;; `summing` works at every numeric type, through the `(where (Num %a))` of
;; its `Collector` implementation. A string is not a number, and the error
;; names the use and the constraint, not the body of the implementation.

;; EXPECT-ERROR: 'string' does not satisfy 'Num', needed by the implementation of 'Collector'

(import (std prelude))

(defun (main args)
  (println {summing x (:for x ["a" "b"])})
  0)
