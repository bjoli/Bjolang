;; A top-level `def*` is its clauses spliced into the declaration list, so two
;; clauses binding one name would be two definitions of it rather than the
;; shadowing a body would give. Refused, as it is in a body.

;; EXPECT-ERROR: is bound by more than one clause of this def*

(import (std prelude))

(def* ((Tuple a b) (Tuple 1 2))
      ((Tuple b c) (Tuple 3 4)))
