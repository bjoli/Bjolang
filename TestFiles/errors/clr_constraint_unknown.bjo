;; EXPECT-ERROR: not a .NET interface this compiler can find
;;
;; The interface is resolved where it is named, so a misspelling is reported on
;; the `def/trait` rather than at whatever call site first needed it.
(import (std prelude))

(def/trait (Num %a)
  (#:clr-constraint (System.Numerics.INumbre %a)))

(defun (main) 0)
