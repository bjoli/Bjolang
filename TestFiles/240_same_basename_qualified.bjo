;; Two modules of one name, `thing`, and a macro expansion that calls a helper
;; of one of them by its qualified name. C# sees two `thing_Module` classes,
;; so that reference has to name its namespace.

(import (std prelude))
(import (std simpletest))
(import "samebase/a/thing.bjo")
(import "samebase/m/thing.bjo")

(defun (main)
  (expect "the macro's helper, from the right thing" (doubled (peel-a (make-a 21))) 42)
  0)
