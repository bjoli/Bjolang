;; An rx that takes no argument is a keyword. A symbol in that position is the
;; likeliest mistake for someone coming from irregex, so it is named.

;; EXPECT-ERROR: 'bos' is a symbol
;; EXPECT-ERROR: Did you mean :bos?

(import (std prelude))
(import (std rx))

(defun (main)
  (println (->str (rx-match? #rx(seq bos "a") "a")))
  0)
