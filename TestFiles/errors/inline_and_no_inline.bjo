;; `#:inline` and `#:no-inline` on one definition.
;;
;; The two markers say opposite things, and neither wins by being written
;; first, so the definition is refused rather than read one way.

(import (std prelude))

;; EXPECT-ERROR: A definition is #:inline or #:no-inline, not both.
(: f (-> int int))
(defun (f x) #:inline #:no-inline (+ x 1))

(defun (main args) (f 1))
