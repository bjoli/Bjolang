# The bootstrap, and `rebjo`.
#
# `bjo` is written in Bjolang, so something that is not Bjolang has to compile
# it the first time. That is what this does: it gets `bjo.exe` to exist and
# hands over. Everything a user asked for — which command, what is stale, what
# to run — is decided in `bjo.bjo`, and nothing here should grow to have an
# opinion about it.
#
# What it no longer does is ask whether the compiler is behind its own sources.
# That question cost a walk of every `.fs` and every `.cs` in the tree on every
# invocation, to answer "no" nearly every time — and when it was "yes", it was a
# build nobody asked for in the middle of running something else. It is `bjo
# rebjo` now, and only ever that.
#
# It does ask that about `bjo` itself, which is a different question with a
# different cost: the answer is in `bjo.bjobuild`, which the last build wrote,
# and reading it is a stat per entry rather than a walk.
#
# `rebjo` is answered here rather than in `bjo.bjo` because it rebuilds
# `bjo.exe`, which `bjo.bjo` is running from. Nothing else about it needs bash:
# the two commands below are the whole of the bootstrap, and a `rebjo` is the
# bootstrap run on purpose.

set -e

BJO_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
BJO_ROOT="$(cd "$BJO_DIR/.." && pwd)"
export BJO_ROOT

COMPILER_DLL="$BJO_ROOT/bin/Release/net10.0/Bjolang.dll"
SOURCE="$BJO_DIR/bjo.bjo"
EXE="$BJO_DIR/bjo.exe"

build_compiler() {
    echo "Building the Bjolang compiler..."
    dotnet build "$BJO_ROOT/Bjolang.fsproj" -c Release -v q --nologo
}

build_bjo() {
    echo "Building bjo..."
    dotnet "$COMPILER_DLL" "$SOURCE"
}

if [ "$1" = "rebjo" ]; then
    if [ $# -ne 1 ]; then
        echo "bjo rebjo: takes no arguments."
        exit 1
    fi

    build_compiler
    build_bjo
    exit 0
fi

# Is bjo.exe behind its own sources?
#
# The build record beside bjo.bjo lists every source and every assembly the
# last build read, so this covers the modules bjo imports by path — bjo.bjo,
# project.bjo, resolve.bjo, git.bjo, lock.bjo, manifest.bjo — without anything
# here knowing their names. It is a stat per entry over a list of a few dozen,
# not the walk of the whole tree that asking the same about the compiler cost.
bjo_is_stale() {
    local record="$BJO_DIR/bjo.bjobuild"
    [ -f "$record" ] || return 0

    local key value
    while read -r key value; do
        case "$key" in
            source|dep|compiler)
                if [ -e "$value" ] && [ "$value" -nt "$EXE" ]; then
                    return 0
                fi
                ;;
        esac
    done < "$record"

    return 1
}

# The compiler is missing, not stale: a file that is not there cannot be run,
# and answering that is a question about two paths rather than about the tree.
# bjo itself is both, because editing it is the ordinary way to work on it.
[ -f "$COMPILER_DLL" ] || build_compiler

if [ ! -f "$EXE" ] || bjo_is_stale; then
    build_bjo
fi

exec dotnet "$EXE" "$@"
