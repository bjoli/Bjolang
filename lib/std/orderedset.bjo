;; std/orderedset.bjo — the sorted set.
;;
;; A `(OrderedSet %a)` is a persistent B-tree of elements kept in their natural
;; order. That is what it buys over a `(Set %a)`, and the whole of it: a walk
;; arrives sorted, and a program may ask for the smallest element, the one after
;; a given key, or every element between two — none of which a hash trie can
;; answer at all. The price is the comparison: membership is O(log n) rather than
;; effectively constant, and the element type has to be comparable at run time.
;;
;; The three interfaces are `(std set)`'s three, for the same reasons: the set
;; itself, a builder shaped like `ListBuilder`, and a transient that is the set's
;; own interface with the writes turned inside out.
;;
;; **Ordering is `Comparer<T>.Default`.** A type with no natural order fails when
;; the first comparison happens rather than when the set is made, which is a real
;; edge and the price of not carrying a comparer through every signature.

(export
  ;; The types. `OrderedSetting` is the collector, and its constructor is what
  ;; an `:acc` clause writes.
  OrderedSet OrderedSetBuilder TransientOrderedSet OrderedSetCursor
  OrderedSetting

  ;; Sets
  orderedset-empty orderedset-add orderedset-add-all orderedset-remove
  orderedset-remove-all orderedset-contains? orderedset-length orderedset-empty?
  orderedset-clear
  ;; Set algebra
  orderedset-union orderedset-intersection orderedset-difference
  orderedset-symmetric-difference
  ;; Order — what the tree is for
  orderedset-min orderedset-max orderedset-successor orderedset-predecessor
  orderedset-range orderedset-from orderedset-until
  ;; Walking and rebuilding
  orderedset-map orderedset-filter orderedset-fold orderedset-for-each
  orderedset-iter orderedset-any? orderedset-find
  ;; Conversions
  list->orderedset orderedset->list vec->orderedset orderedset->vec
  seq->orderedset orderedset->seq
  orderedset->str
  ;; Builders — the same shape as ListBuilder
  orderedsetbuilder-empty orderedset->orderedsetbuilder orderedsetbuilder-add!
  orderedsetbuilder-add-all! orderedsetbuilder-length orderedsetbuilder->orderedset
  ;; Transients — the set's interface, in place
  transientorderedset-empty orderedset->transientorderedset
  transientorderedset->orderedset transientorderedset-add!
  transientorderedset-add-all! transientorderedset-remove!
  transientorderedset-remove-all! transientorderedset-contains?
  transientorderedset-length transientorderedset-empty?
  transientorderedset-min transientorderedset-max
  transientorderedset-filter!)

(import (std prelude))

(import/class
  ((OrderedSet %a) (: OrderedSet.OrderedSet))
  ((OrderedSetBuilder %a) (: OrderedSet.OrderedSetBuilder))
  ((TransientOrderedSet %a) (: OrderedSet.TransientOrderedSet))
  ((OrderedSetCursor %a) (: OrderedSet.OrderedSetCursor)))

;; ---------------------------------------------------------------------------
;; The set
;; ---------------------------------------------------------------------------

(import/extern
  (orderedset-empty      (: OrderedSet.OrderedSetModule.Empty       (-> (OrderedSet %a))))
  (orderedset-add        (: OrderedSet.OrderedSetModule.Add         (-> (OrderedSet %a) %a (OrderedSet %a))))
  ;; Through a transient, so the tree is copied once rather than once per
  ;; element — which is what makes adding a run of elements worth spelling.
  (orderedset-add-all    (: OrderedSet.OrderedSetModule.AddRange    (-> (OrderedSet %a) (Seq %a) (OrderedSet %a))))
  (orderedset-remove     (: OrderedSet.OrderedSetModule.Remove      (-> (OrderedSet %a) %a (OrderedSet %a))))
  (orderedset-remove-all (: OrderedSet.OrderedSetModule.RemoveRange (-> (OrderedSet %a) (Seq %a) (OrderedSet %a))))
  (orderedset-contains?  (: OrderedSet.OrderedSetModule.Contains    (-> (OrderedSet %a) %a bool)))
  (orderedset-length     (: OrderedSet.OrderedSetModule.Count       (-> (OrderedSet %a) int)))
  (orderedset-empty?     (: OrderedSet.OrderedSetModule.IsEmpty     (-> (OrderedSet %a) bool)))
  (orderedset-clear      (: OrderedSet.OrderedSetModule.Clear       (-> (OrderedSet %a) (OrderedSet %a))))

  ;; --- Set algebra ---
  ;;
  ;; The last three walk both trees once, in order, which is what the ordering
  ;; makes possible: no hashing, and no second lookup per element.
  (orderedset-union                (: OrderedSet.OrderedSetModule.Merge (-> (OrderedSet %a) (OrderedSet %a) (OrderedSet %a))))
  (orderedset-intersection         (: OrderedSet.OrderedSetModule.Intersect (-> (OrderedSet %a) (OrderedSet %a) (OrderedSet %a))))
  (orderedset-difference           (: OrderedSet.OrderedSetModule.Except (-> (OrderedSet %a) (OrderedSet %a) (OrderedSet %a))))
  (orderedset-symmetric-difference (: OrderedSet.OrderedSetModule.SymmetricExcept (-> (OrderedSet %a) (OrderedSet %a) (OrderedSet %a))))

  ;; --- Order ---
  ;;
  ;; Each answers `(found, key)`, which `Option` is put on below: a static C#
  ;; method has no `Option` to hand back, the type being Bjolang's.
  (orderedset-try-min         (: OrderedSet.OrderedSetModule.TryGetMin         (-> (OrderedSet %a) (Tuple bool %a))))
  (orderedset-try-max         (: OrderedSet.OrderedSetModule.TryGetMax         (-> (OrderedSet %a) (Tuple bool %a))))
  (orderedset-try-successor   (: OrderedSet.OrderedSetModule.TryGetSuccessor   (-> (OrderedSet %a) %a (Tuple bool %a))))
  (orderedset-try-predecessor (: OrderedSet.OrderedSetModule.TryGetPredecessor (-> (OrderedSet %a) %a (Tuple bool %a))))

  ;; Lazy, and the reason a slice of a big set is cheap: the tree is descended
  ;; to the lower bound once and then walked, so a range costs its own size
  ;; rather than the set's.
  (orderedset-range (: OrderedSet.OrderedSetModule.Range (-> (OrderedSet %a) %a %a (Seq %a))))
  (orderedset-from  (: OrderedSet.OrderedSetModule.From  (-> (OrderedSet %a) %a (Seq %a))))
  (orderedset-until (: OrderedSet.OrderedSetModule.Until (-> (OrderedSet %a) %a (Seq %a))))

  ;; --- Walking ---
  (orderedset-map        (: OrderedSet.OrderedSetModule.Map        (-> (-> %a %b) (OrderedSet %a) (OrderedSet %b))))
  (orderedset-filter     (: OrderedSet.OrderedSetModule.Filter     (-> (-> %a bool) (OrderedSet %a) (OrderedSet %a))))
  ;; In order, which is what makes a fold over a sorted set worth having: the
  ;; answer does not depend on where the elements happened to hash.
  (orderedset-fold       (: OrderedSet.OrderedSetModule.Fold       (-> (-> %s %a %s) %s (OrderedSet %a) %s)))
  (orderedset-iter       (: OrderedSet.OrderedSetModule.Iter       (-> (-> %a bool) (OrderedSet %a) bool)))
  (orderedset-any?       (: OrderedSet.OrderedSetModule.Exists     (-> (-> %a bool) (OrderedSet %a) bool)))
  (orderedset-try-find   (: OrderedSet.OrderedSetModule.TryFindKey (-> (-> %a bool) (OrderedSet %a) (Tuple bool %a))))

  (seq->orderedset (: OrderedSet.OrderedSetModule.FromEnumerable (-> (Seq %a) (OrderedSet %a))))
  (orderedset->seq (: OrderedSet.OrderedSetModule.AsEnumerable   (-> (OrderedSet %a) (Seq %a))))

  (orderedset-cursor         (: OrderedSet.OrderedSetModule.Cursor        (-> (OrderedSet %a) (OrderedSetCursor %a))))
  (orderedset-cursor-done?   (: OrderedSet.OrderedSetModule.CursorDone    (-> (OrderedSetCursor %a) bool)))
  (orderedset-cursor-current (: OrderedSet.OrderedSetModule.CursorCurrent (-> (OrderedSetCursor %a) %a))))

;; The four partial answers, as `Option`s. `None` for the empty set, and for a
;; key with nothing beyond it — which is the reason they are not plain values:
;; there is no element of `%a` that could stand for "there is no smaller one".
(: orderedset-min (-> (OrderedSet %a) (Option %a)))
(defun (orderedset-min s)
  (def (found key) (orderedset-try-min s))
  (if found (Some key) None))

(: orderedset-max (-> (OrderedSet %a) (Option %a)))
(defun (orderedset-max s)
  (def (found key) (orderedset-try-max s))
  (if found (Some key) None))

;; The smallest element greater than `key`. The key itself need not be a member.
(: orderedset-successor (-> (OrderedSet %a) %a (Option %a)))
(defun (orderedset-successor s key)
  (def (found next) (orderedset-try-successor s key))
  (if found (Some next) None))

(: orderedset-predecessor (-> (OrderedSet %a) %a (Option %a)))
(defun (orderedset-predecessor s key)
  (def (found prev) (orderedset-try-predecessor s key))
  (if found (Some prev) None))

(: orderedset-find (-> (-> %a bool) (OrderedSet %a) (Option %a)))
(defun (orderedset-find pred s)
  (def (found key) (orderedset-try-find pred s))
  (if found (Some key) None))

;; ---------------------------------------------------------------------------
;; Builders and transients
;; ---------------------------------------------------------------------------
;;
;; The builder collects into a flat list and sorts it into a B-tree bottom-up in
;; one pass, where adding to the set itself copies a path down the tree per
;; element. The transient is for editing a set that already exists: it owns the
;; nodes it has touched, so an edit rewrites rather than copies.

(import/extern
  (orderedsetbuilder-empty         (: OrderedSet.OrderedSetBuilderModule.Empty    (-> (OrderedSetBuilder %a))))
  (orderedset->orderedsetbuilder   (: OrderedSet.OrderedSetBuilderModule.FromSet  (-> (OrderedSet %a) (OrderedSetBuilder %a))))
  (orderedsetbuilder-add!          (: OrderedSet.OrderedSetBuilderModule.Add      (-> (OrderedSetBuilder %a) %a void)))
  (orderedsetbuilder-add-all!      (: OrderedSet.OrderedSetBuilderModule.AddRange (-> (OrderedSetBuilder %a) (Seq %a) void)))
  ;; Appends, not elements: duplicates are compacted when the set is built.
  (orderedsetbuilder-length        (: OrderedSet.OrderedSetBuilderModule.Count    (-> (OrderedSetBuilder %a) int)))
  (orderedsetbuilder->orderedset   (: OrderedSet.OrderedSetBuilderModule.Build    (-> (OrderedSetBuilder %a) (OrderedSet %a))))

  (transientorderedset-empty       (: OrderedSet.TransientOrderedSetModule.Empty          (-> (TransientOrderedSet %a))))
  (orderedset->transientorderedset (: OrderedSet.TransientOrderedSetModule.FromPersistent (-> (OrderedSet %a) (TransientOrderedSet %a))))
  (transientorderedset->orderedset (: OrderedSet.TransientOrderedSetModule.ToPersistent   (-> (TransientOrderedSet %a) (OrderedSet %a))))
  (transientorderedset-add!        (: OrderedSet.TransientOrderedSetModule.Add            (-> (TransientOrderedSet %a) %a void)))
  (transientorderedset-add-all!    (: OrderedSet.TransientOrderedSetModule.AddRange       (-> (TransientOrderedSet %a) (Seq %a) void)))
  (transientorderedset-remove!     (: OrderedSet.TransientOrderedSetModule.Remove         (-> (TransientOrderedSet %a) %a void)))
  (transientorderedset-remove-all! (: OrderedSet.TransientOrderedSetModule.RemoveRange    (-> (TransientOrderedSet %a) (Seq %a) void)))
  (transientorderedset-contains?   (: OrderedSet.TransientOrderedSetModule.Contains       (-> (TransientOrderedSet %a) %a bool)))
  (transientorderedset-length      (: OrderedSet.TransientOrderedSetModule.Count          (-> (TransientOrderedSet %a) int)))
  (transientorderedset-empty?      (: OrderedSet.TransientOrderedSetModule.IsEmpty        (-> (TransientOrderedSet %a) bool)))
  ;; The transient's answer to `filter`, which cannot be "a new set" here.
  (transientorderedset-filter!     (: OrderedSet.TransientOrderedSetModule.FilterInPlace  (-> (-> %a bool) (TransientOrderedSet %a) void)))

  (transientorderedset-try-min     (: OrderedSet.TransientOrderedSetModule.TryGetMin      (-> (TransientOrderedSet %a) (Tuple bool %a))))
  (transientorderedset-try-max     (: OrderedSet.TransientOrderedSetModule.TryGetMax      (-> (TransientOrderedSet %a) (Tuple bool %a)))))

(: transientorderedset-min (-> (TransientOrderedSet %a) (Option %a)))
(defun (transientorderedset-min s)
  (def (found key) (transientorderedset-try-min s))
  (if found (Some key) None))

(: transientorderedset-max (-> (TransientOrderedSet %a) (Option %a)))
(defun (transientorderedset-max s)
  (def (found key) (transientorderedset-try-max s))
  (if found (Some key) None))

;; ---------------------------------------------------------------------------
;; Conversions
;; ---------------------------------------------------------------------------

(: list->orderedset (-> (List %a) (OrderedSet %a)))
(defun (list->orderedset xs) (seq->orderedset (list->seq xs)))

(: orderedset->list (-> (OrderedSet %a) (List %a)))
(defun (orderedset->list s) (seq->list (orderedset->seq s)))

(: vec->orderedset (-> (Vec %a) (OrderedSet %a)))
(defun (vec->orderedset v) (seq->orderedset (vec->seq v)))

(: orderedset->vec (-> (OrderedSet %a) (Vec %a)))
(defun (orderedset->vec s) (seq->vec (orderedset->seq s)))

;; ---------------------------------------------------------------------------
;; The traits
;; ---------------------------------------------------------------------------

(def/impl (Iterable (OrderedSet %a))
  (type %elem %a)
  (type %cursor (OrderedSetCursor %a))
  (defun (iterable-start s) (orderedset-cursor s))
  (defun (iterable-done? s c) (orderedset-cursor-done? c))
  (defun (iterable-current s c) (orderedset-cursor-current c))
  (defun (iterable-next s c) c))

(: orderedset-for-each (-> (-> %a void) (OrderedSet %a) void))
(defun (orderedset-for-each f s)
  (loop (:for x s) (:do (f x))))

(def/impl (Collection (OrderedSet %a))
  (type %content %a)
  (defun (length s) (orderedset-length s))
  (defun (empty? s) (orderedset-empty? s)))

(def/impl (Foldable (OrderedSet %a))
  (type %item %a)
  (defun (fold f acc col) (orderedset-fold f acc col)))

;; The result is sorted by the *new* elements' order, not by the old one's — a
;; mapping is free to reorder, and a set that came out of one is still sorted.
(def/impl (Functor (OrderedSet %a))
  (defun (map g s) (orderedset-map g s)))

;; `(loop (:for x xs) (:acc s (ordered-setting x)))` — sorted, whatever order the
;; elements arrive in.
(type (: (OrderedSetting %a) (Union ordered-setting)))

(def/impl (Collector (OrderedSetting %a))
  (type %elem %a)
  (type %acc (OrderedSetBuilder %a))
  (type %out (OrderedSet %a))
  (defun (collector-init c) (orderedsetbuilder-empty))
  (defun (collector-step c acc x) (orderedsetbuilder-add! acc x) acc)
  (defun (collector-finish c acc) (orderedsetbuilder->orderedset acc)))

;; `#{1 2 3}`, in order — which for this set is a fact rather than an artefact,
;; so two equal sets always print the same.
;; Two ordered sets are equal when they hold the same elements.
;;
;; A paired walk rather than a membership test, and that is what the ordering
;; buys: both trees walk in the same order, so the comparison is element against
;; element through `Eq` and the tree's own `Comparer<T>` never has to be trusted
;; to agree with it. `(Set %a)` cannot do this — it has to ask the trie.
;;
;; The lists are the price. `OrderedSet.OrderedSet` is a C# class with no
;; structural `Equals` of its own, so before this `=` on two of them was
;; reference identity; a walk that allocates is a great deal better than an
;; answer that is wrong.
(def/impl (Eq (OrderedSet %a))
  (where (Eq %a))
  (defun (= a b)
    (and (= (orderedset-length a) (orderedset-length b))
         (= (orderedset->list a) (orderedset->list b))))
  ;; Order *does* matter here, and may: the walk is sorted, so two equal sets
  ;; produce the same sequence whatever order they were built in.
  (defun (eq-hash s)
    (orderedset-fold (fun (h x) (hash-combine h (eq-hash x))) 17 s)))

(: orderedset->str (-> (OrderedSet %a) string) (where (->str %a)))
(defun (orderedset->str s)
  (let ((sb (stringbuilder-empty)))
    (stringbuilder-add-string! sb "#{")
    (loop (:with first? #t #f)
          (:for elem s)
          (:do (unless first? (stringbuilder-add-string! sb " "))
               (stringbuilder-add-string! sb (->str elem))))
    (stringbuilder-add-string! sb "}")
    (stringbuilder->string sb)))

(def/impl (->str (OrderedSet %a))
  (where (->str %a))
  (defun (->str s)
    (orderedset->str s)))
