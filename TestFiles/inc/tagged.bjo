;; For 237_tags.bjo: a grammar with keyword lists, published from a library.
;;
;; The grammar travels with the type into the metadata. The importing module
;; must read a keyword list the same way as this module does. A keyword list
;; beats the list without a keyword, so `'(from t)` is a CFrom and
;; `'(plain a)` is a CPlain.

(import (std prelude))

(export Q Item render-q)

(def/grammar Q
  (Q (:or (: CFrom (from symbol))
          (: CSelect (select Item ...))
          (: CEsc 'esc)
          ;; A list without a keyword. Its head is data.
          (: CPlain (Item ...))))
  (Item (:or (: ISym symbol) (: ISub (Item ...)))))

(: render-item (-> Item string))
(defun (render-item i)
  (match i
    ((ISym s) (symbol->string s))
    ((ISub xs) (string-append "(" (string-append (render-items xs) ")")))))

(: render-items (-> (List Item) string))
(defun (render-items xs)
  (match xs
    (Nil "")
    ((Cons x Nil) (render-item x))
    ((Cons x rest) (string-append (render-item x) (string-append " " (render-items rest))))))

(: render-q (-> Q string))
(defun (render-q q)
  (match q
    ((CPlain xs) (string-append "plain(" (string-append (render-items xs) ")")))
    ((CFrom t) (string-append "from " (symbol->string t)))
    ((CSelect xs) (string-append "select(" (string-append (render-items xs) ")")))
    ((CEsc) "esc")))
