;; EXPECT-ERROR: None reaches no clause

;; A match in a local function's keyword default is checked for exhaustiveness
;; like any other.

(import (std prelude))

(: pick (-> (Option int) int))
(defun (pick o)
  (defun (inner a #:k (match o ((Some v) v)))
    (+ a k))
  (inner 1))

(defun (main args)
  (println (->str (pick None)))
  0)
