;; `def/else` produces the value of the whole form.
;;
;; The else body is the form's other arm, exactly as an `if`'s is: whichever
;; arm runs, its value is the form's. It jumps nowhere by itself, so a body
;; that means to leave an enclosing block writes the `(ret ...)` that leaves
;; it, and that `ret` is an ordinary tail-position form there.
;;
;; Before this, the else body was typed against the enclosing *block's* result
;; and compiled to an escape. That implicit jump was the only reason the form
;; needed a `with-return` at all — a `def/else` with nothing blocklike about it
;; still had to be wrapped in one. `219_with_return.bjo` covers the form as it
;; behaves inside a block; this file covers it as a value.

(import (std prelude))
(import (std simpletest))

(: parse-int (-> string (Result string int)))
(defun (parse-int s)
  (if (= s "12") (Ok 12) (Err "nope")))

;; --- Outside any block: the else body is simply the other arm --------------
;;
;; No `with-return` anywhere. This is the shape the change exists for.
(: label (-> string string))
(defun (label s)
  (def/else ((Ok n) (parse-int s))
    "unparseable")
  (str "n = " (int->string n)))

;; --- Inside a block, with the escape written out ---------------------------
;;
;; What the implicit jump used to do, said in the ordinary way. `(ret ...)` is
;; in tail position of the else body, which is where `checkEscapeUses` already
;; allowed it, so this compiles to what it always did.
(: inside (-> string (Result string int)))
(defun (inside s)
  (with-return ret
    (def/else ((Ok n) (parse-int s))
      (ret (Err "bad input")))
    (Ok (+ n 1))))

;; --- A void body ------------------------------------------------------------
;;
;; The sequel produces nothing, so the else body may not produce anything
;; either. `panic!` is typed `%a` and so agrees with `void` as it agrees with
;; everything. It exits the process, so only the matching path is run here.
(: shout (-> (Option string) void))
(defun (shout o)
  (def/else ((Some msg) o)
    (panic! "nothing to shout"))
  (println msg))

;; --- Not in tail position: the declare-and-assign path ---------------------
;;
;; The `let`'s body is a subexpression, so it is generated into a declared
;; local and both arms assign it. The declaration carries `default!` for the
;; sake of an else body that never assigns at all — one ending in a `ret` or a
;; `panic!` — which C# would otherwise call CS0165 about code no user wrote.
(: described (-> (Option int) string))
(defun (described o)
  (str "n is "
       (let ((zero 0))
         (def/else ((Some n) o)
           "nothing")
         (int->string (+ n zero)))))

;; --- def/else*: the else body stands outside every clause's bindings -------
;;
;; The else body runs because a clause did not match, so nothing any clause
;; would have bound is in scope in it: it sees `fallback`, bound outside the
;; form, and none of `x`, `y` or `z`. That it *cannot* see them is the other
;; half of this, and is asserted where an unbound name can be:
;; `errors/def_else_else_sees_no_clause_binding.bjo`.
;;
;; The clauses still bind sequentially among themselves — `y`'s scrutinee could
;; name `x` — and the sequel sees all three.
(: pick (-> (Option int) (Option int) (Option int) string))
(defun (pick a b c)
  (let ((fallback 99))
    (def/else* (((Some x) a)
                ((Some y) b)
                ((Some z) c))
      (str "else sees fallback=" (int->string fallback)))
    (str "all: " (int->string (+ x (+ y z))))))

;; --- Leaving an *outer* block, which is what the dropped name used to do ---
;;
;; `(def/else outer (p e) ...)` was how this was said. The name is gone and the
;; else body says it the ordinary way, by applying the escape it means — which
;; is the same thing every other form does.
(: outer-from-inner (-> (Option int) string))
(defun (outer-from-inner o)
  (with-return outer
    (with-return inner
      (def/else ((Some n) o)
        (outer "left the outer block"))
      (str "inner got " (int->string n)))))

(defun (main)
  (expect "outside any block, matching" (label "12") "n = 12")
  (expect "outside any block, the else arm" (label "xx") "unparseable")

  (expect "inside a block, matching"
          (match (inside "12") ((Ok n) (int->string n)) ((Err e) e))
          "13")
  (expect "inside a block, the explicit ret"
          (match (inside "zz") ((Ok n) (int->string n)) ((Err e) e))
          "bad input")

  (expect "not in tail position, matching" (described (Some 4)) "n is 4")
  (expect "not in tail position, the else arm" (described None) "n is nothing")

  (expect "def/else* with every clause matching"
          (pick (Some 1) (Some 2) (Some 3))
          "all: 6")
  (expect "the middle clause fails, and the else body sees the outer binding"
          (pick (Some 1) None (Some 3))
          "else sees fallback=99")
  (expect "the first clause fails, likewise"
          (pick None (Some 2) (Some 3))
          "else sees fallback=99")
  (expect "the last clause fails, likewise"
          (pick (Some 1) (Some 2) None)
          "else sees fallback=99")

  (expect "the inner block falls through" (outer-from-inner (Some 7)) "inner got 7")
  (expect "the else body leaves the outer block"
          (outer-from-inner None)
          "left the outer block")

  (shout (Some "a void body ran to its end"))

  (println "220 ok")
  0)
