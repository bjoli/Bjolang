;; A hexadecimal literal too large for a float was C# error CS1021, as a real
;; one too large is refused here.
;; EXPECT-ERROR: '0x1000000000000000000000000000000000' does not fit in a 'float'
(import (std prelude))
(defun (main args)
  (def (: f float) 0x1000000000000000000000000000000000)
  (println (displayed f))
  0)
