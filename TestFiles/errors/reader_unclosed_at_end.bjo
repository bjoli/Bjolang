;; A form still open when the file ends.
;;
;; The end of the file used to close every form left open, so this compiled as
;; though the closing bracket had been written. The error is at the bracket
;; that was never closed, which is the innermost one still open at the end.
;;
;; EXPECT-ERROR: reader_unclosed_at_end.bjo:11: the '(' opened here is never closed

(defun (main) 0)

(def z (+ 1 2)
