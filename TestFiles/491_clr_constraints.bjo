;; Generic .NET methods called at types that meet their constraints compile
;; as before. See errors/clr_constraint_*.bjo for the ones that do not.
(import (std prelude))
(import (std simpletest))

(import/class (DayOfWeek (: System.DayOfWeek)))
(import/extern (enum-values (: System.Enum.GetValues (-> (Array %a)))))

(: (-> (Array DayOfWeek)))
(defun (days) (enum-values))

(defun (main)
  (expect "an enum meets struct, Enum" (array-length (days)) 7)
  0)
