;; Constructing an `#:opaque` record from outside.
;;
;; A record is built by its own type name, which resolves to the record here as
;; it does in `vault`. The construction is refused because it is this module's
;; code.

;; EXPECT-ERROR: 'vault/Ledger' cannot be constructed here
;; EXPECT-ERROR: vault/Ledger is exported #:opaque

(import "../inc/vault.bjo")

(defun (main args)
  (println (int->string (ledger-total (Ledger (total 1) (note "x")))))
  0)
