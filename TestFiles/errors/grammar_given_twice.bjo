;; :each takes each item at most once.
;; EXPECT-ERROR: (port ...) is given twice
(import (std prelude))
(def/grammar Conn
  (Conn (conn (: host string) (: rest Opts)))
  (Opts (:each (: port (:? (port int))) (: limit (:? (limit int))))))
(defun (main args)
  (def (: c Conn) '(conn "h" (port 1) (port 2)))
  0)
