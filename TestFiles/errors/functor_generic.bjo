;; EXPECT-ERROR: Kind Error
;; EXPECT-ERROR: Bjolang has no higher-kinded type variables
(import (std prelude))

(def/trait (Functor (%f %a))
  (: fmap (-> (%f %a) (-> %a %b) (%f %b))))

(def/impl (Functor (List %a))
  (defun (fmap xs g) (list-map xs g)))

;; The thing you actually want a Functor *for*: code written once, over any
;; functor at all.
(: bump (-> (%f int) (%f int)))
(defun (bump fa)
  (fmap fa (fun (n) (+ n 1))))

(defun (main) 0)
