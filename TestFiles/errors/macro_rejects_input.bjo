;; `syntax-error` is how a transformer rejects its input. The expander unwraps
;; the reflection frame and reports it against the macro's call site, so the
;; message names the form the programmer wrote.
;;
;; EXPECT-ERROR: The macro 'or-else' failed
;; EXPECT-ERROR: or-else takes two arguments
;; EXPECT-ERROR: (or-else 1 2 3)

(import "../inc/macros.bjo")

(defun (main args)
  (println (int->string (or-else 1 2 3)))
  0)
