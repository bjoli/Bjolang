;; En impl som inte binder en av traitens associerade typer.
;;
;; Förut överlevde den hit och föll först vid första projektionen, med "Missing
;; implementation of Foldable for (Vec int)" — ett meddelande om en
;; implementation som står tio rader längre upp. Frågan ställs där svaret
;; skrivs.
;;
;; EXPECT-ERROR: does not bind its associated type %item
;; EXPECT-ERROR: Write (type %item <type>) in it

(import (std prelude))

(type (: (Pair %a) (Struct (: fst %a) (: snd %a))))

(impl (Foldable (Pair %a))
  (defun (fold f acc p)
    (f (f acc (struct-ref p fst)) (struct-ref p snd))))

(defun (main args) 0)
