;; A span cannot be part of another value.
;; EXPECT-ERROR: this is a (Option (System.Span long)), which holds a (System.Span long)
(import (std prelude))
(import/extern
  (whole (: System.MemoryExtensions.AsSpan (-> (Array %a) (System.Span %a))))
  (sleep (: System.Threading.Tasks.Task.Delay (-> int void) #:async #:uncancellable)))
(: (-> (System.Span long) int))
(defun (len s) (.-Length s))

(defun (main) (def xs (vec->array [1L])) (def o (Some (whole xs))) 0)
