;; Day 1: Secret Entrance. A dial of 0..99 starts at 50. Part 1 counts the
;; turns that end at 0, part 2 every click that passes 0.
(import (std maths) (std scan) "common.bjo")

(defun (main args)
  (defun (turn pos right? d) (modulo ((if right? + -) pos d) 100))
  (defun (hits pos right? d)
    (cond (right? (quotient (+ pos d) 100))
          ((= pos 0) (quotient d 100))
          ((>= d pos) (+ 1 (quotient (- d pos) 100)))
          (else 0)))
  (def (zeros clicks)
    (loop (:for line (input-lines args))
          (:with pos 50 (turn pos right? d))
          (:let (dir . d) (scan line '(char int)))
          (:let right? (char=? dir #\R))
          (:acc zeros (counting line) #:when (= (turn pos right? d) 0))
          (:acc clicks (summing (hits pos right? d)))
          => (Tuple zeros clicks)))
  (println zeros)
  (println clicks)
  0)
