;; Docs for std/eq.bjo, read through (:doc #:file "eq.bjodoc"). The texts are
;; samizdat markup: code in prose is @code{...}.

(:doc #:module
  (summary "Equality (Eq), ordering (Ord), and sorting, minimum, and maximum utilities.")
  (see = eq-hash Ord compare list-sort)
  (example """
    (= (list 1 2 3) (list 1 2 3))      ; #t
    (compare "apple" "banana")         ; a negative int
    (less? 2 3)                        ; #t
    (list-sort (list 3 1 2))           ; (1 2 3)
    (list-max (list 3 1 2))            ; (Some 3)
    """)
  (reference """
    The prelude re-exports all identifiers from this module; importing
    @code{(std prelude)} makes this module available automatically.

    @strong{Eq.} The trait provides two methods: @code{=} and @code{eq-hash}.
    Every type has an @code{Eq} instance. Types without custom instances use
    the default implementation delegating to .NET @code{Equals} and
    @code{GetHashCode}. Primitive types (@code{int}, @code{bool},
    @code{string}, @code{char}, @code{Keyword}, @code{Symbol},
    @code{StringCursor}) have specialized implementations. For @code{double},
    @code{Equals} is used so that @code{NaN} equals @code{NaN}. All @code{void}
    values are equal.

    Container types (@code{List}, @code{Vec}, @code{Option}, @code{Result}, and
    tuples with 2 to 4 elements) compare elements structurally using each
    element's @code{=}, and compute hashes using @code{eq-hash}. List and vector
    equality checks run iteratively to avoid stack overflows on large
    collections.

    @strong{Ord.} Defines total ordering via @code{compare}. Derived comparison
    functions and sorting utilities rely solely on @code{compare}. Numeric
    types, @code{bool}, and @code{char} delegate to .NET @code{CompareTo}
    (including @code{decimal}, @code{bigint}, @code{int128}, @code{uint128},
    and @code{System.SByte}). String comparisons are ordinal (based on Unicode
    code points) rather than culture-sensitive, ensuring identical cross-platform
    ordering matching @code{OrderedMap}. Tuples with 2 to 4 elements whose
    elements are ordered are ordered lexicographically: by the first element,
    then by the second when the first are equal, and so on.
    @code{(std clr-ord)} provides @code{Ord} for additional .NET types like
    @code{Guid} and @code{Version}.

    @strong{Custom implementations.} Implementations must preserve key
    invariants: equal values under @code{=} must produce identical @code{eq-hash}
    values, and @code{compare} must return @code{0} if and only if values are
    equal under @code{=}.

    @codeblock[#:lang "bjolang"]|{
    (impl (Ord Card)
      (defun (compare a b) (compare (card-rank a) (card-rank b))))
    }|
    """))

;; ---------------------------------------------------------------------------
;; Eq
;; ---------------------------------------------------------------------------

(:doc Eq
  (summary "Trait for structural equality and hashing.")
  (see = eq-hash)
  (reference """
    Every type provides an @code{Eq} instance. The default instance delegates
    to .NET @code{Equals} and @code{GetHashCode}. Custom instances must ensure
    that equal values yield identical hash codes.
    """))

(:doc =
  (summary "Returns #t if two values are equal, otherwise #f.")
  (arg a "The first value.")
  (arg b "The second value.")
  (returns "#t when a and b are equal.")
  (see eq-hash compare)
  (example """
    (= "abc" "abc")               ; #t
    (= (Some 1) (Some 2))         ; #f
    """)
  (reference """
    Structural equality method of @code{Eq}. Containers compare their items
    with each item's @code{=}. On @code{double}, @code{NaN} equals @code{NaN}.
    """))

(:doc eq-hash
  (summary "Computes a hash code consistent with =.")
  (arg a "The value to hash.")
  (returns "An int hash code. Equal values produce identical hash codes.")
  (see =)
  (reference """
    Hashing method of @code{Eq}, used by hash sets and hash maps. Container
    hash codes combine the hashes of their elements in sequence.
    """))

;; ---------------------------------------------------------------------------
;; Ord
;; ---------------------------------------------------------------------------

(:doc Ord
  (summary "Trait for a total order.")
  (tparam %a "The type to order.")
  (see compare less? list-sort)
  (example """
    (impl (Ord Card)
      (defun (compare a b) (compare (card-rank a) (card-rank b))))

    (list-sort hand)   ; sorted by rank
    """)
  (reference """
    Requires implementing @code{compare}. All relational operators and
    sorting functions in this module derive from @code{compare}. @code{compare}
    must return 0 if and only if two values are equal under @code{=}.
    """))

(:doc compare
  (summary "Compares two values for order.")
  (arg a "The first value.")
  (arg b "The second value.")
  (returns "A negative int when a < b, 0 when a = b, and a positive int when a > b.")
  (see less? greater? least)
  (reference """
    Primary method of @code{Ord}. Only the sign of the result is significant.
    String comparisons are ordinal (based on Unicode code points) and independent
    of system locale.
    """))

(:doc less?
  (summary "Tests if a is strictly less than b.")
  (arg a "The first value.")
  (arg b "The second value.")
  (returns "#t when (compare a b) is negative.")
  (see at-most? greater? compare))

(:doc greater?
  (summary "Tests if a is strictly greater than b.")
  (arg a "The first value.")
  (arg b "The second value.")
  (returns "#t when (compare a b) is positive.")
  (see at-least? less? compare))

(:doc at-most?
  (summary "Tests if a is less than or equal to b.")
  (arg a "The first value.")
  (arg b "The second value.")
  (returns "#t when (compare a b) is not positive.")
  (see less? at-least? compare))

(:doc at-least?
  (summary "Tests if a is greater than or equal to b.")
  (arg a "The first value.")
  (arg b "The second value.")
  (returns "#t when (compare a b) is not negative.")
  (see greater? at-most? compare))

(:doc least
  (summary "Returns the smaller of two values.")
  (arg a "The first value.")
  (arg b "The second value.")
  (returns "a when a is at most b, else b. When they are equal, returns a.")
  (see greatest list-min))

(:doc greatest
  (summary "Returns the larger of two values.")
  (arg a "The first value.")
  (arg b "The second value.")
  (returns "a when a is at least b, else b. When they are equal, returns a.")
  (see least list-max))

;; ---------------------------------------------------------------------------
;; Lists
;; ---------------------------------------------------------------------------

(:doc list-sort
  (summary "Returns a sorted copy of a list using compare. Stable.")
  (arg xs "The list to sort.")
  (returns "A list of the same items, in ascending order. Preserves the relative order of equal items.")
  (see compare list-min list-max)
  (example """
    (list-sort (list 3 1 2))   ; (1 2 3)
    """)
  (reference """
    Performs a stable merge sort in O(n log n) time. Merges iterative runs
    using temporary array buffers and constructs the resulting list in a single
    pass to avoid stack overflows. Lists with fewer than two items return
    unmodified.
    """))

(:doc vec-sort
  (summary "Returns a sorted copy of a vec using compare. Stable.")
  (arg v "The vec to sort.")
  (returns "A vec of the same items, in ascending order. Equal items keep their order.")
  (see vec-sort-by list-sort compare)
  (example """
    (vec-sort [3 1 2])                           ; [1 2 3]
    (vec-sort [(Tuple 2 "b") (Tuple 1 "z")])     ; [(1, z) (2, b)]
    """)
  (reference """
    The merge sort of @code{list-sort}, over an array: O(n log n), and
    O(n) extra space. A vec of fewer than two items is returned as it is.
    """))

(:doc vec-sort-by
  (summary "Returns a copy of a vec sorted by a comparison function. Stable.")
  (arg cmp "The comparison: negative when its first argument comes first, zero when the two tie, positive otherwise.")
  (arg v "The vec to sort.")
  (returns "A vec of the same items, in the order cmp gives. Items that tie keep their order.")
  (see vec-sort compare)
  (example """
    (vec-sort-by (fun (a b) (compare b a)) [1 3 2])               ; [3 2 1]
    (vec-sort-by (fun (a b) (compare (string-length a) (string-length b)))
                 ["ccc" "a" "bb"])                                 ; ["a" "bb" "ccc"]
    """)
  (reference """
    A comparison that is not a total order gives some order of the items,
    and no error.
    """))

(:doc list-min
  (summary "Finds the minimum item in a list, or None if empty.")
  (arg xs "The list.")
  (returns "(Some item), or None when xs is empty. When multiple items tie for minimum, returns the last occurrence.")
  (see list-max least list-sort))

(:doc list-max
  (summary "Finds the maximum item in a list, or None if empty.")
  (arg xs "The list.")
  (returns "(Some item), or None when xs is empty. When multiple items tie for maximum, returns the last occurrence.")
  (see list-min greatest list-sort))
