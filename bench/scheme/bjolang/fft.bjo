;; FFT -- Fast Fourier Transform, from Gabriel.
;; Arguments: count n fill expected

(import "common.bjo")
(import (only (std maths) sin))

(: four1 (-> (Array double) void))
(defun (four1 data)
  (def n (array-length data))
  (def pi*2 6.28318530717959)

  ;; bit-reversal section
  (let loop1 ((i 0) (j 0))
    (when (< i n)
      (when (< i j)
        (let ((temp (array-ref data i)))
          (array-set! data i (array-ref data j))
          (array-set! data j temp))
        (let ((temp (array-ref data (+ i 1))))
          (array-set! data (+ i 1) (array-ref data (+ j 1)))
          (array-set! data (+ j 1) temp)))
      (let loop2 ((m (/ n 2)) (j j))
        (if (and (>= m 2) (>= j m))
            (loop2 (/ m 2) (- j m))
            (loop1 (+ i 2) (+ j m))))))

  ;; Danielson-Lanczos section
  (let loop3 ((mmax 2))
    (when (< mmax n)
      (let* ((theta (/ pi*2 (cast System.Double mmax)))
             (wpr (let ((x (sin (* 0.5 theta))))
                    (* -2.0 (* x x))))
             (wpi (sin theta)))
        (let loop4 ((wr 1.0) (wi 0.0) (m 0))
          (when (< m mmax)
            (let loop5 ((i m))
              (if (< i n)
                  (let* ((j (+ i mmax))
                         (tempr (- (* wr (array-ref data j))
                                   (* wi (array-ref data (+ j 1)))))
                         (tempi (+ (* wr (array-ref data (+ j 1)))
                                   (* wi (array-ref data j)))))
                    (array-set! data j (- (array-ref data i) tempr))
                    (array-set! data (+ j 1) (- (array-ref data (+ i 1)) tempi))
                    (array-set! data i (+ (array-ref data i) tempr))
                    (array-set! data (+ i 1) (+ (array-ref data (+ i 1)) tempi))
                    (loop5 (+ j mmax)))
                  (loop4 (+ (- (* wr wpr) (* wi wpi)) wr)
                         (+ (+ (* wi wpr) (* wr wpi)) wi)
                         (+ m 2)))))))
      (loop3 (* mmax 2)))))

;; Scheme's `(make-vector n fill)`.
(: make-filled (-> int double (Array double)))
(defun (make-filled n fill)
  (def v (make-array n))
  (let loop ((i 0))
    (when (< i n)
      (array-set! v i fill)
      (loop (+ i 1))))
  v)

(: run (-> (Array double) double))
(defun (run data)
  (four1 data)
  (array-ref data 0))

(defun (main args)
  (def n (arg-int args 1))
  (def fill (arg-double args 2))
  (def expected (arg-double args 3))
  (run-benchmark "fft" (arg-int args 0) (fun () (run (make-filled n fill))) #(= & expected)))
