(import (std prelude))
(import (std simpletest))

;; `_` as a parameter or a loop variable takes the value and binds nothing the
;; body can read. It used to be bound as `_`, which reads as a dropped value:
;; an applied `(fun (_ _) ...)` and a `(:for _ xs)` were refused as discarding
;; an int, and two `_` parameters of a `defun` reached C# as one name twice.

(: both-ignored (-> int int int))
(defun (both-ignored _ _) 1)

(defun (main args)
  (expect "an applied lambda with _ parameters" ((fun (_ _) 7) 1 2) 7)
  (expect "a defun with two _ parameters" (both-ignored 1 2) 1)
  (defun (second _ y) y)
  (expect "a local defun with a _ parameter" (second 1 9) 9)
  (expect "a loop over _" (loop (:for _ (list 1 2 3)) (:acc n (counting 1))) 3)
  (expect "a loop over a range with _" (loop (:for _ (range 0 4)) (:acc n (counting 1))) 4)
  (expect "a :let of _" (loop (:for x (list 1 2)) (:let _ (* x 10)) (:acc s (summing x))) 3)
  (expect "a seql over _" (seq->list (seql (:for _ (list 1 2)) (:yield 0))) (list 0 0))
  (expect "a tuple with a _ part" (loop (:for (Tuple _ x) (list (Tuple 1 2))) (:acc s (summing x))) 2)
  0)
