;; Collecting into an ordered set asks for Ord as building one does.
;; EXPECT-ERROR: no implementation of trait 'Ord' for 'ordered_setting_without_ord/Pt'
(import (std prelude))
(import (std orderedset))

(type (: Pt (Record (: x int) (: y int))))

(defun (main)
  (def s (loop (:for p (list (Pt (x 1) (y 1)) (Pt (x 0) (y 1)))) (:acc acc (ordered-setting p)) => acc))
  (println (->str (orderedset-length s)))
  0)
