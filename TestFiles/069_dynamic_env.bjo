;; The dynamic environment: parameters, and `parameterize`.
;;
;; A parameter is a *value* of type `(Param %a)`, read with `parameter-ref` and
;; rebound for the extent of a body with `parameterize`. R7RS instead makes a
;; parameter object callable and reads it by applying it, which is a convenience
;; of dynamic typing; here one uniform reader keeps `(Param %a)` an ordinary
;; type that can be passed to a function, stored in a record and returned.
;;
;; The three standard ports are parameters like any other. They differ only in
;; where the runtime keeps them — a field on the environment rather than a slot
;; in the champ, because `display` reads the output port on every call — and
;; nothing about that shows here.
;; `TextOutputPort` and the port operations come with the prelude, so there is
;; no `(import (std ports))` here — that module is only the drains that take a
;; reader procedure.
(import (std prelude))
(import (std simpletest))

(import/class
  (StringWriter (: System.IO.StringWriter (-> StringWriter))))

;; A parameter of a user's own. Module-level, and legal there because
;; `(Param int)` is closed — the restriction is on *open* types.
(: indent (Param int))
(def indent (make-parameter 0))

(: verbose? (Param bool))
(def verbose? (make-parameter #f))

;; `make-cold-parameter` makes a parameter that gives up its claim on a cheap
;; read, for one its author knows is not read in a loop. Nothing else about it
;; differs — it is a `(Param %a)` like any other, read and bound by the same two
;; forms — and this file's job is to pin that down, since the whole point of the
;; distinction is that only the runtime is supposed to be able to tell.
;;
;; Two of them, because cold parameters share a place in the environment that
;; hot ones do not: one bound alone and two bound at once take different paths
;; through it, and both have to answer the same.
(: cold-a (Param int))
(def cold-a (make-cold-parameter 10))

(: cold-b (Param int))
(def cold-b (make-cold-parameter 20))

;; Parameters past the point where the cheap places run out. `make-parameter`
;; spends those and then keeps going, so a program that makes a lot of them gets
;; slower reads rather than a failure — and, being the same allocator
;; `make-cold-parameter` draws on, it must land the same way.
(: nth-parameter (-> int (Param int)))
(defun (nth-parameter n)
  (let loop ((i 0) (p (make-parameter -1)))
    (if (>= i n)
        p
        (loop (+ i 1) (make-parameter i)))))

(: spilled (Param int))
(def spilled (nth-parameter 40))

;; The point of a dynamic environment: `describe` never mentions the parameter
;; in its signature, and every caller between it and the `parameterize` is
;; unchanged. Passing this explicitly is what dynamic binding buys you out of.
(: describe (-> string))
(defun (describe)
  (string-append (int->string (parameter-ref indent))
                 (if (parameter-ref verbose?) "/loud" "/quiet")))

;; A named let in tail position *inside* the body, which lowers to a jump inside
;; a try/finally. Worth pinning: `parameterize` desugars to the same try/finally
;; `with-open` does, so whatever this does, both do.
(: sum-to (-> int int))
(defun (sum-to n)
  (parameterize ((indent 1))
    (let loop ((i 0) (acc 0))
      (if (> i n)
          acc
          (loop (+ i 1) (+ acc (parameter-ref indent)))))))

(defun (main)
  ;; --- Reading an unbound parameter ---------------------------------------
  ;;
  ;; The initial value given to `make-parameter` is what a parameter reads
  ;; before anything has bound it.
  (expect "unbound reads its initial" (describe) "0/quiet")

  ;; --- Binding, and restoring ---------------------------------------------
  (parameterize ((indent 2))
    (expect "bound inside" (describe) "2/quiet"))
  (expect "restored after" (describe) "0/quiet")

  ;; Two bindings at once, at two different types.
  (parameterize ((indent 3) (verbose? #t))
    (expect "two parameters" (describe) "3/loud"))
  (expect "both restored" (describe) "0/quiet")

  ;; --- Nesting ------------------------------------------------------------
  (parameterize ((indent 1))
    (parameterize ((indent 2))
      (parameterize ((indent 3))
        (expect "innermost wins" (describe) "3/quiet"))
      (expect "unwound one level" (describe) "2/quiet"))
    (expect "unwound two levels" (describe) "1/quiet"))
  (expect "unwound entirely" (describe) "0/quiet")

  ;; Bindings in one `parameterize` are simultaneous, as R7RS says and as
  ;; `let`'s are: every value expression is evaluated against the environment
  ;; outside the form, and only then is any of them installed. So the second
  ;; value here reads `indent` as it was *before* — 0, not 5 — and the body runs
  ;; quiet.
  (parameterize ((indent 5) (verbose? (= (parameter-ref indent) 5)))
    (expect "bindings are simultaneous" (describe) "5/quiet"))

  ;; `parameterize*` is the sequential one, for when a later value really is
  ;; meant to see an earlier binding installed.
  (parameterize* ((indent 5) (verbose? (= (parameter-ref indent) 5)))
    (expect "parameterize* is sequential" (describe) "5/loud"))

  ;; Both restore, and in the reverse of the order they were installed.
  (expect "restored after either" (describe) "0/quiet")

  ;; --- Capturing the output port ------------------------------------------
  ;;
  ;; `displayln` names no port and never did. It goes to whatever the dynamic
  ;; environment says, so redirecting it needs no change at the call site — this
  ;; is the thing keyword arguments could not buy, and why `#:port` was dropped.
  (def w (StringWriter.))
  (parameterize ((current-output-port (cast TextOutputPort w)))
    (display "captured")
    (newline)
    (display "twice"))

  (expect "output was captured" (.ToString w) "captured\ntwice")

  ;; And the console got none of it: this line proves stdout came back, since
  ;; the harness reads it.
  (expect "stdout restored" "back on stdout" "back on stdout")

  ;; --- Capturing the error port -------------------------------------------
  ;;
  ;; The error port is the one standard port the runtime never writes to
  ;; itself, so it is kept where a program's own parameters are kept rather than
  ;; in a field beside the output port. That is invisible from here, which is
  ;; the case being made: binding, nesting and restoring all read the same.
  (def e1 (StringWriter.))
  (def e2 (StringWriter.))
  (parameterize ((current-error-port (cast TextOutputPort e1)))
    (.Write (parameter-ref current-error-port) "outer")
    (parameterize ((current-error-port (cast TextOutputPort e2)))
      (.Write (parameter-ref current-error-port) "inner"))
    (.Write (parameter-ref current-error-port) "-again"))

  (expect "error port captured and restored" (.ToString e1) "outer-again")
  (expect "error port nests" (.ToString e2) "inner")

  ;; The two output ports are stored two different ways now, so this pins down
  ;; that neither binding went to the other's place.
  (def o3 (StringWriter.))
  (def e3 (StringWriter.))
  (parameterize ((current-output-port (cast TextOutputPort o3))
                 (current-error-port (cast TextOutputPort e3)))
    (display "to-out")
    (.Write (parameter-ref current-error-port) "to-err"))

  (expect "output and error do not alias"
          (string-append (.ToString o3) (string-append "/" (.ToString e3)))
          "to-out/to-err")

  ;; A parameter is an ordinary value, so it can be handed to a function that
  ;; does not know which one it is.
  (expect "parameter passed as a value" (read-twice indent) 0)

  ;; --- Cold parameters ----------------------------------------------------
  ;;
  ;; Everything above, again, for a parameter made the other way. `read-twice`
  ;; takes this one too: which allocator made a parameter is not part of its
  ;; type, so nothing that holds a `(Param int)` has to know.
  (expect "cold reads its initial" (parameter-ref cold-a) 10)

  (parameterize ((cold-a 11))
    (expect "cold binds" (parameter-ref cold-a) 11)
    (expect "cold passed as a value" (read-twice cold-a) 22))
  (expect "cold restores" (parameter-ref cold-a) 10)

  ;; Two at once. Cold parameters share a place that hot ones each have to
  ;; themselves, so this is the case where one could be found under the other's
  ;; binding — neither may see the other's value, and both must come back.
  (parameterize ((cold-a 1) (cold-b 2))
    (expect "two cold, first" (parameter-ref cold-a) 1)
    (expect "two cold, second" (parameter-ref cold-b) 2)
    (parameterize ((cold-a 3))
      (expect "cold shadowed" (parameter-ref cold-a) 3)
      (expect "its neighbour untouched" (parameter-ref cold-b) 2)))
  (expect "both cold restored" (string-append (int->string (parameter-ref cold-a))
                                              (int->string (parameter-ref cold-b)))
          "1020")

  ;; Hot and cold in one form, which is the mixed environment the runtime
  ;; actually sees.
  (parameterize ((indent 4) (cold-a 5))
    (expect "hot beside cold" (string-append (int->string (parameter-ref indent))
                                             (int->string (parameter-ref cold-a)))
            "45"))
  (expect "hot beside cold restored" (describe) "0/quiet")

  ;; A parameter from past the point where the cheap places ran out.
  (expect "spilled reads its initial" (parameter-ref spilled) 39)
  (parameterize ((spilled 7))
    (expect "spilled binds" (parameter-ref spilled) 7)
    (expect "and shadows nothing else" (parameter-ref cold-a) 10))
  (expect "spilled restores" (parameter-ref spilled) 39)

  ;; --- Unwinding through a failure ----------------------------------------
  ;;
  ;; The restore is a `finally`, so an exception on its way out still puts the
  ;; environment back. Without this, one failed call would leave every later
  ;; `display` writing into a dead StringWriter.
  (def w2 (StringWriter.))
  (def outcome
    (try (parameterize ((indent 9) (current-output-port (cast TextOutputPort w2)))
           (.Substring "ab" 99))
      #:catch (System.ArgumentOutOfRangeException)))

  (match outcome
    ((Ok s) (println "FAILURE: the body was supposed to throw"))
    ((Err e) (println "ok: the body threw")))

  (expect "restored after a throw" (describe) "0/quiet")
  (expect "port restored after a throw" (.ToString w2) "")

  ;; --- Tail calls under the restore ---------------------------------------
  (expect "named let inside parameterize" (sum-to 4) 5)

  0)

;; Takes the parameter itself, not its value.
(: read-twice (-> (Param int) int))
(defun (read-twice p)
  (+ (parameter-ref p) (parameter-ref p)))
