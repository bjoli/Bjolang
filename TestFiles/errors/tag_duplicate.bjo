;; A tag selects one case, and selection has no second question to ask when
;; two cases answer to one name.
;; EXPECT-ERROR: the tag `from` is already on a case of tag_duplicate/Q
(import (std prelude))

(type (: Q (Union (CFrom Symbol #:tag from)
                  (CInto Symbol #:tag from)
                  (CPlain (List Symbol)))))

(defun (main args) 0)
