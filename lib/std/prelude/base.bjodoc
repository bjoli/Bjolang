;; Docs of std/prelude/core.bjo, read through (:doc #:file "base.bjodoc").
;; The texts are samizdat markup: code in prose is @code{...}.

(:doc sqrt
  (summary "The square root of a number.")
  (arg x "The number. An integer argument is widened to a double.")
  (returns "The non-negative square root, as a double. NaN for a negative x.")
  (see * recip)
  (example """
    (sqrt 9)      ; 3.0
    (sqrt 2.0)    ; 1.4142135623730951
    """)
  (reference """
    @code{System.Math.Sqrt}. The rest of @code{System.Math} is in
    @code{(std maths)}.
    """))

;; ---------------------------------------------------------------------------
;; Numbers to strings
;; ---------------------------------------------------------------------------

(:doc int->string
  (summary "The text of an int, in decimal or another base, the same on every machine.")
  (arg n "The number.")
  (key #:radix "The base, from 2 to 36. 10 when not given.")
  (key #:upper "Write the letter digits in upper case.")
  (returns "Its digits, with an ASCII minus when negative.")
  (raises System.ArgumentOutOfRangeException "When the radix is not from 2 to 36.")
  (see string->int long->string displayed)
  (example """
    (int->string 255)                         ; "255"
    (int->string 255 #:radix 16)              ; "ff"
    (int->string 255 #:radix 16 #:upper #t)   ; "FF"
    (int->string -5 #:radix 2)                ; "-101"
    (string-pad-left (int->string 233 #:radix 16 #:upper #t) 4 #:with #\0)   ; "00E9"
    """)
  (reference """
    Does not use the c# culture, where minus can come back with U+2212 MINUS SIGN.
    The result is guaranteed to round-trip through @code{string->int} with
    the same radix.

    Digits past 9 are letters: a is 10 and z is 35. A negative number is a
    minus and the digits of its magnitude, not its two's complement. No
    prefix such as @code{0x} is written.
    """))

(:doc long->string
  (summary "The text of a long, in decimal or another base, the same on every machine.")
  (arg n "The number.")
  (key #:radix "The base, from 2 to 36. 10 when not given.")
  (key #:upper "Write the letter digits in upper case.")
  (returns "Its digits, with an ASCII minus when negative.")
  (raises System.ArgumentOutOfRangeException "When the radix is not from 2 to 36.")
  (see int->string string->long displayed)
  (example """
    (long->string 1099511627776L #:radix 16)   ; "10000000000"
    """)
  (reference """
    As @code{int->string}, for 64 bits.
    """))

(:doc decimal->string
  (summary "The text of a decimal, the same on every machine.")
  (arg n "The number.")
  (returns "Its digits, with a point and the digits after it that the decimal holds.")
  (see double->string string->decimal displayed)
  (example """
    (decimal->string 1.50M)   ; "1.50"
    """)
  (reference """
    A decimal keeps its scale, so 1.50M and 1.5M are equal and write as
    "1.50" and "1.5".
    """))

(:doc bigint->string
  (summary "The decimal text of a bigint, the same on every machine.")
  (arg n "The number.")
  (returns "All its digits, with an ASCII minus when negative.")
  (see long->string string->bigint displayed))

(:doc int128->string
  (summary "The decimal text of an int128.")
  (arg n "The number.")
  (returns "Its digits, with an ASCII minus when negative.")
  (see long->string string->int128 displayed))

(:doc uint128->string
  (summary "The decimal text of a uint128.")
  (arg n "The number.")
  (returns "Its digits.")
  (see int128->string string->uint128 displayed))

(:doc byte->string
  (summary "The decimal text of a byte.")
  (arg n "The number.")
  (returns "Its digits, from 0 to 255.")
  (see int->string displayed))

(:doc double->string
  (summary "The text of a double, the same on every machine.")
  (arg n "The number.")
  (returns "The shortest text that reads back as the same double, with a point as the decimal separator.")
  (see string->double int->string displayed)
  (example """
    (double->string 6.0)   ; "6"
    (double->string 2.5)   ; "2.5"
    """)
  (reference """
    .NET's default formatting in the invariant culture, so it round-trips
    through @code{string->double} on any machine. A whole number has no
    point: 6.0 is written @code{6}. Use @code{(std fmt)} when the shape of
    the output matters.
    """))

(:doc number->string
  (summary "The decimal text of an int, under the name R7RS uses.")
  (arg n "The number.")
  (returns "The string representation of n, identical to int->string.")
  (see int->string displayed)
  (reference """
    Only for @code{int}. Other numeric types have their own conversions, or
    @code{displayed}.
    """))

;; ---------------------------------------------------------------------------
;; Printing
;; ---------------------------------------------------------------------------

(:doc Written
  (summary "Trait for the text a value is written as, which the reader reads back.")
  (see written write-into Displayed)
  (reference """
    As Scheme's @code{write}: a string is in quotes with its escapes, a
    char is @code{#\a}, a long is @code{21L}, and a double always has a
    point, such as @code{2.0}. A @code{float}, an @code{int128} and a
    @code{uint128} have no suffix, and are written with their type:
    @code{(: 2.5 float)}. An implementation gives @code{write-into};
    @code{written} by default rents a builder and calls it. A type whose
    text is at hand gives @code{written} too, and adds it in
    @code{write-into}.

    Every type is @code{Written}. With no implementation of its own, a type
    is written as .NET's @code{ToString} gives it, in the invariant culture.
    """))

(:doc written
  (summary "The text a value is written as.")
  (arg x "The value.")
  (returns "Its written text.")
  (see displayed write-into)
  (example """
    (written "a")             ; "\"a\""
    (written #\a)             ; "#\\a"
    (written 21L)             ; "21L"
    (written (list "a" 1))    ; "(\"a\" 1)"
    """))

(:doc write-into
  (summary "Adds the written text of a value to a builder.")
  (arg x "The value.")
  (arg b "The builder.")
  (see written display-into)
  (reference """
    What a container calls on each element, so that a nested value is
    written into one builder.
    """))

(:doc Displayed
  (summary "Trait for the text a value shows a person.")
  (see displayed display-into Written)
  (reference """
    As Scheme's @code{display}: a string is its text, without quotes. Every
    @code{Displayed} type is @code{Written}. A type with no implementation
    of its own is displayed as it is written. @code{println}, @code{print}
    and @code{#"...${x}..."} use @code{displayed}.

    The containers display their elements displayed and write them
    written: a @code{List} as @code{(1 2 3)}, a @code{Vec} as
    @code{[1 2 3]}, an @code{Array} as @code{#[1 2 3]}, a @code{Map} as
    @code{#map((k v) ...)}, an @code{Option} as @code{(Some x)} or
    @code{None}, a @code{Result} as @code{(Ok x)} or @code{(Err e)}, a
    @code{Tuple} as @code{(Tuple 1 2)}, and a @code{Box} as
    @code{(Box x)}. A @code{Seq} is @code{(Seq ...)}, without being walked.
    """))

(:doc displayed
  (summary "The text a value prints as.")
  (arg x "The value.")
  (returns "Its text, as print and println write it.")
  (see written display-into print println)
  (example """
    (displayed 42)                ; "42"
    (displayed #\a)               ; "a"
    (displayed (list 1 2 3))      ; "(1 2 3)"
    (displayed [1 2])             ; "[1 2]"
    (displayed (Some "x"))        ; "(Some x)"
    """))

(:doc display-into
  (summary "Adds the displayed text of a value to a builder.")
  (arg x "The value.")
  (arg b "The builder.")
  (see displayed write-into))

(:doc elements-print-into
  (summary "Adds the elements of a collection to a builder, between two strings.")
  (arg open "The text before the elements.")
  (arg xs "The collection: any Iterable.")
  (arg close "The text after the elements.")
  (arg b "The builder.")
  (arg each "Adds one element, such as write-into or display-into.")
  (see entries-print-into write-into display-into)
  (example """
    (impl (Written (Bag %a))
      (where (Written %a))
      (defun (write-into s b)
        (elements-print-into "#bag(" s ")" b (fun (x b) (write-into x b)))))
    """)
  (reference "A space goes between two elements."))

(:doc entries-print-into
  (summary "Adds the entries of a map to a builder, between two strings, each as (k v).")
  (arg open "The text before the entries.")
  (arg xs "Any Iterable of (Tuple k v).")
  (arg close "The text after the entries.")
  (arg b "The builder.")
  (arg each-key "Adds one key.")
  (arg each-value "Adds one value.")
  (see elements-print-into))

(:doc ->str
  (summary "Deprecated: use @code{displayed}, and implement @code{Displayed} or @code{Written}.")
  (arg x "The value.")
  (returns "What @code{displayed} gives.")
  (see displayed written)
  (reference """
    An implementation of @code{->str} is called by @code{->str} only, not
    by @code{displayed}, @code{println} or an interpolation.
    """))

(:doc print
  (summary "Writes a value's text to the current output port.")
  (arg x "The value, written through its displayed.")
  (see println displayed display)
  (reference """
    @code{(display (displayed x))}: no newline after it. The port is
    @code{current-output-port}, so @code{parameterize} redirects it.
    """))

(:doc println
  (summary "Writes a value's text to the current output port, then a newline.")
  (arg x "The value, written through its displayed.")
  (see print displayed displayln)
  (example """
    (println 42)          ; 42
    (println [1 2 3])     ; [1 2 3]
    """)
  (reference """
    @code{(displayln (displayed x))}. The port is @code{current-output-port}.
    """))

(:doc ignore
  (summary "Discards a value that would otherwise have to be used.")
  (arg x "The value.")
  (see unit detach)
  (example """
    (ignore (map-try-ref m k))
    (ignore (bjo (log-visit user)))   ; detaches the promise
    """)
  (reference """
    The method of the @code{Discard} trait. An expression in statement
    position must evaluate to @code{Unit}; any other type (including a
    @code{Result} or a .NET method return value) will trigger a compiler
    error. Use @code{ignore} to explicitly discard unwanted values.
    For most types it does nothing.

    On a @code{Promise} it is @code{detach}: the result is not wanted, but
    a failure inside the fiber is reported as unhandled rather than lost
    silently. A fiber that stopped because it was cancelled is not
    reported.
    """))

;; ---------------------------------------------------------------------------
;; Boxes
;; ---------------------------------------------------------------------------

(:doc Box
  (summary "A mutable cell holding one value.")
  (tparam %a "What it holds.")
  (see make-box box-ref box-set! deref)
  (example """
    (def count (make-box 0))
    (box-set! count (+ (box-ref count) 1))
    (deref count)   ; 1
    """)
  (reference """
    A one-element array behind an opaque struct. Copying a box copies the
    reference to the array, so every copy reads and writes the same cell.
    It has a @code{Derefable} implementation, so @code{deref} and
    @code{get} read it, and prints as @code{(Box x)}.
    """))

(:doc make-box
  (summary "A new box holding a value.")
  (arg elem "What it starts out holding.")
  (returns "A box of its own.")
  (see box-ref box-set!))

(:doc box-ref
  (summary "What a box holds.")
  (arg b "The box.")
  (returns "The value most recently put in it.")
  (see box-set! deref))

(:doc box-set!
  (summary "Replaces what a box holds, in place.")
  (arg box "The box.")
  (arg val "Its new value.")
  (see box-ref make-box))

;; ---------------------------------------------------------------------------
;; Reading and writing by key
;; ---------------------------------------------------------------------------

(:doc ref
  (summary "Looks up an element in a collection by index or key.")
  (arg coll "The collection to index.")
  (arg i "The lookup key or zero-based integer index.")
  (returns "The element associated with i.")
  (raises System.IndexOutOfRangeException "When coll is an Array or Vec and i is out of bounds.")
  (raises System.Collections.Generic.KeyNotFoundException "When coll is a Map and i is not present.")
  (see try-ref ref-set get vec-ref map-ref)
  (example """
    (ref [10 20 30] 1)          ; 20
    (ref #map("a" 1) "a")       ; 1
    """)
  (reference """
    The primary method of the @code{Refable} trait, also used by @code{get}
    for nested path lookups.

    Supported collections:
    @itemlist{
      @item{@code{Array} and @code{Vec}: indexed by integer.}
      @item{@code{Map}: indexed by key.}
      @item{@code{string}: indexed by @code{StringCursor}, returning a @code{char}.}
      @item{@code{VecBuilder}, @code{TransientVec} and @code{TransientMap},
        the collections @code{ref-set!} writes, and @code{MutableVec} and
        @code{MutableMap} in their own modules.}
    }
    """))

(:doc try-ref
  (summary "Safely looks up an element by index or key, returning an Option.")
  (arg coll "The collection to index.")
  (arg i "The lookup key or integer index.")
  (returns "(Some element) if present; None if the key is missing or index is out of bounds.")
  (see ref try-get map-try-ref)
  (example """
    (try-ref [10 20 30] 5)      ; None
    (try-ref #map("a" 1) "b")   ; None
    """)
  (reference """
    A non-throwing lookup method on the @code{Refable} trait. Returns @code{None}
    when:
    @itemlist{
      @item{An index into a @code{Vec} is out of bounds.}
      @item{A key in a @code{Map} does not exist.}
      @item{A @code{StringCursor} has reached the end of a string.}
    }

    Note: for .NET @code{Array}, the default implementation calls @code{ref},
    which will throw if the index is out of bounds.
    """))

(:doc ref-set
  (summary "Returns a copy of a persistent collection with an updated key or index.")
  (arg coll "The persistent collection to update (unmodified).")
  (arg i "The index or key to update.")
  (arg x "The new value to associate with i.")
  (returns "A new collection containing the updated value.")
  (raises System.IndexOutOfRangeException "When coll is a Vec and i is out of bounds.")
  (see ref set update vec-set map-set)
  (example """
    (ref-set [1 2 3] 0 9)       ; [9 2 3]
    (ref-set #map("a" 1) "b" 2) ; #map(("a" 1) ("b" 2))
    """)
  (reference """
    The method of the @code{Settable} trait, supporting persistent updates
    for @code{Vec} and @code{Map}. Also used by @code{set} and @code{update}
    when traversing nested key paths.

    For a @code{Vec}, updating an existing index is O(log n); an out-of-range index throws.
    For a @code{Map}, sets an existing key or inserts a new one in O(log n).
    """))

(:doc ref-set!
  (summary "Writes a value at a key or index of a mutable collection, in place.")
  (arg coll "The collection to write.")
  (arg i "The index or key to write.")
  (arg x "The value to put at i.")
  (raises System.IndexOutOfRangeException "When coll is indexed by integer and i is out of bounds.")
  (see ref ref-set array-set!)
  (example """
    (def a (make-array 3 #:fill 0))
    (ref-set! a 1 5)            ; a holds 0 5 0
    (set! a 2 7)                ; the same write, through set!
    """)
  (reference """
    The method of the @code{Settable!} trait, the write in place that goes
    with @code{ref}, as @code{Addable!} goes with @code{Addable}. @code{set!}
    with a path writes its last key through it.

    Supported collections:
    @itemlist{
      @item{@code{Array}, @code{VecBuilder} and @code{TransientVec}: indexed by integer.}
      @item{@code{TransientMap}: by key, and a key that was not there is added.}
      @item{@code{MutableVec} and @code{MutableMap}, in @code{(std mutable vec)} and @code{(std mutable map)}.}
    }

    A persistent @code{Vec} or @code{Map} has no impl, because there is
    nothing to write in place: @code{ref-set} and @code{set} answer a copy.
    """))

(:doc deref
  (summary "Returns the current value held in a cell, box, or parameter.")
  (arg p "The cell or parameter.")
  (returns "The value currently stored in p.")
  (see try-deref box-ref parameter-ref get)
  (reference """
    The primary method of the @code{Derefable} trait, implemented for
    @code{Box} (calling @code{box-ref}) and @code{Param} (calling
    @code{parameter-ref}). Also used by @code{get} when called without path steps.
    """))

(:doc try-deref
  (summary "Returns the value held in a cell as an Option.")
  (arg p "The cell or parameter.")
  (returns "(Some value) if present, or None if the cell is empty.")
  (see deref)
  (reference """
    The optional access method of the @code{Derefable} trait. The default
    implementation returns @code{(Some (deref p))}, which both @code{Box}
    and @code{Param} use.
    """))

(:doc deref-set!
  (summary "Puts a new value in a cell, in place.")
  (arg cell "The cell to write.")
  (arg x "Its new value.")
  (see deref box-set! ref-set!)
  (example """
    (def hits (make-box 0))
    (deref-set! hits 1)
    (set! hits 2)               ; the same write: hits is not a def/mutable
    (get hits)                  ; 2
    """)
  (reference """
    The method of the @code{Derefable!} trait, the write in place that goes
    with @code{deref}, as @code{Settable!} goes with @code{Settable}.
    Implemented for @code{Box}.

    @code{(set! name value)} writes through it when @code{name} is not a
    @code{def/mutable}: the binding cannot change, so what it holds does. A
    @code{def/mutable} is written as a variable, whatever it holds.

    A @code{Param} has no impl. It is given a value for an extent with
    @code{parameterize}, and is not written in place.
    """))

;; ---------------------------------------------------------------------------
;; Pairs
;; ---------------------------------------------------------------------------

(:doc fst
  (summary "The first item of a pair.")
  (arg p "The pair.")
  (returns "Its first item.")
  (see snd)
  (example """
    (fst (Tuple 1 "a"))             ; 1
    (list-map fst (list (Tuple 1 "a") (Tuple 2 "b")))   ; (1 2)
    """)
  (reference """
    For a pair only, as in F#. Take a longer tuple apart with a pattern:
    @code{(def (a b c) t)} or @code{(match t ((Tuple a _ _) a))}.
    """))

(:doc snd
  (summary "The second item of a pair.")
  (arg p "The pair.")
  (returns "Its second item.")
  (see fst)
  (example """
    (snd (Tuple 1 "a"))   ; "a"
    """))

(:doc grammar-checked
  (summary "The Ok value of a grammar's check, for a literal the compiler checked.")
  (arg r "What the check gave.")
  (returns "The Ok value.")
  (see panic!)
  (reference """
    The compiler calls a check of a @code{def/grammar} on a literal when it
    compiles the literal, and refuses the literal on an Err. The program calls
    the check again when it runs, and this function takes the value out. The
    Err case calls @code{panic!}, and is reached only by a check that does not
    give the same result for the same value.
    """))

(:doc option-map
  (summary "Applies a function to the value inside a Some.")
  (arg f "The function applied to the value. It may suspend.")
  (arg opt "The Option.")
  (returns "(Some (f v)) for (Some v), and None for None.")
  (see option-filter option-or result-map some->)
  (example """
    (option-map string-length (Some "abc"))   ; (Some 3)
    """)
  (reference """
    To chain a function that itself returns an @code{Option}, use
    @code{some->}, or @code{bind} from @code{(std monad)}.
    """))

(:doc option-filter
  (summary "A Some whose value a predicate holds for, else None.")
  (arg pred "The predicate. It may suspend.")
  (arg opt "The Option.")
  (returns "opt when it is (Some v) and (pred v) holds; None otherwise.")
  (see option-map)
  (example """
    (option-filter (fun (n) (> n 0)) (Some 4))    ; (Some 4)
    (option-filter (fun (n) (> n 0)) (Some -3))   ; None
    """))

(:doc option-or
  (summary "The first of two Options that is a Some.")
  (arg opt "The Option tried first.")
  (arg other "The Option returned when opt is None.")
  (returns "opt when it is a Some, else other.")
  (see option-ref-or option-map)
  (example """
    (option-or (map-try-ref local k) (map-try-ref global k))
    """)
  (reference """
    Both arguments are evaluated, as for any call. To get a plain value
    out with a default, use @code{option-ref-or}.
    """))

(:doc option->result
  (summary "An Option as a Result, with an error for None.")
  (arg opt "The Option.")
  (arg e "The error for None.")
  (returns "(Ok v) for (Some v), and (Err e) for None.")
  (see result->option)
  (example """
    (option->result (map-try-ref users id) "no such user")
    """))

(:doc AsException
  (summary "An error that can be raised as an exception.")
  (see raise-err as-exception)
  (reference """
    @code{Exception} itself is one, and so is each error type that keeps the
    exception it was made from: the prelude's @code{FsError} and
    @code{(std run)}'s @code{RunError}. @code{raise-err} takes the error of
    any of them.
    """))

(:doc as-exception
  (summary "The exception an error stands for.")
  (arg e "The error.")
  (returns "The exception to raise for it.")
  (see AsException raise-err))

(:doc raise-err
  (summary "The value inside an Ok, or the exception of an Err raised.")
  (arg r "A result whose error is an AsException: an Exception, an FsError, a RunError.")
  (returns "The value in @code{Ok}.")
  (see result-ref AsException)
  (example """
    (def text (raise-err (file-read-text "config.toml")))
    """)
  (reference """
    For a script that wants the exception instead of the @code{Result}, for
    a stack trace or for a @code{try} further out. The exception is the one
    the error was made from, with its own type, which @code{result-ref} does
    not keep.
    """))

(:doc result-and-then
  (summary "Passes the value inside an Ok to a function that returns a Result.")
  (arg f "The next step. It returns a Result, and it may suspend.")
  (arg r "The Result.")
  (returns "(f v) for (Ok v); an Err unchanged, and f is not called.")
  (see result-map result-map-err)
  (example """
    (result-and-then parse-config (file-read-text "app.conf"))
    """))

(:doc result-map-err
  (summary "Applies a function to the value inside an Err.")
  (arg f "The function applied to the error. It may suspend.")
  (arg r "The Result.")
  (returns "(Err (f e)) for (Err e); an Ok unchanged.")
  (see result-map result->option)
  (example """
    (result-map-err (fun (e) (str "config: " e)) (Err "no port"))   ; (Err "config: no port")
    """))

(:doc result-ref
  (summary "The value inside an Ok.")
  (arg r "The Result. Must be Ok.")
  (returns "The value it holds.")
  (raises System.InvalidOperationException "When r is an Err.")
  (see result-ref-or option-ref ok?))

(:doc result-ref-or
  (summary "Returns the value inside an Ok, or a fallback for an Err.")
  (arg r "The Result.")
  (arg fallback "The value to return if r is an Err. Eagerly evaluated.")
  (returns "The value r holds, or fallback.")
  (see result-ref option-ref-or)
  (example """
    (result-ref-or (try (string->int text) #:catch (System.FormatException)) 0)
    """))

(:doc result->option
  (summary "A Result as an Option, without the error.")
  (arg r "The Result.")
  (returns "(Some v) for (Ok v), and None for an Err.")
  (see option->result ok?))

(:doc ok?
  (summary "Whether a Result is Ok.")
  (arg r "The Result.")
  (returns "#t for Ok, #f for Err.")
  (see err?))

(:doc err?
  (summary "Whether a Result is Err.")
  (arg r "The Result.")
  (returns "#t for Err, #f for Ok.")
  (see ok?))

(:doc result-map
  (summary "Applies a transformation function to the value inside an Ok.")
  (arg f "The function applied to the Ok value, returning a new value.")
  (arg r "The Result to transform.")
  (returns "(Ok (f v)) for (Ok v); returns an Err unchanged.")
  (see ok? Ok)
  (example """
    (result-map string-length (Ok "abc"))   ; (Ok 3)
    """)
  (reference """
    To chain a function that itself returns a @code{Result}, use @code{try->}
    instead.

    @code{f} may be either colour. A step that waits has to be a
    @code{(bjoroutine (x) ...)}; written @code{(fun (x) ...)}, the same call
    selects the blocking copy and parks the fiber's thread.
    """))

;; ---------------------------------------------------------------------------
;; Failure
;; ---------------------------------------------------------------------------

(:doc Exception
  (summary "System.Exception, the type every .NET exception derives from.")
  (see raise Err)
  (reference """
    The error type of the prelude's fallible operations, such as
    @code{(Result Exception InputPort)}. The @code{Err} carries the real
    .NET exception, so a handler can test for a more specific type.
    """))

(:doc panic!
  (summary "Stops the program with a message.")
  (arg msg "What went wrong, written to the error port.")
  (key #:exit-code "The process's exit code. 1 when not given.")
  (returns "Nothing: it never returns, so it fits where any type is wanted.")
  (see raise)
  (example """
    (when (vec-empty? args)
      (panic! "usage: tool FILE" #:exit-code 2))
    """)
  (reference """
    For a program that cannot go on. It writes @code{msg} and a newline to
    @code{current-error-port}, flushes it, and exits the process. No
    @code{finally} and no scope's cleanup runs.

    At the REPL it does not exit: it throws an exception of its own type,
    which the REPL reports as a panic.
    """))
