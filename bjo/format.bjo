;; bjo/format.bjo — `bjo fmt`: a canonical layout of Bjolang source.
;;
;; The line breaks are chosen by a pretty printer, in the style of `raco fmt`,
;; and the source's own are not kept. The indentation is that of bjomode.el.
;;
;;   - Of the layouts a form may have, the one chosen overflows `wide` columns
;;     the least, and of those has the fewest lines (see "Measures").
;;   - What is kept: comments, one blank line in a row, the lines and columns of
;;     tables (`import/extern`, `import/class`, `defeffect`), the groups of an
;;     export list, and how many forms are on the head's line of a macro named
;;     `def...` or `with-...`.
;;   - Strings are never split. A tab becomes a space, or `\t` in a string.
;;   - The printer works out where each line starts only to judge what fits.
;;     Its line breaks are then indented by the Emacs rules.
;;
;; The indentation follows Emacs's own algorithm rather than an idea of it,
;; because the two have to agree: `calculate-lisp-indent` for the column a
;; line's form lines up under, `lisp-indent-specform` and `lisp-indent-defform`
;; for a form with a body, the rules `bjo-indent-function` adds, and even the
;; column `lisp-indent-region` keeps for the following lines at the same depth.
;; The comments below say which of them each part is.
;;
;; A string's lines are text, not code. Its continued lines move with it, but
;; its value is never changed. The result is checked against the source: it must
;; have the same tokens in the same order, with strings compared by value. If
;; not, the file is left alone.

(export format-source wide)

(import (std prelude) (std mutable map))

;; ---------------------------------------------------------------------------
;; Tokens

(type (: Tok (Union
              (: TOpen string)
              (: TClose string)
              ;; A symbol, a number, a keyword, a character, or a prefix such
              ;; as ' or #' — anything up to a space, a bracket, a quote or a
              ;; semicolon.
              (: TAtom string)
              ;; A string of any kind, as written, over several lines too.
              (: TStr string)
              (: TComment string)
              (: TSpace string)
              TNewline)))

(: text-between (-> (Vec char) int int string))
(defun (text-between cs from to)
  (def sb (stringbuilder-empty))
  (let go ((i from))
    (when (< i to)
      (stringbuilder-add! sb (vec-ref cs i))
      (go (+ i 1))))
  (stringbuilder->string sb))

(: char-at (-> (Vec char) int char))
(defun (char-at cs i)
  (if (< i (vec-length cs)) (vec-ref cs i) #\nul))

(: opening? (-> char bool))
(defun (opening? c) (or (= c #\() (= c #\[) (= c #\{)))

(: closing? (-> char bool))
(defun (closing? c) (or (= c #\)) (= c #\]) (= c #\})))

(: line-break? (-> (Vec char) int bool))
(defun (line-break? cs i)
  (or (= (char-at cs i) #\newline)
      (and (= (char-at cs i) #\return) (= (char-at cs (+ i 1)) #\newline))))

(: blank-char? (-> (Vec char) int bool))
(defun (blank-char? cs i)
  (and (< i (vec-length cs)) (char-whitespace? (vec-ref cs i)) (not (line-break? cs i))))

;; What the compiler's lexer counts as part of a name: a character literal's
;; name, `#\space`, is a run of them.
(: symbol-char? (-> char bool))
(defun (symbol-char? c)
  (not (or (char-whitespace? c) (opening? c) (closing? c)
           (= c #\,) (= c #\:) (= c #\") (= c #\;) (= c #\'))))

(: atom-end (-> (Vec char) int int))
(defun (atom-end cs i)
  (def c (char-at cs i))
  (if (or (>= i (vec-length cs))
          (char-whitespace? c) (opening? c) (closing? c) (= c #\") (= c #\;))
      i
      (atom-end cs (+ i 1))))

(: blank-end (-> (Vec char) int int))
(defun (blank-end cs i)
  (if (blank-char? cs i) (blank-end cs (+ i 1)) i))

(: line-end (-> (Vec char) int int))
(defun (line-end cs i)
  (if (or (>= i (vec-length cs)) (line-break? cs i)) i (line-end cs (+ i 1))))

(: after-break (-> (Vec char) int int))
(defun (after-break cs i)
  (if (= (char-at cs i) #\return) (+ i 2) (+ i 1)))

(: quotes-at (-> (Vec char) int int))
(defun (quotes-at cs i)
  (let go ((p i))
    (if (= (char-at cs p) #\") (go (+ p 1)) (- p i))))

(: line-of (-> (Vec char) int int))
(defun (line-of cs i)
  (let go ((k 0) (line 1))
    (cond
      ((>= k i) line)
      ((= (vec-ref cs k) #\newline) (go (+ k 1) (+ line 1)))
      (else (go (+ k 1) line)))))

(: unterminated (-> (Vec char) int string (Result string int)))
(defun (unterminated cs i what)
  (Err #"line ${(int->string (line-of cs i))}: ${what} that does not end"))

;; Past the end of the string at `i`, which is one of the three kinds the
;; lexer reads: plain, raw on one line, or raw over several lines, which ends
;; on the first line whose text begins with as many quotes as opened it.
(: string-end (-> (Vec char) int (Result string int)))
(defun (string-end cs i)
  (def n (vec-length cs))
  (def k (quotes-at cs i))
  (def opened (+ i k))
  (def w (blank-end cs opened))
  (cond
    ((and (>= k 3) (>= w n)) (unterminated cs i "a raw string"))
    ((and (>= k 3) (line-break? cs w))
     (let lines ((p (after-break cs w)))
       (def start (blank-end cs p))
       (def e (line-end cs p))
       (cond
         ((>= p n) (unterminated cs i "a raw string"))
         ((= (quotes-at cs start) k) (Ok (+ start k)))
         ((>= e n) (unterminated cs i "a raw string"))
         (else (lines (after-break cs e))))))
    ((>= k 3)
     (let one ((p opened))
       (def run (quotes-at cs p))
       (cond
         ((or (>= p n) (line-break? cs p)) (unterminated cs i "a raw string"))
         ((>= run k) (Ok (+ p k)))
         ((> run 0) (one (+ p run)))
         (else (one (+ p 1))))))
    (else
     (let plain ((p (+ i 1)))
       (cond
         ((>= p n) (unterminated cs i "a string"))
         ((= (vec-ref cs p) #\\) (plain (+ p 2)))
         ((= (vec-ref cs p) #\") (Ok (+ p 1)))
         (else (plain (+ p 1))))))))

;; Past the end of the `#"..."` at `i`. A `${...}` hole is code, delimited by
;; brace depth, with strings and `#\{` inside it skipped whole, as the lexer
;; does.
(: interpolated-end (-> (Vec char) int (Result string int)))
(defun (interpolated-end cs i)
  (def n (vec-length cs))
  (let outside ((p (+ i 2)))
    (cond
      ((>= p n) (unterminated cs i "an interpolated string"))
      ((= (vec-ref cs p) #\") (Ok (+ p 1)))
      ((= (vec-ref cs p) #\\) (outside (+ p 2)))
      ((and (= (vec-ref cs p) #\$) (= (char-at cs (+ p 1)) #\{))
       (let hole ((q (+ p 2)) (depth 1))
         (def c (char-at cs q))
         (cond
           ((>= q n) (unterminated cs i "an interpolated string"))
           ((= c #\")
            (match (string-end cs q)
              ((Ok e) (hole e depth))
              ((Err why) (Err why))))
           ((and (= c #\#) (= (char-at cs (+ q 1)) #\\)) (hole (+ q 3) depth))
           ((= c #\{) (hole (+ q 1) (+ depth 1)))
           ((and (= c #\}) (= depth 1)) (outside (+ q 1)))
           ((= c #\}) (hole (+ q 1) (- depth 1)))
           (else (hole (+ q 1) depth)))))
      (else (outside (+ p 1))))))

;; Past the end of the character literal at `i`: a name, `#\space`, or any one
;; character, `#\(` and `#\;` included.
(: char-literal-end (-> (Vec char) int int))
(defun (char-literal-end cs i)
  (def start (+ i 2))
  (def name-end
    (let go ((p start))
      (if (and (< p (vec-length cs)) (symbol-char? (vec-ref cs p))) (go (+ p 1)) p)))
  (cond
    ((> (- name-end start) 1) name-end)
    ((< start (vec-length cs)) (+ start 1))
    (else start)))

;; The token at `i`, and where the next one starts.
(: token-at (-> (Vec char) int (Result string (Tuple Tok int))))
(defun (token-at cs i)
  (def c (vec-ref cs i))
  (defun (to e) (Tuple (TAtom (text-between cs i e)) e))
  (cond
    ((line-break? cs i) (Ok (Tuple TNewline (after-break cs i))))
    ((blank-char? cs i)
     (def e (blank-end cs i))
     (Ok (Tuple (TSpace (text-between cs i e)) e)))
    ((= c #\;)
     (def e (line-end cs i))
     (Ok (Tuple (TComment (string-trim-right (text-between cs i e))) e)))
    ((opening? c) (Ok (Tuple (TOpen (char->string c)) (+ i 1))))
    ((closing? c) (Ok (Tuple (TClose (char->string c)) (+ i 1))))
    ((= c #\")
     (def (Ok e) (string-end cs i)
       :leave ((Err why) (Err why)))
     (Ok (Tuple (TStr (without-continued-indent (text-between cs i e) (column-at cs i))) e)))
    ((and (= c #\#) (= (char-at cs (+ i 1)) #\"))
     (def (Ok e) (interpolated-end cs i)
       :leave ((Err why) (Err why)))
     (Ok (Tuple (TStr (without-continued-indent (text-between cs i e) (column-at cs i))) e)))
    ((and (= c #\#) (= (char-at cs (+ i 1)) #\\)) (Ok (to (char-literal-end cs i))))
    (else
     (Ok (to (match (quantity-end cs i)
               ((Some e) e)
               (None (atom-end cs i))))))))

;; Past the end of the quantity literal at `i`, such as `<9.81 m/s^2>`, if there
;; is one. It ends at the first `>` on its line, and is one token although it
;; has spaces and perhaps brackets in it. A prefix, as in `,<1 m>`, is included.
(: quantity-end (-> (Vec char) int (Option int)))
(defun (quantity-end cs i)
  (def start
    (let go ((p i))
      (if (prefix-char? (char-at cs p))
          (go (+ p 1))
          p)))
  (def c (char-at cs (+ start 1)))
  (def number?
    (or (char-numeric? c)
        (and (or (= c #\.) (= c #\-)) (char-numeric? (char-at cs (+ start 2))))))
  (if (and (= (char-at cs start) #\<) number?)
      (let go ((p (+ start 1)))
        (cond
          ((or (>= p (vec-length cs)) (line-break? cs p)) None)
          ((= (vec-ref cs p) #\>) (Some (+ p 1)))
          (else (go (+ p 1)))))
      None))

(: tokenize (-> (Vec char) (Result string (List Tok))))
(defun (tokenize cs)
  (let go ((i 0) (out Nil))
    (if (>= i (vec-length cs))
        (Ok (list-reverse out))
        (match (token-at cs i)
          ((Err why) (Err why))
          ((Ok (Tuple tok next)) (go next (Cons tok out)))))))

;; The tokens that make the program: everything but the spacing, and a string
;; with its tabs written `\t`, as the layout writes them, and its continued
;; lines joined, since the layout re-indents them. A comment's words are
;; compared, its tabs being spaces once laid out.
(: significant (-> (List Tok) (List string)))
(defun (significant toks)
  (loop (:for t toks)
        (:acc out (listing (match t
                             ((TStr s) (escape-tabs (joined-continuations s)))
                             ((TComment s) (string-replace (string-replace s "\t" "") " " ""))
                             (_ (tok-text t))))
              #:when (meaningful? t))
    => out))

(: meaningful? (-> Tok bool))
(defun (meaningful? t)
  (match t
    ((TSpace _) #f)
    (TNewline #f)
    (_ #t)))

(: tok-text (-> Tok string))
(defun (tok-text t)
  (match t
    ((TOpen s) s)
    ((TClose s) s)
    ((TAtom s) s)
    ((TStr s) s)
    ((TComment s) s)
    ((TSpace s) s)
    (TNewline "\n")))

;; A string's tabs written `\t`, as its value is unchanged by: outside the
;; holes of an interpolated string, and never in a raw one, which has no
;; escapes. A tab after a backslash is kept: the continuations are joined
;; already, so the lexer rejects it, and fmt does not make it mean something.
(: escape-tabs (-> string string))
(defun (escape-tabs s)
  (cond
    ((string-starts-with? s "\"\"\"") s)
    ((not (string-contains? s "\t")) s)
    (else
     (def cs (string->vec s))
     (def n (vec-length cs))
     (def sb (stringbuilder-empty))
     (defun (copy from to) (stringbuilder-add-string! sb (text-between cs from to)))
     (let go ((p 0))
       (when (< p n)
         (def c (vec-ref cs p))
         (cond
           ((= c #\\)
            (copy p (+ p 2))
            (go (+ p 2)))
           ((= c #\tab)
            (stringbuilder-add-string! sb "\\t")
            (go (+ p 1)))
           ((and (= c #\$) (= (char-at cs (+ p 1)) #\{) (string-starts-with? s "#\""))
            (def past (hole-end cs (+ p 2)))
            (copy p past)
            (go past))
           (else
            (stringbuilder-add! sb c)
            (go (+ p 1))))))
     (stringbuilder->string sb))))

;; ---------------------------------------------------------------------------
;; Line continuations
;;
;; A backslash that ends a line in a string stands for nothing, and neither
;; does the next line's indentation up to the column the string's text starts
;; at; indentation beyond that is text. What a continued line says therefore
;; depends on where the string starts, which the layout moves. So a string is
;; read without the indentation a continuation drops, and written with as much
;; as where it is written drops: the text it stands for stays the same.
;;
;; A raw string has no escapes. In the holes of an interpolated string nothing
;; is changed: a string in a hole that continues lines is left as it is.

;; The column of `i` as the compiler's lexer counts it: characters since the
;; line began, a tab one.
(: column-at (-> (Vec char) int int))
(defun (column-at cs i)
  (let go ((k i))
    (if (or (= k 0) (= (vec-ref cs (- k 1)) #\newline)) (- i k) (go (- k 1)))))

;; The column the text of the string `s` written at `col` starts at.
(: text-column (-> string int int))
(defun (text-column s col)
  (if (string-starts-with? s "#\"") (+ col 2) (+ col 1)))

;; Whether the backslash at `p` is a line continuation, and if so where the
;; line break after it starts.
(: continuation-at (-> (Vec char) int (Option int)))
(defun (continuation-at cs p)
  (let go ((k (+ p 1)))
    (cond
      ((line-break? cs k) (Some k))
      ((or (= (char-at cs k) #\space) (= (char-at cs k) #\tab)) (go (+ k 1)))
      (else None))))

;; The string `s`, written with its text from `text-col` on, each continuation
;; as `\` and the line break alone, and from each continued line the
;; indentation it drops: what it stands for wherever it is written. Indentation
;; it keeps is kept.
(: without-continued-indent (-> string int string))
(defun (without-continued-indent s col)
  (def text-col (text-column s col))
  (rewrite-continuations s #t (fun (sb cs at)
                             (let skip ((j at))
                               (if (and (< (- j at) text-col)
                                        (or (= (char-at cs j) #\space) (= (char-at cs j) #\tab)))
                                   (skip (+ j 1))
                                   j)))))

;; The string `s`, as `without-continued-indent` reads it, written at `col`:
;; each continued line indented to where its text starts.
(: with-continued-indent (-> string int string))
(defun (with-continued-indent s col)
  (def text-col (text-column s col))
  (rewrite-continuations s #t (fun (sb cs at)
                             (unless (or (>= at (vec-length cs)) (line-break? cs at))
                               (stringbuilder-add-string! sb (spaces text-col)))
                             at)))

;; `s` with each continuation written as `\` and its line break, and after it
;; what `after` writes, given where the continued line starts; it answers where
;; to go on from. Without `keep?` a continuation's `\` and line break are left
;; out, which joins the lines. A raw string is as it is.
(: rewrite-continuations (-> string bool (-> StringBuilder (Vec char) int int) string))
(defun (rewrite-continuations s keep? after)
  (cond
    ((string-starts-with? s "\"\"\"") s)
    ((not (string-contains? s "\\")) s)
    (else
     (def cs (string->vec s))
     (def n (vec-length cs))
     (def sb (stringbuilder-empty))
     (def interpolated? (string-starts-with? s "#\""))
     (let go ((p 0))
       (when (< p n)
         (def c (vec-ref cs p))
         (cond
           ((= c #\\)
            (match (continuation-at cs p)
              ((Some k)
               (def past (if (= (char-at cs k) #\return) (+ k 2) (+ k 1)))
               (when keep?
                 (stringbuilder-add! sb #\\)
                 (stringbuilder-add-string! sb (text-between cs k past)))
               (go (after sb cs past)))
              (None
               (stringbuilder-add-string! sb (text-between cs p (+ p 2)))
               (go (+ p 2)))))
           ((and interpolated? (= c #\$) (= (char-at cs (+ p 1)) #\{))
            (def past (hole-end cs (+ p 2)))
            (stringbuilder-add-string! sb (text-between cs p past))
            (go past))
           (else
            (stringbuilder-add! sb c)
            (go (+ p 1))))))
     (stringbuilder->string sb))))

;; The string `s`, as `without-continued-indent` reads it, with its continued
;; lines joined: its value, written without continuations. This is what two
;; strings are compared by when the layout has re-indented one of them.
(: joined-continuations (-> string string))
(defun (joined-continuations s)
  (rewrite-continuations s #f (fun (sb cs at) at)))

;; A token as it is written at `col`: a string with its continued lines
;; indented to where its text then starts.
(: tok-written (-> Tok int string))
(defun (tok-written t col)
  (match t
    ((TStr s) (with-continued-indent s col))
    (_ (tok-text t))))

;; Past the `}` closing the hole whose code starts at `q`, as
;; `interpolated-end` reads one.
(: hole-end (-> (Vec char) int int))
(defun (hole-end cs q)
  (let hole ((q q) (depth 1))
    (def c (char-at cs q))
    (cond
      ((>= q (vec-length cs)) q)
      ((= c #\")
       (match (string-end cs q)
         ((Ok e) (hole e depth))
         ((Err _) (vec-length cs))))
      ((and (= c #\#) (= (char-at cs (+ q 1)) #\\)) (hole (+ q 3) depth))
      ((= c #\{) (hole (+ q 1) (+ depth 1)))
      ((and (= c #\}) (= depth 1)) (+ q 1))
      ((= c #\}) (hole (+ q 1) (- depth 1)))
      (else (hole (+ q 1) depth)))))

;; ---------------------------------------------------------------------------
;; Lines

;; A line's tokens, its own indentation taken off, and that indentation as it
;; was, which a `;;;` comment keeps.
(type (: Line (Record (: toks (List Tok)) (: indent string))))

(: lines-of (-> (List Tok) (List Line)))
(defun (lines-of toks)
  (let go ((toks toks) (here Nil) (out Nil))
    (match toks
      (Nil (list-reverse (Cons (tidy (list-reverse here)) out)))
      ((Cons TNewline rest) (go rest Nil (Cons (tidy (list-reverse here)) out)))
      ((Cons t rest) (go rest (Cons t here) out)))))

(: space? (-> Tok bool))
(defun (space? t)
  (match t
    ((TSpace _) #t)
    (_ #f)))

(: comment? (-> Tok bool))
(defun (comment? t)
  (match t
    ((TComment _) #t)
    (_ #f)))

;; A line without the spaces at its ends and just inside its brackets.
(: tidy (-> (List Tok) Line))
(defun (tidy toks)
  (def indent
    (match toks
      ((Cons (TSpace s) _) s)
      (_ "")))
  (def trimmed (list-reverse (drop-spaces (list-reverse (drop-spaces toks)))))
  (Line (toks (inside-brackets trimmed)) (indent indent)))

(: drop-spaces (-> (List Tok) (List Tok)))
(defun (drop-spaces toks)
  (match toks
    ((Cons t rest) #:when (space? t) (drop-spaces rest))
    (_ toks)))

(: inside-brackets (-> (List Tok) (List Tok)))
(defun (inside-brackets toks)
  (match toks
    ((Cons (TOpen o) (Cons s rest)) #:when (and (space? s) (not (starts-comment? rest)))
     (inside-brackets (Cons (TOpen o) rest)))
    ((Cons s (Cons (TClose c) rest)) #:when (space? s)
     (inside-brackets (Cons (TClose c) rest)))
    ((Cons t rest) (Cons t (inside-brackets rest)))
    (Nil Nil)))

(: starts-comment? (-> (List Tok) bool))
(defun (starts-comment? toks)
  (match toks
    ((Cons t _) (comment? t))
    (Nil #f)))

(: blank? (-> Line bool))
(defun (blank? l) (empty? (record-ref l toks)))

(: drop-blank-lines (-> (List Line) (List Line)))
(defun (drop-blank-lines lines)
  (match lines
    ((Cons l rest) #:when (blank? l) (drop-blank-lines rest))
    (_ lines)))

;; No blank lines at the ends, and at most one in a row anywhere else.
(: squeeze-blank-lines (-> (List Line) (List Line)))
(defun (squeeze-blank-lines lines)
  (def trimmed (list-reverse (drop-blank-lines (list-reverse (drop-blank-lines lines)))))
  (let go ((lines trimmed) (run 0) (out Nil))
    (match lines
      (Nil (list-reverse out))
      ((Cons l rest) #:when (blank? l)
       (if (>= run 1) (go rest run out) (go rest (+ run 1) (Cons l out))))
      ((Cons l rest) (go rest 0 (Cons l out))))))

;; ---------------------------------------------------------------------------
;; Indentation

;; A form inside a list, as the indentation reads it: where it starts, a prefix
;; such as ' or #' included; the physical line it starts on; the column of the
;; first form that starts on that line; its text if it is an atom, or its
;; opening bracket; and for a list the column of that bracket.
(type (: Elem (Record (: col int)
                      (: line int)
                      (: line-first int)
                      (: raw string)
                      (: is-list bool)
                      (: bracket int))))

;; An open list: its bracket, the bracket's column and line, the forms in it so
;; far, the last first, and the first two of them.
(type (: Frame (Record (: bracket string)
                       (: col int)
                       (: line int)
                       (: elems (List Elem))
                       (: count int)
                       (: first (Option Elem))
                       (: second (Option Elem)))))

;; A column, and whether `lisp-indent-region` keeps it for the following lines
;; at the same depth, which it does for a plain number and not for the
;; (COLUMN START) a rule answers when the next line may differ.
(type (: Indent (Record (: col int) (: keep bool))))

(: indent (-> int bool Indent))
(defun (indent col keep) (Indent (col col) (keep keep)))

(: with-elem (-> Frame Elem Frame))
(defun (with-elem f e)
  (def n (record-ref f count))
  (Frame (bracket (record-ref f bracket))
         (col (record-ref f col))
         (line (record-ref f line))
         (elems (Cons e (record-ref f elems)))
         (count (+ n 1))
         (first (if (= n 0) (Some e) (record-ref f first)))
         (second (if (= n 1) (Some e) (record-ref f second)))))

(: raw-of (-> (Option Elem) string))
(defun (raw-of e)
  (match e
    ((Some x) (record-ref x raw))
    (None "")))

(: last-of (-> Frame Elem Elem))
(defun (last-of f head)
  (match (record-ref f elems)
    ((Cons e _) e)
    (Nil head)))

;; How a form with a body indents, from `bjo-indent-forms` in bjomode.el: how
;; many forms come before the body, or a rule of its own.
(type (: Rule (Union (: Body int) DefForm NamedLet DefStar)))

(: rule-of (-> string (Option Rule)))
(defun (rule-of head)
  (match head
    ((or "seq" "letrec" "export" "re-export" "import" "import/extern" "import/class"
         "type" "type-rec" "bjo" "begin" "spawn" "spawn/daemon" "spawn/detached"
         "with-shield" "cond" "time-it" "try")
     (Some (Body 0)))
    ;; A definition: everything after its head is the body, whatever else is on
    ;; the head's line.
    ((or "defun" "defbjo" "defbjouble" "impl" "impl/extern" ":doc") (Some DefForm))
    ((or "def/mutable" "def/trait" "def/macro" "def/pattern" "type/derive" "when"
         "unless" "match" "case" "with-open" "parameterize" "parameterize*" "fun" "bjoroutine"
         "let*" "syntax-match" "when-let" "if-let" "with-cancel" "with-deadline"
         "with-response" "with-run" "with-return")
     (Some (Body 1)))
    ("let/mono" (Some (Body 2)))
    ("if" (Some (Body 3)))
    ("def" (Some DefForm))
    ("let" (Some NamedLet))
    ("def*" (Some DefStar))
    (_ None)))

;; The characters Emacs reads as a prefix of the form after them.
(: prefix-char? (-> char bool))
(defun (prefix-char? c)
  (or (= c #\') (= c #\#) (= c #\,) (= c #\@) (= c #\`)))

(: list-drop-while (-> (-> %a bool) (List %a) (List %a)))
(defun (list-drop-while drop? xs)
  (match xs
    ((Cons x rest) #:when (drop? x) (list-drop-while drop? rest))
    (_ xs)))

(: without-prefix (-> string string))
(defun (without-prefix s)
  (list->string (list-drop-while prefix-char? (string->list s))))

(: prefix-length (-> string int))
(defun (prefix-length s)
  (- (string-length s) (string-length (without-prefix s))))

(: prefix-only? (-> string bool))
(defun (prefix-only? s)
  (and (not (string-empty? s)) (string-empty? (without-prefix s))))

;; Whether a form written `raw` begins with a word or a symbol character once
;; its prefix is past: a symbol or a number, not a list, a string or a
;; character literal.
(: symbolic? (-> string bool))
(defun (symbolic? raw)
  (match (string->list (without-prefix raw))
    ((Cons c _) (not (or (opening? c) (= c #\") (= c #\\) (= c #\;))))
    (Nil #f)))

;; Returns the default indentation column for the next line inside list `f`,
;; before any head-specific rule is applied. This is Emacs's
;; `calculate-lisp-indent`:
;;
;; - If the head is a list, align with the head.
;; - If an argument follows the head on the head's line, align with that
;;   argument.
;; - If the head is alone on its line, align with the head, i.e. one column
;;   in from the bracket.
;; - Otherwise, align with the first form on the previous form's line.
(: normal-indent (-> Frame Elem int))
(defun (normal-indent f head)
  (def last (last-of f head))
  (cond
    ((record-ref head is-list) (record-ref head bracket))
    ((= (record-ref last line) (record-ref head line))
     (match (record-ref f second)
       ((Some s) (record-ref s col))
       (None (record-ref head col))))
    (else (record-ref last line-first))))

;; `lisp-indent-specform`: the first two of a form's `n` distinguished forms
;; four in, a third under them, and the body two in.
(: specform (-> int Frame int Indent))
(defun (specform n f normal)
  (def args (- (record-ref f count) 1))
  (def left (- n args))
  (def body (+ (record-ref f col) 2))
  (cond
    ((> left 0) (indent (if (<= args 1) (+ (record-ref f col) 4) normal) #f))
    ((or (and (= n 0) (= args 0)) (and (= left 0) (<= body normal))) (indent body #t))
    (else (indent normal #t))))

;; `lisp-indent-defform`: a body two in, when the form before it is on the
;; line of the bracket.
(: defform (-> Frame Elem (Option Indent)))
(defun (defform f head)
  (if (= (record-ref (last-of f head) line) (record-ref f line))
      (Some (indent (+ (record-ref f col) 2) #t))
      None))

;; Whether a `let` is a named one: a name after `let` on its line.
(: named-let? (-> Frame Elem bool))
(defun (named-let? f head)
  (match (record-ref f second)
    ((Some s) #:when (= (record-ref s line) (record-ref head line))
     (let-name? (record-ref s raw)))
    (_ #f)))

;; Returns true if `name` is a form that takes a record followed by
;; `(field value)` setters.
(: record-setter? (-> string bool))
(defun (record-setter? name)
  (match name
    ((or "record-set" "record-set!" "struct-set" "struct-set!") #t)
    (_ #f)))

;; `bjo-indent-function`: what the form's head says, if it says anything.
(: by-head (-> Frame Elem int (Option Indent)))
(defun (by-head f head normal)
  (def raw (record-ref head raw))
  (def name (without-prefix raw))
  (def head-col (+ (record-ref head col) (prefix-length raw)))
  (cond
    ((string-starts-with? raw "#:") (Some (specform 0 f normal)))
    ;; A list or a string as the head: the rest under the form after it on its
    ;; line, or under the head when nothing follows it there. A guard is part
    ;; of the pattern, so after `#:when` and its guard the form is the one
    ;; after those.
    ((not (symbolic? raw))
     (def forms (list-reverse (record-ref f elems)))
     (def after
       (match forms
         ((Cons _ (Cons w (Cons _ (Cons x _)))) #:when (= (record-ref w raw) "#:when") (Some x))
         ((Cons _ (Cons w _)) #:when (= (record-ref w raw) "#:when") None)
         ((Cons _ (Cons x _)) (Some x))
         (_ None)))
     (Some (match after
             ((Some s) #:when (= (record-ref s line) (record-ref head line)) (indent (record-ref s col) #t))
             (_ (indent (record-ref head col) #t)))))
    ((= name ":match") (Some (indent head-col #t)))
    ;; `(record-set target (f v) ...)`: if the first setter is on the head's
    ;; line, the following setters align under it. Otherwise fall back to the
    ;; normal call indentation.
    ((record-setter? name)
     (match (list-reverse (record-ref f elems))
       ((Cons _ (Cons _ (Cons setter _))) #:when (= (record-ref setter line) (record-ref head line))
        (Some (indent (record-ref setter col) #t)))
       (_ None)))
    (else
     (match (rule-of name)
       ((Some DefForm) (defform f head))
       ((Some (Body n)) (Some (specform n f normal)))
       ((Some NamedLet) (Some (specform (if (named-let? f head) 2 1) f normal)))
       ((Some DefStar) None)
       ;; A head that begins with `def` defines something and one that begins
       ;; with `with-` runs a body in something; both have a body.
       (None
        (if (and (> (string-length name) 3)
                 (or (string-starts-with? name "def") (string-starts-with? name "with-")))
            (defform f head)
            None))))))

;; A line that starts with a keyword goes under a keyword that starts the line
;; of the form before it, when that is not the list's first form.
(: keyword-aligned (-> Frame Elem int string int))
(defun (keyword-aligned f head normal here)
  (def last (last-of f head))
  (def on-its-line
    (list-filter #(= (record-ref & line) (record-ref last line)) (record-ref f elems)))
  (match (list-reverse on-its-line)
    ((Cons s _) #:when (and (string-starts-with? here ":")
                            (not (and (= (record-ref s col) (record-ref head col))
                                      (= (record-ref s line) (record-ref head line))))
                            (string-starts-with? (record-ref s raw) ":"))
     (record-ref s col))
    (_ normal)))

;; Where `def`'s failure part may be: the forms after a `def`'s head, or all
;; of a parenthesised clause of a `def*`. `None` for any other list.
(: clause-forms (-> Frame (Option Frame) (Option (List Elem))))
(defun (clause-forms f outer)
  (def forms (list-reverse (record-ref f elems)))
  (def head (raw-of (record-ref f first)))
  (def in-def-star?
    (match outer
      ((Some o) (= (raw-of (record-ref o first)) "def*"))
      (None #f)))
  (cond
    ((or (= head "def") (= head ":def"))
     (Some (match forms
             ((Cons _ rest) rest)
             (Nil Nil))))
    ((and in-def-star? (= (record-ref f bracket) "(") (not (= head "def*"))) (Some forms))
    (else None)))

(: failure-keyword? (-> string bool))
(defun (failure-keyword? s)
  (match (without-prefix s)
    ((or ":leave-with" ":leave" ":propagate" ":default") #t)
    (_ #f)))

;; `bjo--failure-indent`: a failure keyword two in from the clause's bracket,
;; and the arms after `:leave` under the first of them.
(: failure-indent (-> Frame (Option Frame) string bool (Option Indent)))
(defun (failure-indent f outer here here-form?)
  (match (clause-forms f outer)
    ((Some forms) #:when (>= (+ (list-length forms) (if here-form? 1 0)) 2)
     (cond
       ((and here-form? (failure-keyword? here)) (Some (indent (+ (record-ref f col) 2) #f)))
       (else
        (match (list-drop-while #(not (= (without-prefix (record-ref & raw)) ":leave")) forms)
          ((Cons _ (Cons arm _)) (Some (indent (record-ref arm col) #f)))
          ((Cons leave Nil) (Some (indent (record-ref leave col) #f)))
          (Nil None)))))
    (_ None)))

;; A form whose result a `=>` introduces, which goes two in, as a body does.
(: loop-form? (-> Frame bool))
(defun (loop-form? f)
  (match (raw-of (record-ref f first))
    ((or "loop" ":loop" "subloop" ":subloop" "seql") #t)
    (_ #f)))

(: binding-form? (-> string bool))
(defun (binding-form? head)
  (match head
    ((or "let" "let*" "letrec" "with-open" "parameterize" "parameterize*") #t)
    (_ #f)))

;; `bjo--binding-list-p`: whether `f` is the bindings of a `let` or a form like
;; it, `outer`: the list after the head, or after the name of a named `let`.
(: binding-list? (-> Frame (Option Frame) bool))
(defun (binding-list? f outer)
  (match outer
    ((Some o)
     (def head (raw-of (record-ref o first)))
     (def named?
       (and (= head "let")
            (let-name? (raw-of (record-ref o second)))))
     ;; `f` is open inside `o`, so it is the last of `o`'s forms so far.
     (and (= (record-ref f bracket) "(")
          (binding-form? head)
          (= (record-ref o count) (if named? 3 2))))
    (None #f)))

;; Whether `bjo--calculate-indent` stops the column being kept: in a `def`
;; clause and in a `loop` or a `seql`, where the next line may indent
;; differently.
(: no-reuse? (-> Frame (Option Frame) bool))
(defun (no-reuse? f outer)
  (or (loop-form? f)
      (match (clause-forms f outer)
        ((Some forms) (not (empty? forms)))
        (None #f))))

;; The column for a line inside `f`, whose first token is `here` and starts a
;; form if `here-form?`.
(: indent-in (-> Frame (Option Frame) string bool Indent))
(defun (indent-in f outer here here-form?)
  ;; Returns true if the current list is the value of a keyword argument of a
  ;; `defeffect`, e.g. the name list in `#:cold (name ...)`. Such a list is
  ;; data, so its elements align under the first one.
  (: effect-names? (-> (Option Frame) bool))
  (defun (effect-names? outer)
    (match outer
      ((Some o) (and (= (raw-of (record-ref o first)) "defeffect")
                     ;; `o`'s most recent element is the current list, so the
                     ;; one before it is what precedes the list.
                     (match (record-ref o elems)
                       ((Cons _ (Cons e _)) (keyword-arg? (record-ref e raw)))
                       (_ #f))))
      (None #f)))
  (def calculated
    (match (record-ref f first)
      (None (indent (+ (record-ref f col) 1) #t))
      ;; A vec or an array is data, and a `let`'s bindings are a list of them:
      ;; every element goes under the first, whatever it is. The rules below
      ;; are for code.
      ((Some head) #:when (or (= (record-ref f bracket) "[") (binding-list? f outer) (effect-names? outer))
       (indent (record-ref head col) #t))
      ((Some head)
       (def normal (normal-indent f head))
       (match (by-head f head normal)
         ((Some i) i)
         (None (indent (keyword-aligned f head normal here) #t))))))
  (match (failure-indent f outer here here-form?)
    ((Some i) i)
    (None
     (cond
       ((and (loop-form? f) (= here "=>")) (indent (+ (record-ref f col) 2) #f))
       ((and (record-ref calculated keep) (no-reuse? f outer)) (indent (record-ref calculated col) #f))
       (else calculated)))))

;; ---------------------------------------------------------------------------
;; Writing it out

;; What is known while the lines are written: the lists open, the innermost
;; first; the column kept at each depth, the innermost first, one more than
;; there are lists open, and how many lists were open when they were kept;
;; the physical line being written; and what is to be said about the lines so
;; far, each with its line, the last first.
(type (: State (Record (: frames (List Frame))
                       (: kept (List (Option int)))
                       (: kept-depth int)
                       (: line int)
                       (: notes (List (Tuple int string))))))

;; The width past which a line the layout made wider is pointed out: an
;; indenter only moves text right, and a line it moves too far wants breaking
;; by hand. Racket's style has the same limit.
(: wide int)
(def wide 102)

;; What is to be said about a line whose tokens are `toks` as it is written:
;; that it has a tab in a raw string, which no escape can write. How wide it
;; is is said once it is broken; see `width-notes`.
(: notes-on (-> (List Tok) (List string)))
(defun (notes-on toks)
  (if (any? (fun (t)
              (match t
                ((TStr s) (and (string-starts-with? s "\"\"\"") (string-contains? s "\t")))
                (_ #f)))
            toks)
      (list "a tab in a raw string, which has no escape for it; write the text another way")
      Nil))

;; The lines of `result` wider than `wide`, each with its width as a note, but
;; one that is part of a line of `source` as wide already: a string, a comment
;; or a table nothing here breaks, which a person has to, and has been told of.
(: width-notes (-> string string (List (Tuple int string))))
(defun (width-notes source result)
  (def wide-before
    (loop (:for l (string-split source "\n"))
          (:acc out (listing (string-trim l)) #:when (> (columns l) wide))
      => out))
  (def lines (string-split result "\n"))
  (loop (:for i (range 0 (vec-length lines)))
        (:acc out (listing (Tuple (+ i 1)
                                  #"${(int->string (columns (vec-ref lines i)))} columns, more than ${(int->string wide)}; break the line"))
              #:when (let ((l (vec-ref lines i)))
                       (and (> (columns l) wide)
                            (not (any? #(string-contains? & (string-trim l)) wide-before)))))
    => out))

(: spaces (-> int string))
(defun (spaces n)
  (def sb (stringbuilder-empty))
  (let go ((i 0))
    (when (< i n)
      (stringbuilder-add! sb #\space)
      (go (+ i 1))))
  (stringbuilder->string sb))

;; The column after `s` written at `col`, and how many line breaks it has.
(: advance (-> string int (Tuple int int)))
(defun (advance s col)
  (string-fold (fun (c at)
                 (match at
                   ((Tuple column breaks)
                    (if (= c #\newline) (Tuple 0 (+ breaks 1)) (Tuple (+ column 1) breaks)))))
               (Tuple col 0)
               s))

(: expand-tabs (-> string int string))
(defun (expand-tabs s col)
  (def sb (stringbuilder-empty))
  (ignore
   (string-fold (fun (c at)
                  (cond
                    ((= c #\tab)
                     (def to (* 8 (+ 1 (/ at 8))))
                     (stringbuilder-add-string! sb (spaces (- to at)))
                     to)
                    (else
                     (stringbuilder-add! sb c)
                     (+ at 1))))
                col
                s))
  (stringbuilder->string sb))

;; The kept columns adjusted from `from` lists open to `depth`, as
;; `lisp-indent-calc-next` adjusts its stack: one dropped per list closed
;; since, a fresh one per list opened.
(: kept-at (-> (List (Option int)) int int (List (Option int))))
(defun (kept-at kept from depth)
  (cond
    ((> from depth)
     (kept-at (match kept
                ((Cons _ rest) rest)
                (Nil Nil))
              (- from 1)
              depth))
    ((< from depth) (kept-at (Cons None kept) (+ from 1) depth))
    (else kept)))

;; The text of a line's first token, and whether it starts a form.
(: first-of-line (-> (List Tok) (Tuple string bool)))
(defun (first-of-line toks)
  (match toks
    ((Cons (TAtom s) _) (Tuple s #t))
    ((Cons (TOpen s) _) (Tuple s #t))
    ((Cons (TStr s) _) (Tuple s #t))
    ((Cons (TComment s) _) (Tuple s #f))
    ((Cons (TClose s) _) (Tuple s #f))
    (_ (Tuple "" #f))))

;; One line, indented, and the state after it.
(: write-line (-> StringBuilder State Line State))
(defun (write-line out st l)
  (def toks (record-ref l toks))
  (def frames (record-ref st frames))
  (def depth (list-length frames))
  (def kept (kept-at (record-ref st kept) (record-ref st kept-depth) depth))
  (def (Tuple here here-form?) (first-of-line toks))
  (def (Tuple col keep)
    (match kept
      ((Cons (Some c) _) (Tuple c #f))
      (_
       (match frames
         (Nil (Tuple 0 #t))
         ((Cons f rest)
          (def outer
            (match rest
              ((Cons o _) (Some o))
              (Nil None)))
          (def i (indent-in f outer here here-form?))
          (Tuple (record-ref i col) (record-ref i keep)))))))
  (def kept-now
    (match kept
      ((Cons None rest) #:when keep (Cons (Some col) rest))
      (_ kept)))
  ;; A `;;;` comment stays where it was, as `lisp-indent-line` leaves it.
  (def lead (if (string-starts-with? here ";;;") (record-ref l indent) (spaces col)))
  (def buffer (stringbuilder-empty))
  (unless (empty? toks) (stringbuilder-add-string! buffer lead))
  (def (Tuple frames-after line-after)
    (write-toks buffer toks frames (string-length lead) (record-ref st line)))
  (stringbuilder-add-string! out (stringbuilder->string buffer))
  (stringbuilder-add! out #\newline)
  (State (frames frames-after)
         (kept kept-now)
         (kept-depth depth)
         (line (+ line-after 1))
         (notes (list-foldl (fun (note acc) (Cons (Tuple (record-ref st line) note) acc))
                            (record-ref st notes)
                            (notes-on toks)))))

;; Whether the token is a prefix, ' or #' or #, written right before the form
;; it belongs to.
(: prefix-of-next? (-> Tok (List Tok) bool))
(defun (prefix-of-next? t rest)
  (match t
    ((TAtom s) #:when (prefix-only? s)
     (match rest
       ((Cons (TOpen _) _) #t)
       ((Cons (TStr _) _) #t)
       ((Cons (TAtom _) _) #t)
       (_ #f)))
    (_ #f)))

(: starts-form? (-> Tok bool))
(defun (starts-form? t)
  (match t
    ((TAtom _) #t)
    ((TOpen _) #t)
    ((TStr _) #t)
    (_ #f)))

;; The forms the token adds to the lists open, and the list it opens or closes.
(: after-tok (-> Tok (List Frame) Elem (List Frame)))
(defun (after-tok t frames e)
  (def added
    (match frames
      ((Cons f outer) (if (starts-form? t) (Cons (with-elem f e) outer) frames))
      (Nil Nil)))
  (match t
    ((TOpen s)
     (Cons (Frame (bracket s) (col (record-ref e bracket)) (line (record-ref e line))
                  (elems Nil) (count 0) (first None) (second None))
           added))
    ((TClose _)
     (match frames
       ((Cons _ outer) outer)
       (Nil Nil)))
    (_ added)))

;; The tokens of one line, written from `col` on physical line `line`, and the
;; lists open after them and the physical line they end on.
(: write-toks (-> StringBuilder (List Tok) (List Frame) int int (Tuple (List Frame) int)))
(defun (write-toks out toks frames col line)
  ;; `first` is the column of the first form on the physical line, once there
  ;; is one; `prefix` that of a prefix waiting for the form it belongs to.
  (let go ((toks toks) (frames frames) (col col) (line line) (first None) (prefix None))
    (match toks
      (Nil (Tuple frames line))
      ((Cons t rest)
       (def written
         (match t
           ((TSpace s) (expand-tabs s col))
           ((TComment s) (expand-tabs s col))
           (_ (tok-written t col))))
       (stringbuilder-add-string! out written)
       (def (Tuple next-col breaks) (advance written col))
       (def waits? (prefix-of-next? t rest))
       (def form-col
         (match prefix
           ((Some p) p)
           (None col)))
       (def line-first
         (match first
           ((Some c) c)
           (None form-col)))
       (def e (Elem (col form-col)
                    (line line)
                    (line-first line-first)
                    (raw (match t
                           ((TStr _) "\"")
                           (_ (tok-text t))))
                    (is-list (match t
                               ((TOpen _) #t)
                               (_ #f)))
                    (bracket col)))
       (def frames-after (if waits? frames (after-tok t frames e)))
       (def first-after
         (cond
           ((> breaks 0) None)
           ((and (or waits? (starts-form? t)) (none? first)) (Some form-col))
           (else first)))
       (def prefix-after
         (cond
           (waits? (Some form-col))
           (else None)))
       (go rest frames-after next-col (+ line breaks) first-after prefix-after)))))

;; ---------------------------------------------------------------------------
;; Brackets

(: partner (-> string string))
(defun (partner open)
  (match open
    ("(" ")")
    ("[" "]")
    (_ "}")))

;; Whether every bracket closes the one opened last: indentation means nothing
;; where they do not, and Emacs, asked to indent such a file, never finishes.
(: balanced (-> (List Tok) (Result string Unit)))
(defun (balanced toks)
  ;; `open` holds each bracket still open and its line, the innermost first.
  (let go ((toks toks) (open Nil) (line 1))
    (match toks
      (Nil
       (match open
         (Nil (Ok unit))
         ((Cons (Tuple b at) _)
          (Err #"line ${(int->string at)}: a ${b} that is never closed"))))
      ((Cons t rest)
       (match t
         (TNewline (go rest open (+ line 1)))
         ((TStr s) (go rest open (+ line (snd (advance s 0)))))
         ((TOpen b) (go rest (Cons (Tuple b line) open) line))
         ((TClose c)
          (match open
            (Nil (Err #"line ${(int->string line)}: a ${c} that closes nothing"))
            ((Cons (Tuple b at) outer)
             (if (= (partner b) c)
                 (go rest outer line)
                 (Err #"line ${(int->string line)}: a ${c} where the ${b} of line ${(int->string at)} wants a ${(partner b)}")))))
         (_ (go rest open line)))))))

;; ---------------------------------------------------------------------------
;; The tree
;;
;; The tokens of a file parsed into nested lists. The source's line breaks are
;; dropped, except where a rule below says that they decide the layout.

(type-rec
  ;; An atom or a string with its prefixes, or a list.
  (: Node (Union (: Leaf (List Tok))
                 (: Branch Group)))
  ;; - `prefix`: the tokens written directly before the bracket, e.g. `#map`.
  ;; - `tail`: the comments after the last item.
  ;; - `width`: the columns the list takes on one line.
  ;; - `plain`: no comment and no multi-line string inside it.
  ;; - `spans`: the source has it over several lines.
  (: Group (Record (: id int)
                   (: prefix (List Tok))
                   (: open string)
                   (: items (Vec Item))
                   (: tail (List Note))
                   (: width int)
                   (: plain bool)
                   (: spans bool)))
  ;; - `lead`: the comments on lines of their own before the item.
  ;; - `trail`: the comment after the item on its line.
  ;; - `blank`: a blank line comes before the item, after the `lead` comments.
  ;; - `broke`: the item starts a line in the source.
  ;; - `space`: what separates the item from the one before it on its line.
  (: Item (Record (: lead (List Note))
                  (: blank bool)
                  (: broke bool)
                  (: space string)
                  (: node Node)
                  (: trail (Option string))))
  ;; A comment on a line of its own, with the indentation it had.
  (: Note (Record (: text string)
                  (: indent string)
                  (: blank bool))))

(: columns (-> string int))
(defun (columns s)
  (fst (advance s 0)))

(: prefix-width (-> (List Tok) int))
(defun (prefix-width toks)
  (list-foldl (fun (t n) (+ n (columns (tok-text t)))) 0 toks))

(: breaks? (-> Tok bool))
(defun (breaks? t)
  (match t
    ((TStr s) (string-contains? s "\n"))
    (_ #f)))

(: node-width (-> Node int))
(defun (node-width n)
  (match n
    ((Leaf toks) (prefix-width toks))
    ((Branch g) (record-ref g width))))

;; Returns true if the node can be written as one line of text.
(: node-plain? (-> Node bool))
(defun (node-plain? n)
  (match n
    ((Leaf toks) (not (any? breaks? toks)))
    ((Branch g) (record-ref g plain))))

(: node-spans? (-> Node bool))
(defun (node-spans? n)
  (match n
    ((Leaf toks) (any? breaks? toks))
    ((Branch g) (record-ref g spans))))

;; The text of an atom, and "" for a string or a list.
(: node-atom (-> Node string))
(defun (node-atom n)
  (match n
    ((Leaf (Cons (TAtom s) Nil)) s)
    (_ "")))

(: node-list? (-> Node bool))
(defun (node-list? n)
  (match n
    ((Branch _) #t)
    (_ #f)))

(: make-group (-> int (List Tok) string (Vec Item) (List Note) Group))
(defun (make-group id prefix open items tail)
  (def n (vec-length items))
  (def (Tuple width plain spans)
    (let go ((k 0)
             (width 0)
             (plain (empty? tail))
             (spans (not (empty? tail))))
      (if (= k n)
          (Tuple width plain spans)
          (let ((it (vec-ref items k)))
            (go (+ k 1)
                (+ width (node-width (record-ref it node)))
                (and plain
                     (empty? (record-ref it lead))
                     (none? (record-ref it trail))
                     (node-plain? (record-ref it node)))
                (or spans (and (> k 0) (record-ref it broke)) (node-spans? (record-ref it node))))))))
  (Group (id id)
         (prefix prefix)
         (open open)
         (items items)
         (tail tail)
         (width (+ width
                   (prefix-width prefix)
                   2
                   (if (> n 0)
                       (- n 1)
                       0)))
         (plain plain)
         (spans spans)))

;; What has been parsed: the items, the comments after them, and the tokens
;; left, starting with the closing bracket.
(type (: Parsed (Record (: items (Vec Item))
                        (: tail (List Note))
                        (: rest (List Tok)))))

;; Parses items up to a closing bracket or the end. `next-id` numbers the lists.
(: parse (-> (List Tok) (-> int) Parsed))
(defun (parse toks next-id)
  ;; `breaks` counts the line breaks since the last item or comment, and
  ;; `indent` is the space the current line starts with. `notes` holds comments
  ;; waiting for the item after them, the last first. `prefix` holds tokens
  ;; written directly before the current one, the last first.
  (let go ((toks toks)
           (breaks 0)
           (indent "")
           (notes Nil)
           (prefix Nil)
           (out Nil))
    (defun (add node rest)
      (go rest
          0
          ""
          Nil
          Nil
          (Cons (Item (lead (list-reverse notes))
                      (blank (> breaks 1))
                      (broke (or (> breaks 0) (not (empty? notes))))
                      (space (if (string-empty? indent)
                                 " "
                                 indent))
                      (node node)
                      (trail None))
                out)))
    (defun (done rest)
      (Parsed (items (list->vec (list-reverse out))) (tail (list-reverse notes)) (rest rest)))
    (match toks
      (Nil (done Nil))
      ((Cons (TClose _) _) (done toks))
      ((Cons TNewline rest) (go rest (+ breaks 1) "" notes prefix out))
      ((Cons (TSpace s) rest) (go rest breaks s notes prefix out))
      ((Cons (TComment s) rest)
       (match out
         ((Cons it earlier) #:when (and (= breaks 0) (empty? notes) (none? (record-ref it trail)))
          (go rest 0 "" notes Nil (Cons (record-set it (trail (Some s))) earlier)))
         (_
          (def n (Note (text s) (indent indent) (blank (> breaks 1))))
          (go rest 0 "" (Cons n notes) Nil out))))
      ((Cons (TOpen b) rest)
       (def id (next-id))
       (def inner (parse rest next-id))
       (def after
         (match (record-ref inner rest)
           ((Cons _ r) r)
           (Nil Nil)))
       (add (Branch
             (make-group id (list-reverse prefix) b (record-ref inner items) (record-ref inner tail)))
            after))
      ((Cons t rest)
       (def glued?
         (match t
           ((TAtom _)
            (match rest
              ((Cons (TOpen _) _) #t)
              ((Cons (TStr _) _) #t)
              ((Cons (TAtom _) _) #t)
              (_ #f)))
           ;; Two strings with nothing between them, as `#""` and `""`.
           ((TStr _)
            (match rest
              ((Cons (TStr _) _) #t)
              ((Cons (TAtom _) _) #t)
              (_ #f)))
           (_ #f)))
       (if glued?
           (go rest breaks indent notes (Cons t prefix) out)
           (add (Leaf (list-reverse (Cons t prefix))) rest))))))

;; ---------------------------------------------------------------------------
;; Measures
;;
;; A layout is chosen the way the pretty printer behind `raco fmt` does it
;; ("A Pretty Expressive Printer", Porncharoenwase et al., 2023). Laying out a
;; form at a column gives a set of measures, one per layout worth keeping. A
;; layout is dropped if another one costs no more and ends no further right.

;; What a layout writes.
(type (: Rope (Union Empty
                     Blank
                     Break
                     (: Text Tok)
                     (: Flat Node)
                     (: Join Rope Rope))))

;; A layout: the column after it, its cost, and what it writes. The cost is
;; compared part by part, in this order:
;; - `over`: the columns past `wide`, each line's squared.
;; - `lines`: the line breaks.
;; - `style`: what the less preferred layouts add.
(type (: Measure (Record (: last int)
                         (: over int)
                         (: lines int)
                         (: style int)
                         (: rope Rope))))

;; What `width` columns of text at `col` add to `over`. The parts of one line
;; add up to what the line costs as a whole.
(: overflow (-> int int int))
(defun (overflow col width)
  ;; Capped so that the square cannot overflow.
  (def end (+ col width))
  (def stop
    (if (> end 5000)
        5000
        end))
  (cond
    ((<= stop wide) 0)
    (else
     (def a
       (if (> col 5000)
           (- 5000 wide)
           (if (> col wide)
               (- col wide)
               0)))
     (def b (- stop wide))
     (- (* b b) (* a a)))))

(: text-measure (-> int int Rope Measure))
(defun (text-measure col width rope)
  (Measure (last (+ col width)) (over (overflow col width)) (lines 0) (style 0) (rope rope)))

(: cost<=? (-> Measure Measure bool))
(defun (cost<=? a b)
  (cond
    ((not (= (record-ref a over) (record-ref b over))) (< (record-ref a over) (record-ref b over)))
    ((not (= (record-ref a lines) (record-ref b lines)))
     (< (record-ref a lines) (record-ref b lines)))
    (else (<= (record-ref a style) (record-ref b style)))))

;; `a` followed by `b`, which was laid out from where `a` ends.
(: then (-> Measure Measure Measure))
(defun (then a b)
  (Measure (last (record-ref b last))
           (over (+ (record-ref a over) (record-ref b over)))
           (lines (+ (record-ref a lines) (record-ref b lines)))
           (style (+ (record-ref a style) (record-ref b style)))
           (rope (Join (record-ref a rope) (record-ref b rope)))))

(: dominates? (-> Measure Measure bool))
(defun (dominates? a b)
  (and (<= (record-ref a last) (record-ref b last)) (cost<=? a b)))

;; The set `ms` with `m` in it. The earlier of two equal layouts is kept.
(: with-measure (-> Measure (List Measure) (List Measure)))
(defun (with-measure m ms)
  (if (any? #(dominates? & m) ms)
      ms
      (list-append (list-filter #(not (dominates? m &)) ms) (list m))))

(: merged (-> (List Measure) (List Measure) (List Measure)))
(defun (merged a b)
  (list-foldl with-measure a b))

(: best (-> (List Measure) Measure))
(defun (best ms)
  (match ms
    ((Cons m rest)
     (list-foldl (fun (x b)
                   (if (cost<=? b x)
                       b
                       x))
                 m
                 rest))
    (Nil (text-measure 0 0 Empty))))

;; `m`, then a line break and possibly a blank line, then column `col`.
(: newline-to (-> Measure int bool Measure))
(defun (newline-to m col blank?)
  (Measure (last col)
           (over (record-ref m over))
           (lines (+ (record-ref m lines) 1))
           (style (record-ref m style))
           (rope (Join (record-ref m rope)
                       (if blank?
                           (Join Break Break)
                           Break)))))

;; `m` with `rope` after it, which takes no columns.
(: with-rope (-> Measure Rope Measure))
(defun (with-rope m rope)
  (record-set m (rope (Join (record-ref m rope) rope))))

;; ---------------------------------------------------------------------------
;; Forms

;; Where a list is, which decides what it is:
;; - `Code`: an expression, a definition or a declaration.
;; - `Data`: quoted data, a pattern or a parameter list.
;; - `Table`: kept in the lines the source has it in.
;; - `Bindings`, `Binding`: the bindings of a `let`, and one of them.
;; - `Arm`, `Clause`: a clause of a `match` and of a `cond`.
;; - `DefClause`: a clause of a `def*`.
;; - `InType`: a type.
(type (: Place (Union Code Data Table Bindings Binding Arm Clause DefClause InType)))

;; The kinds of list, each with its own layouts (see `plans`).
(type (: Kind (Union KCall
                     KData
                     KTable
                     KBindings
                     KBinding
                     KArm
                     KDef
                     KLoopDef
                     KDefStar
                     KDefClause
                     ;; A head, this many forms on its line, and a body below.
                     (: KBody int)
                     ;; As `KBody`, but also allowed on one line.
                     (: KSmallBody int)
                     ;; As many forms on the head's line as the source has there.
                     KKept
                     ;; A body right after the head.
                     KBlock
                     ;; As `KBlock`, but allowed on one line with a single form.
                     KSmallBlock
                     KCond
                     KMatch
                     KIf
                     (: KLet bool)
                     KLetrec
                     KLoop
                     KLoopClause
                     KLoopDo
                     KMatchClause
                     KSetter
                     KSignature
                     KArrow
                     ;; A type with at least two fields or cases that have types.
                     KFields
                     ;; The entries of a hash macro.
                     KEntries
                     KImport
                     KExport)))

(: item-at (-> Group int Node))
(defun (item-at g k)
  (if (and (>= k 0) (< k (vec-length (record-ref g items))))
      (record-ref (vec-ref (record-ref g items) k) node)
      (Leaf Nil)))

(: head-of (-> Group string))
(defun (head-of g)
  (without-prefix (node-atom (item-at g 0))))

;; The head of a list, and "" for any other node.
(: head-atom (-> Node string))
(defun (head-atom n)
  (match n
    ((Branch g) (node-atom (item-at g 0)))
    (_ "")))

;; Whether a node is a clause of a loop, such as `(:for x xs)`.
(: loop-clause? (-> Node bool))
(defun (loop-clause? n)
  (def head (head-atom n))
  (and (string-starts-with? head ":") (> (string-length head) 1)))

;; Returns the number of items of `g` that `p` holds for.
(: count-items (-> Group (-> Node bool) int))
(defun (count-items g p)
  (def items (record-ref g items))
  (let go ((k 0)
           (n 0))
    (if (= k (vec-length items))
        n
        (go (+ k 1)
            (if (p (record-ref (vec-ref items k) node))
                (+ n 1)
                n)))))

(: table-head? (-> string bool))
(defun (table-head? head)
  (match head
    ((or "import/extern" "import/class" "defeffect") #t)
    (_ #f)))

(: loop-head? (-> string bool))
(defun (loop-head? head)
  (match head
    ((or "loop" ":loop" "subloop" ":subloop" "seql") #t)
    (_ #f)))

(: let-name? (-> string bool))
(defun (let-name? raw)
  (match (list-drop-while #(= & #\,) (string->list raw))
    ((Cons c _) (char-alphabetic? c))
    (Nil #f)))

(: keyword-arg? (-> string bool))
(defun (keyword-arg? raw)
  (and (string-starts-with? raw "#:") (> (string-length raw) 2)))

;; Whether `g` is a record or a union of several fields or cases, which go on a
;; line each.
(: fields? (-> Group string bool))
(defun (fields? g head)
  (and (> (count-items g #(= (head-atom &) ":")) 1)
       (match head
         ((or "Record" "Struct" "Union") #t)
         (_ #f))))

;; Whether `g` is the list of a hash macro, `#map(...)`.
(: hash-macro? (-> Group bool))
(defun (hash-macro? g)
  (match (record-ref g prefix)
    ((Cons (TAtom s) Nil) (and (string-starts-with? s "#") (not (prefix-only? s))))
    (_ #f)))

;; What the list `g` is in `place`.
(: kind-of (-> Group Place Kind))
(defun (kind-of g place)
  (def head (head-of g))
  (def quoted?
    (match (record-ref g prefix)
      ((Cons (TAtom "'") Nil) #t)
      (_ #f)))
  (match place
    (Table KTable)
    (_ #:when quoted? KData)
    (_ #:when (= (record-ref g open) "[") KData)
    (Code #:when (and (hash-macro? g) (node-list? (item-at g 0))) KEntries)
    (Data KData)
    (Bindings KBindings)
    (Binding KBinding)
    (Arm KArm)
    (Clause
     (match head
       (":def" KLoopDef)
       (":match" KMatchClause)
       (_ KArm)))
    (DefClause KDefClause)
    (InType
     (cond
       ((= head ":") KSignature)
       ((string-ends-with? head "->") KArrow)
       ((fields? g head) KFields)
       (else KCall)))
    (Code
     (if (= (record-ref g open) "{")
         KCall
         (code-kind g head)))))

(: code-kind (-> Group string Kind))
(defun (code-kind g head)
  (match head
    ("" KCall)
    ("if" KIf)
    ("cond" KCond)
    ((or "match" "case" "syntax-match") KMatch)
    ("let" (KLet (let-name? (node-atom (item-at g 1)))))
    ((or "let*" "with-open" "parameterize" "parameterize*") (KLet #f))
    ("letrec" KLetrec)
    ((or "def" "def/mutable") KDef)
    (":def" KLoopDef)
    ("def*" KDefStar)
    ((or "defun" "defbjo" "defbjouble" "def/trait" "def/macro" "def/pattern" "when" "unless"
         "when-let" "if-let" "with-cancel" "with-deadline" "with-response" "with-run" "with-return")
     (KBody 1))
    ((or "fun" "bjoroutine" "type/derive") (KSmallBody 1))
    ("let/mono" (KBody 2))
    ((or "begin" "seq") KBlock)
    ;; In an `impl`, `(type %elem int)` sets an associated type.
    ("type" #:when (not (node-list? (item-at g 1))) KCall)
    ((or "bjo" "spawn" "spawn/daemon" "spawn/detached" "with-shield" "time-it" "try" "type"
         "type-rec")
     KSmallBlock)
    ((or "import") KImport)
    ((or "export" "re-export") KExport)
    (":" KSignature)
    (":do" KLoopDo)
    (":match" KMatchClause)
    ((or "impl" "impl/extern" ":doc") KKept)
    (_
     (cond
       ((table-head? head) KTable)
       ((record-setter? head) KSetter)
       ((and (loop-head? head) (> (count-items g loop-clause?) 0)) KLoop)
       ((and (string-starts-with? head ":") (> (string-length head) 1)) KLoopClause)
       ((and (> (string-length head) 3)
             (or (string-starts-with? head "def") (string-starts-with? head "with-")))
        KKept)
       (else KCall)))))

;; The place of item `k` of `g`, which is `kind` in `place`.
(: place-of (-> Group Place Kind int Place))
(defun (place-of g place kind k)
  (match kind
    (KTable Table)
    (KData
     (match place
       (Code #:when (and (= (record-ref g open) "[") (empty? (record-ref g prefix))) Code)
       (_ Data)))
    (KBindings Binding)
    (KBinding
     (if (= k 0)
         Data
         Code))
    (KArm
     (if (and (= k 0) (= place Arm))
         Data
         Code))
    (KDef
     (cond
       ((= k 1) Data)
       ((and (> k 2) (= (node-atom (item-at g (leave-index g))) ":leave") (> k (leave-index g))) Arm)
       (else Code)))
    (KLoopDef
     (if (= k 1)
         Data
         Code))
    (KDefStar DefClause)
    (KDefClause
     (if (= k 0)
         Data
         Code))
    (KCond Clause)
    (KMatch
     (if (> k 1)
         Arm
         Code))
    (KMatchClause
     (if (= k 1)
         Data
         Code))
    ((KLet named?)
     (if (= k (if named? 2 1))
         Bindings
         Code))
    (KLetrec
     (if (= k 1)
         Bindings
         Code))
    ((KBody _)
     (match (head-of g)
       ((or "defun" "defbjo" "defbjouble")
        (if (= k 1)
            Data
            Code))
       (_ Code)))
    ((KSmallBody _)
     (if (= k 1)
         Data
         Code))
    (KSignature
     (if (= k 0)
         Code
         InType))
    (KArrow InType)
    (KFields InType)
    (KCall
     (match place
       (InType InType)
       (_ Code)))
    (_ Code)))

;; The index of the `:leave` of a `def`, or one past its items.
(: leave-index (-> Group int))
(defun (leave-index g)
  (def items (record-ref g items))
  (let go ((k 0))
    (cond
      ((= k (vec-length items)) k)
      ((= (node-atom (record-ref (vec-ref items k) node)) ":leave") k)
      (else (go (+ k 1))))))

;; Whether the form itself, whatever is in it, may be on one line.
(: one-line? (-> Group Kind bool))
(defun (one-line? g kind)
  (def n (vec-length (record-ref g items)))
  (match kind
    (KTable (= n 0))
    (KBindings (<= n 1))
    (KArm
     (<= n
         (if (= (node-atom (item-at g 1)) "#:when")
             4
             2)))
    (KDef (def-one-line? g))
    (KLoopDef (def-one-line? g))
    (KDefClause (def-one-line? g))
    ((KBody k) (<= n (+ k 1)))
    ((KSmallBody k) (<= n (+ (head-line g k) 2)))
    (KKept (not (record-ref g spans)))
    (KBlock (<= n 2))
    (KSmallBlock (or (<= n 2) (and (= (head-of g) "try") (keyword-arg? (node-atom (item-at g 2))))))
    (KCond (<= n 1))
    (KMatch (<= n 2))
    (KMatchClause
     (<= n
         (if (= (node-atom (item-at g 3)) "#:when")
             6
             4)))
    (KIf (= (count-items g node-list?) 0))
    ((KLet _) (<= n 2))
    (KLetrec (<= n 2))
    (KDefStar (<= n 2))
    (KFields #f)
    (KLoop (<= (count-items g loop-clause?) 1))
    (KLoopDo (<= n 2))
    (_ #t)))

;; Of the failure parts, only `:propagate` may share the line.
(: def-one-line? (-> Group bool))
(defun (def-one-line? g)
  (def failing (fun (n) (and (failure-keyword? (node-atom n)) (not (= (node-atom n) ":propagate")))))
  (= (count-items g failing) 0))

;; ---------------------------------------------------------------------------
;; Plans

;; What comes before an item of a list:
;; - `Same`: a space. The item before it is kept on one line if it can be.
;; - `Mark`: as `Same`. The items after it align under this one.
;; - `Under`: a line break, aligned.
;; - `(In n)`: a line break, `n` columns in from the bracket. The items after it
;;   align under this one.
;; - `Fill`: as `Same` if the item fits on the line, else as `Under`.
(type (: Gap (Union Same Mark Under (: In int) Fill)))

;; One way to lay out a list: the gap before each item but the first, and what
;; it adds to the style cost.
(type (: Plan (Record (: gaps (Vec Gap))
                      (: style int))))

;; The plan for `g` with the gap `gap` returns for each index. A keyword
;; argument's value stays with its keyword.
(: plan (-> Group int (-> int Gap) Plan))
(defun (plan g style gap)
  (def n (vec-length (record-ref g items)))
  (def out (vecbuilder-empty))
  (let go ((k 0))
    (when (< k n)
      (def value?
        (and (> k 1)
             (keyword-arg? (node-atom (item-at g (- k 1))))
             (not (keyword-arg? (node-atom (item-at g k))))))
      (vecbuilder-add! out
                       (if value?
                           Same
                           (gap k)))
      (go (+ k 1))))
  (Plan (gaps (vecbuilder->vec out)) (style style)))

;; The first argument on the head's line and the others under it, or every
;; argument below the head, `n` columns in.
(: call-plans (-> Group int (List Plan)))
(defun (call-plans g n)
  (list (plan g 0 (fun (k)
                    (if (= k 1)
                        Mark
                        Under)))
        (plan g 1 (fun (k)
                    (if (= k 1)
                        (In n)
                        Under)))))

;; Every item but the last on the head's line, for a call whose last argument
;; is a function over several lines.
(: hugging-plans (-> Group (List Plan)))
(defun (hugging-plans g)
  (def n (vec-length (record-ref g items)))
  (match (head-atom (item-at g (- n 1)))
    ((or "fun" "bjoroutine") #:when (> n 2)
     (if (all-plain? g (- n 1))
         (list (plan g 0 (fun (k)
                           (if (= k 1)
                               Mark
                               Same))))
         Nil))
    (_ Nil)))

;; Whether the first `n` items of `g` can be written on one line.
(: all-plain? (-> Group int bool))
(defun (all-plain? g n)
  (let go ((k 0))
    (or (>= k n) (and (node-plain? (item-at g k)) (go (+ k 1))))))

;; `k` forms on the head's line and the others 2 in.
(: body-plan (-> Group int int Plan))
(defun (body-plan g on-line style)
  (plan g style (fun (k)
                  (if (<= k on-line)
                      Same
                      (In 2)))))

;; Returns how many forms go on the head's line when `k` come before the body: a
;; return type, `: type`, goes there too.
(: head-line (-> Group int int))
(defun (head-line g k)
  (if (= (node-atom (item-at g (+ k 1))) ":")
      (+ k 2)
      k))

;; The forms of a `def`, a `:def` or a `def*` clause whose pattern is item
;; `first`. The value is on the pattern's line or `below`, and each failure
;; part is on a line of its own, 2 in.
(: def-plans (-> Group int Gap (List Plan)))
(defun (def-plans g first below)
  (def string-value?
    (match (item-at g (+ first 1))
      ((Leaf _) #t)
      (_ #f)))
  (def parts
    (list (plan g 0 (fun (k) (def-gap g first below #f k)))
          (plan g 0 (fun (k) (def-gap g first below #t k)))))
  (if (or string-value? (> (vec-length (record-ref g items)) (+ first 2)))
      (Cons (plan g 0 (fun (k) (def-gap g first Same #f k))) parts)
      parts))

;; The gap before item `k` of a `def`. `propagate?` puts `:propagate` on the
;; value's line.
(: def-gap (-> Group int Gap bool int Gap))
(defun (def-gap g first value propagate? k)
  (def raw (node-atom (item-at g k)))
  (def before
    (if (> k 0)
        (node-atom (item-at g (- k 1)))
        ""))
  (cond
    ((= k first) Mark)
    ((= k (+ first 1)) value)
    ((and propagate? (= raw ":propagate")) Same)
    ((failure-keyword? raw) (In 2))
    ((= before ":leave") Mark)
    ((failure-keyword? before) Same)
    (else Under)))

;; The index of the type in a signature: the first item after the name that is
;; not a keyword, or the first item if that is an arrow, since the signature then
;; has no name.
(: type-index (-> Group int))
(defun (type-index g)
  (def n (vec-length (record-ref g items)))
  (if (string-ends-with? (head-atom (item-at g 1)) "->")
      1
      (let go ((k 2))
        (if (and (< k n) (keyword-arg? (node-atom (item-at g k))))
            (go (+ k 1))
            k))))

;; A signature: the `where` and the first marker start a line. The type is on
;; the name's line or below it.
(: signature-plan (-> Group int Gap Plan))
(defun (signature-plan g style type-gap)
  (def at (type-index g))
  (def n (vec-length (record-ref g items)))
  (def first-marker
    (let go ((k (+ at 1)))
      (if (or (>= k n) (keyword-arg? (node-atom (item-at g k))))
          k
          (go (+ k 1)))))
  (def out (vecbuilder-empty))
  (let go ((k 0))
    (when (< k n)
      (vecbuilder-add! out
                       (cond
                         ((= k 1) Mark)
                         ((= k at) type-gap)
                         ((= k first-marker) Under)
                         ((and (> k at) (< k first-marker)) Under)
                         ((keyword-arg? (node-atom (item-at g k))) Fill)
                         (else Same)))
      (go (+ k 1))))
  (Plan (gaps (vecbuilder->vec out)) (style style)))

(: plans (-> Group Kind (List Plan)))
(defun (plans g kind)
  (def items (record-ref g items))
  (def n (vec-length items))
  (defun (broke? k)
    (record-ref (vec-ref items k) broke))
  (match kind
    (KCall (list-append (hugging-plans g) (call-plans g 1)))
    (KData (data-plans g))
    (KTable (list (table-plan g)))
    (KBindings (list (plan g 0 (fun (k) (In 1)))))
    (KBinding (call-plans g 1))
    (KArm (arm-plans g))
    (KDef (def-plans g 1 (In 2)))
    (KLoopDef (def-plans g 1 Under))
    (KDefStar (call-plans g 1))
    (KDefClause (def-plans g 0 (In 1)))
    ((KBody k) (list (body-plan g (head-line g k) 0)))
    ((KSmallBody k) (list (body-plan g (head-line g k) 0)))
    (KKept
     (def on-line
       (let go ((k 1))
         (if (and (< k n) (not (broke? k)))
             (go (+ k 1))
             (- k 1))))
     (def least
       (if (> on-line 1)
           1
           on-line))
     (if (or (not (record-ref g spans)) (= on-line least))
         (list (body-plan g least 0))
         (list (body-plan g on-line 0) (body-plan g least 1))))
    (KBlock (list (body-plan g 0 0)))
    (KSmallBlock
     (def single? (and (<= n 2) (= (head-of g) "type")))
     (if single?
         (list (body-plan g 1 0) (body-plan g 0 1))
         (list (body-plan g 0 0))))
    (KCond (list (body-plan g 0 0)))
    (KMatch (list (body-plan g 1 0)))
    (KMatchClause
     (list (plan g 0 (fun (k)
                       (if (or (< k 3) (= (node-atom (item-at g k)) "#:when"))
                           Same
                           (In 1))))))
    (KIf
     (list (plan g 0 (fun (k)
                       (if (= k 1)
                           Mark
                           Under)))))
    ((KLet named?) (list (body-plan g (if named? 2 1) 0)))
    (KLetrec (call-plans g 2))
    (KLoop (list (loop-plan g)))
    (KLoopClause
     (list (plan g 0 (fun (k)
                       (cond
                         ((= k 1) Mark)
                         ((= k 2) Same)
                         (else Under))))
           (plan g 1 (fun (k)
                       (if (= k 1)
                           Mark
                           Under)))))
    (KLoopDo (call-plans g 1))
    (KSetter
     (def stacked
       (plan g 0 (fun (k)
                   (cond
                     ((= k 1) Same)
                     ((= k 2) Mark)
                     (else Under)))))
     (if (and (> n 2) (node-plain? (item-at g 1)))
         (Cons stacked (call-plans g 1))
         (call-plans g 1)))
    (KSignature
     (if (<= n 2)
         (call-plans g 1)
         (if (> (type-index g) 2)
             (list (signature-plan g 0 Under))
             (list (signature-plan g 0 Same) (signature-plan g 1 Under)))))
    (KArrow
     (list (plan g 0 (fun (k)
                       (if (= k 1)
                           Mark
                           Fill)))))
    (KFields (call-plans g 1))
    (KEntries (data-plans g))
    (KImport (call-plans g 2))
    (KExport
     (list (plan g 0 (fun (k)
                       (cond
                         ((= k 1) (In 2))
                         ((broke? k) Under)
                         (else Fill))))))))

;; The lines the source has.
(: table-plan (-> Group Plan))
(defun (table-plan g)
  (def items (record-ref g items))
  (def out (vecbuilder-empty))
  (let go ((k 0))
    (when (< k (vec-length items))
      (vecbuilder-add! out
                       (cond
                         ((record-ref (vec-ref items k) broke) Under)
                         ((= k 1) Mark)
                         (else Same)))
      (go (+ k 1))))
  (Plan (gaps (vecbuilder->vec out)) (style 0)))

;; Data is filled, and has an item per line if any item is a list. A list that
;; starts with one has every item under the first.
(: data-plans (-> Group (List Plan)))
(defun (data-plans g)
  (def lists? (> (count-items g node-list?) 0))
  (def first-list? (node-list? (item-at g 0)))
  (cond
    ((or first-list? (and lists? (= (record-ref g open) "["))) (list (plan g 0 (fun (k) (In 1)))))
    ((= (record-ref g open) "[") (list (plan g 0 (fun (k) Fill))))
    (lists? (call-plans g 1))
    (else
     (list (plan g 0 (fun (k)
                       (if (= k 1)
                           Mark
                           Fill)))))))

;; A clause: its pattern, its `#:when` guard, and its body below, under the
;; pattern. A guard that does not fit goes below the pattern.
(: arm-plans (-> Group (List Plan)))
(defun (arm-plans g)
  (cond
    ((= (node-atom (item-at g 1)) "#:when")
     (def first-list? (node-list? (item-at g 0)))
     (list (plan g 0 (fun (k)
                       (cond
                         ((= k 1) (if first-list? Same Mark))
                         ((> k 3) Under)
                         ((> k 2)
                          (if first-list?
                              (In 1)
                              Under))
                         (else Same))))
           (plan g 1 (fun (k)
                       (if (= k 1)
                           (In 1)
                           Under)))))
    (else (list (plan g 0 (fun (k) (In 1)))))))

;; A loop: each clause on a line of its own, under the first. `=>` and the
;; result are 2 in.
(: loop-plan (-> Group Plan))
(defun (loop-plan g)
  (plan g 0 (fun (k)
              (cond
                ((= (node-atom (item-at g k)) "=>") (In 2))
                ((= (node-atom (item-at g (- k 1))) "=>") Same)
                ((= k 1) Mark)
                (else Under)))))

;; ---------------------------------------------------------------------------
;; Choosing a layout

;; What is known about the lists of one top-level form, by list id: whether one
;; may be on one line, and its layouts, by id and column.
(type (: Memo (Record (: flat (MutableMap int bool))
                      (: laid (MutableMap int (List Measure))))))

(: flat-ok? (-> Memo Node Place bool))
(defun (flat-ok? memo node place)
  (match node
    ((Leaf _) (node-plain? node))
    ((Branch g) #:when (not (record-ref g plain)) #f)
    ((Branch g)
     (match (mutablemap-try-ref (record-ref memo flat) (record-ref g id))
       ((Some known) known)
       (None
        (def kind (kind-of g place))
        (def n (vec-length (record-ref g items)))
        (def ok
          (and (one-line? g kind)
               (let go ((k 0))
                 (or (= k n)
                     (and (flat-ok? memo (item-at g k) (place-of g place kind k)) (go (+ k 1)))))))
        (mutablemap-set! (record-ref memo flat) (record-ref g id) ok)
        ok)))))

;; The layouts of an atom or a string at `col`.
(: leaf-measure (-> (List Tok) int Measure))
(defun (leaf-measure toks col)
  (list-foldl (fun (t m)
                (def at (record-ref m last))
                (def written (tok-written t at))
                (def part
                  (if (breaks? t)
                      (string-measure written t at)
                      (text-measure at (columns written) (Text t))))
                (then m part))
              (text-measure col 0 Empty)
              toks))

;; A string over several lines, whose widths are its own.
(: string-measure (-> string Tok int Measure))
(defun (string-measure written t col)
  (def (Tuple last breaks) (advance written col))
  (Measure (last last) (over 0) (lines breaks) (style 0) (rope (Text t))))

;; The layouts of `node` at `col`, with `tail` closing brackets after it.
(: lay (-> Memo Node Place int int (List Measure)))
(defun (lay memo node place col tail)
  (match node
    ((Leaf toks) (list (leaf-measure toks col)))
    ((Branch g)
     (def key
       (+ (* (record-ref g id) 1024)
          (if (> col 1023)
              1023
              col)))
     (match (mutablemap-try-ref (record-ref memo laid) key)
       ((Some known) known)
       (None
        (def width (record-ref g width))
        (def flat? (flat-ok? memo node place))
        ;; A line this wide is never chosen when there is anything to break.
        (def possible? (and flat? (or (< width 1000) (= (vec-length (record-ref g items)) 0))))
        (def flat
          (if possible?
              (list (text-measure col width (Flat node)))
              Nil))
        (def found
          (if (or (= (vec-length (record-ref g items)) 0) (and flat? (<= (+ col width tail) wide)))
              (if flat?
                  flat
                  (lay-group memo g place col tail))
              (merged flat (lay-group memo g place col tail))))
        (mutablemap-set! (record-ref memo laid) key found)
        found)))))

;; The layouts of `g` that its plans give.
(: lay-group (-> Memo Group Place int int (List Measure)))
(defun (lay-group memo g place col tail)
  (def kind (kind-of g place))
  (def opening
    (then (leaf-measure (record-ref g prefix) col)
          (text-measure (+ col (prefix-width (record-ref g prefix)))
                        1
                        (Text (TOpen (record-ref g open))))))
  (def n (vec-length (record-ref g items)))
  (if (= n 0)
      (list (closed g opening))
      (list-foldl (fun (p found)
                    (merged found
                            (list-map #(closed g &) (lay-plan memo g place kind p opening tail))))
                  Nil
                  (plans g kind))))

;; `m`, which is `g` up to its closing bracket, with the bracket. A comment
;; before the bracket puts it on a line of its own.
(: closed (-> Group Measure Measure))
(defun (closed g m)
  (def n (vec-length (record-ref g items)))
  (def noted
    (list-foldl (fun (c m) (with-note (newline-to m 0 (record-ref c blank)) c))
                m
                (record-ref g tail)))
  (def after-comment?
    (or (not (empty? (record-ref g tail)))
        (and (> n 0) (some? (record-ref (vec-ref (record-ref g items) (- n 1)) trail)))))
  (def at
    (if after-comment?
        (newline-to noted 0 #f)
        noted))
  (then at (text-measure (record-ref at last) 1 (Text (TClose (partner (record-ref g open)))))))

;; `m` with the comment `c` on the line it has just started.
(: with-note (-> Measure Note Measure))
(defun (with-note m c)
  (def indent (record-ref c indent))
  (with-rope m
    (if (string-empty? indent)
        (Text (TComment (record-ref c text)))
        (Join (Text (TSpace indent)) (Text (TComment (record-ref c text)))))))

;; The layouts of `g` according to `p`, up to its closing bracket.
(: lay-plan (-> Memo Group Place Kind Plan Measure int (List Measure)))
(defun (lay-plan memo g place kind p opening tail)
  (def items (record-ref g items))
  (def n (vec-length items))
  (def bracket (- (record-ref opening last) 1))
  (def gaps (record-ref p gaps))
  ;; `ms` are the layouts up to item `k`, and `align` is the column that items
  ;; after it align under.
  (let go ((k 0)
           (align (+ bracket 1))
           (ms (list (record-set opening (style (record-ref p style))))))
    (cond
      ((= k n) ms)
      (else
       (def it (vec-ref items k))
       (def its-place (place-of g place kind k))
       (def its-tail
         (if (= k (- n 1))
             (+ tail 1)
             0))
       (def node (record-ref it node))
       (def forced?
         (or (not (empty? (record-ref it lead)))
             (and (> k 0) (some? (record-ref (vec-ref items (- k 1)) trail)))))
       ;; Whether the next item stays on this one's line.
       (def followed?
         (and (< (+ k 1) n)
              (none? (record-ref it trail))
              (empty? (record-ref (vec-ref items (+ k 1)) lead))
              (match (vec-ref gaps (+ k 1))
                (Same #t)
                (Mark #t)
                (_ #f))))
       ;; The layouts of the item after `m`.
       (: placed (-> Measure (List Measure)))
       (defun (placed m)
         (def at (record-ref m last))
         (def whole
           (if (and followed? (flat-ok? memo node its-place))
               (list (text-measure at (node-width node) (Flat node)))
               (lay memo node its-place at its-tail)))
         (list-map (fun (x) (trailed it (then m x))) whole))
       (def space
         (match kind
           (KTable (record-ref it space))
           (_ " ")))
       (: spaced (-> Measure Measure))
       (defun (spaced m)
         (then m (text-measure (record-ref m last) (columns space) (Text (TSpace space)))))
       (: on-new-line (-> int (List Measure)))
       (defun (on-new-line at)
         (go (+ k 1) at (placed (led it (best ms) at (> k 0)))))
       (: each-placed (-> (List Measure)))
       (defun (each-placed)
         (list-foldl (fun (m found) (merged found (placed (spaced m)))) Nil ms))
       (cond
         ((= k 0)
          (go 1
              align
              (list-foldl (fun (m found) (merged found (placed (led it m align #f)))) Nil ms)))
         (else
          (match (vec-ref gaps k)
            (Under (on-new-line align))
            ((In d) (on-new-line (+ bracket d)))
            (_ #:when forced? (on-new-line align))
            (Same (go (+ k 1) align (each-placed)))
            (Mark
             (list-foldl (fun (m found)
                           (def s (spaced m))
                           (merged found (go (+ k 1) (record-ref s last) (placed s))))
                         Nil
                         ms))
            (Fill
             (def m (best ms))
             ;; A keyword needs room for its value too.
             (def value
               (if (and (keyword-arg? (node-atom node)) (< (+ k 1) n))
                   (+ 1
                      (node-width (item-at g (+ k 1)))
                      (if (= k (- n 2))
                          (+ tail 1)
                          0))
                   0))
             (def stop (+ (record-ref m last) 1 (node-width node) value its-tail))
             (if (and (<= stop wide) (flat-ok? memo node its-place))
                 (go (+ k 1) align (placed (spaced m)))
                 (on-new-line align))))))))))

;; `m` with its comments and, if `break?`, a line break before item `it`, which
;; then starts at `col`.
(: led (-> Item Measure int bool Measure))
(defun (led it m col break?)
  (def (Tuple after started?)
    (list-foldl (fun (c st)
                  (match st
                    ((Tuple m started?)
                     (Tuple (with-note (if started?
                                           (newline-to m col (record-ref c blank))
                                           m)
                              c)
                            #t))))
                (Tuple m break?)
                (record-ref it lead)))
  (if started?
      (newline-to after col (record-ref it blank))
      m))

;; `m` with the comment on the line of item `it`, which costs nothing.
(: trailed (-> Item Measure Measure))
(defun (trailed it m)
  (match (record-ref it trail)
    ((Some s) (with-rope m (Join Blank (Text (TComment s)))))
    (None m)))

;; ---------------------------------------------------------------------------
;; Printing

;; The tokens of `items`, a file's top-level forms, each laid out.
(: printed (-> (Vec Item) (List Note) (List Tok)))
(defun (printed items tail)
  ;; The tokens, the last first.
  (def rope
    (let go ((k 0)
             (out Empty))
      (cond
        ((= k (vec-length items))
         (list-foldl
          (fun (c out)
            (Join out
                  (record-ref (with-note (newline-to (text-measure 0 0 Empty) 0 (record-ref c blank))
                                c)
                              rope)))
          out
          tail))
        (else
         (def it (vec-ref items k))
         (def memo (Memo (flat (mutablemap)) (laid (mutablemap))))
         (def start (led it (text-measure 0 0 Empty) 0 #t))
         (def form (then start (best (lay memo (record-ref it node) Code 0 0))))
         (go (+ k 1) (Join out (record-ref (trailed it form) rope)))))))
  (list-reverse (rope-toks rope Nil)))

;; The tokens of `rope` before `out`, the last first.
(: rope-toks (-> Rope (List Tok) (List Tok)))
(defun (rope-toks rope out)
  (match rope
    (Empty out)
    (Blank (Cons (TSpace " ") out))
    (Break (Cons TNewline out))
    ((Text t) (Cons t out))
    ((Flat n) (node-toks n out))
    ((Join a b) (rope-toks b (rope-toks a out)))))

;; The tokens of `n` on one line before `out`, the last first.
(: node-toks (-> Node (List Tok) (List Tok)))
(defun (node-toks n out)
  (match n
    ((Leaf toks) (list-foldl Cons out toks))
    ((Branch g)
     (def items (record-ref g items))
     (def opened (Cons (TOpen (record-ref g open)) (list-foldl Cons out (record-ref g prefix))))
     (def filled
       (let go ((k 0)
                (out opened))
         (if (= k (vec-length items))
             out
             (go (+ k 1)
                 (node-toks (record-ref (vec-ref items k) node)
                            (if (= k 0)
                                out
                                (Cons (TSpace " ") out)))))))
     (Cons (TClose (partner (record-ref g open))) filled))))

;; The tokens with their line breaks chosen again.
(: rebroken (-> (List Tok) (List Tok)))
(defun (rebroken toks)
  (def ids (mutablemap))
  (defun (next-id)
    (def id (+ (mutablemap-ref-or ids 0 0) 1))
    (mutablemap-set! ids 0 id)
    id)
  (def written
    (list-map (fun (t)
                (match t
                  ((TStr s) (TStr (escape-tabs s)))
                  (_ t)))
              toks))
  (def p (parse written next-id))
  (printed (record-ref p items) (record-ref p tail)))

;; ---------------------------------------------------------------------------
;; The whole of it

;; `source` laid out, with what is to be said about its lines, each with its
;; line number in what is laid out (see `notes-on`); or why it cannot be: it
;; does not read, or, which would be a bug here, laying it out would change
;; its tokens.
(: format-source (-> string (Result string (Tuple string (List (Tuple int string))))))
(defun (format-source source)
  (def cs (string->vec source))
  (def (Ok toks) (tokenize cs)
    :leave ((Err why) (Err why)))
  (def (Ok _) (balanced toks)
    :leave ((Err why) (Err why)))
  (def (Tuple result notes) (layout (rebroken toks)))
  (def (Ok again) (tokenize (string->vec result))
    :leave ((Err why) (Err #"formatting made it unreadable: ${why}")))
  (if (= (significant again) (significant toks))
      (Ok (Tuple result (list-sort (list-append notes (width-notes source result)))))
      (Err "formatting would change its tokens, which is a bug in bjo fmt")))

;; The tokens laid out, and what is to be said about their lines.
(: layout (-> (List Tok) (Tuple string (List (Tuple int string)))))
(defun (layout toks)
  (def lines (squeeze-blank-lines (lines-of toks)))
  (def out (stringbuilder-empty))
  (def done
    (list-foldl (fun (l st) (write-line out st l))
                (State (frames Nil) (kept (list None)) (kept-depth 0) (line 1) (notes Nil))
                lines))
  (Tuple (stringbuilder->string out) (list-reverse (record-ref done notes))))
