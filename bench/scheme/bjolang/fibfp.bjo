;; FIBFP -- Computes fib(n) inefficiently, with doubles.
;; Arguments: count n expected

(import "common.bjo")

(: fibfp (-> double double))
(defun (fibfp n)
  (if (< n 2.0)
      n
      (+ (fibfp (- n 1.0)) (fibfp (- n 2.0)))))

(defun (main args)
  (def n (arg-double args 1))
  (def expected (arg-double args 2))
  (run-benchmark "fibfp" (arg-int args 0) (fun () (fibfp n)) #(= & expected)))
