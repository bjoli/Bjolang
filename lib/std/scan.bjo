;; std/scan.bjo — reading a line by a pattern, after OCaml's Scanf.
;;
;; `(scan line '(long "-" long))` reads two longs with a dash between them and
;; answers them as a tuple. The pattern is a quoted list, read when the macro
;; expands: the expansion is straight-line code over the line's bytes, one
;; step of `BjoScan.cs` per item, with no pattern left to interpret at run
;; time. A number step answers a value and the next position as a value
;; tuple, so a pattern of numbers allocates nothing. A text step answers only
;; the next position, and the value is a slice made after it, so text that
;; `(:skip ...)` drops allocates nothing either.
;;
;; The code is built in continuation-passing style: each item is given what to
;; do with its value and the position after it, and what to do when it does
;; not match. Where the rest of the pattern would be copied into two places —
;; after a repetition, an option or a choice — it is a local function instead,
;; a join point, so the expansion grows with the pattern and not faster.
(import (std prelude) (std syntax-match))

(:doc #:file "scan.bjodoc")

(export scan-lit scan-byte scan-lit8 scan-ws scan-int scan-long scan-double scan-char scan-word
        scan-rest scan-chars scan-until scan-until-byte scan-slice scan-end? scan-fail scan-message)

;; What the expansion calls. Exported, because a template reaches a helper of
;; its own module only through the module's exports.
(import/extern
  (scan-lit     (: Bjolang.Runtime.BjoScan.Lit     (-> string int string int)))
  (scan-byte    (: Bjolang.Runtime.BjoScan.Byte    (-> string int int int)))
  (scan-lit8    (: Bjolang.Runtime.BjoScan.Lit8    (-> string int long int int)))
  (scan-ws      (: Bjolang.Runtime.BjoScan.Ws      (-> string int int)))
  (scan-int     (: Bjolang.Runtime.BjoScan.Int     (-> string int int (Tuple int int))))
  (scan-long    (: Bjolang.Runtime.BjoScan.Long    (-> string int int (Tuple long int))))
  (scan-double  (: Bjolang.Runtime.BjoScan.Double  (-> string int int (Tuple double int))))
  (scan-char    (: Bjolang.Runtime.BjoScan.Char    (-> string int (Tuple char int))))
  (scan-word    (: Bjolang.Runtime.BjoScan.Word    (-> string int int int)))
  (scan-rest    (: Bjolang.Runtime.BjoScan.Rest    (-> string int int int)))
  (scan-chars   (: Bjolang.Runtime.BjoScan.Chars   (-> string int long long int int)))
  (scan-until   (: Bjolang.Runtime.BjoScan.Until   (-> string int long long int int)))
  (scan-until-byte (: Bjolang.Runtime.BjoScan.UntilByte (-> string int int int int)))
  (scan-slice   (: Bjolang.Runtime.BjoScan.Slice   (-> string int int string)))
  (scan-end?    (: Bjolang.Runtime.BjoScan.End     (-> string int bool)))
  (scan-fail    (: Bjolang.Runtime.BjoScan.Fail    (-> string int string %a)))
  (scan-message (: Bjolang.Runtime.BjoScan.Message (-> string int string string))))

;; ---------------------------------------------------------------------------
;; The pattern
;; ---------------------------------------------------------------------------

;; One item of a pattern. An `(Option int)` is the item's width: the most
;; characters it reads. `ISet` is the characters of `(chars ...)`, or of
;; `(until ...)` when its flag is set, and the text an error says it
;; expected.
(type (: Item (Union (: ILit string)
                     IWs
                     (: IRead string (Option int))
                     (: ISet string bool string (Option int))
                     (: IGroup (List Item))
                     (: IRep Item (Option Item))
                     (: IOpt Item)
                     (: IOr (List Item))
                     (: ISkip Item))))

;; Whether the item reads a value, which the result then holds.
(: (-> Item bool))
(defun (valued? item)
  (match item
    ((ILit _) #f)
    (IWs #f)
    ((IRead _ _) #t)
    ((ISet _ _ _ _) #t)
    ((IGroup items) (any? valued? items))
    ((IRep _ _) #t)
    ((IOpt inner) (valued? inner))
    ((IOr alts) (valued? (list-head alts)))
    ((ISkip _) #f)))

;; What an error says the item was expected to be.
(: (-> Item string))
(defun (describe item)
  (match item
    ((ILit t) (str "\"" t "\""))
    (IWs "whitespace")
    ((IRead kind _)
     (case kind
       (("int") "an int")
       (("long") "a long")
       (("double") "a double")
       (("char") "a character")
       (("word") "a word")
       (else "the rest of the line")))
    ((ISet _ _ what _) what)
    ((IGroup items) (if (list-empty? items) "nothing" (describe (list-head items))))
    ((IRep inner _) (describe inner))
    ((IOpt inner) (describe inner))
    ((IOr alts) (str "one of " (string-join (list->vec (list-map describe alts)) ", ")))
    ((ISkip inner) (describe inner))))

(: (-> char bool))
(defun (space? c) (or (char=? c #\space) (char=? c #\tab)))

;; A string of a pattern: the text between its spaces, each exactly, and a
;; run of spaces as any amount of whitespace.
(: (-> string (List Item)))
(defun (string-items text)
  (defun (flush lit acc)
    (if (list-empty? lit) acc (Cons (ILit (list->string (list-reverse lit))) acc)))
  (defun (skip cs)
    (match cs
      ((Cons c rest) #:when (space? c) (skip rest))
      (_ cs)))
  (let go ((cs (string->list text)) (lit Nil) (acc Nil))
    (match cs
      (Nil (list-reverse (flush lit acc)))
      ((Cons c rest)
       (cond ((space? c)
              (go (skip rest) Nil (Cons IWs (flush lit acc))))
             (else (go rest (Cons c lit) acc)))))))

;; The bit of an ASCII character in a set's two halves.
(: (-> int (Tuple long long)))
(defun (char-bit code)
  (if (< code 64)
      (Tuple (shift-left 1L code) 0L)
      (Tuple 0L (shift-left 1L (- code 64)))))

;; The characters a `(chars ...)` keyword names.
(: (-> string (Option string)))
(defun (char-class name)
  (case name
    (("digit") (Some "0123456789"))
    (("lower") (Some "abcdefghijklmnopqrstuvwxyz"))
    (("upper") (Some "ABCDEFGHIJKLMNOPQRSTUVWXYZ"))
    (("alpha") (Some "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ"))
    (("alnum") (Some "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789"))
    (("hex") (Some "0123456789abcdefABCDEF"))
    (else None)))

;; A set of ASCII characters as the two halves `BjoScan.cs` tests a byte
;; against.
(: (-> string (Tuple long long)))
(defun (mask text)
  (string-fold
   (fun (c acc)
     (def (l . h) (char-bit (char->integer c)))
     (Tuple (bitwise-ior (fst acc) l) (bitwise-ior (snd acc) h)))
   (Tuple 0L 0L) text))

;; The characters of a string of a set, with `a-z` as all the characters from
;; `a` to `z`. A `-` at the start or the end is itself.
(: (-> string string Syntax string))
(defun (with-ranges text form at)
  (defun (span from to)
    (let go ((c to) (acc Nil))
      (if (< c from) (list->string acc) (go (- c 1) (Cons (integer->char c) acc)))))
  (let go ((cs (string->list text)) (acc ""))
    (match cs
      ((Cons a (Cons dash (Cons b rest))) #:when (char=? dash #\-)
       (def* (from (char->integer a))
             (to (char->integer b)))
       (when (> from to)
         (ignore (ret-error at (str form " has the range " (char->string a) "-" (char->string b) ", which goes backwards."))))
       (go rest (str acc (span from to))))
      ((Cons c rest) (go rest (str acc (char->string c))))
      (Nil acc))))

;; `(chars ".#")`, `(chars "a-z" :digit)` and the same for `(until ...)`:
;; the characters of the strings and the classes. `form` names the item in
;; errors.
(: (-> string bool (List Syntax) Syntax Item))
(defun (set-item form until? parts whole)
  (def text
    (fold
     (fun (part acc)
       (match part
         ((SStr s) (str acc (with-ranges s form part)))
         ((SKey k)
          (match (char-class (displayed k))
            ((Some cs) (str acc cs))
            (None (ret-error part (str form " knows the classes :digit, :lower, :upper, :alpha, :alnum and :hex, not :" (displayed k) ".")))))
         (_ (ret-error part (str form " takes strings of characters and class keywords, such as (chars \".#\"), (chars \"a-z\" \"_\") or (until \",\").")))))
     "" parts))
  (when (string-empty? text)
    (ignore (ret-error whole (str form " needs at least one character."))))
  (string-for-each
   (fun (c)
     (when (>= (char->integer c) 128)
       (ignore (ret-error whole (str form " takes ASCII characters only, and " (char->string c) " is not one.")))))
   text)
  (def written
    (string-join
     (list->vec (list-map (fun (part)
                            (match part
                              ((SStr s) (str "\"" s "\""))
                              ((SKey k) (str ":" (displayed k)))
                              (_ "")))
                          parts))
     " "))
  (ISet text until? (if until? (str "text up to one of " written) (str "one of " written)) None))

;; A syntax error, as a value of any type: the transformer raises it, and the
;; expander reports it at the form it names.
(: (-> Syntax string %a))
(defun (ret-error at message)
  (ignore (syntax-error at message))
  (panic! "unreachable: syntax-error does not return"))

(: (-> Syntax string bool))
(defun (keyword? s name)
  (match s
    ((SKey k) (= (displayed k) name))
    (_ #f)))

(def items-are
  "The items are strings, int, long, double, char, word, rest, (chars ...), (until ...), a group (...), (:? ...), (:or ...) and (:skip ...).")

;; One item, without what follows it.
(: (-> Syntax Item))
(defun (parse-item s)
  (match s
    ((SStr text)
     (match (string-items text)
       ((Cons only Nil) only)
       (items (IGroup items))))
    ((SSym name)
     (def kind (symbol->string name))
     (if (any? #(= & kind) (list "int" "long" "double" "char" "word" "rest"))
         (IRead kind None)
         (ret-error s (str "'" kind "' is not an item of a scan pattern. " items-are))))
    ((SList (Cons head rest))
     (cond ((keyword? head "?")
            (IOpt (group-of (parse-items rest s))))
           ((keyword? head "or") (or-item rest s))
           ((keyword? head "skip")
            (ISkip (group-of (parse-items rest s))))
           ((named? head "chars") (set-item "(chars ...)" #f rest s))
           ((named? head "until") (set-item "(until ...)" #t rest s))
           (else (IGroup (parse-items (Cons head rest) s)))))
    ((SList Nil) (IGroup Nil))
    (_ (ret-error s (str "This is not an item of a scan pattern. " items-are)))))

(: (-> Syntax string bool))
(defun (named? s name)
  (match s
    ((SSym n) (= (symbol->string n) name))
    (_ #f)))

;; `item #:width n`: the item reads no more than n characters.
(: (-> Item int Syntax Item))
(defun (with-width item n at)
  (def message "#:width goes after int, long, double, word, rest, (chars ...) or (until ...).")
  (match item
    ((IRead _ (Some _)) (ret-error at "This item has a #:width already."))
    ((ISet _ _ _ (Some _)) (ret-error at "This item has a #:width already."))
    ((IRead kind None)
     (if (= kind "char") (ret-error at message) (IRead kind (Some n))))
    ((ISet text until? what None) (ISet text until? what (Some n)))
    (_ (ret-error at message))))

;; `(:or a b ...)`: each choice is one item, and they all read a value or
;; none does.
(: (-> (List Syntax) Syntax Item))
(defun (or-item choices whole)
  (def alts (list-map (fun (a) (group-of (parse-items (list a) a))) choices))
  (when (list-empty? alts)
    (ignore (ret-error whole "(:or ...) needs at least one choice.")))
  (when (not (all? #(= (valued? &) (valued? (list-head alts))) alts))
    (ignore (ret-error whole "(:or ...) needs every choice to read a value, or none of them.")))
  (IOr alts))

;; A list of items as one item.
(: (-> (List Item) Item))
(defun (group-of items)
  (match items
    ((Cons only Nil) only)
    (_ (IGroup items))))

;; The items of a list, with `item ...` and `item ... #:sep sep` read as
;; repetitions of the item before them, and `item #:width n` as the item
;; with a width.
(: (-> (List Syntax) Syntax (List Item)))
(defun (parse-items xs whole)
  (let go ((xs xs) (acc Nil))
    (match xs
      (Nil (list-reverse acc))
      ((Cons k (Cons (SInt digits) more)) #:when (and (keyword? k "width") (> (string->int digits) 0))
       (match acc
         (Nil (ret-error k "#:width gives a width to the item before it, and there is none."))
         ((Cons prev before) (go more (Cons (with-width prev (string->int digits) k) before)))))
      ((Cons k _) #:when (keyword? k "width")
       (ret-error k "#:width needs a number of characters after it, as in int #:width 4."))
      ((Cons (SPunct "...") rest)
       (match acc
         (Nil (ret-error whole "A '...' repeats the item before it, and there is none."))
         ((Cons prev before)
          (when (not (valued? prev))
            (ignore (ret-error whole "A '...' repeats an item that reads a value, and a string reads none. Put the string in a group with something that does, as in (\"(\" int \")\") ...")))
          (match rest
            ((Cons k (Cons sep more)) #:when (keyword? k "sep")
             (go more (Cons (IRep prev (Some (parse-item sep))) before)))
            ((Cons k Nil) #:when (keyword? k "sep")
             (ret-error whole "#:sep needs the separator after it, as in int ... #:sep \",\"."))
            (_ (go rest (Cons (IRep prev None) before)))))))
      ((Cons x rest) (go rest (Cons (parse-item x) acc))))))

;; ---------------------------------------------------------------------------
;; The expansion
;; ---------------------------------------------------------------------------

;; The line's name in the expansion, and a counter for the expansion's own
;; temporaries. Each temporary is built from a string, so that each one gets a
;; name of its own: hygiene gives every distinct name one fresh spelling per
;; expansion, and one template name used at every depth would shadow itself.
;; `keep` is false inside `(:skip ...)`: there an item gives no value, so a
;; text item makes no slice and a repetition no vec.
(type (: Ctx (Record (: line Syntax) (: counter (Array int)) (: keep bool))))

;; Whether the item gives a value here.
(: (-> Ctx Item bool))
(defun (holds? ctx item) (and (.keep ctx) (valued? item)))

(: (-> Ctx string Syntax))
(defun (fresh ctx prefix)
  (def n (ref (.counter ctx) 0))
  (array-set! (.counter ctx) 0 (+ n 1))
  (SSym (string->symbol (str "scan-" prefix (displayed n)))))

;; What an item does with its value and the position after it, and what it
;; does when it does not match.
(type (: OnValue (-> (Option Syntax) Syntax Syntax)))
(type (: OnMiss (-> Syntax string Syntax)))

;; A width as the steps take it: -1 for none.
(: (-> (Option int) Syntax))
(defun (width-literal width)
  (match width
    ((Some n) (SInt (int->string n)))
    (None (SInt "-1"))))

(: (-> int Syntax))
(defun (int-literal n) (SInt (int->string n)))

(: (-> long Syntax))
(defun (long-literal n) (SInt (str (long->string n) "L")))

;; Up to 8 byte values as one long, the first in the lowest byte, as
;; `scan-lit8` reads them.
(: (-> (List int) long))
(defun (packed codes)
  (list-foldr (fun (code acc) (bitwise-ior (shift-left acc 8) (cast System.Int64 code))) 0L codes))

;; Code for `item` at position `p`.
(: (-> Ctx Item Syntax OnValue OnMiss Syntax))
(defun (gen ctx item p ok fail)
  (def s (.line ctx))
  (match item
    ((ILit text)
     (def q (fresh ctx "q"))
     (def codes (list-map char->integer (string->list text)))
     (def n (list-length codes))
     (def step
       (cond ((not (all? #(< & 128) codes)) #'(scan-lit ,s ,p ,(SStr text)))
             ((= n 1) #'(scan-byte ,s ,p ,(int-literal (list-head codes))))
             ((<= n 8) #'(scan-lit8 ,s ,p ,(long-literal (packed codes)) ,(int-literal n)))
             (else #'(scan-lit ,s ,p ,(SStr text)))))
     #'(let ((,q ,step))
         (if (< ,q 0) ,(fail p (describe item)) ,(ok None q))))
    (IWs
     (def q (fresh ctx "q"))
     #'(let ((,q (scan-ws ,s ,p))) ,(ok None q)))
    ((IRead kind width)
     (def w (width-literal width))
     (case kind
       (("int") (gen-number ctx item #'(scan-int ,s ,p ,w) p ok fail))
       (("long") (gen-number ctx item #'(scan-long ,s ,p ,w) p ok fail))
       (("double") (gen-number ctx item #'(scan-double ,s ,p ,w) p ok fail))
       (("char") (gen-number ctx item #'(scan-char ,s ,p) p ok fail))
       (("word") (gen-text ctx item #'(scan-word ,s ,p ,w) p ok fail))
       (else (gen-text ctx item #'(scan-rest ,s ,p ,w) p ok fail))))
    ((ISet text until? _ width)
     (def w (width-literal width))
     (def (low . high) (mask text))
     (def step
       (cond ((not until?) #'(scan-chars ,s ,p ,(long-literal low) ,(long-literal high) ,w))
             ((= (string-length text) 1)
              #'(scan-until-byte ,s ,p ,(int-literal (char->integer (list-head (string->list text)))) ,w))
             (else #'(scan-until ,s ,p ,(long-literal low) ,(long-literal high) ,w))))
     (gen-text ctx item step p ok fail))
    ((IGroup items) (gen-seq ctx items p Nil ok fail))
    ((IOpt inner) (gen-opt ctx inner p ok))
    ((IOr alts) (gen-or ctx alts item p ok fail))
    ((IRep inner sep) (gen-rep ctx inner sep p ok))
    ((ISkip inner)
     (gen (Ctx (line s) (counter (.counter ctx)) (keep #f)) inner p
          (fun (_ q) (ok None q)) fail))))

;; A step that answers a value and the position after it.
(: (-> Ctx Item Syntax Syntax OnValue OnMiss Syntax))
(defun (gen-number ctx item step p ok fail)
  (def* (v (fresh ctx "v"))
        (q (fresh ctx "q")))
  #'(match ,step
      ((,v . ,q) (if (< ,q 0) ,(fail p (describe item)) ,(ok (if (.keep ctx) (Some v) None) q)))))

;; A step that answers the position after its text. The value is the slice
;; from `p` to there, made only where the value is used.
(: (-> Ctx Item Syntax Syntax OnValue OnMiss Syntax))
(defun (gen-text ctx item step p ok fail)
  (def* (s (.line ctx))
        (q (fresh ctx "q")))
  #'(let ((,q ,step))
      (if (< ,q 0)
          ,(fail p (describe item))
          ,(ok (if (.keep ctx) (Some #'(scan-slice ,s ,p ,q)) None) q))))

;; Code for items in order. A group's value is its one value, or a tuple of
;; its values, or none.
(: (-> Ctx (List Item) Syntax (List Syntax) OnValue OnMiss Syntax))
(defun (gen-seq ctx items p vals ok fail)
  (match items
    (Nil
     (match (list-reverse vals)
       (Nil (ok None p))
       ((Cons only Nil) (ok (Some only) p))
       (all (ok (Some #'(Tuple ,@all)) p))))
    ((Cons item rest)
     (gen ctx item p
          (fun (v q)
            (gen-seq ctx rest q (match v ((Some x) (Cons x vals)) (None vals)) ok fail))
          fail))))

;; A join point: a local function `k` that runs `ok` on its arguments, so
;; that several paths can continue with one copy of it. `valued?` says
;; whether it takes a value before the position.
(: (-> Ctx bool OnValue (-> (-> (Option Syntax) Syntax Syntax) Syntax) Syntax))
(defun (join ctx valued? ok body)
  (def* (k (fresh ctx "k"))
        (kv (fresh ctx "kv"))
        (kp (fresh ctx "kp")))
  (if valued?
      #'(let ()
          (defun (,k ,kv ,kp) ,(ok (Some kv) kp))
          ,(body (fun (v q) #'(,k ,(option-ref v) ,q))))
      #'(let ()
          (defun (,k ,kp) ,(ok None kp))
          ,(body (fun (v q) #'(,k ,q))))))

;; `(:? item)`: the item's value in a `Some`, or `None` and no text read.
(: (-> Ctx Item Syntax OnValue Syntax))
(defun (gen-opt ctx inner p ok)
  (def valued (holds? ctx inner))
  (join ctx valued ok
        (fun (k)
          (gen ctx inner p
               (fun (v q) (k (match v ((Some x) (Some #'(Some ,x))) (None None)) q))
               (fun (_ _) (k (if valued (Some #'None) None) p))))))

;; `(:or a b ...)`: the first choice that matches, each tried at `p`.
(: (-> Ctx (List Item) Item Syntax OnValue OnMiss Syntax))
(defun (gen-or ctx alts whole p ok fail)
  (join ctx (valued? whole) ok
        (fun (k)
          (let next ((alts alts))
            (match alts
              (Nil (fail p (describe whole)))
              ((Cons a rest) (gen ctx a p k (fun (_ _) (next rest)))))))))

;; `item ...` and `item ... #:sep sep`: the items as a vec, as many as match,
;; none included. A separator not followed by an item is not read. The loop
;; is a named let, so it runs as a loop however many items there are. Where
;; the value is not kept, the loop only moves past the items.
(: (-> Ctx Item (Option Item) Syntax OnValue Syntax))
(defun (gen-rep ctx inner sep p ok)
  ;; The loop reads an item at `at`, and stops at `back` when the item does
  ;; not match: `back` is the position before the separator, so that a
  ;; separator not followed by an item is not read. The item and the
  ;; separator are each written once, so nested repetitions grow with the
  ;; pattern.
  (def* (keep (.keep ctx))
        (acc (fresh ctx "acc"))
        (back (fresh ctx "back"))
        (at (fresh ctx "at"))
        (more (fresh ctx "more")))
  (join ctx keep ok
        (fun (k)
          (defun (stop pos) (k (if keep (Some #'(vecbuilder->vec ,acc)) None) pos))
          ;; After the separator at `q`, or none: round again, or stop at `q`.
          (defun (next q)
            (match sep
              (None #'(,more ,q ,q))
              ((Some sep-item)
               (gen ctx sep-item q (fun (_ sq) #'(,more ,q ,sq)) (fun (_ _) (stop q))))))
          ;; After an item: add its value and go on from `q`. A round that
          ;; reads no text, as `rest` at the end does, ends the repetition
          ;; without its value, because it would match forever.
          (defun (add v q)
            #'(if (= ,q ,back)
                  ,(stop back)
                  ,(if keep
                       #'(let ()
                           (vecbuilder-add! ,acc ,(option-ref v))
                           ,(next q))
                       (next q))))
          (def loop
            #'(let ,more ((,back ,p) (,at ,p))
                ,(gen ctx inner at add (fun (_ _) (stop back)))))
          (if keep
              #'(let ((,acc (vecbuilder-empty/small))) ,loop)
              loop))))

;; The whole expansion: the items from position 0, then the end of the line.
(: (-> Syntax Syntax Syntax bool Syntax))
(defun (expand form line pattern raising?)
  (def quoted
    (match pattern
      ((SList (Cons (SSym q) items))
       (if (= (symbol->string q) "quoted-list") (Some items) None))
      (_ None)))
  (def items
    (match quoted
      ((Some items) (parse-items items pattern))
      (None (ret-error pattern "The pattern of a scan is a quoted list, such as '(int \",\" int)."))))
  (def ctx (Ctx (line (SSym (string->symbol "scan-line"))) (counter (make-array 1 #:fill 0)) (keep #t)))
  (def s (.line ctx))
  (defun (fail p expected)
    (if raising?
        #'(scan-fail ,s ,p ,(SStr expected))
        #'(Err (scan-message ,s ,p ,(SStr expected)))))
  (defun (finish v p)
    (def value (match v ((Some x) x) (None #'unit)))
    #'(if (scan-end? ,s ,p)
          ,(if raising? value #'(Ok ,value))
          ,(fail p "the end of the line")))
  #'(let ((,s ,line))
      ,(gen-seq ctx items #'0 Nil finish fail)))

;; `(scan line '(pattern ...))`: the values the pattern reads, or raises a
;; FormatException that says where the line does not match.
(def/macro (scan form inject compare)
  (syntax-match form
    ((_ line pattern) (expand form line pattern #t))
    (bad (syntax-error bad "scan takes a line and a quoted pattern, as in (scan line '(int \",\" int))."))))

;; `(try-scan line '(pattern ...))`: the same values in an `Ok`, or an `Err`
;; with the message `scan` would raise.
(def/macro (try-scan form inject compare)
  (syntax-match form
    ((_ line pattern) (expand form line pattern #f))
    (bad (syntax-error bad "try-scan takes a line and a quoted pattern, as in (try-scan line '(int \",\" int))."))))
