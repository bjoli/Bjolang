;; A pattern that can fail to match. It is matched in a `match` of its own, so
;; the error names the values of the event, not the tags of the expansion.

;; EXPECT-ERROR: this match does not cover every value. None reaches no clause.

(import (std prelude))

(defbjo (main args)
  (def ch (make-chan))
  (println (select ((chan-recv ch) (Some n) n) (#:else 0)))
  0)
