;; `...` repeats the item before it. At the start of a list there is no such
;; item, so the compiler refuses the mark.
;; EXPECT-ERROR: ... repeats the item before it, and there is no item before it
(import (std prelude))

(def/grammar Q
  (:or (: CFrom (from ... symbol))
       (: CPlain (symbol ...))))

(defun (main args) 0)
