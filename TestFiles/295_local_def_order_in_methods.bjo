;; The definitions in an impl method, a trait default and either body of a
;; defbjouble follow the same rule as a defun's: values run in the order they
;; are written, and a local function may be defined below the value that calls
;; it, as long as what it reads is defined above that value.

(import (std prelude))
(import (std simpletest))

(def/trait (Speak %a)
  (: speak (-> %a int))
  (: speak-twice (-> %a int))
  (defun (speak-twice x)
    (def once (speak x))
    (def doubled (twice once))
    (defun (twice (: n int)) (* 2 n))
    doubled))

(type (: Dog (Record (: n int))))

(impl (Speak Dog)
  (defun (speak d)
    (def b (.n d))
    (def a (plus-one b))
    (defun (plus-one (: x int)) (+ x 1))
    a))

(: helper (-bjo-> int int))
(defbjo (helper x) x)

(: plus-one (-> int int))
(defbjouble (plus-one x)
  (#:sync
    (def b x)
    (def a (step b))
    (defun (step (: n int)) (+ n 1))
    a)
  (#:bjo
    (def b (helper x))
    (def a (step b))
    (defun (step (: n int)) (+ n 1))
    a))

(: plus-one-suspending (-bjo-> int int))
(defbjo (plus-one-suspending x) (plus-one x))

(defun (main args)
  (expect "an impl method calls a function defined below" (speak (Dog (n 41))) 42)
  (expect "a trait default calls a function defined below" (speak-twice (Dog (n 41))) 84)
  (expect "a defbjouble's sync body calls a function defined below" (plus-one 41) 42)
  (expect "and so does its suspending body"
          (match (sync/blocking (promise-join (bjo (plus-one-suspending 41))))
            ((Ok n) n)
            ((Err e) -1))
          42)
  0)
