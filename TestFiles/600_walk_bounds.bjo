;; `up-from` and `down-from` do not step past the end of their number type.
;;
;; - A walk with no `#:to` ends at the last value that it can step from.
;; - A walk with a `#:to` that it could step past raises when it is made.
;; - Other walks give the values that they gave before.

(import (std prelude))
(import (std simpletest))

;; The message a walk raises when it is made, or "no error".
(: (-> (-> int) string))
(defun (raised f)
  (match (try (f) #:catch (System.ArgumentException))
    ((Ok _) "no error")
    ((Err e) (.-Message e))))

;; At most `limit` values of a walk, so that a walk that wraps round ends the
;; test and does not hang it.
(: (-> %s int (List int)) (where (Iterable %s #:elem int)))
(defun (some-of walk limit)
  (loop (:for x walk)
        (:with n 0 (+ n 1))
        (:finish (>= n limit) (list -1))
        (:acc out (listing x))))

(defun (main)
  ;; --- walks that are not near an end ------------------------------------------
  (expect "up-from" (some-of (up-from 0 #:to 5) 100) (list 0 1 2 3 4))
  (expect "up-from by 2" (some-of (up-from 1 #:to 8 #:by 2) 100) (list 1 3 5 7))
  (expect "up-from, no values" (some-of (up-from 5 #:to 5) 100) Nil)
  (expect "down-from" (some-of (down-from 3 #:to 0) 100) (list 3 2 1 0))
  (expect "down-from by 2" (some-of (down-from 7 #:to 0 #:by 2) 100) (list 7 5 3 1))
  (expect "down-from, no values" (some-of (down-from 0 #:to 1) 100) Nil)
  (expect "longs" {listing x (:for x (up-from 0L #:to 3L))} (list 0L 1L 2L))
  (expect "doubles" {listing x (:for x (up-from 0.0 #:to 1.0 #:by 0.25))} (list 0.0 0.25 0.5 0.75))
  (expect "doubles, down" {listing x (:for x (down-from 1.0 #:to 0.0 #:by 0.5))} (list 1.0 0.5 0.0))

  ;; --- no #:to: the walk ends before the end of int -----------------------------
  (expect "up-from by 1 ends below int-max"
          (some-of (up-from (- int-max 3)) 100)
          (list (- int-max 3) (- int-max 2) (- int-max 1)))
  (expect "up-from by 2 ends at the last value it can step from"
          (some-of (up-from (- int-max 5) #:by 2) 100)
          (list (- int-max 5) (- int-max 3)))
  (expect "up-from by 4, from a value it cannot step from"
          (some-of (up-from (- int-max 1) #:by 4) 100)
          Nil)
  (expect "down-from by 1 ends above int-min"
          (some-of (down-from (+ int-min 2)) 100)
          (list (+ int-min 2) (+ int-min 1)))
  (expect "down-from by 3"
          (some-of (down-from (+ int-min 7) #:by 3) 100)
          (list (+ int-min 7) (+ int-min 4)))
  (expect "#:to int-max by 1 is safe: the bound is not given"
          (some-of (up-from (- int-max 2) #:to int-max) 100)
          (list (- int-max 2) (- int-max 1)))

  ;; --- a #:to that the walk could step past -------------------------------------
  (expect-true "up-from raises"
               (string-contains? (raised (fun () (list-length (some-of (up-from 0 #:to (- int-max 1) #:by 4) 3))))
                                 "up-from: #:to is 2147483646 and #:by is 4"))
  (expect-true "down-from raises"
               (string-contains? (raised (fun () (list-length (some-of (down-from 10 #:to (+ int-min 1) #:by 4) 3))))
                                 "down-from: #:to is -2147483647 and #:by is 4"))
  (expect-true "a #:to that is the end of the type raises too"
               (string-contains? (raised (fun () (list-length (some-of (up-from (- int-max 5) #:to int-max #:by 2) 3))))
                                 "up-from: #:to is 2147483647 and #:by is 2"))
  (expect-true "down-from to int-min raises"
               (string-contains? (raised (fun () (list-length (some-of (down-from 0 #:to int-min) 3))))
                                 "down-from: #:to is -2147483648 and #:by is 1"))
  (expect-true "an unsigned count down to zero raises"
               (string-contains? (raised (fun () (loop (:for x (down-from 3u #:to 0u)) (:acc n (counting x)))))
                                 "down-from: #:to is 0 and #:by is 1"))
  (expect "an unsigned count down to one"
          (loop (:for x (down-from 3u #:to 1u)) (:acc n (counting x)))
          3)
  (expect "a #:to one step from the end is safe"
          (raised (fun () (list-length (some-of (up-from (- int-max 9) #:to (- int-max 3) #:by 4) 100))))
          "no error")
  (expect "and gives its values"
          (some-of (up-from (- int-max 9) #:to (- int-max 3) #:by 4) 100)
          (list (- int-max 9) (- int-max 5)))
  (expect "a walk with no values raises nothing"
          (raised (fun () (list-length (some-of (up-from int-max #:to (- int-max 1) #:by 4) 100))))
          "no error")
  (expect "down-from to int-min + 1 by 1 is safe"
          (some-of (down-from (+ int-min 2) #:to (+ int-min 1)) 100)
          (list (+ int-min 2) (+ int-min 1)))
  (println "600 ok")
  0)
