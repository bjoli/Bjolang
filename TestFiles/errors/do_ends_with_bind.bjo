;; A block's last form is its value, so a clause that only binds cannot be it.
;;
;; The rejection is `(std monad)`'s rather than the parser's: `do` is a macro
;; there, and this pins that its diagnostics arrived with it.

;; EXPECT-ERROR: cannot end with (:bind ...)

(import (std prelude))
(import (std monad))

(: halve-twice (-> int (Option int)))
(defun (halve-twice n)
  (do (:bind x (Some n))
      (:bind y (Some (/ x 2)))))

(defun (main) 0)
