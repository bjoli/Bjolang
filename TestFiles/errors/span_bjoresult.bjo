;; A bjoroutine cannot answer a span.
;; EXPECT-ERROR: 'f' is a bjoroutine, and it answers a (System.Span long)
(import (std prelude))
(import/extern
  (whole (: System.MemoryExtensions.AsSpan (-> (Array %a) (System.Span %a))))
  (sleep (: System.Threading.Tasks.Task.Delay (-> int void) #:async #:uncancellable)))
(: (-> (System.Span long) int))
(defun (len s) (.-Length s))

(: (-bjo-> (Array long) (System.Span long)))
(defbjo (f xs) (sleep 1) (whole xs))
(defbjo (main) 0)
