;; An imported module's private binding is not the prelude's, though both are
;; members of a class this file has a `using static` for. A bare call to the
;; prelude's was ambiguous to C# (CS0121), so an import is always qualified.
(import (std prelude))
(import (std simpletest))
(import "inc/private_take.bjo")

(defun (main)
  (expect "the prelude's string-take" (string-take "abcdef" 3) "abc")
  (expect "and as a value" ((fun (f) (f "abcdef" 2)) string-take) "ab")
  (expect "the private one, where it was written" (first-two "abcdef") "private")
  0)
