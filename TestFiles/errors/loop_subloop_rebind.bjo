;; A `:subloop` form carries the enclosing loop's variables by name, so it may
;; not bind one of them again.

;; EXPECT-ERROR: 'x' at loop_subloop_rebind.bjo:11 is already a variable of an enclosing level of this loop.

(import (std prelude))

(: f (-> (List (List int)) (List int)))
(defun (f rows)
  (loop (:for x rows)
        (:subloop (:for x x)
                  (:acc s (summing x)))
        (:acc out (listing s))))

(defun (main) (println (int->string (list-length (f '((1)))))) 0)
