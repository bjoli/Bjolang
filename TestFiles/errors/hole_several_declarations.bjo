;; EXPECT-ERROR: hole_several_declarations.bjo:12:15: '_' stands for a value of type (-> int string).
;; EXPECT-ERROR: hole_several_declarations.bjo:15:34: '_n' stands for a value of type int.
;; EXPECT-NO-ERROR: Unbound variable
;;
;; A hole costs its own declaration, and each declaration's holes are
;; reported. What calls a declaration with a hole is checked against its
;; signature and says nothing more.

(import (std prelude))

(: f (-> int string))
(defun (f x) (_ x))

(: g (-> string int))
(defun (g s) (+ (string-count s) _n))

(defun (main)
  (println (f (g "abc")))
  0)
