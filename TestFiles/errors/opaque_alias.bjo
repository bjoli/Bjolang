;; `#:opaque` on an alias.
;;
;; Refused rather than supported, because an alias is expanded by
;; `resolveTypeAnnotation` wherever it is named: there is no representation to
;; hold back, and an opaque one would be a different type inside the module from
;; the one outside. A type that is meant to be its own is a Record or a Union.

;; EXPECT-ERROR: #:opaque on the alias 'Money'
;; EXPECT-ERROR: expanded wherever it is named

(type (: Money #:opaque int))

(defun (main args) 0)
