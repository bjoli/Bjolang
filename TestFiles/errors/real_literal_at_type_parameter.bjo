;; `Num` does not say a type has fractions, so a real literal is refused at a
;; type parameter.

;; EXPECT-ERROR: '0.5' has a fraction, and it is being used at the type parameter '%a', which may be a whole number.

(import (std prelude))

(: (-> %a %a) (where (Num %a)))
(defun (scale x) (* x 0.5))

(defun (main args) 0)
