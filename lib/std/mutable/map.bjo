;; std/mutable/map.bjo — the hash table, written in place.
;;
;; A `MutableMap` *is* a .NET `Dictionary<K,V>`: open addressing over buckets,
;; O(1) expected for every operation below. `mutablemap` makes a subclass that
;; also keeps an entry for the key `null`, which a `Dictionary` refuses. The
;; one case of a union that carries nothing is often `null` at run time, and
;; this lets it be a key.
;;
;; **This is the mutable one.** `(mutablemap-set! m k v)` writes `m`; it answers
;; nothing, and everyone holding `m` sees the change. `Map` is the persistent
;; structure of the same shape.
;;
;; **What `TransientMap` is not.** A transient is a `Map` being built: it is
;; made from a persistent map, filled, and frozen back into one. This is a table
;; that is never frozen — entries go in and come out for as long as the program
;; holds it, which is what a cache, an index or a counter wants.
;;
;; **Keys are filed under .NET's equality**, `EqualityComparer<K>.Default`, not
;; under the `Eq` implementation in `std/eq`. That is the same equality `Map` and
;; `HashSet` file their keys under, so the three agree with each other — but a
;; hand-written `Eq` that departs from .NET's is not consulted here.
(import (std prelude))

(:doc #:file "map.bjodoc")

(export
  MutableMap MutableMapEnumerator
  mutablemap mutablemap-with-capacity
  mutablemap-length mutablemap-empty?
  mutablemap-ref mutablemap-try-ref mutablemap-ref-or
  mutablemap-set! mutablemap-add-new! mutablemap-try-add-new!
  mutablemap-remove! mutablemap-clear!
  mutablemap-contains? mutablemap-keys mutablemap-values mutablemap-copy
  mutablemap-enumerator mutablemap-enumerator-next! mutablemap-enumerator-current
  mutablemap-for-each
  list->mutablemap mutablemap->list vec->mutablemap mutablemap->vec
  seq->mutablemap mutablemap->seq map->mutablemap mutablemap->map
  mutablemap->str)

;; The type is .NET's, so a `MutableMap` handed to any other `import/extern`
;; taking a `Dictionary<K,V>` is accepted as it stands. Such an extern does not
;; see the entry for a `null` key.
(import/class
  ((MutableMap %k %v) (: System.Collections.Generic.Dictionary))
  ((MutableMapEnumerator %k %v) (: Bjolang.Runtime.MutableMapEnumerator)))

;; ---------------------------------------------------------------------------
;; The map
;; ---------------------------------------------------------------------------

(import/extern
  (mutablemap               (: Bjolang.Runtime.MutableMapModule.Empty        (-> (MutableMap %k %v))))
  (mutablemap-with-capacity (: Bjolang.Runtime.MutableMapModule.WithCapacity (-> int (MutableMap %k %v))))
  (mutablemap-length        (: Bjolang.Runtime.MutableMapModule.Count        (-> (MutableMap %k %v) int)))
  (mutablemap-empty?        (: Bjolang.Runtime.MutableMapModule.IsEmpty      (-> (MutableMap %k %v) bool)))
  ;; Throws when the key is absent, which is what `Refable` asks. The two
  ;; answers that are not an exception are below it.
  (mutablemap-ref           (: Bjolang.Runtime.MutableMapModule.Get          (-> (MutableMap %k %v) %k %v)))
  (mutablemap-ref-or        (: Bjolang.Runtime.MutableMapModule.GetOr        (-> (MutableMap %k %v) %k %v %v)))
  ;; Replaces whatever was under the key.
  (mutablemap-set!          (: Bjolang.Runtime.MutableMapModule.Set          (-> (MutableMap %k %v) %k %v void)))
  ;; Adds a key that must be new, and raises when it is not. To add or replace,
  ;; there is `mutablemap-set!`, which is also what `Addable!`'s `add!` does.
  (mutablemap-add-new!      (: Bjolang.Runtime.MutableMapModule.AddNew       (-> (MutableMap %k %v) %k %v void)))
  ;; The value already under the key, or None when the entry was added. What
  ;; `mutablemap-try-add-new!` is made of.
  (add-or-existing!         (: Bjolang.Runtime.MutableMapModule.AddOrExisting (-> (MutableMap %k %v) %k %v (out %v) (Option %v))))
  (mutablemap-remove!       (: Bjolang.Runtime.MutableMapModule.Remove       (-> (MutableMap %k %v) %k bool)))
  (mutablemap-clear!        (: Bjolang.Runtime.MutableMapModule.Clear        (-> (MutableMap %k %v) void)))
  (mutablemap-contains?     (: Bjolang.Runtime.MutableMapModule.ContainsKey  (-> (MutableMap %k %v) %k bool)))
  ;; Views, not copies: each walks the map as it stands when it is walked, so
  ;; writing the map during one is an error .NET raises.
  (mutablemap-keys          (: Bjolang.Runtime.MutableMapModule.Keys         (-> (MutableMap %k %v) (Seq %k))))
  (mutablemap-values        (: Bjolang.Runtime.MutableMapModule.Values       (-> (MutableMap %k %v) (Seq %v))))
  (mutablemap-copy          (: Bjolang.Runtime.MutableMapModule.Copy         (-> (MutableMap %k %v) (MutableMap %k %v))))
  (mutablemap->seq          (: Bjolang.Runtime.MutableMapModule.AsEnumerable (-> (MutableMap %k %v) (Seq (Tuple %k %v)))))
  ;; Later pairs win, so this and repeated `mutablemap-set!` agree.
  (seq->mutablemap          (: Bjolang.Runtime.MutableMapModule.FromEnumerable (-> (Seq (Tuple %k %v)) (MutableMap %k %v))))

  (mutablemap-try-ref       (: Bjolang.Runtime.MutableMapModule.TryGet       (-> (MutableMap %k %v) %k (out %v) (Option %v))))

  ;; A walk with .NET's protocol: `next!` is `MoveNext`, `current` is `Current`.
  (mutablemap-enumerator         (: Bjolang.Runtime.MutableMapModule.Enumerator (-> (MutableMap %k %v) (MutableMapEnumerator %k %v))))
  (mutablemap-enumerator-next!   (: Bjolang.Runtime.MutableMapModule.MoveNext   (-> (MutableMapEnumerator %k %v) bool)))
  (mutablemap-enumerator-current (: Bjolang.Runtime.MutableMapModule.Current    (-> (MutableMapEnumerator %k %v) (Tuple %k %v)))))

;; `mutablemap-add-new!` with the failure as a value: `(Err v)` carries the
;; value the key already has, which the lookup found anyway.
(: (-> (MutableMap %k %v) %k %v (Result %v Unit)))
(defun (mutablemap-try-add-new! m k v)
  (match (add-or-existing! m k v)
    ((Some old) (Err old))
    (None (Ok unit))))

;; The key and the value as two arguments, which is what a caller of a map
;; almost always wants and what the `Iterable` walk over pairs cannot give.
(: (-> (-?-> %k %v void) (MutableMap %k %v) void))
(defun (mutablemap-for-each f m)
  (def e (mutablemap-enumerator m))
  (let go ()
    (when (mutablemap-enumerator-next! e)
      (def (k v) (mutablemap-enumerator-current e))
      (f k v)
      (go))))

;; ---------------------------------------------------------------------------
;; Conversions
;; ---------------------------------------------------------------------------

(: (-> (List (Tuple %k %v)) (MutableMap %k %v)))
(defun (list->mutablemap xs) (seq->mutablemap (list->seq xs)))

(: (-> (MutableMap %k %v) (List (Tuple %k %v))))
(defun (mutablemap->list m) (->list (mutablemap->seq m)))

(: (-> (Vec (Tuple %k %v)) (MutableMap %k %v)))
(defun (vec->mutablemap v) (seq->mutablemap (vec->seq v)))

(: (-> (MutableMap %k %v) (Vec (Tuple %k %v))))
(defun (mutablemap->vec m) (->vec (mutablemap->seq m)))

(: (-> (Map %k %v) (MutableMap %k %v)))
(defun (map->mutablemap m) (seq->mutablemap (map->seq m)))

(: (-> (MutableMap %k %v) (Map %k %v)))
(defun (mutablemap->map m) (->map (mutablemap->seq m)))

;; ---------------------------------------------------------------------------
;; The traits
;; ---------------------------------------------------------------------------

(impl (Refable (MutableMap %k %v))
  (type %index %k)
  (type %out %v)
  (defun (ref m key)
    (mutablemap-ref m key))
  (defun (try-ref m key)
    (mutablemap-try-ref m key)))

;; Written in place, so `(set! m k v)` writes `m`, and adds `k` if it was not
;; there.
(impl (Settable! (MutableMap %k %v))
  (type %index %k)
  (type %in %v)
  (defun (ref-set! m k v)
    (mutablemap-set! m k v)))

(impl (Iterable (MutableMap %k %v))
  (type %elem (Tuple %k %v))
  ;; The enumerator is the cursor, and it steps in `done?`, which the
  ;; protocol calls once per step before `current`. See the `Seq` impl.
  (type %cursor (MutableMapEnumerator %k %v))
  (defun (iterable-start m) (mutablemap-enumerator m))
  (defun (iterable-done? m e) (not (mutablemap-enumerator-next! e)))
  (defun (iterable-current m e) (mutablemap-enumerator-current e))
  (defun (iterable-next m e) e))

(impl (Collection (MutableMap %k %v))
  (type %content (Tuple %k %v))
  (defun (length m) (mutablemap-length m))
  (defun (empty? m) (mutablemap-empty? m)))

;; Set semantics, as `Addable`'s do everywhere: a key already there is replaced.
(impl (Addable! (MutableMap %k %v))
  (type %elem (Tuple %k %v))
  (defun (add! m pair)
    (def (k v) pair)
    (mutablemap-set! m k v)))

;; Two maps are equal when they hold the same keys with equal values.
;;
;; Without this they would fall to the blanket, which for a `Dictionary<K,V>` is
;; reference identity. The walk is one-sided because the lengths are compared
;; first: every key of `a` being in `b` with an equal value, at equal counts,
;; leaves `b` no room for a key of its own.
;;
;; The *keys* are matched by .NET's equality, since finding one is a lookup;
;; only the values go through `Eq`. `eq-hash` refuses, as `Deque`'s does.
(impl (Eq (MutableMap %k %v))
  (where (Eq %v))
  (defun (= a b)
    (and (= (mutablemap-length a) (mutablemap-length b))
         (let ((e (mutablemap-enumerator a)))
           (let go ()
             (cond
               ((not (mutablemap-enumerator-next! e)) #t)
               (else
                (def (k v) (mutablemap-enumerator-current e))
                (match (mutablemap-try-ref b k)
                  (None #f)
                  ((Some w) (if (= v w) (go) #f)))))))))
  (defun (eq-hash m) (unhashable "MutableMap")))

;; `#mmap(k v k v)`: each key and its value, flat, with a space between all.
;; Each key and value is added by the function given for it.
(: (-> (MutableMap %k %v) StringBuilder (-> %k StringBuilder void) (-> %v StringBuilder void) void))
(defun (mutablemap-print-into m b each-key each-value)
  (stringbuilder-add-string! b "#mmap(")
  (loop (:with first? #t #f)
        (:for entry m)
        (:do (def (k v) entry)
             (unless first? (stringbuilder-add-string! b " "))
             (each-key k b)
             (stringbuilder-add-string! b " ")
             (each-value v b)))
  (stringbuilder-add-string! b ")"))

(impl (Written (MutableMap %k %v))
  (where (Written %k) (Written %v))
  (defun (write-into m b)
    (mutablemap-print-into m b (fun (k b) (write-into k b)) (fun (v b) (write-into v b)))))

(impl (Displayed (MutableMap %k %v))
  (where (Displayed %k) (Displayed %v))
  (defun (display-into m b)
    (mutablemap-print-into m b (fun (k b) (display-into k b)) (fun (v b) (display-into v b)))))

(: (-> (MutableMap %k %v) string) (where (Displayed %k) (Displayed %v)))
(defun (mutablemap->str m) (displayed m))

(:deprecated mutablemap->str "use `displayed`")

