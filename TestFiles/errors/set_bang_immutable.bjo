;; `(set! name value)` writes a def/mutable, or, for any other binding, what
;; it holds through Derefable!. An int holds nothing, so the refusal is the
;; plain one, and names both readings. The literal's type is not settled yet
;; where the set! is checked, and that is refused too rather than left to the
;; trait, whose message would not name the variable.

;; EXPECT-ERROR: Cannot mutate immutable variable 'n'
;; EXPECT-ERROR: set! with a name and a value writes a def/mutable, or what a Box holds

(import (std prelude))

(defun (main args)
  (def n 1)
  (set! n 2)
  0)
