;; Docs for std/orderedset.bjo, read through (:doc #:file "orderedset.bjodoc").
;; The texts are samizdat markup: code in prose is @code{...}.

(:doc #:module
  (summary "Persistent sorted set implemented as a B-tree in element order, with builder and transient.")
  (see OrderedSet orderedset-empty orderedset-add orderedset-min orderedset-range orderedset-union OrderedSetBuilder TransientOrderedSet)
  (example """
    (import (std orderedset))

    (def s (list->orderedset (list 5 1 3 9)))
    (orderedset->list s)                 ; (1 3 5 9)
    (orderedset-min s)                   ; (Some 1)
    (orderedset-successor s 3)           ; (Some 5)
    (orderedset-successor s 4)           ; (Some 5), 4 need not be in set
    (seq->list (orderedset-range s 2 6)) ; (3 5)
    """)
  (reference """
    An @code{(OrderedSet a)} is an immutable, persistent sorted set.
    Updates return a new set sharing untouched nodes with the original.
    Implemented as a B-tree (@code{OrderedSet.OrderedSet} in the runtime).
    Lookup, insertion, and deletion operations run in O(log n) time.

    @strong{Element ordering.} Constructors (@code{orderedset-empty},
    @code{seq->orderedset}, @code{list->orderedset}, @code{vec->orderedset},
    @code{orderedsetbuilder-empty}, @code{transientorderedset-empty}, and the
    @code{ordered-setting} collector) require an @code{Ord} instance for
    element type @code{%a}. Elements are ordered according to @code{compare}.
    Elements considered equal by @code{compare} are deduplicated. Derived sets
    retain the source set's ordering comparer.

    @strong{Order guarantees.} All traversals, conversions, and callbacks
    visit elements in ascending order. Provides efficient boundary operations
    (@code{orderedset-min}, @code{orderedset-max}, @code{orderedset-successor},
    @code{orderedset-predecessor}) and range slices (@code{orderedset-range},
    @code{orderedset-from}, @code{orderedset-until}). If element ordering is not
    required, use @code{(std hashset)}, which requires only @code{Eq}.

    @strong{Batch mutations and construction.} An @code{OrderedSetBuilder}
    collects elements, sorts them, and constructs the tree in a single pass. A
    @code{TransientOrderedSet} mutates tree nodes in place and converts to a
    persistent set in O(1) time. Both outperform repeated calls to
    @code{orderedset-add} for bulk updates.

    @strong{Traits.} Implements @code{Iterable}, @code{Collection},
    @code{Refable} (where @code{(ref s x)} tests membership), @code{Addable},
    @code{Eq}, and @code{->str}. Two sets are @code{=} if they contain identical
    elements. Builders and transients implement @code{Addable!}, and transients
    implement @code{Refable}.
    """))

;; ---------------------------------------------------------------------------
;; The types
;; ---------------------------------------------------------------------------

(:doc OrderedSet
  (summary "Persistent set sorted by element.")
  (tparam %a "The element type. Requires an Ord instance.")
  (see orderedset-empty orderedset-add orderedset-contains? OrderedSetBuilder TransientOrderedSet OrderedSetting)
  (example """
    (def s (orderedset-add (orderedset-add (orderedset-empty) "b") "a"))
    (orderedset->list s)   ; ("a" "b")
    (ref s "c")            ; #f
    """))

(:doc OrderedSetBuilder
  (summary "Mutable buffer for constructing an ordered set in a single pass.")
  (tparam %a "The element type.")
  (see orderedsetbuilder-empty orderedsetbuilder-add! orderedsetbuilder->orderedset TransientOrderedSet)
  (example """
    (def b (orderedsetbuilder-empty))
    (orderedsetbuilder-add! b 3)
    (orderedsetbuilder-add! b 1)
    (orderedsetbuilder-add! b 3)
    (orderedsetbuilder-length b)           ; 3
    (orderedsetbuilder->orderedset b)      ; #{1 3}
    """)
  (reference """
    Appends elements to a flat buffer. Calling
    @code{orderedsetbuilder->orderedset} sorts elements and constructs the
    B-tree in a single pass. If elements arrive in sorted order, sorting is
    skipped. Duplicate elements are deduplicated. Builders do not support lookups
    or removals; use @code{TransientOrderedSet} for mutable set operations.
    Implements @code{Addable!}.
    """))

(:doc TransientOrderedSet
  (summary "Mutable transient ordered set for batch in-place updates.")
  (tparam %a "The element type.")
  (see orderedset->transientorderedset transientorderedset->orderedset transientorderedset-add! OrderedSetBuilder)
  (example """
    (def t (orderedset->transientorderedset s))
    (transientorderedset-add! t 4)
    (transientorderedset-remove! t 1)
    (transientorderedset->orderedset t)
    """)
  (reference """
    Provides in-place mutators mirroring persistent @code{orderedset-}
    functions. Mutates owned tree nodes in place without copying. Calling
    @code{transientorderedset->orderedset} yields a persistent set in O(1) time.
    The transient remains usable afterward; subsequent writes perform
    copy-on-write on shared nodes. Implements @code{Addable!} and
    @code{Refable}.
    """))

(:doc OrderedSetCursor
  (summary "Cursor for iterating over an ordered set.")
  (tparam %a "The element type.")
  (see OrderedSet)
  (reference """
    Used by the @code{Iterable} implementation of @code{OrderedSet} to iterate
    in ascending element order. Immutable cursor value: advancing produces a
    new cursor without mutating the previous one.
    """))

(:doc OrderedSetting
  (summary "Collector for gathering elements into an ordered set via loop.")
  (tparam %a "The element type. Requires an Ord instance.")
  (case ordered-setting "The collector constructor.")
  (see list->orderedset OrderedSetBuilder)
  (example """
    (loop (:for x (range 0 10))
          (:when (= 0 (% x 2)))
          (:acc s (ordered-setting x)))   ; #{0 2 4 6 8}
    """)
  (reference "Collects elements through an @code{OrderedSetBuilder}."))

;; ---------------------------------------------------------------------------
;; Sets
;; ---------------------------------------------------------------------------

(:doc orderedset-empty
  (summary "Creates an empty ordered set.")
  (returns "An empty set ordered by the element type's Ord instance.")
  (see orderedset-clear seq->orderedset list->orderedset))

(:doc orderedset-add
  (summary "Returns a new set with an element added.")
  (arg s "The source set (unmodified).")
  (arg x "The element to add.")
  (returns "A new set containing x. If x is already present, returns an equivalent set.")
  (see orderedset-add-all orderedset-remove add))

(:doc orderedset-add-all
  (summary "Returns a new set with all elements of a sequence added.")
  (arg s "The source set (unmodified).")
  (arg xs "Sequence of elements to add.")
  (returns "A new set containing all elements from s and xs.")
  (see orderedset-add orderedset-union transientorderedset-add-all!)
  (reference """
    Executes through a transient, copying tree nodes once rather than once
    per element.
    """))

(:doc orderedset-remove
  (summary "Returns a new set with an element removed.")
  (arg s "The source set (unmodified).")
  (arg x "The element to remove.")
  (returns "A new set without x. If x was absent, returns s directly.")
  (see orderedset-remove-all orderedset-filter))

(:doc orderedset-remove-all
  (summary "Returns a new set with all specified elements removed.")
  (arg s "The source set (unmodified).")
  (arg xs "Sequence of elements to remove.")
  (returns "A new set without those elements.")
  (see orderedset-remove orderedset-difference transientorderedset-remove-all!)
  (reference """
    Executes through a transient, copying tree nodes once rather than once
    per element.
    """))

(:doc orderedset-contains?
  (summary "Tests if an element is in the set.")
  (arg s "The set to inspect.")
  (arg x "The element to locate.")
  (returns "#t if x is present, otherwise #f.")
  (see ref orderedset-find))

(:doc orderedset-length
  (summary "Returns the number of elements in the set.")
  (arg s "The set.")
  (returns "The count of elements.")
  (see orderedset-empty? length))

(:doc orderedset-empty?
  (summary "Tests if the set contains no elements.")
  (arg s "The set.")
  (returns "#t if empty, otherwise #f.")
  (see orderedset-length empty?))

(:doc orderedset-clear
  (summary "Returns an empty set retaining the element comparer of the source set.")
  (arg s "The set whose order is preserved.")
  (returns "An empty persistent set.")
  (see orderedset-empty orderedset-remove-all))

;; ---------------------------------------------------------------------------
;; Set algebra
;; ---------------------------------------------------------------------------

(:doc orderedset-union
  (summary "Returns the union of two sets.")
  (arg s "The first set.")
  (arg other "The second set.")
  (returns "A new set containing elements from both sets.")
  (see orderedset-add-all orderedset-intersection)
  (reference """
    Elements from @code{other} are added to @code{s} using a transient.
    If either set is empty, the other set is returned directly.
    """))

(:doc orderedset-intersection
  (summary "Returns the intersection of two sets.")
  (arg s "The first set.")
  (arg other "The second set.")
  (returns "A new set containing only elements present in both sets, ordered as s is.")
  (see orderedset-union orderedset-difference)
  (reference """
    Traverses both sorted sets in parallel in O(n + m) time. Assumes both
    sets share identical ordering.
    """))

(:doc orderedset-difference
  (summary "Returns the set difference of two sets.")
  (arg s "The base set.")
  (arg other "Elements to exclude.")
  (returns "A new set containing elements of s that are absent from other.")
  (see orderedset-remove-all orderedset-symmetric-difference)
  (reference """
    Traverses both sorted sets in parallel in O(n + m) time. Assumes both
    sets share identical ordering.
    """))

(:doc orderedset-symmetric-difference
  (summary "Returns elements present in either set, but not both.")
  (arg s "The first set.")
  (arg other "The second set.")
  (returns "A new set containing elements in s or other, but not both.")
  (see orderedset-difference orderedset-intersection)
  (reference """
    Traverses both sorted sets in parallel in O(n + m) time. Assumes both
    sets share identical ordering.
    """))

;; ---------------------------------------------------------------------------
;; Order
;; ---------------------------------------------------------------------------

(:doc orderedset-min
  (summary "Returns the smallest element of a set, or None if empty.")
  (arg s "The set.")
  (returns "(Some x) for the smallest element, or None if empty.")
  (see orderedset-max orderedset-successor transientorderedset-min))

(:doc orderedset-max
  (summary "Returns the largest element of a set, or None if empty.")
  (arg s "The set.")
  (returns "(Some x) for the largest element, or None if empty.")
  (see orderedset-min orderedset-predecessor transientorderedset-max))

(:doc orderedset-successor
  (summary "Returns the smallest element strictly greater than a value, or None.")
  (arg s "The set.")
  (arg x "Search value (need not exist in set).")
  (returns "(Some y) for the next greater element, or None.")
  (see orderedset-predecessor orderedset-from)
  (example """
    (def s (list->orderedset (list 10 20 30)))
    (orderedset-successor s 20)   ; (Some 30)
    (orderedset-successor s 25)   ; (Some 30)
    (orderedset-successor s 30)   ; None
    """))

(:doc orderedset-predecessor
  (summary "Returns the largest element strictly less than a value, or None.")
  (arg s "The set.")
  (arg x "Search value (need not exist in set).")
  (returns "(Some y) for the next smaller element, or None.")
  (see orderedset-successor orderedset-until))

(:doc orderedset-range
  (summary "Returns a sequence of elements in [lo, hi] in ascending order.")
  (arg s "The set.")
  (arg lo "Lower bound value (inclusive). Need not exist in set.")
  (arg hi "Upper bound value (inclusive). Need not exist in set.")
  (returns "A lazy sequence of elements in ascending order.")
  (see orderedset-from orderedset-until)
  (example """
    (seq->list (orderedset-range (list->orderedset (list 1 3 5 7)) 2 5))   ; (3 5)
    """)
  (reference """
    Lazy: descends the B-tree to @code{lo} once and advances sequentially,
    so slicing a subset runs in time proportional to the range slice size.
    """))

(:doc orderedset-from
  (summary "Returns a sequence of elements >= lo in ascending order.")
  (arg s "The set.")
  (arg lo "Lower bound value (inclusive). Need not exist in set.")
  (returns "A lazy sequence of elements >= lo in ascending order.")
  (see orderedset-range orderedset-until orderedset-successor)
  (reference "Lazy, matching @code{orderedset-range}."))

(:doc orderedset-until
  (summary "Returns a sequence of elements <= hi in ascending order.")
  (arg s "The set.")
  (arg hi "Upper bound value (inclusive). Need not exist in set.")
  (returns "A lazy sequence of elements <= hi in ascending order.")
  (see orderedset-range orderedset-from orderedset-predecessor)
  (reference "Lazy, matching @code{orderedset-range}."))

;; ---------------------------------------------------------------------------
;; Traversals and transformations
;; ---------------------------------------------------------------------------

(:doc orderedset-map
  (summary "Transforms all elements using a function, returning a new set.")
  (arg f "Transformation function called as (f x), in ascending order.")
  (arg s "The source set.")
  (returns "A new ordered set of transformed elements using the result type's Ord instance.")
  (see orderedset-filter orderedset-fold)
  (reference """
    Duplicate transformed values are consolidated, so the resulting set may
    have fewer elements than @code{s}.
    """))

(:doc orderedset-filter
  (summary "Returns a new set containing only elements satisfying a predicate.")
  (arg keep? "Predicate function called as (keep? x); #t keeps element.")
  (arg s "The source set.")
  (returns "A new set of retained elements in ascending order.")
  (see orderedset-remove-all transientorderedset-filter! orderedset-find))

(:doc orderedset-fold
  (summary "Folds over all elements in ascending order.")
  (arg f "Accumulator function called as (f element acc), returning next acc.")
  (arg init "Initial accumulator value.")
  (arg s "The set to fold.")
  (returns "The final accumulator value, or init if empty.")
  (see orderedset-for-each fold)
  (example """
    (orderedset-fold (fun (x acc) (+ (* acc 10) x)) 0
                     (list->orderedset (list 2 1 3)))   ; 123
    """))

(:doc orderedset-for-each
  (summary "Applies a function to each element in ascending order.")
  (arg f "Callback function called as (f x).")
  (arg s "The set to iterate over.")
  (see orderedset-iter orderedset-fold))

(:doc orderedset-iter
  (summary "Iterates over elements in ascending order until f returns #f.")
  (arg f "Callback function called as (f x); #f stops iteration.")
  (arg s "The set to iterate over.")
  (returns "#t if all elements were visited; #f if stopped early by f.")
  (see orderedset-for-each orderedset-any? orderedset-find))

(:doc orderedset-any?
  (summary "Tests if any element satisfies a predicate.")
  (arg pred "Predicate function called as (pred x).")
  (arg s "The set to inspect.")
  (returns "#t on the first element satisfying pred; #f if none match.")
  (see orderedset-find orderedset-iter))

(:doc orderedset-find
  (summary "Returns the first element satisfying a predicate in ascending order.")
  (arg pred "Predicate function called as (pred x).")
  (arg s "The set to search.")
  (returns "(Some x) for the first match, or None.")
  (see orderedset-any? orderedset-filter))

;; ---------------------------------------------------------------------------
;; Conversions
;; ---------------------------------------------------------------------------

(:doc list->orderedset
  (summary "Constructs an ordered set from a list.")
  (arg xs "Source list. Duplicate elements are added once.")
  (returns "A new ordered set sorted by element.")
  (see orderedset->list vec->orderedset seq->orderedset OrderedSetting)
  (reference "Constructed through a builder in a single pass."))

(:doc orderedset->list
  (summary "Converts set elements to a list in ascending order.")
  (arg s "The source set.")
  (returns "A list of elements in ascending order.")
  (see list->orderedset orderedset->vec orderedset->seq))

(:doc vec->orderedset
  (summary "Constructs an ordered set from a vector.")
  (arg v "Source vector. Duplicate elements are added once.")
  (returns "A new ordered set sorted by element.")
  (see orderedset->vec list->orderedset seq->orderedset)
  (reference "Constructed through a builder in a single pass."))

(:doc orderedset->vec
  (summary "Converts set elements to a vector in ascending order.")
  (arg s "The source set.")
  (returns "A vector of elements in ascending order.")
  (see vec->orderedset orderedset->list orderedset->seq))

(:doc seq->orderedset
  (summary "Constructs an ordered set from a sequence.")
  (arg xs "Source sequence. Duplicate elements are added once.")
  (returns "A new ordered set sorted by element.")
  (see orderedset->seq list->orderedset vec->orderedset)
  (reference "Constructed through a builder in a single pass."))

(:doc orderedset->seq
  (summary "Views set elements as a sequence in ascending order.")
  (arg s "The source set.")
  (returns "A sequence of elements in ascending order.")
  (see seq->orderedset orderedset-range orderedset->list))

(:doc orderedset->str
  (summary "Formats an ordered set as text in the form #{...}.")
  (arg s "The set to format.")
  (returns "String with elements in ascending order inside #{...}, separated by spaces.")
  (see orderedset->list)
  (example """
    (orderedset->str (list->orderedset (list 3 1 2)))   ; #{1 2 3}
    """)
  (reference """
    Implements @code{->str} for ordered sets. Elements appear in ascending
    order. No reader macro reads this text back into an ordered set.
    """))

;; ---------------------------------------------------------------------------
;; Builders
;; ---------------------------------------------------------------------------

(:doc orderedsetbuilder-empty
  (summary "Creates an empty ordered set builder.")
  (returns "A new builder using the element type's Ord instance.")
  (see orderedset->orderedsetbuilder orderedsetbuilder-add! OrderedSetBuilder))

(:doc orderedset->orderedsetbuilder
  (summary "Creates an ordered set builder initialized with elements from a set.")
  (arg s "The source set (unmodified).")
  (returns "A new builder containing s's elements.")
  (see orderedsetbuilder-empty orderedset->transientorderedset)
  (reference """
    Traverses the set to populate the buffer in O(n) time. To mutate an
    existing set in place, use @code{orderedset->transientorderedset} in O(1).
    """))

(:doc orderedsetbuilder-add!
  (summary "Appends an element to an ordered set builder buffer.")
  (arg b "The builder.")
  (arg x "The element to append.")
  (see orderedsetbuilder-add-all! orderedsetbuilder->orderedset add!))

(:doc orderedsetbuilder-add-all!
  (summary "Appends all elements of a sequence to an ordered set builder buffer.")
  (arg b "The builder.")
  (arg xs "Sequence of elements to append.")
  (see orderedsetbuilder-add!))

(:doc orderedsetbuilder-length
  (summary "Returns the number of elements appended to the builder buffer.")
  (arg b "The builder.")
  (returns "The count of elements appended, including duplicates.")
  (see orderedsetbuilder->orderedset)
  (reference """
    Duplicate entries are resolved when the set is built, so this represents
    an upper bound on final set size.
    """))

(:doc orderedsetbuilder->orderedset
  (summary "Constructs a persistent ordered set from the builder buffer.")
  (arg b "The builder.")
  (returns "A new persistent ordered set containing the appended elements.")
  (see orderedsetbuilder-empty OrderedSetBuilder))

;; ---------------------------------------------------------------------------
;; Transients
;; ---------------------------------------------------------------------------

(:doc transientorderedset-empty
  (summary "Creates an empty transient ordered set.")
  (returns "A new transient ordered set using the element type's Ord instance.")
  (see orderedset->transientorderedset TransientOrderedSet))

(:doc orderedset->transientorderedset
  (summary "Creates a transient ordered set from an existing persistent set.")
  (arg s "The source set (unmodified).")
  (returns "A mutable transient set that updates in place in O(1) time.")
  (see transientorderedset->orderedset transientorderedset-empty)
  (reference """
    Shares nodes with s without copying. The transient performs copy-on-write
    on individual nodes as they are mutated.
    """))

(:doc transientorderedset->orderedset
  (summary "Converts a transient ordered set into a persistent set in O(1) time.")
  (arg t "The transient ordered set (remains usable).")
  (returns "A new immutable persistent ordered set.")
  (see orderedset->transientorderedset)
  (reference """
    Relinquishes ownership of current nodes to the persistent set. Subsequent
    writes to t perform copy-on-write without affecting the returned set.
    """))

(:doc transientorderedset-add!
  (summary "Adds an element to a transient ordered set in place.")
  (arg t "The transient set to modify.")
  (arg x "The element to add.")
  (see transientorderedset-add-all! orderedset-add add!))

(:doc transientorderedset-add-all!
  (summary "Adds all elements of a sequence to a transient ordered set in place.")
  (arg t "The transient set to modify.")
  (arg xs "Sequence of elements to add.")
  (see transientorderedset-add! orderedset-add-all))

(:doc transientorderedset-remove!
  (summary "Removes an element from a transient ordered set in place.")
  (arg t "The transient set to modify.")
  (arg x "The element to remove.")
  (see transientorderedset-remove-all! orderedset-remove))

(:doc transientorderedset-remove-all!
  (summary "Removes all specified elements from a transient ordered set in place.")
  (arg t "The transient set to modify.")
  (arg xs "Sequence of elements to remove.")
  (see transientorderedset-remove! orderedset-remove-all))

(:doc transientorderedset-filter!
  (summary "Removes elements rejected by a predicate from a transient ordered set in place.")
  (arg keep? "Predicate function called as (keep? x); #f removes element.")
  (arg t "The transient set to modify.")
  (see orderedset-filter transientorderedset-remove-all!)
  (reference """
    Identifies all elements to remove before performing deletions, ensuring
    keep? observes the complete transient set state.
    """))

(:doc transientorderedset-contains?
  (summary "Tests if an element exists in the transient ordered set.")
  (arg t "The transient set.")
  (arg x "The element to locate.")
  (returns "#t if present, otherwise #f.")
  (see orderedset-contains? ref))

(:doc transientorderedset-length
  (summary "Returns the number of elements in the transient ordered set.")
  (arg t "The transient set.")
  (returns "Current count of elements.")
  (see transientorderedset-empty? orderedset-length))

(:doc transientorderedset-empty?
  (summary "Tests if the transient ordered set contains no elements.")
  (arg t "The transient set.")
  (returns "#t if empty, otherwise #f.")
  (see transientorderedset-length orderedset-empty?))

(:doc transientorderedset-min
  (summary "Returns the smallest element of a transient ordered set, or None if empty.")
  (arg t "The transient set.")
  (returns "(Some x) for the smallest element, or None if empty.")
  (see transientorderedset-max orderedset-min))

(:doc transientorderedset-max
  (summary "Returns the largest element of a transient ordered set, or None if empty.")
  (arg t "The transient set.")
  (returns "(Some x) for the largest element, or None if empty.")
  (see transientorderedset-min orderedset-max))
