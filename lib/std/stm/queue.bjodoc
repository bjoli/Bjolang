;; Docs for std/stm/queue.bjo, read through (:doc #:file "queue.bjodoc"). The
;; texts are samizdat markup: code in prose is @code{...}.

(:doc #:module
  (summary "A transactional FIFO queue supporting atomic composition with other queues and locations, or synchronization as a CML event.")
  (see TQueue queue-push! queue-pop! queue-recv queue-get)
  (example """
    (import (std stm))
    (import (std stm queue))

    (def jobs (make-bounded-queue 100))
    (def done (make-queue))

    ;; Outside a transaction, using channel-like operations.
    (queue-put jobs "resize a.png")
    (queue-get jobs)                       ; "resize a.png"

    ;; In a transaction: take a job and record it as started in one atomic step.
    (atomically
     (fun (tx)
       (let ((job (queue-pop! tx jobs)))
         (queue-push! tx done job)
         job)))

    ;; Wait for a job with a 1-second timeout.
    (sync (choose (wrap (queue-recv jobs) Some)
                  (wrap (timeout (seconds 1)) (fun (_) None))))
    """)
  (reference """
    A @code{(TQueue T)} stores elements of type T in first-in, first-out
    order. Backed by transactional locations from @code{(std stm)}, all
    operations participate in the surrounding transaction.

    @strong{Two API layers.} Within a transaction, operations accept an
    explicit @code{Tx}: @code{queue-push!}, @code{queue-pop!},
    @code{queue-try-pop!}, @code{queue-peek}, @code{queue-try-peek},
    @code{queue-pop-all!}, @code{queue-length}, and @code{queue-empty?}.
    Outside a transaction, channel-style operations provide event-based
    access: @code{queue-send} and @code{queue-recv} return events, while
    @code{queue-put} and @code{queue-get} synchronously execute them.

    @strong{Atomic composition.} Unlike channels, transactions can
    atomically inspect and modify multiple queues and STM locations
    simultaneously: transfer elements between queues, dequeue from
    multiple queues at once, or consume an element and update shared
    state in a single atomic step without intermediate states visible
    to other fibers.

    @strong{Waiting and retrying.} @code{queue-pop!} and @code{queue-peek}
    retry when the queue is empty, and @code{queue-push!} retries when a
    bounded queue is full. The transaction blocks until another transaction
    modifies the queue. @code{queue-recv} and @code{queue-send} integrate
    with @code{choose}, allowing timeouts or multi-resource coordination.
    A cancelled branch performs no side effects.

    @strong{Ordering.} Elements are dequeued in the order in which the
    pushing transactions committed. Fibers waiting on a queue are resumed
    without guaranteed ordering.

    @strong{Contention.} Pushes write to the back of the queue and pops
    write to the front, so producers and consumers do not contend with
    each other unless the front list is exhausted and elements must be
    transferred. Pushes contend with other pushes, and pops contend with
    other pops. Bounded queues decouple push allocation counters from pop
    release counters, matching the design of Haskell's @code{TBQueue}.

    @strong{Complexity.} Operations run in amortized O(1) time;
    @code{queue-length} runs in O(1) time; @code{queue-pop-all!} runs in
    O(n) time.
    """))

(:doc TQueue
  (summary "A transactional FIFO queue holding elements of type %a.")
  (tparam %a "The element type.")
  (see make-queue make-bounded-queue))

(:doc make-queue
  (summary "Creates an unbounded transactional queue.")
  (returns "A new empty queue.")
  (see make-bounded-queue))

(:doc make-bounded-queue
  (summary "Creates a bounded transactional queue with the specified maximum capacity.")
  (arg capacity "Maximum number of elements allowed in the queue. Must be at least 1.")
  (returns "A new bounded queue.")
  (raises System.ArgumentException "When capacity is less than 1.")
  (reference """
    Pushing to a full queue retries, providing backpressure so producers
    wait until consumers free space.
    """))

(:doc queue-push!
  (summary "Enqueues an element to the back of the queue within the transaction.")
  (arg tx "The transaction log context.")
  (arg q "The queue.")
  (arg x "The element to enqueue.")
  (reference """
    On a bounded queue that is full, this operation retries until space is
    freed by a concurrent pop.
    """))

(:doc queue-pop!
  (summary "Dequeues and returns the front element within the transaction. Retries if the queue is empty.")
  (arg tx "The transaction log context.")
  (arg q "The queue.")
  (returns "The front element.")
  (see queue-try-pop! queue-recv))

(:doc queue-try-pop!
  (summary "Dequeues and returns the front element within the transaction, or None if the queue is empty.")
  (arg tx "The transaction log context.")
  (arg q "The queue.")
  (returns "(Some item), or None if the queue is empty."))

(:doc queue-peek
  (summary "Returns the front element without removing it, within the transaction. Retries if the queue is empty.")
  (arg tx "The transaction log context.")
  (arg q "The queue.")
  (returns "The front element."))

(:doc queue-try-peek
  (summary "Returns the front element without removing it, or None if the queue is empty.")
  (arg tx "The transaction log context.")
  (arg q "The queue.")
  (returns "(Some item), or None if the queue is empty."))

(:doc queue-pop-all!
  (summary "Dequeues and returns all elements from the queue in order.")
  (arg tx "The transaction log context.")
  (arg q "The queue.")
  (returns "A list of elements from front to back, or an empty list if the queue is empty (does not retry).")
  (reference """
    On a bounded queue, this frees all reserved capacity.
    """))

(:doc queue-length
  (summary "Returns the current number of elements in the queue.")
  (arg tx "The transaction log context.")
  (arg q "The queue.")
  (returns "The element count.")
  (reference """
    Reads both ends of the queue, causing transaction conflicts with
    concurrent pushes and pops. Call only when necessary.
    """))

(:doc queue-empty?
  (summary "Checks whether the queue is empty.")
  (arg tx "The transaction log context.")
  (arg q "The queue.")
  (returns "#t if the queue is empty, #f otherwise."))

(:doc queue-send
  (summary "Returns an event that enqueues x to the back of the queue.")
  (arg q "The queue.")
  (arg x "The element to enqueue.")
  (returns "An event enabled when the push commits.")
  (reference """
    On a bounded queue that is full, the event is not enabled until a pop
    frees space. If another branch of a @code{choose} is selected, no
    element is enqueued.
    """))

(:doc queue-recv
  (summary "Returns an event that dequeues and yields the front element.")
  (arg q "The queue.")
  (returns "An event enabled when an element is available.")
  (reference """
    If another branch of a @code{choose} is selected, no element is dequeued.
    """))

(:doc queue-put
  (summary "Enqueues x to the back of the queue, blocking while a bounded queue is full.")
  (arg q "The queue.")
  (arg x "The element to enqueue.")
  (reference """
    Equivalent to @code{(sync (queue-send q x))} in a fiber, or
    @code{(sync/blocking (queue-send q x))} outside a fiber context.
    """))

(:doc queue-get
  (summary "Dequeues and returns the front element, blocking while the queue is empty.")
  (arg q "The queue.")
  (returns "The front element.")
  (reference """
    Equivalent to @code{(sync (queue-recv q))} in a fiber, or
    @code{(sync/blocking (queue-recv q))} outside a fiber context.
    """))
