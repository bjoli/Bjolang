;; An imported generic class is a type only. Constructing one said the .NET type
;; could not be found, which is true of the plain name and says nothing useful.
;; EXPECT-ERROR: 'Dict' is System.Collections.Generic.Dictionary, a generic class taking 2 type argument(s), and (Dict.) cannot construct one
(import/class ((Dict %k %v) (: System.Collections.Generic.Dictionary)))

(defun (main args)
  (def d (Dict.))
  0)
