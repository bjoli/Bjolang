;; For 529_linked_trait.bjo and codegen/monomorphise_linked_trait.bjo. A trait
;; that the importer of `linked_trait_b.bjo` does not import: this module is
;; only linked there.

(export Twice twice)
(import (std prelude))

(def/trait (Twice %a)
  (: twice (-> %a %a)))

(impl (Twice int)
  (defun (twice x) (* x 2)))

(impl (Twice double)
  (defun (twice x) (* x 2.0)))
