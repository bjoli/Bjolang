;; An imported constrained function whose local functions annotate a parameter
;; with the signature's type variable is still copied at a concrete type.
;; `list-sort`'s `merge-runs` is written `(: src (Array %a))`. In the copy that
;; variable has to be the copy's type, or `merge-runs` is generalized on its
;; own, keeps the `Ord` constraint, and the copy is declined.
;;
;; EXPECT-CS: listsubsort__at_int
;; EXPECT-NO-CS: Ord

(import (std prelude))

(export sorted-ints)

(: sorted-ints (-> (List int) (List int)))
(defun (sorted-ints xs) (list-sort xs))
