;; std/test/expect.bjo — output compared with a text in the test.
;;
;;     (deftest "printing a card"
;;       (print-value (Card (rank 12) (suit Hearts)))
;;       (expect-output """
;;         (Card (rank 12) (suit Hearts))
;;         """))
;;
;; A test whose body names `expect-output` writes its output to a string port
;; (see `take-test-output!` in `(std test)`). Each `expect-output` compares
;; what was written since the test started, or since the previous one, with
;; its text. With `--promote`, a text that differs is not a failure: the run
;; writes the output into the test file in its place, when it ends.

(export expect-output
        ;; Named by the template of the macro above, so it has to be
        ;; reachable where that expands.
        expect-output-check!)

(import (std prelude))
(import (std syntax-match))
(import (std test))

(:doc #:file "expect.bjodoc")

;; ---------------------------------------------------------------------------
;; Comparing
;; ---------------------------------------------------------------------------

;; Text as it is compared: its lines, without a carriage return or other
;; whitespace at their ends, and without empty lines at its start and end. A
;; raw string drops the line breaks next to its quotes, so this keeps a
;; printed final newline from being a difference.
(: compared-lines (-> string (Vec string)))
(defun (compared-lines text)
  (def lines (vec->list (vec-map string-trim-right (string-split text "\n"))))
  (defun (drop-empty xs)
    (match xs
      ((Cons "" more) (drop-empty more))
      (_ xs)))
  (list->vec (list-reverse (drop-empty (list-reverse (drop-empty lines))))))

;; A line diff of two texts: a line only in `wanted` starts with -, one only
;; in `got` with +, and one in both with a space. The longest common
;; subsequence decides which lines are in both.
(: diff-lines (-> (Vec string) (Vec string) (List string)))
(defun (diff-lines wanted got)
  (def n (vec-length wanted))
  (def m (vec-length got))
  (if (> (* n m) 1000000)
      ;; Too large to diff in reasonable time: both, in full.
      (list-append (list-map (fun (l) (str "-" l)) (vec->list wanted))
                   (list-map (fun (l) (str "+" l)) (vec->list got)))
      (let ((table (make-array (* (+ n 1) (+ m 1)))))
        (defun (at i j) (array-ref table (+ (* i (+ m 1)) j)))
        ;; table[i][j] is the length of the common subsequence of the lines
        ;; from i on and from j on.
        (loop (:for back-i (range 0 (+ n 1)))
              (:let i (- n back-i))
              (:do (loop (:for back-j (range 0 (+ m 1)))
                         (:let j (- m back-j))
                         (:do (array-set! table (+ (* i (+ m 1)) j)
                                          (cond
                                            ((or (= i n) (= j m)) 0)
                                            ((= (vec-ref wanted i) (vec-ref got j)) (+ 1 (at (+ i 1) (+ j 1))))
                                            (else (max (at (+ i 1) j) (at i (+ j 1))))))))))
        (let go ((i 0) (j 0) (out (list)))
          (cond
            ((and (= i n) (= j m)) (list-reverse out))
            ((= i n) (go i (+ j 1) (cons (str "+" (vec-ref got j)) out)))
            ((= j m) (go (+ i 1) j (cons (str "-" (vec-ref wanted i)) out)))
            ((= (vec-ref wanted i) (vec-ref got j)) (go (+ i 1) (+ j 1) (cons (str " " (vec-ref wanted i)) out)))
            ((>= (at (+ i 1) j) (at i (+ j 1))) (go (+ i 1) j (cons (str "-" (vec-ref wanted i)) out)))
            (else (go i (+ j 1) (cons (str "+" (vec-ref got j)) out))))))))

;; One `expect-output` whose text differed: where it is, the text it had when
;; the test ran, and what the test wrote instead. The old text is how the
;; promoter finds the form, and how it knows the file has not changed since.
(type (: Promotion (Record (: line int) (: wanted string) (: got string))))

;; The output a run promotes, by file, newest first.
(: promotions (Box (List (Tuple string Promotion))))
(def promotions (make-box (list)))

(: shown-name (-> string string))
(defun (shown-name path)
  (match (path-filename path)
    ((Some name) name)
    (None path)))

;; What `expect-output` expands to.
(: expect-output-check! (-> string int string void))
(defun (expect-output-check! file line wanted)
  (def where #"${(shown-name file)}:${line}")
  (match (take-test-output!)
    (None
     (test-failed! #"  ${where}: expect-output has no output to read. It reads the output of a test whose deftest body names it."))
    ((Some got)
     (def w (compared-lines wanted))
     (def g (compared-lines got))
     (unless (= w g)
       (if (record-ref (current-test-options) promote)
           (begin
             (box-set! promotions (cons (Tuple file (Promotion (line line) (wanted wanted) (got got)))
                                        (box-ref promotions)))
             (at-run-end! "std test expect: promote" promote-all!))
           (test-failed!
             (string-join
               (list->vec (cons #"  ${where}: the output is not the expected text (- expected, + written; --promote updates the text):"
                                (list-map (fun (l) (str "    " l)) (diff-lines w g))))
               "\n")))))))

;; `(expect-output text)` — the output since the test started, or since the
;; previous `expect-output`, is the text.
(def/macro (expect-output form inject compare)
  (syntax-match form
    ((_ text)
     #'(expect-output-check! ,(SStr (syntax-file form)) ,(SInt (int->string (syntax-line form))) ,text))
    (bad (syntax-error bad "expect-output takes a string: (expect-output \"\"\" ... \"\"\")."))))

;; ---------------------------------------------------------------------------
;; Promoting
;; ---------------------------------------------------------------------------

;; The index in `cs` of the first occurrence of `needle` at or after `from`.
(: vec-search (-> (Vec char) (Vec char) int (Option int)))
(defun (vec-search cs needle from)
  (def n (vec-length cs))
  (def k (vec-length needle))
  (let go ((i from))
    (cond
      ((> (+ i k) n) None)
      ((loop (:for j (range 0 k)) (:acc ok (folding #t (and ok (char=? (vec-ref cs (+ i j)) (vec-ref needle j))))))
       (Some i))
      (else (go (+ i 1))))))

;; The index where line `line` (from 1) starts.
(: line-start (-> (Vec char) int int))
(defun (line-start cs line)
  (let go ((i 0) (l 1))
    (cond
      ((= l line) i)
      ((>= i (vec-length cs)) i)
      ((char=? (vec-ref cs i) #\newline) (go (+ i 1) (+ l 1)))
      (else (go (+ i 1) l)))))

;; How many quotes stand in a row from i.
(: quote-run (-> (Vec char) int int))
(defun (quote-run cs i)
  (let go ((j i))
    (if (and (< j (vec-length cs)) (char=? (vec-ref cs j) #\")) (go (+ j 1)) (- j i))))

;; Where the string literal that starts at i ends: the index after its
;; closing quotes. A run of three or more quotes is a raw string, closed by a
;; run as long.
(: literal-end (-> (Vec char) int (Option int)))
(defun (literal-end cs i)
  (def q (quote-run cs i))
  (def n (vec-length cs))
  (cond
    ((= q 0) None)
    ((= q 2) (Some (+ i 2)))
    ((= q 1)
     (let go ((j (+ i 1)))
       (cond
         ((>= j n) None)
         ((char=? (vec-ref cs j) #\\) (go (+ j 2)))
         ((char=? (vec-ref cs j) #\") (Some (+ j 1)))
         (else (go (+ j 1))))))
    (else
     (let go ((j (+ i q)))
       (cond
         ((>= j n) None)
         ((>= (quote-run cs j) q) (Some (+ j q)))
         (else (go (+ j 1))))))))

;; The longest run of quotes in a text.
(: longest-quote-run (-> string int))
(defun (longest-quote-run text)
  (def cs (string->vec text))
  (let go ((i 0) (best 0))
    (if (>= i (vec-length cs))
        best
        (let ((q (quote-run cs i)))
          (if (> q 0) (go (+ i q) (max q best)) (go (+ i 1) best))))))

(: repeat-string (-> string int string))
(defun (repeat-string s n)
  (string-join (list->vec (loop (:for _ (range 0 n)) (:acc out (listing s)))) ""))

;; The text as a literal for the test file. One line without a quote, a
;; backslash or a tab is a plain string. Anything else is a raw string whose
;; lines start at `margin` columns, with the closing quotes on a line of their
;; own at the margin; its quotes are one more than the longest run in the
;; text, and at least three.
(: raw-literal (-> string int string))
(defun (raw-literal text margin)
  (def lines (compared-lines text))
  (cond
    ((vec-empty? lines) "\"\"")
    ((and (= (vec-length lines) 1)
          (not (string-contains? (vec-ref lines 0) "\""))
          (not (string-contains? (vec-ref lines 0) "\\"))
          (not (string-contains? (vec-ref lines 0) "\t")))
     (str "\"" (vec-ref lines 0) "\""))
    (else
      (let* ((q (repeat-string "\"" (max 3 (+ 1 (longest-quote-run text)))))
             (pad (repeat-string " " margin)))
        (str q "\n"
             (string-join (vec-map (fun (l) (if (string-empty? l) "" (str pad l))) lines) "\n")
             "\n" pad q)))))

;; What the string literal from i to end holds: a raw string without its
;; margin, or an escaped string with its escapes undone.
(: literal-text (-> (Vec char) int int string))
(defun (literal-text cs i end)
  (def q (quote-run cs i))
  (defun (chars from to) (list->string (vec->list (vec-slice cs from (- to from)))))
  (cond
    ((= q 2) "")
    ((= q 1) (unescape (chars (+ i 1) (- end 1))))
    (else
     (def inside (chars (+ i q) (- end q)))
     (if (string-starts-with? inside "\n")
         ;; Over several lines: the opening quotes end their line, and the
         ;; closing ones stand at the margin on a line of their own.
         (let* ((lines (vec->list (string-split inside "\n")))
                (body (list-tail lines))
                (margin (string-length (list-head (list-reverse body))))
                (text (list-reverse (list-tail (list-reverse body)))))
           (string-join (list->vec (list-map (fun (l) (drop-chars l margin)) text)) "\n"))
         inside))))

;; The string without its first n characters, or empty when it is shorter.
(: drop-chars (-> string int string))
(defun (drop-chars s n)
  (let go ((left (string->list s)) (k n))
    (match left
      ((Cons _ more) #:when (> k 0) (go more (- k 1)))
      (_ (list->string left)))))

;; An escaped string's text: \n, \t, \r, \0, \\ and \" undone. Other escapes
;; are kept as written, which is enough to compare texts.
(: unescape (-> string string))
(defun (unescape s)
  (let go ((left (string->list s)) (out (list)))
    (match left
      (Nil (list->string (list-reverse out)))
      ((Cons #\\ (Cons c more))
       (go more (cons (case c
                        (#\n #\newline)
                        (#\t #\tab)
                        (#\r #\return)
                        (#\0 (int->char 0))
                        (else c))
                      out)))
      ((Cons c more) (go more (cons c out))))))

;; The places on line `line` (from 1) where an `(expect-output` starts.
(: forms-on-line (-> (Vec char) int (List int)))
(defun (forms-on-line cs line)
  (def head (string->vec "(expect-output"))
  (def start (line-start cs line))
  (def stop (line-start cs (+ line 1)))
  (let go ((from start) (out (list)))
    (match (vec-search cs head from)
      ((Some at) (if (< at stop) (go (+ at 1) (cons at out)) (list-reverse out)))
      (None (list-reverse out)))))

;; Where the `expect-output` on `line` that still holds `wanted` is: the
;; start of the form, and the start and end of its literal. None when no form
;; there holds it, because the file changed since the test was compiled.
(: find-form (-> (Vec char) int string (Option (Tuple int (Tuple int int)))))
(defun (find-form cs line wanted)
  (def head-length (string-length "(expect-output"))
  (loop (:for at (forms-on-line cs line))
        (:acc found
              (folding None
                       (match found
                         ((Some _) found)
                         (None
                          (match (literal-after cs (+ at head-length))
                            (None None)
                            ((Some (Tuple i end))
                             (if (= (compared-lines (literal-text cs i end)) (compared-lines wanted))
                                 (Some (Tuple at (Tuple i end)))
                                 None)))))))))

;; The text with the literal from i to end replaced by `got`, at the margin of
;; a form that starts at `at`.
(: replace-literal (-> (Vec char) int int int int string string))
(defun (replace-literal cs line at i end got)
  (str (list->string (vec->list (vec-slice cs 0 i)))
       (raw-literal got (+ (- at (line-start cs line)) 2))
       (list->string (vec->list (vec-slice cs end (- (vec-length cs) end))))))

;; Where the literal after i starts and ends, past whitespace.
(: literal-after (-> (Vec char) int (Option (Tuple int int))))
(defun (literal-after cs i)
  (cond
    ((>= i (vec-length cs)) None)
    ((char-whitespace? (vec-ref cs i)) (literal-after cs (+ i 1)))
    (else
     (match (literal-end cs i)
       (None None)
       ((Some end) (Some (Tuple i end)))))))

;; Writes every promotion into its file, from the last line to the first so
;; that a replacement does not move the lines of those still to come. Forms on
;; one line go from the right, for the same reason: a raw string over several
;; lines moves what follows it on its line.
(: promote-all! (-> void))
(defun (promote-all!)
  (def by-file
    (list-foldl (fun (p m)
                  (match p
                    ((Tuple file entry) (map-set m file (cons entry (map-ref-or m file (list)))))))
                (map-empty)
                (box-ref promotions)))
  (map-for-each
    (fun (file entries)
      (match (promote-file (file-read-text file) file (list-sort-desc entries))
        ((Tuple new-text n)
         (when (> n 0)
           (file-write-text file new-text)
           (println #"promote: wrote ${n} text(s) into ${(shown-name file)}")))))
    by-file)
  (box-set! promotions (list)))

;; The text with the promotions written into it, and how many were. The
;; promotions come by line, the last first.
(: promote-file (-> string string (List Promotion) (Tuple string int)))
(defun (promote-file text file sorted)
  (match sorted
    (Nil (Tuple text 0))
    ((Cons p _)
     (def line (record-ref p line))
     (def here (list-filter (fun (q) (= (record-ref q line) line)) sorted))
     (def rest (list-filter (fun (q) (not (= (record-ref q line) line))) sorted))
     (def cs (string->vec text))
     ;; Each form found on the line, from the right.
     (def found
       (loop (:for q here)
             (:acc out (listing (Tuple q (find-form cs line (record-ref q wanted)))))))
     (loop (:for f found)
           (:do (match f
                  ((Tuple q None)
                   (println #"promote: the expect-output at ${(shown-name file)}:${line} no longer holds the text the test ran with, so it was left alone"))
                  (_ unit))))
     (def placed (sort-by-start-desc
                   (loop (:for f found)
                         (:when-let (Tuple q (Some place)) f)
                         (:acc out (listing (Tuple q place))))))
     (def new-text
       (list-foldl (fun (f t)
                     (match f
                       ((Tuple q (Tuple at (Tuple i end)))
                        (replace-literal (string->vec t) line at i end (record-ref q got)))))
                   text
                   placed))
     (match (promote-file new-text file rest)
       ((Tuple final n) (Tuple final (+ n (list-length placed))))))))

(: sort-by-start-desc (-> (List (Tuple Promotion (Tuple int (Tuple int int))))
                          (List (Tuple Promotion (Tuple int (Tuple int int))))))
(defun (sort-by-start-desc xs)
  (list-foldl insert-by-start (list) xs))

(: insert-by-start (-> (Tuple Promotion (Tuple int (Tuple int int)))
                       (List (Tuple Promotion (Tuple int (Tuple int int))))
                       (List (Tuple Promotion (Tuple int (Tuple int int))))))
(defun (insert-by-start e sorted)
  (match sorted
    (Nil (list e))
    ((Cons f more)
     (if (>= (start-of e) (start-of f)) (cons e sorted) (cons f (insert-by-start e more))))))

(: start-of (-> (Tuple Promotion (Tuple int (Tuple int int))) int))
(defun (start-of e) (match e ((Tuple _ (Tuple at _)) at)))

;; The promotions by line, the last first. A form promoted twice, at the same
;; line with the same old text, keeps the first.
(: list-sort-desc (-> (List Promotion) (List Promotion)))
(defun (list-sort-desc xs)
  (list-foldl insert-promotion (list) (list-reverse xs)))

(: insert-promotion (-> Promotion (List Promotion) (List Promotion)))
(defun (insert-promotion e sorted)
  (match sorted
    (Nil (list e))
    ((Cons f more)
     (cond
       ((and (= (record-ref e line) (record-ref f line)) (= (record-ref e wanted) (record-ref f wanted))) sorted)
       ((>= (record-ref e line) (record-ref f line)) (cons e sorted))
       (else (cons f (insert-promotion e more)))))))
