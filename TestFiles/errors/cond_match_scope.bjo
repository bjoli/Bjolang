;; What a `:match` binds is in scope in its own guard and body, and not in the
;; clauses below it: that is the difference from `:def`.
;; EXPECT-ERROR: Unbound variable: port

(import (std prelude))

(: f (-> (Option int) int))
(defun (f o)
  (cond
    (:match (Some port) o #:when (> port 0) port)
    (else port)))

(defun (main) (f None))
