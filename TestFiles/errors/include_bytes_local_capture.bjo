;; EXPECT-ERROR: 's' is a (System.ReadOnlySpan byte) bound outside this (fun ...), and a span cannot be captured
;;
;; A local span of include-bytes is a span as any other: a closure cannot
;; capture it. A module-level one it can read.
(import (std prelude))
(defun (main)
  (def s (include-bytes "../assets/include-bytes/bytes.bin"))
  (def f (fun (i) (cast int (ro-span-ref s i))))
  (f 0))
