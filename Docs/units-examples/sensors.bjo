;; Paper program: weather station readings from CSV, filtered and printed.
;;
;; readings.csv:
;;   sensor,temp_c,pressure_hpa,wind_kmh
;;   roof,21.5,1013.2,12.0
;;   mast,19.0,1009.8,61.5

(import (std units) (text csv) (text csv-codec))

;; A field with a unit reads and writes the number in the type's unit.
;; Needs (impl (CsvField (double %u))) in csv-codec.
(def/csv-type
  (: Reading (Record (: sensor string)
                     (: temp Celsius #:csv "temp_c")
                     (: pressure (double hPa) #:csv "pressure_hpa")
                     (: wind (double km/h) #:csv "wind_kmh"))))

(: windy? (-> Reading bool))
(defun (windy? r)
  (> (.wind r) <50 km/h>))                ; literal stays 50, in km/h

(: low-pressure? (-> Reading bool))
(defun (low-pressure? r)
  (< (.pressure r) <1 atm>))              ; literal becomes 1013.25 hPa

(: mean-wind (-> (Vec Reading) (double km/h)))
(defun (mean-wind rs)
  (/ (loop (:for r rs) (:acc s (summing (.wind r))))   ; summing at km/h: Measure, not Num
     (cast System.Double (length rs))))

(defun (main args)
  (match (parse-csv-records (csv-file "readings.csv"))
    ((Ok rs)
     (loop (:for r rs)
           (:when (or (windy? r) (low-pressure? r)))
           (:do (println (.sensor r) ": " (.wind r) ", " (as (.wind r) m/s))))
     ;; mast: 61.5 km/h, 17.083 m/s
     (println "mean: " (mean-wind rs)))   ; mean: 36.75 km/h
    ((Err e) (println e)))
  0)

;; Temperature.
;; (.temp r) is a Celsius, a newtype over double from (std units), and not
;; a (double degC). Arithmetic on it is a type error: 20 °C + 20 °C is not
;; 40 °C. Conversions:
(celsius->kelvin (.temp r))               ; (double K), 294.65
(- (celsius->kelvin a) (celsius->kelvin b))   ; (double K), a difference

;; Errors.
(+ (.wind r) (.pressure r))
;; error: cannot add km/h and hPa.
;;   km/h is length/time, hPa is mass/(length time^2).

(> (.wind r) 50)
;; error: cannot compare km/h and 1.
;;   Write <50 km/h>.

;; Count: 3 field units, 1 annotation (mean-wind), 1 as, 1 cast.
