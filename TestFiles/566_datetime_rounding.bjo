;; (std datetime): round-to-duration, round-to-duration/opt and start-of-day.
;; Each mode on positive and negative values; a moment's local time rounded
;; and resolved again; a moment rounded to a day of 23 and of 25 hours; and
;; the errors.
(import (std prelude))
(import (std simpletest))
(import (std datetime))

(: (-> (Option %a) %a))
(defun (the o)
  (match o
    ((Some x) x)
    (None (panic! "a constant date or zone came back None"))))

(: (-> (-> %a) bool))
(defun (raises? thunk)
  (err? (try (thunk) #:catch (System.OverflowException))))

(: (-> (-> %a) bool))
(defun (refused? thunk)
  (err? (try (thunk) #:catch (System.ArgumentException))))

(: Duration)
(def an-hour (duration #:hours 1))

(: Duration)
(def a-day (duration #:hours 24))

(: (-> long Duration))
(defun (minutes n) (duration #:minutes n))

;; A duration of n minutes rounded to the hour by mode, as written.
(: (-> long TimeRounding string))
(defun (hour-of n mode) (displayed (round-to-duration (minutes n) an-hour #:mode mode)))

(: (-> void))
(defun (modes)
  (expect "half-expand by default: 89 minutes"
          (displayed (round-to-duration (minutes 89) an-hour))
          "PT1H")
  (expect "a half rounds away from zero" (hour-of 90 TimeHalfExpand) "PT2H")
  (expect "and below zero" (hour-of -90 TimeHalfExpand) "-PT2H")
  (expect "floor" (hour-of 119 TimeFloor) "PT1H")
  (expect "floor below zero" (hour-of -61 TimeFloor) "-PT2H")
  (expect "ceil" (hour-of 61 TimeCeil) "PT2H")
  (expect "ceil below zero" (hour-of -119 TimeCeil) "-PT1H")
  (expect "trunc goes toward zero"
          (Tuple (hour-of 119 TimeTrunc) (hour-of -119 TimeTrunc))
          (Tuple "PT1H" "-PT1H"))
  (expect "expand goes away from it"
          (Tuple (hour-of 61 TimeExpand) (hour-of -61 TimeExpand))
          (Tuple "PT2H" "-PT2H"))
  (expect "half-even: 1.5 h and 2.5 h are 2 h"
          (Tuple (hour-of 90 TimeHalfEven) (hour-of 150 TimeHalfEven))
          (Tuple "PT2H" "PT2H"))
  (expect "half-even off the half is nearest" (hour-of 151 TimeHalfEven) "PT3H")
  (expect "a multiple is itself in every mode" (hour-of 120 TimeCeil) "PT2H")
  (expect "a mode prints" (displayed TimeHalfEven) "TimeHalfEven"))

(: (-> void))
(defun (calendar-types)
  (expect "a datetime to 15 minutes"
          (displayed (round-to-duration (the (datetime 2026 1 1 #:hours 10 #:minutes 7))
                                        (minutes 15)))
          "2026-01-01T10:00:00")
  (expect "half way is up"
          (displayed (round-to-duration (the (datetime 2026 1 1 #:hours 10 #:minutes 7 #:seconds 30))
                                        (minutes 15)))
          "2026-01-01T10:15:00")
  (expect "a datetime to the day"
          (displayed (round-to-duration (the (datetime 2026 1 1 #:hours 12)) a-day))
          "2026-01-02T00:00:00")
  (expect "a time rounded up to 24:00 wraps"
          (displayed (round-to-duration (the (time 23 50)) an-hour))
          "00:00:00")
  (expect "an instant before 1970, floored"
          (displayed (round-to-duration (the (iso8601->instant "1969-12-31T23:59:59.5Z"))
                                        (duration #:seconds 1)
                                        #:mode TimeFloor))
          "1969-12-31T23:59:59Z")
  (expect "start-of-day of a datetime"
          (displayed (start-of-day (the (datetime 2026 5 17 #:hours 10))))
          "2026-05-17T00:00:00"))

(: (-> void))
(defun (errors)
  (def last (the (datetime 9999 12 31 #:hours 23 #:minutes 59 #:seconds 59)))
  (expect-true "rounding past 9999-12-31 raises"
               (raises? (fun () (round-to-duration last (duration #:seconds 2)))))
  (expect-true "and is None with /opt" (none? (round-to-duration/opt last (duration #:seconds 2))))
  (expect "rounding down there is fine"
          (round-to-duration/opt last an-hour #:mode TimeFloor)
          (datetime 9999 12 31 #:hours 23))
  (expect-true "a duration past ±29 227 years"
               (none? (round-to-duration/opt (duration #:hours 256204778)
                                             (duration #:hours 1000)
                                             #:mode TimeCeil)))
  (expect-true "7 minutes does not divide a day"
               (refused? (fun () (round-to-duration (the (time 1 0)) (minutes 7)))))
  (expect-true "nor does 25 hours" (refused? (fun () (round-to-duration last (duration #:hours 25)))))
  (expect "a duration takes any increment"
          (displayed (round-to-duration (minutes 20) (minutes 7)))
          "PT21M")
  (expect-true "zero raises" (refused? (fun () (round-to-duration (minutes 20) (duration)))))
  (expect-true "and /opt still raises it"
               (refused? (fun () (round-to-duration/opt (the (time 1 0)) (minutes 7))))))

(: (-> TimeZone int int int int int Moment))
(defun (at z y mo d h mi)
  (datetime->moment (the (datetime y mo d #:hours h #:minutes mi)) z compatible-resolver))

(: (-> TimeZone void))
(defun (stockholm z)
  (expect "into the gap: pushed forward"
          (displayed (round-to-duration (at z 2026 3 29 1 50) an-hour))
          "2026-03-29T03:00:00+02:00[Europe/Stockholm]")
  (def second-0210
    (datetime->moment (the (datetime 2026 10 25 #:hours 2 #:minutes 10))
                      z
                      (resolver GapPush OverlapLater)))
  (expect "in an overlap a moment keeps its offset"
          (displayed (round-to-duration second-0210 an-hour #:mode TimeFloor))
          "2026-10-25T02:00:00+01:00[Europe/Stockholm]")
  (expect "the first 02:10 keeps its own"
          (displayed (round-to-duration (at z 2026 10 25 2 10) an-hour #:mode TimeFloor))
          "2026-10-25T02:00:00+02:00[Europe/Stockholm]")
  (expect "an ordinary day: 12:00 is half"
          (displayed (round-to-duration (at z 2026 5 17 12 0) a-day))
          "2026-05-18T00:00:00+02:00[Europe/Stockholm]")
  (expect "a 23-hour day: 12:29 is 11 h 29 min in, under half"
          (displayed (round-to-duration (at z 2026 3 29 12 29) a-day))
          "2026-03-29T00:00:00+01:00[Europe/Stockholm]")
  (expect "and 12:30 is half of 23 hours"
          (displayed (round-to-duration (at z 2026 3 29 12 30) a-day))
          "2026-03-30T00:00:00+02:00[Europe/Stockholm]")
  (expect "a 25-hour day: 11:29 is 12 h 29 min in, under half"
          (displayed (round-to-duration (at z 2026 10 25 11 29) a-day))
          "2026-10-25T00:00:00+02:00[Europe/Stockholm]")
  (expect "and 11:30 is half of 25 hours"
          (displayed (round-to-duration (at z 2026 10 25 11 30) a-day))
          "2026-10-26T00:00:00+01:00[Europe/Stockholm]")
  (expect "start-of-day of a moment"
          (displayed (start-of-day (at z 2026 10 25 18 0)))
          "2026-10-25T00:00:00+02:00[Europe/Stockholm]")
  (def last-evening (at z 9999 12 31 20 0))
  (expect-true "9999-12-31 has no next day to round up to"
               (raises? (fun () (round-to-duration last-evening a-day))))
  (expect "but rounds down to its start"
          (displayed (round-to-duration (at z 9999 12 31 1 0) a-day))
          "9999-12-31T00:00:00+01:00[Europe/Stockholm]"))

(: (-> void))
(defun (other-zones)
  (match (Tuple (timezone "Asia/Kolkata") (timezone "America/Sao_Paulo"))
    ((Tuple (Some kolkata) (Some sao-paulo))
     (expect "a half-hour offset rounds its local time"
             (displayed (round-to-duration (at kolkata 2026 5 17 10 40) an-hour))
             "2026-05-17T11:00:00+05:30[Asia/Kolkata]")
     ;; São Paulo began summer time at midnight until 2019: 2018-11-04 00:00
     ;; was 01:00.
     (expect "a day whose midnight is in a gap starts after it"
             (displayed (start-of-day (at sao-paulo 2018 11 4 12 0)))
             "2018-11-04T01:00:00-02:00[America/Sao_Paulo]"))
    (_ (fail "no Asia/Kolkata or America/Sao_Paulo"))))

(defun (main)
  (modes)
  (calendar-types)
  (errors)
  (match (timezone "Europe/Stockholm")
    ((Some z)
     (stockholm z)
     (other-zones))
    (None (fail "the IANA time zone database was not found. Install tzdata.")))
  0)
