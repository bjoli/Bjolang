    (list "ha" "10000 m2" "hectare" "hectares")
    (list "are" "100 m2" "ares")
    (list "acre" "4046.8564224 m2" "acres")
    ;; Volume
    (list "l" "0.001 m3" "L" "litre" "litres" "liter" "liters")
    (list "gal" "3.785411784 l" "gallon" "gallons")
    (list "qt" "1|4 gal" "quart" "quarts")
