;; std/maths.bjo — Math functions.

;; Import Eq trait for `=`.
(import (std eq))

(:doc #:file "maths.bjodoc")

(export
  ;; Num
  abs sign min max clamp zero? even? odd?
  sqr positive? negative?
  ;; Integer division, and the integer functions
  quotient remainder modulo quotient/remainder
  gcd lcm expt integer-sqrt
  ;; Doubles: what they are, and pi
  nan? infinite? finite? pi
  ;; Exponential and logarithmic
  cbrt exp pow loge log-base log2 log10
  ;; Rounding, and rounding to an int
  floor ceiling truncate round
  exact-floor exact-ceiling exact-truncate exact-round
  ;; Trigonometric
  sin cos tan asin acos atan atan2
  ;; Hyperbolic
  sinh cosh tanh asinh acosh atanh)

;; ---------------------------------------------------------------------------
;; Num
;; ---------------------------------------------------------------------------

;; `Num` interface.
(def/trait (Num %a)
  (#:clr-constraint (System.Numerics.INumber %a))
  (: abs   (-> %a %a)        #:clr-member Abs)
  (: sign  (-> %a int)       #:clr-member Sign)
  (: min   (-> %a %a %a)     #:clr-member Min)
  (: max   (-> %a %a %a)     #:clr-member Max)
  (: clamp (-> %a %a %a %a)  #:clr-member Clamp)
  ;; Parity tests.
  (: zero? (-> %a bool)      #:clr-member IsZero)
  (: even? (-> %a bool)      #:clr-member IsEvenInteger)
  (: odd?  (-> %a bool)      #:clr-member IsOddInteger))


;; Todo: `min`/`max` over a sequence.

(: sqr (-> %a %a) (where (Num %a)))
(defun (sqr x) (* x x))

;; Not `INumber.IsPositive`, which holds for zero.
(: positive? (-> %a bool) (where (Num %a) (Ordered %a)))
(defun (positive? x) (> x 0))

(: negative? (-> %a bool) (where (Num %a) (Ordered %a)))
(defun (negative? x) (< x 0))

;; ---------------------------------------------------------------------------
;; Integer division
;; ---------------------------------------------------------------------------
;;
;; Racket's names. `quotient` and `remainder` are `/` and `%` at an integer
;; type, named, so that they can be passed and so that a reader sees which
;; convention is meant; `modulo` is the one the operators do not give. R7RS's
;; `truncate/` and `floor/` families are the same operations under other names.

(import/class
  (Exception (: System.Exception))
  (ArgumentOutOfRangeException (: System.ArgumentOutOfRangeException)))

(: out-of-range (-> string string %a))
(defun (out-of-range parameter why)
  (raise (cast Exception (ArgumentOutOfRangeException. parameter why))))

(: quotient (-> %a %a %a) (where (Integral %a) (Num %a)))
(defun (quotient a b) (/ a b))

(: remainder (-> %a %a %a) (where (Integral %a) (Num %a)))
(defun (remainder a b) (% a b))

;; The remainder moved into the divisor's sign: a nonzero remainder of the
;; other sign is one divisor away from it.
(: modulo (-> %a %a %a) (where (Integral %a) (Num %a) (Ordered %a)))
(defun (modulo a b)
  (let ((r (% a b)))
    (if (and (not (zero? r)) (not (= (< r 0) (< b 0))))
        (+ r b)
        r)))

(: quotient/remainder (-> %a %a (Tuple %a %a)) (where (Integral %a) (Num %a)))
(defun (quotient/remainder a b)
  (Tuple (/ a b) (% a b)))

;; ---------------------------------------------------------------------------
;; The integer functions
;; ---------------------------------------------------------------------------

;; Euclid's algorithm, on the magnitudes.
(: gcd (-> %a %a %a) (where (Integral %a) (Num %a)))
(defun (gcd a b)
  (let go ((x (abs a)) (y (abs b)))
    (if (zero? y) x (go y (% x y)))))

;; Divided before it is multiplied, so that the product overflows only when the
;; answer does.
(: lcm (-> %a %a %a) (where (Integral %a) (Num %a)))
(defun (lcm a b)
  (if (or (zero? a) (zero? b))
      0
      (abs (* (/ a (gcd a b)) b))))

;; By squaring: one multiplication per bit of the exponent, and one more for
;; each bit that is set.
(: expt (-> %a int %a) (where (Integral %a) (Num %a)))
(defun (expt base n)
  (when (< n 0)
    (out-of-range "n" "expt: the exponent is negative, and an integer power has to be one."))
  (let go ((b base) (k n) (acc 1))
    (if (= k 0)
        acc
        (go (* b b) (shift-right k 1) (if (odd? k) (* acc b) acc)))))

;; Newton's method from above. The start, n/2 + 1, is at least the root for
;; every n of 2 or more, and nothing on the way adds past n, so it cannot
;; overflow even at the type's largest value.
(: integer-sqrt (-> %a %a) (where (Integral %a) (Num %a) (Ordered %a)))
(defun (integer-sqrt n)
  (when (< n 0)
    (out-of-range "n" "integer-sqrt: the number is negative."))
  (if (< n 2)
      n
      (let go ((x (+ (/ n 2) 1)))
        (let ((y (/ (+ x (/ n x)) 2)))
          (if (>= y x) x (go y))))))

;; ---------------------------------------------------------------------------
;; The double functions
;; ---------------------------------------------------------------------------

;; What a double is.
(import/extern
  (nan?      (: System.Double.IsNaN))
  (infinite? (: System.Double.IsInfinity))
  (finite?   (: System.Double.IsFinite))
  (pi        (: System.Math.PI #:get)))

;; Exponential and logarithmic.
;;
;; One name per base, and none of them overloaded. `System.Math.Log` is two
;; methods rather than one — the natural logarithm and the log to a given base —
;; and binding both to `log` made the meaning depend on how many arguments the
;; call happened to pass. `loge` completes `log2` and `log10`, and `log-base`
;; says what its second argument is.
(import/extern
  (cbrt     (: System.Math.Cbrt))
  (exp      (: System.Math.Exp))
  (pow      (: System.Math.Pow))
  (loge     (: System.Math.Log (-> double double)))
  (log-base (: System.Math.Log (-> double double double)))
  (log2     (: System.Math.Log2))
  (log10    (: System.Math.Log10)))

;; Rounding.
(import/extern
  (floor    (: System.Math.Floor))
  (ceiling  (: System.Math.Ceiling))
  (truncate (: System.Math.Truncate))
  (round    (: System.Math.Round)))

;; Rounding to an int. `Convert.ToInt32` refuses NaN, the infinities and
;; anything out of an int's range with an OverflowException, where a cast
;; would answer a number. The value it is given is already whole, so its own
;; rounding never applies.
(import/extern
  (double->int (: System.Convert.ToInt32 (-> double int))))

(: exact-floor (-> double int))
(defun (exact-floor x) (double->int (floor x)))

(: exact-ceiling (-> double int))
(defun (exact-ceiling x) (double->int (ceiling x)))

(: exact-truncate (-> double int))
(defun (exact-truncate x) (double->int (truncate x)))

(: exact-round (-> double int))
(defun (exact-round x) (double->int (round x)))

;; Trigonometric.
(import/extern
  (sin   (: System.Math.Sin))
  (cos   (: System.Math.Cos))
  (tan   (: System.Math.Tan))
  (asin  (: System.Math.Asin))
  (acos  (: System.Math.Acos))
  (atan  (: System.Math.Atan))
  (atan2 (: System.Math.Atan2)))

;; Hyperbolic.
(import/extern
  (sinh  (: System.Math.Sinh))
  (cosh  (: System.Math.Cosh))
  (tanh  (: System.Math.Tanh))
  (asinh (: System.Math.Asinh))
  (acosh (: System.Math.Acosh))
  (atanh (: System.Math.Atanh)))
