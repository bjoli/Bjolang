;; A prefix gives the trait and its methods a name of their own, and the bare
;; names are then no names for them, as for a type.
;; EXPECT-ERROR: there is no trait named 'Pretty'. It is imported as 'A/Pretty'
(import (std prelude))
(import (prefix-types "../inc/pretty_a.bjo" "A/"))

(: (-> %a string) (where (Pretty %a)))
(defun (shown x) (A/pretty x))

(defun (main args)
  (println (shown 1))
  0)
