;; List functions whose callback may suspend.
;;
;; `(list-map (bjoroutine (p) (read-line p)) ports)` was a type error until the
;; five list functions that take a procedure moved out of the compiler's builtin
;; table and into the prelude, written in Bjolang. The move is the whole fix: a
;; parameter declared `-?->` gets a second copy of the function generated for a
;; suspending callback, and the compiler can only copy a body it can see. A
;; builtin's body is C#.
;;
;; What is *not* here is `vec-map` and `map-map`. Those are tree algorithms —
;; an RRB list and a CHAMP trie — written in C# to copy as little as possible,
;; and rewriting them in Bjolang to gain a colour would pay for it on every
;; ordinary call. They keep their `->` callbacks, and the error a bjoroutine
;; gets there says what to do instead.

(import (std prelude))
(import (std simpletest))

(: run-list (-> (Promise (List string)) (List string)))
(defun (run-list p)
  (match (sync/blocking (promise-join p))
    ((Ok xs) xs)
    ((Err e) (list "raised"))))

(: run-int (-> (Promise int) int))
(defun (run-int p)
  (match (sync/blocking (promise-join p))
    ((Ok n) n)
    ((Err e) -1)))

(: two-ports (-> (List TextInputPort)))
(defun (two-ports)
  (list (open-input-string "one\ntwo\n") (open-input-string "three\n")))

;; --- map ---------------------------------------------------------------------

(: first-lines (-bjo-> (List TextInputPort) (List string)))
(defbjo (first-lines ps)
  (list-map (bjoroutine (p) (read-line p)) ps))

;; --- filter ------------------------------------------------------------------
;;
;; The predicate suspends, and the elements it keeps are the ports that had
;; something on their first line.

(: non-empty-first (-bjo-> (List TextInputPort) int))
(defbjo (non-empty-first ps)
  (list-length
    (list-filter (bjoroutine (p) (not (string-empty? (read-line p)))) ps)))

;; --- the folds ---------------------------------------------------------------

(: total-length (-bjo-> (List TextInputPort) int))
(defbjo (total-length ps)
  (list-foldl (bjoroutine (acc p) (+ acc (string-length (read-line p)))) 0 ps))

(: joined (-bjo-> (List TextInputPort) string))
(defbjo (joined ps)
  (list-foldr (bjoroutine (p acc) (string-append (read-line p) acc)) "" ps))

;; --- and the ordinary colour is untouched ------------------------------------
;;
;; The same five names, called with ordinary callbacks from ordinary functions.
;; Which copy a call means is decided by the callback it is handed, so these
;; reach the body that was always there.

(: lengths (-> (List string) (List int)))
(defun (lengths names) (list-map string-length names))

(: longer-than (-> int (List string) (List string)))
(defun (longer-than n names)
  (list-filter (fun (s) (> (string-length s) n)) names))

(: sum-lengths (-> (List string) int))
(defun (sum-lengths names)
  (list-foldl (fun (acc s) (+ acc (string-length s))) 0 names))

(: concat (-> (List string) string))
(defun (concat names)
  (list-foldr (fun (s acc) (string-append s acc)) "" names))

(defun (main)
  ;; --- suspending callbacks --------------------------------------------------
  (expect "map with a suspending callback"
          (run-list (bjo (first-lines (two-ports))))
          (list "one" "three"))
  (expect "filter with a suspending predicate"
          (run-int (bjo (non-empty-first (two-ports))))
          2)
  (expect "foldl with a suspending step"
          (run-int (bjo (total-length (two-ports))))
          8)
  (expect "foldr with a suspending step"
          (joined-check)
          "onethree")

  ;; --- ordinary callbacks ----------------------------------------------------
  (expect "map, ordinarily" (lengths (list "ab" "cde")) (list 2 3))
  (expect "filter, ordinarily" (longer-than 2 (list "ab" "cde")) (list "cde"))
  (expect "foldl, ordinarily" (sum-lengths (list "ab" "cde")) 5)
  (expect "foldr, ordinarily" (concat (list "ab" "cde")) "abcde")
  0)

;; A right fold runs its steps back to front, so the reads happen in the
;; opposite order to the list — which is worth having on the page, since it is
;; the one place the colour makes the order visible.
(: joined-check (-> string))
(defun (joined-check)
  (run-str (bjo (joined (two-ports)))))

(: run-str (-> (Promise string) string))
(defun (run-str p)
  (match (sync/blocking (promise-join p))
    ((Ok s) s)
    ((Err e) "raised")))
