;; A clause written flat.
;;
;; A comprehension's clauses are the loop's own, so they are parenthesized: that
;; is what lets everything before the first one be the accumulator form verbatim,
;; and what tells the `(:for ...)` that ends that form apart from the `(* a a)`
;; inside it.
;;
;; Only `:when` may be loose, because it is the one thing that does not become a
;; clause at all — it gates the accumulation instead, and is written with the
;; accumulator it guards. So a flat `:for` is refused rather than guessed at, and
;; the message says how to write it.

;; EXPECT-ERROR: must be written (:for ...)
;; EXPECT-ERROR: Only ':when' may be loose, and only before the first clause

(import (std prelude))

(defun (main args)
  (println {summing a :for a (range 0 10)})
  0)
