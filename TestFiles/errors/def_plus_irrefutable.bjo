;; A binding pattern that cannot fail leaves every arm unreachable.
;;
;; Almost always a typo where a constructor was not in scope and so parsed as a
;; plain variable. Refused rather than warned, unlike the match clause it
;; resembles: a `def+` exists to say what happens when the scrutinee is not what
;; was wanted, and one that cannot fail is a `def` with dead code after it.

;; EXPECT-ERROR: always matches, so no arm of this def+ can ever run

(import (std prelude))

(: f (-> (Option int) string))
(defun (f o)
  (def+ (whatever o)
        (None "this can never run"))
  "always here")
