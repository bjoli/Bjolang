;; The third slot of a `def` is always an expression, never arms — the clause
;; pattern is unparenthesised at the head, so there is no shape left to tell the
;; two apart. Arms go after `:fail`.
;;
;; A list of lists whose heads read as patterns is what a reader who meant
;; `:fail` writes here, so it is answered with the keyword rather than with a
;; type error about a call.

;; EXPECT-ERROR: Arms go after `:fail`

(import (std prelude))

(: f (-> (Result string int) string))
(defun (f r)
  (def (Ok n) r (((Err e) e)))
  (int->string n))
