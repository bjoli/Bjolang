;; std/simpletest.bjo — basic test assertion module.

(export expect expect-true fail
        default-test-ms overran?
        FakeFs fake-fs fake-fs-written fake-fs-contents fake-fs-set-modified!
        ;; The handlers, one per `FS` operation. Exported because the
        ;; `with-fake-fs` templates name them.
        fake-fs-reader fake-fs-writer fake-fs-info fake-fs-list
        fake-fs-create-directory fake-fs-delete-file fake-fs-delete-directory
        fake-fs-move)

(import (std prelude))
(import (std effect))
(import (std syntax-match))

;; Asserts equality and prints result.
(: expect (-> string %a %a void) (where (Eq %a) (->str %a)))
(defun (expect label actual wanted)
  (if (= actual wanted)
      (println #"ok: ${label}")
      (println #"FAILURE: ${label} gave ${actual} but wanted ${wanted}")))

;; Asserts boolean and prints result.
(: expect-true (-> string bool void))
(defun (expect-true label ok)
  (if ok
      (println #"ok: ${label}")
      (println #"FAILURE: ${label}")))

;; Marks a failing branch.
(: fail (-> string void))
(defun (fail label)
  (println #"FAILURE: ${label}"))

;; ---------------------------------------------------------------------------
;; A test body, under a scope
;; ---------------------------------------------------------------------------
;;
;; `(with-test "name" body ...)` runs the body under a deadline and asserts that
;; it did not leave a resource behind:
;;
;;     (with-test "reads the fixture"
;;       (with-fake-fs (("a.txt" "hello"))
;;         (expect "read it" (call-with-input-file "a.txt" read-all) (Ok "hello"))))
;;
;; Four things come from the scope rather than from the harness. A test gets a
;; timeout, so a leaked fiber is a failure that names the test instead of a
;; suite that hangs. A fiber the body spawned is waited for, so an assertion
;; inside one cannot be missed. Resources the body opened are released. And
;; several failures in one body are reported together rather than only the
;; first.
;;
;; We check if the test left any resources open *before* the scope finishes. 
;; If we checked after, the scope would have already silently cleaned them up! 
;; We want tests to explicitly fail if they forget to close their files.
;;
;; You can disable this check using `#:open-ok` (useful if you are specifically 
;; testing that cleanup happens on scope-close).
;;
;; `#:within ms` overrides the deadline.
;;
;; We catch `System.Exception` here to handle `Cancelled` exceptions caused by timeouts.
;;
;; Normally, catching and hiding a cancellation is a terrible idea in structured 
;; concurrency. But since this is the top-level test runner, we *want* to catch 
;; it. Doing so lets us report a clean failure with the test's name, instead 
;; of crashing and dumping an unhelpful stack trace.

(: default-test-ms (-> int))
(defun (default-test-ms) 5000)

(: leak-check (-> Syntax Syntax))
(defun (leak-check name)
  #'(let ((left (scope-owned-count (current-scope))))
      (unless (= left 0)
        (fail (string-append ,name (string-append " left " (string-append (int->string left) " resource(s) open")))))))

;; Whether the deadline was what ended the scope.
;;
;; A fiber the body leaked is *cancelled* by the deadline rather than failing,
;; and a cancelled child is not a failure - so the scope closes cleanly and the
;; test would otherwise pass, slowly. The token carries the reason, so the
;; scope is kept in a box and the reason read after it has closed.
(: overran? (-> (Box (Option Scope)) bool))
(defun (overran? holder)
  (match (box-ref holder)
    (None #f)
    ((Some s)
     (match (cancel-reason (scope-token s))
       ((Some Deadline) #t)
       (_ #f)))))

(: test-expansion (-> Syntax Syntax bool (List Syntax) Syntax))
(defun (test-expansion name ms check body)
  (let ((core (if check
                  #'(let () ,@body ,(leak-check name) unit)
                  #'(let () ,@body unit))))
    #'(let ((holder (make-box None)))
        (match (try (with-deadline ,ms (let () (box-set! holder (Some (current-scope))) ,core))
                 #:catch (System.Exception))
          ((Ok _)
           (when (overran? holder)
             (fail (string-append ,name " ran past its deadline: something it started never finished"))))
          ((Err e) (fail (string-append ,name (string-append " did not finish: " (.-Message e)))))))))

(def/macro (with-test form inject compare)
  (syntax-match form
    ((_ name #:within ms #:open-ok first body ...)
     (test-expansion name ms #f (cons first body)))
    ((_ name #:within ms first body ...)
     (test-expansion name ms #t (cons first body)))
    ((_ name #:open-ok first body ...)
     (test-expansion name #'(default-test-ms) #f (cons first body)))
    ((_ name first body ...)
     (test-expansion name #'(default-test-ms) #t (cons first body)))
    (bad (syntax-error bad "with-test takes a name and a body: (with-test \"name\" body ...), optionally #:within ms and #:open-ok."))))

;; ---------------------------------------------------------------------------
;; A filesystem that is not one
;; ---------------------------------------------------------------------------
;;
;; `with-fake-fs` installs a handler for every operation of the prelude's `FS`
;; effect, so everything that reaches the disk through it - the text and byte
;; openers, `file-read-text` and its neighbours, `file-exists?`, `file-delete`,
;; `file-move` and the directory functions - answers out of a map instead:
;;
;;     (with-fake-fs (("notes.txt" "a b c")
;;                    ("empty.txt" ""))
;;       (expect "read it back" (call-with-input-file "notes.txt" read-all) (Ok "a b c")))
;;
;; A seeded path is a file, and every directory above one exists. A path
;; written inside it is readable afterwards. `with-fake-fs-of` installs an
;; existing `FakeFs`, so that `(fake-fs-written fs "out.txt")` can read back
;; what was written - which works after the port has been closed, because
;; `MemoryStream.ToArray` does.
;;
;; Paths are compared as text after one normalization: backslashes become
;; slashes, and a leading "./" and a trailing "/" are dropped. "" and "." are
;; the root. Nothing resolves "..", and a relative path is not made absolute, so
;; "a.txt" and "/tmp/a.txt" are different files.
;;
;; A failure answers the exception type the .NET call would raise, so a test
;; that matches on the error matches either way.
;;
;; The fake has a clock of its own, so that a test about modified times does
;; not depend on how fast it runs. It starts at 2000-01-01T00:00:00Z, which is
;; every seed's time, and each write opened and each directory created moves it
;; one second on and stamps the path: something written later is always newer.
;; A move keeps the times it moves, as a rename does on a disk.
;; `(fake-fs-set-modified! fs path ms)` sets one by hand.
;;
;; The openers answer a `MemoryStream`, and the ports over it are built and
;; owned by the same code that builds them over a file - so a fake port is
;; registered on the scope the open happened in, and a leak test over a fake
;; filesystem means what it means over a real one.
;;
;; `with-fake-fs` is a handler frame, not a scope: it does not wait for a fiber
;; spawned inside it. The fiber keeps the fake - a spawn takes the environment
;; as it stood at the spawn - but the body's assertions, and `with-test`'s leak
;; check, run before the fiber is done. So a fiber that reads or writes the fake
;; goes inside a `with-scope` of its own, inside `with-fake-fs`. No scope is
;; opened here, because one would hide from `with-test` what the body left open.

(import/class
  (Stream (: System.IO.Stream))
  (MemoryStream (: System.IO.MemoryStream (-> MemoryStream)))
  (Encoding (: System.Text.Encoding))
  (FileNotFound (: System.IO.FileNotFoundException (-> string FileNotFound)))
  (DirectoryNotFound (: System.IO.DirectoryNotFoundException (-> string DirectoryNotFound)))
  (IOException (: System.IO.IOException (-> string IOException)))
  (AccessDenied (: System.UnauthorizedAccessException (-> string AccessDenied))))

(import/extern
  (clr-utf8 (: System.Text.Encoding.UTF8 #:get))
  (stream-position! (: System.IO.Stream.Position (-> Stream long void) #:set)))

;; A seeded file holds its text. A written one holds the stream it was written
;; through, which is read when the file is: the writer may still be open, and a
;; read sees what has reached the stream so far, as a read of a real file sees
;; what has been flushed.
(type (: FakeEntry (Union (: FakeText string) (: FakeWritten MemoryStream) FakeDir)))

;; Mutable because a write has to be visible to a later read. `modified` holds
;; the time of every path something stamped; any other path has the clock's
;; start.
(type
  (: FakeFs #:opaque
     (Record (: entries (Map string FakeEntry) #:mutable)
             (: modified (Map string long) #:mutable)
             (: clock long #:mutable))))

;; 2000-01-01T00:00:00Z, in Unix milliseconds.
(: fake-epoch-ms long)
(def fake-epoch-ms 946684800000L)

;; Byte offsets, for the scanning below that counts in bytes.
(import/extern
  (clr-index-of        (: BjolangRuntime.StringIndexOf))
  (clr-last-index-of   (: BjolangRuntime.StringLastIndexOf))
  (clr-substring       (: BjolangRuntime.StringSubstring))
  (clr-substring-from  (: BjolangRuntime.StringSubstringFrom)))

(: fake-path (-> string string))
(defun (fake-path path)
  (let loop ((p (string-replace path "\\" "/")))
    (cond
      ((= p ".") "")
      ((string-starts-with? p "./") (loop (clr-substring-from p 2)))
      ((and (string-ends-with? p "/") (> (string-length p) 1))
       (loop (clr-substring p 0 (- (string-length p) 1))))
      (else p))))

(: fake-parent (-> string string))
(defun (fake-parent path)
  (def at (clr-last-index-of path "/"))
  (if (< at 0) "" (clr-substring path 0 at)))

;; "" for the root, so that a child of the root is its own name.
(: fake-prefix (-> string string))
(defun (fake-prefix path)
  (if (string-empty? path) "" (str path "/")))

;; Every directory above `path` gets an entry of its own, so that it outlives
;; its contents: emptying a directory does not delete it.
(: fake-with-ancestors (-> (Map string FakeEntry) string (Map string FakeEntry)))
(defun (fake-with-ancestors m path)
  (let loop ((m m) (dir (fake-parent path)))
    (if (or (string-empty? dir) (map-has-key? m dir))
        m
        (loop (map-set m dir FakeDir) (fake-parent dir)))))

(: fake-fs (-> (List (Tuple string string)) FakeFs))
(defun (fake-fs seeds)
  (FakeFs (entries (list-foldl (fun (seed m)
                                 (def (raw text) seed)
                                 (def path (fake-path raw))
                                 (map-set (fake-with-ancestors m path) path (FakeText text)))
                               (map-empty)
                               seeds))
          (modified (map-empty))
          (clock fake-epoch-ms)))

(: fake-entries (-> FakeFs (Map string FakeEntry)))
(defun (fake-entries fs) (record-ref fs entries))

(: fake-update! (-> FakeFs (Map string FakeEntry) void))
(defun (fake-update! fs m) (record-set! fs (entries m)))

;; Moves the clock one second on, and gives `path` the new time.
(: fake-stamp! (-> FakeFs string void))
(defun (fake-stamp! fs path)
  (def now (+ (record-ref fs clock) 1000L))
  (record-set! fs (clock now) (modified (map-set (record-ref fs modified) path now))))

(: fake-forget-time! (-> FakeFs string void))
(defun (fake-forget-time! fs path)
  (record-set! fs (modified (map-remove (record-ref fs modified) path))))

(: fake-fs-set-modified! (-> FakeFs string long void))
(defun (fake-fs-set-modified! fs path ms)
  (record-set! fs (modified (map-set (record-ref fs modified) (fake-path path) ms))))

(: fake-bytes->text (-> (Array byte) string))
(defun (fake-bytes->text bytes) (.GetString (cast Encoding clr-utf8) bytes))

(: fake-text->bytes (-> string (Array byte)))
(defun (fake-text->bytes text) (.GetBytes (cast Encoding clr-utf8) text))

;; What a file entry holds. `None` for a directory.
(: fake-entry-text (-> FakeEntry (Option string)))
(defun (fake-entry-text entry)
  (match entry
    ((FakeText text) (Some text))
    ((FakeWritten s) (Some (fake-bytes->text (.ToArray s))))
    (FakeDir None)))

;; What a file entry holds, as bytes. Reading and appending go through this
;; rather than through the text, so that bytes that are not UTF-8 come back as
;; they were written.
(: fake-entry-bytes (-> FakeEntry (Option (Array byte))))
(defun (fake-entry-bytes entry)
  (match entry
    ((FakeText text) (Some (fake-text->bytes text)))
    ((FakeWritten s) (Some (.ToArray s)))
    (FakeDir None)))

(: fake-bytes-at (-> FakeFs string (Option (Array byte))))
(defun (fake-bytes-at fs path)
  (match (map-try-ref (fake-entries fs) path)
    ((Some entry) (fake-entry-bytes entry))
    (None None)))

;; In bytes, as a file on a disk would be.
(: fake-entry-size (-> FakeEntry long))
(defun (fake-entry-size entry)
  (match (fake-entry-bytes entry)
    ((Some bytes) (cast System.Int64 (array-length bytes)))
    (None 0L)))

;; A path that is no entry of its own is still a directory when something is
;; below it.
(: fake-kind (-> FakeFs string (Option FsKind)))
(defun (fake-kind fs path)
  (if (string-empty? path)
      (Some FsDirectory)
      (match (map-try-ref (fake-entries fs) path)
        ((Some FakeDir) (Some FsDirectory))
        ((Some _) (Some FsFile))
        (None (if (map-any? (fun (k v) (string-starts-with? k (fake-prefix path)))
                            (fake-entries fs))
                  (Some FsDirectory)
                  None)))))

(: fake-info (-> FakeFs string (Option FsInfo)))
(defun (fake-info fs path)
  (match (fake-kind fs path)
    (None None)
    ((Some k)
     (Some (FsInfo (kind k)
                   (size (match (map-try-ref (fake-entries fs) path)
                           ((Some entry) (fake-entry-size entry))
                           (None 0L)))
                   (modified-ms (map-ref-or (record-ref fs modified) path fake-epoch-ms))
                   (link? #f))))))

(: fake-dir? (-> FakeFs string bool))
(defun (fake-dir? fs path)
  (match (fake-kind fs path)
    ((Some FsDirectory) #t)
    (_ #f)))

;; What a file holds, whether it was seeded or written.
(: fake-fs-contents (-> FakeFs string (Option string)))
(defun (fake-fs-contents fs path)
  (match (map-try-ref (fake-entries fs) (fake-path path))
    ((Some entry) (fake-entry-text entry))
    (None None)))

(: fake-memory-stream (-> (Array byte) MemoryStream))
(defun (fake-memory-stream bytes)
  (def s (MemoryStream.))
  (.Write s bytes 0 (array-length bytes))
  (stream-position! (cast Stream s) 0L)
  s)

(: fake-error (-> Exception (Result Exception %a)))
(defun (fake-error e) (Err e))

(: not-found (-> string (Result Exception %a)))
(defun (not-found path)
  (fake-error (cast Exception (FileNotFound. #"the fake filesystem has no file ${path}"))))

(: no-directory (-> string (Result Exception %a)))
(defun (no-directory path)
  (fake-error (cast Exception (DirectoryNotFound. #"the fake filesystem has no directory ${path}"))))

(: io-error (-> string (Result Exception %a)))
(defun (io-error message)
  (fake-error (cast Exception (IOException. message))))

(: access-denied (-> string (Result Exception %a)))
(defun (access-denied path)
  (fake-error (cast Exception (AccessDenied. #"the fake filesystem cannot do that to directory ${path}"))))

;; --- The handlers --------------------------------------------------------------

(: fake-fs-reader (-> FakeFs (-> string (Result Exception Stream))))
(defun (fake-fs-reader fs)
  (fun (raw)
    (def path (fake-path raw))
    (match (fake-kind fs path)
      ((Some FsDirectory) (access-denied path))
      ((Some FsFile) (match (fake-bytes-at fs path)
                       ((Some bytes) (Ok (cast Stream (fake-memory-stream bytes))))
                       (None (not-found path))))
      (None (if (fake-dir? fs (fake-parent path)) (not-found path) (no-directory path))))))

;; `Append` starts the new stream with what the path held.
(: fake-fs-writer (-> FakeFs (-> string WriteMode (Result Exception Stream))))
(defun (fake-fs-writer fs)
  (fun (raw mode)
    (def path (fake-path raw))
    (def kind (fake-kind fs path))
    (cond
      ((not (fake-dir? fs (fake-parent path))) (no-directory path))
      (else
       (match (Tuple mode kind)
         ((Tuple _ (Some FsDirectory)) (access-denied path))
         ((Tuple CreateNew (Some FsFile)) (io-error #"the fake filesystem already has ${path}"))
         (_
          (def s (match (Tuple mode (fake-bytes-at fs path))
                   ((Tuple Append (Some bytes)) (let ((m (fake-memory-stream bytes)))
                                                 (stream-position! (cast Stream m) (.-Length m))
                                                 m))
                   (_ (MemoryStream.))))
          (fake-update! fs (map-set (fake-entries fs) path (FakeWritten s)))
          (fake-stamp! fs path)
          (Ok (cast Stream s))))))))

(: fake-fs-info (-> FakeFs (-> string (Option FsInfo))))
(defun (fake-fs-info fs)
  (fun (raw) (fake-info fs (fake-path raw))))

;; Whole paths, as `Directory.GetFileSystemEntries` gives them, sorted.
(: fake-fs-list (-> FakeFs (-> string (Result Exception (Vec string)))))
(defun (fake-fs-list fs)
  (fun (raw)
    (def path (fake-path raw))
    (def prefix (fake-prefix path))
    (if (not (fake-dir? fs path))
        (no-directory path)
        (let ((children (map-fold (fun (k v found)
                                    (if (and (string-starts-with? k prefix) (not (= k path)))
                                        (let* ((rest (clr-substring-from k (string-length prefix)))
                                               (at (clr-index-of rest "/")))
                                          (map-set found (str prefix (if (< at 0) rest (clr-substring rest 0 at))) #t))
                                        found))
                                  (map-empty)
                                  (fake-entries fs))))
          (Ok (list->vec (list-sort (loop (:for child (map-keys children))
                                          (:acc (listing child))))))))))

;; Every missing directory along the path, as `Directory.CreateDirectory`.
(: fake-fs-create-directory (-> FakeFs (-> string (Result Exception Unit))))
(defun (fake-fs-create-directory fs)
  (fun (raw)
    (def path (fake-path raw))
    (match (fake-kind fs path)
      ((Some FsFile) (io-error #"the fake filesystem has a file at ${path}"))
      ((Some FsDirectory) (Ok unit))
      (None (fake-update! fs (map-set (fake-with-ancestors (fake-entries fs) path) path FakeDir))
            (fake-stamp! fs path)
            (Ok unit)))))

;; A missing file is not an error, as with `File.Delete`.
(: fake-fs-delete-file (-> FakeFs (-> string (Result Exception Unit))))
(defun (fake-fs-delete-file fs)
  (fun (raw)
    (def path (fake-path raw))
    (match (fake-kind fs path)
      ((Some FsDirectory) (access-denied path))
      ((Some FsFile) (fake-update! fs (map-remove (fake-entries fs) path))
                     (fake-forget-time! fs path)
                     (Ok unit))
      (None (Ok unit)))))

(: fake-fs-delete-directory (-> FakeFs (-> string (Result Exception Unit))))
(defun (fake-fs-delete-directory fs)
  (fun (raw)
    (def path (fake-path raw))
    (def prefix (fake-prefix path))
    (match (fake-kind fs path)
      ((Some FsFile) (io-error #"the fake filesystem has a file, not a directory, at ${path}"))
      (None (no-directory path))
      ((Some FsDirectory)
       (cond
         ((string-empty? path) (io-error "the fake filesystem's root cannot be deleted"))
         ((map-any? (fun (k v) (string-starts-with? k prefix)) (fake-entries fs))
          (io-error #"the fake directory ${path} is not empty"))
         (else (fake-update! fs (map-remove (fake-entries fs) path))
               (fake-forget-time! fs path)
               (Ok unit)))))))

;; `m` with `from`, and everything below it, renamed to `to`. Generic, because
;; the entries and their times move by the same renaming.
(: fake-renamed (-> (Map string %v) string string (Map string %v)))
(defun (fake-renamed m from to)
  (def from-prefix (fake-prefix from))
  (map-fold (fun (k v acc)
              (cond
                ((= k from) (map-set acc to v))
                ((string-starts-with? k from-prefix)
                 (map-set acc (str to "/" (clr-substring-from k (string-length from-prefix))) v))
                (else (map-set acc k v))))
            (map-empty)
            m))

;; A file, or a directory and everything below it. Fails if `to` exists,
;; unless `MoveReplace` asks to replace a file there with a file. The source is
;; checked first, as `File.Move` does.
(: fake-fs-move (-> FakeFs (-> string string MoveMode (Result Exception Unit))))
(defun (fake-fs-move fs)
  (fun (raw-from raw-to mode)
    (def from (fake-path raw-from))
    (def to (fake-path raw-to))
    (def from-kind (fake-kind fs from))
    (def to-kind (fake-kind fs to))
    (def replacing (match (Tuple mode from-kind to-kind)
                     ((Tuple MoveReplace (Some FsFile) (Some FsFile)) #t)
                     (_ #f)))
    (cond
      ((none? from-kind) (not-found from))
      ((and (some? to-kind) (not replacing)) (io-error #"the fake filesystem already has ${to}"))
      ((not (fake-dir? fs (fake-parent to))) (no-directory to))
      (else
       (when replacing
         (fake-update! fs (map-remove (fake-entries fs) to))
         (fake-forget-time! fs to))
       (fake-update! fs (fake-renamed (fake-entries fs) from to))
       (record-set! fs (modified (fake-renamed (record-ref fs modified) from to)))
       (Ok unit)))))

;; What was written to `path`, or `None` if nothing was. A seeded file nobody
;; wrote is `None`.
(: fake-fs-written (-> FakeFs string (Option string)))
(defun (fake-fs-written fs path)
  (match (map-try-ref (fake-entries fs) (fake-path path))
    ((Some (FakeWritten s)) (Some (fake-bytes->text (.ToArray s))))
    (_ None)))

;; --- The forms -----------------------------------------------------------------
;;
;; The operation names go through `inject`, so they arrive at `with-handler`
;; unrenamed. `with-handler` derives the cell it binds from the name it is
;; given, and a renamed `open-read-stream` would derive a cell nothing
;; declares. Any macro that writes a `with-handler` has to do this.

(: fake-op (-> (-> Symbol Syntax) string Syntax))
(defun (fake-op inject name) (inject (string->symbol name)))

;; `(with-fake-fs-of fs body ...)`: install `fs` for the body.
(def/macro (with-fake-fs-of form inject compare)
  (syntax-match form
    ((_ fs first body ...)
     #'(let ((the-fs ,fs))
         (with-handler ((,(fake-op inject "open-read-stream") (fake-fs-reader the-fs))
                        (,(fake-op inject "open-write-stream") (fake-fs-writer the-fs))
                        (,(fake-op inject "fs-info") (fake-fs-info the-fs))
                        (,(fake-op inject "fs-list") (fake-fs-list the-fs))
                        (,(fake-op inject "fs-create-directory") (fake-fs-create-directory the-fs))
                        (,(fake-op inject "fs-delete-file") (fake-fs-delete-file the-fs))
                        (,(fake-op inject "fs-delete-directory") (fake-fs-delete-directory the-fs))
                        (,(fake-op inject "fs-move") (fake-fs-move the-fs)))
           ,first ,@body)))
    (bad (syntax-error bad "with-fake-fs-of takes a FakeFs and a body: (with-fake-fs-of fs body ...)"))))

;; `(with-fake-fs ((path contents) ...) body ...)`: a fresh one, seeded.
(def/macro (with-fake-fs form inject compare)
  (syntax-match form
    ((_ ((path text) ...) first body ...)
     #'(with-fake-fs-of (fake-fs (list ,@{listing #'(Tuple ,p ,t) (:for p path) (:for t text)}))
         ,first ,@body))
    (bad (syntax-error bad "with-fake-fs takes a list of (path contents) pairs and a body: (with-fake-fs ((\"a.txt\" \"hello\")) body ...)"))))
