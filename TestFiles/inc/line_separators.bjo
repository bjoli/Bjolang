;; Strings that hold the characters C# takes as line ends, carried across a
;; module boundary by a function and by a macro's expansion.
(export sep-macro sep-fun)
(import (std syntax-match))

(def/macro (sep-macro form inject compare)
  (syntax-match form
    ((_) #'"a  b")))

(: (-> string))
(defun (sep-fun) "a  b")
