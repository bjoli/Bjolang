;; `:until` takes exactly one test.

;; EXPECT-ERROR: Invalid (:until ...)
;; EXPECT-ERROR: Expected: (:until test)

(import (std prelude))

(: f (-> (List int) int))
(defun (f xs)
  (loop (:for x xs)
        (:until (> x 1) (> x 2))
        (:acc s (summing x))))

(defun (main) (println (int->string (f '(1 2 3)))) 0)
