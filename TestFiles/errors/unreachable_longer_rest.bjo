;; A rest pattern of binders covers every vec at least as long as its prefix,
;; so a longer one of binders below it is dead. The open length class begins
;; at the longest prefix written, and this is still found there.

;; EXPECT-ERROR: this clause can never run
;; EXPECT-ERROR: at unreachable_longer_rest.bjo:14:6

(import (std prelude))

(: (-> (Vec string) int))
(defun (count-args v)
  (match v
    ([a rest ...] 1)
    ([x y rest ...] 2)
    (_ 3)))

(defun (main args)
  (println (count-args ["q"]))
  0)
