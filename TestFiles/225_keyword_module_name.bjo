;; A module named after a C# keyword — `lock.bjo` — declaring a type and
;; implementing a trait for it. Both the type and the impl class carry the
;; module's name.

(import (std prelude))
(import "lock.bjo")
(import (std simpletest))

(defun (main)
  (expect "a type from a module named after a C# keyword" (held-value (held 7)) 7)
  (expect "and a trait implemented for it" (->str (held 7)) "held 7")
  0)
