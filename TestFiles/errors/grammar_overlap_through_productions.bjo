;; Two alternatives hold grammars that both start with the keyword list
;; `(id ...)`. The literal `'(id 1)` could be either one. The compiler refuses
;; the grammar where it is declared. It does not select by the order of
;; declaration.
;; EXPECT-ERROR: can both start with (id ...)
(import (std prelude))

(def/grammar A (:or (: AId (id int)) (: AName (name string))))
(def/grammar B (:or (: BId (id int)) (: BAge (age int))))
(def/grammar Both (:or (: FromA A) (: FromB B)))

(defun (main args) 0)
