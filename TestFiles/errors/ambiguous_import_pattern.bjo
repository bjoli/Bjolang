;; EXPECT-ERROR: Ambiguous name at ambiguous_import_pattern.bjo:13: 'Pt' is imported from same_a and same_b
;; EXPECT-ERROR: (prefix-types ...)
;;
;; A constructor in a pattern is a use too. `make-pt` is `same_a`'s alone, but
;; `Pt` is a case of `same_a`'s `Figure` and of `same_b`'s.

(import (std prelude))
(import "../inc/same_a.bjo")
(import "../inc/same_b.bjo")

(defun (main)
  (match (make-pt 3)
    ((Pt n) n)))
