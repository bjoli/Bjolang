;; The table of HTML's named character references for (text markdown), from
;; WHATWG's entities.json.
;;
;; - Only the names that end in ";" are kept. CommonMark reads an entity
;;   only with its semicolon.
;; - The names are sorted, and each value is written with \u{...} escapes,
;;   so the file is ASCII.
;;
;; Writes:
;;   lib/text/markdown-entities.protobjo

(export entity-table-file)

(import (std prelude))
(import (text json))

;; The value of an entity: its code points, as escapes.
(: (-> Json string))
(defun (entity-value fields)
  (match fields
    ((JsonObj m)
     (match (map-try-ref m "codepoints")
       ((Some (JsonArr points))
        (string-join {vecing (match p
                               ((JsonInt n) (str "\\u{" (long->string n #:radix 16 #:upper #t) "}"))
                               (_ (panic! "markdown-entities: a code point that is not an integer")))
                             (:for p (iarray->vec points))}
                     ""))
       (_ (panic! "markdown-entities: an entity with no codepoints"))))
    (_ (panic! "markdown-entities: an entity that is not an object"))))

;; Writes lib/text/markdown-entities.protobjo from the entities.json at
;; `file`.
(: (-> string void))
(defun (entity-table-file file)
  (def table
    (match (parse-json (raise-err (file-read-text file)))
      ((Ok (JsonObj m)) m)
      ((Ok _) (panic! #"markdown-entities: ${file} is not a JSON object"))
      ((Err why) (panic! #"markdown-entities: ${file}: ${why}"))))
  (def names
    (vec-sort {vecing (string-drop-right (string-drop name 1) 1)
                      (:for name (map-keys table))
                      (:when (string-ends-with? name ";"))}))
  (def rows
    {vecing #"   (Tuple \"${name}\" \"${(entity-value (map-ref table (str "&" name ";")))}\")"
            (:for name names)})
  (raise-err (file-write-text "lib/text/markdown-entities.protobjo"
                   (str ";; Generated by tools/markdown/entities.bjo from WHATWG's entities.json,\n"
                        ";; https://html.spec.whatwg.org/entities.json. Do not edit; run\n"
                        ";; bjo task markdown-data instead.\n"
                        "\n"
                        ";; HTML's named character references that end in \";\": each name, without\n"
                        ";; its & and ;, and its text.\n"
                        "(: entity-table (Vec (Tuple string string)))\n"
                        "(def entity-table\n"
                        "  ["
                        (string-trim-left (string-join rows "\n"))
                        "])\n")))
  (println #"markdown-entities: ${(vec-length names)} entities"))
