;; Docs for std/unicode/grapheme.bjo, read through (:doc #:file "grapheme.bjodoc").
;; The texts are samizdat markup: code in prose is @code{...}.

(:doc #:module
  (summary "Grapheme clusters, the characters a reader sees, by Unicode's rules (UAX #29).")
  (see string-cursor-next-grapheme string-cursor-prev-grapheme string-grapheme-count string->graphemes grapheme-step grapheme-back-pair)
  (example """
    (import (std unicode grapheme))

    (string->graphemes "é🇸🇪\r\n")    ; ["é" "🇸🇪" "\r\n"]: 6 characters, 3 clusters
    (string-grapheme-count "👨‍👩‍👧")       ; 1
    (def c (string-cursor-next-grapheme s (string-cursor-start s)))   ; past the first cluster
    (string-cursor-prev-grapheme s (string-cursor-end s))             ; the start of the last
    """)
  (reference """
    A grapheme cluster is what a reader takes for one character: a letter
    and its accents, a flag of two regional indicators, an emoji sequence
    joined by ZWJs, a Hangul syllable of jamo, CR LF. An editor moves its
    cursor and deletes by clusters. These are the extended grapheme clusters
    of UAX #29, for the Unicode version @code{grapheme-unicode-version}
    gives.

    @strong{Cursors on boundaries.} The cursor functions take a cursor on a
    cluster boundary: the start, the end, or one a grapheme function
    returned. From a cursor that is not on one, they treat it as a boundary.
    @code{string-cursor-grapheme-boundary?} tells which a cursor is.

    @strong{Cost.} A cluster has no limit on its length: a letter can carry
    any number of marks. A step forward reads each character of the cluster
    once. A step back also reads, for the three rules that look back (Indic
    conjuncts, emoji ZWJ sequences and flags), the run of characters the
    rule looks back over. A run of regional indicators is counted once:
    from a boundary before one, the parity is known. A loop over a text, in
    either direction, takes O(n) time, so long runs cannot make it quadratic.

    @strong{The state machines.} The rules are two state machines over
    characters, which know nothing of the container, and a front end drives
    them with its own cursors. This module is the front end for strings;
    @code{(std text)} has the one for texts. A new container needs a few
    lines: see @code{grapheme-step} and @code{grapheme-back-pair}.

    @strong{The table.} The properties are a table of two stages,
    generated by @code{tools/unicode/grapheme.bjo} from the Unicode
    Character Database into @code{grapheme-table.protobjo}, and checked
    against every case of
    @code{GraphemeBreakTest.txt}.
    """))

(:doc grapheme-unicode-version
  (summary "The version of Unicode the rules and the table are of.")
  (see grapheme-step))

(:doc grapheme-plain-break?
  (summary "Whether the rules put a boundary between two code points with no context.")
  (arg a "The code point before.")
  (arg b "The code point after.")
  (returns "#t when both are printable ASCII: a front end can test bytes with it and skip the state machines.")
  (see grapheme-step grapheme-back-pair))

;; ---------------------------------------------------------------------------
;; Forward
;; ---------------------------------------------------------------------------

(:doc grapheme-start
  (summary "The forward state after the first character of a cluster.")
  (arg ch "The character after a cluster boundary.")
  (returns "A state, an int, to give to grapheme-step with the next character.")
  (see grapheme-step grapheme-break?))

(:doc grapheme-step
  (summary "The forward state after one more character.")
  (arg st "The state after the character before ch.")
  (arg ch "The next character.")
  (returns "The state after ch: grapheme-break? says whether a boundary falls before ch.")
  (see grapheme-start grapheme-break? grapheme-back-pair)
  (example """
    ;; The cursor after the cluster that starts at c.
    (def (Tuple ch0 c1) (string-cursor-ref+next s c))
    (let go ((st (grapheme-start ch0)) (c c1))
      (if (string-cursor-end? s c)
          c
          (begin
            (def (Tuple ch nxt) (string-cursor-ref+next s c))
            (def st2 (grapheme-step st ch))
            (if (grapheme-break? st2) c (go st2 nxt)))))
    """)
  (reference """
    The state holds what the rules need of the text before: the last
    character's properties, and whether it ends in an emoji and a ZWJ, a
    Linker, or an odd number of regional indicators. Nothing is allocated.
    """))

(:doc grapheme-break?
  (summary "Whether a forward state has a boundary before its last character.")
  (arg st "A state from grapheme-step, or from grapheme-start, which has one.")
  (returns "#t when a cluster ends before the character the state was last given.")
  (see grapheme-step))

;; ---------------------------------------------------------------------------
;; Backward
;; ---------------------------------------------------------------------------

(:doc grapheme-back-start
  (summary "The backward state when nothing is known of what follows the cursor.")
  (returns "A state for the first grapheme-back-pair: at the end of a text, or for a cursor that may not be on a boundary.")
  (see grapheme-back-start-before grapheme-back-pair))

(:doc grapheme-back-needs-after?
  (summary "Whether the backward state needs the character after a boundary cursor.")
  (arg b "The character before the cursor.")
  (returns "#t when b is a regional indicator: only then does grapheme-back-start-before know more than grapheme-back-start.")
  (see grapheme-back-start-before))

(:doc grapheme-back-start-before
  (summary "The backward state of a cursor on a cluster boundary, from the character after it.")
  (arg ch "The character after the cursor.")
  (returns "A state for the first grapheme-back-pair.")
  (see grapheme-back-needs-after? grapheme-back-start)
  (reference """
    A boundary before a regional indicator has an even number of them
    before it. The state keeps that, so a loop back through a run of them
    does not count the run again for each flag.
    """))

(:doc grapheme-back-pair
  (summary "The backward state for the boundary between two characters.")
  (arg w "The state from the pair after this one, or from grapheme-back-start or -start-before.")
  (arg a "The character before the boundary.")
  (arg b "The character after it: the a of the pair given before, or the character before the cursor.")
  (returns "A state that is known, for grapheme-back-break?, or that grapheme-back-wants? the characters before a.")
  (see grapheme-back-wants? grapheme-back-more grapheme-back-break?)
  (example """
    ;; The start of the cluster that ends at c, a boundary of s.
    (def start (string-cursor-start s))
    (def c1 (string-cursor-prev s c))
    (def b1 (string-cursor-ref s c1))
    (def w0 (if (and (grapheme-back-needs-after? b1) (not (string-cursor-end? s c)))
                (grapheme-back-start-before (string-cursor-ref s c))
                (grapheme-back-start)))
    (let go ((w w0) (bc c1) (b b1))
      (if (string-cursor=? bc start)
          bc
          (begin
            (def ac (string-cursor-prev s bc))
            (def a (string-cursor-ref s ac))
            ;; Give the characters before a while the state wants them.
            (def w2 (let more ((w (grapheme-back-pair w a b)) (k ac))
                      (cond ((not (grapheme-back-wants? w)) w)
                            ((string-cursor=? k start) (grapheme-back-sot w))
                            (else (let ((k2 (string-cursor-prev s k)))
                                    (more (grapheme-back-more w (string-cursor-ref s k2)) k2))))))
            (if (grapheme-back-break? w2) bc (go w2 ac a)))))
    """)
  (reference """
    Most pairs are decided by the two characters. Three rules need the
    characters before @code{a}: GB9c (a Linker before Extend characters and
    a Consonant), GB11 (a pictograph before Extend characters, a ZWJ and a
    pictograph) and GB12/13 (how many regional indicators come before). Each
    reads back over one run of characters of one kind, and stops at the
    first that is not.
    """))

(:doc grapheme-back-wants?
  (summary "Whether a backward state needs the character before the last one given.")
  (arg w "A state from grapheme-back-pair or grapheme-back-more.")
  (returns "#t until the state is known.")
  (see grapheme-back-more grapheme-back-sot))

(:doc grapheme-back-more
  (summary "The backward state after the character before the last one given.")
  (arg w "A state that grapheme-back-wants? the character for.")
  (arg ch "The character before the last one given.")
  (returns "The state, known or still wanting the character before ch.")
  (see grapheme-back-wants? grapheme-back-sot))

(:doc grapheme-back-sot
  (summary "The backward state when there is no character before the last one given.")
  (arg w "A state that grapheme-back-wants? a character for.")
  (returns "The known state at the start of the text.")
  (see grapheme-back-more))

(:doc grapheme-back-break?
  (summary "Whether a known backward state is a boundary.")
  (arg w "A state that does not want more characters.")
  (returns "#t when a cluster boundary falls between the pair the state was given.")
  (see grapheme-back-pair))

;; ---------------------------------------------------------------------------
;; Strings
;; ---------------------------------------------------------------------------

(:doc string-cursor-next-grapheme
  (summary "The cursor after the grapheme cluster that starts at a cursor.")
  (arg s "The string.")
  (arg c "A cursor of s on a cluster boundary, not at the end.")
  (returns "The cursor at the end of the cluster that starts at c, which is the next boundary.")
  (raises System.ArgumentOutOfRangeException "When c is at the end of s.")
  (see string-cursor-prev-grapheme string-cursor-next))

(:doc string-cursor-prev-grapheme
  (summary "The cursor at the start of the grapheme cluster that ends at a cursor.")
  (arg s "The string.")
  (arg c "A cursor of s on a cluster boundary, not at the start.")
  (returns "The cursor at the start of the cluster before c, which is the boundary before.")
  (raises System.ArgumentOutOfRangeException "When c is at the start of s.")
  (see string-cursor-next-grapheme string-cursor-prev))

(:doc string-cursor-grapheme-boundary?
  (summary "Whether a cursor is on a grapheme cluster boundary.")
  (arg s "The string.")
  (arg c "A cursor of s.")
  (returns "#t at the start, at the end, and between two clusters.")
  (see string-cursor-next-grapheme)
  (reference """
    Looks back as far as the rules need, with nothing known of what follows:
    in a run of regional indicators, that is the whole run.
    """))

(:doc string-grapheme-count
  (summary "The number of grapheme clusters in a string.")
  (arg s "The string.")
  (returns "How many clusters s holds: 0 for the empty string.")
  (see string->graphemes string-count))

(:doc string->graphemes
  (summary "The grapheme clusters of a string.")
  (arg s "The string.")
  (returns "A vec of the clusters of s, in order, each a string.")
  (see string-grapheme-count string-cursor-next-grapheme))
