;; Docs for std/mutable/deque.bjo, read through (:doc #:file "deque.bjodoc").
;; The texts are samizdat markup: code in prose is @code{...}.

(:doc #:module
  (summary "Double-ended mutable queue supporting O(1) amortized push and pop operations at both ends.")
  (see Deque deque deque-push-back! deque-pop-front!)
  (example """
    (import (std mutable deque))

    ;; Worklist pattern: workers push items, main loop pops items.
    (def work (deque))
    (deque-push-back! work 1)
    (deque-push-back! work 2)
    (deque-push-front! work 0)
    (deque-pop-front! work)    ; (Some 0)
    (deque-pop-back! work)     ; (Some 2)
    (deque->list work)         ; (1)
    """)
  (reference """
    @code{(Deque a)} is a mutable double-ended queue. Operations such as
    @code{deque-push-back!} modify the queue in place and return unit. It is
    well-suited as a worklist in algorithms where new elements are continuously
    queued and dequeued without requiring persistent snapshots. If persistent
    history is required, use @code{List} or @code{Vec}.

    @strong{Internal representation.} The deque is implemented with two
    internal singly-linked lists: @code{front} (storing items in front-to-back
    order) and @code{back} (storing rear items in reverse order). Pushing at
    either end prepends to the corresponding list in O(1). Popping removes the
    head element. When one side is exhausted, half of the other side is
    transferred and reversed. Rebalancing by half guarantees O(1) amortized bounds
    across alternating operations at opposite ends. @code{deque-length} tracks
    element count in O(1).

    @strong{Rebalancing during peek.} Calling @code{deque-peek-front!} or
    @code{deque-peek-back!} may rebalance elements between the internal lists
    when one side is empty. Although logical content remains unchanged, internal
    pointers are updated, hence the @code{!} naming convention.

    @strong{Traversals.} @code{deque->list}, @code{deque-fold},
    @code{deque-for-each}, and @code{displayed} traverse the elements from
    front to back without altering internal storage.

    @strong{Empty queue behavior.} Popping or peeking from an empty deque returns
    @code{None} without raising exceptions.

    @strong{Equality and hashing.} Two deques are @code{=} if they contain
    equal elements in identical logical order. Because deques are mutable,
    @code{eq-hash} raises an exception to prevent using deques as hash table keys.

    @strong{Thread safety.} Deques are not thread-safe and must not be accessed
    concurrently without synchronization.
    """))

;; ---------------------------------------------------------------------------
;; The deque
;; ---------------------------------------------------------------------------

(:doc Deque
  (summary "Mutable double-ended queue holding elements of type %a.")
  (tparam %a "The element type.")
  (see deque list->deque)
  (reference """
    Opaque record type. Access and modify deques through the functions in this
    module.
    """))

(:doc deque
  (summary "Creates an empty mutable deque.")
  (returns "A new deque containing no elements.")
  (see list->deque))

(:doc deque-length
  (summary "Returns the number of elements in the deque in O(1) time.")
  (arg d "The deque.")
  (returns "The element count.")
  (see deque-empty?))

(:doc deque-empty?
  (summary "Tests if the deque contains no elements.")
  (arg d "The deque.")
  (returns "#t if empty, otherwise #f.")
  (see deque-length))

(:doc deque-clear!
  (summary "Removes all elements from the deque.")
  (arg d "The deque to clear."))

;; ---------------------------------------------------------------------------
;; The ends
;; ---------------------------------------------------------------------------

(:doc deque-push-front!
  (summary "Prepends an element to the front of the deque.")
  (arg d "The deque to modify.")
  (arg x "The element to prepend.")
  (see deque-push-back! deque-pop-front!))

(:doc deque-push-back!
  (summary "Appends an element to the back of the deque.")
  (arg d "The deque to modify.")
  (arg x "The element to append.")
  (see deque-push-front! deque-pop-back!))

(:doc deque-pop-front!
  (summary "Removes and returns the front element, or None if empty.")
  (arg d "The deque to modify.")
  (returns "(Some x) containing the front element, or None if empty.")
  (see deque-pop-back! deque-peek-front!)
  (example """
    (let loop ()
      (match (deque-pop-front! work)
        (None unit)
        ((Some job) (run job) (loop))))
    """)
  (reference """
    Runs in O(1) amortized time. When the front list is empty, half of the back
    list is reversed and moved to the front.
    """))

(:doc deque-pop-back!
  (summary "Removes and returns the back element, or None if empty.")
  (arg d "The deque to modify.")
  (returns "(Some x) containing the back element, or None if empty.")
  (see deque-pop-front! deque-peek-back!)
  (reference """
    Runs in O(1) amortized time. When the back list is empty, half of the front
    list is reversed and moved to the back.
    """))

(:doc deque-peek-front!
  (summary "Returns the front element without removing it, or None if empty.")
  (arg d "The deque. Contents are preserved, but internal storage may be rebalanced.")
  (returns "(Some x) containing the front element, or None if empty.")
  (see deque-pop-front! deque-peek-back!)
  (reference """
    When the front list is empty, half of the back list is transferred to the
    front as in @code{deque-pop-front!}. Because internal references are modified,
    the function is named with a trailing @code{!}.
    """))

(:doc deque-peek-back!
  (summary "Returns the back element without removing it, or None if empty.")
  (arg d "The deque. Contents are preserved, but internal storage may be rebalanced.")
  (returns "(Some x) containing the back element, or None if empty.")
  (see deque-pop-back! deque-peek-front!)
  (reference """
    When the back list is empty, half of the front list is transferred to the
    back as in @code{deque-pop-back!}.
    """))

;; ---------------------------------------------------------------------------
;; Conversions and traversals
;; ---------------------------------------------------------------------------

(:doc list->deque
  (summary "Constructs a new deque from a list in front-to-back order.")
  (arg xs "Source list. The head becomes the front of the deque.")
  (returns "A new mutable deque.")
  (see deque->list deque)
  (reference """
    The list is adopted as the front list directly without copying, since
    Bjolang lists are immutable. Counting elements runs in O(n) time.
    """))

(:doc deque->list
  (summary "Converts the deque to a list from front to back.")
  (arg d "The source deque.")
  (returns "A new list containing the deque elements in logical order.")
  (see list->deque deque-fold))

(:doc deque-fold
  (summary "Folds over the elements of the deque from front to back.")
  (arg f "Accumulator function taking (element, acc) and returning the next accumulator value.")
  (arg init "Initial accumulator value.")
  (arg d "The deque to fold.")
  (returns "The final accumulated result.")
  (see deque-for-each deque->list)
  (example """
    (deque-fold (fun (x sum) (+ x sum)) 0 (list->deque (list 1 2 3)))   ; 6
    """)
  (reference """
    Do not mutate the deque inside callback f.
    """))

(:doc deque-for-each
  (summary "Applies a function to each element from front to back.")
  (arg f "Function to call on each element.")
  (arg d "The deque to iterate over.")
  (see deque-fold)
  (reference """
    Traverses the front list followed by the back list. Do not mutate the
    deque inside callback f.
    """))

;; ---------------------------------------------------------------------------
;; Printing
;; ---------------------------------------------------------------------------

(:doc deque->str
  (summary "Deprecated: use @code{displayed}. Formats the deque as text in the form #<a b c>.")
  (arg d "The deque to format.")
  (returns "Formatted string representation using displayed for each element.")
  (example """
    (displayed (list->deque (list 1 2 3)))   ; "#<1 2 3>"
    """)
  (reference """
    The same text as @code{displayed} gives for a deque. @code{written}
    writes each element as it is written.
    """))
