;; One instantiation of a unit-generic function takes one unit.

;; EXPECT-ERROR: Their units differ

(import (std prelude))

(def/dimension length #:base m)
(def/dimension time #:base s)

(: pick (-> (double %u) (double %u) (double %u)))
(defun (pick a b) a)

(: bad (-> (double m) (double s) (double m)))
(defun (bad a b) (pick a b))

(defun (main) 0)
