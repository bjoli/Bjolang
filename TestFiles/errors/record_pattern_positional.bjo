;; A record pattern takes fields by name, not by position.

;; EXPECT-ERROR: 'Car' is a record type
;; EXPECT-ERROR: written (field-name pattern)

(import (std prelude))

(type (: Car (Record (: brand string) (: year int))))

(: f (-> Car string))
(defun (f c)
  (match c
    ((Car b y) b)))

(defun (main args)
  (println (f (Car (brand "a") (year 1))))
  0)
