(import (std prelude))

;; A trait is a function that can be defined for different datatypes.
;; Take the Gettable trait:

(def/trait (Gettable %a)
  ;; The type of the position argument
  (type %pos)
  ;; The item type it returns
  (type %item)
  (: item-at (-> %a %pos %item)))

(impl (Gettable (Vec %a))
  ;; For a Vec the position is always int
  (type %pos int)
  ;; The item is %a, the same %a as in (Vec %a) above
  (type %item %a)
  (defun (item-at v i)
    (vec-ref v i)))

;; Where the types are known, the trait is inlined. That is why it is a good
;; thing to keep the trait body short:
;;
;;   (item-at myvec 2)
;;   ;; inlines to
;;   (vec-ref myvec 2)
;;   ;; which returns 3
(: myvec (Vec int))
(def myvec [1 2 3 4 5])

;; Inlining does not matter above, but for some traits it does. Take the map
;; trait (or the functor trait, for you wonks). We want to say that map takes
;; a collection and returns a different collection. For that we borrow the
;; syntax of higher-kinded types:
(def/trait (Mappable (%f %a))
  (: map-all (-> (-> %a %b) (%f %a) (%f %b))))

(impl (Mappable (List %a))
  (defun (map-all fun lst) (list-map fun lst)))

;; Mappable is a function on a collection (%f %a). It takes a function
;; (-> %a %b) and returns (%f %b). That is fine. But what happens when we try
;; to map it to a C# interface?
;;
;;   public interface IFunctor<F>
;;   {
;;       // F<A> and F<B> are invalid, because F is treated as a concrete
;;       // type instead of a generic type constructor
;;       F<B> Map<A,B>(F<A> source, Func<A, B> func);
;;   }
;;
;; Even with C# 11 it breaks, because you cannot say F<B>: F<B> and F<A> are
;; distinct types. Bjolang compiles to C#, and traits compile to interfaces,
;; so this cannot be expressed.
;;
;; Here is where inlining comes in. Inlining the trait body makes the call a
;; regular function call. The cost is that you cannot use map-all where the
;; collection type is generic, whatever the constraints, because the compiler
;; does not know what to inline. This does not compile:
;;
;;   (: do-it (-> %a %a))
;;   (defun (do-it something)
;;     (map-all #(+ & 1) something))
;;
;; A trait like Foldable can however be an interface, and it can be used
;; where the type is generic, at the cost of a dynamic dispatch:
(def/trait (Foldable %col)
  (type %item)
  (: fold-all (-> (-> %item %acc %acc) %acc %col %acc)))

(impl (Foldable (List %a))
  (type %item %a)
  (defun (fold-all f acc col)
    (list-foldl f acc col)))

(defun (main args)
  (println (item-at myvec 2))
  (println (map-all #(+ & 1) (list 1 2 3)))
  (println (fold-all + 0 (list 1 2 3)))
  0)
