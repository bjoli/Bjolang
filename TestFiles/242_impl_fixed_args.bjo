;; An impl for a type whose arguments are fixed, `(Array byte)`, is a class
;; with no type parameters, and its dictionary is spelled that way — also when
;; it is handed to another module's constrained function, and inside a
;; conditional impl's.

(import (std prelude))
(import (std simpletest))
(import "inc/fixed_args.bjo")

(defun (main)
  (expect "directly" (size #[1uy 2uy]) 2)
  (expect "to another module's constrained function" (total #[1uy] #[1uy 2uy 3uy]) 4)
  (expect "inside a conditional impl" (total (Some #[1uy 2uy]) None) 2)
  0)
