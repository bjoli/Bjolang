;; Docs for std/stopwatch.bjo, read through (:doc #:file "stopwatch.bjodoc").
;; The texts are samizdat markup: code in prose is @code{...}.

(:doc #:module
  (summary "Stopwatches reading ambient monotonic time, and time-it benchmarking utility.")
  (see Stopwatch stopwatch time-it)
  (example """
    (import (std stopwatch))

    (def sw (stopwatch))
    (stopwatch-start! sw)
    (do-the-work)
    (stopwatch-stop! sw)
    (stopwatch-ms sw)          ; elapsed milliseconds, as a long
    (ref sw 's)                ; elapsed time in whole seconds

    (time-it #:times 10 (do-the-work))
    """)
  (reference """
    A stopwatch reads monotonic time from the prelude's @code{monotonic-ms},
    which queries @code{current-clock}. It does not wrap
    @code{System.Diagnostics.Stopwatch}. This allows tests to bind a deterministic
    virtual clock and produce predictable timings:

    @codeblock[#:lang "bjolang"]|{
    (parameterize ((current-clock (make-clock #:monotonic-ms (fun () 0L))))
      (time-the-thing))   ; every stopwatch inside reads 0
    }|

    Stopwatches are mutable structures. They can be started and stopped
    repeatedly, accumulating elapsed runtime across active periods with
    millisecond resolution.

    Stopwatches implement @code{Refable} using symbol units: @code{(ref sw 'ms)}
    returns elapsed time in milliseconds, and @code{(ref sw 's)} returns elapsed
    time in integer seconds (rounded down). Any other symbol raises
    @code{System.ArgumentException}.
    """))

;; ---------------------------------------------------------------------------
;; Stopwatches
;; ---------------------------------------------------------------------------

(:doc Stopwatch
  (summary "Stopwatch structure tracking total elapsed time and active run state.")
  (field started "Timestamp of the current active run, or -1 if stopped.")
  (field elapsed "Accumulated milliseconds across completed runs.")
  (see stopwatch stopwatch-start! stopwatch-ms)
  (reference """
    Both fields are mutable to support in-place updates. Use this module's API
    rather than @code{record-set!} directly.

    @code{(ref sw 'ms)} and @code{(ref sw 's)} read elapsed time in milliseconds
    or whole seconds. Any other symbol raises @code{System.ArgumentException}.
    """))

(:doc stopwatch
  (summary "Creates a new stopped stopwatch initialized to zero.")
  (returns "A stopped stopwatch with 0 ms elapsed.")
  (see stopwatch-start!))

(:doc stopwatch-start!
  (summary "Starts or resumes a stopwatch.")
  (arg sw "The stopwatch.")
  (see stopwatch-stop! stopwatch-ms)
  (reference """
    Starting an already-running stopwatch has no effect.
    """))

(:doc stopwatch-stop!
  (summary "Stops a stopwatch and accumulates the current run duration.")
  (arg sw "The stopwatch. Stopping an already-stopped stopwatch has no effect.")
  (see stopwatch-start! stopwatch-ms))

(:doc stopwatch-ms
  (summary "Returns total elapsed milliseconds for a stopwatch.")
  (arg sw "The stopwatch.")
  (returns "Total elapsed time across completed runs, plus the active run if currently running.")
  (see stopwatch-stop!)
  (reference """
    Can be called on running stopwatches without interrupting timing.
    """))

(:doc get-memory-usage
  (summary "Returns bytes allocated on the current thread since creation.")
  (returns "A monotonically increasing long. Subtract consecutive readings to measure allocations.")
  (see time-it)
  (reference """
    Delegates to @code{System.GC.GetAllocatedBytesForCurrentThread}. Measures
    allocations on the calling thread only; allocations on other threads or fibers
    are not included.
    """))

;; ---------------------------------------------------------------------------
;; time-it
;; ---------------------------------------------------------------------------

(:doc time-it
  (summary "Executes a body repeatedly and reports average elapsed time and thread allocations.")
  (form (time-it body ...))
  (form (time-it #:times n body ...))
  (arg n "Number of timed iterations. Defaults to 1.")
  (rest body "Expression(s) to benchmark. Evaluated for side effects; return value is discarded.")
  (see stopwatch get-memory-usage)
  (example """
    (time-it #:times 100 (list-sort big-list))
    ;; prints: Mean of 100 runs: 3ms. 120000B allocated per run.
    """)
  (reference """
    Executes one untimed warmup iteration prior to timed runs (total iterations:
    n + 1). During warmup, @code{current-output-port} is redirected to a string
    port to suppress console output, though other side effects still occur.

    Timings derive from @code{current-clock} with millisecond resolution. Averages
    use integer division, so bodies completing in under 1 ms report 0 ms. Memory
    allocation measurements derive from @code{get-memory-usage} on the executing
    thread. Operations that suspend and resume across different thread pool
    threads will report inaccurate allocation values.

    Returns unit.
    """))
