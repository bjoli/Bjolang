;; Docs for std/stopwatch.bjo, read through (:doc #:file "stopwatch.bjodoc").
;; The texts are samizdat markup: code in prose is @code{...}.

(:doc #:module
  (summary "Stopwatches reading ambient monotonic time, and time-it benchmarking utility.")
  (see Stopwatch stopwatch time-it)
  (example """
    (import (std stopwatch))

    (def sw (stopwatch))
    (stopwatch-start! sw)
    (do-the-work)
    (stopwatch-stop! sw)
    (stopwatch-ms sw)          ; elapsed milliseconds, as a long
    (stopwatch-ns sw)          ; elapsed nanoseconds
    (ref sw 's)                ; elapsed time in whole seconds
    (ns->string (stopwatch-ns sw))   ; e.g. "12.5 us"

    (time-it #:times 10 (do-the-work))
    """)
  (reference """
    A stopwatch reads monotonic time from the prelude's @code{monotonic-ns},
    which queries @code{current-clock}. It does not wrap
    @code{System.Diagnostics.Stopwatch}. This allows tests to bind a deterministic
    virtual clock and produce predictable timings:

    @codeblock[#:lang "bjolang"]|{
    (parameterize ((current-clock (make-clock #:monotonic-ms (fun () 0L))))
      (time-the-thing))   ; every stopwatch inside reads 0
    }|

    Stopwatches are mutable structures. They can be started and stopped
    repeatedly, accumulating elapsed runtime across active periods in
    nanoseconds, at the resolution the clock has. The other units are read from
    the nanoseconds and rounded down.

    Stopwatches implement @code{Refable} using symbol units: @code{(ref sw 'ns)},
    @code{'us}, @code{'ms} and @code{'s} return elapsed time in that unit,
    rounded down. Any other symbol raises @code{System.ArgumentException}.
    """))

;; ---------------------------------------------------------------------------
;; Stopwatches
;; ---------------------------------------------------------------------------

(:doc Stopwatch
  (summary "Stopwatch structure tracking total elapsed time and active run state.")
  (field started "Timestamp in nanoseconds of the current active run, or -1 if stopped.")
  (field elapsed "Accumulated nanoseconds across completed runs.")
  (see stopwatch stopwatch-start! stopwatch-ns stopwatch-ms)
  (reference """
    Both fields are mutable to support in-place updates. Use this module's API
    rather than @code{record-set!} directly.

    @code{(ref sw 'ns)}, @code{'us}, @code{'ms} and @code{'s} read elapsed time
    in that unit. Any other symbol raises @code{System.ArgumentException}.
    """))

(:doc stopwatch
  (summary "Creates a new stopped stopwatch initialized to zero.")
  (returns "A stopped stopwatch with nothing elapsed.")
  (see stopwatch-start!))

(:doc stopwatch-start!
  (summary "Starts or resumes a stopwatch.")
  (arg sw "The stopwatch.")
  (see stopwatch-stop! stopwatch-ms)
  (reference """
    Starting an already-running stopwatch has no effect.
    """))

(:doc stopwatch-stop!
  (summary "Stops a stopwatch and accumulates the current run duration.")
  (arg sw "The stopwatch. Stopping an already-stopped stopwatch has no effect.")
  (see stopwatch-start! stopwatch-ms))

(:doc stopwatch-ns
  (summary "Returns total elapsed nanoseconds for a stopwatch.")
  (arg sw "The stopwatch.")
  (returns "Total elapsed time across completed runs, plus the active run if currently running.")
  (see stopwatch-stop! stopwatch-us stopwatch-ms ns->string)
  (reference """
    Can be called on running stopwatches without interrupting timing. The
    resolution is the clock's: on @code{system-clock}, that of
    @code{System.Diagnostics.Stopwatch}.
    """))

(:doc stopwatch-us
  (summary "Returns total elapsed microseconds for a stopwatch, rounded down.")
  (arg sw "The stopwatch.")
  (returns "What stopwatch-ns returns, divided by 1000.")
  (see stopwatch-ns))

(:doc stopwatch-ms
  (summary "Returns total elapsed milliseconds for a stopwatch, rounded down.")
  (arg sw "The stopwatch.")
  (returns "Total elapsed time across completed runs, plus the active run if currently running.")
  (see stopwatch-stop! stopwatch-ns)
  (reference """
    Can be called on running stopwatches without interrupting timing.
    """))

(:doc ns->string
  (summary "A duration in nanoseconds as text, in a unit that fits it.")
  (arg ns "The duration, in nanoseconds.")
  (returns "The duration in ns, us, ms or s: the largest unit it is at least 1 of, with one decimal under 100.")
  (see stopwatch-ns time-it)
  (example """
    (ns->string 850L)        ; "850 ns"
    (ns->string 12500L)      ; "12.5 us"
    (ns->string 3210000L)    ; "3.2 ms"
    """))

(:doc get-memory-usage
  (summary "Returns bytes allocated on the current thread since creation.")
  (returns "A monotonically increasing long. Subtract consecutive readings to measure allocations.")
  (see time-it)
  (reference """
    Delegates to @code{System.GC.GetAllocatedBytesForCurrentThread}. Measures
    allocations on the calling thread only; allocations on other threads or fibers
    are not included.
    """))

(:doc time-it
  (summary "Measures a body and prints one line: (std bench)'s time-it, which this module has too.")
  (form (time-it body ...))
  (form (time-it #:times n body ...))
  (form (time-it #:warm-up-rounds w body ...))
  (form (time-it #:times n #:warm-up-rounds w body ...))
  (arg n "With #:times, exactly n timed runs: no calibration.")
  (arg w "With #:warm-up-rounds, exactly w untimed runs first. 0 unless given.")
  (rest body "The forms, run as one call; the value of the last is kept alive.")
  (see stopwatch)
  (example """
    (time-it (list-sort big-list))
    ;; (list-sort big-list): 8.31 ms ± 1.1% (min 8.12 ms), 2.40 MB/call, 120 samples
    """)
  (reference """
    The same macro as @code{(std bench)}'s @code{time-it}, which documents
    it in full: a body measured as a benchmark is, warmed up, calibrated
    and sampled, or run once when its first run takes more than a second.
    It is here so that an @code{(import (std stopwatch))} that used it goes
    on working.
    """))
