;; Docs for std/net.bjo, read through (:doc #:file "net.bjodoc"). The texts
;; are samizdat markup: code in prose is @code{...}.

(:doc #:module
  (summary "TCP networking abstractions exposing bidirectional connections as paired input and output ports.")
  (see tcp-connect tcp-listen accept-evt accept close-listener! peer-address)
  (example """
    (import (std net))
    (import (std ports))

    ;; Client workflow: send request, half-close write half, read response.
    (match (tcp-connect "127.0.0.1" 8080)
      ((Ok (Tuple in out))
       (write-bytes! out request)
       (flush-port out)
       (shutdown! out)              ; Send FIN packet
       (read-some in))              ; Read response payload
      ((Err e) None))
    """)
  (example """
    ;; Server loop: accept connections until the listener closes.
    (: serve (-bjo-> Listener Symbol))
    (defbjo (serve l)
      (let go ()
        (match (sync (choose (wrap (accept-evt l) Some)
                             (wrap (listener-closed l) (fun (_) None))))
          ((Some (Ok conn)) (spawn (handle conn)) (go))
          ((Some (Err e))   (log (str "accept failed: " (.-Message e))) 'failed)
          (None             'stopped))))
    """)
  (reference """
    A TCP connection is represented as a @code{(Tuple InputPort OutputPort)}.
    Rather than exposing raw socket handles, connections integrate directly
    with @code{(std ports)} abstractions. Network protocols can be developed
    generically over ports, enabling unit testing with in-memory
    @code{byte-pipe} instances.

    Connection I/O is managed using @code{(std ports)} and prelude functions,
    including @code{read-some}, @code{read-bytes-evt}, @code{write-bytes!},
    @code{flush-port}, @code{shutdown!}, and @code{limited}.

    @strong{Socket lifecycle.} The underlying network socket is disposed when
    both the input and output ports are closed, or when the owning concurrency
    scope terminates. Closing one port direction does not terminate the
    opposite direction, supporting half-closed communication patterns.

    @strong{Scope management.} Connections created via @code{tcp-connect} or
    @code{stream->ports} are scoped to the ambient concurrency context.
    Connections produced by @code{tcp-listen} and @code{accept} belong to the
    listener's scope. Exiting the scope terminates the listener and forcibly
    closes any active accepted connections.

    @strong{CML Event semantics.} Accepted incoming connections are buffered
    at the listener level. @code{accept-evt} is a composable CML event: if an
    alternative branch in @code{choose} synchronizes first, no connection is
    consumed, leaving it available for subsequent synchronization.

    Nagle's algorithm is disabled by default (@code{NoDelay = true}).
    @code{flush-port} transmits buffered bytes immediately.

    See @code{BjolangRuntime/BjoNet.cs} for implementation details.
    """))

;; ---------------------------------------------------------------------------
;; Connecting
;; ---------------------------------------------------------------------------

(:doc tcp-connect
  (summary "Establishes an outbound TCP connection to a host and port, returning a port pair.")
  (arg host "Host name or IP address string (e.g. \"127.0.0.1\" or \"::1\").")
  (arg port "TCP port number (0–65535).")
  (returns "@code{(Ok (Tuple in out))} on success, or @code{(Err e)} on connection or DNS resolution failure.")
  (raises Bjolang.Runtime.ScopeEnded "When called outside an ambient concurrency scope.")
  (see tcp-listen stream->ports peer-address shutdown!)
  (example """
    (with-deadline 5000
      (tcp-connect "example.com" 80))
    """)
  (reference """
    Hostnames are resolved and IP addresses attempted sequentially until a
    connection succeeds. Connections are owned by the ambient concurrency
    scope and closed upon scope exit if not closed explicitly. Respects
    ambient cancellation tokens and deadlines.
    """))

;; ---------------------------------------------------------------------------
;; A connection somebody else made
;; ---------------------------------------------------------------------------

(:doc stream->ports
  (summary "Wraps a bidirectional .NET Stream into an input and output port pair.")
  (arg s "A bidirectional .NET Stream instance.")
  (key peer "Optional peer address string returned by @code{peer-address} (defaults to empty string).")
  (returns "A tuple containing the input port and output port sharing the stream.")
  (raises Bjolang.Runtime.ScopeEnded "When called outside an ambient concurrency scope.")
  (see tcp-connect peer-address stream->input-port stream->output-port)
  (reference """
    Coordinates disposal across both port halves: the stream is disposed only
    when both the input and output ports are closed, or when the owning scope
    exits.
    """))

;; ---------------------------------------------------------------------------
;; Listening
;; ---------------------------------------------------------------------------

(:doc Listener
  (summary "A TCP listening socket that yields incoming connections via CML events.")
  (see tcp-listen accept-evt accept close-listener! listener-closed))

(:doc tcp-listen
  (summary "Binds and listens for incoming TCP connections on the specified host and port.")
  (arg host "Host name or IP address string to bind.")
  (arg port "TCP port number to bind (0 assigns an ephemeral port).")
  (key backlog "Maximum length of the pending connections queue (defaults to at least 1).")
  (returns "@code{(Ok listener)} on success, or @code{(Err e)} on bind or resolution failure.")
  (raises Bjolang.Runtime.ScopeEnded "When called outside an ambient concurrency scope.")
  (see accept-evt accept listener-port close-listener!)
  (example """
    (match (tcp-listen "127.0.0.1" 0)
      ((Ok l) (log (str "listening on " (int->string (listener-port l)))))
      ((Err e) (log (.-Message e))))
    """)
  (reference """
    The listener is owned by the ambient concurrency scope. Scope exit
    forcibly closes the listening socket and any open accepted connections.
    Use @code{close-listener!} for graceful drain operations.
    """))

(:doc listener-port
  (summary "Returns the local port number assigned to the listener.")
  (arg l "The TCP listener instance.")
  (returns "The bound TCP port number.")
  (see tcp-listen)
  (reference """
    Remains accessible after the listener is closed.
    """))

(:doc accept-evt
  (summary "Returns a CML event that accepts the next incoming connection on the listener.")
  (arg l "The TCP listener instance.")
  (returns "An event yielding @code{(Ok (Tuple in out))}, or @code{(Err e)} on socket failure.")
  (see accept listener-closed close-listener! tcp-listen)
  (reference """
    First-class CML event. If another branch in @code{choose} synchronizes
    first, no connection is consumed. The event is ephemeral: repeated
    synchronizations yield new connections. Socket errors yield an @code{Err}
    result.
    """))

(:doc listener-closed
  (summary "Returns a CML event that triggers when the listener has ceased accepting connections.")
  (arg l "The TCP listener instance.")
  (returns "An event enabled once the listener is closed.")
  (see close-listener! accept-evt)
  (reference """
    Triggers when @code{close-listener!} is called or when the owning
    concurrency scope exits.
    """))

(:doc accept
  (summary "Accepts the next incoming connection, suspending or blocking until available.")
  (arg l "The TCP listener instance.")
  (returns "A tuple containing the input and output ports of the accepted connection.")
  (raises System.Net.Sockets.SocketException "When an underlying socket error occurs.")
  (see accept-evt listener-closed)
  (reference """
    Synchronizes on @code{accept-evt}. Suspends cooperatively within a
    bjoroutine; blocks the thread in standard synchronous code.
    """))

(:doc close-listener!
  (summary "Gracefully stops accepting new connections while preserving existing active connections.")
  (arg l "The TCP listener instance.")
  (see listener-closed tcp-listen)
  (reference """
    Closes the listening socket and enables @code{listener-closed}. Existing
    active connections remain open until closed by their respective handlers.
    Idempotent.
    """))

;; ---------------------------------------------------------------------------
;; Who is at the other end
;; ---------------------------------------------------------------------------

(:doc peer-address
  (summary "Returns the remote IP address and port of a connection's input port.")
  (arg p "Input port of a TCP connection.")
  (returns "@code{(Some address)} formatted as IP:port, or @code{None} if not a network connection.")
  (see tcp-connect accept-evt stream->ports)
  (reference """
    Returns @code{None} for non-network ports, including files, pipes, and
    @code{limited} wrappers.
    """))
