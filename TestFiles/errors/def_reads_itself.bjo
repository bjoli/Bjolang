;; A value's own name, read outside a lambda, is the name from before the def.
;; With nothing before it, there is nothing to read. This used to compile and
;; read the new binding before it had a value.

;; EXPECT-ERROR: Unbound variable: z

(import (std prelude))

(defun (main args)
  (def z (+ z 1))
  (println z)
  0)
