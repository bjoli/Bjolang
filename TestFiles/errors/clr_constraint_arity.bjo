;; EXPECT-ERROR: not a .NET interface this compiler can find
;;
;; `INumber` takes one type argument. Written at three it names nothing, and the
;; arity is part of what is looked up rather than something inferred afterwards.
(import (std prelude))

(def/trait (Num %a)
  (#:clr-constraint (System.Numerics.INumber %a %a %a)))

(defun (main) 0)
