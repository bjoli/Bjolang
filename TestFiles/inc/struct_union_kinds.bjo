;; Unions for 335_struct_union.bjo, from a module of their own: each fits in
;; 16 bytes and is a struct at run time, and an importer has to agree on that.

(type/derive (Eq Ord) (: Grade (Union (: Pass int) (: Merit int int) Fail)))
(type (: Cell (Union (: Text string) (: Count string long) Blank)))

(: points (-> Grade int))
(defun (points g)
  (match g
    ((Pass n) n)
    ((Merit a b) (+ a b))
    (Fail 0)))

(export Grade Cell points)
