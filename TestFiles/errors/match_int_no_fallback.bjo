;; `int` has no listable set of values, so only a binder covers it. The
;; counterexample is `_`: the check knows a value gets through, not which one.

;; EXPECT-ERROR: does not cover every value
;; EXPECT-ERROR: _ reaches no clause

(import (std prelude))

(: name (-> int string))
(defun (name n)
  (match n
    (0 "zero")
    (1 "one")))

(defun (main args)
  (println (name 0))
  0)
