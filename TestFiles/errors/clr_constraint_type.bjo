;; A generic .NET type at an argument that breaks its constraint is a Bjolang
;; error where the type is written. Nullable<T> needs T : struct.
;; EXPECT-ERROR: (System.Nullable (Array int)) is System.Nullable<T>, which needs T to be a value type (struct), and here T is (Array int).
(import (std prelude))
(import/class ((Nullable %a) (: System.Nullable)))

(: (-> (Nullable (Array int)) int))
(defun (f x) 1)

(defun (main) 0)
