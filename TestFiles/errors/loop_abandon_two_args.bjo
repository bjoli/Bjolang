;; `:abandon` takes exactly one test.

;; EXPECT-ERROR: Invalid (:abandon ...)
;; EXPECT-ERROR: Expected: (:abandon test)

(import (std prelude))

(: f (-> (List int) (List int) int))
(defun (f xs ys)
  (loop (:for x xs)
        (:subloop)
        (:for y ys)
        (:abandon (> y 1) 0)
        (:acc s (summing y))
        => s))

(defun (main) (println (int->string (f '(1 2 3) '(1 2)))) 0)
