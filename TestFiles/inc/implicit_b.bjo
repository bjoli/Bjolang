;; For 380_implicit_exports.bjo. The same private names as `implicit_a.bjo`,
;; with other types.

(export b-register! b-first b-shout)
(import (std prelude))

(: registry (Box (List string)))
(def registry (make-box (list)))

(: helper (-> string string))
(defun (helper s) (str s "!"))

(: b-register! (-> string void))
(defun (b-register! s) #:inline (box-set! registry (cons (helper s) (box-ref registry))))

(: b-first (-> string))
(defun (b-first) #:inline (match (box-ref registry) ((Cons s _) s) (_ "")))

(: b-shout (-> %a string) (where (->str %a)))
(defun (b-shout x) (helper (->str x)))
