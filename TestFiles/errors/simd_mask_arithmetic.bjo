;; A comparison gives a mask, a type of its own, and a mask is not numbers:
;; summing one is refused. `simd-mask->lanes` gives the lanes for code that
;; means to.

;; EXPECT-ERROR: no implementation of trait 'Simd' for '(simd/Mask256 double)', required by 'simd-sum'

(import (std prelude))
(import (std simd))

(defun (main)
  (def m (simd-lt (simd256-splat 1.0) (simd256-splat 2.0)))
  (println (simd-sum m))
  0)
