;; EXPECT-ERROR: has a -?-> arrow, and a definition in a body cannot have one

;; -?-> makes a copy for each colour, and a local definition has one body.

(import (std prelude))

(: (-> int))
(defun (outer)
  (: (-> (-?-> int int) int))
  (defun (helper f) (f 1))
  (helper (fun (x) x)))

(defun (main args) (println (outer)) 0)
