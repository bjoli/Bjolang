;; `{...}` inside '(...).
;;
;; The reader rewrites a comprehension to a reserved head before the parser sees
;; it, so quoting one would otherwise produce a list beginning with the symbol
;; `comprehension` — a form nobody wrote. A comprehension is a loop that
;; produces a value, and `,{...}` is how that value gets into the list.

;; EXPECT-ERROR: A comprehension inside a quoted list
;; EXPECT-ERROR: write ,{...} to splice what it produces

(import (std prelude))

(defun (main args)
  (println (int->string (list-length '(a {listing x (:for x (list 1 2))}))))
  0)
