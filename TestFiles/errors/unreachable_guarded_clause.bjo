;; A guarded clause covers nothing, but it is still checked for being reachable:
;; the guard never runs, because the clause above it matched first.

;; EXPECT-ERROR: this clause can never run

(import (std prelude))

(: describe (-> (Option int) string))
(defun (describe o)
  (match o
    (x "anything")
    ((Some n) #:when (> n 1) "big")))

(defun (main args)
  (println (describe None))
  0)
