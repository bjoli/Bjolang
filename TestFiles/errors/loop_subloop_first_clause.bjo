;; A `:subloop` form begins with a driver, as a loop does.

;; EXPECT-ERROR: A loop must begin with a (:for ...), (:with ...), (:while ...) or (:until ...)

(import (std prelude))

(: f (-> (List (List int)) (List int)))
(defun (f rows)
  (loop (:for row rows)
        (:subloop (:acc s (summing 1))
                  (:for y row))
        (:acc out (listing s))))

(defun (main) (println (int->string (list-length (f '((1)))))) 0)
