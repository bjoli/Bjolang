;; Macros whose templates name builtins, for
;; `484_template_builtins_resolved.bjo`.

(import (std prelude))
(import (std syntax-match))

(export one-of size-via-value)

(def/macro (one-of form inject compare)
  (syntax-match form
    ((_ x) #'(cons ,x '()))))

(def/macro (size-via-value form inject compare)
  (syntax-match form
    ((_ xs) #'((fun (f) (f ,xs)) list-length))))
