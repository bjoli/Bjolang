;; (std bytestring): making, slicing, comparing, UTF-8 steps, search, split.

(import (std prelude))
(import (std simpletest))
(import (only (std random) make-random/seed64 random-int))

(: (-> (-> %a) bool))
(defun (out-of-range? thunk)
  (match (try (thunk) #:catch (System.ArgumentOutOfRangeException))
    ((Ok _) #f)
    ((Err _) #t)))

(: (-> (Vec int) ByteString))
(defun (bs-of xs) (bytes->bytestring (vec->array (vec-map (fun (x) (cast byte x)) xs))))

;; The parts of a byte string as (offset, char or None).
(: (-> ByteString (List (Tuple int (Option char)))))
(defun (parts b) (->list (in-bytestring-utf-8 b)))

;; The offsets that `prev` reaches from the end.
(: (-> ByteString (List int)))
(defun (back-offsets b)
  (let go ((i (bytestring-length b)) (acc Nil))
    (if (= i 0) acc (let ((p (bytestring-utf-8-prev b i))) (go p (Cons p acc))))))

(defun (main)
  ;; Making and converting
  (def hello (string->bytestring "hello world"))
  (expect "length" (bytestring-length hello) 11)
  (expect "round trip through a string" (bytestring->string hello) (Ok "hello world"))
  (expect "round trip through an array" (array->vec (bytestring->bytes (bytestring 1uy 2uy 3uy))) [1uy 2uy 3uy])
  (def src (vec->array [1uy 2uy 3uy]))
  (def copied (bytes->bytestring src))
  (array-set! src 0 9uy)
  (expect "the array is copied" (bytestring-ref copied 0) 1uy)
  (expect "a range of an array" (bytes->bytestring (vec->array [1uy 2uy 3uy 4uy]) #:start 1 #:end 3) (bytestring 2uy 3uy))
  (expect "empty" (bytestring-empty? bytestring-empty) #t)
  (expect "empty to a string" (bytestring->string bytestring-empty) (Ok ""))

  ;; The default value is the empty byte string
  (def (: defaults (Array ByteString)) (make-array 1))
  (def d (array-ref defaults 0))
  (expect "a default is empty" (bytestring-length d) 0)
  (expect "a default equals the empty one" (= d bytestring-empty) #t)
  (expect "a default to a string" (bytestring->string d) (Ok ""))
  (expect "a default written" (written d) "#b\"\"")

  ;; Slices
  (def world (bytestring-slice hello 6 11))
  (expect "a slice" (bytestring->string world) (Ok "world"))
  (expect "a slice of a slice" (bytestring->string (bytestring-slice world 1 3)) (Ok "or"))
  (expect "offsets count from the slice" (bytestring-ref world 0) 119uy)
  (expect "a copy is equal" (bytestring-copy world) world)
  (expect "slice out of range" (out-of-range? (fun () (bytestring-slice hello 3 12))) #t)
  (expect "slice backwards" (out-of-range? (fun () (bytestring-slice hello 4 3))) #t)
  (expect "ref out of range" (out-of-range? (fun () (bytestring-ref world 5))) #t)
  (expect "ref before the start" (out-of-range? (fun () (bytestring-ref world -1))) #t)

  ;; Equality, order, hash
  (def abc (string->bytestring "xabcabc"))
  (def first-abc (bytestring-slice abc 1 4))
  (def second-abc (bytestring-slice abc 4 7))
  (expect "equal at different starts" (= first-abc second-abc) #t)
  (expect "equal hashes" (= (eq-hash first-abc) (eq-hash (string->bytestring "abc"))) #t)
  (expect "order by bytes" (compare (string->bytestring "ab") (string->bytestring "b")) -1)
  (expect "a prefix comes first" (compare (string->bytestring "ab") (string->bytestring "abc")) -1)
  (expect "order is unsigned" (compare (bytestring 127uy) (bytestring 128uy)) -1)
  (expect "equal compare" (compare first-abc second-abc) 0)
  (expect "a map with byte string keys" (map-length (->map [(Tuple first-abc 1) (Tuple second-abc 2) (Tuple (string->bytestring "x") 3)])) 2)

  ;; Bytes as an iterable
  (expect "iterates bytes" (->list (bytestring-slice hello 0 3)) (list 104uy 101uy 108uy))
  (expect "count" (count world) 5)

  ;; Not UTF-8
  (def cafe (bs-of [99 97 102 0xE9 46 116 120 116]))
  (expect "lossy" (bytestring->string/lossy cafe) "caf\u{FFFD}.txt")
  (expect "not UTF-8" (bytestring-utf-8? cafe) #f)
  (expect "valid end" (bytestring-utf-8-valid-end cafe) 3)
  (expect "valid end of UTF-8" (bytestring-utf-8-valid-end hello) 11)
  (expect "strict returns the error" (bytestring->string cafe)
          (Err (DecodeError (offset 3) (bytes [233uy]) (encoding "utf-8"))))
  (expect "the offset counts from the slice" (bytestring->string (bytestring-slice cafe 1 8))
          (Err (DecodeError (offset 2) (bytes [233uy]) (encoding "utf-8"))))
  (expect "lossy with a replacement" (bytestring->string/lossy cafe #:replace #\?) "caf?.txt")
  (expect "written" (written cafe) "#b\"caf\\xE9.txt\"")
  (expect "written UTF-8" (written (string->bytestring "blåbär \"q\"\n")) "#b\"blåbär \\\"q\\\"\\n\"")
  (expect "written control" (written (bytestring 1uy)) "#b\"\\u{01}\"")
  (expect "displayed" (displayed cafe) "caf\u{FFFD}.txt")
  (expect "chars" (->list (in-bytestring-chars cafe)) (string->list "caf\u{FFFD}.txt"))

  ;; Maximal subparts (Unicode chapter 3, table 3-8 and around)
  (expect "a cut 4-byte sequence is one part" (parts (bs-of [0xF0 0x9F 0x98])) (list (Tuple 0 None)))
  (expect "overlong is two parts" (parts (bs-of [0xC0 0xAF])) (list (Tuple 0 None) (Tuple 1 None)))
  (expect "a surrogate is three parts" (parts (bs-of [0xED 0xA0 0x80])) (list (Tuple 0 None) (Tuple 1 None) (Tuple 2 None)))
  (expect "past U+10FFFF is four parts" (parts (bs-of [0xF4 0x90 0x80 0x80]))
          (list (Tuple 0 None) (Tuple 1 None) (Tuple 2 None) (Tuple 3 None)))
  (expect "a cut sequence before ASCII" (parts (bs-of [0xE2 0x82 0x41])) (list (Tuple 0 None) (Tuple 2 (Some #\A))))
  (expect "a whole emoji" (parts (string->bytestring "a😀")) (list (Tuple 0 (Some #\a)) (Tuple 1 (Some #\😀))))
  (expect "ref of a character" (bytestring-utf-8-ref (string->bytestring "é") 0) (Some #\é))
  (expect "ref of a bad part" (bytestring-utf-8-ref cafe 3) None)
  (expect "ref inside a character" (bytestring-utf-8-ref (string->bytestring "é") 1) None)
  (expect "next over a character" (bytestring-utf-8-next (string->bytestring "é!") 0) 2)
  (expect "next at the end raises" (out-of-range? (fun () (bytestring-utf-8-next world 5))) #t)
  (expect "prev at 0 raises" (out-of-range? (fun () (bytestring-utf-8-prev world 0))) #t)
  (expect "prev over continuation bytes alone" (back-offsets (bs-of [0x80 0x80 0x80 0x80 0x80])) (list 0 1 2 3 4))
  (expect "prev over a slice" (back-offsets (bytestring-slice (string->bytestring "xé😀") 1 7)) (list 0 2))

  ;; The stepper against .NET's lossy decoding and prev against next, on
  ;; random bytes. Most bytes are drawn from the lead and continuation
  ;; ranges, so most strings have whole characters and bad parts mixed.
  (def rng (make-random/seed64 7UL))
  (def pool (vec->array [0x41 0x80 0x8F 0x90 0x9F 0xA0 0xBF 0xC0 0xC2 0xDF 0xE0 0xE1 0xED 0xEF 0xF0 0xF1 0xF4 0xF5 0xFF]))
  (def mismatches
    (loop (:for _ (range 0 2000))
          (:acc bad (summing
                      (let* ((n (random-int 0 8 #:rng rng))
                             (b (bs-of (loop (:for _ (range 0 n))
                                             (:acc xs (vecing (array-ref pool (random-int 0 (- (array-length pool) 1) #:rng rng)))))))
                             (forward (loop (:for (Tuple at _) (in-bytestring-utf-8 b)) (:acc l (listing at))))
                             (lossy (list->string (->list (in-bytestring-chars b)))))
                        (if (and (= lossy (bytestring->string/lossy b))
                                 (= forward (back-offsets b)))
                            0
                            1))))))
  (expect "stepper agrees with .NET and with prev" mismatches 0)

  ;; Search
  (expect "search" (bytestring-search hello (string->bytestring "o")) (Some 4))
  (expect "search from" (bytestring-search hello (string->bytestring "o") #:from 5) (Some 7))
  (expect "search not found" (bytestring-search hello (string->bytestring "z")) None)
  (expect "search in a slice" (bytestring-search world (string->bytestring "o")) (Some 1))
  (expect "search backward" (bytestring-search-backward hello (string->bytestring "o")) (Some 7))
  (expect "search backward before" (bytestring-search-backward hello (string->bytestring "o") #:before 7) (Some 4))
  (expect "search a byte" (bytestring-search-byte hello 32uy) (Some 5))
  (expect "search a byte backward" (bytestring-search-byte-backward hello 108uy) (Some 9))
  (expect "contains" (bytestring-contains? hello (string->bytestring "lo w")) #t)
  (expect "starts with" (bytestring-starts-with? hello (string->bytestring "hell")) #t)
  (expect "ends with" (bytestring-ends-with? world (string->bytestring "ld")) #t)
  (expect "does not end with" (bytestring-ends-with? world (string->bytestring "lo")) #f)
  (expect "search from out of range" (out-of-range? (fun () (bytestring-search hello hello #:from 12))) #t)

  ;; Joining and splitting
  (def path (string->bytestring "/usr//lib/"))
  (expect "split" (vec-map bytestring->string/lossy (bytestring-split path 47uy)) ["" "usr" "" "lib" ""])
  (expect "split with no separator" (vec-map bytestring->string/lossy (bytestring-split world 47uy)) ["world"])
  (expect "split empty" (vec-length (bytestring-split bytestring-empty 47uy)) 1)
  (expect "join" (bytestring-join (bytestring-split path 47uy) (string->bytestring "/")) path)
  (expect "join none" (bytestring-join [] (string->bytestring "/")) bytestring-empty)
  (expect "append" (bytestring-append world (bytestring-slice hello 5 6)) (string->bytestring "world "))
  (expect "concat with a default" (bytestring-concat [d world d]) world)
  (expect "concat keeps bad bytes" (bytestring-concat [cafe cafe]) (bs-of [99 97 102 0xE9 46 116 120 116 99 97 102 0xE9 46 116 120 116])))
