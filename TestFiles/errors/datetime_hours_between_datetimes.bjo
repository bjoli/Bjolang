;; Elapsed time is measured between instants, and a DateTime has none: across
;; a change of offset its wall clock is not the time that passed.

;; EXPECT-ERROR: no implementation of trait 'HasInstant' for 'datetime/DateTime', needed to call 'hours-between'
;; EXPECT-NO-ERROR: could not specialise

(import (std datetime))

(defun (main)
  (match (Tuple (datetime 2026 10 25) (datetime 2026 10 26))
    ((Tuple (Some a) (Some b)) (println (hours-between a b)))
    (_ (println "none")))
  0)
