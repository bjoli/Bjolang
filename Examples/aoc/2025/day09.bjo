;; Day 9: Movie Theater. Red tiles, in order around a closed loop whose sides
;; are horizontal or vertical; the tiles on the loop and inside it are red or
;; green. Part 1: the largest rectangle with red tiles at two opposite
;; corners. Part 2: the largest such rectangle with only red and green tiles.
(import (std prelude))
(import (std maths))
(import "common.bjo")

(type (: P (Record (: x long) (: y long))))

(: area (-> P P long))
(defun (area a b)
  (* (+ 1L (abs (- (.x a) (.x b)))) (+ 1L (abs (- (.y a) (.y b))))))

;; Whether some side of the loop passes through the open inside of the
;; rectangle [x0, x1] x [y0, y1].
(: crossed? (-> (Vec P) long long long long bool))
(defun (crossed? ps x0 x1 y0 y1)
  (def n (length ps))
  (loop (:for i (range 0 n))
        (:let a (ref ps i))
        (:let b (ref ps (% (+ i 1) n)))
        (:let ex0 (min (.x a) (.x b)))
        (:let ex1 (max (.x a) (.x b)))
        (:let ey0 (min (.y a) (.y b)))
        (:let ey1 (max (.y a) (.y b)))
        (:acc hit (folding #f (and (< ex0 x1) (> ex1 x0) (< ey0 y1) (> ey1 y0))))
        (:finish hit)
        => hit))

;; Whether the point (px + 1/2, py + 1/2) is inside the loop, by counting the
;; vertical sides to its right.
(: inside? (-> (Vec P) long long bool))
(defun (inside? ps px py)
  (def n (length ps))
  (loop (:for i (range 0 n))
        (:let a (ref ps i))
        (:let b (ref ps (% (+ i 1) n)))
        (:when (and (= (.x a) (.x b)) (> (.x a) px)
                    (<= (min (.y a) (.y b)) py) (> (max (.y a) (.y b)) py)))
        (:acc crossings (summing 1))
        => (= 1 (% crossings 2))))

(defun (main args)
  (def ps {vecing (let ((v (vec-map parse-long (string-split l ",")))) (P (x (ref v 0)) (y (ref v 1))))
                  (:for l (input-lines args))})
  (def n (length ps))
  (def (part1 part2)
    (loop (:for i (range 0 n))
          (:subloop)
          (:for j (range (+ i 1) n))
          (:let a (ref ps i))
          (:let b (ref ps j))
          (:let x0 (min (.x a) (.x b)))
          (:let x1 (max (.x a) (.x b)))
          (:let y0 (min (.y a) (.y b)))
          (:let y1 (max (.y a) (.y b)))
          (:let s (area a b))
          (:acc part1 (folding 0L (max part1 s)))
          ;; A rectangle of one row or column has no inside to test; the
          ;; largest one is never that thin.
          (:acc part2 (folding 0L (if (and (> s part2) (< x0 x1) (< y0 y1)
                                           (not (crossed? ps x0 x1 y0 y1))
                                           (inside? ps x0 y0))
                                      s
                                      part2)))
          => (Tuple part1 part2)))
  (println part1)
  (println part2)
  0)
