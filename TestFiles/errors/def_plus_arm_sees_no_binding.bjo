;; An arm runs because the binder did not match, so what the binder would have
;; bound does not exist there.
;;
;; `n` is bound by the binding pattern and is visible in the sequel — but not
;; in an arm, whose reason for running is that the pattern did not match. What
;; the *arm's* own pattern binds is a different question, and is what
;; `220_def_plus.bjo` asserts.

;; EXPECT-ERROR: Unbound variable: n

(import (std prelude))

(: f (-> (Option int) string))
(defun (f o)
  (def+ ((Some n) o)
        (None (int->string n)))
  (int->string n))
