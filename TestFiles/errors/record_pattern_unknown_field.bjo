;; A record pattern names fields the type has.

;; EXPECT-ERROR: 'Car' has no field 'colour'
;; EXPECT-ERROR: Its fields are: brand, year

(import (std prelude))

(type (: Car (Record (: brand string) (: year int))))

(: f (-> Car string))
(defun (f c)
  (match c
    ((Car (colour b)) b)
    (_ "")))

(defun (main args)
  (println (f (Car (brand "a") (year 1))))
  0)
