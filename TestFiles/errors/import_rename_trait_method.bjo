;; Rule 4, at a trait method. A systematic prefix of a trait's methods is fine
;; — dispatch resolves through the name the trait declared — but an individual
;; bare-name remap is refused, because the impls that travel with the trait are
;; filed under the declared name and nothing would look up the new one.
;;
;; EXPECT-ERROR: Invalid (rename ...)
;; EXPECT-ERROR: 'label' is a method of the trait 'Labelled'

(import (rename "../inc/kitchen.bjo" (label tag)))

(defun (main)
  0)
