;; The items of a keyword list are read in order against the alternative.
;; Thus the grammar gives the number of arguments, and a literal can have too
;; many.
;; EXPECT-ERROR: expected the end of the list; found the symbol `b`
(import (std prelude))

(def/grammar Q
  (:or (: CFrom (from symbol))
       (: CPlain (symbol ...))))

(: render (-> Q string))
(defun (render q) "r")

(defun (main args)
  (println (render '(from a b)))
  0)
