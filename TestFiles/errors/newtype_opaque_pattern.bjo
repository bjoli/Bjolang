;; An #:opaque newtype is taken apart only by the code of its own module.

;; EXPECT-ERROR: the newtype newtype_lib/Email cannot be taken apart here

(import (std prelude))
(import "../inc/newtype_lib.bjo")

(defun (main args)
  (match (parse-email "a@b")
    ((Some (Email s)) (println s))
    (_ (println "none")))
  0)
