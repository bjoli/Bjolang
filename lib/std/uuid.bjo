;; std/uuid.bjo — uuids, as RFC 9562 specifies them.
;;
;; A `Uuid` is 16 bytes, held as two `ulong`s in network byte order. Two uuids
;; compare as their bytes compare, which is also how their text compares and
;; how Postgres orders its `uuid` type. A version 7 uuid starts with the time,
;; so version 7 uuids sort by the time they were made.
;;
;; The random bits come from `(std random)`, and the time of a version 7 uuid
;; from `current-clock`. Both are parameters, so a test can fix them.

(export
  Uuid
  ;; Making one
  uuid-v4 uuid-v7 uuid-v5 uuid-v3
  uuid-nil uuid-max
  uuid-ns-dns uuid-ns-url uuid-ns-oid uuid-ns-x500
  ;; Text and bytes
  uuid->string string->uuid uuid-string?
  uuid->bytes bytes->uuid
  ;; What is in one
  uuid-version uuid-v7-time
  ;; .NET
  uuid->guid guid->uuid)

(import (std prelude))
(import (only (std random) current-random random-u64))
(import (only (std datetime) Instant now instant->unix-milliseconds unix-milliseconds->instant))
(import (only (std crypto hash) HashAlgorithm make-hasher hasher-add! hasher-add-string! hasher-finish!))
(import (only (std atomic) Atomic make-atomic atomic-update!))

(:doc #:file "uuid.bjodoc")

;; The constructor that takes the fields in the order of the bytes:
;; `(uint, ushort, ushort, byte x 8)` is bytes 0-3, 4-5, 6-7 and 8-15,
;; big-endian.
(import/class
  (Guid (: System.Guid (-> uint ushort ushort byte byte byte byte byte byte byte byte Guid))))

(import/extern
  ;; With `#t`: the 16 bytes in the order of the text.
  (clr-guid-bytes (: System.Guid.ToByteArray (-> Guid bool (Array byte)))))

;; `hi` is the first 8 bytes, `lo` the last 8. Opaque, so every `Uuid` is one
;; that a function here made. `type/derive` does not take `#:opaque`, so `Eq`
;; and `Ord` are written out: `hi` first, then `lo`, which is the order of the
;; bytes.
(type (: Uuid #:opaque (Struct (: hi ulong) (: lo ulong))))

(impl (Eq Uuid)
  (defun (= a b) (and (= (struct-ref a hi) (struct-ref b hi)) (= (struct-ref a lo) (struct-ref b lo))))
  (defun (eq-hash u) (bitwise-xor (eq-hash (struct-ref u hi)) (* 31 (eq-hash (struct-ref u lo))))))

(impl (Ord Uuid)
  (defun (compare a b)
    (def by-hi (compare (struct-ref a hi) (struct-ref b hi)))
    (if (= by-hi 0) (compare (struct-ref a lo) (struct-ref b lo)) by-hi)))

(: (-> Uuid ulong))
(defun (hi-of u) (struct-ref u hi))

(: (-> Uuid ulong))
(defun (lo-of u) (struct-ref u lo))

;; ---------------------------------------------------------------------------
;; Bits and bytes
;; ---------------------------------------------------------------------------

;; Everything in `hi` except the 4 version bits, bits 12 to 15.
(: ulong)
(def version-mask 0xFFFFFFFFFFFF0FFF)

;; Everything in `lo` except the 2 variant bits at the top.
(: ulong)
(def variant-mask 0x3FFFFFFFFFFFFFFF)

;; The variant of RFC 9562: the top two bits of `lo` are 10.
(: ulong)
(def rfc-variant 0x8000000000000000)

(: (-> ulong int ulong))
(defun (with-version hi version)
  (bitwise-ior (bitwise-and hi version-mask) (shift-left (cast ulong version) 12)))

(: (-> ulong ulong))
(defun (with-variant lo) (bitwise-ior (bitwise-and lo variant-mask) rfc-variant))

;; The 8 bytes from `start`, big-endian.
(: (-> (Array byte) int ulong))
(defun (read-u64 bytes start)
  (let go ((i start) (v 0UL))
    (if (= i (+ start 8))
        v
        (go (+ i 1) (bitwise-ior (shift-left v 8) (cast ulong (array-ref bytes i)))))))

;; Writes `v` into the 8 bytes from `start`, big-endian.
(: (-> (Array byte) int ulong void))
(defun (write-u64! bytes start v)
  (loop (:for i (range 0 8))
        (:do (array-set! bytes (+ start i) (cast byte (shift-right-logical v (* 8 (- 7 i))))))))

;; ---------------------------------------------------------------------------
;; Making one
;; ---------------------------------------------------------------------------

;; 122 random bits.
(: (-> (#:rng RandomSource) Uuid))
(defun (uuid-v4 #:rng (parameter-ref current-random))
  (def r1 (random-u64 #:rng rng))
  (def r2 (random-u64 #:rng rng))
  (Uuid (hi (with-version r1 4)) (lo (with-variant r2))))

;; A version 7 uuid without its version and variant bits: the 48 bits of the
;; time and then the 74 random bits, as one 122-bit number. `high` is its top
;; 58 bits and `low` its bottom 64.
(type (: V7Bits (Struct (: high ulong) (: low ulong))))

(: (-> V7Bits V7Bits bool))
(defun (v7-greater? a b)
  (or (> (struct-ref a high) (struct-ref b high))
      (and (= (struct-ref a high) (struct-ref b high))
           (> (struct-ref a low) (struct-ref b low)))))

;; `b` plus 1.
(: (-> V7Bits V7Bits))
(defun (v7-next b)
  (def bottom (+ (struct-ref b low) 1UL))
  (V7Bits (high (if (= bottom 0UL) (+ (struct-ref b high) 1UL) (struct-ref b high)))
          (low bottom)))

;; The last version 7 value that this process made.
(: (Atomic V7Bits))
(def last-v7 (make-atomic (V7Bits (high 0UL) (low 0UL))))

;; The Unix time in milliseconds, then 74 random bits. The uuids that this
;; process makes always increase, also when two are made in one millisecond
;; and when the clock steps back.
;;
;; - A value that is not greater than the last one is the last one plus 1, as
;;   RFC 9562 section 6.2 allows.
;; - `last-v7` changes in one atomic step, so this holds across threads.
(: (-> (#:clock Clock) (#:rng RandomSource) Uuid))
(defun (uuid-v7 #:clock (parameter-ref current-clock) #:rng (parameter-ref current-random))
  (def ms (bitwise-and (cast ulong (instant->unix-milliseconds (now #:clock clock))) 0xFFFFFFFFFFFF))
  (def r1 (random-u64 #:rng rng))
  (def r2 (random-u64 #:rng rng))
  (def candidate (V7Bits (high (bitwise-ior (shift-left ms 10) (bitwise-and r1 0x3FF)))
                         (low r2)))
  (def chosen
    (atomic-update! last-v7 (fun (last) (if (v7-greater? candidate last) candidate (v7-next last)))))
  (def top (struct-ref chosen high))
  (def bottom (struct-ref chosen low))
  ;; 48 bits of time, the version, then the top 12 random bits.
  (def rand-a (bitwise-and (bitwise-ior (shift-left top 2) (shift-right-logical bottom 62)) 0xFFF))
  (Uuid (hi (bitwise-ior (shift-left (shift-right-logical top 10) 16) (bitwise-ior 0x7000 rand-a)))
        (lo (with-variant bottom))))

;; A digest of the namespace's 16 bytes and the name's UTF-8 bytes. The uuid
;; is the first 16 bytes of the digest, with the version and the variant set.
;; SHA-1 and MD5 digests are 20 and 16 bytes.
(: (-> HashAlgorithm int Uuid string Uuid))
(defun (name-based algorithm version namespace name)
  (def h (make-hasher #:algorithm algorithm))
  (hasher-add! h (uuid->bytes namespace))
  (hasher-add-string! h name)
  (def digest (hasher-finish! h))
  (Uuid (hi (with-version (read-u64 digest 0) version))
        (lo (with-variant (read-u64 digest 8)))))

;; The same namespace and name always give the same uuid. SHA-1.
(: (-> Uuid string Uuid))
(defun (uuid-v5 namespace name) (name-based Sha1 5 namespace name))

;; As `uuid-v5`, with MD5. For a system that already uses version 3.
(: (-> Uuid string Uuid))
(defun (uuid-v3 namespace name) (name-based Md5 3 namespace name))

(: Uuid)
(def uuid-nil (Uuid (hi 0UL) (lo 0UL)))

(: Uuid)
(def uuid-max (Uuid (hi 18446744073709551615UL) (lo 18446744073709551615UL)))

;; The namespaces of RFC 9562, section 6.6.
(: (-> string Uuid))
(defun (known text)
  (match (string->uuid text)
    ((Some u) u)
    (None (panic! (str "(std uuid): not a uuid: " text)))))

(: Uuid)
(def uuid-ns-dns (known "6ba7b810-9dad-11d1-80b4-00c04fd430c8"))

(: Uuid)
(def uuid-ns-url (known "6ba7b811-9dad-11d1-80b4-00c04fd430c8"))

(: Uuid)
(def uuid-ns-oid (known "6ba7b812-9dad-11d1-80b4-00c04fd430c8"))

(: Uuid)
(def uuid-ns-x500 (known "6ba7b814-9dad-11d1-80b4-00c04fd430c8"))

;; ---------------------------------------------------------------------------
;; Text and bytes
;; ---------------------------------------------------------------------------

(: (Array byte))
(def lower-digits (string->bytes "0123456789abcdef"))

(: (Array byte))
(def upper-digits (string->bytes "0123456789ABCDEF"))

;; Whether the 32 hex digits have a hyphen before digit `i`.
(: (-> int bool))
(defun (hyphen-before? i) (or (= i 8) (= i 12) (= i 16) (= i 20)))

;; 8-4-4-4-12 hex digits, lower case unless `#:upper #t`.
(: (-> Uuid (#:upper bool) string))
(defun (uuid->string u #:upper #f)
  (def digits (if upper upper-digits lower-digits))
  (def sb (stringbuilder-empty))
  (loop (:for i (range 0 32))
        (:do (when (hyphen-before? i) (stringbuilder-add-code! sb 45))
             (let ((word (if (< i 16) (hi-of u) (lo-of u)))
                   (shift (* 4 (- 15 (% i 16)))))
               (stringbuilder-add-code!
                 sb (cast int (array-ref digits (cast int (bitwise-and (shift-right-logical word shift) 15UL))))))))
  (stringbuilder->string sb))

;; 0 to 15 for an ASCII hex digit in either case, -1 for any other byte.
(: (-> byte int))
(defun (hex-value b)
  (def c (cast int b))
  (cond
    ((and (>= c 48) (<= c 57)) (- c 48))
    ((and (>= c 65) (<= c 70)) (- c 55))
    ((and (>= c 97) (<= c 102)) (- c 87))
    (else -1)))

;; Only the 36-character form, in upper or lower case: no braces, no
;; `urn:uuid:`, and no form without hyphens, so that one uuid has one text in
;; each case.
(: (-> string (Option Uuid)))
(defun (string->uuid text)
  (def bytes (string->bytes text))
  (if (not (= (array-length bytes) 36))
      None
      ;; `i` indexes the text, `digit` counts the hex digits read.
      (let go ((i 0) (digit 0) (h 0UL) (l 0UL))
        (cond
          ((= i 36) (Some (Uuid (hi h) (lo l))))
          ((or (= i 8) (= i 13) (= i 18) (= i 23))
           (if (= (array-ref bytes i) 45uy) (go (+ i 1) digit h l) None))
          (else
           (def v (hex-value (array-ref bytes i)))
           (cond
             ((< v 0) None)
             ((< digit 16) (go (+ i 1) (+ digit 1) (bitwise-ior (shift-left h 4) (cast ulong v)) l))
             (else (go (+ i 1) (+ digit 1) h (bitwise-ior (shift-left l 4) (cast ulong v))))))))))

(: (-> string bool))
(defun (uuid-string? text) (some? (string->uuid text)))

;; 16 bytes, in network byte order.
(: (-> Uuid (Array byte)))
(defun (uuid->bytes u)
  (def (: bytes (Array byte)) (make-array 16))
  (write-u64! bytes 0 (hi-of u))
  (write-u64! bytes 8 (lo-of u))
  bytes)

;; `None` unless there are exactly 16 bytes.
(: (-> (Array byte) (Option Uuid)))
(defun (bytes->uuid bytes)
  (if (= (array-length bytes) 16)
      (Some (Uuid (hi (read-u64 bytes 0)) (lo (read-u64 bytes 8))))
      None))

(impl (Written Uuid)
  (defun (written u) (uuid->string u))
  (defun (write-into u b) (stringbuilder-add-string! b (written u))))

;; ---------------------------------------------------------------------------
;; What is in one
;; ---------------------------------------------------------------------------

;; The 4 version bits: 4 for `uuid-v4`, 7 for `uuid-v7`. 0 for `uuid-nil` and
;; 15 for `uuid-max`.
(: (-> Uuid int))
(defun (uuid-version u)
  (cast int (bitwise-and (shift-right-logical (hi-of u) 12) 15UL)))

;; When a version 7 uuid was made, to the millisecond. `None` for any other
;; version.
(: (-> Uuid (Option Instant)))
(defun (uuid-v7-time u)
  (if (= (uuid-version u) 7)
      (unix-milliseconds->instant (cast long (shift-right-logical (hi-of u) 16)))
      None))

;; ---------------------------------------------------------------------------
;; .NET
;; ---------------------------------------------------------------------------

;; A `System.Guid` with the same 16 bytes, for a .NET library such as Npgsql.
;; A Guid keeps its first three fields in the machine's byte order, and its
;; `CompareTo` does not compare the bytes in order. Compare the `Uuid`.
(: (-> Uuid Guid))
(defun (uuid->guid u)
  (def b (uuid->bytes u))
  (def hi (hi-of u))
  (Guid. (cast uint (shift-right-logical hi 32))
         (cast ushort (shift-right-logical hi 16))
         (cast ushort hi)
         (array-ref b 8) (array-ref b 9) (array-ref b 10) (array-ref b 11)
         (array-ref b 12) (array-ref b 13) (array-ref b 14) (array-ref b 15)))

(: (-> Guid Uuid))
(defun (guid->uuid g)
  (def b (clr-guid-bytes g #t))
  (Uuid (hi (read-u64 b 0)) (lo (read-u64 b 8))))
