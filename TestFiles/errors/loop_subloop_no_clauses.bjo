;; A `:subloop` form with an export but no clauses has nothing to run.

;; EXPECT-ERROR: Invalid (:subloop ...) at loop_subloop_no_clauses.bjo:10: it has no clauses.

(import (std prelude))

(: f (-> (List int) (List int)))
(defun (f xs)
  (loop (:for x xs)
        (:subloop => (a 1))
        (:acc out (listing (+ x a)))))

(defun (main) (println (int->string (list-length (f '(1))))) 0)
