;; A literal at a union that has nowhere to put it.
;;
;; `Money` carries numbers and nothing else, so a string written at it is not a
;; case waiting to be found. The report names the union and what it does carry,
;; rather than leaving a bare "string does not unify with Money" to be traced
;; back to a literal several lines up.

;; EXPECT-ERROR: no case of the union Money carries a string
;; EXPECT-ERROR: Money has (Kr int), (Ore int)

(import (std prelude))

(type (: Money (Union (Kr int) (Ore int))))

(: total (-> (List Money) int))
(defun (total ms) 0)

(defun (main args)
  (println (int->string (total '("hello"))))
  0)
