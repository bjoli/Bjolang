
;; Fibonacci sequence,
(: fibseq (Seq int))
(def fibseq
  (seql (:with a 0 b)
        (:with b 1 (+ a b))
        (:yield a)))


;; using a named let
(: fibiter (-> int (Vec int)))
(defun (fibiter n)
  (loop (:for i (range 0 n))
        (:with a 0 b)
        (:with b 1 (+ a b))
        (:acc v (vecing a))))

;; as a non-tail-recursive named let
;;
(: fibrec (-> int (List int)))
(defun (fibrec n)
  (let lp ((i 0) (a 0) (b 1))
    (if (>= i n)
        Nil
        (cons a (lp (+ i 1) b (+ a b))))))


(defun (main args)
  (println (fold + 0 (fibrec 10)))
  (println (seq-fold + 0 (seq-take fibseq 10)))
  (println (fold + 0 (fibiter 10)))
  )
