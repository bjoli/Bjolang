;; `${}` — a hole with nothing in it.
;;
;; It would expand to `(->str)`, which is a trait method applied to no
;; implementor and would be reported as an arity error against a form nobody
;; wrote. Refused at the hole instead, where the mistake is.
;;
;; A literal `${}` in the text is available as `\${}`, which the escape test in
;; `099_interpolation.bjo` covers.

;; EXPECT-ERROR: there is nothing to interpolate

(import (std prelude))

(defun (main args)
  (println #"empty: ${}")
  0)
