;; `:bind` takes an identifier and not a pattern, because a pattern raises the
;; question of what a failed match means — which wants a `MonadFail` this
;; language does not have. `:match` is the answer written out: it says the word
;; `match`, and a match that does not cover throws.

;; EXPECT-ERROR: takes a plain identifier, not a pattern

(import (std prelude))
(import (std monad))

(: first-of (-> (Option (Tuple int int)) (Option int)))
(defun (first-of pair)
  (do (:bind (Tuple a b) pair)
      (:return (+ a b))))

(defun (main) 0)
