;; Quoted literals read by a grammar into constructors, recursively.
;;
;; `'(pipe (ls "-l"))` has no type of its own: a symbol beside a list of a
;; symbol and a string has no one element type. That is the point. The
;; literal describes a `ProcList`, and the grammar makes each piece the case
;; that can hold it:
;;
;;   (list (ProcSym 'pipe) (ProcSub (list (ProcSym 'ls) (ProcStr "-l"))))
;;
;; The shape of the literal selects the case before the compiler infers it.
;; The expected type comes from an annotation or from the parameter that the
;; literal goes to.

(import (std prelude))
(import (std simpletest))

;; `ProcArgv` takes a `[...]` and `ProcSub` takes a `(...)`, so the shape
;; tells them apart. `ProcFn` takes only a spliced function. `ProcList` is one
;; type, so it is an alias of `(List ProcItem)`.
(def/grammar ProcList
  (ProcList (List ProcItem))
  (ProcItem (:or (: ProcSym symbol)
                 (: ProcStr string)
                 (: ProcFn ,(-> string string))
                 (: ProcArgv (Vec string))
                 (: ProcSub (ProcItem ...)))))

(: render (-> ProcItem string))
(defun (render item)
  (match item
    ((ProcSym s) (symbol->string s))
    ((ProcStr s) (string-append "\"" (string-append s "\"")))
    ((ProcFn f) (f "@"))
    ((ProcArgv v) (string-append "[" (string-append (vec-fold (fun (s acc) (string-append acc s)) "" v) "]")))
    ((ProcSub items) (string-append "(" (string-append (render-all items) ")")))))

;; The alias of the grammar in the signature.
(: render-all (-> ProcList string))
(defun (render-all items)
  (match items
    (Nil "")
    ((Cons x Nil) (render x))
    ((Cons x rest) (string-append (render x) (string-append " " (render-all rest))))))

;; An ordinary function. No macro, and no annotated binding at the call sites
;; below.
(: run/lines (-> ProcList string))
(defun (run/lines items) (render-all items))

(: my-rot-13 (-> string string))
(defun (my-rot-13 s) (string-append "rot13" s))

;; Two productions that refer to each other. Each level reads by its own
;; production, so this is not a special case of a production that refers to
;; itself.
(def/grammar Odd
  (Odd (:or (: OddSym symbol) (: OddSub (Even ...))))
  (Even (:or (: EvenStr string) (: EvenSub (Odd ...)))))

(: show-odd (-> Odd string))
(defun (show-odd o)
  (match o
    ((OddSym s) (symbol->string s))
    ((OddSub es) (string-append "<" (string-append (show-evens es) ">")))))

(: show-even (-> Even string))
(defun (show-even e)
  (match e
    ((EvenStr s) s)
    ((EvenSub os) (string-append "{" (string-append (show-odds os) "}")))))

(: show-evens (-> (List Even) string))
(defun (show-evens es)
  (match es
    (Nil "")
    ((Cons x Nil) (show-even x))
    ((Cons x rest) (string-append (show-even x) (string-append " " (show-evens rest))))))

(: show-odds (-> (List Odd) string))
(defun (show-odds os)
  (match os
    (Nil "")
    ((Cons x Nil) (show-odd x))
    ((Cons x rest) (string-append (show-odd x) (string-append " " (show-odds rest))))))

;; Two cases carry a list. A written list is a `Sub`. `Args` takes only a
;; spliced `(List string)`, so a literal never selects it.
(def/grammar Item
  (:or (: Sym symbol)
       (: Str string)
       (: Sub (Item ...))
       (: Args ,(List string))))

(: show-item (-> Item string))
(defun (show-item i)
  (match i
    ((Sym s) (symbol->string s))
    ((Str s) s)
    ((Args a) (string-append "args:" (int->string (list-length a))))
    ((Sub items) (string-append "(" (string-append (show-items items) ")")))))

(: show-items (-> (List Item) string))
(defun (show-items items)
  (match items
    (Nil "")
    ((Cons x Nil) (show-item x))
    ((Cons x rest) (string-append (show-item x) (string-append " " (show-items rest))))))

;; A value of a union type is an element as it is. It is never a payload.
;; These two unions are not grammars. `Just` holds a type variable, and
;; `Wrap` holds the tree itself. `(list (Just 7) (Just 8))` must compile, and
;; `(list a b)` of two leaves must not put `b` in a `Wrap`.
(type (: (Opt %a) (Union Nothing (: Just %a))))
(type (: Tree (Union (: Leaf int) (: Wrap Tree))))

(: depth (-> Tree int))
(defun (depth t)
  (match t
    ((Leaf _) 0)
    ((Wrap u) (+ 1 (depth u)))))

(defun (main args)
  ;; As an argument, with nothing annotated anywhere.
  (expect "argument position"
          (run/lines '(pipe (ls "-l") (wc "-l")))
          "pipe (ls \"-l\") (wc \"-l\")")

  ;; Depth is not a special case. Each level reads its part of the literal by
  ;; the item of the case that the level above selected.
  (expect "deep nesting"
          (run/lines '(pipe (a (b (c "x")))))
          "pipe (a (b (c \"x\")))")

  ;; A spliced value has no literal shape, so its type selects the case. A
  ;; `(-> string string)` can only be a `ProcFn`.
  (expect "unquote selected by type"
          (run/lines '(pipe (ls) ,my-rot-13))
          "pipe (ls) rot13@")

  ;; `[...]` in a quote is a vec. It is not a list that starts with the
  ;; symbol `vec-literal`.
  (expect "vec literal in a quote"
          (run/lines '(pipe (ls ["-l" "-a"])))
          "pipe (ls [-l-a])")

  ;; An annotated binding.
  (def (: xs ProcList) '(pipe (ls "-l")))
  (expect "annotated binding" (run/lines xs) "pipe (ls \"-l\")")

  ;; A generic parameter expects no type, so no grammar reads a literal
  ;; there. See `errors/literal_no_expected_type.bjo`. An annotation solves
  ;; this: with one type, the grammar reads each element of the outer list as
  ;; a `ProcList`.
  (def (: many (List ProcList)) (list '(pipe (ls "-l")) '(wc)))
  (expect "list of literals"
          (list-foldl (fun (s acc) (string-append acc (string-append "|" s)))
                      ""
                      (list-map run/lines many))
          "|pipe (ls \"-l\")|wc")

  ;; An empty literal, and one with no nesting at all.
  (expect "flat literal" (run/lines '(ls "-l")) "ls \"-l\"")
  (expect "empty literal" (run/lines '()) "")

  ;; Mutual recursion: each level of the list uses the other production.
  (expect "mutually recursive productions"
          (show-evens '("a" (b ("c"))))
          "a {b <c>}")

  ;; A written list is a `Sub`, not an `Args`.
  (expect "a written list selects Sub"
          (show-items '(a (b "c")))
          "a (b c)")

  ;; You can write the `Args` constructor. Its parameter type is the expected
  ;; type of the literal inside it, as for a function.
  (expect "the splice-only case written out"
          (show-items (list (Sym 'x) (Args (list "y" "z"))))
          "x args:2")

  ;; Values of a union in a list of that union.
  (expect "a generic union's values" (list-length (list (Just 7) (Just 8))) 2)
  (def leaf-a (Leaf 1))
  (def leaf-b (Leaf 2))
  (expect "a recursive union's values are not wrapped"
          (list-map depth (list leaf-a leaf-b))
          (list 0 0))
  (expect "and one wrapped by hand stays as written"
          (list-map depth (list leaf-a (Wrap leaf-b)))
          (list 0 1))
  0)
