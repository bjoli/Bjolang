;; A defun and its signature listing keywords in different orders paired them
;; by position, and the error was a mismatch between two different keywords.
;; EXPECT-ERROR: 'f' takes its keywords in the order #:b #:a and its signature lists them as #:a #:b
(: f (-> int (#:a int) (#:b string) string))
(defun (f x #:b "b" #:a 1) (str x a b))

(defun (main args) 0)
