;; Day 6: Trash Compactor. Problems side by side, separated by blank columns,
;; with the operator in the last row. Part 1 reads each row of a problem as a
;; number; part 2 reads each column, its digits top to bottom.
(import "common.bjo")

(defun (main args)
  (def* (lines (input-lines args)) (width (vec-fold #(max (length &1) &2) 0 lines))
        (rows {vecing (string->vec (string-pad-right l width)) (:for l lines)})
        (last (- (length rows) 1)))
  (defun (cell r c) (ref (ref rows r) c))
  ;; The digits of (at i) for i in [from, to), as a number. Spaces are skipped.
  (defun (number from to at)
    (loop (:for i (range from to))
          (:let ch (at i))
          (:when (char-numeric? ch))
          (:acc n (folding 0L (+ (* n 10L) (cast System.Int64 (digit ch)))))
          => n))
  (defun (combine op xs)
    (if (char=? op #\*) (list-foldl * 1L xs) (list-foldl + 0L xs)))
  ;; The problems, as column ranges [from, to).
  (def ps
    (list-filter (fun ((Tuple from to)) (< from to))
                 (let go ((c (- width 1)) (to width) (acc Nil))
                   (cond ((< c 0) (Cons (Tuple 0 to) acc))
                         ((all? #(char=? (ref & c) #\space) rows)
                          (go (- c 1) c (Cons (Tuple (+ c 1) to) acc)))
                         (else (go (- c 1) to acc))))))
  (defun (op-of from to)
    (loop (:for c (range from to))
          (:acc op (folding #\+ (if (char=? (cell last c) #\space) op (cell last c))))
          => op))
  (defun (solve nums)
    {summing (combine (op-of from to) (nums from to)) (:for (Tuple from to) ps)})
  (println (solve (fun (from to) {listing (number from to #(cell r &)) (:for r (range 0 last))})))
  (println (solve (fun (from to) {listing (number 0 last #(cell & c)) (:for c (range from to))})))
  0)
