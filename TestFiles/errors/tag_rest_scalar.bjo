;; `#:rest` says a tag's arguments are its payload, so the case's one type is
;; the collection of them. A scalar has no element type to read, and saying so
;; once where the case is declared beats one error at every use.
;; EXPECT-ERROR: the tag's arguments are its payload, so the case's one type is the collection of them
;; EXPECT-ERROR: and it is 'Symbol'
(import (std prelude))

(type (: Q (Union (CFrom Symbol #:tag from #:rest)
                  (CPlain (List Symbol)))))

(defun (main args) 0)
