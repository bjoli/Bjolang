;; Functions named like the namespaces modules are compiled into: `std` for
;; (std ...), `text` for (text ...). For 319_import_named_like_namespace.bjo.

(export std text)

(import (std prelude))

(: (-> string string))
(defun (std s) (str "std " s))

(: (-> string string))
(defun (text s) (str "text " s))
