# Compiler and test output. Every .bjo that is built leaves these beside it.
# The libraries too: build_std.sh writes lib/std/*.dll, and the suite writes a
# .dll for every test compiled with --lib.
*.exe
*.dll

# Where the test runner last built the fixture libraries. A compiled module
# records the absolute paths of its dependencies, so a checkout that moved has
# to rebuild them however new they look.
TestFiles/inc/.built-from
*.pdb
*.deps.json
*.runtimeconfig.json

# What a build was built from, written by the compiler and read by `bjo` and
# `bjor` to decide whether there is anything to do. Absolute paths, so it means
# nothing in another checkout.
*.bjobuild

# .NET build directories.
bin/
obj/

# The lock that keeps two run_tests.sh out of one working tree.
.test-lock
/TestFiles/srcimport/importer
/TestFiles/071_blanket_across_dll
/Playground/lp.py
/Playground/*.bjo

# Working notes on how the CLR constraints came to be. Kept locally; what a
# reader of the repo needs is in Docs/Numerics.org and Docs/Syntax.org.
/Docs/Constraints.org

.fake
# Python bytecode from run_tests.py.
__pycache__/

# Per-test output from run_tests.py, rewritten on every run.
/TestFiles/.test-logs/

# Throwaway probes and repro cases. Kept locally; anything worth keeping moves
# into TestFiles/ or bench/.
/scratch/
