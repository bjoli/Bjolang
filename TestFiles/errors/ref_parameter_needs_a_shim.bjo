;; A method whose only overloads take ref parameters cannot be called, and the
;; error says what to do instead.
;; EXPECT-ERROR: ref, in and pointer parameters are not supported
;; EXPECT-ERROR: needs a C# shim
;; EXPECT-ERROR: ref int location
(import (std prelude))

(import/extern
  (increment (: System.Threading.Interlocked.Increment)))

(defun (main args)
  (increment 1)
  0)
