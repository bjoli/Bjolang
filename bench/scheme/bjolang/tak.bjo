;; TAK -- A vanilla version of the TAKeuchi function.
;; Arguments: count x y z expected

(import "common.bjo")

(: tak (-> int int int int))
(defun (tak x y z)
  (if (not (< y x))
      z
      (tak (tak (- x 1) y z)
           (tak (- y 1) z x)
           (tak (- z 1) x y))))

(defun (main args)
  (def x (arg-int args 1))
  (def y (arg-int args 2))
  (def z (arg-int args 3))
  (def expected (arg-int args 4))
  (run-benchmark "tak" (arg-int args 0) (fun () (tak x y z)) #(= & expected)))
