(import (std prelude))

(: rot-char (-> char char))
(defun (rot-char ch)
  (if (and (char-ci>=? #\a ch) (char-ci<=? ch  #\m))
      (-> (char->integer ch)
          (+ & 13))))

(def/trait (SetAt %c)
  (type key)
  (type val)
  (: set-at! (-> %c key val unit)))

(def/impl (SetAt (Array %a))
  (type key int)
  (type val %a)
  (defun (set-at! arr i v)
    (array-set! arr i v)))

(def/impl (SetAt (VecBuilder %a))
  (type key int)
  (type val %a)
  (defun (set-at! tv i v)
    (vecbuilder-set! tv i v)))

(type
  (: Bang (Union (ProcBang string) (ProcSym Symbol))))

(defun (main args)
  (def (: lst (List Bang)) (list "hej" 'bajs))
  (loop (:for a lst)
        (:do (match a
               ((ProcBang s) (println s))
               ((ProcSym  sym) (println (symbol->string sym))))))
  0)
