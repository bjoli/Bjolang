;; A comparison pattern in a published body, for 368_comparison_patterns.bjo.
;; `grade` takes a function, so its body is published and inlined where it is
;; called, and the importer reads the patterns back from the written form.
;;
;; The three ranges cover every int, so the match needs no `_`, and a `_`
;; would be refused as a clause that can never run. The match is an argument,
;; where a match is a C# switch expression, unless it holds a comparison.

(import (std prelude))

(export grade)

(: (-> (-> string string) int string))
(defun (grade f n)
  (f (match n
       ((:less-than 0) "invalid")
       ((:between 0 59) "fail")
       ((:at-least 60) "pass"))))
