;; A trait constraint has to travel up a chain of callers.
;;
;; Only `doubled` says `(where (Sized %s))`. Everything above it acquires the
;; constraint by calling something that has it — without that, the dictionary
;; would have nowhere to come from.

(def/trait (Sized %s)
  (: size (-> %s int)))

(def/impl (Sized (List %a))
  (defun (size l) (list-foldl (fun (acc x) (+ acc 1)) 0 l)))

(def/impl (Sized (Vec %a))
  (defun (size v) (vec-fold (fun (acc x) (+ acc 1)) 0 v)))

;; Declares the constraint.
(: doubled (-> %s int) (where (Sized %s)))
(defun (doubled s)
  (* 2 (size s)))

;; Inherits it from `doubled`.
(: mid (-> %s int))
(defun (mid s)
  (doubled s))

;; ...and again, one level further out.
(: outer (-> %s int))
(defun (outer s)
  (+ (mid s) 1))

;; Calls a constrained function at a concrete type, so it needs no constraint of
;; its own and must not acquire one.
(: concrete (-> int))
(defun (concrete)
  (mid (Cons 1 (Cons 2 Nil))))

(defun (main args)
  (displayln (int->string (outer [1 2 3])))                 ;; 2*3 + 1 = 7
  (displayln (int->string (outer (Cons 1 (Cons 2 Nil)))))   ;; 2*2 + 1 = 5
  (displayln (int->string (concrete)))                      ;; 2*2     = 4
  0)
