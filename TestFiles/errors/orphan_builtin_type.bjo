;; An implementation of an imported trait for a type of the runtime.
;;
;; `List` is declared by no module, so only the module that declares
;; `Displayed` may implement it for a list.

;; EXPECT-ERROR: Orphan Rule Violation
;; EXPECT-ERROR: so 'Displayed' cannot be implemented for it here

(import (std prelude))

(impl (Displayed (List int))
  (defun (display-into xs b) (stringbuilder-add-string! b "ints")))

(defun (main args) 0)
