;; A signature without a name takes the name of the definition directly
;; below it. With none there, it has no name to take.

;; EXPECT-ERROR: Syntax error at nameless_signature_orphan.bjo:8: a signature without a name, (: type), goes directly above

(import (std prelude))

(: (-> int int))
(println "not a definition")

(defun (main args) 0)
