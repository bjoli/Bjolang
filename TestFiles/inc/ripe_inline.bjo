;; For 384_prefix_replaces_bare.bjo: inline bodies that build and take apart
;; this module's own `Ripe`. An importer declares a `Ripe` of its own, with a
;; case of the same name; the bodies spliced there still mean this one.

(export Ripe ripe ripe-value)
(import (std prelude))

(type (: Ripe (Union (: MkRipe int))))

(: ripe (-> int Ripe))
(defun (ripe n) #:inline (MkRipe n))

(: ripe-value (-> Ripe int))
(defun (ripe-value r) #:inline
  (match r
    ((MkRipe n) n)))
