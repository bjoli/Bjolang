;; For 418_two_traits_one_name.bjo: a trait Pretty whose method gives a
;; string. inc/pretty_b.bjo has a different trait of the same name.
(export Pretty pretty)
(import (std prelude))
(def/trait (Pretty %a) (: pretty (-> %a string)))
(impl (Pretty int) (defun (pretty n) (str "a:" (displayed n))))
