;; `mk`'s element type appears only in its result, so it is held back: one
;; type for every call. `g` uses it, so `g` is not polymorphic in it either,
;; and calling `g` at two types is an error. It used to be quantified by `g`
;; and reach C# as a type argument nothing could infer.
;; EXPECT-ERROR: these types do not match

(import (std prelude))

(defun (main args)
  (defun (mk) Nil)
  (defun (g x) (cons x (mk)))
  (println (->str (list-length (g 1))))
  (println (->str (list-length (g "s"))))
  0)
