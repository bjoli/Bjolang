;; A .NET generic type is a type *constructor*, so its alias has to be written
;; applied to as many parameters as the type takes. Written bare, the alias would
;; name something that is not a type.
;; EXPECT-ERROR: is a generic type taking 1 argument(s)
;; EXPECT-ERROR: Import it applied to its parameters
(import (std prelude))

(import/class
  (Set (: Set.Set)))

(defun (main args) 0)
