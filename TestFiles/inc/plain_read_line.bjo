;; A module exporting a plain `read-line` of its own, for
;; `247_own_def_over_defbjouble.bjo` and `warnings/own_def_over_blocking.bjo`.
;; The prelude's `read-line` is a `defbjouble` that parks; this one is neither.
(import (std prelude))

(export read-line)

(: read-line (-> string string))
(defun (read-line s) (string-append s "?"))
