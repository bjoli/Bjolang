;; A dropped `Result`.
;;
;; An ordinary discard, and that is the point of the fixture: a `Result` is
;; caught by the same rule as an `int` and by nothing else. It used to be the
;; whole of a third level that `ignore` could not satisfy — see
;; `080_discard.bjo` for what replaced that.

;; EXPECT-ERROR: has type (Result System.Exception int) and is discarded
;; EXPECT-ERROR: write `(ignore ...)` around it

(import (std prelude))

(defun (main args)
  (try (string-length "hi") #:catch (System.Exception))
  0)
