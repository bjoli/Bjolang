<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <AssemblyName>CmlBench</AssemblyName>
        <RootNamespace>CmlBench</RootNamespace>
        <ServerGarbageCollection>true</ServerGarbageCollection>
        <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
        <NuGetAudit>false</NuGetAudit>
    </PropertyGroup>

    <ItemGroup>
        <!-- The runtime, not the CML layer on its own. Referencing the runtime is
             what keeps this a pure-C# path against the same assembly Bjolang links,
             so a regression here is a regression the language would also see. -->
        <ProjectReference Include="../../BjolangRuntime/BjolangRuntime.csproj" />
    </ItemGroup>

</Project>
