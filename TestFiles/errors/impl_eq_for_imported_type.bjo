;; An `Eq` implementation for a type another module declares.
;;
;; The orphan rule refuses it: neither `Eq` nor the type is this module's. The
;; implementation belongs in the declaring module; in the REPL, in the same
;; entry as the type.

;; EXPECT-ERROR: is declared in another module
;; EXPECT-ERROR: same entry as the type

(import (std prelude))
(import "../inc/kitchen.bjo")

(impl (Eq Tag)
  (defun (= a b) #t)
  (defun (eq-hash a) 0))

(defun (main args) 0)
