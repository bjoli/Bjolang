;; More positional arguments than the target has fixed parameters.
;;
;; `join` has none, so `"extra"` has nowhere to go. Overflowing it into the rest
;; slot instead would be statically safe — the element type is known — but it
;; means building a new array from the leading arguments and the collection
;; together, so it is left out for now and the shape is refused rather than
;; being given a second meaning later.

;; EXPECT-ERROR: fixed parameter(s) and 'apply' was given
;; EXPECT-ERROR: Everything before the collection fills a fixed parameter, one for one

(import (std prelude))

(: join (-> #:rest string string))
(defun (join #:rest parts) "")

(defun (main args)
  (def parts (list "a" "b"))
  (println (apply join "extra" parts))
  0)
