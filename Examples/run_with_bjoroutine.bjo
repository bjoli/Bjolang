;; This program demonstrates the (std run) module, and how it is integrated with bjoroutines
;; The main function runs a pipe catting the contents of this file, then pushes
;; everything through the bjoroutine my-rot13 and greps the output case-insesitively for
;; "bomb".
;;
;; my-rot13 runs in a background thread and interacts with the pipe in the same way
;; a program would in the same pipe position.
;;
;; This prints:
;; DANGER!
;; ;; this function is THE BOMB!

(import (std run))

;; Encryption and decryption are the same. It is the beauty of
;; rot-13. Or as, we say:
;; guvf shapgvba vf GUR OBZO!
(: rot13-char (-> Char Char))
(defun (rot13-char ch)
  (defun (char+int ch i)
    (-> (char->integer ch)
        (+ & i)
        integer->char))
  (cond
   ((<= #\a (char-downcase ch) #\m)
    (char+int ch 13))
   ((<= #\n (char-downcase ch) #\z)
    (char+int ch -13))
   (else ch)))

;; A filter function takes an in, an out and returns unit (unit is void)
;; The Filter type is defined in the (std run) module as a function that takes
;; an input port, an output port and returns unit.
(: my-rot13 Filter)
(defbjo (my-rot13 in out)
  (let lp ()
    (cond
     ((port-eof? in) unit)
     (else
      (write-char out (rot13-char (read-char in)))
      (lp)))))


(defun (main args)
  ;; run/string returns a Result of (Ok a-string)
  ;; ,my-rot13 is a bjoroutine, and will execute off the main thread
  ;; if (cat ...) for some reason hangs, my-rot13 will suspend until
  ;; data is available.
  (match (run/string '(pipe (cat "Examples/run_with_bjoroutine.bjo")
                            ,my-rot13
                            (grep "-i" "bomb")))
    ((Err e) (println "Command failed with ${e}"))
    ;; An empty result. 
    ((Ok "")
     (println "Everything is safe"))
    ((Ok r)
     (println "DANGER!")
     (println r)))
  0)
