;; EXPECT-ERROR: dyn_superclass_not_boxable.bjo:13:10: 'Same' cannot be boxed: it requires 'Eq'
;; A box of a trait holds the boxed value's implementation of each of the
;; trait's superclasses, and `Eq` cannot be boxed.
(import (std prelude))

(def/trait (Same %a)
  (where (Eq %a))
  (: tag (-> %a string)))

(impl (Same int) (defun (tag x) "int"))

(defun (main)
  (def d (dyn Same 1))
  (println (tag d))
  0)
