;; Set algebra runs at compile time, so a set that came out empty is caught
;; here rather than becoming an unreadable complaint about `[]` from .NET.

;; EXPECT-ERROR: This character set is empty

(import (std prelude))
(import (std rx))

(defun (main)
  (println (->str (rx-match? #rx((- :digit :digit)) "1")))
  0)
