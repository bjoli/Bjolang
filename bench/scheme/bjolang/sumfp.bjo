;; SUMFP -- Compute sum of integers from 0 to n using doubles.
;; Arguments: count n expected

(import "common.bjo")

(: run (-> double double))
(defun (run n)
  (let loop ((i n) (sum 0.0))
    (if (< i 0.0)
        sum
        (loop (- i 1.0) (+ i sum)))))

(defun (main args)
  (def n (arg-double args 1))
  (def expected (arg-double args 2))
  (run-benchmark "sumfp" (arg-int args 0) (fun () (run n)) #(= & expected)))
