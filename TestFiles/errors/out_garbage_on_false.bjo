;; TryGetValue leaves its out as default(TValue) on a miss, and says so with
;; [MaybeNullWhen(false)]. The tuple form would hand that value to Bjolang.
;; EXPECT-ERROR: An out that is garbage on false forces the Option form
;; EXPECT-ERROR: Declare the result as (Option %v)
(import (std prelude))

(import/class
  ((Dict %k %v) (: System.Collections.Generic.Dictionary)))

(import/extern
  (dict-try-get (: System.Collections.Generic.Dictionary.TryGetValue
                   (-> (Dict %k %v) %k (out %v) (Tuple bool %v)))))

(defun (main args) 0)
