;; (see ...) names something in scope.

;; EXPECT-ERROR: has (see ... zork ...), and nothing named zork is in scope here

(import (std prelude))

(:doc twice (summary "Doubles.") (arg x "The number.") (returns "Twice x.") (see zork))
(: twice (-> int int))
(defun (twice x) (* 2 x))

(defun (main args) 0)
