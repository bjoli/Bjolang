;; Two implementations of one trait for one type. The second replaced the
;; first without a word, and the C# then failed with two classes of one name.

;; EXPECT-ERROR: 'Describe' already has an implementation for int, at impl_duplicate.bjo:11:1. Remove one of them.

(import (std prelude))

(def/trait (Describe %a)
  (: describe (-> %a string)))

(impl (Describe int)
  (defun (describe x) "first"))

(impl (Describe int)
  (defun (describe x) "second"))

(defun (main args)
  (println (describe 1))
  0)
