;; Every conjunct matches, so every conjunct's binders are the clause's — and
;; two of them binding one name is two values for it.

;; EXPECT-ERROR: Invalid and pattern
;; EXPECT-ERROR: is bound by more than one of these

(import (std prelude))

(: f (-> (Option int) int))
(defun (f o)
  (match o
    ((and x (Some x)) x)
    (None 0)))

(defun (main args)
  (println (int->string (f None)))
  0)
