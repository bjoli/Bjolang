;; A trait used through a compiled module.
;;
;; `Foldable`, its `List`/`Vec` implementations and the `fold` method all reach
;; this file through `prelude.dll`'s export metadata: nothing here declares them.
(import (std prelude))
(import (std simpletest))

;; Generic over the collection: `fold` is dispatched through a dictionary, and
;; the element type `%item` arrives as a synthesized type parameter.
(: count (-> %c int) (where (Foldable %c)))
(defun (count c)
  (fold (fun (acc x) (+ acc 1)) 0 c))

;; Forwards its dictionary to another constrained function.
(: twice (-> %c int) (where (Foldable %c)))
(defun (twice c)
  (+ (count c) (count c)))

;; Inherits `(Foldable %c)` from `count` without declaring it: the constraint is
;; only reachable through the callee's signature.
(: quadruple (-> %c int))
(defun (quadruple c)
  (* 2 (twice c)))

(defun (main args)
    ;; Concrete receivers devirtualize to the impl class in prelude.dll.
    (expect "fold sums a Vec" (fold + 0 [1 2 3 4]) 10)
    (expect "fold sums a List" (fold + 0 (Cons 1 (Cons 2 Nil))) 3)

    ;; Generic receivers, at three different element types.
    (expect "count over a Vec of int" (count [1 2 3 4]) 4)
    (expect "count over a List of int" (count (Cons 1 (Cons 2 Nil))) 2)
    (expect "count over a Vec of string" (count ["a" "b" "c"]) 3)
    (expect "twice forwards its dictionary" (twice [1 2]) 4)
    (expect "quadruple inherits the constraint" (quadruple [1 2 3]) 12)
    0)
