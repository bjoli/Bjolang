;; std/http/client.bjo: the current version of the HTTP client.
;;
;; This module re-exports (std http client v1). A later major release of
;; Bjolang can point it at a newer version. Import (std http client v1) to
;; keep this version.

(import (std http client v1))

(re-export (everything-from (std http client v1)))
