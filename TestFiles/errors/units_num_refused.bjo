;; A function generic over Num does not take a number with a unit.

;; EXPECT-ERROR: '(double m)' does not satisfy 'Num', needed to call 'twice-squared'. A number with a unit is not a Num

(import (std prelude))

(def/dimension length #:base m)

(: twice-squared (-> %a %a) (where (Num %a)))
(defun (twice-squared x) (* 2 (* x x)))

(def y (twice-squared <3 m>))

(defun (main) 0)
