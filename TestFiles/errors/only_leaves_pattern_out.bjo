;; EXPECT-ERROR: Unknown constructor 'Pt'
;; EXPECT-ERROR: It is a constructor of the type 'Figure' of same_a
;;
;; In a pattern too. `make-pt` is listed and its result can be held, but taking
;; it apart by its constructor needs the type.

(import (std prelude))
(import (only "../inc/same_a.bjo" make-pt))

(defun (main)
  (match (make-pt 1)
    ((Pt n) n)))
