;; An ordered set compares its elements, so a type with no Ord cannot be one.
;; It was accepted, and the program failed at the second element with "At least
;; one object must implement IComparable".
;; EXPECT-ERROR: no implementation of trait 'Ord' for 'orderedset_without_ord/Pt', needed to call 'list->orderedset'
(import (std prelude))
(import (std orderedset))

(type (: Pt (Record (: x int) (: y int))))

(defun (main)
  (println (->str (orderedset-length (list->orderedset (list (Pt (x 1) (y 2)) (Pt (x 0) (y 2)))))))
  0)
