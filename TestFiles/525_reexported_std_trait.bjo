;; A trait of the standard library re-exported by a module outside it is the
;; same trait for the importer: the facade's implementations are found, with
;; or without an import of the trait's own module. A trait of the standard
;; library has its bare name as its key, which reading the facade must not
;; key to the facade.
(import (std prelude))
(import (std simpletest))
(import "inc/stdtrait_facade.bjo")

(defun (main)
  (expect "a method of the re-exported trait, at the facade's type" (chunk-size (span5 12)) 12)
  (expect "the facade's implementation"
          (vec-map (fun (r) (count r)) (chunks (span5 12) 0))
          [5 5 2])
  0)
