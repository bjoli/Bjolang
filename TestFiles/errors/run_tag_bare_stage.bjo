;; A keyword form with an item of the wrong kind.
;;
;; `(into-file string Form)` takes a file name as a string. Here the file name
;; is a symbol, so the compiler refuses the literal where you write it.
;;
;; A keyword is a keyword only at the head of a list. A bare `into-file` is a
;; program name.

;; EXPECT-ERROR: (into-file ...): expected a string

(import (std prelude))
(import (std run))

(defun (main args)
  (ignore
   (match (run/string '(pipe (echo "x") (into-file out.txt (cat))))
     ((Ok s) 0)
     ((Err e) 0)))
  0)
