;; `-?->` on a record field.
;;
;; A field holds a value, and a function value has one colour — the delegate
;; type it is stored as decides. `(Vec (-> A B))` cannot hold a mix either, and
;; for the same reason: monomorphisation is a compile-time answer, and a
;; runtime-polymorphic effect needs a uniform representation, which means
;; everything async, which means losing `Func<A, B>` interop entirely.
;;
;; So this is not a gap waiting to be filled in. It is the shape of the answer.

;; EXPECT-ERROR: -?-> says that a *parameter* may be given a function of either colour

(import (std prelude))

(type
  (: Handler (Record (: handle (-?-> string void)))))

(defun (main args) 0)
