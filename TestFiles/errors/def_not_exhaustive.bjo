;; The clause pattern and the `:fail` arms are a match over one scrutinee, so
;; between them they have to cover it.
;;
;; This is what the arms buy over a bare failure value: the compiler can tell
;; which value reaches nothing, and say so. `Blue` here matches neither the
;; clause nor the one arm, and a `def` has nowhere to send it.

;; EXPECT-ERROR: does not cover every value

(import (std prelude))

(type (: Colour (Union Red Green Blue)))

(: name (-> Colour string))
(defun (name c)
  (def Red c :fail ((Green "green")))
  "red")
