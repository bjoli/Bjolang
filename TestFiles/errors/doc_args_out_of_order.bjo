;; The arguments are documented in the order the function takes them.

;; EXPECT-ERROR: documents hi before lo, and clamp takes lo first

(import (std prelude))

(:doc clamp (summary "Clamps.") (arg x "The number.") (arg hi "The most.") (arg lo "The least.") (returns "x, clamped."))
(: clamp (-> int int int int))
(defun (clamp x lo hi) (max lo (min hi x)))

(defun (main args) 0)
