;; A trait with two implementations at one head, published for another module
;; to call.
(export Label label label-via)

(def/trait (Label %a)
  (: label (-> %a string)))

(impl (Label (List int))
  (defun (label xs) "ints"))

(impl (Label (List string))
  (defun (label xs) "strings"))

(: (-> %a string) (where (Label %a)))
(defun (label-via x) (label x))
