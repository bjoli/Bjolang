;; A `#:when` guard may fail, and then the value is still unmatched, so a
;; guarded clause covers nothing however irrefutable its pattern is.

;; EXPECT-ERROR: does not cover every value
;; EXPECT-ERROR: None reaches no clause

(import (std prelude))

(: describe (-> (Option int) string))
(defun (describe o)
  (match o
    ((Some n) (->str n))
    (None #:when #t "none")))

(defun (main args)
  (println (describe None))
  0)
