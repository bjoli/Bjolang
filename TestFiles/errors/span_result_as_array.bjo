;; A span is passed as an array, but a span a member answers is not one.
;; EXPECT-ERROR: answers a (System.ReadOnlySpan byte), and a span is not a Bjolang value
;; EXPECT-ERROR: C# glue
(import (std prelude))

(import/class
  (Encoding (: System.Text.Encoding)))

(import/extern
  (utf8 (: System.Text.Encoding.UTF8 #:get))
  (preamble (: System.Text.Encoding.Preamble (-> Encoding (Array byte)) #:get)))

(defun (main)
  (println (written (array->vec (preamble utf8))))
  0)
