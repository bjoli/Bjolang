;; n-ary arithmetic and chained comparison.
;;
;; `+ - * / %` left-fold and `< > <= >= =` chain, both desugared in the parser
;; to the binary applications the rest of the compiler already understands. So
;; an operator is still emitted infix, still allocates nothing, and still works
;; at whatever type C# has the operator on — no rest parameter and no trait.
(import (std prelude))
(import (std simpletest))

(: expect-b (-> string bool bool void))
(defun (expect-b label actual wanted)
  (if (eq? actual wanted)
      (println (string-append "ok: " label))
      (println (string-append "FAILURE: " label))))

;; A counter, so a chained comparison can be shown to evaluate each operand
;; exactly once rather than once per comparison it appears in.
(defun (main)
  (def calls (make-array 1))
  (array-set! calls 0 0)

  (defun (tick x)
    (array-set! calls 0 (+ (array-ref calls 0) 1))
    x)

  ;; ---- folding, at every arity -------------------------------------------
  (expect "(+ 1 2 3 4)" (+ 1 2 3 4) 10)
  (expect "(+ 5)" (+ 5) 5)
  (expect "(+)" (+) 0)
  (expect "(* 2 3 4)" (* 2 3 4) 24)
  (expect "(*)" (*) 1)

  ;; Left-associative, so these are (- (- 10 1) 2) and (/ (/ 100 5) 2).
  (expect "(- 10 1 2)" (- 10 1 2) 7)
  (expect "(/ 100 5 2)" (/ 100 5 2) 10)
  (expect "(% 17 10 4)" (% 17 10 4) 3)

  ;; ---- unary, as in Scheme ------------------------------------------------
  (expect "(- 5)" (- 5) -5)
  (expect "(- -5)" (- -5) 5)
  (expect "(- 2.5)" (double->string (- 2.5)) "-2.5")
  (expect "(- 3000000000L)" (long->string (- 3000000000L)) "-3000000000")

  ;; Negation keeps the operand's type rather than promoting to int, which is
  ;; what the cast in codegen is for.
  (def n 7)
  (expect "(- n)" (- n) -7)

  ;; Reciprocal. Integer division truncates, so this is 0 for ints — the same
  ;; answer C# gives, not a rational.
  (expect "(/ 2.0)" (double->string (/ 2.0)) "0.5")
  (expect "(/ 4)" (/ 4) 0)

  ;; ---- chained comparison -------------------------------------------------
  (expect-b "(< 1 2 3)" (< 1 2 3) #t)
  (expect-b "(< 1 3 2)" (< 1 3 2) #f)
  (expect-b "(< 3 2 1)" (< 3 2 1) #f)
  (expect-b "(> 3 2 1)" (> 3 2 1) #t)
  (expect-b "(<= 1 1 2)" (<= 1 1 2) #t)
  (expect-b "(>= 2 2 1)" (>= 2 2 1) #t)
  (expect-b "(= 1 1 1)" (= 1 1 1) #t)
  (expect-b "(= 1 1 2)" (= 1 1 2) #f)
  (expect-b "(< 1.5 2.5 3.5)" (< 1.5 2.5 3.5) #t)

  ;; Binary comparison is untouched.
  (expect-b "(< 1 2)" (< 1 2) #t)

  ;; A middle operand appears in two comparisons but must run once.
  (array-set! calls 0 0)
  (expect-b "(< 0 (tick 5) 10)" (< 0 (tick 5) 10) #t)
  (expect "middle operand evaluated once" (array-ref calls 0) 1)

  ;; Short-circuiting still holds: the second comparison is never reached, so
  ;; `tick` is not called at all.
  (array-set! calls 0 0)
  (expect-b "(< 5 1 (tick 9))" (< 5 1 (tick 9)) #f)
  (expect "short-circuit skips the tail" (array-ref calls 0) 0)

  ;; ---- operators as values ------------------------------------------------
  ;; Desugaring happens only in head position, so a bare operator is still the
  ;; binary function it always was.
  (expect "(fold + 0 ...)" (fold + 0 (Cons 1 (Cons 2 (Cons 3 Nil)))) 6)

  0)
