;; A member's where clause naming the trait's own implementor.
;;
;; What the implementor must satisfy is an impl-level matter, and it stays
;; refused there for a trait with associated types; a member may only
;; constrain its own type variables.

;; EXPECT-ERROR: constrains '%c', the trait's own implementor

(import (std prelude))

(def/trait (Weird %c)
  (: poke (-> %c int)
     (where (Iterable %c #:elem %e #:cursor %k))))

(defun (main) 0)
