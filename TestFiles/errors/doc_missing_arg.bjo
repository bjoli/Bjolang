;; Every argument without a default is documented.

;; EXPECT-ERROR: does not document the argument hi

(import (std prelude))

(:doc clamp (summary "Clamps.") (arg x "The number.") (arg lo "The least.") (returns "x, clamped."))
(: clamp (-> int int int int))
(defun (clamp x lo hi) (max lo (min hi x)))

(defun (main args) 0)
