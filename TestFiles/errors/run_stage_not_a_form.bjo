;; A number where a stage belongs.
;;
;; The stages of a pipeline are `run/Form`s, and a number is not a form. The
;; compiler reads the literal where you write it, so it refuses the stage
;; there, not `run` at start-up. The message tells what can come.

;; EXPECT-ERROR: (pipe ...): expected Form or the end of the list; found the number 7

(import (std prelude))
(import (std run))

(defun (main args)
  (ignore
   (match (run/string '(pipe (echo "x") 7))
     ((Ok s) 0)
     ((Err e) 0)))
  0)
