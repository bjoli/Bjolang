;; A bare clause propagates, and only `Option` and `Result` do.
;;
;; The rule is one check over the constructors the pattern leaves out: exactly
;; one, belonging to a type whose failure case carries nothing new. A user union
;; has no such case — there is no answer to what `(Stopped)` should become at
;; the body's type — so the failure has to be written.

;; EXPECT-ERROR: only propagates Option and Result

(import (std prelude))

(type (: State (Union (Running string) Stopped)))

(: describe (-> State string))
(defun (describe m)
  (def (Running since) m)
  (str "running since " since))
