;; Docs for std/stm/map.bjo, read through (:doc #:file "map.bjodoc"). The
;; texts are samizdat markup: code in prose is @code{...}.

(:doc #:module
  (summary "Transactional hash map (TMap) supporting fine-grained concurrent updates and CML retry.")
  (see TMap tmap-set! tmap-try-ref tmap-update!)
  (example """
    (import (std stm))
    (import (std stm map))

    (def stock (make-tmap))
    (def orders (make-tmap))

    (atomically (fun (tx) (tmap-set! tx stock "apples" 10)))

    ;; Deduct stock for order 17, or retry until sufficient inventory exists:
    (atomically
     (fun (tx)
       (let ((n (tmap-ref-or tx stock "apples" 0)))
         (if (< n 3)
             (tx-retry tx)
             (begin
               (tmap-set! tx stock "apples" (- n 3))
               (tmap-set! tx orders 17 "3 apples"))))))
    """)
  (reference """
    @code{(TMap K V)} is a concurrent hash map designed for software
    transactional memory. Key type K must implement @code{Eq} (providing
    @code{=} and @code{eq-hash}). All operations take a @code{Tx} transaction
    log parameter and execute within transactions via @code{atomically} or
    @code{atomically-evt}.

    @strong{Naming conventions.} Operations mirror the prelude's @code{Map}
    API using the @code{tmap-} prefix: @code{tmap-try-ref}, @code{tmap-ref-or},
    @code{tmap-set!}, @code{tmap-remove!}, and @code{tmap-update!}.

    @strong{Conditional retry.} When a required entry is absent, transactions
    can call @code{tx-retry} to suspend until the corresponding hash branch is
    updated.

    @strong{Fine-grained concurrency.} Implemented as a hash trie where each
    branch node is a separate transactional @code{Loc}. Lookups and updates
    access only the nodes along the key's hash path. Transactions modifying
    distinct keys rarely conflict. Map size is tracked using a striped
    @code{TCounter} to avoid bottlenecking concurrent insertions on a shared
    count (inspired by Haskell's @code{stm-containers}).

    @strong{Performance characteristics.} Lookups, insertions, and removals
    run in O(log32 n) time. Whole-map operations (@code{tmap-fold},
    @code{tmap->list}) read all branch locations, conflicting with any
    concurrent modification.
    """))

(:doc TMap
  (summary "Transactional hash map mapping %k to %v.")
  (tparam %k "The key type (must implement Eq).")
  (tparam %v "The value type.")
  (see make-tmap))

(:doc TMapSlot
  (summary "Internal slot node type for TMap.")
  (tparam %k "The key type.")
  (tparam %v "The value type."))

(:doc TMapBranch
  (summary "Internal branch node type for TMap.")
  (tparam %k "The key type.")
  (tparam %v "The value type."))

(:doc TMapChange
  (summary "Internal change descriptor type for TMap.")
  (tparam %k "The key type.")
  (tparam %v "The value type."))

(:doc make-tmap
  (summary "Creates an empty transactional hash map.")
  (returns "A new empty TMap."))

(:doc tmap-try-ref
  (summary "Returns (Some value) for key k within a transaction, or None if absent.")
  (arg tx "The transaction log context.")
  (arg m "The map.")
  (arg k "The key to look up.")
  (returns "(Some value) if k is present, otherwise None."))

(:doc tmap-ref
  (summary "Returns the value for key k within a transaction, raising if missing.")
  (arg tx "The transaction log context.")
  (arg m "The map.")
  (arg k "The key to look up.")
  (returns "The value associated with k.")
  (raises System.Collections.Generic.KeyNotFoundException "When k is not in the map."))

(:doc tmap-ref-or
  (summary "Returns the value for key k within a transaction, or a fallback default.")
  (arg tx "The transaction log context.")
  (arg m "The map.")
  (arg k "The key to look up.")
  (arg default "Fallback value returned if k is absent.")
  (returns "The value associated with k, or default."))

(:doc tmap-contains?
  (summary "Tests if key k exists in the map within a transaction.")
  (arg tx "The transaction log context.")
  (arg m "The map.")
  (arg k "The key to locate.")
  (returns "#t if k is present, otherwise #f."))

(:doc tmap-set!
  (summary "Associates key k with value v within a transaction.")
  (arg tx "The transaction log context.")
  (arg m "The map.")
  (arg k "The key.")
  (arg v "The value to associate with k."))

(:doc tmap-remove!
  (summary "Removes key k from the map within a transaction.")
  (arg tx "The transaction log context.")
  (arg m "The map.")
  (arg k "The key to remove."))

(:doc tmap-update!
  (summary "Updates or removes key k via transformation function f within a transaction.")
  (arg tx "The transaction log context.")
  (arg m "The map.")
  (arg k "The key.")
  (arg f "Function receiving (Some old-value) or None, returning (Some new-value) to update or None to remove.")
  (example """
    ;; Increment a counter entry:
    (tmap-update! tx counts word
                  (fun (old) (match old
                               ((Some n) (Some (+ n 1)))
                               (None (Some 1)))))
    """)
  (reference """
    Performs lookup and mutation in a single trie descent.
    """))

(:doc tmap-length
  (summary "Returns the number of keys in the map within a transaction.")
  (arg tx "The transaction log context.")
  (arg m "The map.")
  (returns "The count of key-value pairs.")
  (reference """
    Reads the underlying striped counter, conflicting with transactions that
    add or remove entries.
    """))

(:doc tmap-empty?
  (summary "Tests if the map contains no entries within a transaction.")
  (arg tx "The transaction log context.")
  (arg m "The map.")
  (returns "#t if empty, otherwise #f.")
  (reference """
    Inspects only the root trie branch without scanning all stripes.
    """))

(:doc tmap-fold
  (summary "Folds over all key-value entries in the map within a transaction.")
  (arg tx "The transaction log context.")
  (arg f "Accumulator function called as (f key value acc).")
  (arg init "Initial accumulator value.")
  (arg m "The map.")
  (returns "The final accumulator value.")
  (reference """
    Traverses all trie branches in hash order, conflicting with any concurrent
    modification to the map.
    """))

(:doc tmap->list
  (summary "Converts all entries in the map to a list of (Tuple key value) pairs within a transaction.")
  (arg tx "The transaction log context.")
  (arg m "The map.")
  (returns "A list of (Tuple key value) pairs in arbitrary hash order.")
  (reference """
    Traverses all trie branches, conflicting with any concurrent modification.
    """))
