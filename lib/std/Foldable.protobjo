(def/trait (Foldable %col)
  (type %item)
  (: fold (-> (-> %acc %item %acc) %acc %col %acc)))

(def/impl (Foldable (List %a))
  (type %item %a)
  (defun (fold f acc col)
    (list-foldl f acc col)))

(def/impl (Foldable (Vec %a))
  (type %item %a)
  (defun (fold f acc col)
    (vec-fold f acc col)))

;; `Foldable (Map %k %v)` is in `prelude.bjo` itself, with the rest of the Map
;; surface: it is written in terms of bindings this file is included above.

