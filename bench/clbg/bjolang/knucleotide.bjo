;; k-nucleotide: reads the third sequence of a fasta file from standard input,
;; and counts its k-mers in a hash table: the frequencies of all of length 1
;; and 2, and the counts of five given ones.

(import "harness.bjo")
(import (std fmt))
(import (std mutable map))

;; Sorted by count, the largest first, then by name.
(type/derive (Eq Ord) (: Freq (Record (: neg-count int) (: name string))))

;; The sequence after the line that starts with ">THREE", as the codes
;; 0 to 3 for A, C, G and T.
(: read-sequence (-> InputPort (Array byte)))
(defun (read-sequence in)
  (let skip ()
    (match (read-line/opt in)
      ((Some line) (unless (string-starts-with? line ">THREE") (skip)))
      (None unit)))
  (def sb (stringbuilder-empty))
  (let go ()
    (match (read-line/opt in)
      ((Some line)
       (unless (string-starts-with? line ">")
         (stringbuilder-add-string! sb line)
         (go)))
      (None unit)))
  (def bytes (string->bytes (stringbuilder->string sb)))
  (loop (:for i (range 0 (array-length bytes)))
        (:do (array-set! bytes i (code (array-ref bytes i)))))
  bytes)

(: code (-> byte byte))
(defun (code b)
  (match b
    (97uy 0uy) (65uy 0uy)
    (99uy 1uy) (67uy 1uy)
    (103uy 2uy) (71uy 2uy)
    (_ 3uy)))

;; Each k-mer is a long, two bits per nucleotide, the first one highest.
(: count-kmers (-> (Array byte) int (MutableMap long int)))
(defun (count-kmers sq k)
  (def counts (mutablemap))
  (def mask (- (shift-left 1L (* 2 k)) 1L))
  (def n (array-length sq))
  (let go ((i 0) (key 0L))
    (when (< i n)
      (def key (bitwise-and (bitwise-ior (shift-left key 2) (cast System.Int64 (array-ref sq i))) mask))
      (when (>= i (- k 1))
        (mutablemap-set! counts key (+ 1 (mutablemap-ref-or counts key 0))))
      (go (+ i 1) key)))
  counts)

(: key->string (-> long int string))
(defun (key->string key k)
  (def sb (stringbuilder-empty))
  (loop (:for i (down-from (- k 1) #:to 0))
        (:do (stringbuilder-add! sb
                                 (match (bitwise-and (shift-right key (* 2 i)) 3L)
                                   (0L #\A) (1L #\C) (2L #\G) (_ #\T)))))
  (stringbuilder->string sb))

(: string->key (-> string long))
(defun (string->key s)
  (string-fold (fun (c key)
                 (bitwise-ior (shift-left key 2)
                             (match c (#\A 0L) (#\C 1L) (#\G 2L) (_ 3L))))
               0L s))

(: write-frequencies (-> (Array byte) int void))
(defun (write-frequencies sq k)
  (def counts (count-kmers sq k))
  (def total (cast System.Double (- (+ (array-length sq) 1) k)))
  (def sorted
    (list-sort {listing (Freq (neg-count (- v)) (name (key->string key k)))
                        (:for (Tuple key v) (mutablemap->seq counts))}))
  (loop (:for f sorted)
        (:do (displayln (render->string [(.name f) " " (numeric (/ (* 100.0 (cast System.Double (- (.neg-count f)))) total)
                                                           #:precision 3)]))))
  (displayln ""))

(: write-count (-> (Array byte) string void))
(defun (write-count sq name)
  (def k (string-length name))
  (def counts (count-kmers sq k))
  (displayln #"${(mutablemap-ref-or counts (string->key name) 0)}\t${name}"))

(: run (-> (Vec string) void))
(defun (run args)
  (def sq (read-sequence (parameter-ref current-input-port)))
  (write-frequencies sq 1)
  (write-frequencies sq 2)
  (loop (:for name ["GGT" "GGTA" "GGTATT" "GGTATTTTAATT" "GGTATTTTAATTTATAGT"])
        (:do (write-count sq name))))

(defun (main args) (bench-main args #t run))
