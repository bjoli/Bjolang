;; The superclass of an imported trait holds the implementations written for it
;; here as well: it travels with the trait.

;; EXPECT-ERROR: 'Greet' requires 'Named' of every implementor, and 'Named' does not hold for superclass_missing_imported/Dog here.

(import (std prelude))
(import "../inc/superclass_traits.bjo")

(type (: Dog (Struct (: n int))))

(impl (Greet Dog)
  (defun (greeting d) "woof"))

(defun (main args) 0)
