;; A trait can require only one declared before it, which is also what keeps
;; two traits from requiring each other.

;; EXPECT-ERROR: 'Greet' cannot require 'Named': no trait of that name is declared before it.

(import (std prelude))

(def/trait (Greet %a)
  (where (Named %a))
  (: greeting (-> %a string)))

(def/trait (Named %a)
  (: name-of (-> %a string)))

(defun (main args) 0)
