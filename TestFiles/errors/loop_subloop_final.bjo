;; `:final` is not supported inside a `:subloop` form.

;; EXPECT-ERROR: (:final ...) at loop_subloop_final.bjo:12 is not supported inside a (:subloop ...) form.

(import (std prelude))

(: f (-> (List (List int)) (List int)))
(defun (f rows)
  (loop (:for row rows)
        (:subloop (:for y row)
                  (:acc s (summing y))
                  (:final (> s 3)))
        (:acc out (listing s))))

(defun (main) (println (int->string (list-length (f '((1)))))) 0)
