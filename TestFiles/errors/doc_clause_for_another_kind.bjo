;; A clause a record's doc does not take.

;; EXPECT-ERROR: has (arg ...), and Point is a record. Its doc takes summary, see, example, reference, field, tparam

(import (std prelude))

(:doc Point (summary "A place.") (arg x "Across.") (field x "Across.") (field y "Up."))
(type (: Point (Record (: x int) (: y int))))

(defun (main args) 0)
