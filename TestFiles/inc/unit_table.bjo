;; Units for 510_unit_decls.bjo: two dimensions, a prefix and a unit.
(import (std prelude))

(export seconds-per-hour)

(def/dimension length #:base m)
(def/dimension time #:base s #:carrier double)
(def/prefix k 1000)
(def/prefix m "1|1000")
(def/unit h "3600 s")

(: seconds-per-hour (-> int))
(defun (seconds-per-hour) 3600)
