;; A :for runs out, and then the loop has no value: it needs `=>` for that
;; exit, even though it also ends by (:finish test value).

;; EXPECT-ERROR: two branches here give values of different types.

(import (std prelude))

(: find-negative (-> (List int) int))
(defun (find-negative xs)
  (loop (:for x xs)
        (:finish (< x 0) x)))

(defun (main) 0)
