;; `#:no-inline` and `#:inline` on one definition, in that order.
;;
;; The same refusal as the other order: the parser takes `#:no-inline` off
;; first, so this order is checked where it does.

(import (std prelude))

;; EXPECT-ERROR: A definition is #:inline or #:no-inline, not both.
(: (-> int int))
(defun (f x) #:no-inline #:inline (+ x 1))

(defun (main args) (f 1))
