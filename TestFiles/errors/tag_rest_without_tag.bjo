;; An untagged case's payload already describes the whole literal, so a case of
;; many is written `(List T)` with no marker at all. `#:rest` on one would mean
;; nothing.
;; EXPECT-ERROR: says that a *tag's* arguments are its payload
(import (std prelude))

(type (: Q (Union (CPlain (List Symbol) #:rest))))

(defun (main args) 0)
