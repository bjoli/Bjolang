;; An implementation of an imported trait for an imported type.
;;
;; A module that imports the type's module but not this one would take the
;; blanket `Displayed` at `Tag`, and this one its own: one value, two ways of
;; being displayed. An implementation is written with its trait or its type.

;; EXPECT-ERROR: Orphan Rule Violation
;; EXPECT-ERROR: is declared in another module, so 'Displayed' cannot be implemented for it here
;; EXPECT-ERROR: newtype

(import (std prelude))
(import "../inc/kitchen.bjo")

(impl (Displayed Tag)
  (defun (display-into t b) (stringbuilder-add-string! b "a tag")))

(defun (main args) 0)
