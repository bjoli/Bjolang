;; `set!` with two operands writes a variable, so the first has to be a name.
;; The message gives both forms.

;; EXPECT-ERROR: Invalid set! syntax
;; EXPECT-ERROR: (set! name value), which writes a variable, or (set! target step ... value)

(import (std prelude))

(defun (main args)
  (def a (make-array 1 #:fill 0))
  (set! (ref a 0) 1)
  0)
