;; The value written to a property is of the wrong type. A property write is
;; not overload selection, so nothing scored the value before it was cast.

;; EXPECT-ERROR: foreign_setter_value.bjo:16:25
;; EXPECT-ERROR: the .NET type 'System.Diagnostics.ProcessStartInfo' is wanted here

(import (std prelude))

(import/class (Process (: System.Diagnostics.Process (-> Process))))
(import/extern
  (set-info! (: System.Diagnostics.Process.StartInfo (-> Process System.Diagnostics.ProcessStartInfo void) #:set)))

(type (: Thing (Union (: A string) B)))

(defun (main args)
  (set-info! (Process.) (A "x"))
  0)
