;; A `def` whose pattern may fail has to say what happens when it does.
;;
;; Nothing written is not a silent propagation: it says the pattern matches
;; every value, and a pattern that does not is refused here rather than given a
;; failure path nobody asked for. The failure parts are `:leave-with`,
;; `:leave`, `:default` and `:propagate`.

;; EXPECT-ERROR: a def with no failure part has nowhere to send it

(import (std prelude))

(: lookup (-> string (Option string)))
(defun (lookup k) (if (= k "host") (Some k) None))

(: size (-> string (Option int)))
(defun (size k)
  (def (Some found) (lookup k))
  (Some (string-length found)))
