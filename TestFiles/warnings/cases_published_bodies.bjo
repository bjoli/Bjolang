;; The bodies of `inc/cases_published.bjo` name a case several of its unions
;; have, and were published with the case each use means. Published by its
;; spelling alone, a body named one union's case where the other's was meant,
;; and could neither be specialised nor inlined here.

;; EXPECT-NO-WARNING: could not specialise
;; EXPECT-NO-WARNING: could not inline

(import (std prelude))
(import (prefix "../inc/cases_published.bjo" "c/"))

(type (: Fruit (Union Apple Pear)))

(impl (c/Describe Fruit)
  (defun (describe f) "fruit"))

(defun (main)
  (println (c/light-red? 3 (c/first-light)))
  (println (c/suit-code c/Red))
  (println (c/describe (c/first-light)))
  (println (c/default-suit Apple))
  0)
