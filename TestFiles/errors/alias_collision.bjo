;; Rule 5: an alias is a top-level binding, so a name the module defines for
;; itself is not something a second spelling may quietly take over.
;;
;; EXPECT-ERROR: Alias Error: 'doubled'
;; EXPECT-ERROR: is also defined in this module

(: doubled (-> int int))
(defun (doubled x)
  (* x 2))

(:alias doubled println)

(defun (main)
  0)
