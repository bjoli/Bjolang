;; `(dyn Eq)` — en trait vars metod nämner implementorn två gånger.
;;
;; Två lådor säger ingenting om varandra: de kan dölja var sin typ, och `=` har
;; då ingen typ att köras vid. Regeln gäller traiten och inte anropsstället, så
;; den ställs där `(dyn ...)` skrivs och namnger metoden som bryter den.
;;
;; EXPECT-ERROR: 'Eq' cannot be boxed
;; EXPECT-ERROR: '=' mentions %a 2 times

(import (std prelude))

(: same? (-> (dyn Eq) bool))
(defun (same? d) #t)

(defun (main args) 0)
