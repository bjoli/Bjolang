;; std/unicode/normalize.bjo — Unicode normalization (UAX #15): NFC, NFD,
;; NFKC and NFKD.
;;
;; - The tables are generated by gen_normalize.py into normalize-*.bin, and
;;   compiled into the assembly with include-bytes. They do not depend on
;;   .NET or ICU, so every platform normalizes the same way.
;; - Hangul syllables decompose and compose by arithmetic, as in the Unicode
;;   Standard, section 3.12.
;;
;; Cost:
;; - Each function first makes the quick check of UAX #15, section 9. A
;;   string that passes it is returned as it is, with no copy. ASCII passes
;;   without the table.
;; - Otherwise the part from the last character that the check allows to
;;   stay is decomposed into an array of code points, put in canonical
;;   order, and, for NFC and NFKC, composed again. The part before it is
;;   copied.
;; - A decomposition is a binary search over about 2,000 (canonical) or
;;   6,000 (compatibility) entries. A composition is a binary search over
;;   961 pairs, made only for a character that can be the second of one.

(export
  normalize-unicode-version
  string-nfc string-nfd string-nfkc string-nfkd
  string-nfc? string-nfd? string-nfkc? string-nfkd?)

;; The core, so that (std prelude) can import this module.
(import (std prelude core))

(:doc #:file "normalize.bjodoc")

(include "normalize-table.protobjo")

;; ---------------------------------------------------------------------------
;; The tables
;; ---------------------------------------------------------------------------

(: string)
(def normalize-unicode-version unicode-version)

;; The tables are compiled into the assembly (see `include-bytes`). Each is a
;; property, so initializing the module decodes and copies nothing. The
;; layout of each is in gen_normalize.py.

;; The block of each 256 code points.
(: (RoSpan byte))
(def stage1 (include-bytes "normalize-stage1.bin"))

;; The blocks: for each code point, the index of its property in `kinds`.
(: (RoSpan byte))
(def stage2 (include-bytes "normalize-stage2.bin"))

;; The properties that occur.
(: (RoSpan int))
(def kinds (include-bytes "normalize-kinds.bin" #:of int))

;; The property of the code point `cp`:
;; - bits 0-7, Canonical_Combining_Class;
;; - bit 8, set when it has a canonical decomposition (NFD_QC No);
;; - bit 9, set when it has a decomposition of either kind (NFKD_QC No);
;; - bits 10-11, NFC_QC, and bits 12-13, NFKC_QC: 0 Yes, 1 Maybe, 2 No.
(: (-> int int) #:inline)
(defun (props-of cp)
  (if (< cp 128)
      0
      (ro-span-ref kinds (cast int (ro-span-ref stage2 (+ (shift-left (cast int (ro-span-ref stage1 (shift-right cp 8))) 8)
                                                          (bitwise-and cp 255)))))))

(: (-> int int) #:inline)
(defun (class-of p) (bitwise-and p 255))

;; The full decompositions. A table is `count` code points in order, then
;; the start of each one's decomposition (`count` + 1 of them, the last the
;; end), then the code points of the decompositions.
(: (RoSpan int))
(def canonical (include-bytes "normalize-canonical.bin" #:of int))

(: (RoSpan int))
(def compatibility (include-bytes "normalize-compatibility.bin" #:of int))

;; The index of `x` in the first `count` entries of `table`, which are in
;; order, or -1.
(: (-> (RoSpan int) int int int))
(defun (search table count x)
  (let go ((lo 0) (hi count))
    (if (>= lo hi)
        -1
        (let* ((mid (shift-right (+ lo hi) 1))
               (k (ro-span-ref table mid)))
          (cond
            ((< x k) (go lo mid))
            ((> x k) (go (+ mid 1) hi))
            (else mid))))))

;; The pairs that compose, as `first * 0x110000 + second`, in order.
(: (RoSpan long))
(def composition-keys (include-bytes "normalize-composition-keys.bin" #:of long))

;; The composite of each pair.
(: (RoSpan int))
(def composites (include-bytes "normalize-composites.bin" #:of int))

;; ---------------------------------------------------------------------------
;; Hangul syllables
;; ---------------------------------------------------------------------------

(: int) (def s-base 0xAC00)
(: int) (def l-base 0x1100)
(: int) (def v-base 0x1161)
(: int) (def t-base 0x11A7)
(: int) (def l-count 19)
(: int) (def v-count 21)
(: int) (def t-count 28)
(: int) (def n-count 588)
(: int) (def s-count 11172)

(: (-> int bool) #:inline)
(defun (syllable? cp) (and (>= cp s-base) (< cp (+ s-base s-count))))

;; ---------------------------------------------------------------------------
;; The forms
;; ---------------------------------------------------------------------------

;; A form is NFD with `compat?` and `compose?` false, NFKD with `compat?`,
;; NFC with `compose?`, and NFKC with both.

;; The quick check of a property, for a form: 0 Yes, 1 Maybe, 2 No.
(: (-> int bool bool int) #:inline)
(defun (quick-check p compat? compose?)
  (cond
    ((and compose? compat?) (bitwise-and (shift-right p 12) 3))
    (compose? (bitwise-and (shift-right p 10) 3))
    (compat? (if (= (bitwise-and p 512) 0) 0 2))
    (else (if (= (bitwise-and p 256) 0) 0 2))))

;; The result of the quick check of a string, and where normalization must
;; start when it is not Yes: the cursor of the last character before the
;; failure whose quick check is Yes and whose combining class is 0. Nothing
;; before that character changes.
(type (: Check (Record (: verdict int)
                       (: restart StringCursor))))

(: (-> string bool bool Check))
(defun (check s compat? compose?)
  (def start (string-cursor-start s))
  (let go ((c start) (safe start) (last-class 0) (verdict 0))
    (if (string-cursor-end? s c)
        (Check (verdict verdict) (restart safe))
        (let* ((r (string-cursor-ref+next s c))
               (cp (char->int (fst r)))
               (p (props-of cp))
               (cls (class-of p))
               (qc (quick-check p compat? compose?)))
          (cond
            ((and (> last-class cls) (not (= cls 0))) (Check (verdict 2) (restart safe)))
            ((= qc 2) (Check (verdict 2) (restart safe)))
            (else
             (go (snd r)
                 (if (and (= verdict 0) (= qc 0) (= cls 0)) c safe)
                 cls
                 (if (= qc 1) 1 verdict))))))))

;; ---------------------------------------------------------------------------
;; Normalization
;; ---------------------------------------------------------------------------

;; A growing array of code points.
(type (: Buffer (Record (: data (Array int) #:mutable)
                        (: size int #:mutable))))

(: (-> int Buffer))
(defun (make-buffer capacity) (Buffer (data (make-array (max capacity 8))) (size 0)))

;; Adds `cp` in canonical order: a character of a combining class other than
;; 0 goes before those of a higher class that end the buffer.
(: (-> Buffer int void))
(defun (add-ordered! buf cp)
  (def n (record-ref buf size))
  (when (= n (array-length (record-ref buf data)))
    (record-set! buf (data (array-resize (record-ref buf data) (* 2 n)))))
  (def data (record-ref buf data))
  (def cls (class-of (props-of cp)))
  (def at
    (if (= cls 0)
        n
        (let go ((j n))
          (if (and (> j 0) (> (class-of (props-of (array-ref data (- j 1)))) cls))
              (begin (array-set! data j (array-ref data (- j 1))) (go (- j 1)))
              j))))
  (array-set! data at cp)
  (record-set! buf (size (+ n 1))))

;; Adds the full decomposition of `cp` to `buf`.
(: (-> Buffer int bool void))
(defun (add-decomposed! buf cp compat?)
  (def p (props-of cp))
  (cond
    ((= (bitwise-and p (if compat? 512 256)) 0) (add-ordered! buf cp))
    ((syllable? cp)
     (def s (- cp s-base))
     (add-ordered! buf (+ l-base (/ s n-count)))
     (add-ordered! buf (+ v-base (/ (% s n-count) t-count)))
     (def t (% s t-count))
     (when (> t 0) (add-ordered! buf (+ t-base t))))
    (compat? (add-mapped! buf compatibility compatibility-count cp))
    (else (add-mapped! buf canonical canonical-count cp))))

;; Adds the decomposition of `cp` in `table`, of `count` entries.
(: (-> Buffer (RoSpan int) int int void))
(defun (add-mapped! buf table count cp)
  (def i (search table count cp))
  (def targets (+ (* 2 count) 1))
  (let go ((k (ro-span-ref table (+ count i))))
    (when (< k (ro-span-ref table (+ count i 1)))
      (add-ordered! buf (ro-span-ref table (+ targets k)))
      (go (+ k 1)))))

;; The primary composite of `first` and `second`, or -1.
(: (-> int int int))
(defun (composite first second)
  (cond
    ;; L + V
    ((and (>= first l-base) (< first (+ l-base l-count)) (>= second v-base) (< second (+ v-base v-count)))
     (+ s-base (* (+ (* (- first l-base) v-count) (- second v-base)) t-count)))
    ;; LV + T
    ((and (syllable? first) (= (% (- first s-base) t-count) 0)
          (> second t-base) (< second (+ t-base t-count)))
     (+ first (- second t-base)))
    (else
     (def key (+ (* (cast long first) 1114112L) (cast long second)))
     (let go ((lo 0) (hi composition-count))
       (if (>= lo hi)
           -1
           (let* ((mid (shift-right (+ lo hi) 1))
                  (k (ro-span-ref composition-keys mid)))
             (cond
               ((< key k) (go lo mid))
               ((> key k) (go (+ mid 1) hi))
               (else (ro-span-ref composites mid)))))))))

;; Composes the decomposed, ordered code points of `buf` in place: the
;; canonical composition algorithm of UAX #15. A character composes with the
;; last starter when nothing between them blocks it: no character of class 0,
;; and none of the same or a higher class.
(: (-> Buffer void))
(defun (compose! buf)
  (def data (record-ref buf data))
  (def n (record-ref buf size))
  (when (> n 1)
    (def first-class (class-of (props-of (array-ref data 0))))
    ;; A string that starts with a combining character has no starter to
    ;; compose with until the first one: 256 blocks every composition.
    (let go ((i 1) (out 1) (starter 0) (last-class (if (= first-class 0) 0 256)))
      (if (= i n)
          (record-set! buf (size out))
          (let* ((cp (array-ref data i))
                 (p (props-of cp))
                 (cls (class-of p))
                 ;; Only a character whose NFC_QC is Maybe can be the second
                 ;; of a composite.
                 (made (if (and (= (bitwise-and (shift-right p 10) 3) 1)
                                (or (< last-class cls) (= last-class 0)))
                           (composite (array-ref data starter) cp)
                           -1)))
            (if (>= made 0)
                (begin (array-set! data starter made) (go (+ i 1) out starter last-class))
                (begin
                  (array-set! data out cp)
                  (go (+ i 1) (+ out 1) (if (= cls 0) out starter) cls))))))))

;; The normal form of `s`, whose part before `from` is already normal.
(: (-> string StringCursor bool bool string))
(defun (normalize-from s from compat? compose?)
  (def buf (make-buffer (string-length s)))
  (let go ((c from))
    (when (not (string-cursor-end? s c))
      (def r (string-cursor-ref+next s c))
      (add-decomposed! buf (char->int (fst r)) compat?)
      (go (snd r))))
  (when compose? (compose! buf))
  (def sb (stringbuilder-empty))
  (stringbuilder-add-substring! sb s (string-cursor-start s) from)
  (def data (record-ref buf data))
  (loop (:for i (range 0 (record-ref buf size)))
        (:do (stringbuilder-add! sb (int->char (array-ref data i)))))
  (stringbuilder->string sb))

(: (-> string bool bool string))
(defun (normalize s compat? compose?)
  (def c (check s compat? compose?))
  (if (= (.verdict c) 0)
      s
      (normalize-from s (.restart c) compat? compose?)))

(: (-> string bool bool bool))
(defun (normalized? s compat? compose?)
  (def c (check s compat? compose?))
  (match (.verdict c)
    (0 #t)
    (2 #f)
    (_ (= (normalize-from s (.restart c) compat? compose?) s))))

;; ---------------------------------------------------------------------------
;; Strings
;; ---------------------------------------------------------------------------

(: (-> string string))
(defun (string-nfc s) (normalize s #f #t))

(: (-> string string))
(defun (string-nfd s) (normalize s #f #f))

(: (-> string string))
(defun (string-nfkc s) (normalize s #t #t))

(: (-> string string))
(defun (string-nfkd s) (normalize s #t #f))

(: (-> string bool))
(defun (string-nfc? s) (normalized? s #f #t))

(: (-> string bool))
(defun (string-nfd? s) (normalized? s #f #f))

(: (-> string bool))
(defun (string-nfkc? s) (normalized? s #t #t))

(: (-> string bool))
(defun (string-nfkd? s) (normalized? s #t #f))
