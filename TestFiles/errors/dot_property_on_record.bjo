;; `.-brand` reads a .NET property. A record's field is read with `.brand`.

;; EXPECT-ERROR: '.-brand' reads a .NET property, but its target has the record type
;; EXPECT-ERROR: Write (.brand ...) to read it.

(import (std prelude))

(type (: Car (Record (: brand string))))

(defun (main args)
  (def c (Car (brand "banana")))
  (println (.-brand c))
  0)
