;; For 353_current_module.bjo: a function and a macro, each using
;; `(current-module)`.
(export lib-module where-expanded)

(import (std prelude))
(import (std syntax-match))

;; Written here, so it answers this module wherever it is called from.
(: (-> string))
(defun (lib-module) (current-module))

;; Written in a template, so it answers the module the macro expands in.
(def/macro (where-expanded form inject compare)
  (syntax-match form
    ((_) #'(current-module))
    (bad (syntax-error bad "where-expanded takes nothing."))))
