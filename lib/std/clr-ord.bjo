;; Ordering for common .NET types.
(export DateTime DateTimeOffset TimeSpan DateOnly TimeOnly Guid Version)

(import (std prelude))

;; Provides Ord trait implementations for common .NET types.
(import/class
  (DateTime       (: System.DateTime))
  (DateTimeOffset (: System.DateTimeOffset))
  (TimeSpan       (: System.TimeSpan))
  (DateOnly       (: System.DateOnly))
  (TimeOnly       (: System.TimeOnly))
  (Guid           (: System.Guid))
  (Version        (: System.Version)))

;; Implements Ord using CompareTo.
(impl (Ord DateTime)
  (defun (compare a b) (.CompareTo a b)))

(impl (Ord DateTimeOffset)
  (defun (compare a b) (.CompareTo a b)))

(impl (Ord TimeSpan)
  (defun (compare a b) (.CompareTo a b)))

(impl (Ord DateOnly)
  (defun (compare a b) (.CompareTo a b)))

(impl (Ord TimeOnly)
  (defun (compare a b) (.CompareTo a b)))

(impl (Ord Guid)
  (defun (compare a b) (.CompareTo a b)))

;; Implements Ord for Version using CompareTo.
(impl (Ord Version)
  (defun (compare a b) (.CompareTo a b)))
