;; Deriving for a type alias.
;;
;; An alias is a second spelling of a type rather than a type of its own: there
;; is nothing to write an implementation for, and one written here would be an
;; implementation for whatever it names — declared in the wrong module, with the
;; orphan rule having nothing to say about it.

;; EXPECT-ERROR: has to be a Record, a Struct or a Union

(import (std prelude))

(type/derive (Eq)
  (: Name string))

(defun (main args) 0)
