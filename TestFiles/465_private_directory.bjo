;; A directory whose name starts with `_` is kept to the directory it is in.
;; `inc/private_facade.bjo` is beside `inc/_private/` and may import it; this
;; file may not (`errors/private_dir_import.bjo`), and uses what the facade
;; offers, whose code links the hidden module without this file importing it.
(import (std prelude))
(import (std simpletest))
(import "inc/private_facade.bjo")

(defun (main)
  (expect "through the module beside the _ directory" (answer) 42)
  0)
