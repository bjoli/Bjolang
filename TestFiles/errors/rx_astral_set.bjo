;; A character class is written in UTF-16 units, so it cannot name a scalar
;; above U+FFFF. Matching one as a literal is fine, and the message says so.

;; EXPECT-ERROR: A character set is limited to U+0000..U+FFFF

(import (std prelude))
(import (std rx))

(defun (main)
  (println (->str (rx-match? #rx((in #\😀)) "😀")))
  0)
