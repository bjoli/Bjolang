;; A `(:view ...)` decides its clause by running code, and nothing here reasons
;; about what a step returns. So a view covers nothing, and a clause list made
;; only of views has to end in a binder.

;; EXPECT-ERROR: does not cover every value
;; EXPECT-ERROR: _ reaches no clause

(import (std prelude))

(: describe (-> int string))
(defun (describe n)
  (match n
    ((:view even? #t) "even")
    ((:view even? #f) "odd")))

(defun (main args)
  (println (describe 1))
  0)
