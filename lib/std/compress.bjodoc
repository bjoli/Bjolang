;; Docs for std/compress.bjo, read through (:doc #:file "compress.bjodoc").
;; The texts are samizdat markup: code in prose is @code{...}.

(:doc #:module
  (summary "gzip, zlib, deflate and Brotli: ports that decompress what they read, and ports that compress what is written to them.")
  (see gzip-input-port gzip-output-port CompressLevel)
  (example """
    (import (std prelude))
    (import (std ports))
    (import (std compress))

    ;; Write a .gz file. Closing the gzip port ends the compressed data;
    ;; the file is closed after it.
    (with-open ((file (raise-err (open-output-file "log.txt.gz"))))
      (with-open ((gz (gzip-output-port file)))
        (write-string gz "first line\n")
        (write-string gz "second line\n")))

    ;; Read it back a line at a time.
    (with-open ((file (raise-err (open-input-file "log.txt.gz"))))
      (port->lines (gzip-input-port file)))
    """)
  (reference """
    @bold{Each format} has a pair: @code{gzip-input-port} and
    @code{gzip-output-port}, and the same for @code{zlib-}, @code{deflate-}
    and @code{brotli-}. gzip is what @code{.gz} files and HTTP's
    @code{Content-Encoding: gzip} hold; zlib is deflate with a short header
    and a checksum, as in PNG; deflate is the raw data, as in a zip entry;
    Brotli is HTTP's @code{br}.

    @bold{The new port is owned by the ambient scope}, as a file port is,
    and the port under it is left open. Closing an output port writes the
    last block and the format's trailer into the port under it, so close it
    before that port. A scope releases what it owns in the reverse order
    it was opened in, which is that order.

    @bold{Reads and writes suspend} a fiber where the port under them would:
    the compressor reads and writes through the port's own operations.

    @bold{An error in the data} raises from the read that finds it.
    @itemize{
      @item{@bold{Data that ends early} raises
        @code{System.IO.EndOfStreamException}, for gzip, zlib and deflate: a
        deflate stream has to reach its last block, and a gzip or zlib stream
        its trailer.}
      @item{@bold{Data that is not the format}, and a gzip CRC-32, a gzip
        length or a zlib Adler-32 that does not match, raise
        @code{System.IO.InvalidDataException}. The check is made at the
        trailer, so the reads before it have returned the data already.}
      @item{@bold{Brotli} raises @code{System.InvalidOperationException} on
        bad data, as .NET's decoder does, and does not detect data that ends
        early.}}

    @bold{The gzip, zlib and deflate decoders are written in Bjolang},
    over @code{make-input-port}; the compressors and the Brotli decoder are
    .NET's. The decoders are about a third as fast as .NET's.

    @bold{An input port reads ahead} from the port under it, past the end
    of the compressed data. Give it a port that ends where the data ends:
    a file, or a @code{limited} view of a longer port.
    """))

(:doc CompressLevel
  (summary "How hard an output port compresses.")
  (case CompressFastest "Fast, and larger.")
  (case CompressOptimal "A balance of speed and size. The default.")
  (case CompressSmallest "As small as the format can, and slow.")
  (case CompressNone "Stored as it is, in the format's framing.")
  (see gzip-output-port brotli-output-port))

(:doc gzip-input-port
  (summary "A port that reads gzip data from a port and returns it decompressed.")
  (arg p "The port with the gzip data.")
  (returns "A new input port, owned by the ambient scope. Closing it leaves p open.")
  (see gzip-output-port zlib-input-port brotli-input-port)
  (example """
    (with-open ((file (raise-err (open-input-file "access.log.gz"))))
      (read-line (gzip-input-port file)))
    """)
  (reference """
    A file of several gzip members, as @code{cat a.gz b.gz} makes, is read
    as one: the members' data one after another. Raises
    @code{InvalidDataException} on data that is not gzip, on a CRC-32 or a
    length that does not match the data, and on bytes after the last member
    that are not another member. Raises @code{EndOfStreamException} on data
    that ends before a member's trailer.
    """))

(:doc gzip-output-port
  (summary "A port that compresses what is written to it as gzip into a port.")
  (arg p "The port the gzip data is written to.")
  (key level "How hard to compress. CompressOptimal unless given.")
  (returns "A new output port, owned by the ambient scope. Closing it writes the trailer into p and leaves p open.")
  (see gzip-input-port CompressLevel)
  (example """
    (with-open ((file (raise-err (open-output-file "data.json.gz"))))
      (with-open ((gz (gzip-output-port file #:level CompressSmallest)))
        (write-string gz json)))
    """)
  (reference """
    @code{flush-port} writes out what has been compressed so far, so that a
    reader at the other end of a connection can decompress it. Flushing
    often makes the data larger.
    """))

(:doc zlib-input-port
  (summary "A port that reads zlib data from a port and returns it decompressed.")
  (arg p "The port with the zlib data.")
  (returns "A new input port, owned by the ambient scope. Closing it leaves p open.")
  (see zlib-output-port gzip-input-port deflate-input-port))

(:doc zlib-output-port
  (summary "A port that compresses what is written to it as zlib into a port.")
  (arg p "The port the zlib data is written to.")
  (key level "How hard to compress. CompressOptimal unless given.")
  (returns "A new output port, owned by the ambient scope. Closing it writes the checksum into p and leaves p open.")
  (see zlib-input-port CompressLevel))

(:doc deflate-input-port
  (summary "A port that reads raw deflate data from a port and returns it decompressed.")
  (arg p "The port with the deflate data.")
  (returns "A new input port, owned by the ambient scope. Closing it leaves p open.")
  (see deflate-output-port zlib-input-port)
  (reference """
    Raw deflate has no header and no checksum: a damaged stream may read as
    other data rather than raise. Data that ends before the last block does
    raise @code{EndOfStreamException}. Prefer gzip or zlib where you choose
    the format.
    """))

(:doc deflate-output-port
  (summary "A port that compresses what is written to it as raw deflate into a port.")
  (arg p "The port the deflate data is written to.")
  (key level "How hard to compress. CompressOptimal unless given.")
  (returns "A new output port, owned by the ambient scope. Closing it writes the last block into p and leaves p open.")
  (see deflate-input-port CompressLevel))

(:doc brotli-input-port
  (summary "A port that reads Brotli data from a port and returns it decompressed.")
  (arg p "The port with the Brotli data.")
  (returns "A new input port, owned by the ambient scope. Closing it leaves p open.")
  (see brotli-output-port gzip-input-port)
  (reference """
    Raises @code{System.InvalidOperationException} on data that is not
    Brotli, not @code{InvalidDataException} as the other formats do.
    """))

(:doc brotli-output-port
  (summary "A port that compresses what is written to it as Brotli into a port.")
  (arg p "The port the Brotli data is written to.")
  (key level "How hard to compress. CompressOptimal unless given.")
  (returns "A new output port, owned by the ambient scope. Closing it writes the last block into p and leaves p open.")
  (see brotli-input-port CompressLevel)
  (reference """
    Brotli compresses text smaller than gzip, and CompressSmallest is much
    slower than CompressOptimal.
    """))
