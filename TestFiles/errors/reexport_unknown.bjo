;; A re-exported name that is neither a binding nor a type.
;;
;; The message has to say which two namespaces were looked in, because "not in
;; scope" is the one thing a reader already knows: they wrote the name.

;; EXPECT-ERROR: A re-exported name must be a binding or a type this module imported.

(import (std prelude))
(import "../inc/reexport_facade.bjo")

(re-export Nonsense)

(defun (main args) 0)
