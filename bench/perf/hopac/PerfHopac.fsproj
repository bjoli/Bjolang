<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <AssemblyName>PerfHopac</AssemblyName>
        <RootNamespace>PerfHopac</RootNamespace>
        <ServerGarbageCollection>true</ServerGarbageCollection>
        <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
        <!-- Hopac 0.5.1 predates the nullable/trim analyzers; its warnings are noise here. -->
        <NoWarn>FS0044;NU1701;NU1902;NU1903</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <Compile Include="Program.fs" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Hopac" Version="0.5.1" />
    </ItemGroup>

</Project>
