(import (std prelude))

(type
  (: Bang (Union (ProcBang string) (ProcSym Symbol))))

(defun (main args)
  (def (: lst (List Bang)) (list "hej" 'bajs))
  (loop (:for a lst)
        (:do (match a
               ((ProcBang s) (println s))
               ((ProcSym  sym) (println (symbol->string sym))))))
  0)
