;; A collector macro's own syntax-error is reported at the clause.
;;
;; EXPECT-ERROR: (:acc name (summing-squares x))

(import "../inc/acc_macros.bjo")

(defun (main args)
  (println (int->string (loop (:for x [1 2])
                              (:acc s (summing-squares x x))
                          => s)))
  0)
