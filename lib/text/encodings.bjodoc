;; Docs for text/encodings.bjo, read through (:doc #:file "encodings.bjodoc").
;; The texts are samizdat markup: code in prose is @code{...}.

(:doc #:module
  (summary "Every character encoding .NET knows, as a value, and finding one by name.")
  (see encoding-named encoding-of-code-page encoding-name)
  (example """
    (import (only (text encodings) utf-16be windows-1252 encoding-named))

    (string->bytes "blåbär" #:encoding utf-16be)
    (bytes->string bs #:encoding windows-1252)
    (match (encoding-named "Shift_JIS")
      ((Some e) (bytes->string bs #:encoding e))
      (None "an encoding nothing here knows"))
    """)
  (reference """
    An encoding is an @code{Encoding}, the prelude's name for .NET's
    @code{System.Text.Encoding}. This module exports one for each of the
    139 encodings .NET provides, the Windows and DOS code pages included,
    named as .NET names them, in lower case: @code{utf-8}, @code{us-ascii},
    @code{iso-8859-1}, @code{windows-1252}, @code{dos-862}, @code{koi8-r},
    @code{shift_jis}, @code{big5}, @code{gb18030}, @code{ibm437},
    @code{x-mac-cyrillic} and the rest.

    @strong{Two exceptions.} .NET's @code{utf-16} and @code{utf-32} are
    little-endian; here they are @code{utf-16le} and @code{utf-32le}, next
    to @code{utf-16be} and @code{utf-32be}. Where .NET gives two code pages
    one name, the less common is @code{cp} and its number: @code{euc-jp} is
    code page 51932 and @code{cp20932} the other, @code{iso-2022-jp} is
    50220 and @code{cp50222} the other.

    @strong{Strict or lenient is not the encoding's.} @code{bytes->string}
    and @code{string->bytes} fail on what does not convert unless given a
    replacement; a port reads what does not decode as U+FFFD. The same value
    serves both.

    @strong{No byte order marks.} The Unicode encodings neither write a mark
    nor skip one: a mark is the character U+FEFF.

    @strong{Cost.} An encoding is made the first time its name is used and
    kept; importing the module makes none. UTF-7 is not provided, as .NET
    has stopped providing it.
    """))

(:doc encoding-named
  (summary "The encoding a name means, as a charset header would give it.")
  (arg name "A name, in any case: the names this module exports, and every name and alias .NET knows (latin1, cp1252, Shift-JIS, unicodeFFFE).")
  (returns "(Some encoding), or None for a name nothing knows.")
  (see encoding-name encoding-of-code-page)
  (example """
    (encoding-named "Windows-1252")   ; (Some windows-1252)
    (encoding-named "latin1")         ; (Some iso-8859-1)
    (encoding-named "utf-7")          ; None
    """)
  (reference """
    Space around the name is ignored. .NET's own names come after this
    module's, so @code{utf-16} means what .NET means by it, little-endian.
    The value is the same object the module exports under its own name.
    """))

(:doc encoding-of-code-page
  (summary "The encoding of a Windows code page number.")
  (arg code-page "The number: 1252, 862, 65001.")
  (returns "(Some encoding), or None for a number no encoding has.")
  (see encoding-named encoding-name)
  (example """
    (encoding-of-code-page 862)     ; (Some dos-862)
    (encoding-of-code-page 65000)   ; None: UTF-7
    """))

(:doc encoding-name
  (summary "The name this module exports an encoding under.")
  (arg encoding "An encoding.")
  (returns "Its name here, or .NET's name for it in lower case for one made elsewhere.")
  (see encoding-named)
  (example """
    (encoding-name windows-1252)   ; "windows-1252"
    (encoding-name utf-16le)       ; "utf-16le"
    """))

