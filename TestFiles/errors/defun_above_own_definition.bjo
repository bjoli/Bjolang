;; A function body that reads an imported name the module defines again further
;; down, at another type. The checker typed the use as the imported string, and
;; the emitted code read the module's own int.

;; EXPECT-ERROR: `label` is used here, above this module's own definition of it

(import (std prelude))
(import "../inc/value_k.bjo")

(: shout (-> string))
(defun (shout) (string-upcase label))

(: label int)
(def label 3)

(defun (main args)
  (println (shout))
  0)
