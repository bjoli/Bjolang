;; `#:async` on a method that returns no task.
;;
;; Answered at the import, not at the first call: the claim was made here, and
;; whether it is true does not depend on any argument. An import nobody got
;; around to using is still wrong.

;; EXPECT-ERROR: is imported #:async
;; EXPECT-ERROR: no overload of it returns a Task or a ValueTask

(import (std prelude))

(import/extern
  (absolute (: System.Math.Abs #:async)))

(defbjo (main args) 0)
