;; text/bjodat-core.bjo
;;
;; The bjodat value, the reader and the writer. The reader reads the document's
;; UTF-8 bytes.
;;
;; **This is the machinery, not the interface.** `(text bjodat)` is what a
;; program imports: it declares a record and generates a decoder that reads the
;; text straight into it, with no `Bjodat` value in between. What is here is
;; what that decoder is built out of, and what a program reaches for directly
;; only when the shape of its data is not known until run time.
;;
;; A program that declares records with `def/bjodat-type` does not need this
;; module: `(text bjodat)` re-exports `Bjodat`, `Reader` and the one-pass
;; driver, so one import covers the generator, the traits and the writer. What
;; is left here, and the reason to import it by name, is the *tree* —
;; `parse-bjodat`, `bjodat-ref` and the entry accessors.
;;
;; It used to be imported alongside `(text bjodat)` always, and the comment
;; here said a facade could not spare you the second line. It can; I was wrong
;; about what `re-export` could be made to do. See `re-export` in
;; `Docs/MODULES.org`.
;;
;; Source's shapes, read as data: a bare identifier is a Symbol rather than a
;; reference, and `{...}` is a map rather than a comprehension. A file is a
;; stream of values.
;;
;; A map is held as a *flat* vec of alternating key and value, in the order it
;; was written. Not a trie, for two reasons that a benchmark settled: building
;; one is about seventy percent of what reading a keyed document costs, and a
;; record decoded from it reads every field once and then throws it away. A
;; linear scan of reference comparisons over a handful of interned keywords is
;; cheaper than hashing them. Keeping the order is what lets a value be written
;; back out looking like what was read.

(export
  Bjodat
  bjodat-max-depth
  read-bjodat parse-bjodat
  read-bjodat-all parse-bjodat-all
  bjodat->string
  bjodat-entry-count bjodat-entry-key bjodat-entry-value bjodat-ref
  ;; What a generated one-pass decoder drives. Not an API for people: see the
  ;; section it is defined in.
  Reader
  open-map! next-key! end-entry! key=? field-value skip-value!
  ;; The same, for a record written as a tagged form: `(tag (field value) ...)`.
  open-form! next-field! end-clause! skip-clause! clause-values!
  read-one-pass parse-one-pass read-one-pass-all parse-one-pass-all)

(import (std prelude))
(import (only (std ports) read-some))

;; Every export is documented there; the module doc is too.
(:doc #:file "bjodat-core.bjodoc")

(import/extern
  (clr-to-long   (: Bjolang.Runtime.BjoNum.ParseLong))
  (clr-to-double (: Bjolang.Runtime.BjoNum.ParseDouble)))

(import/extern
  (clr-nan?               (: System.Double.IsNaN              (-> double bool)))
  (clr-positive-infinity? (: System.Double.IsPositiveInfinity (-> double bool)))
  (clr-negative-infinity? (: System.Double.IsNegativeInfinity (-> double bool))))

;; Hex and binary, which have no reader of their own.
(import/extern
  (clr-radix-long (: System.Convert.ToInt64 (-> string int long)
                     #:exceptions (System.OverflowException System.FormatException))))

;; ---------------------------------------------------------------------------
;; The value
;; ---------------------------------------------------------------------------

(type
  (: Bjodat (Union
             (: BjoBool bool)
             (: BjoInt long)
             (: BjoFloat double)
             (: BjoStr string #:literal)
             (: BjoChar char)
             (: BjoSym Symbol)
             (: BjoKey Keyword)
             (: BjoList (List Bjodat))
             (: BjoVec (Vec Bjodat))
             ;; key, value, key, value — an even length, in written order.
             (: BjoMap (Vec Bjodat)))))

(: bjodat-max-depth int)
(def bjodat-max-depth 200)

;; --- what a map is, for anyone holding one ---------------------------------

(: bjodat-entry-count (-> (Vec Bjodat) int))
(defun (bjodat-entry-count entries) (/ (vec-length entries) 2))

(: bjodat-entry-key (-> (Vec Bjodat) int Bjodat))
(defun (bjodat-entry-key entries i) (vec-ref entries (* i 2)))

(: bjodat-entry-value (-> (Vec Bjodat) int Bjodat))
(defun (bjodat-entry-value entries i) (vec-ref entries (+ (* i 2) 1)))

;; A keyword key, found by reference. Written order, so the first wins.
(: bjodat-ref (-> (Vec Bjodat) Keyword (Option Bjodat)))
(defun (bjodat-ref entries k)
  (def n (vec-length entries))
  (let go ((i 0))
    (if (>= i n)
        None
        (match (vec-ref entries i)
          ((BjoKey kk) (if (eq? kk k) (Some (vec-ref entries (+ i 1))) (go (+ i 2))))
          (_ (go (+ i 2)))))))

;; ---------------------------------------------------------------------------
;; The name cache
;; ---------------------------------------------------------------------------
;; A document repeats its names. A manifest of twenty thousand records writes
;; the same five keys twenty thousand times, and interning one costs a string
;; built off the scratch buffer and then a dictionary probe — so almost every
;; one of those allocations is of a string that already exists.
;;
;; This holds the last name seen in each slot and compares the buffer against it
;; without building a string, which is what `stringbuilder=?` is for. A hit
;; costs that comparison and nothing else. A miss costs what interning
;; always cost, plus the failed comparison.
;;
;; Direct-mapped rather than associative: a probe is one comparison, and two
;; names colliding costs a miss rather than a wrong answer. Sized for the number
;; of distinct names a *record* has, not the number of records.
;;
;; This was a class in `BjolangRuntime/BjoText.cs` — a hundred lines of C# that
;; existed for one library. It is here instead because a library in the standard
;; library should not need a file in the runtime; what the runtime owes it is
;; primitives, and `stringbuilder-code-ref` and `stringbuilder=?` are the two it
;; was missing.

(: name-slots int)
(def name-slots 16)

;; Empty slots hold `""`. No name of any other length can equal it, and a name
;; that *is* empty answers `""`, which is the right answer anyway — so there is
;; no empty case to test for. `make-array` would leave nulls, which
;; `string-length` would not survive.
(: new-name-cache (-> (Array string)))
(defun (new-name-cache)
  (def a (make-array name-slots))
  (loop (:for i (range 0 name-slots))
        (:do (array-set! a i "")))
  a)

;; The first unit and the length. Cheap, and enough to separate the names of one
;; record: `version` and `commit` differ by length, `git` and `name` by both.
(: name-slot (-> StringBuilder int int))
(defun (name-slot sb n)
  (if (= n 0)
      0
      (bitwise-and (bitwise-xor (* (stringbuilder-code-ref sb 0) 31) n)
                   (- name-slots 1))))

;; The buffer's contents as a string, reusing the one already handed out for
;; those same units.
;;
;; This stops short of answering the interned `Keyword` itself, which would save
;; the probe inside `string->keyword` as well. Nothing here can: interning is
;; the runtime's, and a name read from a port is not known until it is read.
(: cached-name (-> (Array string) StringBuilder string))
(defun (cached-name cache sb)
  (def n (stringbuilder-length sb))
  (def i (name-slot sb n))
  (def name (array-ref cache i))
  (cond
    ((stringbuilder=? sb name) name)
    (else
     (def s (stringbuilder->string sb))
     (array-set! cache i s)
     s)))

;; ---------------------------------------------------------------------------
;; The reader
;; ---------------------------------------------------------------------------
;; The reader works on bytes: a chunk of the document in `bytes`, the one it is
;; looking at at `next`, and `limit` where the chunk ends. Looking is an array
;; load and stepping is an increment. A chunk comes from the port with
;; `read-some`; the `parse-` readers hand over the string's own bytes as the
;; one chunk there is, and no port.
;;
;; All the format's punctuation is ASCII. A character of several bytes - in a
;; string, a symbol, a keyword or a character literal - is checked to be UTF-8
;; and copied whole; one that is not UTF-8 is refused. A column counts
;; characters: only a byte that starts one moves it.
;;
;; The byte is handled as a number, so that the end of the document is a
;; value, `spent`, rather than a second case.

(: spent int)
(def spent -1)

(type
  (: Reader (Record (: port (Option InputPort) #:mutable)
                    (: bytes (Array byte) #:mutable)
                    (: next int #:mutable)
                    (: limit int #:mutable)
                    (: row int #:mutable)
                    (: col int #:mutable)
                    ;; One buffer for every string, symbol and number.
                    (: scratch StringBuilder)
                    ;; One array for every list, vec and map in the document.
                    (: stack (Array Bjodat) #:mutable)
                    (: top int #:mutable)
                    ;; One cache for every name in the document.
                    (: names (Array string)))))

;; A reader over `bytes`, and then whatever `port` has after them.
(: reader (-> (Option InputPort) (Array byte) Reader))
(defun (reader port bytes)
  (Reader (port port)
          (bytes bytes)
          (next 0)
          (limit (array-length bytes))
          (row 1)
          (col 1)
          (scratch (stringbuilder-empty))
          (stack (make-array 16))
          (top 0)
          (names (new-name-cache))))

(: push! (-> Reader Bjodat void))
(defun (push! rd v)
  (def a (record-ref rd stack))
  (def n (record-ref rd top))
  (cond
    ((< n (array-length a)) (array-set! a n v))
    (else
     (def bigger (array-resize a (* n 2)))
     (array-set! bigger n v)
     (record-set! rd (stack bigger))))
  (record-set! rd (top (+ n 1))))

(: harvest! (-> Reader int (Vec Bjodat)))
(defun (harvest! rd mark)
  (def v (subarray->vec (record-ref rd stack) mark (- (record-ref rd top) mark)))
  (record-set! rd (top mark))
  v)

(: buffer (-> Reader StringBuilder))
(defun (buffer rd)
  (def sb (record-ref rd scratch))
  (stringbuilder-clear! sb)
  sb)

;; `count` bytes of `old` from `from`, then `more`: what is left of one chunk
;; and the next. Almost always nothing is left, and `more` is the answer.
(: join-bytes (-> (Array byte) int int (Array byte) (Array byte)))
(defun (join-bytes old from count more)
  (if (= count 0)
      more
      (let ((joined (make-array (+ count (array-length more)))))
        (loop (:for i (range 0 count))
              (:do (array-set! joined i (array-ref old (+ from i)))))
        (loop (:for i (range 0 (array-length more)))
              (:do (array-set! joined (+ count i) (array-ref more i))))
        joined)))

;; Whether there are at least `n` bytes from `next` on, reading from the port
;; until there are or it ends. Bytes not yet looked at are kept, so a
;; character cut in two by the end of a chunk is whole afterwards.
(: ensure! (-> Reader int bool))
(defun (ensure! rd n)
  (let go ()
    (def have (- (record-ref rd limit) (record-ref rd next)))
    (cond
      ((>= have n) #t)
      (else
       (match (record-ref rd port)
         (None #f)
         ((Some p)
          (match (read-some p)
            (None
             (record-set! rd (port None))
             #f)
            ((Some more)
             (record-set! rd
                          (bytes (join-bytes (record-ref rd bytes) (record-ref rd next) have more))
                          (next 0)
                          (limit (+ have (array-length more))))
             (go)))))))))

;; The byte the reader is looking at, or `spent` at the end of the document.
(: held-code (-> Reader int))
(defun (held-code rd)
  (def i (record-ref rd next))
  (cond
    ((< i (record-ref rd limit)) (cast int (array-ref (record-ref rd bytes) i)))
    ((ensure! rd 1) (cast int (array-ref (record-ref rd bytes) (record-ref rd next))))
    (else spent)))

(: at-end? (-> Reader bool))
(defun (at-end? rd) (= (held-code rd) spent))

;; Anything that is not ASCII answers #\nul, because every character this is
;; asked about is one of the format's own punctuation.
(: peek (-> Reader char))
(defun (peek rd)
  (def c (held-code rd))
  (if (and (>= c 0) (< c 128)) (integer->char c) #\nul))

;; Moves past the byte being looked at, which is a character of its own: every
;; caller has just looked at it and found it ASCII. A character of several
;; bytes is taken by `take-character!`.
(: step! (-> Reader void))
(defun (step! rd)
  (record-set! rd
               (next (+ (record-ref rd next) 1))
               (col (+ (record-ref rd col) 1))))

(: newline! (-> Reader void))
(defun (newline! rd)
  (record-set! rd
               (next (+ (record-ref rd next) 1))
               (row (+ (record-ref rd row) 1))
               (col 1)))

;; --- characters of several bytes --------------------------------------------

(: not-utf-8 string)
(def not-utf-8 "a byte that is not UTF-8")

;; How many bytes a character starting with `lead` has, by RFC 3629; 0 for a
;; byte no character starts with: a continuation byte, C0 and C1 (which could
;; only start an overlong form), and F5 and up.
(: utf8-length (-> int int))
(defun (utf8-length lead)
  (cond
    ((< lead 128) 1)
    ((< lead 194) 0)
    ((< lead 224) 2)
    ((< lead 240) 3)
    ((< lead 245) 4)
    (else 0)))

(: continuation? (-> int bool))
(defun (continuation? b) (= (bitwise-and b 192) 128))

;; How many bytes the character the reader is looking at has, when they are
;; UTF-8; 0 when they are not, or the document ends inside them. The second
;; byte is narrower after E0 and F0, which would otherwise start an overlong
;; form, after ED, which would start a surrogate, and after F4, which would
;; go past U+10FFFF.
(: sequence-length (-> Reader int))
(defun (sequence-length rd)
  (def lead (held-code rd))
  (def n (utf8-length lead))
  (cond
    ((<= n 1) n)
    ((not (ensure! rd n)) 0)
    (else
     (def b (record-ref rd bytes))
     (def i (record-ref rd next))
     (def second (cast int (array-ref b (+ i 1))))
     (def low (cond ((= lead 224) 160) ((= lead 240) 144) (else 128)))
     (def high (cond ((= lead 237) 159) ((= lead 244) 143) (else 191)))
     (if (and (>= second low)
              (<= second high)
              (let check ((k 2))
                (cond
                  ((>= k n) #t)
                  ((continuation? (cast int (array-ref b (+ i k)))) (check (+ k 1)))
                  (else #f))))
         n
         0))))

;; Copies the `n` bytes of the character being looked at into `sb`, and moves
;; past them: one column.
(: take-character! (-> Reader StringBuilder int void))
(defun (take-character! rd sb n)
  (def b (record-ref rd bytes))
  (def i (record-ref rd next))
  (loop (:for k (range 0 n))
        (:do (stringbuilder-add-code! sb (cast int (array-ref b (+ i k))))))
  (record-set! rd
               (next (+ i n))
               (col (+ (record-ref rd col) 1))))

;; The character being looked at, of `n` bytes known to be UTF-8.
(: held-character (-> Reader int char))
(defun (held-character rd n)
  (def i (record-ref rd next))
  (vec-ref (string->vec (bytes->string (record-ref rd bytes) #:start i #:end (+ i n))) 0))

;; The character being looked at, `c`, copied into `sb` and stepped past: an
;; ASCII byte as it is, a character of several bytes once it is known to be
;; UTF-8. False, having taken nothing, when it is not.
(: add-held! (-> Reader StringBuilder int bool))
(defun (add-held! rd sb c)
  (cond
    ((< c 128)
     (stringbuilder-add-unit! sb c)
     (step! rd)
     #t)
    (else
     (def n (sequence-length rd))
     (cond
       ((= n 0) #f)
       (else
        (take-character! rd sb n)
        #t)))))

;; --- character classes ------------------------------------------------------

;; A `case` rather than a chain of `=`: it is a C# switch, which Roslyn turns
;; into a jump table, and this is asked about every character of the document.
(: space-code? (-> int bool))
(defun (space-code? c)
  (case c
    ((32 10 9 13) #t)
    (else #f)))

;; What ends a name: whitespace, the end of the port (`spent`, -1), or one of
;; the delimiters the lexer refuses inside a symbol — ( ) [ ] { } , : " ; '
;;
;; One case rather than three calls and fifteen comparisons, because
;; `take-name!` asks this per character of every symbol, keyword and number.
;;
;; A `.` and a `/` are deliberately absent: they are symbol characters, which
;; is what makes `net8.0` and `bjolang/http` one symbol each.
(: symbol-code? (-> int bool))
(defun (symbol-code? c)
  (case c
    ((-1 32 10 9 13 40 41 91 93 123 125 44 58 34 59 39) #f)
    (else #t)))

(: digit-code? (-> int bool))
(defun (digit-code? c) (and (>= c 48) (<= c 57)))

;; Whitespace, and `;` to the end of the line.
(: skip-space! (-> Reader void))
(defun (skip-space! rd)
  (let go ()
    (def c (held-code rd))
    (cond
     ((space-code? c)
      (if (= c 10)
          (newline! rd)
          (step! rd))
      (go))
     ((= c 59)
      (let skip ()
        (def k (held-code rd))
        (when (and (not (= k spent)) (not (= k 10)))
          (step! rd)
          (skip)))
      (go))
     (else unit))))

;; ---------------------------------------------------------------------------
;; Refusals
;; ---------------------------------------------------------------------------

(: at (-> Reader string string))
(defun (at rd what)
  (str "line " (int->string (record-ref rd row))
       ", column " (int->string (record-ref rd col))
       ": " what))

(: found (-> Reader string))
(defun (found rd)
  (def c (held-code rd))
  (cond
    ((= c spent) "the document ended")
    ((< c 128) (str "'" (list->string (list (integer->char c))) "'"))
    (else
     (def n (sequence-length rd))
     (if (= n 0)
         not-utf-8
         (str "'" (list->string (list (held-character rd n))) "'")))))

;; The refusal of a string or a name with bytes in it that are not UTF-8.
(: not-utf-8-here (-> Reader string))
(defun (not-utf-8-here rd) (at rd "text has to be UTF-8, and this byte is not"))

(: too-deep (-> Reader string string))
(defun (too-deep rd what)
  (at rd (str "this " what " nests deeper than " (int->string bjodat-max-depth)
              ", which is as far as reading goes")))

;; ---------------------------------------------------------------------------
;; Strings
;; ---------------------------------------------------------------------------

(: hex-digit (-> char int))
(defun (hex-digit c)
  (cond
    ((and (char>=? c #\0) (char<=? c #\9)) (- (char->integer c) 48))
    ((and (char>=? c #\a) (char<=? c #\f)) (- (char->integer c) 87))
    ((and (char>=? c #\A) (char<=? c #\F)) (- (char->integer c) 55))
    (else -1)))

;; The escapes source writes. `\n`, `\t`, `\r`, `\\`, `\"`, `\0`, and `\uXXXX`.
(: read-escape! (-> Reader StringBuilder (Result string bool)))
(defun (read-escape! rd sb)
  (step! rd)
  (cond
    ((at-end? rd) (Err (at rd "the document ended inside a string")))
    (else
     (def c (peek rd))
     (cond
       ((char=? c #\n) (stringbuilder-add-code! sb 10) (step! rd) (Ok #t))
       ((char=? c #\t) (stringbuilder-add-code! sb 9) (step! rd) (Ok #t))
       ((char=? c #\r) (stringbuilder-add-code! sb 13) (step! rd) (Ok #t))
       ((char=? c #\0) (stringbuilder-add-code! sb 0) (step! rd) (Ok #t))
       ((char=? c #\\) (stringbuilder-add-code! sb 92) (step! rd) (Ok #t))
       ((char=? c #\") (stringbuilder-add-code! sb 34) (step! rd) (Ok #t))
       ((char=? c #\u) (read-unicode-escape! rd sb))
       (else (Err (at rd (str "\\" (list->string (list c)) " is not an escape"))))))))

(: read-unicode-escape! (-> Reader StringBuilder (Result string bool)))
(defun (read-unicode-escape! rd sb)
  (step! rd)
  (let go ((k 0) (acc 0))
    (cond
      ((= k 4) (stringbuilder-add-unit! sb acc) (Ok #t))
      ((at-end? rd) (Err (at rd "the document ended inside a \\u escape")))
      (else
       (def d (hex-digit (peek rd)))
       (cond
         ((< d 0) (Err (at rd (str "a \\u escape wants four hex digits, and this is "
                                   (found rd)))))
         (else (step! rd) (go (+ k 1) (+ (* acc 16) d))))))))

;; A string, raw or escaped. `""` is the empty string, and a third quote after
;; it opens a raw one.
(: read-text (-> Reader (Result string string)))
(defun (read-text rd)
  (step! rd)
  (cond
    ((not (= (held-code rd) 34)) (read-escaped-text rd))
    (else
     (step! rd)
     (if (= (held-code rd) 34)
         (read-raw-text rd)
         (Ok "")))))

;; ---------------------------------------------------------------------------
;; Raw strings
;; ---------------------------------------------------------------------------
;; `"""..."""`, read by the rules `readRawString` in the compiler's Lexer.fs
;; reads it by, which Docs/Syntax.org describes. The two have to agree, and
;; TestFiles/263_raw_strings.bjo reads one file with both to show that they do.

;; Steps over a run of quotes, and answers how long it was.
(: skip-quotes! (-> Reader int))
(defun (skip-quotes! rd)
  (let go ((k 0))
    (cond
      ((= (held-code rd) 34) (step! rd) (go (+ k 1)))
      (else k))))

(: add-quotes! (-> StringBuilder int void))
(defun (add-quotes! sb k)
  (loop (:for i (range 0 k))
        (:do (stringbuilder-add-code! sb 34))))

(: too-many-quotes (-> Reader int int string))
(defun (too-many-quotes rd n k)
  (at rd (str "a raw string opened with " (int->string n) " quotes has " (int->string k)
              " in a row. Open and close it with more quotes than it holds in a row")))

;; The held quote is the third of the opening ones.
(: read-raw-text (-> Reader (Result string string)))
(defun (read-raw-text rd)
  (def n (+ 2 (skip-quotes! rd)))
  (def sb (buffer rd))
  (let spaces ()
    (def c (held-code rd))
    (when (or (= c 32) (= c 9))
      (stringbuilder-add-unit! sb c)
      (step! rd)
      (spaces)))
  (cond
    ((= (held-code rd) 10) (newline! rd) (read-raw-lines rd n))
    ((= (held-code rd) 13)
     (step! rd)
     (cond
       ((= (held-code rd) 10) (newline! rd) (read-raw-lines rd n))
       (else (stringbuilder-add-code! sb 13) (read-raw-line rd n sb))))
    (else (read-raw-line rd n sb))))

;; A raw string on the line of its opening quotes, which ends on that line.
(: read-raw-line (-> Reader int StringBuilder (Result string string)))
(defun (read-raw-line rd n sb)
  (let go ()
    (def c (held-code rd))
    (cond
      ((= c spent) (Err (at rd "the document ended inside a string")))
      ((= c 10)
       (Err (at rd (str "a raw string that begins on the line of its opening quotes ends on that line. "
                        "One over several lines begins on the line after them"))))
      ((= c 34)
       (def k (skip-quotes! rd))
       (cond
         ((= k n) (Ok (stringbuilder->string sb)))
         ((> k n) (Err (too-many-quotes rd n k)))
         (else (add-quotes! sb k) (go))))
      ((add-held! rd sb c) (go))
      (else (Err (not-utf-8-here rd))))))

;; A raw string over several lines. Each line is kept as it was written, with
;; the row it is on, until the closing quotes say what the margin is.
(: read-raw-lines (-> Reader int (Result string string)))
(defun (read-raw-lines rd n)
  (let next-line ((lines Nil))
    (def row (record-ref rd row))
    (def sb (stringbuilder-empty))
    (let spaces ()
      (def c (held-code rd))
      (when (or (= c 32) (= c 9))
        (stringbuilder-add-unit! sb c)
        (step! rd)
        (spaces)))
    (def lead (skip-quotes! rd))
    (cond
      ((= lead n) (strip-margin (stringbuilder->string sb) (list-reverse lines)))
      ((> lead n) (Err (too-many-quotes rd n lead)))
      (else
       (add-quotes! sb lead)
       (let go ()
         (def c (held-code rd))
         (cond
           ((= c spent)
            (Err (at rd (str "the document ended inside a raw string, which closes with "
                             (int->string n) " quotes on a line of their own"))))
           ((= c 10)
            (newline! rd)
            (next-line (Cons (Tuple row (stringbuilder->string sb)) lines)))
           ((= c 13)
            (step! rd)
            (cond
              ((= (held-code rd) 10)
               (newline! rd)
               (next-line (Cons (Tuple row (stringbuilder->string sb)) lines)))
              (else (stringbuilder-add-code! sb 13) (go))))
           ((= c 34)
            (def k (skip-quotes! rd))
            (cond
              ((> k n) (Err (too-many-quotes rd n k)))
              ((= k n)
               (Err (at rd (str "a raw string closes only on a line of its own. For " (int->string n)
                                " quotes in the text, open and close it with more"))))
              (else (add-quotes! sb k) (go))))
           ((add-held! rd sb c) (go))
           (else (Err (not-utf-8-here rd)))))))))

(: blank? (-> string bool))
(defun (blank? s)
  (none? (string-index #(not (or (char=? &1 #\space) (char=? &1 #\tab))) s)))

;; What follows `prefix` in `s`, which starts with it.
(: after-prefix (-> string string string))
(defun (after-prefix s prefix)
  (let go ((c (string-cursor-start s)) (n (string-count prefix)))
    (if (= n 0)
        (substring s c (string-cursor-end s))
        (go (string-cursor-next s c) (- n 1)))))

;; The margin is the whitespace before the closing quotes. It comes off every
;; line, and a line with text that does not begin with it is refused, since
;; cutting it anyway would cut text.
(: strip-margin (-> string (List (Tuple int string)) (Result string string)))
(defun (strip-margin margin lines)
  (def out (stringbuilder-empty))
  (let go ((left lines) (first #t))
    (match left
      (Nil (Ok (stringbuilder->string out)))
      ((Cons (Tuple row s) more)
       (unless first (stringbuilder-add-code! out 10))
       (cond
         ((string-starts-with? s margin)
          (stringbuilder-add-string! out (after-prefix s margin))
          (go more #f))
         ((blank? s) (go more #f))
         (else
          (Err (str "line " (int->string row) ", column 1: this line of a raw string does not "
                    "begin with its margin. The whitespace before the closing quotes is removed "
                    "from every line, so every line with text in it begins with that whitespace"))))))))

;; An escaped string, after its opening quote.
(: read-escaped-text (-> Reader (Result string string)))
(defun (read-escaped-text rd)
  (def sb (buffer rd))
  (let go ()
    (cond
     ((at-end? rd) (Err (at rd "the document ended inside a string")))
     (else
      (def c (held-code rd))
      (cond
       ((= c 34) (step! rd) (Ok (stringbuilder->string sb)))
       ((= c 92) (match (read-escape! rd sb)
                   ((Err e) (Err e))
                   ((Ok _) (go))))
       ((= c 10)
        (stringbuilder-add-unit! sb c)
        (newline! rd)
        (go))
       ((add-held! rd sb c) (go))
       (else (Err (not-utf-8-here rd))))))))

;; ---------------------------------------------------------------------------
;; Numbers
;; ---------------------------------------------------------------------------

(: take-digits! (-> Reader StringBuilder int))
(defun (take-digits! rd sb)
  (let go ((n 0))
    (if (digit-code? (held-code rd))
        (begin
          (stringbuilder-add-unit! sb (held-code rd))
          (step! rd)
          (go (+ n 1)))
        n)))

;; `0x` and `0b`. The `0` has been stepped over and the marker is held.
(: read-radix (-> Reader bool int (Result string Bjodat)))
(defun (read-radix rd neg radix)
  (step! rd)
  (def sb (buffer rd))
  (let go ((n 0))
    (if (and (not (at-end? rd)) (>= (hex-digit (peek rd)) 0))
        (begin (stringbuilder-add-unit! sb (held-code rd)) (step! rd) (go (+ n 1)))
        (if (= n 0)
            (Err (at rd (str "this number has no digits after its radix, and there is "
                             (found rd))))
            (match (clr-radix-long (stringbuilder->string sb) radix)
              ((Err _) (Err (at rd "this number does not fit in a long")))
              ((Ok v) (Ok (BjoInt (if neg (- 0L v) v)))))))))

(: scan-fraction! (-> Reader StringBuilder (Result string bool)))
(defun (scan-fraction! rd sb)
  (if (not (= (held-code rd) 46))
      (Ok #f)
      (begin
        (stringbuilder-add-code! sb 46)
        (step! rd)
        (if (= (take-digits! rd sb) 0)
            (Err (at rd (str "a number needs a digit after its decimal point, and this is "
                             (found rd))))
            (Ok #t)))))

(: scan-exponent! (-> Reader StringBuilder (Result string bool)))
(defun (scan-exponent! rd sb)
  (def c (held-code rd))
  (cond
    ((not (or (= c 101) (= c 69))) (Ok #f))
    (else
     (stringbuilder-add-code! sb 101)
     (step! rd)
     ;; `s` is bound rather than read three times, and it is not only the
     ;; calls: with a name, `(or (= s 43) (= s 45))` is emitted as a
     ;; ternary, and with the calls inlined the operands stop being simple
     ;; and it becomes an if/else over a temporary, to keep the short
     ;; circuit in the right order.
     (def s (held-code rd))
     (when (or (= s 43) (= s 45))
       (stringbuilder-add-unit! sb s)
       (step! rd))
     (if (= (take-digits! rd sb) 0)
         (Err (at rd (str "a number needs a digit after its exponent, and this is "
                          (found rd))))
         (Ok #t)))))

;; A digit is held. The sign, if there was one, has been stepped over already —
;; which is what tells `-` the symbol apart from `-1` the number, since deciding
;; needs a character of lookahead the reader does not have until it has moved.
(: read-magnitude (-> Reader bool (Result string Bjodat)))
(defun (read-magnitude rd neg)
  (cond
    ((= (held-code rd) 48)
     (step! rd)
     (def c (held-code rd))
     (cond
       ((or (= c 120) (= c 88)) (read-radix rd neg 16))
       ((or (= c 98) (= c 66)) (read-radix rd neg 2))
       (else
        (def sb (buffer rd))
        (stringbuilder-add-code! sb 48)
        (finish-number rd neg sb))))
    (else (finish-number rd neg (buffer rd)))))

(: finish-number (-> Reader bool StringBuilder (Result string Bjodat)))
(defun (finish-number rd neg sb)
  (ignore (take-digits! rd sb))
  (def (Ok frac?) (scan-fraction! rd sb) :propagate)
  (def (Ok exp?) (scan-exponent! rd sb) :propagate)
  (cond
    ((or frac? exp?)
     (def d (clr-to-double sb))
     (Ok (BjoFloat (if neg (- 0.0 d) d))))
    ;; Wider than a long is still a number.
    (else
     (match (try (clr-to-long sb) #:catch (System.OverflowException))
       ((Ok n) (Ok (BjoInt (if neg (- 0L n) n))))
       ((Err _)
        (def d (clr-to-double sb))
        (Ok (BjoFloat (if neg (- 0.0 d) d))))))))

;; ---------------------------------------------------------------------------
;; Symbols, keywords, and what a `#` begins
;; ---------------------------------------------------------------------------

(: take-name! (-> Reader StringBuilder int))
;; A byte that is not UTF-8 ends the name, and is refused by what reads next.
(defun (take-name! rd sb)
  (let go ((n 0))
    (def c (held-code rd))
    (if (and (symbol-code? c) (add-held! rd sb c))
        (go (+ n 1))
        n)))

;; NaN and the infinities, spelled as Scheme spells them. They read as names
;; do, so a name is checked for them before it becomes a symbol.
(: special-double (-> string (Option double)))
(defun (special-double name)
  (cond
    ((= name "+inf.0") (Some (/ 1.0 0.0)))
    ((= name "-inf.0") (Some (/ -1.0 0.0)))
    ((or (= name "+nan.0") (= name "-nan.0")) (Some (/ 0.0 0.0)))
    (else None)))

;; A name as a symbol, unless it is one of the doubles above.
(: name-value (-> Reader StringBuilder Bjodat))
(defun (name-value rd sb)
  (def name (cached-name (record-ref rd names) sb))
  (match (special-double name)
    ((Some d) (BjoFloat d))
    (None (BjoSym (string->symbol name)))))

(: read-symbol (-> Reader (Result string Bjodat)))
(defun (read-symbol rd)
  (def sb (buffer rd))
  (if (= (take-name! rd sb) 0)
      (Err (at rd (str (found rd) " does not begin a value")))
      (Ok (name-value rd sb))))

;; `:name`. The colon is held.
(: read-keyword (-> Reader (Result string Bjodat)))
(defun (read-keyword rd)
  (step! rd)
  (def sb (buffer rd))
  (if (= (take-name! rd sb) 0)
      (Err (at rd (str "a keyword needs a name after its colon, and this is "
                       (found rd))))
      (Ok (BjoKey (string->keyword (cached-name (record-ref rd names) sb))))))

;; The characters source spells with a word.
(: named-char (-> string int))
(defun (named-char name)
  (cond
    ((= name "newline") 10)
    ((= name "space") 32)
    ((= name "tab") 9)
    ((= name "return") 13)
    ((= name "nul") 0)
    (else -1)))

;; `#\c`, `#\newline`. The backslash is held.
(: read-char-literal (-> Reader (Result string Bjodat)))
(defun (read-char-literal rd)
  (step! rd)
  (cond
    ((at-end? rd) (Err (at rd "the document ended inside a character")))
    ((= (sequence-length rd) 0) (Err (not-utf-8-here rd)))
    (else
     (def lead (held-code rd))
     (def first (if (< lead 128) (integer->char lead) (held-character rd (sequence-length rd))))
     (def sb (buffer rd))
     (ignore (add-held! rd sb lead))
     ;; `n` is bound rather than inlined into the test: a name compares
     ;; straight into the `if`, where the call needs a temporary for its
     ;; result and then a second one for the comparison.
     (def n (take-name! rd sb))
     (cond
       ((= n 0) (Ok (BjoChar first)))
       (else
        (def name (stringbuilder->string sb))
        (def code (named-char name))
        (if (< code 0)
            (Err (at rd (str "#\\" name " is not a character")))
            (Ok (BjoChar (integer->char code)))))))))

;; `#t`, `#f`, `#\c`, `#:keyword`. The `#` is held.
(: read-hash (-> Reader (Result string Bjodat)))
(defun (read-hash rd)
  (step! rd)
  (cond
    ((at-end? rd) (Err (at rd "the document ended after '#'")))
    (else
     (def c (peek rd))
     (cond
       ((char=? c #\t) (step! rd) (Ok (BjoBool #t)))
       ((char=? c #\f) (step! rd) (Ok (BjoBool #f)))
       ((char=? c #\\) (read-char-literal rd))
       ((char=? c #\:) (read-keyword rd))
       (else (Err (at rd (str "'#' begins #t, #f, #\\c or #:keyword, and this is "
                              (found rd)))))))))

;; ---------------------------------------------------------------------------
;; Lists, vecs and maps
;; ---------------------------------------------------------------------------

(: read-sequence (-> Reader int int char string (Result string (Vec Bjodat))))
(defun (read-sequence rd depth closer-code closer what)
  (step! rd)
  (def mark (record-ref rd top))
  (let go ()
    (skip-space! rd)
    (cond
      ((at-end? rd)
       (Err (at rd (str "the document ended inside a " what))))
      ((= (held-code rd) closer-code)
       (step! rd)
       (Ok (harvest! rd mark)))
      (else
       (match (read-value rd (+ depth 1))
         ((Err e) (Err e))
         ((Ok v) (push! rd v) (go)))))))

;; A key is any value but a list. Refusing one is what makes `{(` unambiguous:
;; a `(` where a key would go means the map is written in the parenthesised
;; form, and nothing else.
(: read-key (-> Reader int (Result string Bjodat)))
(defun (read-key rd depth)
  (match (read-value rd depth)
    ((Err e) (Err e))
    ((Ok (BjoList _)) (Err (at rd "a list is not a key")))
    ((Ok v) (Ok v))))

;; `{(k v) (k v)}`. The opening brace has been stepped over and a `(` is held.
(: read-paired-map (-> Reader int int (Result string Bjodat)))
(defun (read-paired-map rd depth mark)
  (let go ()
    (skip-space! rd)
    (cond
      ((at-end? rd) (Err (at rd "the document ended inside a map")))
      ((= (held-code rd) 125)
       (step! rd)
       (Ok (BjoMap (harvest! rd mark))))
      ((not (= (held-code rd) 40))
       (Err (at rd (str "this map is written (key value), so its entries all are, "
                        "and here there is " (found rd)))))
      (else
       (step! rd)
       (def (Ok k) (read-key rd (+ depth 1)) :propagate)
       (push! rd k)
       (def (Ok v) (read-value rd (+ depth 1)) :propagate)
       (push! rd v)
       (skip-space! rd)
       (if (= (held-code rd) 41)
           (begin (step! rd) (go))
           (Err (at rd (str "an entry holds a key and a value, and then there is "
                            (found rd)))))))))

;; `{k v k v}`. The opening brace has been stepped over before reaching this fun.
(: read-flat-map (-> Reader int int (Result string Bjodat)))
(defun (read-flat-map rd depth mark)
  (let go ()
    (skip-space! rd)
    (cond
      ((at-end? rd) (Err (at rd "the document ended inside a map")))
      ((= (held-code rd) 125)
       (step! rd)
       (Ok (BjoMap (harvest! rd mark))))
      ((= (held-code rd) 40)
       (Err (at rd "this map is written flat, so a '(' here is an entry of the other form")))
      (else
       (def (Ok k) (read-key rd (+ depth 1)) :propagate)
       (push! rd k)
       (skip-space! rd)
       (if (or (at-end? rd) (= (held-code rd) 125))
           (Err (at rd "this map has a key with no value"))
           (match (read-value rd (+ depth 1))
             ((Err e) (Err e))
             ((Ok v) (push! rd v) (go))))))))

;; Which form a map is written in is decided by the first thing inside it, and
;; then every entry has to agree.
(: read-map (-> Reader int (Result string Bjodat)))
(defun (read-map rd depth)
  (step! rd)
  (def mark (record-ref rd top))
  (skip-space! rd)
  (cond
    ((at-end? rd) (Err (at rd "the document ended inside a map")))
    ((= (held-code rd) 125)
     (step! rd)
     (Ok (BjoMap (harvest! rd mark))))
    ((= (held-code rd) 40) (read-paired-map rd depth mark))
    (else (read-flat-map rd depth mark))))

;; ---------------------------------------------------------------------------
;; A value
;; ---------------------------------------------------------------------------

(: read-value (-> Reader int (Result string Bjodat)))
(defun (read-value rd depth)
  (skip-space! rd)
  (cond
    ((> depth bjodat-max-depth) (Err (too-deep rd "value")))
    ((at-end? rd) (Err (at rd "the document ended where a value was expected")))
    (else
     (def c (peek rd))
     (cond
       ((char=? c #\()
        (match (read-sequence rd depth 41 #\) "list")
          ((Err e) (Err e))
          ((Ok v) (Ok (BjoList (vec->list v))))))
       ((char=? c #\[)
        (match (read-sequence rd depth 93 #\] "vec")
          ((Err e) (Err e))
          ((Ok v) (Ok (BjoVec v)))))
       ((char=? c #\{) (read-map rd depth))
       ((char=? c #\")
        (match (read-text rd)
          ((Err e) (Err e))
          ((Ok s) (Ok (BjoStr s)))))
       ((char=? c #\#) (read-hash rd))
       ((char=? c #\:) (read-keyword rd))
       ((char=? c #\)) (Err (at rd "')' closes nothing here")))
       ((char=? c #\]) (Err (at rd "']' closes nothing here")))
       ((char=? c #\}) (Err (at rd "'}' closes nothing here")))
       ((char=? c #\,) (Err (at rd "a comma is not a separator here")))
       ((char=? c #\') (Err (at rd "a symbol in bjodat is written without a quote")))
       ((digit-code? (held-code rd)) (read-magnitude rd #f))
       ;; `-` is a symbol of its own, and the start of a number when a digit
       ;; follows it. Stepping over it first is what makes the difference
       ;; visible; if no digit came, what was stepped over is the first
       ;; character of a symbol.
       ((char=? c #\-)
        (step! rd)
        (cond
          ((digit-code? (held-code rd)) (read-magnitude rd #t))
          (else
           (def sb (buffer rd))
           (stringbuilder-add-code! sb 45)
           (ignore (take-name! rd sb))
           (Ok (name-value rd sb)))))
       (else (read-symbol rd))))))

;; ---------------------------------------------------------------------------
;; Reading a document
;; ---------------------------------------------------------------------------

;; A byte order mark, EF BB BF, is skipped and is not a column.
(: skip-bom! (-> Reader void))
(defun (skip-bom! rd)
  (when (and (ensure! rd 3)
             (let ((b (record-ref rd bytes)) (i (record-ref rd next)))
               (and (= (cast int (array-ref b i)) 239)
                    (= (cast int (array-ref b (+ i 1))) 187)
                    (= (cast int (array-ref b (+ i 2))) 191))))
    (record-set! rd (next (+ (record-ref rd next) 3)))))

(: no-bytes (Array byte))
(def no-bytes (make-array 0))

;; A reader for a port, and one for a string's own bytes.
(: port-reader (-> InputPort Reader))
(defun (port-reader port) (reader (Some port) no-bytes))

(: string-reader (-> string Reader))
(defun (string-reader text) (reader None (string->bytes text)))

;; Exactly one value, and then the end.
(: read-bjodat (-> InputPort (Result string Bjodat)))
(defun (read-bjodat port) (one-value (port-reader port)))

(: one-value (-> Reader (Result string Bjodat)))
(defun (one-value rd)
  (skip-bom! rd)
  (match (read-value rd 1)
    ((Err e) (Err e))
    ((Ok v)
     (skip-space! rd)
     (if (at-end? rd)
         (Ok v)
         (Err (at rd (str "the value ended here, and then there is " (found rd))))))))

(: parse-bjodat (-> string (Result string Bjodat)))
(defun (parse-bjodat text) (one-value (string-reader text)))

;; Every value in the file, in order. A file is a stream, so an empty one is an
;; empty list rather than a refusal.
(: read-bjodat-all (-> InputPort (Result string (List Bjodat))))
(defun (read-bjodat-all port) (all-values (port-reader port)))

(: all-values (-> Reader (Result string (List Bjodat))))
(defun (all-values rd)
  (skip-bom! rd)
  (let go ((acc Nil))
    (skip-space! rd)
    (if (at-end? rd)
        (Ok (list-reverse acc))
        (match (read-value rd 1)
          ((Err e) (Err e))
          ((Ok v) (go (Cons v acc)))))))

(: parse-bjodat-all (-> string (Result string (List Bjodat))))
(defun (parse-bjodat-all text) (all-values (string-reader text)))

;; ---------------------------------------------------------------------------
;; Reading a record in one pass
;; ---------------------------------------------------------------------------
;; What `(text bjodat-codec)`'s generated decoders drive, so that a record can be
;; read without a `Bjodat` tree standing between the text and the fields.
;;
;; The tree is not free. A map costs, per entry, a name string built off the
;; buffer, an interned `Keyword`, a `BjoKey` node and two slots in a vec — and
;; then the decoder scans that vec once per field, and the whole of it is thrown
;; away the moment the record exists. A generated decoder knows its field names
;; when it is *compiled*, so it can compare the key against them in the buffer
;; and build none of it.
;;
;; The caller drives the loop rather than handing in a table, because the caller
;; is generated code that already knows what it is looking for, and a table
;; would be the thing this is trying not to build. So these are small and
;; awkward on purpose: they are not an API for people.
;;
;; What is *not* here is a typed value reader. A field's value still goes
;; through `read-value` and the field type's own `bjodat->` instance, which is
;; what keeps every instance — including one a user wrote — working, and every
;; error message identical to the tree decoder's. The entry is what this saves,
;; not the value.

;; Steps over `{`, and answers whether this map's entries are parenthesised.
;; Which form it is in is decided by the first thing inside it, exactly as
;; `read-map` decides it, and then every entry has to agree.
(: open-map! (-> Reader string (Result string bool)))
(defun (open-map! rd owner)
  (skip-space! rd)
  (cond
    ((at-end? rd)
     (Err (at rd (str owner ": the document ended where a map was expected"))))
    ((not (= (held-code rd) 123))
     (Err (at rd (str owner ": expected a map, and here there is " (found rd)))))
    (else
     (step! rd)
     (skip-space! rd)
     (Ok (= (held-code rd) 40)))))

;; A key's name, taken into the buffer without being interned.
;;
;; A key that is not a keyword is read and dropped, and leaves the buffer empty
;; — which no field name can equal, so it takes the same path an unknown key
;; does. That matches the tree decoder, where `bjodat-ref` only ever matches a
;; `BjoKey` and a key of any other shape is simply never found.
(: take-key! (-> Reader string (Result string bool)))
(defun (take-key! rd owner)
  (skip-space! rd)
  (cond
    ((= (held-code rd) 58)
     (step! rd)
     (def sb (buffer rd))
     (if (= (take-name! rd sb) 0)
         (Err (at rd (str owner ": a keyword needs a name after its colon, and this is "
                          (found rd))))
         (Ok #t)))
    (else
     (match (read-key rd 1)
       ((Err e) (Err e))
       ((Ok _)
        (stringbuilder-clear! (record-ref rd scratch))
        (Ok #t))))))

;; `#t` when a key is in the buffer and the reader stands at its value; `#f`
;; when the map closed.
(: next-key! (-> Reader string bool (Result string bool)))
(defun (next-key! rd owner paired)
  (skip-space! rd)
  (cond
    ((at-end? rd) (Err (at rd (str owner ": the document ended inside a map"))))
    ((= (held-code rd) 125) (step! rd) (Ok #f))
    ((and paired (not (= (held-code rd) 40)))
     (Err (at rd (str owner ": this map is written (key value), so its entries all are, "
                      "and here there is " (found rd)))))
    ((and (not paired) (= (held-code rd) 40))
     (Err (at rd (str owner ": this map is written flat, so a '(' here is an entry of the "
                      "other form"))))
    (else
     (when paired (step! rd))
     (match (take-key! rd owner)
       ((Err e) (Err e))
       ((Ok _)
        (skip-space! rd)
        (if (or (at-end? rd) (= (held-code rd) 125))
            (Err (at rd (str owner ": this map has a key with no value")))
            (Ok #t)))))))

;; The `)` of a parenthesised entry. Nothing at all in the flat form.
(: end-entry! (-> Reader string bool (Result string bool)))
(defun (end-entry! rd owner paired)
  (if (not paired)
      (Ok #t)
      (begin
        (skip-space! rd)
        (if (= (held-code rd) 41)
            (begin (step! rd) (Ok #t))
            (Err (at rd (str owner ": an entry holds a key and a value, and then there is "
                             (found rd))))))))

;; Is the key in the buffer this name? The comparison the whole thing is for:
;; no string is built, and nothing is interned.
(: key=? (-> Reader string bool))
(defun (key=? rd name)
  (def sb (record-ref rd scratch))
  (stringbuilder=? sb name))

;; A field's value, as a `Bjodat` for its own instance to convert.
(: field-value (-> Reader (Result string Bjodat)))
(defun (field-value rd) (read-value rd 1))

;; An unknown key's value, read and dropped. It has to be *read*: a value is not
;; a token, and finding where it ends means parsing it.
(: skip-value! (-> Reader (Result string bool)))
(defun (skip-value! rd)
  (match (read-value rd 1)
    ((Err e) (Err e))
    ((Ok _) (Ok #t))))

;; ---------------------------------------------------------------------------
;; Reading a record written as a tagged form
;; ---------------------------------------------------------------------------
;; `(package (name bjolang/http) (version "1.2.3"))` — the head symbol names the
;; type, and each clause is a field.
;;
;; This is the *parenthesised map* with two differences: a `(` opens it rather
;; than a `{`, and it carries a tag. So the loop a generated decoder runs is the
;; one `next-key!` and `end-entry!` already drive, and what is new here is only
;; the opener, the clause name being a bare symbol rather than a keyword, and
;; what an unknown clause costs to get past.
;;
;; **The shape never picks the type.** A `BjoList` headed by a symbol is a
;; tagged record where a tagged record is expected and a union case where a
;; union is, exactly as a `{...}` is a record in one field and a lookup table in
;; the next. The reader commits to neither and there is nothing here that could:
;; these functions are called by a decoder that already knows what it wants.

;; Steps over `(` and the head symbol, and refuses a head that is not `tag`.
(: open-form! (-> Reader string string (Result string bool)))
(defun (open-form! rd owner tag)
  (skip-space! rd)
  (cond
    ((at-end? rd)
     (Err (at rd (str owner ": the document ended where (" tag " ...) was expected"))))
    ((not (= (held-code rd) 40))
     (Err (at rd (str owner ": expected (" tag " ...), and here there is " (found rd)))))
    (else
     (step! rd)
     (skip-space! rd)
     (def sb (buffer rd))
     (cond
       ((= (take-name! rd sb) 0)
        (Err (at rd (str owner ": a form begins with the name of its type, and this is "
                         (found rd)))))
       ;; The comparison the whole thing is for: the tag is matched against
       ;; the buffer, so a form costs no string and interns nothing for its
       ;; own name any more than it does for a field's.
       ((key=? rd tag) (Ok #t))
       ;; Only here, on the way to refusing, is a string built.
       (else
        (Err (at rd (str owner ": expected (" tag " ...), and this is ("
                         (stringbuilder->string sb) " ...)"))))))))

;; `#t` when a clause's field name sits in the buffer and the reader stands at
;; its first value; `#f` when the form closed.
(: next-field! (-> Reader string (Result string bool)))
(defun (next-field! rd owner)
  (skip-space! rd)
  (cond
    ((at-end? rd) (Err (at rd (str owner ": the document ended inside a form"))))
    ((= (held-code rd) 41) (step! rd) (Ok #f))
    ((not (= (held-code rd) 40))
     (Err (at rd (str owner ": a clause is written (name value), and here there is "
                      (found rd)))))
    (else
     (step! rd)
     (skip-space! rd)
     (def sb (buffer rd))
     (if (= (take-name! rd sb) 0)
         (Err (at rd (str owner ": a clause begins with a field name, and this is "
                          (found rd))))
         (Ok #t)))))

;; The `)` that closes a clause holding one value.
;;
;; The owner and the field name arrive apart and are joined only on the way to
;; refusing. Joined by the caller they would be one string built per field per
;; record — which is the cost this whole path exists to avoid — and dropped they
;; would leave a message that does not say which clause was wrong. The tree
;; decoder's `bjodat-one-value` says the same sentence under the same name.
(: end-clause! (-> Reader string string (Result string bool)))
(defun (end-clause! rd owner name)
  (skip-space! rd)
  (if (= (held-code rd) 41)
      (begin (step! rd) (Ok #t))
      (Err (at rd (str owner "." name
                       ": a clause holds a field name and one value, and then there is "
                       (found rd))))))

;; An unknown clause, read and dropped: the name has been taken, the values have
;; not. **Any arity**, and that is the point of it. A flat map's unknown key is
;; one value and done, but a clause may hold none, one or five, and a reader
;; that insisted on one would make every new clause a breaking change for every
;; older tool. This is what keeps a manifest forward-compatible.
(: skip-clause! (-> Reader (Result string bool)))
(defun (skip-clause! rd)
  (let go ()
    (skip-space! rd)
    (cond
      ((at-end? rd) (Err (at rd "the document ended inside a clause")))
      ((= (held-code rd) 41) (step! rd) (Ok #t))
      (else
       (match (read-value rd 1)
         ((Err e) (Err e))
         ((Ok _) (go)))))))

;; Every value of a clause, in written order, for a `#:rest` field that takes
;; them all. The closing `)` is stepped over.
;;
;; The values arrive as `Bjodat` and are converted by the element type's own
;; instance, exactly as the single-value case does through `field-value`. That
;; is not laziness: `read-value` carries the depth budget, so a manifest nesting
;; `(package (depends (package (depends ...))))` five hundred deep is refused by
;; `bjodat-max-depth` rather than by the stack. A `#:rest` that recursed
;; straight back into a generated decoder would have no budget at all.
(: clause-values! (-> Reader (Result string (List Bjodat))))
(defun (clause-values! rd)
  (let go ((acc Nil))
    (skip-space! rd)
    (cond
      ((at-end? rd) (Err (at rd "the document ended inside a clause")))
      ((= (held-code rd) 41) (step! rd) (Ok (list-reverse acc)))
      (else
       (match (read-value rd 1)
         ((Err e) (Err e))
         ((Ok v) (go (Cons v acc))))))))

;; One record, and then the end, for a decoder generated by `def/bjodat-type`.
;;
;; The decoder is declared `-?->` rather than `->`, and has to be: a written
;; arrow outranks the default, so a plain one would pin the generated decoder to
;; its *sync* copy — and then a bjoroutine reading a socket would call the copy
;; that parks the thread. The blocking lint says so in as many words, which is
;; how this was found.
(: read-one-pass (-> InputPort (-?-> Reader (Result string %a)) (Result string %a)))
(defun (read-one-pass port decode) (one-record (port-reader port) decode))

(: one-record (-> Reader (-?-> Reader (Result string %a)) (Result string %a)))
(defun (one-record rd decode)
  (skip-bom! rd)
  (match (decode rd)
    ((Err e) (Err e))
    ((Ok v)
     (skip-space! rd)
     (if (at-end? rd)
         (Ok v)
         (Err (at rd (str "the value ended here, and then there is " (found rd))))))))

(: parse-one-pass (-> string (-?-> Reader (Result string %a)) (Result string %a)))
(defun (parse-one-pass text decode) (one-record (string-reader text) decode))

;; A `[...]` of them, which is what a manifest's list of dependencies is.
;;
;; A `List` rather than a `Vec` because it is built by consing and turned round
;; once, where a vec would be an RRB append per element. A caller that wants a
;; vec can say so in one call; a caller that folds over it once — which is most
;; of them — should not pay for a tree it does not index into.
(: read-one-pass-all (-> InputPort (-?-> Reader (Result string %a)) (Result string (List %a))))
(defun (read-one-pass-all port decode) (all-records (port-reader port) decode))

(: all-records (-> Reader (-?-> Reader (Result string %a)) (Result string (List %a))))
(defun (all-records rd decode)
  (skip-bom! rd)
  (skip-space! rd)
  (if (not (= (held-code rd) 91))
      (Err (at rd (str "expected a vec of values, and here there is " (found rd))))
      (begin
        (step! rd)
        (let go ((acc Nil))
          (skip-space! rd)
          (cond
            ((at-end? rd) (Err (at rd "the document ended inside a vec")))
            ((= (held-code rd) 93) (step! rd) (Ok (list-reverse acc)))
            (else
             (match (decode rd)
               ((Err e) (Err e))
               ((Ok v) (go (Cons v acc))))))))))

(: parse-one-pass-all (-> string (-?-> Reader (Result string %a)) (Result string (List %a))))
(defun (parse-one-pass-all text decode) (all-records (string-reader text) decode))

;; ---------------------------------------------------------------------------
;; Writing
;; ---------------------------------------------------------------------------
;; The canonical spelling: maps flat, in the order they are held.

(: escape-into! (-> StringBuilder string void))
(defun (escape-into! sb s)
  (stringbuilder-add! sb #\")
  (loop (:for c s)
        (:do (let* ((n (char->integer c)))
               (cond
                 ((= n 34) (stringbuilder-add-string! sb "\\\""))
                 ((= n 92) (stringbuilder-add-string! sb "\\\\"))
                 ((= n 10) (stringbuilder-add-string! sb "\\n"))
                 ((= n 9) (stringbuilder-add-string! sb "\\t"))
                 ((= n 13) (stringbuilder-add-string! sb "\\r"))
                 (else (stringbuilder-add! sb c))))))
  (stringbuilder-add! sb #\"))

(: char-into! (-> StringBuilder char void))
(defun (char-into! sb c)
  (def n (char->integer c))
  (stringbuilder-add-string! sb "#\\")
  (cond
    ((= n 10) (stringbuilder-add-string! sb "newline"))
    ((= n 32) (stringbuilder-add-string! sb "space"))
    ((= n 9) (stringbuilder-add-string! sb "tab"))
    ((= n 13) (stringbuilder-add-string! sb "return"))
    ((= n 0) (stringbuilder-add-string! sb "nul"))
    (else (stringbuilder-add! sb c))))

;; A double with a fraction or an exponent, so that it reads back as a
;; `BjoFloat`: .NET writes 1.0 as "1", which the reader takes for an integer.
;; "1E+20" already has its exponent. NaN and the infinities are written as
;; Scheme writes them, which the reader reads back.
(: double-text (-> double string))
(defun (double-text d)
  (cond
    ((clr-nan? d) "+nan.0")
    ((clr-positive-infinity? d) "+inf.0")
    ((clr-negative-infinity? d) "-inf.0")
    (else
     (def s (double->string d))
     (if (or (string-contains? s ".") (string-contains? s "E") (string-contains? s "e"))
         s
         (str s ".0")))))

(: write-into! (-> StringBuilder Bjodat void))
(defun (write-into! sb v)
  (match v
    ((BjoBool b) (stringbuilder-add-string! sb (if b "#t" "#f")))
    ((BjoInt n) (stringbuilder-add-string! sb (long->string n)))
    ((BjoFloat d) (stringbuilder-add-string! sb (double-text d)))
    ((BjoStr s) (escape-into! sb s))
    ((BjoChar c) (char-into! sb c))
    ((BjoSym s) (stringbuilder-add-string! sb (symbol->string s)))
    ((BjoKey k)
     (stringbuilder-add! sb #\:)
     (stringbuilder-add-string! sb (keyword->string k)))
    ((BjoList xs)
     (stringbuilder-add! sb #\()
     (loop (:with first #t #f)
           (:for x xs)
           (:do (unless first (stringbuilder-add! sb #\space))
                (write-into! sb x)))
     (stringbuilder-add! sb #\)))
    ((BjoVec xs)
     (stringbuilder-add! sb #\[)
     (loop (:with first #t #f)
           (:for x xs)
           (:do (unless first (stringbuilder-add! sb #\space))
                (write-into! sb x)))
     (stringbuilder-add! sb #\]))
    ((BjoMap entries)
     (stringbuilder-add! sb #\{)
     (loop (:with first #t #f)
           (:for x entries)
           (:do (unless first (stringbuilder-add! sb #\space))
                (write-into! sb x)))
     (stringbuilder-add! sb #\}))))

(: bjodat->string (-> Bjodat string))
(defun (bjodat->string v)
  (def sb (stringbuilder-empty))
  (write-into! sb v)
  (stringbuilder->string sb))
