;; std/text.bjo — persistent text: a B+ tree of UTF-8 chunks. Inserting,
;; deleting, splitting and joining are O(log n) and share what they do not
;; change.
;;
;; - Positions are byte offsets, as a string's cursors are. An offset in the
;;   middle of a character is an error.
;; - A text of at most `chunk-max` bytes is one string and no tree.
;; - The tree's nodes are C# (`Bjolang.Runtime.TextTree`), because they hold their
;;   slots in inline arrays. Every operation is here, including those on one
;;   node.
;; - A node has up to 16 children and keeps each one's length in bytes and its
;;   number of newlines. The children of a leaves node (height 1) are chunks:
;;   strings of valid UTF-8 of at most `chunk-max` bytes. The children of a
;;   branch are nodes one level down.
;; - Every node other than a root has at least `min-kids` children. Chunks
;;   are kept at `chunk-min` bytes or more where an edit can merge them with a
;;   neighbour in the same node. This is not an invariant: reads do not
;;   depend on it.
;; - An edit copies the nodes on its path. A transient's owner lets it edit
;;   in place the nodes it copied. Owner 0 copies every node it edits.

(import (std prelude))
(import (std atomic))

(:doc #:file "text.bjodoc")

(export
  Text TextWalk TextBuilder TransientText TextCursor TextBackward TextBackwardStep Texting TextingInto
  TextPiece textbuilder-add-piece!
  ;; Texts
  text-empty text string->text text->string text-length text-empty? text-line-count text-char-count
  text-ref text-substring text-slice text-split-at
  text-concat text-append text-prepend text-insert text-insert-text text-delete text-replace-range
  ;; As a string has them
  text-take text-drop text-take-right text-drop-right
  text-replace text-split text-split-once text-join
  text-search text-search-backward text-search-any text-index
  text-trim text-trim-left text-trim-right text-pad-left text-pad-right
  text-upcase text-downcase text-reverse
  ;; Lines
  text-line-start text-line-end text-line-of text-line
  ;; Characters
  text-next text-prev
  ;; Searching
  text-index-of text-last-index-of text-contains? text-starts-with? text-ends-with?
  ;; Cursors
  text-cursor-at text-cursor-start text-cursor-end text-cursor-at-line text-cursor-offset text-cursor-text
  text-cursor-start? text-cursor-end? text-cursor-ref text-cursor-next text-cursor-prev text-cursor-ref+next
  text-cursor-forward text-cursor-back text-cursor-line text-cursor-column text-cursor-line-start text-cursor-line-end
  text-cursor-search text-cursor-search-backward text-cursor-find text-cursor-find-backward
  text-cursor=? text-cursor<? text-cursor>? text-cursor<=? text-cursor>=?
  text-cursor-substring text-cursor-slice text-backward
  ;; Chunks
  text-fold-chunks text-for-each-chunk text-chunk-count
  ;; Builders
  textbuilder-empty textbuilder-add! textbuilder-add-char! textbuilder-add-text! textbuilder-length textbuilder->text
  ;; Transients
  text->transienttext transienttext->text transienttext-insert! transienttext-delete!
  transienttext-replace-range! transienttext-append! transienttext-length
  ;; Checks, for tests
  text-check text-height)

(import/class
  (ArgumentException (: System.ArgumentException))
  (Utf8Builder (: BjoString.Utf8StringBuilder))
  (ArgumentOutOfRangeException (: System.ArgumentOutOfRangeException))
  (Exception (: System.Exception))
  (TextNode (: Bjolang.Runtime.TextTree.TextNode))
  (TextBranch (: Bjolang.Runtime.TextTree.TextBranch))
  (TextLeaves (: Bjolang.Runtime.TextTree.TextLeaves))
  (StringWalk (: Bjolang.Runtime.StringWalk)))

(import/class ((Lanes %a) (: System.Runtime.Intrinsics.Vector128)))

(import/extern
  (new-branch      (: Bjolang.Runtime.TextTree.TextNodes.NewBranch   (-> long TextBranch)))
  (new-leaves      (: Bjolang.Runtime.TextTree.TextNodes.NewLeaves   (-> long TextLeaves)))
  (copy-branch     (: Bjolang.Runtime.TextTree.TextNodes.CopyBranch  (-> TextBranch long TextBranch)))
  (copy-leaves     (: Bjolang.Runtime.TextTree.TextNodes.CopyLeaves  (-> TextLeaves long TextLeaves)))
  (as-branch       (: Bjolang.Runtime.TextTree.TextNodes.AsBranch    (-> TextNode TextBranch)))
  (as-leaves       (: Bjolang.Runtime.TextTree.TextNodes.AsLeaves    (-> TextNode TextLeaves)))
  (branch-node     (: Bjolang.Runtime.TextTree.TextNodes.BranchNode  (-> TextBranch TextNode)))
  (leaves-node     (: Bjolang.Runtime.TextTree.TextNodes.LeavesNode  (-> TextLeaves TextNode)))
  (node-owner      (: Bjolang.Runtime.TextTree.TextNodes.Owner       (-> TextNode long)))
  (node-count      (: Bjolang.Runtime.TextTree.TextNodes.Count       (-> TextNode int)))
  (set-count!      (: Bjolang.Runtime.TextTree.TextNodes.SetCount    (-> TextNode int void)))
  (slot-end        (: Bjolang.Runtime.TextTree.TextNodes.End         (-> TextNode int int)))
  (set-slot-end!   (: Bjolang.Runtime.TextTree.TextNodes.SetEnd      (-> TextNode int int void)))
  (slot-ends       (: Bjolang.Runtime.TextTree.TextNodes.Ends        (-> TextNode int (RoSpan int))))
  (slot-ends4      (: Bjolang.Runtime.TextTree.TextNodes.Ends4       (-> TextNode int (Lanes int))))
  (set-slot-ends4! (: Bjolang.Runtime.TextTree.TextNodes.SetEnds4    (-> TextNode int (Lanes int) void)))
  (slot-lines      (: Bjolang.Runtime.TextTree.TextNodes.Lines       (-> TextNode int int)))
  (set-slot-lines! (: Bjolang.Runtime.TextTree.TextNodes.SetLines    (-> TextNode int int void)))
  (kid             (: Bjolang.Runtime.TextTree.TextNodes.Kid         (-> TextBranch int TextNode)))
  (set-kid!        (: Bjolang.Runtime.TextTree.TextNodes.SetKid      (-> TextBranch int TextNode void)))
  (chunk-at        (: Bjolang.Runtime.TextTree.TextNodes.Chunk       (-> TextLeaves int string)))
  (set-chunk!      (: Bjolang.Runtime.TextTree.TextNodes.SetChunk    (-> TextLeaves int string void)))
  (string-walk         (: Bjolang.Runtime.StringWalks.Start   (-> string StringWalk)))
  (string-walk-done?   (: Bjolang.Runtime.StringWalks.Done    (-> StringWalk bool)))
  (string-walk-current (: Bjolang.Runtime.StringWalks.Current (-> StringWalk char)))
  (string-walk-next    (: Bjolang.Runtime.StringWalks.Next    (-> StringWalk StringWalk)))
  ;; One allocation of the exact size, for a chunk with text put in it.
  (concat2         (: BjoString.Utf8String.Concat (-> string string string)))
  (concat3         (: BjoString.Utf8String.Concat (-> string string string string)))
  (concat-all      (: BjoString.Utf8String.Concat (-> (RoSpan string) string)))
  ;; Checks the bytes and copies them.
  (utf8->string    (: BjoString.Utf8String.FromUtf8 (-> (RoSpan byte) string)))
  ;; Vectorized in .NET.
  (span-count      (: System.MemoryExtensions.Count             (-> (RoSpan byte) byte int)))
  (span-index-of   (: System.MemoryExtensions.IndexOf           (-> (RoSpan byte) byte int)))
  (span-find       (: System.MemoryExtensions.IndexOf           (-> (RoSpan byte) (RoSpan byte) int)))
  (span-equal?     (: System.MemoryExtensions.SequenceEqual     (-> (RoSpan byte) (RoSpan byte) bool)))
  (span-compare    (: System.MemoryExtensions.SequenceCompareTo (-> (RoSpan byte) (RoSpan byte) int)))
  (span-find-last  (: System.MemoryExtensions.LastIndexOf       (-> (RoSpan byte) (RoSpan byte) int)))
  (span-last-index-of (: System.MemoryExtensions.LastIndexOf    (-> (RoSpan byte) byte int)))
  (span-index-of-any (: System.MemoryExtensions.IndexOfAny      (-> (RoSpan byte) (RoSpan byte) int)))
  (span-first-outside (: System.MemoryExtensions.IndexOfAnyExceptInRange (-> (RoSpan int) int int int)))
  ;; Four ints at once.
  (lanes-splat     (: System.Runtime.Intrinsics.Vector128.Create (-> int (Lanes int))))
  (lanes-of        (: System.Runtime.Intrinsics.Vector128.Create (-> int int int int (Lanes int))))
  (lanes-add       (: System.Runtime.Intrinsics.Vector128.Add (-> (Lanes int) (Lanes int) (Lanes int))))
  (lanes-and       (: System.Runtime.Intrinsics.Vector128.BitwiseAnd (-> (Lanes int) (Lanes int) (Lanes int))))
  (lanes-ge        (: System.Runtime.Intrinsics.Vector128.GreaterThanOrEqual (-> (Lanes int) (Lanes int) (Lanes int))))
  ;; The full 128-bit product, one mulx.
  (big-mul         (: System.Math.BigMul (-> ulong ulong uint128))))

(def cap 16)
(def min-kids 8)
(def chunk-max 1024)
(def chunk-min 256)
;; The longest text an edit puts into one chunk. A chunk that grows past
;; `chunk-max` then splits in two, each at most `chunk-max`.
(def small-insert 512)

(def newline (cast byte 10))

(: (-> string %a))
(defun (bad-argument why) (raise (cast Exception (ArgumentException. why))))

(: (-> string %a))
(defun (out-of-range why) (raise (cast Exception (ArgumentOutOfRangeException. "offset" why))))

;; ---------------------------------------------------------------------------
;; Chunks
;; ---------------------------------------------------------------------------

(: (-> string int))
(defun (newlines-in s) #:inline (span-count (.AsSpan s) newline))

;; The newlines in bytes `from` to `to` of `s`.
(: (-> string int int int))
(defun (newlines-between s from to)
  (if (= from to) 0 (span-count (ro-span-slice (.AsSpan s) #:from from #:to to) newline)))

;; Whether byte `k` of `s` starts a character, or is its end.
(: (-> string int bool))
(defun (boundary? s k)
  (or (<= k 0) (>= k (string-length s))
      (not (= (bitwise-and (cast int (ro-span-ref (.AsSpan s) k)) 192) 128))))

;; The last character boundary at or before `k`.
(: (-> string int int))
(defun (boundary-before s k)
  (let go ((k k)) (if (boundary? s k) k (go (- k 1)))))

;; Bytes `from` to `to` of `s`, sharing its array.
(: (-> string int int string))
(defun (piece s from to) #:inline (.SliceBytes s from (- to from)))

;; ---------------------------------------------------------------------------
;; Nodes
;; ---------------------------------------------------------------------------

(def owners (make-atomic 0L))

(: (-> long))
(defun (owner-next) (atomic-increment! owners))

;; A node that holds nothing, the root of a text that is one string.
(def no-node (leaves-node (new-leaves 0L)))

(: (-> int long TextNode))
(defun (new-node h o)
  (if (= h 1) (leaves-node (new-leaves o)) (branch-node (new-branch o))))

;; `n` if `o` owns it, and otherwise a copy that `o` owns.
(: (-> int TextNode long TextNode))
(defun (editable h n o)
  (cond
    ((and (not (= o 0L)) (= (node-owner n) o)) n)
    ((= h 1) (leaves-node (copy-leaves (as-leaves n) o)))
    (else (branch-node (copy-branch (as-branch n) o)))))

;; The bytes before slot `i` of `n`.
(: (-> TextNode int int))
(defun (slot-base n i) #:inline (if (= i 0) 0 (slot-end n (- i 1))))

(: (-> TextNode int int))
(defun (slot-bytes n i) #:inline (- (slot-end n i) (slot-base n i)))

;; The slot numbers of 4 lanes from `from`.
(def lanes-0 (lanes-of 0 1 2 3))
(def lanes-4 (lanes-of 4 5 6 7))
(def lanes-8 (lanes-of 8 9 10 11))
(def lanes-12 (lanes-of 12 13 14 15))

;; Adds `d` to the 4 ends from slot `from` that are of slot `i` or after.
(: (-> TextNode int (Lanes int) (Lanes int) (Lanes int) void))
(defun (add-ends4! n from slots i d) #:inline
  (set-slot-ends4! n from (lanes-add (slot-ends4 n from) (lanes-and (lanes-ge slots i) d))))

;; Adds `d` to the ends of slot `i` and every slot after it, including those
;; past the count, 4 at a time with no branch.
(: (-> TextNode int int void))
(defun (add-slot-bytes! n i d)
  (def li (lanes-splat i))
  (def ld (lanes-splat d))
  (add-ends4! n 0 lanes-0 li ld)
  (add-ends4! n 4 lanes-4 li ld)
  (add-ends4! n 8 lanes-8 li ld)
  (add-ends4! n 12 lanes-12 li ld))

;; Slot `i` of `n` holds `b` bytes; the slots after it, up to the count, keep
;; theirs.
(: (-> TextNode int int void))
(defun (set-slot-bytes! n i b) #:inline
  (add-slot-bytes! n i (- b (slot-bytes n i))))

(: (-> TextNode int))
(defun (sum-bytes n)
  (def count (node-count n))
  (if (= count 0) 0 (slot-end n (- count 1))))

(: (-> TextNode int))
(defun (sum-lines n)
  (def count (node-count n))
  (let go ((i 0) (acc 0)) (if (< i count) (go (+ i 1) (+ acc (slot-lines n i))) acc)))

;; Slot `i` of the leaves node `n` holds `c`.
(: (-> TextNode int string void))
(defun (put-chunk! n i c)
  (set-chunk! (as-leaves n) i c)
  (set-slot-bytes! n i (string-length c))
  (set-slot-lines! n i (newlines-in c)))

;; Slot `i` of the branch `n` holds the node `k`.
(: (-> TextNode int TextNode void))
(defun (put-kid! n i k)
  (set-kid! (as-branch n) i k)
  (set-slot-bytes! n i (sum-bytes k))
  (set-slot-lines! n i (sum-lines k)))

;; Copies slot `from` of `src` to slot `to` of `dst`, both of height `h`. The
;; end of the slot is that of `src` plus `d`.
(: (-> int TextNode int TextNode int int void))
(defun (copy-slot! h src from dst to d)
  (set-slot-end! dst to (+ (slot-end src from) d))
  (set-slot-lines! dst to (slot-lines src from))
  (if (= h 1)
      (set-chunk! (as-leaves dst) to (chunk-at (as-leaves src) from))
      (set-kid! (as-branch dst) to (kid (as-branch src) from))))

;; Copies `n` slots of `src` from `from` to `dst` from `to`, adding `d` to
;; their ends. The ranges may overlap in one node.
(: (-> int TextNode int TextNode int int int void))
(defun (shift-slots! h src from dst to n d)
  (if (<= to from)
      (loop (:for i (range 0 n)) (:do (copy-slot! h src (+ from i) dst (+ to i) d)))
      (loop (:for i (down-from (- n 1) #:to 0)) (:do (copy-slot! h src (+ from i) dst (+ to i) d)))))

;; Copies `n` slots of `src` from `from` to `dst` from `to`. The ranges may
;; overlap in one node.
;;
;; - The moved slots keep their bytes, after the bytes before slot `to` of
;;   `dst`.
;; - The ends of the slots of `dst` after the moved ones are stale, until they
;;   are overwritten or past the count.
(: (-> int TextNode int TextNode int int void))
(defun (move-slots! h src from dst to n)
  (shift-slots! h src from dst to n (- (slot-base dst to) (slot-base src from))))

;; Empties slots `from` to `to`, so that they keep nothing alive.
(: (-> int TextNode int int void))
(defun (clear-slots! h n from to)
  (loop (:for i (range from to))
        (:do (if (= h 1)
                 (set-chunk! (as-leaves n) i "")
                 (set-kid! (as-branch n) i no-node)))))

;; Opens slot `i` of the editable node `n`, which has room, moving the slots
;; after it one to the right.
(: (-> int TextNode int void))
(defun (open-slot! h n i)
  (def count (node-count n))
  (move-slots! h n i n (+ i 1) (- count i))
  (set-count! n (+ count 1)))

;; Removes slot `i` of the editable node `n`.
(: (-> int TextNode int void))
(defun (remove-slot! h n i)
  (def count (node-count n))
  (move-slots! h n (+ i 1) n i (- count i 1))
  (clear-slots! h n (- count 1) count)
  (set-count! n (- count 1)))

;; A new node with slots `from` to `to` of `n`.
(: (-> int TextNode int int long TextNode))
(defun (node-part h n from to o)
  (def part (new-node h o))
  (move-slots! h n from part 0 (- to from))
  (set-count! part (- to from))
  part)

;; Moves the second half of the editable node `n` into a new node, and returns
;; that.
(: (-> int TextNode long TextNode))
(defun (split-half! h n o)
  (def count (node-count n))
  (def keep (/ count 2))
  (def right (node-part h n keep count o))
  (clear-slots! h n keep count)
  (set-count! n keep)
  right)

;; Moves every slot of `r` to the end of the editable node `l`, which has room.
(: (-> int TextNode TextNode void))
(defun (append-slots! h l r)
  (def cl (node-count l))
  (def cr (node-count r))
  (move-slots! h r 0 l cl cr)
  (set-count! l (+ cl cr)))

;; Moves slots between the editable neighbours `l` and `r` until each has
;; half of them. Moving slots to the front of `r` first shifts its slots right
;; by the bytes that come.
(: (-> int TextNode TextNode void))
(defun (even-out! h l r)
  (def cl (node-count l))
  (def cr (node-count r))
  (def target (/ (+ cl cr) 2))
  (cond
    ((> cl target)
     (def k (- cl target))
     (shift-slots! h r 0 r k cr (- (slot-end l (- cl 1)) (slot-base l target)))
     (move-slots! h l target r 0 k)
     (clear-slots! h l target cl)
     (set-count! l target)
     (set-count! r (+ cr k)))
    ((< cl target)
     (def k (- target cl))
     (move-slots! h r 0 l cl k)
     (move-slots! h r k r 0 (- cr k))
     (clear-slots! h r (- cr k) cr)
     (set-count! l target)
     (set-count! r (- cr k)))
    (else unit)))

;; As `slot-starting`, by comparing the ends in turn. For a step to the next
;; or previous chunk, whose slot is predictable: the loop is small enough for
;; .NET to inline into a per-character loop without taking its registers.
(: (-> TextNode int (Tuple int int)))
(defun (slot-scanning n at)
  (def last (- (node-count n) 1))
  (let go ((i 0) (base 0))
    (def e (slot-end n i))
    (if (and (< i last) (<= e at)) (go (+ i 1) e) (Tuple i (- at base)))))

;; The slot of `n` whose bytes hold offset `at`, and the offset in it. An
;; offset between two slots is the end of the first.
;;
;; - One vectorized search of the ends, with no branch on the slot it finds:
;;   a lookup at an arbitrary offset costs no misprediction at each level.
(: (-> TextNode int (Tuple int int)))
(defun (slot-ending n at)
  (def last (- (node-count n) 1))
  (def i (if (<= at 0) 0 (span-first-outside (slot-ends n last) 0 (- at 1))))
  (def j (if (< i 0) last i))
  (Tuple j (- at (slot-base n j))))

;; As `slot-ending`, but an offset between two slots is the start of the
;; second.
(: (-> TextNode int (Tuple int int)))
(defun (slot-starting n at)
  (def last (- (node-count n) 1))
  (def i (span-first-outside (slot-ends n last) 0 at))
  (def j (if (< i 0) last i))
  (Tuple j (- at (slot-base n j))))

;; ---------------------------------------------------------------------------
;; The text
;; ---------------------------------------------------------------------------

;; `small` is the text when `height` is 0, and `root` is unused. Otherwise
;; `root` is a node of that height and `small` is "".
(type (: Text #:opaque
         (Record (: root TextNode)
                 (: height int)
                 (: bytes int)
                 (: lines int)
                 (: small string))))

(: (-> string Text))
(defun (small-text s)
  (Text (root no-node) (height 0) (bytes (string-length s)) (lines (newlines-in s)) (small s)))

(def empty-text (small-text ""))

(: (-> Text))
(defun (text-empty) empty-text)

(: (-> Text int))
(defun (text-length r) (.bytes r))

(: (-> Text bool))
(defun (text-empty? r) (= (.bytes r) 0))

;; Lines are separated by "\n": one more than the newlines.
(: (-> Text int))
(defun (text-line-count r) (+ (.lines r) 1))

(: (-> Text int))
(defun (text-height r) (.height r))

;; ---------------------------------------------------------------------------
;; Chunks of a tree
;; ---------------------------------------------------------------------------

;; Folds `f` over the chunks of `n`, of height `h`, in order.
(: (-> (-?-> string %a %a) %a TextNode int %a))
(defun (fold-node-chunks f acc n h)
  (def count (node-count n))
  (if (= h 1)
      (let go ((i 0) (acc acc))
        (if (< i count) (go (+ i 1) (f (chunk-at (as-leaves n) i) acc)) acc))
      (let go ((i 0) (acc acc))
        (if (< i count) (go (+ i 1) (fold-node-chunks f acc (kid (as-branch n) i) (- h 1))) acc))))

(: (-> (-?-> string %a %a) %a Text %a))
(defun (text-fold-chunks f init r)
  (cond
    ((> (.height r) 0) (fold-node-chunks f init (.root r) (.height r)))
    ((= (.bytes r) 0) init)
    (else (f (.small r) init))))

(: (-> (-?-> string void) TextNode int void))
(defun (each-node-chunk f n h)
  (def count (node-count n))
  (if (= h 1)
      (loop (:for i (range 0 count)) (:do (f (chunk-at (as-leaves n) i))))
      (loop (:for i (range 0 count)) (:do (each-node-chunk f (kid (as-branch n) i) (- h 1))))))

(: (-> (-?-> string void) Text void))
(defun (text-for-each-chunk f r)
  (cond
    ((> (.height r) 0) (each-node-chunk f (.root r) (.height r)))
    ((> (.bytes r) 0) (f (.small r)))
    (else unit)))

(: (-> Text int))
(defun (text-chunk-count r) (text-fold-chunks (fun (_ n) (+ n 1)) 0 r))

;; The number of chunks under `n`.
(: (-> TextNode int int))
(defun (node-chunks n h)
  (def count (node-count n))
  (if (= h 1)
      count
      (let go ((i 0) (acc 0))
        (if (< i count) (go (+ i 1) (+ acc (node-chunks (kid (as-branch n) i) (- h 1)))) acc))))

;; Puts the chunks under `n` in `out` from `at`, and returns the slot after.
(: (-> TextNode int (Array string) int int))
(defun (gather-chunks! n h out at)
  (def count (node-count n))
  (if (= h 1)
      (begin
        (loop (:for i (range 0 count)) (:do (array-set! out (+ at i) (chunk-at (as-leaves n) i))))
        (+ at count))
      (let go ((i 0) (at at))
        (if (< i count) (go (+ i 1) (gather-chunks! (kid (as-branch n) i) (- h 1) out at)) at))))

;; The text under `n`, in one allocation of its size.
(: (-> TextNode int int string))
(defun (node->string n h bytes)
  (def (: out (Array string)) (make-array (node-chunks n h) #:fill ""))
  (ignore (gather-chunks! n h out 0))
  (concat-all (array->ro-span out)))

(: (-> Text string))
(defun (text->string r)
  (if (= (.height r) 0) (.small r) (node->string (.root r) (.height r) (.bytes r))))

;; The text of a tree, which may be empty (height 0), have a root with one
;; child, or hold no more than one chunk's worth.
(: (-> TextNode int Text))
(defun (tree->text n h)
  (cond
    ((or (= h 0) (= (node-count n) 0)) empty-text)
    ((and (> h 1) (= (node-count n) 1)) (tree->text (kid (as-branch n) 0) (- h 1)))
    (else
     (def bytes (sum-bytes n))
     (if (<= bytes chunk-max)
         (small-text (node->string n h bytes))
         (Text (root n) (height h) (bytes bytes) (lines (sum-lines n)) (small ""))))))

;; The tree of a text: its root and height, and height 0 for an empty one.
(: (-> Text long (Tuple TextNode int)))
(defun (tree-of r o)
  (cond
    ((> (.height r) 0) (Tuple (.root r) (.height r)))
    ((= (.bytes r) 0) (Tuple no-node 0))
    (else
     (def n (new-node 1 o))
     (set-count! n 1)
     (put-chunk! n 0 (.small r))
     (Tuple n 1))))

;; The chunk that holds byte `at`, and the offset it starts at. The end of the
;; text is in its last chunk.
(: (-> Text int (Tuple string int)))
(defun (chunk-of r at)
  (if (= (.height r) 0)
      (Tuple (.small r) 0)
      (let go ((n (.root r)) (h (.height r)) (k at))
        (def (Tuple i k2) (slot-starting n k))
        (if (= h 1)
            (Tuple (chunk-at (as-leaves n) i) (- at k2))
            (go (kid (as-branch n) i) (- h 1) k2)))))

;; As `chunk-of`, with `slot-scanning`: for the step to a neighbouring chunk.
(: (-> Text int (Tuple string int)))
(defun (chunk-scanning r at)
  (if (= (.height r) 0)
      (Tuple (.small r) 0)
      (let go ((n (.root r)) (h (.height r)) (k at))
        (def (Tuple i k2) (slot-scanning n k))
        (if (= h 1)
            (Tuple (chunk-at (as-leaves n) i) (- at k2))
            (go (kid (as-branch n) i) (- h 1) k2)))))

;; As `chunk-of`, with the chunk after it when the same leaves node holds
;; it, and "" otherwise.
(: (-> Text int (Tuple string int string)))
(defun (chunk-and-next r at)
  (if (= (.height r) 0)
      (Tuple (.small r) 0 "")
      (let go ((n (.root r)) (h (.height r)) (k at))
        (def (Tuple i k2) (slot-starting n k))
        (if (= h 1)
            (Tuple (chunk-at (as-leaves n) i) (- at k2)
                   (if (< (+ i 1) (node-count n)) (chunk-at (as-leaves n) (+ i 1)) ""))
            (go (kid (as-branch n) i) (- h 1) k2)))))

;; An iteration over the chunks of a text in order, either way, from the
;; chunk with a given byte. It keeps the path: `nodes` and `slots` hold the
;; node and slot at each level, the leaves node first. A step moves to the
;; next slot of the lowest node that has one, and down its first or last
;; children, so a step costs O(1) amortized and not a search from the root.
(type (: ChunkIter
         (Record (: nodes (Array TextNode))
                 (: slots (Array int))
                 (: height int)
                 (: chunk string #:mutable)
                 (: start int #:mutable))))

;; The iteration on the chunk that holds byte `at`, below the length of `r`.
(: (-> Text int ChunkIter))
(defun (chunk-iter r at)
  (def h (.height r))
  (if (= h 0)
      (ChunkIter (nodes (make-array 0 #:fill no-node)) (slots (make-array 0 #:fill 0)) (height 0)
                 (chunk (.small r)) (start 0))
      (begin
        (def nodes (make-array h #:fill no-node))
        (def slots (make-array h #:fill 0))
        (let go ((n (.root r)) (lvl (- h 1)) (k at) (start 0))
          (def (Tuple i k2) (slot-starting n k))
          (array-set! nodes lvl n)
          (array-set! slots lvl i)
          (if (= lvl 0)
              (ChunkIter (nodes nodes) (slots slots) (height h)
                         (chunk (chunk-at (as-leaves n) i)) (start (+ start (- k k2))))
              (go (kid (as-branch n) i) (- lvl 1) k2 (+ start (- k k2))))))))

;; Moves `it` to the next chunk, and returns #f when there is none.
(: (-> ChunkIter bool))
(defun (chunk-iter-next! it)
  (def nodes (.nodes it))
  (def slots (.slots it))
  (def h (.height it))
  (def next-start (+ (.start it) (string-length (.chunk it))))
  (let up ((lvl 0))
    (cond
      ((>= lvl h) #f)
      ((< (+ (array-ref slots lvl) 1) (node-count (array-ref nodes lvl)))
       (array-set! slots lvl (+ (array-ref slots lvl) 1))
       (let down ((l lvl))
         (when (> l 0)
           (array-set! nodes (- l 1) (kid (as-branch (array-ref nodes l)) (array-ref slots l)))
           (array-set! slots (- l 1) 0)
           (down (- l 1))))
       (record-set! it (chunk (chunk-at (as-leaves (array-ref nodes 0)) (array-ref slots 0))) (start next-start))
       #t)
      (else (up (+ lvl 1))))))

;; Moves `it` to the chunk before, and returns #f when there is none.
(: (-> ChunkIter bool))
(defun (chunk-iter-prev! it)
  (def nodes (.nodes it))
  (def slots (.slots it))
  (def h (.height it))
  (let up ((lvl 0))
    (cond
      ((>= lvl h) #f)
      ((> (array-ref slots lvl) 0)
       (array-set! slots lvl (- (array-ref slots lvl) 1))
       (let down ((l lvl))
         (when (> l 0)
           (def k (kid (as-branch (array-ref nodes l)) (array-ref slots l)))
           (array-set! nodes (- l 1) k)
           (array-set! slots (- l 1) (- (node-count k) 1))
           (down (- l 1))))
       (def c (chunk-at (as-leaves (array-ref nodes 0)) (array-ref slots 0)))
       (record-set! it (chunk c) (start (- (.start it) (string-length c))))
       #t)
      (else (up (+ lvl 1))))))

;; ---------------------------------------------------------------------------
;; Building
;; ---------------------------------------------------------------------------

;; Builds a text from strings added at its end.
;;
;; - `levels` holds the open node of each level, the leaves node at 0. A full
;;   node is closed, into the level above, when the next item comes.
;; - Text shorter than a chunk waits in `pending`. A longer string is cut into
;;   chunks that share its array.
;; - `textbuilder->text` closes the open nodes. The last node of a level, if
;;   it has fewer than `min-kids` children, is merged with or evened out with
;;   the one before it.
(type (: TextBuilder #:opaque
         (Record (: levels (Array TextNode))
                 (: top int #:mutable)
                 (: pending StringBuilder)
                 (: owner long #:mutable)
                 (: bytes int #:mutable))))

(: (-> TextBuilder))
(defun (textbuilder-empty)
  (TextBuilder (levels (make-array 24 #:fill no-node)) (top -1) (pending (Utf8Builder. chunk-max))
               (owner (owner-next)) (bytes 0)))

(: (-> TextBuilder int))
(defun (textbuilder-length b) (.bytes b))

;; The open node of level `lvl`, made if there is none.
(: (-> TextBuilder int TextNode))
(defun (open-node b lvl)
  (when (> lvl (.top b))
    (array-set! (.levels b) lvl (new-node (+ lvl 1) (.owner b)))
    (record-set! b (top lvl)))
  (array-ref (.levels b) lvl))

;; Closes the full open node of level `lvl` into the level above.
(: (-> TextBuilder int void))
(defun (close-level! b lvl)
  (def full (array-ref (.levels b) lvl))
  (array-set! (.levels b) lvl (new-node (+ lvl 1) (.owner b)))
  (add-node! b (+ lvl 1) full))

;; Adds `k`, a node of height `lvl`, to level `lvl`.
(: (-> TextBuilder int TextNode void))
(defun (add-node! b lvl k)
  (when (= (node-count (open-node b lvl)) cap) (close-level! b lvl))
  (def n (array-ref (.levels b) lvl))
  (def i (node-count n))
  (set-count! n (+ i 1))
  (put-kid! n i k))

(: (-> TextBuilder string void))
(defun (add-chunk! b c)
  (when (= (node-count (open-node b 0)) cap) (close-level! b 0))
  (def n (array-ref (.levels b) 0))
  (def i (node-count n))
  (set-count! n (+ i 1))
  (put-chunk! n i c))

(: (-> TextBuilder void))
(defun (flush-pending! b)
  (def p (.pending b))
  (when (> (stringbuilder-length p) 0)
    (def c (stringbuilder->string p))
    (stringbuilder-clear! p)
    (add-chunk! b c)))

(: (-> TextBuilder string void))
(defun (textbuilder-add! b s)
  (def len (string-length s))
  (def p (.pending b))
  (def pl (stringbuilder-length p))
  (record-set! b (bytes (+ (.bytes b) len)))
  (cond
    ((= len 0) unit)
    ((and (= pl 0) (>= len chunk-min) (<= len chunk-max)) (add-chunk! b s))
    ((<= (+ pl len) chunk-max)
     (stringbuilder-add-string! p s)
     (when (= (+ pl len) chunk-max) (flush-pending! b)))
    (else
     ;; The pending chunk filled up from the front of `s`, then whole chunks
     ;; that share `s`, then the rest pending.
     (def start
       (if (= pl 0)
           0
           (begin
             (def cut (boundary-before s (- chunk-max pl)))
             (stringbuilder-add-string! p (piece s 0 cut))
             (flush-pending! b)
             cut)))
     (let go ((at start))
       (if (> (- len at) chunk-max)
           (begin
             (def cut (boundary-before s (+ at chunk-max)))
             (add-chunk! b (piece s at cut))
             (go cut))
           (when (< at len)
             (if (>= (- len at) chunk-min)
                 (add-chunk! b (piece s at len))
                 (stringbuilder-add-string! p (piece s at len)))))))))

;; Adds `ch`, in the pending chunk, which goes to the tree first when `ch`
;; would take it past `chunk-max`.
(: (-> TextBuilder char void))
(defun (textbuilder-add-char! b ch)
  (def cp (char->integer ch))
  (def w (cond ((< cp 128) 1) ((< cp 2048) 2) ((< cp 65536) 3) (else 4)))
  (def p (.pending b))
  (when (> (+ (stringbuilder-length p) w) chunk-max) (flush-pending! b))
  (stringbuilder-add! p ch)
  (record-set! b (bytes (+ (.bytes b) w))))

(: (-> TextBuilder Text void))
(defun (textbuilder-add-text! b r)
  (text-for-each-chunk (fun (c) (textbuilder-add! b c)) r))

;; The pending text as the last chunk. A short one is merged with the chunk
;; before it, or evened out with it.
(: (-> TextBuilder void))
(defun (flush-last! b)
  (def p (.pending b))
  (def pl (stringbuilder-length p))
  (when (> pl 0)
    (def c (stringbuilder->string p))
    (stringbuilder-clear! p)
    (def n (if (>= (.top b) 0) (array-ref (.levels b) 0) no-node))
    (def count (node-count n))
    (if (or (>= pl chunk-min) (= count 0))
        (add-chunk! b c)
        (begin
          (def last (chunk-at (as-leaves n) (- count 1)))
          (def t (string-append last c))
          (if (<= (string-length t) chunk-max)
              (put-chunk! n (- count 1) t)
              (begin
                (def cut (boundary-before t (/ (string-length t) 2)))
                (put-chunk! n (- count 1) (piece t 0 cut))
                (add-chunk! b (piece t cut (string-length t)))))))))

(: (-> TextBuilder Text))
(defun (textbuilder->text b)
  (flush-last! b)
  (def levels (.levels b))
  ;; Each level's open node goes into the level above, from the bottom. The
  ;; one before it is always there: a level above is only opened by closing
  ;; a node of this one.
  (let go ((lvl 0))
    (when (< lvl (.top b))
      (def x (array-ref levels lvl))
      (def cx (node-count x))
      (when (> cx 0)
        (def parent (array-ref levels (+ lvl 1)))
        (def cp (node-count parent))
        (if (and (< cx min-kids) (> cp 0))
            (begin
              (def h (+ lvl 1))
              (def y (editable h (kid (as-branch parent) (- cp 1)) (.owner b)))
              (if (<= (+ (node-count y) cx) cap)
                  (begin (append-slots! h y x) (put-kid! parent (- cp 1) y))
                  (begin
                    (even-out! h y x)
                    (put-kid! parent (- cp 1) y)
                    (add-node! b (+ lvl 1) x))))
            (add-node! b (+ lvl 1) x)))
      (go (+ lvl 1))))
  (def top (.top b))
  (def result (if (< top 0) empty-text (tree->text (array-ref levels top) (+ top 1))))
  ;; Start over, with an owner that does not own what was given away.
  (loop (:for i (range 0 (+ top 1))) (:do (array-set! levels i no-node)))
  (record-set! b (top -1) (owner (owner-next)) (bytes 0))
  result)

;; A text of the strings, in order.
(: (-> #:rest string Text))
(defun (text #:rest parts)
  (def b (textbuilder-empty))
  (loop (:for s parts) (:do (textbuilder-add! b s)))
  (textbuilder->text b))

(: (-> string Text))
(defun (string->text s)
  (if (<= (string-length s) chunk-max)
      (small-text s)
      (begin
        (def b (textbuilder-empty))
        (textbuilder-add! b s)
        (textbuilder->text b))))

;; ---------------------------------------------------------------------------
;; Joining
;; ---------------------------------------------------------------------------

;; A new node of height `h` with the children `a` and `b`.
(: (-> int TextNode TextNode long TextNode))
(defun (pair-node h a b o)
  (def n (new-node h o))
  (set-count! n 2)
  (put-kid! n 0 a)
  (put-kid! n 1 b)
  n)

;; Merges the chunks at slots `i - 1` and `i` of the editable leaves node `n`
;; when one is shorter than `chunk-min` and the two fit in one.
(: (-> int TextNode int void))
(defun (tidy-seam! h n i)
  (when (and (= h 1) (> i 0) (< i (node-count n)))
    (def a (slot-bytes n (- i 1)))
    (def b (slot-bytes n i))
    (when (and (or (< a chunk-min) (< b chunk-min)) (<= (+ a b) chunk-max))
      (def l (as-leaves n))
      (put-chunk! n (- i 1) (string-append (chunk-at l (- i 1)) (chunk-at l i)))
      (remove-slot! 1 n i))))

;; Puts `k` in slot `j` of the editable node `n`. A full `n` is split first;
;; the result is then the two halves in order and #t.
(: (-> TextNode int int TextNode long (Tuple TextNode TextNode bool)))
(defun (add-kid-at n h j k o)
  (if (< (node-count n) cap)
      (begin
        (open-slot! h n j)
        (put-kid! n j k)
        (Tuple n no-node #f))
      (begin
        (def right (split-half! h n o))
        (def keep (node-count n))
        (if (<= j keep)
            (begin (open-slot! h n j) (put-kid! n j k))
            (begin (open-slot! h right (- j keep)) (put-kid! right (- j keep) k)))
        (Tuple n right #t))))

;; Joins `b`, of height `hb`, to the right of `a`, of the greater height `ha`.
;; The result is a node of height `ha`, and a second one after it when the
;; first had no room.
(: (-> TextNode int TextNode int long (Tuple TextNode TextNode bool)))
(defun (join-right a ha b hb o)
  (def n (editable ha a o))
  (def last (- (node-count n) 1))
  (def y (kid (as-branch n) last))
  (if (= (- ha 1) hb)
      (begin
        (def cy (node-count y))
        (def cb (node-count b))
        (if (<= (+ cy cb) cap)
            (begin
              (def y2 (editable hb y o))
              (append-slots! hb y2 b)
              (tidy-seam! hb y2 cy)
              (put-kid! n last y2)
              (Tuple n no-node #f))
            (if (or (< cy min-kids) (< cb min-kids))
                (begin
                  (def y2 (editable hb y o))
                  (def b2 (editable hb b o))
                  (even-out! hb y2 b2)
                  (put-kid! n last y2)
                  (add-kid-at n ha (+ last 1) b2 o))
                (add-kid-at n ha (+ last 1) b o))))
      (begin
        (def (Tuple c extra split?) (join-right y (- ha 1) b hb o))
        (put-kid! n last c)
        (if split? (add-kid-at n ha (+ last 1) extra o) (Tuple n no-node #f)))))

;; Joins `a`, of height `ha`, to the left of `b`, of the greater height `hb`,
;; as `join-right` does.
(: (-> TextNode int TextNode int long (Tuple TextNode TextNode bool)))
(defun (join-left a ha b hb o)
  (def n (editable hb b o))
  (def y (kid (as-branch n) 0))
  (if (= (- hb 1) ha)
      (begin
        (def cy (node-count y))
        (def ca (node-count a))
        (if (<= (+ cy ca) cap)
            (begin
              (def a2 (editable ha a o))
              (append-slots! ha a2 y)
              (tidy-seam! ha a2 ca)
              (put-kid! n 0 a2)
              (Tuple n no-node #f))
            (if (or (< cy min-kids) (< ca min-kids))
                (begin
                  (def y2 (editable ha y o))
                  (def a2 (editable ha a o))
                  (even-out! ha a2 y2)
                  (put-kid! n 0 y2)
                  (add-kid-at n hb 0 a2 o))
                (add-kid-at n hb 0 a o))))
      (begin
        (def (Tuple first second split?) (join-left a ha y (- hb 1) o))
        (put-kid! n 0 first)
        (if split? (add-kid-at n hb 1 second o) (Tuple n no-node #f)))))

;; The tree of `a` followed by `b`. Either may be empty (height 0) or have a
;; root with fewer than `min-kids` children; every other node is full enough.
(: (-> TextNode int TextNode int long (Tuple TextNode int)))
(defun (join a ha b hb o)
  (cond
    ((= ha 0) (Tuple b hb))
    ((= hb 0) (Tuple a ha))
    ((= ha hb)
     (def ca (node-count a))
     (def cb (node-count b))
     (if (<= (+ ca cb) cap)
         (begin
           (def m (editable ha a o))
           (append-slots! ha m b)
           (tidy-seam! ha m ca)
           (Tuple m ha))
         (begin
           (def a2 (editable ha a o))
           (def b2 (editable ha b o))
           (when (or (< ca min-kids) (< cb min-kids)) (even-out! ha a2 b2))
           (Tuple (pair-node (+ ha 1) a2 b2 o) (+ ha 1)))))
    ((> ha hb)
     (def (Tuple n extra split?) (join-right a ha b hb o))
     (if split? (Tuple (pair-node (+ ha 1) n extra o) (+ ha 1)) (Tuple n ha)))
    (else
     (def (Tuple first second split?) (join-left a ha b hb o))
     (if split? (Tuple (pair-node (+ hb 1) first second o) (+ hb 1)) (Tuple first hb)))))

(: (-> Text Text long Text))
(defun (concat-with a b o)
  (cond
    ((= (.bytes a) 0) b)
    ((= (.bytes b) 0) a)
    ((and (= (.height b) 0) (<= (.bytes b) small-insert)) (insert-with a (.bytes a) (.small b) o))
    ((and (= (.height a) 0) (<= (.bytes a) small-insert)) (insert-with b 0 (.small a) o))
    (else
     (def (Tuple na ha) (tree-of a o))
     (def (Tuple nb hb) (tree-of b o))
     (def (Tuple n h) (join na ha nb hb o))
     (tree->text n h))))

(: (-> Text Text Text))
(defun (text-concat a b) (concat-with a b (owner-next)))

;; ---------------------------------------------------------------------------
;; Splitting
;; ---------------------------------------------------------------------------

(: (-> string int string void))
(defun (check-boundary s k who)
  (unless (boundary? s k) (inside-character who)))

;; Raises that an offset is inside a character. Not inlined, as
;; `cursor-at-edge`.
(: (-> string void))
(defun (inside-character who) #:no-inline
  (bad-argument (str who ": the offset is in the middle of a character.")))

;; Merges the chunk at slot `i` of the editable leaves node `n` with a
;; neighbour when it is shorter than `chunk-min`: into one chunk if they fit,
;; and otherwise into two of about the same length.
(: (-> TextNode int void))
(defun (merge-small-chunk! n i)
  (def count (node-count n))
  (when (and (> count 1) (< (slot-bytes n i) chunk-min))
    (def a (if (< (+ i 1) count) i (- i 1)))
    (def l (as-leaves n))
    (def t (string-append (chunk-at l a) (chunk-at l (+ a 1))))
    (def tl (string-length t))
    (if (<= tl chunk-max)
        (begin (put-chunk! n a t) (remove-slot! 1 n (+ a 1)))
        (begin
          (def cut (boundary-before t (/ tl 2)))
          (put-chunk! n a (piece t 0 cut))
          (put-chunk! n (+ a 1) (piece t cut tl))))))

;; The trees of the bytes of `n`, of height `h`, before and after `at`, where
;; 0 < `at` < the bytes of `n`.
(: (-> TextNode int int string long (Tuple TextNode int TextNode int)))
(defun (split-tree n h at who o)
  (def (Tuple i k) (slot-ending n at))
  (def count (node-count n))
  (if (= h 1)
      (begin
        (def c (chunk-at (as-leaves n) i))
        (def cl (string-length c))
        (check-boundary c k who)
        (def left (node-part 1 n 0 i o))
        (set-count! left (+ i 1))
        (put-chunk! left i (piece c 0 k))
        (merge-small-chunk! left i)
        (def rest (- count i 1))
        (def right
          (if (< k cl)
              (begin
                (def r (new-node 1 o))
                (set-count! r 1)
                (put-chunk! r 0 (piece c k cl))
                (move-slots! 1 n (+ i 1) r 1 rest)
                (set-count! r (+ rest 1))
                (merge-small-chunk! r 0)
                r)
              (node-part 1 n (+ i 1) count o)))
        (Tuple left 1 right (if (= (node-count right) 0) 0 1)))
      (if (= k (slot-bytes n i))
          (Tuple (node-part h n 0 (+ i 1) o) h
                 (node-part h n (+ i 1) count o) (if (= (+ i 1) count) 0 h))
          (begin
            (def (Tuple ln lh rn rh) (split-tree (kid (as-branch n) i) (- h 1) k who o))
            (def (Tuple l2 lh2) (join (node-part h n 0 i o) (if (= i 0) 0 h) ln lh o))
            (def (Tuple r2 rh2) (join rn rh (node-part h n (+ i 1) count o) (if (= (+ i 1) count) 0 h) o))
            (Tuple l2 lh2 r2 rh2)))))

(: (-> Text int string long (Tuple Text Text)))
(defun (split-with r at who o)
  (check-offset r at who)
  (cond
    ((= at 0) (Tuple empty-text r))
    ((= at (.bytes r)) (Tuple r empty-text))
    ((= (.height r) 0)
     (def s (.small r))
     (check-boundary s at who)
     (Tuple (small-text (piece s 0 at)) (small-text (piece s at (.bytes r)))))
    (else
     (def (Tuple ln lh rn rh) (split-tree (.root r) (.height r) at who o))
     (Tuple (tree->text ln lh) (tree->text rn rh)))))

(: (-> Text int string void))
(defun (check-offset r at who)
  (when (or (< at 0) (> at (.bytes r))) (offset-outside who at (.bytes r))))

;; Raises that `at` is outside a text of `bytes` bytes. Not inlined, as
;; `cursor-at-edge`.
(: (-> string int int void))
(defun (offset-outside who at bytes) #:no-inline
  (out-of-range #"${who}: the offset ${at} is outside the text, of ${bytes} bytes."))

(: (-> Text int (Tuple Text Text)))
(defun (text-split-at r at) (split-with r at "text-split-at" (owner-next)))

(: (-> Text int int Text))
(defun (text-slice r from to)
  (check-range r from to "text-slice")
  (def o (owner-next))
  (def (Tuple _ tail) (split-with r from "text-slice" o))
  (def (Tuple mid _) (split-with tail (- to from) "text-slice" o))
  mid)

(: (-> Text int int string void))
(defun (check-range r from to who)
  (check-offset r from who)
  (check-offset r to who)
  (when (> from to)
    (out-of-range #"${who}: the range ${from} to ${to} ends before it starts.")))

;; ---------------------------------------------------------------------------
;; Inserting
;; ---------------------------------------------------------------------------

;; Puts `s`, of `sl` newlines and at most `small-insert` bytes, at byte `at`
;; of the editable node `n`, which has room for one more slot.
(: (-> TextNode int int string int long void))
(defun (insert-into! n h at s sl o)
  (def slen (string-length s))
  (def (Tuple i k) (slot-ending n at))
  (if (= h 1)
      (begin
        (def l (as-leaves n))
        (def c (chunk-at l i))
        (check-boundary c k "text-insert")
        (def cl (string-length c))
        (def t (concat3 (piece c 0 k) s (piece c k cl)))
        (if (<= (+ cl slen) chunk-max)
            (begin
              (set-chunk! l i t)
              (set-slot-bytes! n i (+ cl slen))
              (set-slot-lines! n i (+ (slot-lines n i) sl)))
            (begin
              (def tl (string-length t))
              (def cut (boundary-before t (/ tl 2)))
              (open-slot! 1 n (+ i 1))
              (put-chunk! n i (piece t 0 cut))
              (put-chunk! n (+ i 1) (piece t cut tl)))))
      (begin
        (def b (as-branch n))
        (def child (editable (- h 1) (kid b i) o))
        (set-kid! b i child)
        (if (= (node-count child) cap)
            (begin
              (def right (split-half! (- h 1) child o))
              (open-slot! h n (+ i 1))
              (put-kid! n i child)
              (put-kid! n (+ i 1) right)
              (def lb (slot-bytes n i))
              (if (<= k lb)
                  (into-kid! n h i child k s sl o)
                  (into-kid! n h (+ i 1) right (- k lb) s sl o)))
            (into-kid! n h i child k s sl o)))))

(: (-> TextNode int int TextNode int string int long void))
(defun (into-kid! n h i child k s sl o)
  (insert-into! child (- h 1) k s sl o)
  (add-slot-bytes! n i (string-length s))
  (set-slot-lines! n i (+ (slot-lines n i) sl)))

(: (-> Text int string long Text))
(defun (insert-with r at s o)
  (check-offset r at "text-insert")
  (def slen (string-length s))
  (cond
    ((= slen 0) r)
    ((= (.height r) 0)
     (def s0 (.small r))
     (def len0 (.bytes r))
     (check-boundary s0 at "text-insert")
     (if (<= (+ len0 slen) chunk-max)
         (small-text (concat3 (piece s0 0 at) s (piece s0 at len0)))
         (text (piece s0 0 at) s (piece s0 at len0))))
    ((<= slen small-insert)
     (def h (.height r))
     (def n (editable h (.root r) o))
     (def sl (newlines-in s))
     (def (Tuple root height)
       (if (= (node-count n) cap)
           (begin
             (def right (split-half! h n o))
             (Tuple (pair-node (+ h 1) n right o) (+ h 1)))
           (Tuple n h)))
     (insert-into! root height at s sl o)
     (Text (root root) (height height) (bytes (+ (.bytes r) slen)) (lines (+ (.lines r) sl)) (small "")))
    (else
     (def (Tuple l rr) (split-with r at "text-insert" o))
     (concat-with (concat-with l (string->text s) o) rr o))))

(: (-> Text int string Text))
(defun (text-insert r at s) (insert-with r at s (owner-next)))

(: (-> Text int Text Text))
(defun (text-insert-text r at x)
  (def o (owner-next))
  (def (Tuple l rr) (split-with r at "text-insert-text" o))
  (concat-with (concat-with l x o) rr o))

(: (-> Text string Text))
(defun (text-append r s) (insert-with r (.bytes r) s (owner-next)))

(: (-> Text string Text))
(defun (text-prepend r s) (insert-with r 0 s (owner-next)))

;; ---------------------------------------------------------------------------
;; Deleting
;; ---------------------------------------------------------------------------

;; Merges child `i` of the editable branch `n`, of height `h`, which has fewer
;; than `min-kids` children, with a neighbour, or evens the two out.
(: (-> TextNode int int long void))
(defun (fix-underflow! n h i o)
  (def count (node-count n))
  (when (> count 1)
    (def a (if (< (+ i 1) count) i (- i 1)))
    (def b (as-branch n))
    (def x (editable (- h 1) (kid b a) o))
    (def y (editable (- h 1) (kid b (+ a 1)) o))
    (def cx (node-count x))
    (if (<= (+ cx (node-count y)) cap)
        (begin
          (append-slots! (- h 1) x y)
          (tidy-seam! (- h 1) x cx)
          (put-kid! n a x)
          (remove-slot! h n (+ a 1)))
        (begin
          (even-out! (- h 1) x y)
          (put-kid! n a x)
          (put-kid! n (+ a 1) y)))))

;; Deletes bytes `at` to `at + len` of the editable node `n`, all in one
;; chunk, and returns how many newlines they held.
(: (-> TextNode int int int long int))
(defun (delete-into! n h at len o)
  (def (Tuple i k) (slot-starting n at))
  (if (= h 1)
      (begin
        (def l (as-leaves n))
        (def c (chunk-at l i))
        (def cl (string-length c))
        (check-boundary c k "text-delete")
        (check-boundary c (+ k len) "text-delete")
        (def dl (newlines-between c k (+ k len)))
        (if (= len cl)
            (remove-slot! 1 n i)
            (begin
              (set-chunk! l i (concat3 (piece c 0 k) "" (piece c (+ k len) cl)))
              (set-slot-bytes! n i (- cl len))
              (set-slot-lines! n i (- (slot-lines n i) dl))
              (merge-small-chunk! n i)))
        dl)
      (begin
        (def b (as-branch n))
        (def child (editable (- h 1) (kid b i) o))
        (set-kid! b i child)
        (def dl (delete-into! child (- h 1) k len o))
        (add-slot-bytes! n i (- len))
        (set-slot-lines! n i (- (slot-lines n i) dl))
        (when (< (node-count child) min-kids) (fix-underflow! n h i o))
        dl)))

(: (-> Text int int long Text))
(defun (delete-with r from to o)
  (check-range r from to "text-delete")
  (def len (- to from))
  (cond
    ((= len 0) r)
    ((= (.height r) 0)
     (def s (.small r))
     (check-boundary s from "text-delete")
     (check-boundary s to "text-delete")
     (small-text (concat3 (piece s 0 from) "" (piece s to (.bytes r)))))
    (else
     (def (Tuple c start) (chunk-of r from))
     (if (<= to (+ start (string-length c)))
         (begin
           (def h (.height r))
           (def n (editable h (.root r) o))
           (def dl (delete-into! n h from len o))
           (tree->text-sized n h (- (.bytes r) len) (- (.lines r) dl)))
         (begin
           (def (Tuple l tail) (split-with r from "text-delete" o))
           (def (Tuple _ rr) (split-with tail len "text-delete" o))
           (concat-with l rr o))))))

;; `tree->text` for a root whose bytes and newlines are known.
(: (-> TextNode int int int Text))
(defun (tree->text-sized n h bytes lines)
  (if (or (<= bytes chunk-max) (and (> h 1) (= (node-count n) 1)))
      (tree->text n h)
      (Text (root n) (height h) (bytes bytes) (lines lines) (small ""))))

(: (-> Text int int Text))
(defun (text-delete r from to) (delete-with r from to (owner-next)))

(: (-> Text int int string Text))
(defun (text-replace-range r from to s)
  (def o (owner-next))
  (insert-with (delete-with r from to o) from s o))

;; ---------------------------------------------------------------------------
;; Characters and text
;; ---------------------------------------------------------------------------

;; The number of bytes of the character whose first byte is `b`.
(: (-> int int))
(defun (char-width b)
  (cond ((< b 128) 1) ((< b 224) 2) ((< b 240) 3) (else 4)))

(: (-> (RoSpan byte) int int))
(defun (byte-at sp i) #:inline (cast int (ro-span-ref sp i)))

;; The character that starts at byte `k` of `c`.
(: (-> string int char))
(defun (decode-at c k)
  (def sp (.AsSpan c))
  (def b0 (byte-at sp k))
  (integer->char
   (cond
     ((< b0 128) b0)
     ((< b0 224) (bitwise-ior (shift-left (bitwise-and b0 31) 6) (bitwise-and (byte-at sp (+ k 1)) 63)))
     ((< b0 240) (bitwise-ior (shift-left (bitwise-and b0 15) 12)
                              (bitwise-ior (shift-left (bitwise-and (byte-at sp (+ k 1)) 63) 6)
                                           (bitwise-and (byte-at sp (+ k 2)) 63))))
     (else (bitwise-ior (shift-left (bitwise-and b0 7) 18)
                        (bitwise-ior (shift-left (bitwise-and (byte-at sp (+ k 1)) 63) 12)
                                     (bitwise-ior (shift-left (bitwise-and (byte-at sp (+ k 2)) 63) 6)
                                                  (bitwise-and (byte-at sp (+ k 3)) 63))))))))

(: (-> Text int string void))
(defun (check-char r at who)
  (when (or (< at 0) (>= at (.bytes r)))
    (out-of-range #"${who}: there is no character at ${at} in a text of ${(.bytes r)} bytes.")))

;; The character that starts at byte `at`.
(: (-> Text int char))
(defun (text-ref r at)
  (check-char r at "text-ref")
  (def (Tuple c start) (chunk-of r at))
  (check-boundary c (- at start) "text-ref")
  (decode-at c (- at start)))

;; The offset of the character after the one at `at`.
(: (-> Text int int))
(defun (text-next r at)
  (check-char r at "text-next")
  (def (Tuple c start) (chunk-of r at))
  (+ at (char-width (byte-at (.AsSpan c) (- at start)))))

;; The offset of the character before `at`, which is after the first.
(: (-> Text int int))
(defun (text-prev r at)
  (when (or (<= at 0) (> at (.bytes r)))
    (out-of-range #"text-prev: there is no character before ${at} in a text of ${(.bytes r)} bytes."))
  (def (Tuple c start) (chunk-of r (- at 1)))
  (+ start (boundary-before c (- (- at 1) start))))

;; Bytes `from` to `to` as a string of their own.
(: (-> Text int int string))
(defun (text-substring r from to)
  (check-range r from to "text-substring")
  (cond
    ((= from to) "")
    ((= (.height r) 0)
     (check-boundary (.small r) from "text-substring")
     (check-boundary (.small r) to "text-substring")
     (string-copy (piece (.small r) from to)))
    (else
     ;; The pieces of the chunks from `from` to `to`, joined in one
     ;; allocation of their size.
     (def (Tuple c0 s0 after) (chunk-and-next r from))
     (check-boundary c0 (- from s0) "text-substring")
     (def e0 (+ s0 (string-length c0)))
     (if (<= to e0)
         (begin
           (check-boundary c0 (- to s0) "text-substring")
           (string-copy (piece c0 (- from s0) (- to s0))))
         (begin
           (def first (piece c0 (- from s0) (string-length c0)))
           (def c1 (if (= (string-length after) 0)
                       (begin (def (Tuple c _) (chunk-of r e0)) c)
                       after))
           (def s1 e0)
           (if (<= to (+ s1 (string-length c1)))
               (begin
                 (check-boundary c1 (- to s1) "text-substring")
                 (concat2 first (piece c1 0 (- to s1))))
               (begin
                 ;; The chunks the range touches, counted on a second iteration.
                 (def it (chunk-iter r e0))
                 (def ci (chunk-iter r e0))
                 (def count (let go ((n 2))
                              (if (>= (+ (.start ci) (string-length (.chunk ci))) to)
                                  n
                                  (begin (ignore (chunk-iter-next! ci)) (go (+ n 1))))))
                 (def (: parts (Array string)) (make-array count #:fill ""))
                 (array-set! parts 0 first)
                 (let fill ((k 1))
                   (def c (.chunk it))
                   (def st (.start it))
                   (if (= k (- count 1))
                       (begin
                         (check-boundary c (- to st) "text-substring")
                         (array-set! parts k (piece c 0 (- to st))))
                       (begin
                         (array-set! parts k c)
                         (ignore (chunk-iter-next! it))
                         (fill (+ k 1)))))
                 (concat-all (array->ro-span parts)))))))))

(: (-> Text int))
(defun (text-char-count r) (text-fold-chunks (fun (c n) (+ n (.Count c))) 0 r))

;; ---------------------------------------------------------------------------
;; Lines
;; ---------------------------------------------------------------------------

;; The offset after the `line`-th newline of `c`, counting from 1.
(: (-> string int int))
(defun (nth-newline-end c line)
  (def sp (.AsSpan c))
  (let go ((from 0) (left line))
    (def j (+ from (span-index-of (ro-span-slice sp #:from from) newline)))
    (if (= left 1) (+ j 1) (go (+ j 1) (- left 1)))))

;; The offset after the `line`-th newline of `n`, counting from 1.
(: (-> TextNode int int int))
(defun (line-start-in n h line)
  (let go ((i 0) (line line))
    (def l (slot-lines n i))
    (cond
      ((> line l) (go (+ i 1) (- line l)))
      ((= h 1) (+ (slot-base n i) (nth-newline-end (chunk-at (as-leaves n) i) line)))
      (else (+ (slot-base n i) (line-start-in (kid (as-branch n) i) (- h 1) line))))))

(: (-> Text int string void))
(defun (check-line r n who)
  (when (or (< n 0) (> n (.lines r)))
    (out-of-range #"${who}: there is no line ${n} in a text of ${(+ (.lines r) 1)} lines.")))

;; The offset of the first byte of line `n`, counting from 0.
(: (-> Text int int))
(defun (text-line-start r n)
  (check-line r n "text-line-start")
  (cond
    ((= n 0) 0)
    ((= (.height r) 0) (nth-newline-end (.small r) n))
    (else (line-start-in (.root r) (.height r) n))))

;; The offset of the newline that ends line `n`, or the end of the text for
;; the last line.
(: (-> Text int int))
(defun (text-line-end r n)
  (check-line r n "text-line-end")
  (if (= n (.lines r)) (.bytes r) (- (text-line-start r (+ n 1)) 1)))

;; The line that byte `at` is on: the newlines before it.
(: (-> Text int int))
(defun (text-line-of r at)
  (check-offset r at "text-line-of")
  (if (= (.height r) 0)
      (newlines-between (.small r) 0 at)
      (let go ((n (.root r)) (h (.height r)) (at at) (acc 0))
        (def (Tuple i k) (slot-starting n at))
        (def before (let sum ((j 0) (acc acc)) (if (< j i) (sum (+ j 1) (+ acc (slot-lines n j))) acc)))
        (if (= h 1)
            (+ before (newlines-between (chunk-at (as-leaves n) i) 0 k))
            (go (kid (as-branch n) i) (- h 1) k before)))))

;; Line `n`, without its newline.
(: (-> Text int string))
(defun (text-line r n)
  (text-substring r (text-line-start r n) (text-line-end r n)))

;; ---------------------------------------------------------------------------
;; Searching
;; ---------------------------------------------------------------------------

;; Whether the bytes of `r` from `at` are those of `s`.
(: (-> Text int string bool))
(defun (matches-at? r at s)
  (def m (string-length s))
  (def ss (.AsSpan s))
  (and (<= (+ at m) (.bytes r))
       (let go ((p at))
         (if (>= p (+ at m))
             #t
             (begin
               (def (Tuple c start) (chunk-of r p))
               (def e (min (+ start (string-length c)) (+ at m)))
               (and (span-equal? (ro-span-slice (.AsSpan c) #:from (- p start) #:to (- e start))
                                 (ro-span-slice ss #:from (- p at) #:to (- e at)))
                    (go e)))))))

;; The offset of the first `s` at or after `at`, or -1, searched from the
;; chunks of `it`, which is on the chunk that holds `at` or one before it.
;; Leaves `it` on the chunk where the search stopped, at or before the chunk
;; of the match's end, so the next search can continue from it.
(: (-> Text ChunkIter string int int))
(defun (index-from! r it s at)
  (def m (string-length s))
  (def bytes (.bytes r))
  (def ss (.AsSpan s))
  (def first (cast byte (ro-span-ref ss 0)))
  (let skip ()
    (when (and (<= (+ (.start it) (string-length (.chunk it))) at) (chunk-iter-next! it)) (skip)))
  (let go ((at at))
    (if (> (+ at m) bytes)
        -1
        (begin
          (def c (.chunk it))
          (def start (.start it))
          (def cl (string-length c))
          (def sp (.AsSpan c))
          (def k (- at start))
          (def j (span-find (ro-span-slice sp #:from k) ss))
          (cond
            ((>= j 0) (+ at j))
            ((not (chunk-iter-next! it)) -1)
            (else
             ;; A match that starts in this chunk and ends in the next one,
             ;; or past it.
             (def nc (.chunk it))
             (let straddle ((p (max k (- cl (- m 1)))))
               (def q (if (< p cl) (span-index-of (ro-span-slice sp #:from p) first) -1))
               (if (< q 0)
                   (go (+ start cl))
                   (begin
                     (def pp (+ p q))
                     (def head (- cl pp))
                     (if (and (span-equal? (ro-span-slice sp #:from pp) (ro-span-slice ss #:from 0 #:to head))
                              (if (<= (- m head) (string-length nc))
                                  (span-equal? (ro-span-slice (.AsSpan nc) #:from 0 #:to (- m head))
                                               (ro-span-slice ss #:from head))
                                  (matches-at? r (+ start pp) s)))
                         (+ start pp)
                         (straddle (+ pp 1))))))))))))

;; The offset of the first `s` at or after `#:from`.
(: (-> Text string (#:from int) (Option int)))
(defun (text-index-of r s #:from 0)
  (check-offset r from "text-index-of")
  (def m (string-length s))
  (cond
    ((= m 0) (Some from))
    ((= (.height r) 0)
     (def j (span-find (ro-span-slice (.AsSpan (.small r)) #:from from) (.AsSpan s)))
     (if (>= j 0) (Some (+ from j)) None))
    ((> (+ from m) (.bytes r)) None)
    (else
     (def k (index-from! r (chunk-iter r from) s from))
     (if (>= k 0) (Some k) None))))

(: (-> Text string bool))
(defun (text-contains? r s) (some? (text-index-of r s)))

(: (-> Text string bool))
(defun (text-starts-with? r s) (matches-at? r 0 s))

(: (-> Text string bool))
(defun (text-ends-with? r s)
  (def at (- (.bytes r) (string-length s)))
  (and (>= at 0) (matches-at? r at s)))

;; The offset of the last `s` that ends at or before `#:to`.
;;
;; - Each chunk, last first, is searched for the matches that start in it and
;;   end in a later one, and then for those inside it.
(: (-> Text string (#:to int) (Option int)))
(defun (text-last-index-of r s #:to (text-length r))
  (check-offset r to "text-last-index-of")
  (def m (string-length s))
  (cond
    ((= m 0) (Some to))
    ((> m to) None)
    ((= (.height r) 0)
     (def j (span-find-last (ro-span-slice (.AsSpan (.small r)) #:from 0 #:to to) (.AsSpan s)))
     (if (>= j 0) (Some j) None))
    (else
     (def first (cast byte (ro-span-ref (.AsSpan s) 0)))
     (def it (chunk-iter r (- to 1)))
     (def ss (.AsSpan s))
     ;; `after` is the chunk after this one, which the last step left.
     (let go ((after ""))
       (def c (.chunk it))
       (def start (.start it))
       (def cl (string-length c))
       (def sp (.AsSpan c))
       ;; A match from byte p of the chunk crosses its end when p > cl - m,
       ;; and ends in time when start + p + m <= to.
       (def lo (max 0 (+ (- cl m) 1)))
       (def straddler
         (let back ((hi (min (- cl 1) (- (- to start) m))))
           (if (< hi lo)
               None
               (begin
                 (def q (span-last-index-of (ro-span-slice sp #:from lo #:to (+ hi 1)) first))
                 (def pp (+ lo q))
                 (def head (- cl pp))
                 (cond
                   ((< q 0) None)
                   ((and (span-equal? (ro-span-slice sp #:from pp) (ro-span-slice ss #:from 0 #:to head))
                         (if (<= (- m head) (string-length after))
                             (span-equal? (ro-span-slice (.AsSpan after) #:from 0 #:to (- m head))
                                          (ro-span-slice ss #:from head))
                             (matches-at? r (+ start pp) s)))
                    (Some (+ start pp)))
                   (else (back (- pp 1))))))))
       (match straddler
         ((Some k) (Some k))
         (None
          (def e (min cl (- to start)))
          (def j (if (>= e m) (span-find-last (ro-span-slice sp #:from 0 #:to e) (.AsSpan s)) -1))
          (cond
            ((>= j 0) (Some (+ start j)))
            ((= start 0) None)
            (else (ignore (chunk-iter-prev! it)) (go c)))))))))

;; ---------------------------------------------------------------------------
;; Equality, order and hashing
;; ---------------------------------------------------------------------------

(: (-> (RoSpan byte) (RoSpan byte) bool int))
(defun (compare-spans x y order?) #:inline
  (cond (order? (span-compare x y)) ((span-equal? x y) 0) (else 1)))

;; Compares the bytes of `a` and `b` from 0 to `len`, which both have, part by
;; part, where a part lies in one chunk of each. Returns 0 if they are all
;; equal. Otherwise the order of the first part that differs when `order?`,
;; and 1 when not.
(: (-> Text Text int bool int))
(defun (compare-parts a b len order?)
  (if (= len 0)
      0
      (begin
        (def ia (chunk-iter a 0))
        (def ib (chunk-iter b 0))
        (let go ((p 0))
          (if (>= p len)
              0
              (begin
                (def ca (.chunk ia))
                (def cb (.chunk ib))
                (def sa (.start ia))
                (def sb (.start ib))
                (def ea (+ sa (string-length ca)))
                (def eb (+ sb (string-length cb)))
                (def e (min len (min ea eb)))
                (def d (compare-spans (ro-span-slice (.AsSpan ca) #:from (- p sa) #:to (- e sa))
                                      (ro-span-slice (.AsSpan cb) #:from (- p sb) #:to (- e sb))
                                      order?))
                (cond
                  ((not (= d 0)) d)
                  ((>= e len) 0)
                  (else
                   (when (= e ea) (ignore (chunk-iter-next! ia)))
                   (when (= e eb) (ignore (chunk-iter-next! ib)))
                   (go e)))))))))

(: (-> Text Text bool))
(defun (text=? a b)
  (and (= (.bytes a) (.bytes b))
       (= (.lines a) (.lines b))
       (if (and (= (.height a) 0) (= (.height b) 0))
           (= (.small a) (.small b))
           (= (compare-parts a b (.bytes a) #f) 0))))

(: (-> Text Text int))
(defun (text-compare a b)
  (def d (compare-parts a b (min (.bytes a) (.bytes b)) #t))
  (cond
    ((< d 0) -1)
    ((> d 0) 1)
    (else (compare (.bytes a) (.bytes b)))))

;; A hash of the bytes in order, whatever chunks hold them: the folded
;; multiply of wyhash, as the string hash does.
;;
;; - The bytes are read as 16-byte blocks of two words. Block k of the text
;;   goes to lane k mod 4, and the four lanes do not wait for each other.
;; - A block that spans two chunks is carried over in `w0` and `w1`, with `n`
;;   of its bytes, and `lane` is the lane of the next block.
(type (: HashState (Struct (: s0 ulong) (: s1 ulong) (: s2 ulong) (: s3 ulong)
                           (: w0 ulong) (: w1 ulong) (: n int) (: lane int))))

(def hash-p0 (cast ulong 11562461410679940143UL))
(def hash-p1 (cast ulong 16646288086500911323UL))
(def hash-p2 (cast ulong 10285213230658275043UL))
(def hash-p3 (cast ulong 6384245875588680899UL))

;; The high and low words of a * b, xored.
(: (-> ulong ulong ulong))
(defun (fold-mul a b) #:inline
  (def p (big-mul a b))
  (bitwise-xor (cast ulong (shift-right p 64)) (cast ulong p)))

(: (-> HashState ulong ulong HashState))
(defun (hash-feed st a b)
  (def l (.lane st))
  (def st2
    (cond
      ((= l 0) (record-set st (s0 (fold-mul (bitwise-xor a hash-p0) (bitwise-xor b (.s0 st))))))
      ((= l 1) (record-set st (s1 (fold-mul (bitwise-xor a hash-p1) (bitwise-xor b (.s1 st))))))
      ((= l 2) (record-set st (s2 (fold-mul (bitwise-xor a hash-p2) (bitwise-xor b (.s2 st))))))
      (else (record-set st (s3 (fold-mul (bitwise-xor a hash-p3) (bitwise-xor b (.s3 st))))))))
  (record-set st2 (lane (bitwise-and (+ l 1) 3))))

;; Bytes `from` to `to` of `sp`, at most 8, as the low bytes of a word, the
;; first lowest.
(: (-> (RoSpan byte) int int ulong))
(defun (word-of sp from to)
  (let go ((k (- to 1)) (w (cast ulong 0)))
    (if (< k from) w (go (- k 1) (bitwise-ior (shift-left w 8) (cast ulong (ro-span-ref sp k)))))))

;; Bytes `from` to `to` of `sp`, which fit in the carried block, put in it.
(: (-> HashState (RoSpan byte) int int HashState))
(defun (carry-bytes st sp from to)
  (def n (.n st))
  (def k (- to from))
  ;; The bytes that go to w0, from its byte n, and those after, to w1.
  (def into0 (max 0 (min k (- 8 n))))
  (def w0 (bitwise-ior (.w0 st) (shift-left (word-of sp from (+ from into0)) (* 8 (min n 8)))))
  (def w1 (if (= into0 k)
              (.w1 st)
              (bitwise-ior (.w1 st) (shift-left (word-of sp (+ from into0) to) (* 8 (max 0 (- n 8)))))))
  (record-set st (w0 w0) (w1 w1) (n (+ n k))))

(: (-> string HashState HashState))
(defun (hash-chunk c st0)
  (def sp (.AsSpan c))
  (def len (string-length c))
  (def/mutable st st0)
  (def/mutable i 0)
  ;; The carried block, made whole and fed.
  (when (> (.n st) 0)
    (def take (min len (- 16 (.n st))))
    (set! st (carry-bytes st sp 0 take))
    (set! i take)
    (when (= (.n st) 16)
      (set! st (hash-feed (record-set st (w0 (cast ulong 0)) (w1 (cast ulong 0)) (n 0)) (.w0 st) (.w1 st)))))
  (def blocks (/ (- len i) 16))
  (when (> blocks 0)
    (def (: ws (RoSpan ulong)) (ro-span-> (ro-span-slice sp #:from i #:to (+ i (* 16 blocks)))))
    (def/mutable k 0)
    ;; Single blocks up to lane 0, then four at a time, then the rest.
    (loop (:while (and (> (.lane st) 0) (< k blocks)))
          (:do (set! st (hash-feed st (ro-span-ref ws (* 2 k)) (ro-span-ref ws (+ (* 2 k) 1))))
               (set! k (+ k 1))))
    (def/mutable s0 (.s0 st))
    (def/mutable s1 (.s1 st))
    (def/mutable s2 (.s2 st))
    (def/mutable s3 (.s3 st))
    (loop (:while (<= (+ k 4) blocks))
          (:do (def b (ro-span-slice ws #:from (* 2 k) #:to (+ (* 2 k) 8)))
               (set! s0 (fold-mul (bitwise-xor (ro-span-ref b 0) hash-p0) (bitwise-xor (ro-span-ref b 1) s0)))
               (set! s1 (fold-mul (bitwise-xor (ro-span-ref b 2) hash-p1) (bitwise-xor (ro-span-ref b 3) s1)))
               (set! s2 (fold-mul (bitwise-xor (ro-span-ref b 4) hash-p2) (bitwise-xor (ro-span-ref b 5) s2)))
               (set! s3 (fold-mul (bitwise-xor (ro-span-ref b 6) hash-p3) (bitwise-xor (ro-span-ref b 7) s3)))
               (set! k (+ k 4))))
    (set! st (record-set st (s0 s0) (s1 s1) (s2 s2) (s3 s3)))
    (loop (:while (< k blocks))
          (:do (set! st (hash-feed st (ro-span-ref ws (* 2 k)) (ro-span-ref ws (+ (* 2 k) 1))))
               (set! k (+ k 1))))
    (set! i (+ i (* 16 blocks))))
  (if (< i len) (carry-bytes st sp i len) st))

(: (-> Text int))
(defun (text-hash r)
  (def zero (cast ulong 0))
  (def seed (cast ulong 0x9E3779B97F4A7C15UL))
  (def st (text-fold-chunks hash-chunk
                            (HashState (s0 seed) (s1 (bitwise-xor seed hash-p1)) (s2 (bitwise-xor seed hash-p2))
                                       (s3 (bitwise-xor seed hash-p3)) (w0 zero) (w1 zero) (n 0) (lane 0))
                            r))
  (def lanes (bitwise-xor (bitwise-xor (.s0 st) (.s1 st)) (bitwise-xor (.s2 st) (.s3 st))))
  (def h (fold-mul (bitwise-xor (.w0 st) hash-p0)
                   (bitwise-xor (.w1 st) (bitwise-xor lanes (cast ulong (+ (* 16 (.n st)) (.bytes r)))))))
  (def fin (fold-mul (bitwise-xor h hash-p1) (bitwise-xor (cast ulong (.lane st)) hash-p2)))
  (cast int (bitwise-xor fin (shift-right-logical fin 32))))

(impl (Eq Text)
  (defun (= a b) (text=? a b))
  (defun (eq-hash r) (text-hash r)))

(impl (Ord Text)
  (defun (compare a b) (text-compare a b)))

(impl (Written Text)
  (defun (write-into r b) (write-into (text->string r) b)))

(impl (Displayed Text)
  (defun (display-into r b) (text-for-each-chunk (fun (c) (stringbuilder-add-string! b c)) r))
  (defun (displayed r) (text->string r)))

;; ---------------------------------------------------------------------------
;; Iteration
;; ---------------------------------------------------------------------------

;; A walk over the characters of a text, a struct: a walk over one chunk, and
;; the offset of the next. A step off the end of a chunk moves on to the
;; next one, so that only the last chunk's walk is ever done.
(type (: TextWalk #:opaque
         (Struct (: text Text)
                 (: walk StringWalk)
                 (: next int))))

(: (-> Text TextWalk))
(defun (text-walk r)
  (if (= (.height r) 0)
      (TextWalk (text r) (walk (string-walk (.small r))) (next (.bytes r)))
      (text-walk-at r 0)))

;; The walk over the chunk that starts at `at`.
(: (-> Text int TextWalk))
(defun (text-walk-at r at)
  (def (Tuple c _) (chunk-scanning r at))
  (TextWalk (text r) (walk (string-walk c)) (next (+ at (string-length c)))))

(: (-> TextWalk TextWalk))
(defun (text-walk-next w)
  (def s (string-walk-next (.walk w)))
  (if (and (string-walk-done? s) (< (.next w) (.bytes (.text w))))
      (text-walk-at (.text w) (.next w))
      (record-set w (walk s))))

(impl (Iterable Text)
  (type %elem char)
  (type %cursor TextWalk)
  (defun (iterable-start r) (text-walk r))
  (defun (iterable-done? r w) (string-walk-done? (.walk w)))
  (defun (iterable-current r w) (string-walk-current (.walk w)))
  (defun (iterable-next r w) (text-walk-next w))
  (defun (count r) (text-char-count r)))

(impl (Collection Text)
  (type %content char)
  (defun (length r) (text-char-count r))
  (defun (empty? r) (text-empty? r)))

(impl (Refable Text)
  (type %index TextCursor)
  (type %out char)
  (defun (ref r c) (text-cursor-ref c))
  (defun (try-ref r c) (if (text-cursor-end? c) None (Some (char-at c)))))

(impl (Cursor Text)
  (type %elem char)
  (type %cursor TextCursor)
  (defun (cursor-start r) (text-cursor-start r))
  (defun (cursor-end r) (text-cursor-end r))
  (defun (cursor-end? r c) (text-cursor-end? c))
  (defun (cursor-ref r c) (text-cursor-ref c))
  (defun (cursor-next r c) (text-cursor-next c))
  (defun (cursor-prev r c) (text-cursor-prev c)))

;; ---------------------------------------------------------------------------
;; As a string has them
;; ---------------------------------------------------------------------------

(: (-> string int void))
(defun (check-count who n)
  (when (< n 0) (bad-argument #"${who}: the count ${n} is negative.")))

;; The bytes of the first `n` characters of `c`, or all of it when it has
;; fewer.
(: (-> string int int))
(defun (bytes-of-first c n)
  (def sp (.AsSpan c))
  (def len (string-length c))
  (let go ((k 0) (n n))
    (if (or (= n 0) (>= k len)) k (go (+ k (char-width (byte-at sp k))) (- n 1)))))

;; The bytes of the last `n` characters of `c`, or all of it when it has
;; fewer.
(: (-> string int int))
(defun (bytes-of-last c n)
  (def len (string-length c))
  (let go ((k len) (n n))
    (if (or (= n 0) (<= k 0)) (- len k) (go (boundary-before c (- k 1)) (- n 1)))))

;; The offset after the first `n` characters of `r`, or its end when it has
;; fewer. Skips whole chunks by their character counts.
(: (-> Text int int))
(defun (offset-after-chars r n)
  (if (or (= n 0) (= (.bytes r) 0))
      0
      (begin
        (def it (chunk-iter r 0))
        (let go ((n n))
          (def c (.chunk it))
          (def k (.Count c))
          (cond
            ((< n k) (+ (.start it) (bytes-of-first c n)))
            ((chunk-iter-next! it) (go (- n k)))
            (else (.bytes r)))))))

;; The offset before the last `n` characters of `r`, or 0 when it has fewer.
(: (-> Text int int))
(defun (offset-before-last-chars r n)
  (if (or (= n 0) (= (.bytes r) 0))
      (.bytes r)
      (begin
        (def it (chunk-iter r (- (.bytes r) 1)))
        (let go ((n n))
          (def c (.chunk it))
          (def k (.Count c))
          (cond
            ((< n k) (- (+ (.start it) (string-length c)) (bytes-of-last c n)))
            ((chunk-iter-prev! it) (go (- n k)))
            (else 0))))))

;; Adds bytes `from` to `to` of `r` to `b`, from the chunks of `it`, which is on
;; the chunk that holds `from` or one before it. Leaves `it` on the chunk that
;; holds `to`, or the last.
(: (-> TextBuilder Text ChunkIter int int void))
(defun (add-range! b r it from to)
  (let skip ()
    (when (and (<= (+ (.start it) (string-length (.chunk it))) from) (chunk-iter-next! it)) (skip)))
  (let go ()
    (def c (.chunk it))
    (def start (.start it))
    (def e (min to (+ start (string-length c))))
    (when (< from e)
      (textbuilder-add! b (piece c (- (max from start) start) (- e start))))
    (when (and (< e to) (chunk-iter-next! it)) (go))))

;; The first `n` characters of `r`, or all of it when it has fewer.
(: (-> Text int Text))
(defun (text-take r n)
  (check-count "text-take" n)
  (def (Tuple l _) (split-with r (offset-after-chars r n) "text-take" (owner-next)))
  l)

;; `r` without its first `n` characters.
(: (-> Text int Text))
(defun (text-drop r n)
  (check-count "text-drop" n)
  (def (Tuple _ rr) (split-with r (offset-after-chars r n) "text-drop" (owner-next)))
  rr)

;; The last `n` characters of `r`, or all of it when it has fewer.
(: (-> Text int Text))
(defun (text-take-right r n)
  (check-count "text-take-right" n)
  (def (Tuple _ rr) (split-with r (offset-before-last-chars r n) "text-take-right" (owner-next)))
  rr)

;; `r` without its last `n` characters.
(: (-> Text int Text))
(defun (text-drop-right r n)
  (check-count "text-drop-right" n)
  (def (Tuple l _) (split-with r (offset-before-last-chars r n) "text-drop-right" (owner-next)))
  l)

;; Bytes `from` to `to` of `r` as a text, from the chunks of `it`, which is on
;; the chunk that holds `from` or one before it. A range inside one chunk is
;; a string that shares the chunk's bytes; a longer one is copied when it is
;; at most `chunk-max` bytes, and a slice that shares the chunks otherwise.
(: (-> Text ChunkIter int int Text))
(defun (range-from! r it from to)
  (let skip ()
    (when (and (<= (+ (.start it) (string-length (.chunk it))) from) (chunk-iter-next! it)) (skip)))
  (def c (.chunk it))
  (def start (.start it))
  (cond
    ((<= to (+ start (string-length c))) (small-text (piece c (- from start) (- to start))))
    ((<= (- to from) chunk-max) (small-text (text-substring r from to)))
    (else (text-slice r from to))))

;; `r` with every `old` replaced by `new`, left to right without overlaps.
;;
;; - Searches through one chunk iteration, and adds the text between the
;;   matches through another, sharing the arrays of the chunks it keeps whole.
;; - Raises when `old` is empty.
(: (-> Text string string Text))
(defun (text-replace r old new)
  (when (string-empty? old) (bad-argument "text-replace: the string to replace is empty."))
  (def m (string-length old))
  (cond
    ((< (.bytes r) m) r)
    ((= (.height r) 0)
     (if (string-contains? (.small r) old) (string->text (string-replace (.small r) old new)) r))
    (else
     (def si (chunk-iter r 0))
     (def first (index-from! r si old 0))
     (if (< first 0)
         r
         (begin
           (def b (textbuilder-empty))
           (def it (chunk-iter r 0))
           (let go ((from 0) (at first))
             (add-range! b r it from at)
             (textbuilder-add! b new)
             (def next (+ at m))
             (def k (index-from! r si old next))
             (if (>= k 0)
                 (go next k)
                 (add-range! b r it next (.bytes r))))
           (textbuilder->text b))))))

;; The fields of `r` between the occurrences of `sep`, empty ones kept: one
;; more than the occurrences. An empty `sep` gives `r` as the one field. A
;; field inside one chunk shares the chunk's bytes.
(: (-> Text string (Vec Text)))
(defun (text-split r sep)
  (def m (string-length sep))
  (cond
    ((= m 0) (vec-add (vec-empty) r))
    ((= (.height r) 0) (vec-map small-text (string-split (.small r) sep)))
    (else
     (def si (chunk-iter r 0))
     (def ft (chunk-iter r 0))
     (def out (vecbuilder-empty))
     (let go ((from 0))
       (def k (index-from! r si sep from))
       (if (>= k 0)
           (begin (vecbuilder-add! out (range-from! r ft from k)) (go (+ k m)))
           (vecbuilder-add! out (range-from! r ft from (.bytes r)))))
     (vecbuilder->vec out))))

;; The text before the first `sep` and the text after it, or None.
(: (-> Text string (Option (Tuple Text Text))))
(defun (text-split-once r sep)
  (match (text-index-of r sep)
    ((Some k)
     (def o (owner-next))
     (def (Tuple l rest) (split-with r k "text-split-once" o))
     (def (Tuple _ after) (split-with rest (string-length sep) "text-split-once" o))
     (Some (Tuple l after)))
    (None None)))

;; The texts of `parts` in order, with `sep` between each two.
(: (-> (Vec Text) string Text))
(defun (text-join parts sep)
  (def b (textbuilder-empty))
  (loop (:with first? #t #f)
        (:for part parts)
        (:do (unless first? (textbuilder-add! b sep))
             (textbuilder-add-text! b part)))
  (textbuilder->text b))

;; The cursor on the first `needle` in `r`. An empty needle is at the start.
(: (-> Text string (Option TextCursor)))
(defun (text-search r needle) (text-cursor-search (text-cursor-start r) needle))

;; The cursor on the last `needle` in `r`. An empty needle is at the end.
(: (-> Text string (Option TextCursor)))
(defun (text-search-backward r needle) (text-cursor-search-backward (text-cursor-end r) needle))

;; The cursor on the first character of `r` that `pred` holds for.
(: (-> (-?-> char bool) Text (Option TextCursor)))
(defun (text-index pred r) (text-cursor-find pred (text-cursor-start r)))

;; The cursor on the first character at or after `start` that is in `chars`.
;;
;; - A set of ASCII characters is searched for in each chunk's bytes at once.
;; - An empty set is never found.
(: (-> Text string TextCursor (Option TextCursor)))
(defun (text-search-any r chars start)
  (cond
    ((or (string-empty? chars) (text-cursor-end? start)) None)
    ((= (string-length chars) (string-count chars))
     (def set (.AsSpan chars))
     (def it (chunk-iter r (.at start)))
     (let go ((from (- (.at start) (.start it))))
       (def k (span-index-of-any (ro-span-slice (.AsSpan (.chunk it)) #:from from) set))
       (cond
         ((>= k 0) (Some (text-cursor-at r (+ (.start it) from k))))
         ((chunk-iter-next! it) (go 0))
         (else None))))
    (else
     (def set (loop (:for ch chars) (:acc (arraying ch))))
     (def n (array-length set))
     (text-cursor-find (fun (ch) (let go ((i 0)) (and (< i n) (or (char=? (array-ref set i) ch) (go (+ i 1)))))) start))))

;; Whether `ch` is not white space.
(: (-> char bool))
(defun (not-space? ch) (not (char-whitespace? ch)))

;; `r` without the white space at its start.
(: (-> Text Text))
(defun (text-trim-left r)
  (match (text-index not-space? r)
    ((Some c) (if (text-cursor-start? c) r (text-cursor-slice c (text-cursor-end r))))
    (None empty-text)))

;; `r` without the white space at its end.
(: (-> Text Text))
(defun (text-trim-right r)
  (match (text-cursor-find-backward not-space? (text-cursor-end r))
    ((Some c)
     (def e (text-cursor-next c))
     (if (text-cursor-end? e) r (text-cursor-slice (text-cursor-start r) e)))
    (None empty-text)))

;; `r` without the white space at both ends.
(: (-> Text Text))
(defun (text-trim r) (text-trim-right (text-trim-left r)))

;; `n` copies of `ch`.
(: (-> char int string))
(defun (repeated-char ch n)
  (def b (stringbuilder-empty))
  (loop (:for _ (range 0 n)) (:do (stringbuilder-add! b ch)))
  (stringbuilder->string b))

;; `r` with `#:with` before it until it is `width` characters long.
(: (-> Text int (#:with char) Text))
(defun (text-pad-left r width #:with #\space)
  (def k (- width (text-char-count r)))
  (if (<= k 0) r (text-prepend r (repeated-char with k))))

;; `r` with `#:with` after it until it is `width` characters long.
(: (-> Text int (#:with char) Text))
(defun (text-pad-right r width #:with #\space)
  (def k (- width (text-char-count r)))
  (if (<= k 0) r (text-append r (repeated-char with k))))

;; `r` with each character uppercased in the invariant culture, chunk by chunk.
(: (-> Text Text))
(defun (text-upcase r)
  (def b (textbuilder-empty))
  (text-for-each-chunk (fun (c) (textbuilder-add! b (.ToUpperInvariant c))) r)
  (textbuilder->text b))

;; `r` with each character lowercased in the invariant culture, chunk by chunk.
(: (-> Text Text))
(defun (text-downcase r)
  (def b (textbuilder-empty))
  (text-for-each-chunk (fun (c) (textbuilder-add! b (.ToLowerInvariant c))) r)
  (textbuilder->text b))

;; The characters of `r` in reverse order: its chunks from the last, each
;; reversed.
(: (-> Text Text))
(defun (text-reverse r)
  (if (= (.height r) 0)
      (small-text (.Reverse (.small r)))
      (begin
        (def b (textbuilder-empty))
        (def it (chunk-iter r (- (.bytes r) 1)))
        (let go ()
          (textbuilder-add! b (.Reverse (.chunk it)))
          (when (chunk-iter-prev! it) (go)))
        (textbuilder->text b))))

;; ---------------------------------------------------------------------------
;; Collecting and adding
;; ---------------------------------------------------------------------------

;; What a builder takes a piece of text as: a string or a character.
(def/trait (TextPiece %a)
  (: textbuilder-add-piece! (-> TextBuilder %a void)))

(impl (TextPiece string)
  (defun (textbuilder-add-piece! b s) (textbuilder-add! b s)))

(impl (TextPiece char)
  (defun (textbuilder-add-piece! b ch) (textbuilder-add-char! b ch)))

;; The collector that gathers characters or strings into a text, through a
;; builder, as `stringing` gathers characters into a string.
(type (: (Texting %a) (Union texting)))

(impl (Collector (Texting %a))
  (where (TextPiece %a))
  (type %elem %a)
  (type %acc TextBuilder)
  (type %out Text)
  (defun (collector-init c) (textbuilder-empty))
  (defun (collector-step c acc x) (textbuilder-add-piece! acc x) acc)
  (defun (collector-finish c acc) (textbuilder->text acc)))

;; `(texting x #:into t)`: the builder starts with the chunks of `t`.
(type (: (TextingInto %a) (Struct (: seed Text))))

(impl (Collector (TextingInto %a))
  (where (TextPiece %a))
  (type %elem %a)
  (type %acc TextBuilder)
  (type %out Text)
  (defun (collector-init c)
    (def b (textbuilder-empty))
    (textbuilder-add-text! b (.seed c))
    b)
  (defun (collector-step c acc x) (textbuilder-add-piece! acc x) acc)
  (defun (collector-finish c acc) (textbuilder->text acc)))

(impl (CollectorInto (Texting %a))
  (type %seed Text)
  (type %into (TextingInto %a))
  (defun (collector-into c seed) (TextingInto (seed seed))))

(impl (Addable Text)
  (type %elem string)
  (defun (add r s) (text-append r s)))

(impl (Addable! TextBuilder)
  (type %elem string)
  (defun (add! b s) (textbuilder-add! b s)))

(impl (Addable! TransientText)
  (type %elem string)
  (defun (add! t s) (transienttext-append! t s)))

;; ---------------------------------------------------------------------------
;; Cursors
;; ---------------------------------------------------------------------------

;; A position in a text, a struct that holds the chunk it is in.
;;
;; - `at` is a byte offset on a character boundary. `chunk` starts at byte
;;   `start` of the text, ends at byte `end`, and holds the character at `at`.
;; - At the end of the text, `chunk` is "" and `start` and `end` are `at`.
;; - A step inside the chunk reads its bytes only; a step out of it finds the
;;   next chunk from the root.
(type (: TextCursor #:opaque
         (Struct (: text Text)
                 (: chunk string)
                 (: start int)
                 (: end int)
                 (: at int))))

(: (-> Text TextCursor))
(defun (end-cursor r)
  (TextCursor (text r) (chunk "") (start (.bytes r)) (end (.bytes r)) (at (.bytes r))))

;; The cursor at `at`, a boundary below the length of `r`, found by
;; `chunk-of`.
;;
;; - Not inlined: inlined into a loop that starts with it, the descent takes
;;   the room .NET would inline the loop's steps with.
(: (-> Text int TextCursor))
(defun (cursor-in r at) #:no-inline
  (def (Tuple c start) (chunk-of r at))
  (TextCursor (text r) (chunk c) (start start) (end (+ start (string-length c))) (at at)))

;; As `cursor-in`, for a step into the next or previous chunk.
(: (-> Text int TextCursor))
(defun (cursor-stepped r at)
  (def (Tuple c start) (chunk-scanning r at))
  (TextCursor (text r) (chunk c) (start start) (end (+ start (string-length c))) (at at)))

(: (-> Text int TextCursor))
(defun (text-cursor-at r at)
  (check-offset r at "text-cursor-at")
  (if (= at (.bytes r))
      (end-cursor r)
      (begin
        (def c (cursor-in r at))
        (check-boundary (.chunk c) (- at (.start c)) "text-cursor-at")
        c)))

(: (-> Text TextCursor))
(defun (text-cursor-start r)
  (if (= (.bytes r) 0) (end-cursor r) (cursor-in r 0)))

(: (-> Text TextCursor))
(defun (text-cursor-end r) (end-cursor r))

(: (-> TextCursor int))
(defun (text-cursor-offset c) (.at c))

(: (-> TextCursor Text))
(defun (text-cursor-text c) (.text c))

(: (-> TextCursor bool))
(defun (text-cursor-end? c) (= (.at c) (.bytes (.text c))))

(: (-> TextCursor bool))
(defun (text-cursor-start? c) (= (.at c) 0))

(: (-> TextCursor string void))
(defun (check-not-end c who)
  (when (text-cursor-end? c) (cursor-at-edge who "end")))

(: (-> TextCursor string void))
(defun (check-not-start c who)
  (when (text-cursor-start? c) (cursor-at-edge who "start")))

;; Raises that the cursor is at the `edge` of the text. Not inlined, so that
;; the message is not built in the steps that check.
(: (-> string string void))
(defun (cursor-at-edge who edge) #:no-inline
  (out-of-range #"${who}: the cursor is at the ${edge} of the text."))

;; The character at `c`, which is not at the end.
(: (-> TextCursor char))
(defun (char-at c) #:inline (decode-at (.chunk c) (- (.at c) (.start c))))

;; The cursor `to`, after the character at `c`.
(: (-> TextCursor int TextCursor))
(defun (moved-to c to)
  (cond
    ((< to (.end c)) (record-set c (at to)))
    ((< to (.bytes (.text c))) (cursor-stepped (.text c) to))
    (else (end-cursor (.text c)))))

;; The cursor after the character at `c`, which is not at the end.
(: (-> TextCursor TextCursor))
(defun (step-next c)
  (moved-to c (+ (.at c) (char-width (byte-at (.AsSpan (.chunk c)) (- (.at c) (.start c)))))))

;; The character at `c`, which is not at the end, and the cursor after it,
;; from one read of the chunk.
(: (-> TextCursor (Tuple char TextCursor)))
(defun (ref+next c)
  (def sp (.AsSpan (.chunk c)))
  (def k (- (.at c) (.start c)))
  (def b0 (byte-at sp k))
  (def ch (if (< b0 128) (integer->char b0) (decode-at (.chunk c) k)))
  (Tuple ch (moved-to c (+ (.at c) (char-width b0)))))

;; The cursor on the character before `c`, which is not at the start.
(: (-> TextCursor TextCursor))
(defun (step-prev c)
  (def p (if (> (.at c) (.start c)) c (cursor-stepped (.text c) (- (.at c) 1))))
  (def sp (.AsSpan (.chunk p)))
  (let go ((k (- (- (.at c) 1) (.start p))))
    (if (and (> k 0) (= (bitwise-and (byte-at sp k) 192) 128))
        (go (- k 1))
        (record-set p (at (+ (.start p) k))))))

(: (-> TextCursor char))
(defun (text-cursor-ref c)
  (check-not-end c "text-cursor-ref")
  (char-at c))

(: (-> TextCursor TextCursor))
(defun (text-cursor-next c)
  (check-not-end c "text-cursor-next")
  (step-next c))

(: (-> TextCursor TextCursor))
(defun (text-cursor-prev c)
  (check-not-start c "text-cursor-prev")
  (step-prev c))

(: (-> TextCursor (Tuple char TextCursor)))
(defun (text-cursor-ref+next c)
  (check-not-end c "text-cursor-ref+next")
  (ref+next c))

(: (-> TextCursor int TextCursor))
(defun (text-cursor-forward c n)
  (when (< n 0) (bad-argument #"text-cursor-forward: the count ${n} is negative."))
  (let go ((p c) (k n))
    (cond
      ((= k 0) p)
      ((text-cursor-end? p)
       (out-of-range #"text-cursor-forward: there are fewer than ${n} characters after the cursor."))
      (else (go (step-next p) (- k 1))))))

(: (-> TextCursor int TextCursor))
(defun (text-cursor-back c n)
  (when (< n 0) (bad-argument #"text-cursor-back: the count ${n} is negative."))
  (let go ((p c) (k n))
    (cond
      ((= k 0) p)
      ((text-cursor-start? p)
       (out-of-range #"text-cursor-back: there are fewer than ${n} characters before the cursor."))
      (else (go (step-prev p) (- k 1))))))

;; The cursor `column` characters into line `n`, or at the line's end when
;; it is shorter.
(: (-> Text int (#:column int) TextCursor))
(defun (text-cursor-at-line r n #:column 0)
  (def from (text-line-start r n))
  (def e (text-line-end r n))
  (let go ((p (text-cursor-at r from)) (k column))
    (if (or (<= k 0) (>= (.at p) e)) p (go (step-next p) (- k 1)))))

(: (-> TextCursor int))
(defun (text-cursor-line c) (text-line-of (.text c) (.at c)))

(: (-> TextCursor TextCursor))
(defun (text-cursor-line-start c)
  (def r (.text c))
  (text-cursor-at r (text-line-start r (text-cursor-line c))))

(: (-> TextCursor TextCursor))
(defun (text-cursor-line-end c)
  (def r (.text c))
  (text-cursor-at r (text-line-end r (text-cursor-line c))))

;; The characters between the start of the cursor's line and the cursor.
(: (-> TextCursor int))
(defun (text-cursor-column c)
  (let go ((p (text-cursor-line-start c)) (k 0))
    (if (>= (.at p) (.at c)) k (go (step-next p) (+ k 1)))))

;; The first `s` that starts at or after `c`.
(: (-> TextCursor string (Option TextCursor)))
(defun (text-cursor-search c s)
  (match (text-index-of (.text c) s #:from (.at c))
    ((Some k) (Some (text-cursor-at (.text c) k)))
    (None None)))

;; The last `s` that ends at or before `c`.
(: (-> TextCursor string (Option TextCursor)))
(defun (text-cursor-search-backward c s)
  (match (text-last-index-of (.text c) s #:to (.at c))
    ((Some k) (Some (text-cursor-at (.text c) k)))
    (None None)))

;; The first character at or after `c` that `pred` holds for.
(: (-> (-?-> char bool) TextCursor (Option TextCursor)))
(defun (text-cursor-find pred c)
  (let go ((p c))
    (cond
      ((text-cursor-end? p) None)
      (else
       (def (Tuple ch n) (ref+next p))
       (if (pred ch) (Some p) (go n))))))

;; The last character before `c` that `pred` holds for.
(: (-> (-?-> char bool) TextCursor (Option TextCursor)))
(defun (text-cursor-find-backward pred c)
  (let go ((p c))
    (if (text-cursor-start? p)
        None
        (begin
          (def q (step-prev p))
          (if (pred (char-at q)) (Some q) (go q))))))

(: (-> TextCursor TextCursor string))
(defun (text-cursor-substring a b) (text-substring (.text a) (.at a) (.at b)))

(: (-> TextCursor TextCursor Text))
(defun (text-cursor-slice a b) (text-slice (.text a) (.at a) (.at b)))

;; Comparisons of the offsets of two cursors of one text.
(: (-> TextCursor TextCursor bool))
(defun (text-cursor=? a b) (= (.at a) (.at b)))
(: (-> TextCursor TextCursor bool))
(defun (text-cursor<? a b) (< (.at a) (.at b)))
(: (-> TextCursor TextCursor bool))
(defun (text-cursor>? a b) (> (.at a) (.at b)))
(: (-> TextCursor TextCursor bool))
(defun (text-cursor<=? a b) (<= (.at a) (.at b)))
(: (-> TextCursor TextCursor bool))
(defun (text-cursor>=? a b) (>= (.at a) (.at b)))

(impl (Eq TextCursor)
  (defun (= a b) (= (.at a) (.at b)))
  (defun (eq-hash c) (eq-hash (.at c))))

(impl (Ord TextCursor)
  (defun (compare a b) (compare (.at a) (.at b))))

;; The characters from the cursor to the end.
(impl (Iterable TextCursor)
  (type %elem char)
  (type %cursor TextCursor)
  (defun (iterable-start c) c)
  (defun (iterable-done? c p) (text-cursor-end? p))
  (defun (iterable-current c p) (char-at p))
  (defun (iterable-next c p) (step-next p)))

;; The characters before a cursor, last first.
(type (: TextBackward #:opaque (Struct (: from TextCursor))))

;; A step of a backward loop: the cursor on its character, or done.
(type (: TextBackwardStep #:opaque (Struct (: on TextCursor) (: done? bool))))

(: (-> TextCursor TextBackward))
(defun (text-backward c) (TextBackward (from c)))

(: (-> TextCursor TextBackwardStep))
(defun (backward-from c)
  (if (text-cursor-start? c)
      (TextBackwardStep (on c) (done? #t))
      (TextBackwardStep (on (step-prev c)) (done? #f))))

(impl (Iterable TextBackward)
  (type %elem char)
  (type %cursor TextBackwardStep)
  (defun (iterable-start b) (backward-from (.from b)))
  (defun (iterable-done? b s) (.done? s))
  (defun (iterable-current b s) (char-at (.on s)))
  (defun (iterable-next b s) (backward-from (.on s))))

;; ---------------------------------------------------------------------------
;; Transients
;; ---------------------------------------------------------------------------

;; A text that is edited in place: its edits copy only the nodes it does not
;; own yet. `transienttext->text` returns the text it holds and takes a new
;; owner, so that the text does not change after.
;;
;; - The hot chunk: the chunk of the last edit, held in `buf` as bytes 0 to
;;   `hot-len`, which starts at byte `hot-start` of the text. `path` holds the
;;   nodes down to it, the leaves node first, and `slots` the slot taken in
;;   each. `hot-len` is -1 when no chunk is hot.
;; - An edit inside the hot chunk moves bytes in `buf` and adds to the newline
;;   counts on the path, and allocates nothing. The byte counts on the path
;;   stay those of the old string until `cool!`. It must leave the chunk at most
;;   `chunk-max` bytes, and not empty unless the text is one string.
;; - While a chunk is hot, `bytes` and `lines` are the text's, not those in
;;   `text`, and when `dirty?` its slot holds an old string. `cool!` puts the
;;   chunk back; every other operation cools first.
;; - An edit outside the hot chunk makes its own chunk hot only when it is
;;   within `hot-reach` bytes of `last`, where the edit before it ended. Edits
;;   far apart edit the tree, which costs less than copying each chunk in and
;;   out for one edit.
(def hot-reach 64)

(type (: TransientText #:opaque
         (Record (: text Text #:mutable)
                 (: owner long #:mutable)
                 (: buf (Array byte))
                 (: path (Array TextNode))
                 (: slots (Array int))
                 (: hot-len int #:mutable)
                 (: hot-start int #:mutable)
                 (: dirty? bool #:mutable)
                 (: bytes int #:mutable)
                 (: lines int #:mutable)
                 (: last int #:mutable))))

(: (-> Text TransientText))
(defun (text->transienttext r)
  (TransientText (text r) (owner (owner-next))
                 (buf (make-array chunk-max #:fill (cast byte 0)))
                 (path (make-array 24 #:fill no-node))
                 (slots (make-array 24 #:fill 0))
                 (hot-len -1) (hot-start 0) (dirty? #f) (bytes 0) (lines 0) (last 0)))

;; Copies the bytes of `s` into `buf` from `at`.
(: (-> string (Array byte) int void))
(defun (copy-into! s buf at) #:inline
  (.CopyTo (.AsSpan s) (span-slice (array->span buf) #:from at)))

;; Whether byte `k` of `buf` continues a character.
(: (-> (Array byte) int bool))
(defun (continues? buf k) #:inline
  (= (bitwise-and (cast int (array-ref buf k)) 192) 128))

;; Makes the chunk with byte `at` hot, when no chunk is: the chunk that ends
;; at `at` when `left?`, and otherwise the one that starts there.
;;
;; - Copies the nodes on the path that the transient does not own.
;; - Returns #f, and leaves no chunk hot, when the chunk does not have `room`
;;   bytes free before `chunk-max`.
(: (-> TransientText int bool int bool))
(defun (heat! t at left? room)
  (def r (.text t))
  (def h (.height r))
  (def o (.owner t))
  (def buf (.buf t))
  (if (= h 0)
      (begin
        (def len (.bytes r))
        (if (> (+ len room) chunk-max)
            #f
            (begin
              (copy-into! (.small r) buf 0)
              (record-set! t (hot-len len) (hot-start 0) (dirty? #f) (bytes len) (lines (.lines r)))
              #t)))
      (begin
        (def path (.path t))
        (def slots (.slots t))
        (def root (editable h (.root r) o))
        (unless (= (node-owner (.root r)) o)
          (record-set! t (text (Text (root root) (height h) (bytes (.bytes r)) (lines (.lines r)) (small "")))))
        (let go ((n root) (lvl (- h 1)) (at at) (start 0))
          (def (Tuple i k) (if left? (slot-ending n at) (slot-starting n at)))
          (array-set! path lvl n)
          (array-set! slots lvl i)
          (if (= lvl 0)
              (begin
                (def c (chunk-at (as-leaves n) i))
                (def len (string-length c))
                (if (> (+ len room) chunk-max)
                    #f
                    (begin
                      (copy-into! c buf 0)
                      (record-set! t (hot-len len) (hot-start (+ start (- at k))) (dirty? #f)
                                   (bytes (.bytes r)) (lines (.lines r)))
                      #t)))
              (begin
                (def b (as-branch n))
                (def child (editable lvl (kid b i) o))
                (set-kid! b i child)
                (go child (- lvl 1) k (+ start (- at k)))))))))

;; Adds `dl` newlines to the slots on the path to the hot chunk.
(: (-> TransientText int void))
(defun (adjust-path-lines! t dl)
  (def path (.path t))
  (def slots (.slots t))
  (loop (:for lvl (range 0 (.height (.text t))))
        (:do (def n (array-ref path lvl))
             (def i (array-ref slots lvl))
             (set-slot-lines! n i (+ (slot-lines n i) dl)))))

;; Adds `db` bytes to the slots on the path to the hot chunk.
(: (-> TransientText int void))
(defun (adjust-path-bytes! t db)
  (def path (.path t))
  (def slots (.slots t))
  (loop (:for lvl (range 0 (.height (.text t))))
        (:do (add-slot-bytes! (array-ref path lvl) (array-ref slots lvl) db))))

;; Whether an edit at `at` is near enough the last one to make its chunk hot.
(: (-> TransientText int bool))
(defun (near? t at) #:inline
  (<= (abs (- at (.last t))) hot-reach))

;; Puts `s` at byte `at` when that is in the hot chunk and `s` fits in it, and
;; returns whether it did.
(: (-> TransientText int string bool))
(defun (hot-insert! t at s)
  (def len (.hot-len t))
  (def k (- at (.hot-start t)))
  (def slen (string-length s))
  (if (and (>= k 0) (<= k len) (<= (+ len slen) chunk-max))
      (begin
        (def buf (.buf t))
        (when (and (< k len) (continues? buf k))
          (bad-argument "text-insert: the offset is in the middle of a character."))
        (array-copy! buf k buf (+ k slen) (- len k))
        (copy-into! s buf k)
        (def sl (newlines-in s))
        (adjust-path-lines! t sl)
        (record-set! t (hot-len (+ len slen)) (dirty? #t) (bytes (+ (.bytes t) slen)) (lines (+ (.lines t) sl)))
        #t)
      #f))

;; Deletes bytes `from` to `to`, where `from` < `to`, when they are in the hot
;; chunk and leave some of it in a tree, and returns whether it did.
(: (-> TransientText int int bool))
(defun (hot-delete! t from to)
  (def len (.hot-len t))
  (def k (- from (.hot-start t)))
  (def e (- to (.hot-start t)))
  (if (and (>= k 0) (<= e len) (or (< (- e k) len) (= (.height (.text t)) 0)))
      (begin
        (def buf (.buf t))
        (when (or (continues? buf k) (and (< e len) (continues? buf e)))
          (bad-argument "text-delete: the offset is in the middle of a character."))
        (def dl (span-count (ro-span-slice (array->ro-span buf) #:from k #:to e) newline))
        (array-copy! buf e buf k (- len e))
        (adjust-path-lines! t (- dl))
        (record-set! t (hot-len (- len (- e k))) (dirty? #t) (bytes (- (.bytes t) (- e k))) (lines (- (.lines t) dl)))
        #t)
      #f))

;; Puts the hot chunk back in its slot, if there is one.
;;
;; - A chunk left shorter than `chunk-min` is merged with a neighbour, and
;;   nodes left with fewer than `min-kids` children on the path then too, as
;;   a delete does.
(: (-> TransientText void))
(defun (cool! t)
  (when (and (>= (.hot-len t) 0) (.dirty? t))
    (def r (.text t))
    (def h (.height r))
    (def len (.hot-len t))
    (def c (utf8->string (ro-span-slice (array->ro-span (.buf t)) #:from 0 #:to len)))
    (if (= h 0)
        (record-set! t (text (small-text c)))
        (begin
          (def path (.path t))
          (def slots (.slots t))
          (def o (.owner t))
          (def leaves (array-ref path 0))
          (adjust-path-bytes! t (- len (slot-bytes leaves (array-ref slots 0))))
          (set-chunk! (as-leaves leaves) (array-ref slots 0) c)
          (when (< len chunk-min)
            (merge-small-chunk! leaves (array-ref slots 0))
            (loop (:for lvl (range 1 h))
                  (:do (when (< (node-count (array-ref path (- lvl 1))) min-kids)
                         (fix-underflow! (array-ref path lvl) (+ lvl 1) (array-ref slots lvl) o)))))
          (record-set! t (text (tree->text-sized (.root r) h (.bytes t) (.lines t)))))))
  (record-set! t (hot-len -1) (dirty? #f)))

(: (-> TransientText Text))
(defun (transienttext->text t)
  (cool! t)
  (record-set! t (owner (owner-next)))
  (.text t))

(: (-> TransientText int))
(defun (transienttext-length t)
  (if (>= (.hot-len t) 0) (.bytes t) (.bytes (.text t))))

(: (-> TransientText int string void))
(defun (transienttext-insert! t at s)
  (def slen (string-length s))
  (unless (hot-insert! t at s)
    (cool! t)
    (check-offset (.text t) at "text-insert")
    (unless (and (> slen 0) (<= slen small-insert) (near? t at) (heat! t at #t slen) (hot-insert! t at s))
      (cool! t)
      (record-set! t (text (insert-with (.text t) at s (.owner t))))))
  (record-set! t (last (+ at slen))))

(: (-> TransientText string void))
(defun (transienttext-append! t s)
  (transienttext-insert! t (transienttext-length t) s))

(: (-> TransientText int int void))
(defun (transienttext-delete! t from to)
  (unless (and (< from to) (hot-delete! t from to))
    (cool! t)
    (check-range (.text t) from to "text-delete")
    (unless (and (< from to) (near? t from) (heat! t from #f 0) (hot-delete! t from to))
      (cool! t)
      (record-set! t (text (delete-with (.text t) from to (.owner t))))))
  (record-set! t (last from)))

(: (-> TransientText int int string void))
(defun (transienttext-replace-range! t from to s)
  (transienttext-delete! t from to)
  (transienttext-insert! t from s))

;; ---------------------------------------------------------------------------
;; Checks
;; ---------------------------------------------------------------------------

;; What is wrong with the tree under `n`, of height `h`, if anything: the
;; first problem found.
(: (-> TextNode int bool (Option string)))
(defun (check-node n h root?)
  (def count (node-count n))
  (cond
    ((> count cap) (Some #"a node of height ${h} has ${count} children"))
    ((and (not root?) (< count min-kids)) (Some #"a node of height ${h} has ${count} children, fewer than ${min-kids}"))
    ((= count 0) (Some #"a node of height ${h} is empty"))
    (else
     (let go ((i 0))
       (if (>= i count)
           None
           (if (= h 1)
               (begin
                 (def c (chunk-at (as-leaves n) i))
                 (cond
                   ((= (string-length c) 0) (Some "an empty chunk"))
                   ((> (string-length c) chunk-max) (Some #"a chunk of ${(string-length c)} bytes"))
                   ((not (= (slot-bytes n i) (string-length c))) (Some "a chunk's byte count is wrong"))
                   ((not (= (slot-lines n i) (newlines-in c))) (Some "a chunk's newline count is wrong"))
                   (else (go (+ i 1)))))
               (begin
                 (def k (kid (as-branch n) i))
                 (cond
                   ((not (= (slot-bytes n i) (sum-bytes k))) (Some #"a node of height ${h} has a wrong byte count"))
                   ((not (= (slot-lines n i) (sum-lines k))) (Some #"a node of height ${h} has a wrong newline count"))
                   (else
                    (match (check-node k (- h 1) #f)
                      ((Some why) (Some why))
                      (None (go (+ i 1)))))))))))))

;; What is wrong with `r`, if anything. For tests.
(: (-> Text (Option string)))
(defun (text-check r)
  (cond
    ((= (.height r) 0)
     (cond
       ((> (.bytes r) chunk-max) (Some "a text of one string is longer than a chunk"))
       ((not (= (.bytes r) (string-length (.small r)))) (Some "the byte count is wrong"))
       ((not (= (.lines r) (newlines-in (.small r)))) (Some "the newline count is wrong"))
       (else None)))
    ((not (= (.bytes r) (sum-bytes (.root r)))) (Some "the byte count is wrong"))
    ((not (= (.lines r) (sum-lines (.root r)))) (Some "the newline count is wrong"))
    ((<= (.bytes r) chunk-max) (Some "a tree holds no more than one chunk"))
    ((and (> (.height r) 1) (< (node-count (.root r)) 2)) (Some "a root branch has one child"))
    (else (check-node (.root r) (.height r) #t))))
