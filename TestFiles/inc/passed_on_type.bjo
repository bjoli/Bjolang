;; A type with an implementation of its own, for 452: the modules that pass it
;; on, and the test that imports only them.
(import (std prelude))
(export Crate make-crate)

(type (: Crate (Record (: items int))))

(impl (Displayed Crate)
  (defun (display-into c b)
    (stringbuilder-add-string! b #"a crate of ${(record-ref c items)}")))

(: (-> int Crate))
(defun (make-crate n) (Crate (items n)))
