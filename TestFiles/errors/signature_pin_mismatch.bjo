;; A call is checked against what the callee's where clause pins: the
;; elements of a list of ints are not pairs.

;; EXPECT-ERROR: the associated type #:elem of 'Iterable', which the where clause of 'to-map' pins, does not hold at this call.

(import (std prelude))

(: to-map (-> %s (Map %k %v)) (where (Eq %k) (Iterable %s #:elem (Tuple %k %v))))
(defun (to-map s)
  (loop (:for e s)
        (:acc m (mapping e))))

(defun (main args)
  (println (to-map (list 1 2 3)))
  0)
