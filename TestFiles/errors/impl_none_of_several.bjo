;; A head with implementations at other arguments only.

;; EXPECT-ERROR: no implementation of trait 'Describe' for '(List bool)', required by 'describe'. It has implementations for '(List int)' and '(List string)' only.

(import (std prelude))

(def/trait (Describe %a)
  (: describe (-> %a string)))

(impl (Describe (List int))
  (defun (describe xs) "ints"))

(impl (Describe (List string))
  (defun (describe xs) "strings"))

(defun (main args)
  (println (describe (list #t)))
  0)
