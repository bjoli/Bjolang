;; A `:subloop` form's `:for` variables are not visible after the form.

;; EXPECT-ERROR: Unbound variable: y

(import (std prelude))

(: f (-> (List (List int)) (List int)))
(defun (f rows)
  (loop (:for row rows)
        (:subloop (:for y row)
                  (:acc s (summing y)))
        (:acc out (listing (+ s y)))))

(defun (main) (println (int->string (list-length (f '((1)))))) 0)
