(import (std prelude))

;; En let-bunden lambda är monomorf, så två användningar vid olika typer är ett
;; typfel. `057_local_generalization` har den positiva halvan: monomorf, men
;; fullt användbar.
;;
;; Gränsen som pinnas är den mellan `ELet`s två nivåer. Bara den
;; funktions-formade bindningen går in en nivå och generaliseras; ett värde
;; stannar på den omgivande. Höjdes nivån för båda skulle `id` få ett schema av
;; sig själv och en delegat med odeklarerad typparameter nå C#.
;;
;; EXPECT-ERROR: these types do not match
;; EXPECT-ERROR: string

(defun (main args)
  (let ((id (fun (v) v)))
    (displayln (id "a"))
    (displayln (int->string (id 1))))
  0)
