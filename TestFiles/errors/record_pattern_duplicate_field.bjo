;; A field is matched at most once in one record pattern.

;; EXPECT-ERROR: field 'brand' of 'Car' is matched twice

(import (std prelude))

(type (: Car (Record (: brand string) (: year int))))

(: f (-> Car string))
(defun (f c)
  (match c
    ((Car (brand b) (brand "x")) b)
    (_ "")))

(defun (main args)
  (println (f (Car (brand "a") (year 1))))
  0)
