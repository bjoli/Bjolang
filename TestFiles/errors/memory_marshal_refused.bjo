;; MemoryMarshal can make a read-only memory writable, as the bytes of a
;; string, so it cannot be named.

;; EXPECT-ERROR: 'System.Runtime.InteropServices.MemoryMarshal' cannot be used from Bjolang

(import (std prelude))
(import/class
  ((Rom %a) (: System.ReadOnlyMemory))
  ((Mem %a) (: System.Memory)))
(import/extern
  (writable (: System.Runtime.InteropServices.MemoryMarshal.AsMemory (-> (Rom %a) (Mem %a)))))
(defun (main) 0)
