;; Två moduler med samma filnamn, i olika kataloger.
;;
;; En moduls identitet är katalogen den ligger i och dess namn, inte filnamnet
;; ensamt. Båda heter `thing`, båda deklarerar en `Thing`, och det är två
;; moduler och två typer.
;;
;; Klassen och typerna emitteras i en namnrymd som följer katalogen, och
;; assemblyn heter samma sak — annars svarar `thing.dll` för båda och
;; programmet kallar en metod som inte finns i den som laddades.
;;
;; Att korsa de två `Thing` är ett typfel, och det står i
;; `errors/same_basename_types_are_distinct.bjo`.
(import (std simpletest))
(import "samebase/a/thing.bjo")
(import "samebase/b/thing.bjo")
(import (std prelude))

(defun (main)
  (expect "a's constructor and a's peeler" (peel-a (make-a 7)) 7)
  (expect "b's constructor and b's peeler" (peel-b (make-b "hello")) "hello")
  (println "171 ok")
  0)
