;; #:copy imports, exported: the importing module reads the clause back with
;; its flag.
(export bom-of take-from)

(import/class
  (Encoding (: System.Text.Encoding)))

(import/extern
  (bom-of (: System.Text.Encoding.Preamble (-> Encoding (Array byte)) #:get #:copy))
  (take-from (: System.MemoryExtensions.AsSpan (-> (Array %a) int (Array %a)) #:copy)))
