;; One clause, both accessors.
;;
;; `#:get` and `#:set` produce two different things — a read of one argument and
;; a write of two — and a clause binds one name. Deriving the second name from
;; the first would mean inventing a spelling the author never wrote, and letting
;; one name mean both would mean deciding which by arity, which is the kind of
;; overloading the rest of the interop surface goes out of its way to resolve at
;; compile time.
;;
;; So it is two clauses. That is also what lets a module import only the read of
;; a property it has no business writing.

;; EXPECT-ERROR: a clause is one accessor
;; EXPECT-ERROR: two clauses under two names

(import (std prelude))

(import/extern
  (sb-length (: System.Text.StringBuilder.Length #:get #:set)))

(defun (main args) 0)
