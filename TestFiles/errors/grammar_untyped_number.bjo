;; A number whose type is still open goes where the same number written out
;; would go. In a grammar with no alternative for a number there is no such
;; place, and the message names the variable rather than the literal.
;; EXPECT-ERROR: Word: expected a string or a symbol; found 'total', a number.
(import (std prelude))

(def/grammar Word
  (:or (: WStr string) (: WSym symbol)))

(: (-> Word int))
(defun (f w) 1)

(defun (main)
  (def total (+ 1 2))
  (println (f total)))
