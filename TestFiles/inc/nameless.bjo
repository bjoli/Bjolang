;; Exports functions whose signatures are written without a name, for
;; 417_nameless_signatures.bjo: the signature an importer reads is the named
;; one the parser made.
(import (std prelude))

(export triple sum-of)

(: (-> int int))
(defun (triple x) (* 3 x))

(: (-> %s int) (where (Iterable %s #:elem int)))
(defun (sum-of s) {summing x (:for x s)})
