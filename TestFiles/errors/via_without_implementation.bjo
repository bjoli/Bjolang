;; The implementation via a type is that type's, so there has to be one.

;; EXPECT-ERROR: 'Describe' cannot be implemented for via_without_implementation/Banana via int: int has no implementation of 'Describe'.

(import (std prelude))

(def/trait (Describe %a) (: describe (-> %a string)))

(type (: Banana (Newtype int)))
(impl (Describe Banana) #:via int)

(defun (main args) 0)
