;; Docs for std/syntax-match.bjo, read through (:doc #:file "syntax-match.bjodoc").
;; The texts are samizdat markup: code in prose is @code{...}.

(:doc #:module
  (summary "Pattern matching on syntax objects for macro transformers.")
  (see syntax-match all-of)
  (example """
    (import (std syntax-match))

    (def/macro (my-let form inject compare)
      (syntax-match form
        ((_ ((name value) ...) body ...)
         #'((fun (,@name) ,@body) ,@value))
        (bad (syntax-error bad "my-let takes a binding list and a body."))))
    """)
  (reference """
    @code{#'} constructs syntax and @code{syntax-match} destructures it. Use
    this macro instead of raw @code{match} on @code{Syntax} records.

    A @code{syntax-match} form compiles into a single pattern @code{match}.
    Each clause becomes a pattern branch. Structural tests become pattern guards
    (@code{#:when}). Ellipses over compound patterns desugar into folds using
    @code{all-of}. See @code{Docs/MACROS.org} for comprehensive macro documentation.
    """))

(:doc all-of
  (summary "Applies a function across a list, returning all results or None if any element fails.")
  (arg items "The list of items to process.")
  (arg f "Transformation function returning (Some transformed) or None on failure.")
  (returns "(Some results) in original order if f succeeds for every element, otherwise None.")
  (see syntax-match)
  (example """
    (all-of (list 1 2 3) (fun (n) (if (> n 0) (Some (* n 2)) None)))   ; (Some (list 2 4 6))
    (all-of (list 1 -2 3) (fun (n) (if (> n 0) (Some n) None)))        ; None
    """)
  (reference """
    Used by @code{syntax-match} when expanding ellipses over compound
    patterns, such as @code{((name value) ...)}. Short-circuits on the first
    failure. Returns @code{(Some (list))} for empty input.
    """))

(:doc syntax-match
  (summary "Matches a syntax expression against structural patterns, executing the first matching clause.")
  (form (syntax-match subject clause ...))
  (arg subject "Syntax expression to inspect, typically the macro input form.")
  (rest clause """
    Clause specification @code{(pattern body ...)}. Pattern variables are scoped
    within the clause body. The final expression determines the clause value.
    """)
  (see all-of)
  (example """
    (def/macro (swap! form inject compare)
      (syntax-match form
        ((_ a b)
         #'(let ((tmp ,a)) (set! ,a ,b) (set! ,b tmp)))
        (bad (syntax-error bad "swap! takes two variables: (swap! a b)."))))

    ;; 'else matches the identifier else; a keyword matches that keyword
    (syntax-match clause
      (('else body ...) #'(begin ,@body))
      ((#:when test body ...) #'(when ,test ,@body))
      ((test body ...) #'(if ,test (begin ,@body) unit)))
    """)
  (reference """
    Supported pattern forms:

    @code{_}: Wildcard pattern; matches any syntax without binding.

    @code{name}: Variable pattern; matches any syntax and binds it to @code{name}.
    Variable names must start with a lowercase letter. Uppercase names cause
    compile errors because they resemble union constructors; use quoted literals
    like @code{'Cons} to match capitalized identifiers.

    @code{'name}: Identifier literal; matches identifier @code{name} using
    @code{syntax-ident=?} (ignoring hygiene marks).

    Literals: Integers, strings, characters, and keywords match exact literal
    values.

    @code{(p q)}: Fixed-length list pattern matching each sub-pattern positionally.

    @code{(p q ...)}: Variable-length pattern requiring initial matches for
    prefixes, with trailing elements matching @code{q}. If @code{q} is a variable,
    it binds remaining items as @code{(List Syntax)}. If @code{q} is a compound
    pattern, inner variables bind lists of matched elements. Ellipses may nest:
    @code{((head arg ...) ...)} binds @code{head} to a list and @code{arg} to a
    list of lists.

    Restrictions: Only one @code{...} is allowed per list pattern, and it must
    appear at the end. Duplicate variable bindings within a pattern are syntax
    errors.

    Clauses evaluate in declaration order. If no clauses match and no
    wildcard/catch-all clause is present, a compile error is raised indicating
    that no clause matched. Provide a final fallback clause like
    @code{(bad (syntax-error bad "..."))} to generate informative macro errors.
    """))
