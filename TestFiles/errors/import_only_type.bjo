;; Rule 1: `only` and `except` filter defs and macros. A type always arrives,
;; because an imported signature is source text that has to resolve the types
;; it mentions — there is no view of a module in which its own signatures do
;; not typecheck.
;;
;; EXPECT-ERROR: Invalid (only ...)
;; EXPECT-ERROR: 'Crate' is a type
;; EXPECT-ERROR: Types, constructors and traits always arrive with their module

(import (only "../inc/kitchen.bjo" Crate))

(defun (main)
  0)
