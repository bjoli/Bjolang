;; A tag written where a stage belongs.
;;
;; `into-file` is a `#:tag` of `run/Form`, so a stage position holding it names
;; that case — and the case takes a file name and one form, which a bare symbol
;; is not. The tag is matched where the literal is written, so this is a type
;; error rather than the `Err` it used to be, and it says which case the symbol
;; named and how many arguments one takes.
;;
;; `'(pipe (echo "x") ("into-file" "out.txt"))` is how a program of that name
;; still reads, since a string is no tag.

;; EXPECT-ERROR: run/FInto` takes 2 arguments

(import (std prelude))
(import (std run))

(defun (main args)
  (match (run/string '(pipe (echo "x") into-file "out.txt"))
    ((Ok s) 0)
    ((Err e) 0))
  0)
