;; Only one alternative of an `(or ...)` matches, so which code a view ran
;; would depend on which alternative was tried. Refused for the reason an
;; alternative may not bind.
;;
;; EXPECT-ERROR: an alternative cannot run a view

(: pick (-> int string))
(defun (pick n)
  (match n
    ((or 1 (:view even? #t)) "yes")
    (_ "no")))

(defun (main args)
  (println (pick 1))
  0)
