;; A type variable used where .NET needs a value type and where it needs a
;; reference type cannot be either, and that is said about the function.
;; EXPECT-ERROR: 'both' uses its type variable %a with .NET generics that need it to be a value type (struct) and with ones that need it to be a reference type (class)
(import (std prelude))
(import/class
  ((Nullable %a) (: System.Nullable))
  ((Weak %a) (: System.WeakReference)))

(: (-> (Nullable %a) (Weak %a) int))
(defun (both x y) 1)

(defun (main) 0)
