(import (std prelude))
(defun (main args)
    (def definitely-false (or (= 0 3) (= 4 0)))
    (if definitely-false
        (displayln "Wrong")
        (displayln "Right"))

    (def actually-false (and (= 3 3) (= 4 0)))
    (if actually-false
        (displayln "Wrong")
        (displayln "Right"))
    (def should-be-true (or (= 0 3) (= 4 4)))
    (if should-be-true
        (displayln "Right")
        (displayln "Wrong"))

    (def and-true-again (and (= 4 4) (= 0 0)))
    (if and-true-again
        (displayln "Right")
        (displayln "Wrong"))
    
    (if (not #t)
        (displayln "Wrong")
        (displayln "Right"))
    
    (if (not #f)
        (displayln "Right")
        (displayln "Wrong"))
    0
)
