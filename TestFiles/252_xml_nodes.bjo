;; (text xml): names, the invariants the node constructors keep, the views, the
;; helpers, and equality. Every walk keeps its own stack, which the tree
;; 100 000 elements deep at the end is for.

(import (std prelude))
(import (std simpletest))
(import (text xml))

(: raises? (-> (-> %a) bool))
(defun (raises? thunk)
  (err? (try (thunk) #:catch (System.ArgumentException))))

(: p XmlName)
(def p (xml-name "p"))

(: b XmlName)
(def b (xml-name "b"))

(: atom XmlName)
(def atom (xml-name "entry" #:ns "http://www.w3.org/2005/Atom"))

(: attr (-> string string (Tuple XmlName string)))
(defun (attr name value) (Tuple (xml-name name) value))

(: names (-> void))
(defun (names)
  (expect "a local name" (xml-name-local atom) "entry")
  (expect "its namespace" (xml-name-ns atom) "http://www.w3.org/2005/Atom")
  (expect "no namespace is empty" (xml-name-ns p) "")
  (expect-true "one name, asked for twice" (= atom (xml-name "entry" #:ns "http://www.w3.org/2005/Atom")))
  (expect-true "the namespace is part of it" (not (= (xml-name "entry") atom)))
  (expect-true "a colon is no local name" (raises? (fun () (xml-name "a:b"))))
  (expect-true "nor is the empty string" (raises? (fun () (xml-name ""))))
  (expect-true "nor a leading digit" (raises? (fun () (xml-name "1a"))))
  (expect "the xml namespace" xml-namespace "http://www.w3.org/XML/1998/namespace"))

(: construction (-> void))
(defun (construction)
  (def e (xml-element p Nil (list (xml-text "a") (xml-text "") (xml-text "b")
                                  (xml-comment "c")
                                  (xml-text "") (xml-text "d") (xml-text "e"))))
  (def kids (element-children e))
  (expect "adjacent text is merged, empty text dropped" (list-length kids) 3)
  (expect "the first text" (text-value (list-head kids)) "ab")
  (expect "the last text" (text-value (list-ref kids 2)) "de")
  (expect "only empty text leaves nothing" (list-length (element-children (xml-element p Nil (list (xml-text ""))))) 0)
  (expect-true "a duplicate attribute raises"
               (raises? (fun () (xml-element p (list (attr "a" "1") (attr "a" "2")) Nil))))
  (expect-true "xmlns is not an attribute"
               (raises? (fun () (xml-element p (list (attr "xmlns" "u")) Nil))))
  (expect-true "nor is xmlns:q"
               (raises? (fun () (xml-element p (list (Tuple (xml-name "q" #:ns "http://www.w3.org/2000/xmlns/") "u")) Nil))))
  (def many (list-map (fun (i) (attr #"a${i}" (int->string i))) (seq->list (seq-range 0 40))))
  (expect "forty different attributes" (list-length (element-attrs (xml-element p many Nil))) 40)
  (expect-true "forty and one twice raises"
               (raises? (fun () (xml-element p (Cons (attr "a17" "x") many) Nil))))
  (expect-true "the same name in two namespaces is two attributes"
               (element? (xml-element p (list (attr "a" "1") (Tuple (xml-name "a" #:ns "u") "2")) Nil)))
  (expect "a position" (element-pos (xml-element p Nil Nil #:pos (Some (XmlPos (line 3) (column 4)))))
          (Some (XmlPos (line 3) (column 4))))
  (expect "no position" (element-pos (xml-element p Nil Nil)) None))

(: views (-> void))
(defun (views)
  (def e (xml-element p (list (attr "class" "x") (attr "id" "y"))
                      (list (xml-text "hi ") (xml-element b Nil (list (xml-text "!"))) (xml-pi "t" "d"))))
  (expect-true "element?" (element? e))
  (expect-true "text?" (text? (xml-text "x")))
  (expect-true "comment?" (comment? (xml-comment "x")))
  (expect-true "pi?" (pi? (xml-pi "t" "d")))
  (expect-true "not an element" (not (element? (xml-text "x"))))
  (expect-true "element-name" (= (element-name e) p))
  (expect "attr-ref" (attr-ref e (xml-name "id")) (Some "y"))
  (expect "attr-ref, missing" (attr-ref e (xml-name "href")) None)
  (expect "attr-ref on text" (attr-ref (xml-text "x") (xml-name "id")) None)
  (expect "comment-value" (comment-value (xml-comment "c")) "c")
  (expect "pi-target" (pi-target (xml-pi "t" "d")) "t")
  (expect "pi-data" (pi-data (xml-pi "t" "d")) "d")
  (expect-true "an accessor on the wrong variant raises" (raises? (fun () (element-name (xml-text "x")))))
  (expect-true "and the other way" (raises? (fun () (text-value e))))
  (expect "element-view"
          (match (element-view e)
            ((Some (Tuple name attrs kids)) (list-length kids))
            (None -1))
          3)
  (expect-true "element-view of a text" (none? (element-view (xml-text "x"))))
  (expect "element-children-only" (list-length (element-children-only e)) 1)
  (expect "text-content" (text-content e) "hi !")
  (expect "text-content of a text" (text-content (xml-text "t")) "t")
  (expect "text-content of a comment" (text-content (xml-comment "c")) "")
  (expect "descendants, in document order"
          (seq->list (seq-map (fun (n) (node-case n
                                          #:element (fun (name attrs kids pos) (xml-name-local name))
                                          #:text (fun (s) s)
                                          #:else (fun (m) "?")))
                              (descendants e)))
          (list "hi " "b" "!" "?"))
  (expect "node-case, a clause" (node-case (xml-comment "c") #:comment (fun (s) (str "c:" s)) #:else (fun (m) "")) "c:c")
  (expect "node-case, else" (node-case (xml-pi "t" "d") #:comment (fun (s) 1) #:else (fun (m) 2)) 2)
  (expect "node-case, every clause"
          (node-case e
                     #:element (fun (name attrs kids pos) (list-length attrs))
                     #:text (fun (s) 0) #:comment (fun (s) 0) #:pi (fun (t d) 0))
          2)
  (expect-true "node-case with no clause and no else raises"
               (raises? (fun () (node-case (xml-text "x") #:comment (fun (s) 1))))))

(: equality (-> void))
(defun (equality)
  (def one (xml-element p (list (attr "a" "1") (attr "b" "2")) (list (xml-text "x"))
                        #:pos (Some (XmlPos (line 1) (column 2)))))
  (def two (xml-element p (list (attr "b" "2") (attr "a" "1")) (list (xml-text "x"))))
  (expect-true "positions and attribute order do not count" (node=? one two))
  (expect-true "= is node=?" (= one two))
  (expect "and the hashes agree" (eq-hash one) (eq-hash two))
  (expect-true "a different value" (not (node=? one (xml-element p (list (attr "a" "1") (attr "b" "3")) (list (xml-text "x"))))))
  (expect-true "a missing attribute" (not (node=? one (xml-element p (list (attr "a" "1")) (list (xml-text "x"))))))
  (expect-true "different text" (not (node=? one (xml-element p (list (attr "a" "1") (attr "b" "2")) (list (xml-text "y"))))))
  (expect-true "a child more" (not (node=? one (xml-element p (list (attr "a" "1") (attr "b" "2")) (list (xml-text "x") (xml-comment "c"))))))
  (expect-true "text built in pieces is text" (node=? (xml-element p Nil (list (xml-text "a") (xml-text "b")))
                                                     (xml-element p Nil (list (xml-text "ab")))))
  (expect-true "a text and a comment" (not (node=? (xml-text "a") (xml-comment "a")))))

(: documents (-> void))
(defun (documents)
  (def root (xml-element p Nil (list (xml-text "x"))))
  (def d (xml-document root #:prolog (list (xml-comment "c") (xml-pi "style" "a")) #:epilog (list (xml-comment "e"))))
  (expect-true "the root" (node=? (document-root d) root))
  (expect "the prolog" (list-length (document-prolog d)) 2)
  (expect "the epilog" (list-length (document-epilog d)) 1)
  (expect "no doctype" (document-doctype d) None)
  (def typed (xml-document root #:doctype (Some (Doctype (name "p") (public-id None) (system-id (Some "p.dtd"))))))
  (expect "a doctype" (match (document-doctype typed) ((Some dt) (record-ref dt system-id)) (None None)) (Some "p.dtd"))
  (expect-true "a text is no root" (raises? (fun () (xml-document (xml-text "x")))))
  (expect-true "an element is no prolog" (raises? (fun () (xml-document root #:prolog (list root)))))
  (expect-true "text is no epilog" (raises? (fun () (xml-document root #:epilog (list (xml-text "x"))))))
  (expect-true "document=?" (document=? d (xml-document (xml-element p Nil (list (xml-text "x")))
                                                        #:prolog (list (xml-comment "c") (xml-pi "style" "a"))
                                                        #:epilog (list (xml-comment "e")))))
  (expect-true "and =" (not (= d typed))))

;; n elements, each the only child of the one around it, with text at the
;; bottom. Built from the inside out, so building it recurses no more than
;; walking it may.
(: deep (-> int string Node))
(defun (deep n leaf)
  (let loop ((i 0) (acc (xml-text leaf)))
    (if (= i n) acc (loop (+ i 1) (xml-element (xml-name "d") (list (attr "i" (int->string i))) (list acc))))))

(: depth (-> void))
(defun (depth)
  (def one (deep 100000 "bottom"))
  (def two (deep 100000 "bottom"))
  (expect-true "node=? on 100 000 levels" (node=? one two))
  (expect-true "= on 100 000 levels" (= one two))
  (expect-true "a difference at the bottom" (not (node=? one (deep 100000 "other"))))
  (expect "eq-hash on 100 000 levels" (eq-hash one) (eq-hash two))
  (expect "text-content on 100 000 levels" (text-content one) "bottom")
  (expect "descendants on 100 000 levels" (seq-length (descendants one)) 100000))

(defun (main)
  (names)
  (construction)
  (views)
  (equality)
  (documents)
  (depth)
  0)
