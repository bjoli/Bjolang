;; A function's where clause holds (Trait %var) constraints. A form of any
;; other shape is refused: it used to be dropped without a word, and the
;; function then had no constraint at all.

;; EXPECT-ERROR: Syntax error in the signature of 'sum-up' at signature_where_malformed.bjo:9:23
;; EXPECT-ERROR: a where clause holds (TraitName %var) constraints

(import (std prelude))
(: (-> %s int) (where (Iterable (List %s))))
(defun (sum-up s) 0)

(defun (main args) 0)
