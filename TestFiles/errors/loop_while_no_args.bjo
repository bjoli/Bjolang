;; `:while` takes exactly one test.

;; EXPECT-ERROR: Invalid (:while ...)
;; EXPECT-ERROR: Expected: (:while test)

(import (std prelude))

(: f (-> (List int) int))
(defun (f xs)
  (loop (:for x xs)
        (:while)
        (:acc s (summing x))))

(defun (main) (println (int->string (f '(1 2 3)))) 0)
