;; `(.frobnicate x)` on a value whose type is not known, where no record has a
;; field `frobnicate`. It is a .NET call, and gets the error a .NET call on an
;; unknown receiver has always had, not one about record fields.

;; EXPECT-ERROR: the type of the receiver of '.frobnicate' is not known here
;; EXPECT-NO-ERROR: no record or struct type has a field

(import (std prelude))

(type (: Car (Record (: brand string))))

(defun (main args)
  (def f (fun (x) (.frobnicate x)))
  0)
