  (defun (simd128-narrow-saturating a b) (narrow128-saturating-us a b))
  (defun (simd256-narrow-wrapping a b) (narrow256-wrapping-us a b))
  (defun (simd256-narrow-saturating a b) (narrow256-saturating-us a b)))

(import/extern
  (narrow128-wrapping-i (: System.Runtime.Intrinsics.Vector128.Narrow (-> (Simd128 int) (Simd128 int) (Simd128 short))))
  (narrow128-saturating-i (: System.Runtime.Intrinsics.Vector128.NarrowWithSaturation (-> (Simd128 int) (Simd128 int) (Simd128 short))))
  (narrow256-wrapping-i (: System.Runtime.Intrinsics.Vector256.Narrow (-> (Simd256 int) (Simd256 int) (Simd256 short))))
  (narrow256-saturating-i (: System.Runtime.Intrinsics.Vector256.NarrowWithSaturation (-> (Simd256 int) (Simd256 int) (Simd256 short)))))
(impl (SimdNarrow int)
  (type %narrow short)
  (defun (simd128-narrow-wrapping a b) (narrow128-wrapping-i a b))
  (defun (simd128-narrow-saturating a b) (narrow128-saturating-i a b))
  (defun (simd256-narrow-wrapping a b) (narrow256-wrapping-i a b))
  (defun (simd256-narrow-saturating a b) (narrow256-saturating-i a b)))

(import/extern
  (narrow128-wrapping-ui (: System.Runtime.Intrinsics.Vector128.Narrow (-> (Simd128 uint) (Simd128 uint) (Simd128 ushort))))
  (narrow128-saturating-ui (: System.Runtime.Intrinsics.Vector128.NarrowWithSaturation (-> (Simd128 uint) (Simd128 uint) (Simd128 ushort))))
  (narrow256-wrapping-ui (: System.Runtime.Intrinsics.Vector256.Narrow (-> (Simd256 uint) (Simd256 uint) (Simd256 ushort))))
  (narrow256-saturating-ui (: System.Runtime.Intrinsics.Vector256.NarrowWithSaturation (-> (Simd256 uint) (Simd256 uint) (Simd256 ushort)))))
(impl (SimdNarrow uint)
  (type %narrow ushort)
  (defun (simd128-narrow-wrapping a b) (narrow128-wrapping-ui a b))
  (defun (simd128-narrow-saturating a b) (narrow128-saturating-ui a b))
  (defun (simd256-narrow-wrapping a b) (narrow256-wrapping-ui a b))
  (defun (simd256-narrow-saturating a b) (narrow256-saturating-ui a b)))

(import/extern
  (narrow128-wrapping-l (: System.Runtime.Intrinsics.Vector128.Narrow (-> (Simd128 long) (Simd128 long) (Simd128 int))))
  (narrow128-saturating-l (: System.Runtime.Intrinsics.Vector128.NarrowWithSaturation (-> (Simd128 long) (Simd128 long) (Simd128 int))))
  (narrow256-wrapping-l (: System.Runtime.Intrinsics.Vector256.Narrow (-> (Simd256 long) (Simd256 long) (Simd256 int))))
  (narrow256-saturating-l (: System.Runtime.Intrinsics.Vector256.NarrowWithSaturation (-> (Simd256 long) (Simd256 long) (Simd256 int)))))
(impl (SimdNarrow long)
  (type %narrow int)
  (defun (simd128-narrow-wrapping a b) (narrow128-wrapping-l a b))
  (defun (simd128-narrow-saturating a b) (narrow128-saturating-l a b))
  (defun (simd256-narrow-wrapping a b) (narrow256-wrapping-l a b))
  (defun (simd256-narrow-saturating a b) (narrow256-saturating-l a b)))

(import/extern
  (narrow128-wrapping-ul (: System.Runtime.Intrinsics.Vector128.Narrow (-> (Simd128 ulong) (Simd128 ulong) (Simd128 uint))))
  (narrow128-saturating-ul (: System.Runtime.Intrinsics.Vector128.NarrowWithSaturation (-> (Simd128 ulong) (Simd128 ulong) (Simd128 uint))))
  (narrow256-wrapping-ul (: System.Runtime.Intrinsics.Vector256.Narrow (-> (Simd256 ulong) (Simd256 ulong) (Simd256 uint))))
  (narrow256-saturating-ul (: System.Runtime.Intrinsics.Vector256.NarrowWithSaturation (-> (Simd256 ulong) (Simd256 ulong) (Simd256 uint)))))
(impl (SimdNarrow ulong)
  (type %narrow uint)
  (defun (simd128-narrow-wrapping a b) (narrow128-wrapping-ul a b))
  (defun (simd128-narrow-saturating a b) (narrow128-saturating-ul a b))
  (defun (simd256-narrow-wrapping a b) (narrow256-wrapping-ul a b))
  (defun (simd256-narrow-saturating a b) (narrow256-saturating-ul a b)))

(import/extern
  (int->float128-i (: System.Runtime.Intrinsics.Vector128.ConvertToSingle (-> (Simd128 int) (Simd128 System.Single))))
  (int->float256-i (: System.Runtime.Intrinsics.Vector256.ConvertToSingle (-> (Simd256 int) (Simd256 System.Single)))))
(impl (SimdIntToFloat int)
  (type %float System.Single)
  (defun (simd128-int->float v) (int->float128-i v))
  (defun (simd256-int->float v) (int->float256-i v)))

(import/extern
  (int->float128-ui (: System.Runtime.Intrinsics.Vector128.ConvertToSingle (-> (Simd128 uint) (Simd128 System.Single))))
  (int->float256-ui (: System.Runtime.Intrinsics.Vector256.ConvertToSingle (-> (Simd256 uint) (Simd256 System.Single)))))
(impl (SimdIntToFloat uint)
  (type %float System.Single)
  (defun (simd128-int->float v) (int->float128-ui v))
  (defun (simd256-int->float v) (int->float256-ui v)))

(import/extern
  (int->float128-l (: System.Runtime.Intrinsics.Vector128.ConvertToDouble (-> (Simd128 long) (Simd128 double))))
  (int->float256-l (: System.Runtime.Intrinsics.Vector256.ConvertToDouble (-> (Simd256 long) (Simd256 double)))))
(impl (SimdIntToFloat long)
  (type %float double)
  (defun (simd128-int->float v) (int->float128-l v))
  (defun (simd256-int->float v) (int->float256-l v)))

(import/extern
  (int->float128-ul (: System.Runtime.Intrinsics.Vector128.ConvertToDouble (-> (Simd128 ulong) (Simd128 double))))
  (int->float256-ul (: System.Runtime.Intrinsics.Vector256.ConvertToDouble (-> (Simd256 ulong) (Simd256 double)))))
(impl (SimdIntToFloat ulong)
  (type %float double)
  (defun (simd128-int->float v) (int->float128-ul v))
  (defun (simd256-int->float v) (int->float256-ul v)))

(import/extern
  (float->int128-f (: System.Runtime.Intrinsics.Vector128.ConvertToInt32 (-> (Simd128 System.Single) (Simd128 int))))
  (float->uint128-f (: System.Runtime.Intrinsics.Vector128.ConvertToUInt32 (-> (Simd128 System.Single) (Simd128 uint))))
  (float->int256-f (: System.Runtime.Intrinsics.Vector256.ConvertToInt32 (-> (Simd256 System.Single) (Simd256 int))))
  (float->uint256-f (: System.Runtime.Intrinsics.Vector256.ConvertToUInt32 (-> (Simd256 System.Single) (Simd256 uint)))))
(impl (SimdFloatToInt System.Single)
  (type %int int)
  (type %uint uint)
  (defun (simd128-float->int-truncating v) (float->int128-f v))
  (defun (simd128-float->uint-truncating v) (float->uint128-f v))
  (defun (simd256-float->int-truncating v) (float->int256-f v))
  (defun (simd256-float->uint-truncating v) (float->uint256-f v)))

(import/extern
  (float->int128-d (: System.Runtime.Intrinsics.Vector128.ConvertToInt64 (-> (Simd128 double) (Simd128 long))))
  (float->uint128-d (: System.Runtime.Intrinsics.Vector128.ConvertToUInt64 (-> (Simd128 double) (Simd128 ulong))))
  (float->int256-d (: System.Runtime.Intrinsics.Vector256.ConvertToInt64 (-> (Simd256 double) (Simd256 long))))
  (float->uint256-d (: System.Runtime.Intrinsics.Vector256.ConvertToUInt64 (-> (Simd256 double) (Simd256 ulong)))))
(impl (SimdFloatToInt double)
  (type %int long)
  (type %uint ulong)
  (defun (simd128-float->int-truncating v) (float->int128-d v))
  (defun (simd128-float->uint-truncating v) (float->uint128-d v))
  (defun (simd256-float->int-truncating v) (float->int256-d v))
  (defun (simd256-float->uint-truncating v) (float->uint256-d v)))

;; ---------------------------------------------------------------------------
;; A vector of given lanes
;; ---------------------------------------------------------------------------
;;
;; `(simd128-of 1 2 3 4)`: a vector with these lanes, from lane 0. Each value
;; is written into a vector of zeros with `simd-with`. A lane not given is 0,
;; and a value past the last lane raises `ArgumentOutOfRangeException`. With
;; constants, the JIT folds the writes into one constant vector.

(: (-> Syntax int (List Syntax) Syntax))
(defun (lanes-of acc i xs)
  (match xs
    (Nil acc)
    ((Cons x rest)
     (lanes-of #'(simd-with ,acc ,(SInt (int->string i)) ,x) (+ i 1) rest))))

(def/macro (simd128-of form inject compare)
  (syntax-match form
    ((_ first rest ...) (lanes-of #'(simd128-zero) 0 (Cons first rest)))
    (bad (syntax-error bad "simd128-of takes the lanes, one or more: (simd128-of 1 2 3 4)."))))

(def/macro (simd256-of form inject compare)
  (syntax-match form
    ((_ first rest ...) (lanes-of #'(simd256-zero) 0 (Cons first rest)))
    (bad (syntax-error bad "simd256-of takes the lanes, one or more: (simd256-of 1 2 3 4)."))))

;; ---------------------------------------------------------------------------
;; Where vectors are loaded from
;; ---------------------------------------------------------------------------
;;
;; A source is a run of numbers in memory, one after the other: an array or a
;; `MutableVec`. Every load raises `ArgumentOutOfRangeException` when fewer
;; than a vector's lanes are left. A string is not a source: its positions
;; are cursors, and a lane of its bytes would be a byte index.

(def/trait (SimdSource %s)
  (type %elem)
  (: simd128-load (-> %s int (Simd128 %elem)))
  (: simd256-load (-> %s int (Simd256 %elem)))
  (: simd128-lanes (-> %s int))
  (: simd256-lanes (-> %s int))
  (: simd-source-length (-> %s int)))

(impl (SimdSource (Array %a)) (where (Lane %a))
  (type %elem %a)
  (defun (simd128-load a i) (v128-load-array a i))
  (defun (simd256-load a i) (v256-load-array a i))
  (defun (simd128-lanes a) (v128-array-lanes a))
  (defun (simd256-lanes a) (v256-array-lanes a))
  (defun (simd-source-length a) (array-length a)))

(impl (SimdSource (MutableVec %a)) (where (Lane %a))
  (type %elem %a)
  (defun (simd128-load v i) (v128-load-list v i))
  (defun (simd256-load v i) (v256-load-list v i))
  (defun (simd128-lanes v) (v128-list-lanes v))
  (defun (simd256-lanes v) (v256-list-lanes v))
  (defun (simd-source-length v) (mutablevec-length v)))

;; Where the elements after the last whole vector start.
(: (-> %s int) (where (SimdSource %s)))
(defun (simd128-whole s)
  (def w (simd128-lanes s))
  (* w (/ (simd-source-length s) w)))

(: (-> %s int) (where (SimdSource %s)))
(defun (simd256-whole s)
  (def w (simd256-lanes s))
  (* w (/ (simd-source-length s) w)))
