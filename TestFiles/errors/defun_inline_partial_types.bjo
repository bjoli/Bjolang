;; A return type written at the definition with a parameter left untyped.
;;
;; All or nothing. The return type used to be parsed and thrown away here, which
;; reads as a claim that was checked; half a signature is worse than none,
;; because the half that is missing is the half nothing tells you about.

;; EXPECT-ERROR: the return type is written here but the parameter 'y' has no type

(import (std prelude))

(defun (add (: x int) y) : int
  (+ x y))

(defun (main args)
  (println (add 1 2))
  0)
