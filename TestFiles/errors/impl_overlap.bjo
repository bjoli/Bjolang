;; Two implementations that a type can be an instance of both of. A call at
;; (List int) would have two to choose from, and which it got would depend on
;; what was known where the call was checked.

;; EXPECT-ERROR: 'Describe' already has an implementation for (List int), at impl_overlap.bjo:12:1. This one, for (List %a), overlaps it: (List int) is an instance of both

(import (std prelude))

(def/trait (Describe %a)
  (: describe (-> %a string)))

(impl (Describe (List int))
  (defun (describe xs) "ints"))

(impl (Describe (List %a))
  (defun (describe xs) "any list"))

(defun (main args)
  (println (describe (list 1)))
  0)
