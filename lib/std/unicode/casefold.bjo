;; std/unicode/casefold.bjo — full Unicode case folding (CaseFolding.txt).
;;
;; - The fold is the default, culture-independent one: the mappings of status
;;   C and F. The Turkic mappings (status T) are not used.
;; - The table is generated by gen_casefold.py into casefold-table.protobjo,
;;   and decoded once when the module is initialized.
;;
;; Cost:
;; - ASCII is folded without the table. Other characters take a binary
;;   search over the 1,606 mappings.
;; - A string that has nothing to fold is returned as it is, with no copy.

(export
  casefold-unicode-version
  string-foldcase)

(import (std prelude))

(:doc #:file "casefold.bjodoc")

(include "casefold-table.protobjo")

;; ---------------------------------------------------------------------------
;; The table
;; ---------------------------------------------------------------------------

(: string)
(def casefold-unicode-version unicode-version)

;; The value of a hex digit, as a byte of ASCII.
(: (-> byte int))
(defun (hex-value b)
  (def x (cast int b))
  (if (< x 97) (- x 48) (- x 87)))

;; The bytes of `text` that are not white space: the generated text is
;; indented, and every character it holds is '0' or above.
(: (-> string (Array byte)))
(defun (table-bytes text)
  (def src (string->bytes text))
  (def n (loop (:for b src) (:when (>= (cast int b) 48)) (:acc (summing 1))))
  (def (: out (Array byte)) (make-array n))
  (let go ((i 0) (j 0))
    (cond
      ((>= i (array-length src)) out)
      ((< (cast int (array-ref src i)) 48) (go (+ i 1) j))
      (else (array-set! out j (array-ref src i)) (go (+ i 1) (+ j 1))))))

(: (Array byte))
(def fold-digits (table-bytes fold-text))

;; The value of the `n` hex digits at `i` in `fold-digits`.
(: (-> int int int))
(defun (hex-at i n)
  (let go ((k 0) (v 0))
    (if (= k n)
        v
        (go (+ k 1) (+ (* 16 v) (hex-value (array-ref fold-digits (+ i k))))))))

;; The code points that fold, in order.
(: (Array int))
(def fold-keys (make-array fold-count))

;; Mapping `i` folds to `fold-targets` from `(array-ref fold-starts i)` up to
;; `(array-ref fold-starts (+ i 1))`.
(: (Array int))
(def fold-starts (make-array (+ fold-count 1)))

;; What the code points fold to. Filling it also fills `fold-keys` and
;; `fold-starts`.
(: (Array int))
(def fold-targets
  (begin
    (def (: out (Array int)) (make-array (/ (- (array-length fold-digits) (* 7 fold-count)) 6)))
    (let go ((m 0) (i 0) (t 0))
      (array-set! fold-starts m t)
      (when (< m fold-count)
        (array-set! fold-keys m (hex-at i 6))
        (def n (hex-at (+ i 6) 1))
        (loop (:for k (range 0 n))
              (:do (array-set! out (+ t k) (hex-at (+ i 7 (* 6 k)) 6))))
        (go (+ m 1) (+ i 7 (* 6 n)) (+ t n))))
    out))

;; The index of the mapping of `cp`, or -1 if `cp` does not fold.
(: (-> int int))
(defun (fold-index cp)
  (let go ((lo 0) (hi fold-count))
    (if (>= lo hi)
        -1
        (let* ((mid (shift-right (+ lo hi) 1))
               (k (array-ref fold-keys mid)))
          (cond
            ((< cp k) (go lo mid))
            ((> cp k) (go (+ mid 1) hi))
            (else mid))))))

(: (-> int bool) #:inline)
(defun (ascii-upper? cp) (and (>= cp 65) (<= cp 90)))

;; True if `ch` folds to something other than itself.
(: (-> char bool) #:inline)
(defun (folds? ch)
  (def cp (char->int ch))
  (if (< cp 128) (ascii-upper? cp) (>= (fold-index cp) 0)))

;; Adds the fold of `ch` to `sb`.
(: (-> StringBuilder char void))
(defun (add-folded! sb ch)
  (def cp (char->int ch))
  (if (< cp 128)
      (stringbuilder-add-byte! sb (if (ascii-upper? cp) (+ cp 32) cp))
      (let ((i (fold-index cp)))
        (if (< i 0)
            (stringbuilder-add! sb ch)
            (loop (:for k (range (array-ref fold-starts i) (array-ref fold-starts (+ i 1))))
                  (:do (stringbuilder-add! sb (int->char (array-ref fold-targets k)))))))))

;; ---------------------------------------------------------------------------
;; Strings
;; ---------------------------------------------------------------------------

;; The fold of `s` from the cursor `from` on, after the part before it, which
;; has nothing to fold.
(: (-> string StringCursor string))
(defun (fold-from s from)
  (def sb (stringbuilder-empty))
  (stringbuilder-add-substring! sb s (string-cursor-start s) from)
  (let go ((c from))
    (if (string-cursor-end? s c)
        (stringbuilder->string sb)
        (begin
          (def (Tuple ch next) (string-cursor-ref+next s c))
          (add-folded! sb ch)
          (go next)))))

(: (-> string string))
(defun (string-foldcase s)
  (let scan ((c (string-cursor-start s)))
    (if (string-cursor-end? s c)
        s
        (begin
          (def (Tuple ch next) (string-cursor-ref+next s c))
          (if (folds? ch)
              (fold-from s c)
              (scan next))))))
