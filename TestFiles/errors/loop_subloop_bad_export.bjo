;; `=>` in a `:subloop` form is followed by (name expr).

;; EXPECT-ERROR: must be followed by (name expr)

(import (std prelude))

(: f (-> (List (List int)) (List int)))
(defun (f rows)
  (loop (:for row rows)
        (:subloop (:for y row)
                  (:acc s (summing y))
                  => s)
        (:acc out (listing s))))

(defun (main) (println (int->string (list-length (f '((1)))))) 0)
