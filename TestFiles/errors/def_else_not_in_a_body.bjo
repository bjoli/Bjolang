;; `def/else` binds over the rest of the body it stands in, so it has to stand
;; in one. Inside another expression there is no sequel to give it.

;; EXPECT-ERROR: must appear directly in a body

(import (std prelude))

(: f (-> (Option int) int))
(defun (f o)
  (with-return ret
    (+ 1 (def/else ((Some n) o) 0))))
