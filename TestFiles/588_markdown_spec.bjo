;; The examples of the CommonMark spec 0.31.2, read by (text markdown) with
;; every extension off and written with markdown->html. Each example's HTML
;; must be the spec's.
;;
;; The examples are in TestFiles/assets/markdown/commonmark-spec.json, from
;; `bjo task markdown-data`. A failure is a FAILURE line with the example's
;; number and section, its Markdown, and the HTML that was written.

(import (std prelude))
(import (text json))
(import (text markdown))

(: (-> (Map string Json) string string))
(defun (field m name)
  (match (map-try-ref m name)
    ((Some (JsonStr s)) s)
    ((Some (JsonInt n)) (long->string n))
    (_ (panic! #"588: an example has no ${name}"))))

(defun (main)
  (def examples
    (match (parse-json (file-read-text "TestFiles/assets/markdown/commonmark-spec.json"))
      ((Ok (JsonArr xs)) (iarray->vec xs))
      (_ (panic! "588: commonmark-spec.json is not an array"))))
  (def failed
    {counting #t
              (:for e examples)
              (:let m (match e ((JsonObj m) m) (_ (panic! "588: an example is not an object"))))
              (:let markdown (field m "markdown"))
              (:let wanted (field m "html"))
              (:let got (markdown->html (markdown-parse markdown #:tables #f #:task-lists #f
                                                        #:strikethrough #f #:autolinks #f
                                                        #:footnotes #f #:front-matter #f)))
              (:when (not (= got wanted)))
              (:do (println #"FAILURE: example ${(field m "example")} (${(field m "section")}): ${(written markdown)} gave ${(written got)} but wanted ${(written wanted)}"))})
  (println #"commonmark spec: ${(- (vec-length examples) failed)} of ${(vec-length examples)} examples"))
