;; An alternative of a nested `or` that a clause above covers, with the rest
;; of its clause: `(Tuple 1 3)` is matched by `(Tuple 1 _)`.

;; EXPECT-ERROR: this alternative can never run

(import (std prelude))

(: (-> (Tuple int int) int))
(defun (f t)
  (match t
    ((Tuple 1 _) 5)
    ((Tuple (or 1 2) 3) 1)
    (_ 0)))

(defun (main args)
  (println (int->string (f (Tuple 2 3))))
  0)
