;; `:propagate` rebuilds the cases the pattern leaves out, and a pattern that
;; always matches leaves none.
;;
;; The same refusal an irrefutable pattern gets for a failure value, since the
;; keyword is a failure part like any other.

;; EXPECT-ERROR: always matches, so the failure part of this def can never run

(import (std prelude))

(: f (-> (Option int) (Option int)))
(defun (f o)
  (def whatever o :propagate)
  whatever)
