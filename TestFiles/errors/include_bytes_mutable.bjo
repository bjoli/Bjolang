;; EXPECT-ERROR: 'x' is a module-level definition of type (System.ReadOnlySpan byte). A module-level value is a static field, and a span cannot be one
;;
;; Only a (def x (include-bytes ...)) is a property; a def/mutable is a field.
(import (std prelude))
(def/mutable x (include-bytes "../assets/include-bytes/bytes.bin"))
(defun (main) 0)
