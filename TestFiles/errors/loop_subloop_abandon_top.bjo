;; `:abandon` at the top of a `:subloop` form has no level above it inside the
;; form. Leaving the form that way is `:abandon-subloop`.

;; EXPECT-ERROR: `:abandon` has no level above here; use `:abandon-subloop`.

(import (std prelude))

(: f (-> (List (List int)) (List int)))
(defun (f rows)
  (loop (:for row rows)
        (:subloop (:for y row)
                  (:abandon (< y 0))
                  (:acc s (summing y)))
        (:acc out (listing s))))

(defun (main) (println (int->string (list-length (f '((1)))))) 0)
