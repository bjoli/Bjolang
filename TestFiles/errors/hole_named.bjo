;; EXPECT-ERROR: '_total' stands for a value of type int.
;; EXPECT-ERROR: Bindings in scope that fit: seen, x
;; EXPECT-NO-ERROR: is an illegal name
;; EXPECT-NO-ERROR: Unbound variable
;;
;; A `_name` in an expression is a hole, named. Nothing can bind such a name,
;; so it is never a variable.

(import (std prelude))

(: count-up (-> int int))
(defun (count-up x)
  (let ((seen (+ x 1)))
    (+ seen _total)))

(defun (main) 0)
