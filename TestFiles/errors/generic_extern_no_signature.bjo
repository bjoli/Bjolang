;; A generic method's type arguments come from its declared signature, so it is
;; the one kind of import that cannot do without one. There is nothing else that
;; could say what `%a` is.
;; EXPECT-ERROR: is generic, so this import needs a declared signature
(import (std prelude))

(import/class
  ((Set %a) (: Set.Set)))

(import/extern
  (set-add (: Set.SetModule.Add)))

(defun (main args) 0)
