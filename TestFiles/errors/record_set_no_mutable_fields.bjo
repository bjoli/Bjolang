;; `record-set!` on a record that has no mutable field at all.
;;
;; The same refusal as `record_set_immutable_field`, but the advice differs:
;; there is no list of writable fields to offer, so the message says so rather
;; than trailing off after a colon.

;; EXPECT-ERROR: is not mutable
;; EXPECT-ERROR: It has no mutable fields.

(import (std prelude))

(type
  (: Point (Record (: x int) (: y int))))

(defun (main args)
  (def p (Point (x 1) (y 2)))
  (record-set! p (x 10))
  0)
