;; FIB -- A classic benchmark, computes fib(n) inefficiently.
;; Arguments: count n expected

(import "common.bjo")

(: fib (-> int int))
(defun (fib n)
  (if (< n 2)
      n
      (+ (fib (- n 1)) (fib (- n 2)))))

(defun (main args)
  (def n (arg-int args 1))
  (def expected (arg-int args 2))
  (run-benchmark "fib" (arg-int args 0) (fun () (fib n)) #(= & expected)))
