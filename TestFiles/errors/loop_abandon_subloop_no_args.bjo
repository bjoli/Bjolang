;; `:abandon-subloop` takes exactly one test.

;; EXPECT-ERROR: Invalid (:abandon-subloop ...)
;; EXPECT-ERROR: Expected: (:abandon-subloop test)

(import (std prelude))

(: f (-> (List (List int)) (List int)))
(defun (f rows)
  (loop (:for row rows)
        (:subloop (:for y row)
                  (:abandon-subloop)
                  (:acc s (summing y)))
        (:acc out (listing s))))

(defun (main) (println (int->string (list-length (f '((1)))))) 0)
