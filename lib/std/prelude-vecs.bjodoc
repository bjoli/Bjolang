;; Docs for the prelude's vecs and arrays: the persistent Vec (an RRB tree),
;; its builder and cursors, slices of vecs and arrays to loop over, .NET
;; arrays, and the Vecing collector. Read through (:doc #:file ...) from
;; prelude.bjo. The texts are samizdat markup: code in prose is @code{...}.

;; ---------------------------------------------------------------------------
;; Making and reading a vec
;; ---------------------------------------------------------------------------

(:doc vec-empty
  (summary "An empty vec.")
  (returns "A vec with no elements.")
  (see vec-empty? vecbuilder-empty)
  (reference """
    The constructor. The predicate is @code{vec-empty?}.
    """))

(:doc vec-empty?
  (summary "Whether a vec has no elements.")
  (arg v "The vec.")
  (returns "#t when its length is 0.")
  (see vec-empty vec-length)
  (reference """
    O(1): a vec stores its count, and this reads it.
    """))

(:doc vec-length
  (summary "How many elements a vec has.")
  (arg v "The vec.")
  (returns "Its number of elements.")
  (see vec-empty?)
  (reference """
    O(1): a vec stores its count.
    """))

(:doc vec-ref
  (summary "The element of a vec at an index.")
  (arg v "The vec.")
  (arg i "Zero-based index (0 <= i < length).")
  (returns "The element at i.")
  (raises System.IndexOutOfRangeException "When i is negative or not less than the length.")
  (see vec-set vec-length)
  (reference """
    A descent of the tree from the root, unless i is in the last few
    elements, which are kept in an array of their own. To visit every
    element, a @code{(:for x v)} loop, @code{in-vec} or @code{vec-for-each}
    walks the leaf arrays instead and costs less per element.
    """))

(:doc vec-contains
  (summary "Whether a vec holds an element.")
  (arg v "The vec.")
  (arg x "The element to look for.")
  (returns "#t when some element of v equals x.")
  (see vec-iter)
  (reference """
    A walk from the front that stops at the first match. Elements are
    compared with .NET's default equality for the type
    (@code{EqualityComparer<T>.Default}), not through Bjolang's @code{Eq}.
    """))

;; ---------------------------------------------------------------------------
;; Changing a vec
;; ---------------------------------------------------------------------------

(:doc vec-add
  (summary "Returns a vec with one element added at the end.")
  (arg v "The persistent vector (unmodified).")
  (arg x "The element to add.")
  (returns "A new vec, one longer, with x last.")
  (see vecbuilder-add! vec-insert vec-merge)
  (reference """
    The persistent counterpart of @code{vecbuilder-add!}, and what the
    @code{Addable} implementation for @code{Vec} calls. To add many
    elements, a @code{VecBuilder} or the @code{vecing} collector avoids
    making a vec per element.
    """))

(:doc vec-add-first
  (summary "Returns a vec with one element added at the front.")
  (arg v "The persistent vector (unmodified).")
  (arg x "The element to add.")
  (returns "A new vec, one longer, with x first.")
  (see vec-add vec-pop-first transientvec-add-first! vec-insert)
  (reference """
    The persistent counterpart of @code{transientvec-add-first!}. Equivalent
    to @code{(vec-insert v 0 x)}.
    """))

(:doc vec-set
  (summary "Returns a vec with the element at an index replaced.")
  (arg v "The persistent vector (unmodified).")
  (arg i "Zero-based index (0 <= i < length).")
  (arg x "The new element.")
  (returns "A new vec with x at i.")
  (raises System.IndexOutOfRangeException "When i is negative or not less than the length.")
  (see vec-ref vecbuilder-set!))

(:doc vec-insert
  (summary "Returns a vec with an element inserted at an index.")
  (arg v "The persistent vector (unmodified).")
  (arg i "Zero-based index at which to insert (0 <= i <= length). If i == length, behaves like vec-add.")
  (arg x "The element to insert.")
  (returns "A new vec, one longer, with x at i and subsequent elements shifted right.")
  (raises System.IndexOutOfRangeException "When i is negative or greater than the length.")
  (see vec-add vec-remove-at vec-compact)
  (reference """
    An insertion leaves the tree relaxed, so many of them can make it deeper
    than a vec built from the front; @code{vec-compact} rebuilds it.
    """))

(:doc vec-remove-at
  (summary "Returns a vec with the element at an index removed.")
  (arg v "The persistent vector (unmodified).")
  (arg i "Zero-based index (0 <= i < length).")
  (returns "A new vec with the element at i removed.")
  (raises System.IndexOutOfRangeException "When i is negative or not less than the length.")
  (see vec-insert vec-pop vec-pop-first))

(:doc vec-pop
  (summary "A vec without its last element.")
  (arg v "The vec, which is left as it was. Not empty.")
  (returns "A new vec, one shorter.")
  (raises System.InvalidOperationException "When v is empty.")
  (see vec-pop-first vec-remove-at vec-slice))

(:doc vec-pop-first
  (summary "A vec without its first element.")
  (arg v "The vec, which is left as it was. Not empty.")
  (returns "A new vec, one shorter.")
  (raises System.InvalidOperationException "When v is empty.")
  (see vec-pop vec-slice)
  (reference """
    @code{(vec-slice v 1 (- (vec-length v) 1))}.
    """))

(:doc vec-slice
  (summary "The part of a vec from an index, for a count of elements.")
  (arg v "The vec, which is left as it was.")
  (arg start "The first index taken, from 0.")
  (arg count "How many elements. start plus count is at most the length.")
  (returns "A new vec of count elements, v's from start on.")
  (raises System.ArgumentOutOfRangeException "When start or count is negative, or start plus count is more than the length.")
  (see vec-split in-vec subarray->vec)
  (example """
    (vec-slice [10 20 30 40] 1 2)   ; [20 30]
    """)
  (reference """
    A count, not an end index. A count of 0 returns the empty vec, and the
    whole of v returns v itself. To loop over part of a vec without creating a
    new one, use @code{in-vec}.
    """))

(:doc vec-split
  (summary "Splits a vec into two parts at an index.")
  (arg v "The persistent vector (unmodified).")
  (arg i "Split index, from 0 to length inclusive.")
  (returns "A tuple of the first i elements and the rest.")
  (raises System.IndexOutOfRangeException "When i is negative or greater than the length.")
  (see vec-slice vec-merge)
  (example """
    (def (front back) (vec-split [1 2 3 4 5] 2))   ; [1 2] and [3 4 5]
    """))

(:doc vec-merge
  (summary "Concatenates two vecs into a single vec.")
  (arg a "The first part (unmodified).")
  (arg b "The second part (unmodified).")
  (returns "A new vec with a's elements followed by b's.")
  (see vec-add vec-split vec-compact)
  (reference """
    An RRB concatenation, which joins the two trees rather than copying
    every element. When either vector is empty it returns the other. The result
    may be relaxed; @code{vec-compact} rebuilds it dense.
    """))

(:doc vec-compact
  (summary "Returns a vec with the same elements in a compact, dense tree.")
  (arg v "The persistent vector (unmodified).")
  (returns "A vec equal to v, rebuilt from the front.")
  (see vec-insert vec-merge)
  (reference """
    O(n): every element is added to a new builder. Inserting and merging
    can leave relaxed nodes that make the tree deeper than it needs
    to be; this is for when that has made access slower. A vec small enough
    to have no tree is returned unchanged.
    """))

;; ---------------------------------------------------------------------------
;; Functions over a vec
;; ---------------------------------------------------------------------------

(:doc vec-map
  (summary "Returns a new vec with a function applied to each element.")
  (arg f "Applied to each element, front to back.")
  (arg v "The persistent vector (unmodified).")
  (returns "A new vec of the same length.")
  (see vec-filter vec-for-each vec-fold)
  (reference """
    The synchronous variant traverses the tree and builds a vec of the same shape.
    When @code{f} is suspending, elements are collected using @code{vecing}.
    """))

(:doc vec-filter
  (summary "Returns a new vec keeping only elements that satisfy a predicate.")
  (arg keep? "Predicate evaluated on each element, front to back.")
  (arg v "The persistent vector (unmodified).")
  (returns "A new vec of the elements where keep? returned #t, in order.")
  (see vec-map vec-iter))

(:doc vec-fold
  (summary "Reduces a vec's elements from left to right, starting from an initial value.")
  (arg f "Accumulator function: (f elem acc).")
  (arg init "The initial value before the first element.")
  (arg v "The vec.")
  (returns "The final accumulated value, or init when v is empty.")
  (see vec-reduce vec-for-each)
  (example """
    (vec-fold + 0 [1 2 3])                 ; 6
    (vec-fold cons '() [1 2 3])            ; (3 2 1)
    """))

(:doc vec-reduce
  (summary "Combines a vec's elements from the front, starting from the first.")
  (arg f "Called with an element and the value so far: (f elem acc).")
  (arg v "The vec. Not empty.")
  (returns "The first element combined with each of the others in turn.")
  (see vec-fold)
  (reference """
    @code{f} is first called with the second element and the first. An
    empty vec raises @code{System.InvalidOperationException}.
    """))

(:doc vec-for-each
  (summary "Calls a function on each element of a vec, for its effect.")
  (arg f "Called with each element, front to back.")
  (arg v "The vec.")
  (see vec-for-each/range vec-iter vec-map))

(:doc vec-for-each/range
  (summary "Calls a function on a run of a vec's elements, for its effect.")
  (arg f "Called with each element of the run, front to back.")
  (arg v "The vec.")
  (arg index "The first index visited, from 0.")
  (arg count "How many elements, 0 or more. index plus count is at most the length.")
  (see vec-for-each in-vec)
  (reference """
    The run is checked before f is first called, and one that is not in v
    raises @code{System.ArgumentOutOfRangeException}.
    """))

(:doc vec-iter
  (summary "Calls a function on each element of a vec until it returns #f.")
  (arg f "Called with each element, front to back. Returning #f stops traversal.")
  (arg v "The vec.")
  (returns "#t when f returned #t for every element (or if v is empty); #f when stopped early.")
  (see vec-for-each vec-contains)
  (example """
    (vec-iter (fun (x) (< x 10)) [1 2 30 4])   ; #f, and 4 is never looked at
    """))

;; ---------------------------------------------------------------------------
;; Conversions
;; ---------------------------------------------------------------------------

(:doc vec->list
  (summary "The elements of a vec, as a list.")
  (arg v "The vec.")
  (returns "A list of v's elements, in order.")
  (see list->vec vec->seq)
  (reference """
    Fills a list builder with @code{vec-for-each}, which walks the leaf
    arrays.
    """))

(:doc vec->seq
  (summary "The elements of a vec, as a lazy sequence.")
  (arg v "The vec.")
  (returns "A sequence of v's elements, in order.")
  (see ->vec vec->list)
  (reference """
    Nothing is read until the sequence is walked, and it may be walked more
    than once, since the vec does not change. Each element is read by index.
    """))

(:doc reader->vec
  (summary "Every remaining line of a .NET text reader, as a vec.")
  (arg r "The reader. It is read to the end and not closed.")
  (returns "The lines, without their line terminators.")
  (see vecbuilder-empty)
  (reference """
    Lines as @code{TextReader.ReadLine} splits them, each converted to a
    Bjolang string and added to a builder. The drains in @code{(std ports)}
    are the usual way to read a port into a vec.
    """))

;; ---------------------------------------------------------------------------
;; Vec builders
;; ---------------------------------------------------------------------------

(:doc vecbuilder-empty
  (summary "A new, empty vec builder.")
  (returns "A builder to add to in place and freeze with vecbuilder->vec.")
  (see vecbuilder-add! vecbuilder->vec vec->vecbuilder Vecing)
  (example """
    (def b (vecbuilder-empty))
    (vecbuilder-add! b 1)
    (vecbuilder-add! b 2)
    (vecbuilder->vec b)   ; [1 2]
    """)
  (reference """
    The way to make a vec of many elements without a new vec per element.
    The @code{vecing} collector is one of these under a loop.
    """))

(:doc vecbuilder-empty/small
  (summary "A new, empty vec builder for a vec that is likely small.")
  (returns "A builder to add to in place and freeze with vecbuilder->vec.")
  (see vecbuilder-empty VecingSmall)
  (reference """
    The same as @code{vecbuilder-empty}, except for how it allocates.
    @code{vecbuilder-empty} gives the builder room for 32 elements at the
    first add. This one gives it room for 4, and doubles the room up to 32
    as elements are added. A vec of 4, 8, 16 or 32 elements then takes the
    builder's array with no copy.
    """))

(:doc vec->vecbuilder
  (summary "A builder holding a vec's elements, to go on adding to.")
  (arg v "The vec. Changing the builder does not change it.")
  (returns "A builder starting with v's elements.")
  (see vecbuilder-empty vecbuilder->vec)
  (reference """
    The builder shares v's tree and copies a part before it writes to it.
    """))

(:doc vecbuilder-add!
  (summary "Adds an element to the end of a vec builder, in place.")
  (arg b "The builder.")
  (arg x "The element to add.")
  (see vecbuilder-set! vec-add vecbuilder->vec))

(:doc vecbuilder-set!
  (summary "Replaces the element at an index in a vec builder, in place.")
  (arg b "The builder.")
  (arg i "From 0. Less than the builder's length.")
  (arg x "The new element.")
  (raises System.IndexOutOfRangeException "When i is negative or not less than the length.")
  (see vecbuilder-ref vec-set))

(:doc vecbuilder-ref
  (summary "The element at an index in a vec builder.")
  (arg b "The builder.")
  (arg i "From 0. Less than the builder's length.")
  (returns "The element at i.")
  (see vecbuilder-set! vecbuilder-length vec-ref)
  (reference """
    An index out of range raises @code{System.IndexOutOfRangeException}, as
    @code{vec-ref} does.
    """))

(:doc vecbuilder-length
  (summary "How many elements a vec builder holds.")
  (arg b "The builder.")
  (returns "Its number of elements.")
  (see vecbuilder-ref))

(:doc vecbuilder->vec
  (summary "The vec a builder holds.")
  (arg b "The builder. It may be added to afterwards.")
  (returns "A vec of the builder's elements.")
  (see vecbuilder-empty vec->vecbuilder)
  (reference """
    The builder stays usable: what is added or set in it afterwards does not
    change the previously returned vec.
    """))

;; ---------------------------------------------------------------------------
;; The transient
;; ---------------------------------------------------------------------------

(:doc TransientVec
  (summary "A vec that is changed in place at either end and at any index, and turned back into a vec in O(1).")
  (tparam %a "The element type.")
  (see vec->transientvec transientvec->vec transientvec-add! transientvec-pop!
       transientvec-add-first! transientvec-pop-first! vecbuilder-empty)
  (example """
    (def t (vec->transientvec [1 2 3]))
    (transientvec-add-first! t 0)
    (transientvec-add! t 4)
    (transientvec-pop-first! t)    ; 0
    (transientvec-set! t 0 10)
    (transientvec->vec t)          ; [10 2 3 4]
    """)
  (reference """
    A transient is for many changes in a row to one vec, where each
    persistent @code{vec-add} or @code{vec-pop-first} would copy a part of
    the vec. It holds the vec's head and tail, a leaf's worth at each end, in
    arrays of its own, and adds and removes there in place. Once in a leaf's
    worth of operations at an end, that end runs out or fills, and the
    transient moves a leaf between it and the tree, as a vec does.

    @strong{Sharing.} @code{vec->transientvec} shares the vec's tree, and
    copies a part of it the first time it changes it, so the vec is not
    changed. @code{transientvec->vec} hands what the transient holds to a
    vec in O(1), and the transient copies what it handed over before it
    changes it again. The transient stays usable.

    @strong{Against a builder.} A transient is the same structure as a vec
    builder. A builder is for making a vec by adding at its end; a
    transient for changing one at both ends.

    A transient is not safe to use from two threads at once.

    @strong{Traits.} Implements @code{Collection} and @code{Addable!}, which
    adds at the end.
    """))

(:doc transientvec-empty
  (summary "An empty transient.")
  (returns "A new transient holding nothing.")
  (see vec->transientvec))

(:doc vec->transientvec
  (summary "A transient holding what a vec holds. O(1).")
  (arg v "The vec, which no change to the transient affects.")
  (returns "A new transient.")
  (see transientvec->vec))

(:doc transientvec->vec
  (summary "A vec of what a transient holds. O(1).")
  (arg t "The transient, which may go on being used.")
  (returns "A new vec, which no later change to t affects.")
  (see vec->transientvec))

(:doc transientvec-length
  (summary "How many elements a transient holds. O(1).")
  (arg t "The transient.")
  (returns "The number of elements."))

(:doc transientvec-empty?
  (summary "Whether a transient holds nothing.")
  (arg t "The transient.")
  (returns "#t when it is empty."))

(:doc transientvec-ref
  (summary "The element at an index.")
  (arg t "The transient.")
  (arg i "The index, from 0.")
  (returns "The element.")
  (raises System.IndexOutOfRangeException "When i is negative or not less than the length.")
  (see transientvec-set!))

(:doc transientvec-set!
  (summary "Replaces the element at an index, in place.")
  (arg t "The transient.")
  (arg i "The index, from 0.")
  (arg x "The new element.")
  (raises System.IndexOutOfRangeException "When i is negative or not less than the length.")
  (see transientvec-ref))

(:doc transientvec-add!
  (summary "Adds an element at the end, in place.")
  (arg t "The transient.")
  (arg x "The element.")
  (see transientvec-add-all! transientvec-add-first! transientvec-pop!))

(:doc transientvec-add-all!
  (summary "Adds the elements of a sequence at the end, in order, in place.")
  (arg t "The transient.")
  (arg xs "The elements.")
  (see transientvec-add!))

(:doc transientvec-add-first!
  (summary "Adds an element before the first, in place.")
  (arg t "The transient.")
  (arg x "The element.")
  (see transientvec-pop-first! transientvec-add!))

(:doc transientvec-pop!
  (summary "Removes the last element, in place, and answers it.")
  (arg t "The transient.")
  (returns "The element that was last.")
  (raises System.InvalidOperationException "When the transient is empty.")
  (see transientvec-add! transientvec-pop-first!))

(:doc transientvec-pop-first!
  (summary "Removes the first element, in place, and answers it.")
  (arg t "The transient.")
  (returns "The element that was first.")
  (raises System.InvalidOperationException "When the transient is empty.")
  (see transientvec-add-first! transientvec-pop!)
  (example """
    ;; A queue: add at the end, take from the front.
    (def q (transientvec-empty))
    (transientvec-add! q "a")
    (transientvec-add! q "b")
    (transientvec-pop-first! q)    ; "a"
    """))

;; ---------------------------------------------------------------------------
;; Collecting into a vec
;; ---------------------------------------------------------------------------

(:doc Vecing
  (summary "The collector that gathers a loop's values into a vec.")
  (tparam %a "The element type.")
  (case vecing "The collector itself, written (vecing x) in an :acc clause.")
  (see Collector vecbuilder-empty)
  (example """
    (loop (:for x '(1 2 3))
          (:acc v (vecing (* x x))))   ; [1 4 9]
    """)
  (reference """
    Its accumulator is a @code{VecBuilder}: each value is added in place,
    and the builder is frozen into a vec when the loop ends.
    """))

(:doc VecingSmall
  (summary "The collector that gathers a loop's values into a vec that is likely small.")
  (tparam %a "The element type.")
  (case vecing/small "The collector itself, written (vecing/small x) in an :acc clause.")
  (see Vecing vecbuilder-empty/small)
  (example """
    (loop (:for x '(1 2 3))
          (:acc v (vecing/small (* x x))))   ; [1 4 9]
    """)
  (reference """
    Gives the same vec as @code{vecing}. Its builder is one from
    @code{vecbuilder-empty/small}, which makes a vec of a few elements with
    less allocation and copying. For a vec of many elements it is a little
    slower than @code{vecing}.
    """))

;; ---------------------------------------------------------------------------
;; Vec cursors
;; ---------------------------------------------------------------------------

(:doc vec-cursor
  (summary "A cursor on the first element of a vec, for walking it front to back.")
  (arg v "The vec.")
  (returns "A cursor on the first element, or a finished cursor for an empty vec.")
  (see vec-cursor-done? vec-cursor-current vec-cursor-next vec-cursor-slice)
  (reference """
    What @code{Vec}'s @code{Iterable} implementation walks with. The cursor
    is a value that walks the vec's leaf arrays: an array read per element,
    a lookup per leaf of 32 elements, and nothing allocated. A vec of up to
    32 elements is one array.

    @code{vec-cursor-done?} and @code{vec-cursor-current} only read a
    cursor, and @code{vec-cursor-next} answers the cursor one element on.
    """))

(:doc vec-cursor-slice
  (summary "A cursor for walking a run of a vec's elements front to back.")
  (arg v "The vec.")
  (arg from "The first index walked, from 0.")
  (arg count "How many elements. from plus count is at most the length.")
  (returns "A cursor on the first element of the run, or a finished cursor for an empty run.")
  (raises System.ArgumentOutOfRangeException "When the run is not in v.")
  (see vec-cursor in-vec)
  (reference """
    What @code{VecSlice}'s @code{Iterable} implementation walks with, and so
    what @code{in-vec} walks with. The cursor is the one @code{vec-cursor}
    makes, so it is read and moved on with the same functions.
    """))

(:doc vec-cursor-done?
  (summary "Whether a vec cursor has walked past the last element.")
  (arg c "The cursor.")
  (returns "#t when the walk is over; #f when the cursor is on an element.")
  (see vec-cursor vec-cursor-current vec-cursor-next))

(:doc vec-cursor-current
  (summary "The element a vec cursor is on.")
  (arg c "The cursor, when vec-cursor-done? says #f.")
  (returns "The element.")
  (see vec-cursor vec-cursor-done? vec-cursor-next))

(:doc vec-cursor-next
  (summary "The cursor one element further on.")
  (arg c "The cursor, when vec-cursor-done? says #f.")
  (returns "A cursor on the next element, or a finished cursor after the last.")
  (see vec-cursor vec-cursor-done? vec-cursor-current)
  (reference """
    The cursor given does not change, so it still reads the element it was
    on.
    """))

(:doc VecBackCursor
  (summary "A cursor walking part of a vec backwards.")
  (tparam %a "The element type.")
  (see vec-back-cursor ReverseVecSlice vec-cursor)
  (reference """
    A value that walks the vec's leaf arrays from the end, as
    @code{vec-cursor} walks them from the start: nothing is allocated for a
    walk.
    """))

(:doc vec-back-cursor
  (summary "A cursor for walking a run of a vec's elements backwards.")
  (arg v "The vec.")
  (arg last "The first index walked, the highest of the run. -1 with a count of 0 is the empty run.")
  (arg count "How many elements, going down from last. last minus count is at least -1.")
  (returns "A cursor on the first element of the run, or a finished cursor for an empty run.")
  (raises System.ArgumentOutOfRangeException "When the run is not in v.")
  (see vec-back-cursor-done? vec-back-cursor-current vec-back-cursor-next in-reverse-vec)
  (reference """
    What @code{ReverseVecSlice}'s @code{Iterable} implementation calls, and
    so what @code{in-reverse-vec} walks with; it is exported because that
    implementation's body names it.
    """))

(:doc vec-back-cursor-done?
  (summary "Whether a backward vec cursor has walked past the lowest element of its run.")
  (arg c "The cursor.")
  (returns "#t when the run is over; #f when the cursor is on an element.")
  (see vec-back-cursor vec-back-cursor-current vec-back-cursor-next))

(:doc vec-back-cursor-current
  (summary "The element a backward vec cursor is on.")
  (arg c "The cursor, when vec-back-cursor-done? says #f.")
  (returns "The element.")
  (see vec-back-cursor vec-back-cursor-done? vec-back-cursor-next))

(:doc vec-back-cursor-next
  (summary "The backward cursor one element further on, which is one index lower.")
  (arg c "The cursor, when vec-back-cursor-done? says #f.")
  (returns "A cursor on the next element, or a finished cursor after the last.")
  (see vec-back-cursor vec-back-cursor-done? vec-back-cursor-current))

;; ---------------------------------------------------------------------------
;; Walking part of a vec
;; ---------------------------------------------------------------------------

(:doc in-vec
  (summary "Part of a vec, to walk front to back in a loop.")
  (arg v "The vec.")
  (key #:from "The first index walked, included.")
  (key #:to "The index the walk stops before, not included.")
  (returns "A slice that a (:for ...) clause walks.")
  (see in-reverse-vec VecSlice vec-slice)
  (example """
    (loop (:for x (in-vec v #:from 1 #:to 4))   ; elements 1, 2 and 3
          (:do (displayln x)))
    """)
  (reference """
    Makes no new vec: the slice is a small value holding v and the bounds,
    and the walk goes through the leaf arrays rather than calling
    @code{vec-ref} per index, so part of a vec costs what the whole costs
    per element.

    The bounds are checked once, when the slice is made. When
    @code{#:from} is negative, @code{#:to} is past the length or
    @code{#:from} is past @code{#:to}, it panics with a message naming the
    bounds.
    """))

(:doc in-reverse-vec
  (summary "Part of a vec, to walk back to front in a loop.")
  (arg v "The vec.")
  (key #:from "The lowest index walked, included; the last one visited.")
  (key #:to "The index above the first one visited, not included.")
  (returns "A slice that a (:for ...) clause walks.")
  (see in-vec ReverseVecSlice)
  (example """
    (loop (:for x (in-reverse-vec v #:from 2 #:to 5))   ; elements 4, 3 and 2
          (:do (displayln x)))
    """)
  (reference """
    The same slice @code{in-vec} takes with the same bounds, walked the
    other way. The bounds are checked as @code{in-vec} checks them.
    """))

(:doc VecSlice
  (summary "A run of a vec, which a loop walks front to back.")
  (tparam %a "The element type.")
  (field items "The vec.")
  (field from "The first index walked.")
  (field count "How many elements are walked.")
  (see in-vec vec-cursor-slice)
  (reference """
    Made by @code{in-vec}, which checks the bounds. A value, and so is its
    cursor, so a loop over one allocates nothing.
    """))

(:doc ReverseVecSlice
  (summary "A run of a vec, which a loop walks back to front.")
  (tparam %a "The element type.")
  (field items "The vec.")
  (field last "The first index walked, the highest of the run; -1 for an empty run.")
  (field count "How many elements are walked.")
  (see in-reverse-vec VecBackCursor)
  (reference """
    Made by @code{in-reverse-vec}, which checks the bounds.
    """))

;; ---------------------------------------------------------------------------
;; Arrays
;; ---------------------------------------------------------------------------

(:doc make-array
  (summary "A new .NET array of a length.")
  (arg n "The length.")
  (returns "An array of n elements, each .NET's default for the type: zero for a number.")
  (see array-ref array-set! array-resize))

(:doc array-ref
  (summary "The element of an array at an index.")
  (arg a "The array.")
  (arg i "From 0. Less than the length.")
  (returns "The element at i.")
  (see array-set! array-length vec-ref)
  (reference """
    @code{a[i]}, with .NET's bounds check.
    """))

(:doc array-set!
  (summary "Replaces the element of an array at an index, in place.")
  (arg a "The array, which is changed.")
  (arg i "From 0. Less than the length.")
  (arg x "The new element.")
  (see array-ref)
  (reference """
    @code{a[i] = x}, with .NET's bounds check.
    """))

(:doc array-length
  (summary "How many elements an array has.")
  (arg a "The array.")
  (returns "Its length.")
  (see make-array))

(:doc array-resize
  (summary "A new array of another length, holding as much of an array as fits.")
  (arg a "The array, which is left as it was.")
  (arg n "The new length. Larger grows, smaller shrinks.")
  (returns "A new array of n elements: a's first ones, then .NET's default for the type.")
  (see make-array)
  (reference """
    What a growable array is written over: @code{make-array}, and this when
    it fills up. It always copies, so the old array is not the new one.
    """))

(:doc array->vec
  (summary "A vec of an array's elements.")
  (arg a "The array, which is copied: changing it afterwards does not change the vec.")
  (returns "A vec of a's elements, in order.")
  (see subarray->vec vecbuilder-empty)
  (reference """
    The elements go straight into the tree's leaves in one walk, with no
    add per element, so an array is the cheapest thing to build a vec out
    of. It suits making a great many small vecs, where a builder is sized
    for large ones.
    """))

(:doc subarray->vec
  (summary "A vec of a run of an array's elements.")
  (arg a "The array, which is copied.")
  (arg start "The first index taken, from 0.")
  (arg count "How many elements. start plus count is at most the length.")
  (returns "A vec of count elements, a's from start on.")
  (see array->vec vec-slice)
  (reference """
    Start and count, as @code{vec-slice} takes them.
    """))

(:doc in-array
  (summary "Part of an array, to walk front to back in a loop.")
  (arg arr "The array.")
  (key #:from "The first index walked, included.")
  (key #:to "The index the walk stops before, not included.")
  (returns "A slice that a (:for ...) clause walks.")
  (see in-reverse-array ArraySlice in-vec)
  (example """
    (loop (:for x (in-array a #:from 2))   ; from element 2 to the end
          (:do (displayln x)))
    """)
  (reference """
    The slice is a small value holding the array and the bounds, and the
    walk is an @code{int} index and @code{array-ref}. The bounds are checked
    once, when the slice is made. When @code{#:from} is negative,
    @code{#:to} is past the length or @code{#:from} is past @code{#:to}, it
    panics with a message naming the bounds.
    """))

(:doc in-reverse-array
  (summary "Part of an array, to walk back to front in a loop.")
  (arg arr "The array.")
  (key #:from "The lowest index walked, included; the last one visited.")
  (key #:to "The index above the first one visited, not included.")
  (returns "A slice that a (:for ...) clause walks.")
  (see in-array ReverseArraySlice)
  (example """
    (loop (:for x (in-reverse-array a #:from 2 #:to 5))   ; elements 4, 3 and 2
          (:do (displayln x)))
    """)
  (reference """
    The same slice @code{in-array} takes with the same bounds, walked the
    other way. The bounds are checked as @code{in-array} checks them.
    """))

(:doc ArraySlice
  (summary "A run of an array, which a loop walks front to back.")
  (tparam %a "The element type.")
  (field items "The array.")
  (field from "The first index walked.")
  (field to "The index the walk stops before.")
  (see in-array)
  (reference """
    Made by @code{in-array}, which checks the bounds. Its cursor is an
    @code{int}.
    """))

(:doc ReverseArraySlice
  (summary "A run of an array, which a loop walks back to front.")
  (tparam %a "The element type.")
  (field items "The array.")
  (field from "The lowest index walked, the last visited.")
  (field to "The index above the first one visited.")
  (see in-reverse-array)
  (reference """
    Made by @code{in-reverse-array}, which checks the bounds. Its cursor is
    an @code{int}, starting at @code{to} minus 1.
    """))

;; ---------------------------------------------------------------------------
;; Taking, dropping and reversing
;; ---------------------------------------------------------------------------

(:doc vec-take
  (summary "The first n elements of a vec.")
  (arg v "The vec, which is left as it was.")
  (arg n "How many elements, 0 or more.")
  (returns "A vec of the first n elements; all of v when it has fewer.")
  (see vec-drop vec-slice)
  (example """
    (vec-take [1 2 3 4] 2)    ; [1 2]
    (vec-take [1 2] 10)       ; [1 2]
    """)
  (reference "@code{vec-slice} from 0. A negative n is refused with a panic."))

(:doc vec-drop
  (summary "A vec without its first n elements.")
  (arg v "The vec, which is left as it was.")
  (arg n "How many elements, 0 or more.")
  (returns "A vec of the elements after the first n; the empty vec when v has n or fewer.")
  (see vec-take vec-slice)
  (example """
    (vec-drop [1 2 3 4] 1)    ; [2 3 4]
    """)
  (reference "@code{vec-slice} from n. A negative n is refused with a panic."))

(:doc vec-reverse
  (summary "A vec in the reverse order.")
  (arg v "The vec, which is left as it was.")
  (returns "A new vec of the same elements, last first.")
  (see in-reverse-vec)
  (example """
    (vec-reverse [1 2 3])     ; [3 2 1]
    """)
  (reference "Walks v backwards once. To only walk it backwards, @code{in-reverse-vec} makes no new vec."))

(:doc vec->array
  (summary "The elements of a vec in a new array.")
  (arg v "The vec, which is left as it was.")
  (returns "An array of the elements, in order, which v does not share.")
  (see array->vec subarray->vec)
  (example """
    (array-length (vec->array [1 2 3]))   ; 3
    """))

;; ---------------------------------------------------------------------------
;; The immutable array
;; ---------------------------------------------------------------------------

(:doc IArray
  (summary "An array that is not written after it is made: built once, then read.")
  (tparam %a "The element type.")
  (see vec->iarray subarray->iarray iarray-ref iarray-length iarray-add iarray-set)
  (example """
    (def xs (vec->iarray [1 2 3]))
    (ref xs 1)                  ; 2
    (length xs)                 ; 3
    (iarray->vec (iarray-set xs 0 10))   ; [10 2 3], xs is unchanged
    (= xs (list->iarray '(1 2 3)))       ; #t
    """)
  (reference """
    A struct around .NET's @code{ImmutableArray<T>}, which holds one array.
    Indexing is an array read, a walk reads the array in order, and the
    value is one reference wide, where a vec is an object of its own. Every
    change copies the whole array, so @code{iarray-add} in a loop is
    quadratic: build in a @code{MutableVec} and convert once with
    @code{mutablevec->iarray}. A value that changes after it is made is a
    @code{Vec}.

    @strong{Equality.} Two arrays are equal when they hold equal elements
    in the same order, also to .NET: an @code{IArray} is a good key in a
    @code{Map} or a @code{HashSet}.

    @strong{The default value.} A field or an array slot of this type that
    is not written yet holds no array. Every function reads it as the
    empty array.

    @strong{Traits.} Implements @code{Refable}, @code{Collection},
    @code{Iterable} (an int cursor, as @code{Array} has), @code{Eq},
    @code{Written} and @code{Displayed}, which write @code{#iarray[1 2 3]}.
    There is no literal and no pattern.
    """))

(:doc iarray-empty
  (summary "An empty immutable array.")
  (returns "An IArray with no elements.")
  (see iarray-empty?))

(:doc iarray-length
  (summary "How many elements an immutable array has.")
  (arg xs "The array.")
  (returns "Its number of elements. O(1).")
  (see iarray-empty?))

(:doc iarray-empty?
  (summary "Whether an immutable array has no elements.")
  (arg xs "The array.")
  (returns "#t when its length is 0.")
  (see iarray-length))

(:doc iarray-ref
  (summary "The element of an immutable array at an index.")
  (arg xs "The array.")
  (arg i "Zero-based index (0 <= i < length).")
  (returns "The element at i. An array read.")
  (raises System.IndexOutOfRangeException "When i is negative or not less than the length.")
  (see iarray-try-ref ref))

(:doc iarray-try-ref
  (summary "The element at an index, or None if the index is out of bounds.")
  (arg xs "The array.")
  (arg i "Zero-based index.")
  (returns "(Some x) if index i is valid, otherwise None.")
  (see iarray-ref try-ref))

(:doc iarray-set
  (summary "A copy of an immutable array with the element at an index replaced.")
  (arg xs "The array, which is left as it was.")
  (arg i "Zero-based index (0 <= i < length).")
  (arg x "The new element.")
  (returns "A new array with x at i. O(n): the whole array is copied.")
  (raises System.ArgumentOutOfRangeException "When i is negative or not less than the length.")
  (see iarray-add vec-set))

(:doc iarray-add
  (summary "A copy of an immutable array with one element added at the end.")
  (arg xs "The array, which is left as it was.")
  (arg x "The element to add.")
  (returns "A new array, one longer, with x last. O(n): the whole array is copied.")
  (see iarray-set vec-add)
  (reference """
    To build an array element by element, add to a @code{MutableVec} from
    @code{(std mutable vec)} and convert it once with
    @code{mutablevec->iarray}, or fill an array and use
    @code{subarray->iarray}.
    """))

(:doc iarray-map
  (summary "An immutable array of the results of a function on each element.")
  (arg f "The function, called on each element in order.")
  (arg xs "The array.")
  (returns "A new array of the same length.")
  (see vec-map))

(:doc subarray->iarray
  (summary "An immutable array of part of an array.")
  (arg a "The array, which the result does not share and which can be written again.")
  (arg start "The first index taken, from 0.")
  (arg count "How many elements are taken.")
  (returns "An IArray of a[start, start + count).")
  (raises System.ArgumentOutOfRangeException "When the range is not inside the array.")
  (see array->iarray subarray->vec)
  (reference """
    What a reader that collects elements on a stack uses: the stack is
    written again after the elements are copied out.
    """))

(:doc array->iarray
  (summary "An immutable array of the elements of an array.")
  (arg a "The array, which the result does not share.")
  (returns "An IArray of the same elements.")
  (see subarray->iarray iarray->array))

(:doc iarray->array
  (summary "The elements of an immutable array in a new array.")
  (arg xs "The immutable array.")
  (returns "A new array, which the caller can write.")
  (see array->iarray))

(:doc seq->iarray
  (summary "An immutable array of the elements of a sequence.")
  (arg s "The sequence, walked once.")
  (returns "An IArray of its elements, in order.")
  (see iarray->seq vec->iarray))

(:doc iarray->seq
  (summary "The elements of an immutable array as a sequence.")
  (arg xs "The array.")
  (returns "A sequence that walks xs in order.")
  (see seq->iarray))

(:doc vec->iarray
  (summary "An immutable array of the elements of a vec.")
  (arg v "The vec.")
  (returns "An IArray of its elements, in order.")
  (see iarray->vec list->iarray))

(:doc iarray->vec
  (summary "A vec of the elements of an immutable array.")
  (arg xs "The array.")
  (returns "A vec of its elements, in order.")
  (see vec->iarray iarray->list))

(:doc list->iarray
  (summary "An immutable array of the elements of a list.")
  (arg xs "The list.")
  (returns "An IArray of its elements, in order.")
  (see iarray->list vec->iarray))

(:doc iarray->list
  (summary "A list of the elements of an immutable array.")
  (arg xs "The array.")
  (returns "A list of its elements, in order.")
  (see list->iarray iarray->vec))
