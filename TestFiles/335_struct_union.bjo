(import (std prelude))
(import (std simpletest))
(import (std hashset))
(import (std orderedset))
(import (std mutable map))
(import "inc/struct_union_kinds.bjo")

;; A union that fits in 16 bytes, tag included, is a struct at run time. These
;; are the places a struct could go wrong: slots that cases share, equality,
;; hashing, ordering, printing, the collections, matches, a constructor used as
;; a function, and a union from another module.

;; `I`, `F` and `C` share one 8-byte slot; `B` has a slot of its own.
(type/derive (Eq Ord) (: Val (Union (: I long) (: F double) (: B bool) (: C long) Missing)))

;; Every case carries nothing: a struct of one byte.
(type/derive (Eq Ord) (: Dir (Union North East South West)))

;; A reference slot that holds an object of a class union, which can be `null`.
(type-rec (: Tree (Union Empty (: Node Tree Tree))))
(type (: Holder (Union (: Holds Tree) (: Named Symbol) Nothing)))

(: num (-> Val double))
(defun (num v)
  (match v
    ((I n) (cast double n))
    ((F d) d)
    ((B b) (if b 1.0 0.0))
    ((C n) (cast double (* n 10)))
    (Missing 0.0)))

(: turn (-> Dir Dir))
(defun (turn d)
  (match d
    (North East)
    (East South)
    (South West)
    (West North)))

(: depth (-> Holder int))
(defun (depth h)
  (match h
    ((Holds Empty) 0)
    ((Holds (Node _ _)) 1)
    ((Named _) -1)
    (Nothing -2)))

(defun (main args)
  (expect "a shared slot, as a long" (num (I 3)) 3.0)
  (expect "a shared slot, as a double" (num (F 2.5)) 2.5)
  (expect "a shared slot, as another long" (num (C 4)) 40.0)
  (expect "a slot of its own" (num (B #t)) 1.0)
  (expect "a case with nothing" (num Missing) 0.0)
  (expect-true "equal values" (= (F 2.5) (F 2.5)))
  (expect-true "two cases with the same bits differ" (not (= (I 7) (C 7))))
  (expect-true "zero and negative zero are equal, as doubles are" (= (F 0.0) (F -0.0)))
  (expect "equal values hash the same" (eq-hash (F 0.0)) (eq-hash (F -0.0)))
  (expect "printing" (->str (list (I 1) (B #f) Missing))
          "(_335_struct_union__I { Item1 = 1 } _335_struct_union__B { Item1 = False } Missing)")
  (expect "the derived order is the declared order"
          (list-sort (list Missing (C 1) (F 2.0) (I 5) (I 2)))
          (list (I 2) (I 5) (F 2.0) (C 1) Missing))
  (expect "a hash set" (hashset-length (list->hashset (list (I 1) (C 1) (I 1) Missing Missing))) 3)
  (expect "an ordered set" (orderedset->list (list->orderedset (list West North West)))
          (list North West))

  (def m (mutablemap))
  (mutablemap-set! m North 1)
  (mutablemap-set! m (turn West) 2)
  (expect "a mutable map key" (mutablemap-ref m North) 2)
  (expect "a mutable map length" (mutablemap-length m) 1)

  (expect "a constructor as a function" (list-map num (list-map I (list 1 2)))
          (list 1.0 2.0))
  (expect "a nested pattern on a null case" (depth (Holds Empty)) 0)
  (expect "a nested pattern on a data case" (depth (Holds (Node Empty Empty))) 1)
  (expect "a class in the reference slot" (depth (Named 'x)) -1)
  (expect "a struct union in a vec" (vec-length [(I 1) Missing (F 1.5)]) 3)

  ;; A union from another module.
  (expect "an imported struct union" (points (Merit 2 3)) 5)
  (expect "its order" (list-sort (list Fail (Merit 1 1) (Pass 9))) (list (Pass 9) (Merit 1 1) Fail))
  (expect-true "its equality" (= (Count "a" 2) (Count "a" 2)))
  (expect "its printing" (->str (Text "hi")) "struct_union_kinds__Text { Item1 = hi }")
  0)
