;; EXPECT-ERROR: has no implementations to write
;;
;; The runtime decides whether a type implements an interface, so an `impl`
;; would be a second answer to a question already answered.
(import (std prelude))

(def/trait (Num %a)
  (#:clr-constraint (System.Numerics.INumber %a)))

(impl (Num int))

(defun (main) 0)
