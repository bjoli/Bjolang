;; (std stream): loops over values that work which suspends produces.
;;
;; - A `Stream` is a recipe for a producer: a bjoroutine handed an `Emitter`.
;;   Holding one runs nothing. Each loop over it starts the producer in a
;;   fiber of its own, receives what it emits, and stops it when the loop
;;   ends, however the loop ends.
;; - `in-chan` reads a channel that something else fills, until an end event.
;;   The loop does not own the producer, and leaving early does not stop it.
;;
;; Both are drivers: `(:for x s)`. A loop in a bjoroutine suspends at each
;; receive. Anywhere else the receive parks the thread.
(import (std prelude))
(import (std syntax-match))

(:doc #:file "stream.bjodoc")

(export Stream Emitter StreamRun ChanReads Item make-stream emit! in-chan)

;; What the producer's wrapper sends: a value, the end, or what the
;; producer raised.
(type (: (Item %a) (Union (: Next %a)
                          Done
                          (: Failed Exception))))

;; Where a producer sends its values, and receives the loop's requests for
;; the next one.
(type (: (Emitter %a) #:opaque
         (Struct (: chan (Chan (Item %a)))
                 (: demand (Chan Unit)))))

;; The producer's body. Each loop runs it afresh.
(type (: (Stream %a) #:opaque (Struct (: body (-bjo-> (Emitter %a) void)))))

;; A loop's cursor over a stream: the running producer's channels, the cancel
;; thunk that stops it, its promise, and the item the loop is at.
(type (: (StreamRun %a)
         #:opaque
         (Record (: chan (Chan (Item %a)))
                 (: demand (Chan Unit))
                 (: stop (-> CancelReason void))
                 (: producer (Promise Unit))
                 (: item (Item %a) #:mutable))))

;; A channel read until `end` commits.
(type (: (ChanReads %a %e) #:opaque
         (Struct (: chan (Chan %a))
                 (: end (Event %e)))))

;; A stream whose producer is `body`.
(: (-> (-bjo-> (Emitter %a) void) (Stream %a)))
(defun (make-stream body)
  (Stream (body body)))

;; Sends `v` to the loop, then waits until the loop asks for the next value.
;;
;; - The producer computes nothing the loop has not asked for.
;; - Raises `Cancelled` when the loop has ended, so the producer unwinds and
;;   its own releases run.
(: (-> (Emitter %a) %a void) #:inline)
(defbjo (emit! out v)
  (sync (chan-send (.chan out) (Next v)))
  (sync (chan-recv (.demand out))))

;; The two halves of a receive: a bjoroutine's loop suspends, any other code
;; parks the thread.
(: (-> (Chan %a) %a))
(defbjouble (chan-take c)
  (#:sync (sync/blocking (chan-recv c)))
  (#:bjo (sync (chan-recv c))))

;; Asks the producer for its next item, and receives it.
(: (-> (Chan Unit) (Chan %a) %a))
(defbjouble (chan-ask demand c)
  (#:sync (sync/blocking (chan-send demand unit)) (sync/blocking (chan-recv c)))
  (#:bjo (sync (chan-send demand unit)) (sync (chan-recv c))))

(: (-> (Chan %a) (Event %e) (Option %a)))
(defbjouble (chan-take-until c end)
  (#:sync (sync/blocking (choose (wrap (chan-recv c) (fun (x) (Some x))) (wrap end (fun (_) None)))))
  (#:bjo (sync (choose (wrap (chan-recv c) (fun (x) (Some x))) (wrap end (fun (_) None))))))

;; Runs the producer's body, then sends the end: `Done`, or `Failed` with what
;; the body raised. A body that was cancelled sends nothing: the loop is gone.
;;
;; - The loop asked for the first item by starting the producer, and for each
;;   later one through `demand`, so the end is always asked for.
(: (-> (-bjo-> (Emitter %a) void) (Chan (Item %a)) (Chan Unit) CancelToken void))
(defbjo (run-producer body out demand token)
  (match (try (body (Emitter (chan out) (demand demand))) #:catch (System.Exception))
    ((Ok _) (sync (chan-send out Done)))
    ((Err e)
     (if (cancelled? token)
         (raise e)
         (sync (chan-send out (Failed e)))))))

;; Stores an item in the cursor. A `Failed` is raised here, in the loop.
(: (-> (StreamRun %a) (Item %a) (StreamRun %a)))
(defun (stream-set! run item)
  (match item
    ((Failed e) (raise e))
    (_
     (record-set! run (item item))
     run)))

;; The longest time the end of a loop waits for its producer to unwind.
(def producer-grace (seconds 5))

;; Waits until `p` lands or `d` has passed, whichever is first.
(: (-> (Promise %a) Duration void))
(defbjouble (await-within p d)
  (#:sync (ignore (sync/blocking (choose (wrap (promise-join p) (fun (_) unit)) (timeout d)))))
  (#:bjo (ignore (sync (choose (wrap (promise-join p) (fun (_) unit)) (timeout d))))))

;; Stops the producer, and waits until it has unwound.
;;
;; - After this returns, the producer's releases have run, unless it took
;;   longer than `producer-grace` to unwind.
;; - The wait runs in a shield, so it also works when the loop is left
;;   because its scope was cancelled.
;; - Does not raise when the grace passes. The producer then goes on
;;   unwinding, and the enclosing scope waits for it.
(: (-> (StreamRun %a) CancelReason void))
(defun (stop-producer run reason)
  ((.stop run) reason)
  ;; The shield's deadline is longer than `producer-grace`, so the timeout
  ;; always commits first and the shield never raises `Cancelled`.
  (with-shield
    #:within (seconds 6)
    (await-within (.producer run) producer-grace)))

;; A stream as a driver.
;;
;; - `iterable-start` starts the producer under a cancel token of its own,
;;   linked to the ambient one, and receives the first item.
;; - `iterable-next` asks for the next item, and receives it.
;; - `iterable-end` and `iterable-cleanup` stop it and wait until it has
;;   unwound: at a `:finish`, an `:abandon`, a driver beside it that ran out,
;;   an exception or a `ret`. See `stop-producer`.
(impl (Iterable (Stream %a))
  (type %elem %a)
  (type %cursor (StreamRun %a))
  (defun (iterable-start s)
    (def (Tuple stop token) (make-cancel))
    (link-cancel (parameter-ref current-cancel) token)
    (def c (make-chan))
    (def demand (make-chan))
    (def producer
      (parameterize ((current-cancel token))
        (bjo (run-producer (.body s) c demand token))))
    (stream-set! (StreamRun (chan c) (demand demand) (stop stop) (producer producer) (item Done))
                 (chan-take c)))
  (defun (iterable-done? s run)
    (match (.item run)
      (Done #t)
      (_ #f)))
  (defun (iterable-current s run)
    (match (.item run)
      ((Next x) x)
      (_ (panic! "iterable-current of a stream that has ended"))))
  (defun (iterable-next s run)
    (stream-set! run (chan-ask (.demand run) (.chan run))))
  (defun (iterable-end s run)
    (stop-producer run (Requested "the loop over the stream ended")))
  (defun (iterable-cleanup s run)
    (stop-producer run (Requested "the loop over the stream was left"))))

;; The values received on `c` until `end` commits.
(: (-> (Chan %a) (Event %e) (ChanReads %a %e)))
(defun (in-chan c end)
  (ChanReads (chan c) (end end)))

(impl (Iterable (ChanReads %a %e))
  (type %elem %a)
  (type %cursor (Option %a))
  (defun (iterable-start s)
    (chan-take-until (.chan s) (.end s)))
  (defun (iterable-done? s c)
    (none? c))
  (defun (iterable-current s c)
    (option-ref c))
  (defun (iterable-next s c)
    (chan-take-until (.chan s) (.end s))))

;; `{streaming expr clause ...}`: a stream of `expr` for each round of a loop
;; of the clauses. The loop runs in the producer, so its clauses may suspend.
;;
;; - A loose `:when` arrives as a last `(:when ...)` clause.
(def/macro (streaming form inject compare)
  (syntax-match form
    ((_ expr clause ...) #'(make-stream (bjoroutine (out) (loop ,@clause (:do (emit! out ,expr))))))
    (bad
     (syntax-error
      bad
      "streaming takes an expression and loop clauses: {streaming (* x x) (:for x xs)}"))))
