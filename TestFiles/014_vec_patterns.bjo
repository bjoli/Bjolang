;; Vec patterns: bracket form [a b c ...] and (Vec a b c ...), with rest args.

(import (std prelude))
(import (std simpletest))

;; Fixed-length bracket patterns, including the empty vec.
(: describe (-> (Vec int) string))
(defun (describe v)
  (match v
    ([] "empty")
    ([a] "one")
    ([a b] "two")
    (_ "many")))

;; Rest arg bound to a Vec, consumed recursively.
(: sum-rest (-> (Vec int) int))
(defun (sum-rest v)
  (match v
    ([a rest ...] (+ a (sum-rest rest)))
    (_ 0)))

;; Literal elements and a wildcard rest.
(: starts-zero (-> (Vec int) string))
(defun (starts-zero v)
  (match v
    ([0 _ ...] "starts-with-zero")
    ([a _ ...] "nonempty")
    (_ "empty")))

;; The (Vec ...) spelling, and a rest arg used as a real Vec value.
(: rest-count (-> (Vec int) int))
(defun (rest-count v)
  (match v
    ((Vec a b rest ...) (vec-length rest))
    (_ (- 0 1))))

;; Nested vec patterns.
(: nested (-> (Vec (Vec int)) int))
(defun (nested v)
  (match v
    ([[a b] _ ...] (+ a b))
    (_ 0)))

(defun (main args)
  (expect "empty bracket pattern" (describe []) "empty")
  (expect "one-element bracket pattern" (describe [7]) "one")
  (expect "two-element bracket pattern" (describe [7 8]) "two")
  (expect "longer vec falls to the catch-all" (describe [7 8 9]) "many")
  (expect "rest arg consumed recursively" (sum-rest [1 2 3 4]) 10)
  (expect "no leading element to be zero" (starts-zero []) "empty")
  (expect "literal element in a vec pattern" (starts-zero [0 9]) "starts-with-zero")
  (expect "literal element that does not match" (starts-zero [5 9]) "nonempty")
  (expect "rest arg is a Vec of the remaining elements" (rest-count [1 2 3 4 5]) 3)
  (expect "nested vec pattern" (nested [[3 4] [5 6]]) 7)
  0)
