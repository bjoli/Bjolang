;; Arms written straight after the scrutinee, without `:leave`. A list of lists
;; whose heads read as patterns is answered with the missing keyword rather
;; than with a type error about a call.

;; EXPECT-ERROR: arms follow :leave without a list around them

(import (std prelude))

(: f (-> (Result string int) string))
(defun (f r)
  (def (Ok n) r (((Err e) e)))
  (int->string n))
