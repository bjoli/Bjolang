;; `reader-read-char!`, the blocking char read.
;;
;; A Bjolang char is a Unicode scalar and a port is UTF-8 bytes, so a read
;; decodes one, two, three or four bytes into one character. What is pinned
;; here is that a character comes back whole, that bytes that are not UTF-8
;; read as U+FFFD rather than as half of something, and that the one way left
;; to stand inside a character — a .NET `Read` on the port, which hands out
;; UTF-16 units — is refused by name.

(import (std prelude))
(import (std ports))
(import (std simpletest))

(import/class
  (MemStream (: System.IO.MemoryStream (-> (Array byte) MemStream))))

;; A port over exactly these bytes.
(: bytes-port (-> (Array byte) InputPort))
(defun (bytes-port bytes)
  (stream->input-port (cast Stream (MemStream. bytes))))

(: first-char-in (-> InputPort string))
(defun (first-char-in p)
  (match (try (reader-read-char! p) #:catch (System.Exception))
    ((Ok c) (str "read " (int->string (char->integer c))))
    ((Err e) (.-Message e))))

(: first-char (-> string string))
(defun (first-char s) (first-char-in (open-input-string s)))

;; U+1F600, four bytes of UTF-8.
(: emoji string)
(def emoji (list->string (list (integer->char 128512))))

(defun (main)
  ;; --- what it reads -------------------------------------------------------
  (expect "an ASCII character" (first-char "abc") "read 97")
  ;; The lexer has no \u escape, so é is spelled by its codepoint.
  (expect "a two-byte character"
          (first-char (list->string (list (integer->char 233) #\x)))
          "read 233")
  ;; Four bytes in, one scalar out.
  (expect "an astral character is one char" (first-char emoji) "read 128512")
  (expect "and it is spelled as four bytes" (string-length emoji) 4)

  ;; --- what it is given that is not UTF-8 ----------------------------------
  (expect "the empty port"
          (first-char "")
          "read-char: the port is at end of input. Guard with (port-eof? p), or use read-char/opt.")

  ;; A continuation byte with nothing before it is a replacement, and costs
  ;; one byte, so 'A' is the next character.
  (let ((p (bytes-port #[128 65])))
    (expect "a lone continuation byte" (first-char-in p) "read 65533")
    (expect "only that byte was consumed" (first-char-in p) "read 65"))

  ;; A four-byte lead with two of its three continuations, then a letter.
  (let ((p (bytes-port #[240 159 152 65])))
    (expect "a cut-short character is one replacement" (first-char-in p) "read 65533")
    (expect "and the letter after it is intact" (first-char-in p) "read 65"))

  ;; --- half a character, from .NET ------------------------------------------
  ;;
  ;; A port is also a `TextReader`, whose `Read` hands out UTF-16 units: an
  ;; astral character is two of them. After the first, the port stands inside
  ;; a character, and `read-char` refuses rather than inventing one.
  (let ((p (open-input-string (str emoji "A"))))
    (expect "a .NET read takes the high half" (.Read p) 55357)
    (expect "read-char then refuses the other half"
            (first-char-in p)
            "read-char: the port holds an unpaired low surrogate, which is not a character.")
    (expect "and moves past it" (first-char-in p) "read 65"))

  ;; The colour-aware `read-char` is the same reader underneath.
  (expect "read-char agrees on an astral character"
          (int->string (char->integer (read-char (open-input-string emoji))))
          "128512")
  0)
