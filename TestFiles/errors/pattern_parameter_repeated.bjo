;; A name bound by a parameter's pattern is in the same scope as the other
;; parameters, so it may not repeat one of them.
;; EXPECT-ERROR: 'a' is bound twice in this parameter list
(import (std prelude))

(: f (-> int (Tuple int int) int))
(defun (f a (Tuple a b)) b)

(defun (main args)
  (println (f 1 (Tuple 2 3)))
  0)
