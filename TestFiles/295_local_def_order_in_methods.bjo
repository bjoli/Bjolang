;; A run of body-local defs is one group, put in dependency order, so a def may
;; read one written after it. That holds in an impl method, a trait default and
;; either body of a defbjouble as it does in a defun.

(import (std prelude))
(import (std simpletest))

(def/trait (Speak %a)
  (: speak (-> %a int))
  (: speak-twice (-> %a int))
  (defun (speak-twice x)
    (def doubled (* 2 once))
    (def once (speak x))
    doubled))

(type (: Dog (Record (: n int))))

(impl (Speak Dog)
  (defun (speak d)
    (def a (+ b 1))
    (def b (.n d))
    a))

(: helper (-bjo-> int int))
(defbjo (helper x) x)

(: plus-one (-> int int))
(defbjouble (plus-one x)
  (#:sync
    (def a (+ b 1))
    (def b x)
    a)
  (#:bjo
    (def a (+ b 1))
    (def b (helper x))
    a))

(: plus-one-suspending (-bjo-> int int))
(defbjo (plus-one-suspending x) (plus-one x))

(defun (main args)
  (expect "an impl method reads a later def" (speak (Dog (n 41))) 42)
  (expect "a trait default reads a later def" (speak-twice (Dog (n 41))) 84)
  (expect "a defbjouble's sync body reads a later def" (plus-one 41) 42)
  (expect "and so does its suspending body"
          (match (sync/blocking (promise-join (bjo (plus-one-suspending 41))))
            ((Ok n) n)
            ((Err e) -1))
          42)
  0)
