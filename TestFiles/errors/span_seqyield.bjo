;; A span cannot be in scope across a yield of a (seq ...).
;; EXPECT-ERROR: 's' is a (System.Span long), and it is in scope across a (yield ...)
(import (std prelude))
(import/extern
  (whole (: System.MemoryExtensions.AsSpan (-> (Array %a) (System.Span %a))))
  (sleep (: System.Threading.Tasks.Task.Delay (-> int void) #:async #:uncancellable)))
(: (-> (System.Span long) int))
(defun (len s) (.-Length s))

(: (-> (Array long) (Seq int)))
(defun (f xs) (seq (def s (whole xs)) (yield 1) (yield (len s))))
(defun (main) 0)
