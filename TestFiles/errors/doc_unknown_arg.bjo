;; An arg the function does not have, here a renamed one.

;; EXPECT-ERROR: documents (arg low ...), and clamp has no argument low. Its arguments are x, lo, hi

(import (std prelude))

(:doc clamp (summary "Clamps.") (arg x "The number.") (arg low "The least.") (arg lo "The least.") (arg hi "The most.") (returns "x, clamped."))
(: clamp (-> int int int int))
(defun (clamp x lo hi) (max lo (min hi x)))

(defun (main args) 0)
