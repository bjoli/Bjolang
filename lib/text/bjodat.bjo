;; text/bjodat.bjo
;;
;; The bjodat data format: declare a record, get a reader and a writer.
;;
;;     (import (text bjodat))
;;
;;     (def/bjodat-type
;;       (: Dep (Record (: name string)
;;                      (: version string #:default "*")
;;                      (: pinned bool #:optional))))
;;
;;     (bjodat-parse-Dep "{:name \"http\" :version \"1.2\"}")   ;; -> (Ok Dep)
;;     (Dep->bjodat d)                                          ;; -> Bjodat
;;
;; `bjodat-parse-<Name>` reads the text **straight into the record**. There is
;; no intermediate tree: the key is compared against the field names in the
;; reader's own buffer, so a record costs no key string, no interned `Keyword`,
;; no node and no map. That is the interface to reach for, and it is about a
;; fifth faster than going through a tree.
;;
;; The tree is still here and still useful — for data whose shape is not known
;; until run time, and as the thing a field's own decoder converts. It lives in
;; `(text bjodat-core)`, and the names this module re-exports below are enough
;; that most programs never need to name it.
;;
;; One import is enough. That was not true when this module was split out, and
;; the reason it was not is worth recording rather than leaving as a silence: I
;; believed a type could not be republished through a facade, wrote that in
;; three places, and was wrong. `re-export` takes a type now — it publishes the
;; declaring module's declaration under a spelling of this module's, so there
;; is one `Bjodat` and not two — and a union comes with its cases, so a
;; hand-written `->bjodat` instance can name `BjoInt` here as readily as it
;; could over there. See `re-export` in `Docs/MODULES.org`.
;;
;; A record is a map whose keys are keywords naming its fields. The keys are
;; emitted as keyword *literals* at expansion time, so decoding a field through
;; a tree compares interned references and never interns anything at run time.
;;
;; There is no `null`. If a field is allowed to be missing, mark it with `#:optional` 
;; (which is just shorthand for `#:default None`). Since this format maps directly 
;; to Bjolang values, missing fields are strictly represented as `None`. If an 
;; `(Option %a)` must be explicitly written out in the file, `None` is encoded as 
;; an empty list `()`.

(export
  ;; The generator. Everything else here exists to serve what it writes.
  def/bjodat-type
  ;; The traits, for a type of your own that the generator did not declare.
  ->bjodat bjodat->
  ;; What generated field code calls. Exported because a macro template's names
  ;; resolve against this module's scope.
  bjodat-map bjodat-field bjodat-field/default
  bjodat-read-field bjodat-need-field
  bjodat-key bjodat-entries
  ;; And the same, for a record written as a tagged form.
  bjodat-clauses bjodat-clause-field bjodat-clause-field/default
  bjodat-clause-rest bjodat-clause-rest/default
  bjodat-read-clause bjodat-read-rest bjodat-need-clause
  bjodat-clause bjodat-clause-many bjodat-clause-values bjodat-form-value)

(import (std prelude))
(import (std syntax-match))
(import (text bjodat-core))

;; What `def/bjodat-type` writes has to resolve where it lands, and where it
;; lands is somebody else's module. So everything the template names travels
;; from here, whether or not this module wrote it.
;;
;; The two types are the reason the split used to cost every consumer a second
;; import: a generated signature reads `(-> Name Bjodat)` and `(-> Reader ...)`.
;; They are *this* module's spellings of `bjodat-core`'s declarations, not
;; copies of them — the key is still `bjodat_core`'s, so a value built through
;; either name is one type. `Bjodat`'s cases come with it, which is what lets a
;; hand-written instance match `BjoInt` without naming the other module.
;;
;; The rest is the one-pass driver the generated decoder calls, and the entry
;; points that drive a generated `bjodat-read-<Name>`. `bjodat->string` is here
;; because writing a record back out is the other half of the round trip, and
;; nothing else about the tree is: a program that wants to read data of unknown
;; shape imports `(text bjodat-core)` and gets the reader, the writer and the
;; accessors together.
;;
;; What does *not* travel is an implementation. A re-export publishes a
;; spelling and the declaration behind it, and an impl reaches a consumer
;; through the module that wrote it — see `re-export` in `Docs/MODULES.org`.
;; `bjodat-core` writes none, so there is nothing here to miss.
(re-export
  Bjodat Reader
  open-map! next-key! end-entry! key=? skip-value!
  open-form! next-field! skip-clause!
  read-one-pass parse-one-pass read-one-pass-all parse-one-pass-all
  bjodat->string)

;; ---------------------------------------------------------------------------
;; The traits
;; ---------------------------------------------------------------------------

(def/trait (->bjodat %a)
  (: ->bjodat (-> %a Bjodat)))

(def/trait (bjodat-> %a)
  (: bjodat-> (-> Bjodat (Result string %a))))

;; ---------------------------------------------------------------------------
;; Scalars
;; ---------------------------------------------------------------------------

(impl (->bjodat Bjodat) (defun (->bjodat v) v))
(impl (->bjodat long)   (defun (->bjodat n) (BjoInt n)))
(impl (->bjodat int)    (defun (->bjodat n) (BjoInt (cast System.Int64 n))))
(impl (->bjodat double) (defun (->bjodat n) (BjoFloat n)))
(impl (->bjodat bool)   (defun (->bjodat b) (BjoBool b)))
(impl (->bjodat string) (defun (->bjodat s) (BjoStr s)))
(impl (->bjodat char)   (defun (->bjodat c) (BjoChar c)))
(impl (->bjodat Symbol) (defun (->bjodat s) (BjoSym s)))
(impl (->bjodat Keyword) (defun (->bjodat k) (BjoKey k)))

(impl (bjodat-> Bjodat)
  (defun (bjodat-> v) (Ok v)))

(impl (bjodat-> long)
  (defun (bjodat-> v)
    (match v
      ((BjoInt n) (Ok n))
      (_ (Err "expected an integer")))))

(impl (bjodat-> int)
  (defun (bjodat-> v)
    (match v
      ((BjoInt n) (Ok (cast System.Int32 n)))
      (_ (Err "expected an integer")))))

(impl (bjodat-> double)
  (defun (bjodat-> v)
    (match v
      ((BjoFloat d) (Ok d))
      ;; An integer is a perfectly good double.
      ((BjoInt n) (Ok (cast System.Double n)))
      (_ (Err "expected a number")))))

(impl (bjodat-> bool)
  (defun (bjodat-> v)
    (match v
      ((BjoBool b) (Ok b))
      (_ (Err "expected #t or #f")))))

(impl (bjodat-> string)
  (defun (bjodat-> v)
    (match v
      ((BjoStr s) (Ok s))
      (_ (Err "expected a string")))))

(impl (bjodat-> char)
  (defun (bjodat-> v)
    (match v
      ((BjoChar c) (Ok c))
      (_ (Err "expected a character")))))

;; A symbol and a keyword are different values, and a field asking for one does
;; not take the other: that distinction is the reason both are in the format.
(impl (bjodat-> Symbol)
  (defun (bjodat-> v)
    (match v
      ((BjoSym s) (Ok s))
      (_ (Err "expected a symbol")))))

(impl (bjodat-> Keyword)
  (defun (bjodat-> v)
    (match v
      ((BjoKey k) (Ok k))
      (_ (Err "expected a keyword")))))

;; ---------------------------------------------------------------------------
;; Absence
;; ---------------------------------------------------------------------------

(impl (->bjodat (Option %a))
  (where (->bjodat %a))
  (defun (->bjodat o)
    (match o
      ((Some x) (->bjodat x))
      (None (BjoList Nil)))))

(impl (bjodat-> (Option %a))
  (where (bjodat-> %a))
  (defun (bjodat-> v)
    (match v
      ((BjoList Nil) (Ok None))
      (_ (match (bjodat-> v)
           ((Err e) (Err e))
           ((Ok x) (Ok (Some x))))))))

;; ---------------------------------------------------------------------------
;; Sequences
;; ---------------------------------------------------------------------------

(impl (->bjodat (Vec %a))
  (where (->bjodat %a))
  (defun (->bjodat v)
    (BjoVec (vec-map (fun (x) (->bjodat x)) v))))

(impl (bjodat-> (Vec %a))
  (where (bjodat-> %a))
  (defun (bjodat-> v)
    (match v
      ((BjoVec items)
       ;; vec-fold is already very very fast. no need to rewrite it as a loop
       (vec-fold (fun (el acc)
                   (match acc
                     ((Err e) (Err e))
                     ((Ok b)
                      (match (bjodat-> el)
                        ((Err e) (Err e))
                        ((Ok x) (Ok (vec-add b x)))))))
                 (Ok (vec-empty))
                 items))
      (_ (Err "expected a vec")))))

;; A list is the other sequence, and it is a different shape on the page: a
;; `(...)` rather than a `[...]`. A field takes the one its type names.
(impl (->bjodat (List %a))
  (where (->bjodat %a))
  (defun (->bjodat xs)
    (BjoList (list-map (fun (x) (->bjodat x)) xs))))

(impl (bjodat-> (List %a))
  (where (bjodat-> %a))
  (defun (bjodat-> v)
    (match v
      ((BjoList items)
       ;; this should be a loop.
       (match (list-foldl (fun (el acc)
                            (match acc
                              ((Err e) (Err e))
                              ((Ok b)
                               (match (bjodat-> el)
                                 ((Err e) (Err e))
                                 ((Ok x) (Ok (Cons x b)))))))
                          (Ok Nil)
                          items)
         ((Err e) (Err e))
         ((Ok b) (Ok (list-reverse b)))))
      (_ (Err "expected a list")))))

;; ---------------------------------------------------------------------------
;; What generated field code calls
;; ---------------------------------------------------------------------------

(: bjodat-map (-> string Bjodat (Result string (Vec Bjodat))))
(defun (bjodat-map owner v)
  (match v
    ((BjoMap entries) (Ok entries))
    (_ (Err (str owner ": expected a map")))))

;; The owner and the key are prefixed onto whatever the value's own decoder
;; said, so a wrong type reads "Package.version: expected a string" rather than
;; naming neither.
(: bjodat-field (-> string (Vec Bjodat) Keyword (Result string %a)) (where (bjodat-> %a)))
(defun (bjodat-field owner entries key)
  (match (bjodat-ref entries key)
    (None (Err (str owner ": the map has no :" (keyword->string key) " entry")))
    ((Some v)
     (match (bjodat-> v)
       ((Err e) (Err (str owner "." (keyword->string key) ": " e)))
       ((Ok x) (Ok x))))))

;; Absent is the default. Unlike JSON there is no null to mean it as well.
(: bjodat-field/default (-> string (Vec Bjodat) Keyword %a (Result string %a)) (where (bjodat-> %a)))
(defun (bjodat-field/default owner entries key fallback)
  (match (bjodat-ref entries key)
    (None (Ok fallback))
    ((Some v)
     (match (bjodat-> v)
       ((Err e) (Err (str owner "." (keyword->string key) ": " e)))
       ((Ok x) (Ok x))))))

;; --- and what a one-pass decoder calls --------------------------------------
;;
;; Wait, if this is a "one-pass" decoder, why are we still reading values into 
;; intermediate `Bjodat` trees? This is deliberate! It allows us to reuse all the 
;; existing `bjodat->` decoders (including custom ones written by users) and keeps 
;; error messages perfectly consistent. 
;; 
;; The performance savings of "one-pass" come entirely from the keys: we avoid 
;; allocating the map, interning the keywords, creating `BjoKey` nodes, and doing 
;; map lookups.

;; --- the two cases a generated encoder builds, as functions -----------------
;;
;; `(BjoKey k)` written directly into the template would not compile in the
;; importing module. A union's *cases* do not cross a second module boundary:
;; this module can publish the `Bjodat` type it imported, but not `BjoKey`, and
;; the encoder is spliced into the module that wrote `def/bjodat-type`. A
;; function is an ordinary binding and re-exports cleanly, so these two are what
;; make one import enough.
;;
;; Writing an instance by hand for a type of your own still wants the cases, and
;; that is what `(import (text bjodat-core))` is for. It is the rarer thing and
;; it is the one that should say so.

(: bjodat-key (-> Keyword Bjodat))
(defun (bjodat-key k) (BjoKey k))

;; The entries were pushed in reverse, and are turned round once here.
(: bjodat-entries (-> (List Bjodat) Bjodat))
(defun (bjodat-entries acc) (BjoMap (list->vec (list-reverse acc))))

(: bjodat-read-field (-> string Keyword Reader (Result string %a)) (where (bjodat-> %a)))
(defun (bjodat-read-field owner key rd)
  (match (field-value rd)
    ((Err e) (Err e))
    ((Ok v)
     (match (bjodat-> v)
       ((Err e) (Err (str owner "." (keyword->string key) ": " e)))
       ((Ok x) (Ok x))))))

;; A field that was never met. The message is `bjodat-field`'s, word for word,
;; so which decoder read the document is not something an error report reveals.
(: bjodat-need-field (-> (Option %a) string Keyword (Result string %a)))
(defun (bjodat-need-field slot owner key)
  (match slot
    ((Some x) (Ok x))
    (None (Err (str owner ": the map has no :" (keyword->string key) " entry")))))

;; ---------------------------------------------------------------------------
;; The same, for a record written as a tagged form
;; ---------------------------------------------------------------------------
;; `(package (name bjolang/http) (version "1.2.3"))`. A clause names a field and
;; holds its value, and the head symbol names the type.
;;
;; The clauses are scanned where a map's entries are scanned, and for the same
;; reason: a record has a handful of fields, and walking a handful beats
;; building a trie to throw away. What is deliberately *not* done is flattening
;; the clauses into a keyword map first and reusing `bjodat-ref`. That was the
;; shorter implementation and it would have interned a `Keyword` per field —
;; which is the one cost the tagged form has no reason to pay, since its names
;; arrive as symbols that are interned already.

;; Every clause has to be `(name ...)`. Checked up front rather than as each
;; field is looked for, because the one-pass reader refuses a malformed clause
;; whether or not any field wanted it, and two decoders that disagree about the
;; same document are worse than either rule.
(: bjodat-clause-shape (-> string (List Bjodat) (Result string (List Bjodat))))
(defun (bjodat-clause-shape owner cs)
  (let go ((rest cs))
    (match rest
      (Nil (Ok cs))
      ((Cons c more)
       (match c
         ((BjoList (Cons (BjoSym _) _)) (go more))
         ;; `next-field!`'s sentence, so that the two decoders refuse the same
         ;; document in the same words.
         (_ (Err (str owner ": a clause begins with a field name"))))))))

;; The clauses of `(tag (name value) ...)`, with the tag checked.
(: bjodat-clauses (-> string string Bjodat (Result string (List Bjodat))))
(defun (bjodat-clauses owner tag v)
  (match v
    ((BjoList (Cons (BjoSym h) cs))
     (if (= (symbol->string h) tag)
         (bjodat-clause-shape owner cs)
         (Err (str owner ": expected (" tag " ...), and this is ("
                   (symbol->string h) " ...)"))))
    (_ (Err (str owner ": expected (" tag " ...)")))))

;; The values of the first clause named `name`. **The first wins**, which is
;; what `bjodat-ref` does for a map and what the one-pass decoder does for a
;; repeated clause, so a document read any of the three ways answers the same.
(: bjodat-clause-ref (-> (List Bjodat) string (Option (List Bjodat))))
(defun (bjodat-clause-ref cs name)
  (let go ((rest cs))
    (match rest
      (Nil None)
      ((Cons c more)
       (match c
         ((BjoList (Cons (BjoSym h) vs))
          (if (= (symbol->string h) name) (Some vs) (go more)))
         (_ (go more)))))))

;; A clause holding exactly one value, which is every field but a `#:rest` one.
(: bjodat-one-value (-> string string (List Bjodat) (Result string %a)) (where (bjodat-> %a)))
(defun (bjodat-one-value owner name vs)
  (match vs
    ((Cons v Nil)
     (match (bjodat-> v)
       ((Err e) (Err (str owner "." name ": " e)))
       ((Ok x) (Ok x))))
    (_ (Err (str owner "." name ": a clause holds a field name and one value")))))

;; Every value of a clause, for a `#:rest` field.
(: bjodat-all-values (-> string string (List Bjodat) (Result string (List %a))) (where (bjodat-> %a)))
(defun (bjodat-all-values owner name vs)
  (match (list-foldl (fun (el acc)
                       (match acc
                         ((Err e) (Err e))
                         ((Ok b)
                          (match (bjodat-> el)
                            ((Err e) (Err (str owner "." name ": " e)))
                            ((Ok x) (Ok (Cons x b)))))))
                     (Ok Nil)
                     vs)
    ((Err e) (Err e))
    ((Ok b) (Ok (list-reverse b)))))

(: bjodat-clause-field (-> string (List Bjodat) string (Result string %a)) (where (bjodat-> %a)))
(defun (bjodat-clause-field owner cs name)
  (match (bjodat-clause-ref cs name)
    (None (Err (str owner ": there is no (" name " ...) clause")))
    ((Some vs) (bjodat-one-value owner name vs))))

(: bjodat-clause-field/default (-> string (List Bjodat) string %a (Result string %a)) (where (bjodat-> %a)))
(defun (bjodat-clause-field/default owner cs name fallback)
  (match (bjodat-clause-ref cs name)
    (None (Ok fallback))
    ((Some vs) (bjodat-one-value owner name vs))))

(: bjodat-clause-rest (-> string (List Bjodat) string (Result string (List %a))) (where (bjodat-> %a)))
(defun (bjodat-clause-rest owner cs name)
  (match (bjodat-clause-ref cs name)
    (None (Err (str owner ": there is no (" name " ...) clause")))
    ((Some vs) (bjodat-all-values owner name vs))))

(: bjodat-clause-rest/default (-> string (List Bjodat) string (List %a) (Result string (List %a))) (where (bjodat-> %a)))
(defun (bjodat-clause-rest/default owner cs name fallback)
  (match (bjodat-clause-ref cs name)
    (None (Ok fallback))
    ((Some vs) (bjodat-all-values owner name vs))))

;; --- and what a one-pass decoder calls --------------------------------------
;;
;; Both of these leave the clause fully consumed, closing paren and all, so the
;; generated loop has one shape whether the field took one value or every value.

(: bjodat-read-clause (-> string string Reader (Result string %a)) (where (bjodat-> %a)))
(defun (bjodat-read-clause owner name rd)
  (match (field-value rd)
    ((Err e) (Err e))
    ((Ok v)
     (match (bjodat-> v)
       ((Err e) (Err (str owner "." name ": " e)))
       ((Ok x)
        (match (end-clause! rd owner name)
          ((Err e2) (Err e2))
          ((Ok _) (Ok x))))))))

(: bjodat-read-rest (-> string string Reader (Result string (List %a))) (where (bjodat-> %a)))
(defun (bjodat-read-rest owner name rd)
  (match (clause-values! rd)
    ((Err e) (Err e))
    ((Ok vs) (bjodat-all-values owner name vs))))

;; A clause that was never met. The message is `bjodat-clause-field`'s, word for
;; word, so which decoder read the document is not something a report reveals.
(: bjodat-need-clause (-> (Option %a) string string (Result string %a)))
(defun (bjodat-need-clause slot owner name)
  (match slot
    ((Some x) (Ok x))
    (None (Err (str owner ": there is no (" name " ...) clause")))))

;; --- the three shapes a generated encoder builds, as functions --------------
;;
;; Here for the reason `bjodat-key` and `bjodat-entries` are: a union's *cases*
;; do not cross a second module boundary, and the encoder is spliced into
;; whichever module wrote `def/bjodat-type`.

(: bjodat-clause (-> string Bjodat Bjodat))
(defun (bjodat-clause name v)
  (BjoList (Cons (BjoSym (string->symbol name)) (Cons v Nil))))

(: bjodat-clause-many (-> string (List Bjodat) Bjodat))
(defun (bjodat-clause-many name vs)
  (BjoList (Cons (BjoSym (string->symbol name)) vs)))

(: bjodat-clause-values (-> (List %a) (List Bjodat)) (where (->bjodat %a)))
(defun (bjodat-clause-values xs)
  (list-map (fun (x) (->bjodat x)) xs))

;; The clauses were pushed in reverse, and are turned round once here.
(: bjodat-form-value (-> string (List Bjodat) Bjodat))
(defun (bjodat-form-value tag acc)
  (BjoList (Cons (BjoSym (string->symbol tag)) (list-reverse acc))))

;; ---------------------------------------------------------------------------
;; The generator
;; ---------------------------------------------------------------------------
;; A runtime macro. Field types are never inspected: what a field encodes as is
;; settled later by instance resolution, and only the markers are read here.

(: jb-sym (-> string Syntax))
(defun (jb-sym name) (SSym (string->symbol name)))

(: jb-str (-> Syntax Syntax))
(defun (jb-str s) (SStr (syntax->string s)))

;; `(Box %a)` names the type `Box`; a bare `Package` names itself.
(: jb-head-name (-> Syntax Syntax))
(defun (jb-head-name head)
  (match head
    ((SList parts) (list-head parts))
    (_ head)))

(: jb-head-vars (-> Syntax (List Syntax)))
(defun (jb-head-vars head)
  (match head
    ((SList parts) (list-tail parts))
    (_ Nil)))

(: jb-where (-> (-> Symbol Syntax) Syntax string (List Syntax)))
(defun (jb-where inject head trait)
  (def vars (jb-head-vars head))
  (if (list-empty? vars)
      Nil
      (list #'(,(inject 'where)
               ,@(list-map (fun (v) #'(,(inject (string->symbol trait)) ,v)) vars)))))

;; --- markers ---------------------------------------------------------------

(: jb-marker=? (-> Syntax string bool))
(defun (jb-marker=? m name) (= (syntax->string m) name))

;; The key this field is written under. `#:key :other-name` renames it; without
;; one the key is the field's own name. Built here, at expansion time, so the
;; generated code holds a keyword literal.
;;
;; Note: We generate a keyword literal directly in the decoder for every field. 
;; You might worry this is slow (e.g. hashing and interning the string every time), 
;; and historically, this macro used to generate a static variable to cache it. 
;; 
;; We don't do that anymore because the compiler's `Codegen` phase is now smart 
;; enough to automatically hoist all keyword literals into static fields behind 
;; the scenes. It's just as fast, and the code is cleaner.
(: jb-key (-> Syntax (List Syntax) Syntax))
(defun (jb-key name markers)
  (let go ((ms markers))
    (cond
      ((list-empty? ms) (SKey (string->keyword (syntax->string name))))
      ((jb-marker=? (list-head ms) "#:key") (list-head (list-tail ms)))
      (else (go (list-tail ms))))))

;; The fallback expression, or None if the field is required.
(: jb-fallback (-> (List Syntax) (Option Syntax)))
(defun (jb-fallback markers)
  (let go ((ms markers))
    (cond
      ((list-empty? ms) None)
      (else
       (def m (list-head ms))
       (cond
         ((jb-marker=? m "#:optional") (Some (jb-sym "None")))
         ((jb-marker=? m "#:default") (Some (list-head (list-tail ms))))
         (else (go (list-tail ms))))))))

(: jb-optional? (-> (List Syntax) bool))
(defun (jb-optional? markers)
  (let go ((ms markers))
    (cond
      ((list-empty? ms) #f)
      ((jb-marker=? (list-head ms) "#:optional") #t)
      (else (go (list-tail ms))))))

;; `#:rest` — the field takes *every* value of its clause rather than one, so
;; `(depends (package ...) (package ...))` fills a `(List Dep)`.
;;
;; This is the answer to the question a tagged list otherwise leaves open, which
;; is which clauses may repeat. It is answered per *field*, by the type, because
;; that is the only place that knows: `version` holds one and `depends` holds
;; many, and nothing about the syntax could tell them apart.
;;
;; A field is marked, not a clause repeated. `(depends a) (depends b)` does not
;; accumulate — the first clause wins, as the first entry under a key does.
;; Accumulating would have meant one rule for maps and another for forms.
(: jb-rest? (-> (List Syntax) bool))
(defun (jb-rest? markers)
  (let go ((ms markers))
    (cond
      ((list-empty? ms) #f)
      ((jb-marker=? (list-head ms) "#:rest") #t)
      (else (go (list-tail ms))))))

;; `(Record #:tag package (: name ...) ...)` — the marker, if it is there, and
;; the fields with it taken off.
;;
;; There is no default. `Package` spelled `package` is a casing guess, and which
;; tag a type is written under belongs in the file's vocabulary rather than in a
;; rule about capital letters.
(: jb-tag (-> (List Syntax) (Option Syntax)))
(defun (jb-tag body)
  (cond
    ((list-empty? body) None)
    ((jb-marker=? (list-head body) "#:tag")
     (Some (jb-str (list-head (list-tail body)))))
    (else None)))

(: jb-fields (-> (List Syntax) (List Syntax)))
(defun (jb-fields body)
  (if (some? (jb-tag body))
      (list-tail (list-tail body))
      body))

;; What the record declaration keeps: everything that is not ours.
(: jb-keep (-> (List Syntax) (List Syntax)))
(defun (jb-keep markers)
  (let go ((ms markers))
    (cond
      ((list-empty? ms) Nil)
      (else
       (def m (list-head ms))
       (cond
         ((jb-marker=? m "#:default") (go (list-tail (list-tail ms))))
         ((jb-marker=? m "#:key") (go (list-tail (list-tail ms))))
         ((jb-marker=? m "#:optional") (go (list-tail ms)))
         ((jb-marker=? m "#:rest") (go (list-tail ms)))
         (else (Cons m (go (list-tail ms)))))))))

(: jb-shape string)
(def jb-shape
  "a field is written (: name type), then any of #:mutable, #:optional, #:default <expr>, #:key :name, #:rest.")

(: jb-fail-list (-> Syntax string (List Syntax)))
(defun (jb-fail-list form message)
  (ignore (syntax-error form message))
  Nil)

(: jb-field-name (-> Syntax Syntax))
(defun (jb-field-name f)
  (syntax-match f
    ((_ name _ marker ...) name)
    (bad (syntax-error bad jb-shape))))

(: jb-field-markers (-> Syntax (List Syntax)))
(defun (jb-field-markers f)
  (syntax-match f
    ((_ _ _ marker ...) marker)
    (bad (jb-fail-list bad jb-shape))))

(: jb-strip (-> Syntax Syntax))
(defun (jb-strip f)
  (syntax-match f
    ((colon name ty marker ...) #'(,colon ,name ,ty ,@(jb-keep marker)))
    (bad (syntax-error bad jb-shape))))

;; --- encode ----------------------------------------------------------------
;;
;; The entries are built up in reverse and turned round once, so a map is one
;; vec and the order is the order the fields were declared in. An optional
;; field that is None is not written at all.

(: jb-enc-chain (-> (List Syntax) Syntax Syntax))
(defun (jb-enc-chain fields acc)
  (cond
    ((list-empty? fields) #'(bjodat-entries ,acc))
    (else
     (def f (list-head fields))
     (def name (jb-field-name f))
     (def markers (jb-field-markers f))
     (def key (jb-key name markers))
     (def push #'(Cons (->bjodat (record-ref v ,name))
                       (Cons (bjodat-key ,key) ,acc)))
     (def step (if (jb-optional? markers)
                   #'(if (some? (record-ref v ,name)) ,push ,acc)
                   push))
     #'(let ((,acc ,step))
         ,(jb-enc-chain (list-tail fields) acc)))))

(: jb-encode (-> (List Syntax) Syntax))
(defun (jb-encode fields)
  (def acc (jb-sym "__jb-acc"))
  #'(let ((,acc Nil))
      ,(jb-enc-chain fields acc)))

;; The same, as a tagged form. An optional field that is `None` is not written,
;; and neither is a `#:rest` field that is empty *and* has a fallback to come
;; back as — `(authors)` is noise, and a field with no fallback has to be
;; written or the document would not read back.

(: jb-form-enc-chain (-> (List Syntax) Syntax Syntax Syntax))
(defun (jb-form-enc-chain fields tag acc)
  (cond
    ((list-empty? fields) #'(bjodat-form-value ,tag ,acc))
    (else
     (def f (list-head fields))
     (def name (jb-field-name f))
     (def markers (jb-field-markers f))
     (def nm (jb-key-name name markers))
     (def push (if (jb-rest? markers)
                   #'(Cons (bjodat-clause-many
                            ,nm (bjodat-clause-values (record-ref v ,name)))
                           ,acc)
                   #'(Cons (bjodat-clause ,nm (->bjodat (record-ref v ,name)))
                           ,acc)))
     (def step (cond
                 ((jb-optional? markers)
                  #'(if (some? (record-ref v ,name)) ,push ,acc))
                 ((and (jb-rest? markers) (some? (jb-fallback markers)))
                  #'(if (list-empty? (record-ref v ,name)) ,acc ,push))
                 (else push)))
     #'(let ((,acc ,step))
         ,(jb-form-enc-chain (list-tail fields) tag acc)))))

(: jb-form-encode (-> (List Syntax) Syntax Syntax))
(defun (jb-form-encode fields tag)
  (def acc (jb-sym "__jb-acc"))
  #'(let ((,acc Nil))
      ,(jb-form-enc-chain fields tag acc)))

;; --- decode ----------------------------------------------------------------
;;
;; One `match` per field wrapping the next, with the constructor innermost.

(: jb-chain (-> Syntax Syntax (List Syntax) int Syntax Syntax))
(defun (jb-chain owner entries fields i ctor)
  (cond
    ((list-empty? fields) ctor)
    (else
     (def f (list-head fields))
     (def v (jb-sym (str "__jb-v" (int->string i))))
     (def e (jb-sym (str "__jb-e" (int->string i))))
     (def markers (jb-field-markers f))
     (def key (jb-key (jb-field-name f) markers))
     (def get (match (jb-fallback markers)
                (None #'(bjodat-field ,owner ,entries ,key))
                ((Some d) #'(bjodat-field/default ,owner ,entries ,key ,d))))
     #'(match ,get
         ((Err ,e) (Err ,e))
         ((Ok ,v) ,(jb-chain owner entries (list-tail fields) (+ i 1) ctor))))))

(: jb-ctor (-> Syntax (List Syntax) Syntax))
(defun (jb-ctor head fields)
  #'(Ok (,(jb-head-name head)
         ,@(let go ((fs fields) (i 0))
             (if (list-empty? fs)
                 Nil
                 (Cons #'(,(jb-field-name (list-head fs))
                          ,(jb-sym (str "__jb-v" (int->string i))))
                       (go (list-tail fs) (+ i 1))))))))

(: jb-decode (-> Syntax (List Syntax) Syntax))
(defun (jb-decode head fields)
  (def owner (jb-str (jb-head-name head)))
  (def entries (jb-sym "__jb-entries"))
  (def e (jb-sym "__jb-e"))
  #'(match (bjodat-map ,owner v)
      ((Err ,e) (Err ,e))
      ((Ok ,entries) ,(jb-chain owner entries fields 0 (jb-ctor head fields)))))

;; The same, over the clauses of a tagged form. `jb-ctor` is shared, so both
;; decoders end in one constructor call written once.

(: jb-form-chain (-> Syntax Syntax (List Syntax) int Syntax Syntax))
(defun (jb-form-chain owner cs fields i ctor)
  (cond
    ((list-empty? fields) ctor)
    (else
     (def f (list-head fields))
     (def v (jb-var i))
     (def e (jb-sym "__jb-e"))
     (def markers (jb-field-markers f))
     (def nm (jb-key-name (jb-field-name f) markers))
     (def get (if (jb-rest? markers)
                  (match (jb-fallback markers)
                    (None #'(bjodat-clause-rest ,owner ,cs ,nm))
                    ((Some d) #'(bjodat-clause-rest/default ,owner ,cs ,nm ,d)))
                  (match (jb-fallback markers)
                    (None #'(bjodat-clause-field ,owner ,cs ,nm))
                    ((Some d) #'(bjodat-clause-field/default ,owner ,cs ,nm ,d)))))
     #'(match ,get
         ((Err ,e) (Err ,e))
         ((Ok ,v) ,(jb-form-chain owner cs (list-tail fields) (+ i 1) ctor))))))

(: jb-form-decode (-> Syntax Syntax (List Syntax) Syntax))
(defun (jb-form-decode head tag fields)
  (def owner (jb-str (jb-head-name head)))
  (def cs (jb-sym "__jb-clauses"))
  (def e (jb-sym "__jb-e"))
  #'(match (bjodat-clauses ,owner ,tag v)
      ((Err ,e) (Err ,e))
      ((Ok ,cs) ,(jb-form-chain owner cs fields 0 (jb-ctor head fields)))))

;; --- decode in one pass -----------------------------------------------------
;;
;; The same record, read straight off the reader with no `Bjodat` map in
;; between. The shape is a loop carrying one slot per field:
;;
;;     (let go ((s0 None) (s1 None))
;;       (match (next-key! rd owner paired)
;;         ((Ok #f) <every slot answered for, then the constructor>)
;;         ((Ok _)  (cond ((key=? rd "name") ... (go (Some x) s1))
;;                        ((key=? rd "git")  ... (go s0 (Some x)))
;;                        (else <skip the value> (go s0 s1))))))
;;
;; We use an `(Option %a)` variable to track each field during the loop, rather 
;; than a separate value and a boolean 'seen' flag. Since `Option` is a lightweight 
;; struct, this adds no extra memory overhead and elegantly tracks both "has it 
;; been seen?" and "what is the value?" simultaneously.
;;
;; We compare incoming keys directly against the expected string in the reader's 
;; raw buffer using `key=?`. This is the core optimization of the one-pass 
;; decoder: we never allocate memory or intern strings for keys we encounter in 
;; the file. (The standard tree decoder had to intern every single key just to 
;; look it up in the map).

(: jb-slot (-> int Syntax))
(defun (jb-slot i) (jb-sym (str "__jb-s" (int->string i))))

(: jb-var (-> int Syntax))
(defun (jb-var i) (jb-sym (str "__jb-v" (int->string i))))

;; The key's name as a string, for `key=?`. `#:key :other-name` renames it here
;; exactly as it renames the keyword literal, so the two cannot drift.
(: jb-key-name (-> Syntax (List Syntax) Syntax))
(defun (jb-key-name name markers)
  (let go ((ms markers))
    (cond
      ((list-empty? ms) (SStr (syntax->string name)))
      ((jb-marker=? (list-head ms) "#:key")
       (match (list-head (list-tail ms))
         ((SKey k) (SStr (keyword->string k)))
         (other (SStr (syntax->string other)))))
      (else (go (list-tail ms))))))

(: jb-slot-inits (-> (List Syntax) int (List Syntax)))
(defun (jb-slot-inits fields i)
  (if (list-empty? fields)
      Nil
      (Cons #'(,(jb-slot i) None)
            (jb-slot-inits (list-tail fields) (+ i 1)))))

;; The slots a recursive call passes on, unchanged.
(: jb-slot-args (-> (List Syntax) int (List Syntax)))
(defun (jb-slot-args fields i)
  (if (list-empty? fields)
      Nil
      (Cons (jb-slot i) (jb-slot-args (list-tail fields) (+ i 1)))))

;; The same, with slot `hit` replaced by the value just read.
(: jb-slot-args/hit (-> (List Syntax) int int Syntax (List Syntax)))
(defun (jb-slot-args/hit fields i hit v)
  (if (list-empty? fields)
      Nil
      (Cons (if (= i hit) v (jb-slot i))
            (jb-slot-args/hit (list-tail fields) (+ i 1) hit v))))

(: jb-clauses (-> Syntax Syntax Syntax (List Syntax) (List Syntax) int (List Syntax)))
(defun (jb-clauses owner paired go all fields i)
  (cond
    ((list-empty? fields) Nil)
    (else
     (def f (list-head fields))
     (def markers (jb-field-markers f))
     (def name (jb-field-name f))
     (def x (jb-sym "__jb-x"))
     (def e (jb-sym "__jb-e"))
     (Cons #'((key=? rd ,(jb-key-name name markers))
              (match (bjodat-read-field ,owner ,(jb-key name markers) rd)
                ((Err ,e) (Err ,e))
                ((Ok ,x)
                 (match (end-entry! rd ,owner ,paired)
                   ((Err ,e) (Err ,e))
                   ((Ok _)
                    ;; The *first* entry under a key wins, which is what
                    ;; `bjodat-ref` does for the tree decoder — it answers the
                    ;; first match and stops. Without this test the one-pass
                    ;; decoder took the last, and two decoders that disagree
                    ;; about the same document are worse than either rule.
                    ;; The value still has to be read to get past it.
                    (,go ,@(jb-slot-args/hit all 0 i
                             #'(if (some? ,(jb-slot i)) ,(jb-slot i) (Some ,x)))))))))
           (jb-clauses owner paired go all (list-tail fields) (+ i 1))))))

;; Every slot answered for, innermost first, ending in the constructor. A
;; required field that was never met is the one refusal; a field with a fallback
;; takes it here rather than at the entry, because absence is only known once
;; the map has closed.
(: jb-settle (-> Syntax Syntax (List Syntax) (List Syntax) int Syntax))
(defun (jb-settle head owner all fields i)
  (cond
    ((list-empty? fields) (jb-ctor head all))
    (else
     (def f (list-head fields))
     (def markers (jb-field-markers f))
     (def key (jb-key (jb-field-name f) markers))
     (def e (jb-sym "__jb-e"))
     (def p (jb-sym "__jb-p"))
     (def rest (jb-settle head owner all (list-tail fields) (+ i 1)))
     (match (jb-fallback markers)
       (None #'(match (bjodat-need-field ,(jb-slot i) ,owner ,key)
                 ((Err ,e) (Err ,e))
                 ((Ok ,(jb-var i)) ,rest)))
       ((Some d) #'(let ((,(jb-var i) (match ,(jb-slot i)
                                        ((Some ,p) ,p)
                                        (None ,d))))
                     ,rest))))))

(: jb-one-pass (-> Syntax (List Syntax) Syntax))
(defun (jb-one-pass head fields)
  (def owner (jb-str (jb-head-name head)))
  (def paired (jb-sym "__jb-paired"))
  (def go (jb-sym "__jb-go"))
  (def e (jb-sym "__jb-e"))
  #'(match (open-map! rd ,owner)
      ((Err ,e) (Err ,e))
      ((Ok ,paired)
       (let ,go (,@(jb-slot-inits fields 0))
         (match (next-key! rd ,owner ,paired)
           ((Err ,e) (Err ,e))
           ((Ok #f) ,(jb-settle head owner fields fields 0))
           ((Ok _)
            (cond
              ,@(jb-clauses owner paired go fields fields 0)
              (else
               (match (skip-value! rd)
                 ((Err ,e) (Err ,e))
                 ((Ok _)
                  (match (end-entry! rd ,owner ,paired)
                    ((Err ,e) (Err ,e))
                    ((Ok _) (,go ,@(jb-slot-args fields 0))))))))))))))

;; --- reading a tagged form in one pass --------------------------------------
;;
;; The same loop, over `(package (name "x") (version "1.2"))`. Three things
;; differ from the map above and nothing else does: `open-form!` checks the tag
;; where `open-map!` only found a brace, a clause name is a bare symbol rather
;; than a keyword, and an unknown clause costs `skip-clause!` rather than
;; `skip-value!` because it may hold any number of values.
;;
;; The closing `)` of a clause is consumed by whichever of `bjodat-read-clause`
;; and `bjodat-read-rest` read it, which is why there is no `end-entry!` here to
;; match the map decoder's. That keeps the two branches one shape.

(: jb-form-clauses (-> Syntax Syntax (List Syntax) (List Syntax) int (List Syntax)))
(defun (jb-form-clauses owner go all fields i)
  (cond
    ((list-empty? fields) Nil)
    (else
     (def f (list-head fields))
     (def markers (jb-field-markers f))
     (def nm (jb-key-name (jb-field-name f) markers))
     (def x (jb-sym "__jb-x"))
     (def e (jb-sym "__jb-e"))
     (def read (if (jb-rest? markers)
                   #'(bjodat-read-rest ,owner ,nm rd)
                #'(bjodat-read-clause ,owner ,nm rd)))
  (Cons #'((key=? rd ,nm)
              (match ,read
                ((Err ,e) (Err ,e))
                ((Ok ,x)
                 ;; The first clause under a name wins, as the first entry
                 ;; under a key does. The later one is still read, because
                 ;; finding where it ends means parsing it.
                 (,go ,@(jb-slot-args/hit all 0 i
                          #'(if (some? ,(jb-slot i)) ,(jb-slot i) (Some ,x)))))))
           (jb-form-clauses owner go all (list-tail fields) (+ i 1))))))

(: jb-form-settle (-> Syntax Syntax (List Syntax) (List Syntax) int Syntax))
(defun (jb-form-settle head owner all fields i)
  (cond
    ((list-empty? fields) (jb-ctor head all))
    (else
     (def f (list-head fields))
     (def markers (jb-field-markers f))
     (def nm (jb-key-name (jb-field-name f) markers))
     (def e (jb-sym "__jb-e"))
     (def p (jb-sym "__jb-p"))
     (def rest (jb-form-settle head owner all (list-tail fields) (+ i 1)))
     (match (jb-fallback markers)
       (None #'(match (bjodat-need-clause ,(jb-slot i) ,owner ,nm)
                 ((Err ,e) (Err ,e))
                 ((Ok ,(jb-var i)) ,rest)))
       ((Some d) #'(let ((,(jb-var i) (match ,(jb-slot i)
                                        ((Some ,p) ,p)
                                        (None ,d))))
                     ,rest))))))

(: jb-form-one-pass (-> Syntax Syntax (List Syntax) Syntax))
(defun (jb-form-one-pass head tag fields)
  (def owner (jb-str (jb-head-name head)))
  (def go (jb-sym "__jb-go"))
  (def e (jb-sym "__jb-e"))
  #'(match (open-form! rd ,owner ,tag)
      ((Err ,e) (Err ,e))
      ((Ok _)
       (let ,go (,@(jb-slot-inits fields 0))
         (match (next-field! rd ,owner)
           ((Err ,e) (Err ,e))
           ((Ok #f) ,(jb-form-settle head owner fields fields 0))
           ((Ok _)
            (cond
              ,@(jb-form-clauses owner go fields fields 0)
              (else
               (match (skip-clause! rd)
                 ((Err ,e) (Err ,e))
                 ((Ok _) (,go ,@(jb-slot-args fields 0))))))))))))

;; --- the form ---------------------------------------------------------------

(: jb-expand (-> (-> Symbol Syntax) Syntax Syntax (List Syntax) Syntax))
(defun (jb-expand inject colon head body)
  (def tag (jb-tag body))
  (def fields (jb-fields body))
  (def name (syntax->string (jb-head-name head)))
  ;; Which of the two spellings this record is written in is settled
  ;; once, here, and the three generated bodies agree by construction.
  ;; A type has one encoding: a value that read as `{...}` writes back as
  ;; `{...}`, and one that read as `(tag ...)` writes back as that.
  (def encode (match tag
                (None (jb-encode fields))
                ((Some t) (jb-form-encode fields t))))
  (def decode (match tag
                (None (jb-decode head fields))
                ((Some t) (jb-form-decode head t fields))))
  (def one-pass (match tag
                  (None (jb-one-pass head fields))
                  ((Some t) (jb-form-one-pass head t fields))))
  (def enc (inject (string->symbol (str name "->bjodat"))))
  (def dec (inject (string->symbol (str "bjodat->" name))))
  (def rdr (inject (string->symbol (str "bjodat-read-" name))))
  (def prs (inject (string->symbol (str "bjodat-parse-" name))))
  #'(begin
      (type (,colon ,head (Record ,@(list-map jb-strip fields))))

      (impl (->bjodat ,head)
        ,@(jb-where inject head "->bjodat")
        (defun (->bjodat v) ,encode))

      (impl (bjodat-> ,head)
        ,@(jb-where inject head "bjodat->")
        (defun (bjodat-> v) ,decode))

      ;; The named pair. `bjodat->` alone would be ambiguous at a call site;
      ;; this signature is what fixes the instance, once per type.
      (: ,enc (-> ,head ,(inject 'Bjodat)) ,@(jb-where inject head "->bjodat"))
      (defun (,enc v) (->bjodat v))
      (: ,dec (-> ,(inject 'Bjodat) (Result string ,head)) ,@(jb-where inject head "bjodat->"))
      (defun (,dec v) (bjodat-> v))

      ;; And the one-pass pair, which reads the text itself rather than a
      ;; map someone else built. Same record, same messages; no tree.
      (: ,rdr (-> ,(inject 'Reader) (Result string ,head)) ,@(jb-where inject head "bjodat->"))
      (defun (,rdr rd) ,one-pass)
      (: ,prs (-> string (Result string ,head)) ,@(jb-where inject head "bjodat->"))
      ;; The reader is passed by *name*, not wrapped in a `(fun (rd) ...)`.
      ;; A lambda body is a member of its own and is sealed to the sync copy
      ;; of whatever it calls, so the wrapped form made the suspending copy
      ;; of this function park the thread — which the blocking lint said in
      ;; as many words. A bare name carries an effect variable instead, and
      ;; `parse-one-pass` declares its parameter `-?->`, so the caller's
      ;; colour picks the copy.
      (defun (,prs text) (parse-one-pass text ,rdr))))

(def/macro (def/bjodat-type form inject compare)
  (syntax-match form
    ((_ typedef)
     (syntax-match typedef
       ((colon head ('Record field ...)) (jb-expand inject colon head field))
       (bad (syntax-error bad "def/bjodat-type takes a record: (def/bjodat-type (: Name (Record (: field type) ...)))"))))
    (bad (syntax-error bad "def/bjodat-type takes exactly one record declaration."))))
