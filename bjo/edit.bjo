;; bjo/edit.bjo — `bjo add`, `bjo remove`, `bjo update`: editing the manifest.
;;
;; These three commands write `manifest.bjodat`, and that is the whole of the
;; difficulty. The reader in `(text bjodat)` answers with a *value* — a
;; `Package` — and a value has no idea where in the file it was written, so
;; rewriting the file from one would reformat every line of it and delete every
;; comment, starting with the commented-out example `bjo init` leaves there.
;;
;; So this edits the text. It reads the file with a scanner of its own that
;; records *where* each form is and nothing about what it means, changes the
;; few characters that have to change, and leaves every other byte alone —
;; including the comments, the indentation and the order of the clauses.
;;
;; The scanner is not a second reader of the format: it knows parentheses,
;; strings and `;` comments, and that is all it knows. What a form *means* is
;; read the ordinary way, from the `Package` the real reader produced, and the
;; two are matched up by the package name. Every edit is checked by parsing the
;; result before it is kept, and a file that no longer parses is put back as it
;; was — ugly is acceptable here, wrong is not.

(export
  cmd-add cmd-remove cmd-update)

(import (text bjodat))
(import "manifest.bjo")
(import "project.bjo")
(import "git.bjo")


;; ---------------------------------------------------------------------------
;; The scanner
;; ---------------------------------------------------------------------------

;; A form, and the text it occupies.
;;
;; `span-head` is the head symbol of a list — `depends`, `package` — or the
;; text of an atom. It is what every lookup below is by, because a manifest is
;; a tree of clauses named by their heads.
(type (: Span (Record (: span-head string)
                      (: span-from StringCursor)
                      (: span-to StringCursor)
                      (: span-kids (List Span)))))

(: blank? (-> char bool))
(defun (blank? c)
  (case c
    ((#\space #\tab #\newline #\return) #t)
    (else #f)))

;; A character that ends an atom.
(: delimiter? (-> char bool))
(defun (delimiter? c)
  (or (blank? c)
      (or (char=? c #\() (or (char=? c #\)) (or (char=? c #\;) (char=? c #\")))))) 

;; Past the end of a `;` comment, newline included.
(: skip-line (-> string StringCursor StringCursor))
(defun (skip-line text c)
  (cond
    ((string-cursor-end? text c) c)
    ((char=? (string-cursor-ref text c) #\newline) (string-cursor-next text c))
    (else (skip-line text (string-cursor-next text c)))))

;; Past whitespace and comments, to the next thing that is a form.
(: skip-blank (-> string StringCursor StringCursor))
(defun (skip-blank text c)
  (cond
    ((string-cursor-end? text c) c)
    ((blank? (string-cursor-ref text c)) (skip-blank text (string-cursor-next text c)))
    ((char=? (string-cursor-ref text c) #\;) (skip-blank text (skip-line text c)))
    (else c)))

;; Backwards over whitespace, which is where an insertion goes: the blank line
;; before a closing paren belongs to the layout, not to the last clause.
(: trim-back (-> string StringCursor StringCursor))
(defun (trim-back text c)
  (cond
    ((string-cursor<=? c (string-cursor-start text)) c)
    (:def before (string-cursor-prev text c))
    ((blank? (string-cursor-ref text before)) (trim-back text before))
    (else c)))

;; Past a string literal, the closing quote included. `\"` does not end one.
(: skip-string (-> string StringCursor StringCursor))
(defun (skip-string text c)
  (cond
    ((string-cursor-end? text c) c)
    ((char=? (string-cursor-ref text c) #\\)
     (def next (string-cursor-next text c))
     (if (string-cursor-end? text next) next (skip-string text (string-cursor-next text next))))
    ((char=? (string-cursor-ref text c) #\") (string-cursor-next text c))
    (else (skip-string text (string-cursor-next text c)))))

(: skip-atom (-> string StringCursor StringCursor))
(defun (skip-atom text c)
  (cond
    ((string-cursor-end? text c) c)
    ((delimiter? (string-cursor-ref text c)) c)
    (else (skip-atom text (string-cursor-next text c)))))

;; One form, and the cursor after it. `None` at the end of the text and at a
;; closing paren, which is what ends the loop in `read-list`.
(: read-form (-> string StringCursor (Option (Tuple Span StringCursor))))
(defun (read-form text c0)
  (def at (skip-blank text c0))
  (cond
    ((string-cursor-end? text at) None)
    ((char=? (string-cursor-ref text at) #\)) None)
    ((char=? (string-cursor-ref text at) #\() (read-list text at))
    (else
     (def stop (if (char=? (string-cursor-ref text at) #\")
                   (skip-string text (string-cursor-next text at))
                   (skip-atom text at)))
     ;; An atom that consumed nothing would loop for ever; a stray character
     ;; that is not a delimiter cannot happen, but the guard is one comparison.
     (def end (if (string-cursor<=? stop at) (string-cursor-next text at) stop))
     (Some (Tuple (Span (span-head (substring/cursors text at end))
                        (span-from at) (span-to end) (span-kids Nil))
                  end)))))

(: read-list (-> string StringCursor (Option (Tuple Span StringCursor))))
(defun (read-list text open)
  (let go ((c (string-cursor-next text open)) (kids Nil))
    (def at (skip-blank text c))
    (cond
      ;; Unbalanced. The form is everything that is left, and the parse check
      ;; after the edit is what refuses it.
      ((string-cursor-end? text at) (Some (Tuple (finished text open at kids) at)))
      ((char=? (string-cursor-ref text at) #\))
       (def after (string-cursor-next text at))
       (Some (Tuple (finished text open after kids) after)))
      (else
       (match (read-form text at)
         (None (Some (Tuple (finished text open at kids) at)))
         ((Some (Tuple kid next)) (go next (Cons kid kids))))))))

(: finished (-> string StringCursor StringCursor (List Span) Span))
(defun (finished text open close kids)
  (def ordered (list-reverse kids))
  (Span (span-head (match ordered
                     ((Cons first _) (if (empty? (record-ref first span-kids))
                                         (record-ref first span-head)
                                         ""))
                     (Nil "")))
        (span-from open) (span-to close) (span-kids ordered)))

(: span-text (-> string Span string))
(defun (span-text text s)
  (substring/cursors text (record-ref s span-from) (record-ref s span-to)))

;; The first clause of a form with this head.
(: clause-of (-> Span string (Option Span)))
(defun (clause-of form head)
  (find #(= (record-ref & span-head) head) (record-ref form span-kids)))

;; The one value a clause holds: `(name (bjorsec))` holds `(bjorsec)`.
(: clause-value (-> Span (Option Span)))
(defun (clause-value form)
  (match (record-ref form span-kids)
    ((Cons _ (Cons value _)) (Some value))
    (_ None)))

;; The manifest as a form, which is the `(package ...)` at the top of the file.
(: manifest-form (-> string (Result string Span)))
(defun (manifest-form text)
  (match (read-form text (string-cursor-start text))
    (None (Err "bjo: the manifest is empty."))
    ((Some (Tuple form _))
     (if (= (record-ref form span-head) "package")
         (Ok form)
         (Err "bjo: the manifest does not begin with a (package ...) form.")))))

;; The name a `(package ...)` entry carries, read with the same parser the
;; command line's name goes through, so that `(my app)` written either way is
;; one name.
(: entry-name (-> string Span (Option (List Symbol))))
(defun (entry-name text entry)
  (def* ((Some clause) (clause-of entry "name") :propagate)
        ((Some value) (clause-value clause) :propagate)
        ((Ok segments) (parse-package-name (span-text text value)) None))
  (Some segments))

;; The `(package ...)` entry for a name, in `depends` or in `dev-depends`.
(: find-entry (-> string Span (List Symbol) (Option Span)))
(defun (find-entry text form name)
  (def entries (list-append (entries-of form "depends") (entries-of form "dev-depends")))
  (find #(match (entry-name text &)
           ((Some other) (= (name->string other) (name->string name)))
           (None #f))
        entries))

(: entries-of (-> Span string (List Span)))
(defun (entries-of form head)
  (def (Some clause) (clause-of form head) Nil)
  (list-filter #(= (record-ref & span-head) "package") (record-ref clause span-kids)))


;; ---------------------------------------------------------------------------
;; Writing the file back
;; ---------------------------------------------------------------------------

;; Replaces the text between two cursors, and keeps the result only if it is
;; still a manifest.
;;
;; The check is the whole safety net of editing text rather than a tree: an
;; edit that lands in the wrong place produces a file that does not parse, and
;; a file that does not parse is put back.
(: put #:sync (-> Project string StringCursor StringCursor string (Result string Unit)))
(defun (put project text from to replacement)
  (def edited (str (substring/cursors text (string-cursor-start text) from)
                   replacement
                   (substring/cursors text to (string-cursor-end text))))
  (match (bjodat-parse-Package edited)
    ((Err why)
     (Err (str "bjo: that edit would have left " (path-combine (project-dir project) manifest-name)
               " unreadable, so it was not made:\n  " why)))
    ((Ok package)
     (file-write-text (path-combine (project-dir project) manifest-name) edited)
     (Ok unit))))

(: manifest-text (-> Project string))
(defun (manifest-text project)
  (file-read-text (path-combine (project-dir project) manifest-name)))

;; How far the entries of a clause are indented, so that an inserted one lines
;; up with the ones that are there. The first entry's column, or four spaces.
(: entry-indent (-> string Span string))
(defun (entry-indent text clause)
  (match (list-filter #(= (record-ref & span-head) "package") (record-ref clause span-kids))
    (Nil "    ")
    ((Cons first _) (column-of text (record-ref first span-from)))))

;; The whitespace at the start of the line a cursor is on.
(: column-of (-> string StringCursor string))
(defun (column-of text c)
  (let go ((at c) (spaces 0))
    (cond
      ((string-cursor<=? at (string-cursor-start text)) (blanks spaces))
      (:def before (string-cursor-prev text at))
      (:def ch (string-cursor-ref text before))
      ((char=? ch #\newline) (blanks spaces))
      ((blank? ch) (go before (+ spaces 1)))
      ;; Something that is not whitespace on this line: the entry does not
      ;; start a line of its own, and a guess at its column would be wrong.
      (else "    "))))

(: blanks (-> int string))
(defun (blanks n)
  (loop (:for i (range 0 n)) (:acc out (stringing #\space)) => out))


;; ---------------------------------------------------------------------------
;; The entry a command writes
;; ---------------------------------------------------------------------------

;; What `bjo add` was told to write.
(type (: Wanted (Record (: wanted-name (List Symbol))
                        (: wanted-source string)
                        (: wanted-req (Option string))
                        (: wanted-dev? bool))))

(: entry-text (-> Wanted string))
(defun (entry-text wanted)
  (str "(package (name " (name->string (record-ref wanted wanted-name)) ")"
       (match (record-ref wanted wanted-req)
         (None "")
         ((Some req) (str " (version " req ")")))
       " (source " (record-ref wanted wanted-source) "))"))


;; ---------------------------------------------------------------------------
;; add
;; ---------------------------------------------------------------------------

;; Adds a dependency clause to the manifest.
;;
;; Into the `(depends ...)` that is there, if there is one — a manifest with
;; its dependencies in one place keeps them in one place — and otherwise a new
;; clause at the end of the form, before its closing paren, which is after
;; everything a person has written in it.
(: add-to-manifest #:sync (-> Project Wanted (Result string Unit)))
(defun (add-to-manifest project wanted)
  (with-return ret
    (def text (manifest-text project))
    (def (Ok form) (manifest-form text) :propagate)
    (def name (record-ref wanted wanted-name))
    (def head (if (record-ref wanted wanted-dev?) "dev-depends" "depends"))

    (when (some? (find-entry text form name))
      (ret (Err (str "bjo add: " (name->string name) " is already a dependency in "
                     (path-combine (project-dir project) manifest-name)
                     ". Change it there, or remove it first."))))

    (match (clause-of form head)
      ;; Into the clause that is there, as its last entry.
      ((Some clause)
       (def close (string-cursor-prev text (record-ref clause span-to)))
       (def at (trim-back text close))
       (put project text at (record-ref clause span-to)
            (str "\n" (entry-indent text clause) (entry-text wanted) ")")))

      ;; A clause of its own, at the end of the manifest.
      (None
       (def close (string-cursor-prev text (record-ref form span-to)))
       (def at (trim-back text close))
       (put project text at (record-ref form span-to)
            (str "\n\n  (" head "\n    " (entry-text wanted) ")\n  )"))))))


;; ---------------------------------------------------------------------------
;; remove
;; ---------------------------------------------------------------------------

;; Takes a dependency out, and the clause with it when it was the last one.
;;
;; A `(depends)` with nothing in it is legal and reads as no dependencies, but
;; it is a line that says nothing, and a manifest nobody has to explain is the
;; point of editing the text in the first place.
(: remove-from-manifest #:sync (-> Project (List Symbol) (Result string Unit)))
(defun (remove-from-manifest project name)
  (with-return ret
    (def text (manifest-text project))
    (def (Ok form) (manifest-form text) :propagate)

    (def (Some entry) (find-entry text form name)
      (Err (str "bjo remove: " (name->string name) " is not a dependency in "
                (path-combine (project-dir project) manifest-name) ".")))

    (def (Ok gone) (put project text (trim-back text (record-ref entry span-from))
                        (record-ref entry span-to) "")
      :propagate)

    ;; Read again: every cursor above pointed into the text as it was.
    (def left (manifest-text project))
    (def (Ok after) (manifest-form left) :propagate)
    (drop-empty-clauses project left after)))

(: drop-empty-clauses #:sync (-> Project string Span (Result string Unit)))
(defun (drop-empty-clauses project text form)
  (match (find #(and (or (= (record-ref & span-head) "depends")
                         (= (record-ref & span-head) "dev-depends"))
                     (empty? (list-filter (fun (k) (= (record-ref k span-head) "package"))
                                          (record-ref & span-kids))))
               (record-ref form span-kids))
    (None (Ok unit))
    ((Some clause)
     (def (Ok gone) (put project text (trim-back text (record-ref clause span-from))
                         (record-ref clause span-to) "")
       :propagate)
     ;; One clause per pass, because the cursors of the other one have moved.
     (def left (manifest-text project))
     (def (Ok after) (manifest-form left) :propagate)
     (drop-empty-clauses project left after))))


;; ---------------------------------------------------------------------------
;; update
;; ---------------------------------------------------------------------------

;; Raises a dependency's lower bound to a version.
;;
;; The constraint is replaced, not merged: `(version-at-least "1.2")` becomes
;; `(version-at-least "1.4")` and an upper bound that was there goes with it,
;; because a bound written for 1.2 says nothing about what 1.4 may be used
;; with. A `version-between` that has to survive an update is one to edit by
;; hand.
(: set-requirement #:sync (-> Project (List Symbol) Version (Result string Unit)))
(defun (set-requirement project name to)
  (with-return ret
    (def text (manifest-text project))
    (def (Ok form) (manifest-form text) :propagate)
    (def written (str "(version (version-at-least \"" (version->string to) "\"))"))

    (def (Some entry) (find-entry text form name)
      (Err (str "bjo update: " (name->string name) " is not a dependency in "
                (path-combine (project-dir project) manifest-name) ".")))

    (match (clause-of entry "version")
      ((Some clause)
       (put project text (record-ref clause span-from) (record-ref clause span-to) written))
      ;; No constraint yet: after the name, where a reader expects it.
      (None
       (match (clause-of entry "name")
         (None (Err (str "bjo update: the entry for " (name->string name)
                         " has no (name ...) clause.")))
         ((Some named)
          (put project text (record-ref named span-to) (record-ref named span-to)
               (str " " written))))))))


;; ---------------------------------------------------------------------------
;; The commands
;; ---------------------------------------------------------------------------

;; The flags these three take, read out of what is left after the command.
;;
;; Read here rather than by `parse-flags`, which stops at the first thing that
;; is not a flag: the name comes first in `bjo add bjorsec --git ...`, so every
;; flag of this command is behind it.
(: flag-value (-> (List string) string (Option string)))
(defun (flag-value arguments flag)
  (match arguments
    (Nil None)
    ((Cons only Nil) None)
    ((Cons a (Cons b rest))
     (if (= a flag) (Some b) (flag-value (Cons b rest) flag)))))

(: has-flag? (-> (List string) string bool))
(defun (has-flag? arguments flag) (any? #(= & flag) arguments))

(: positional (-> (List string) (List string)))
(defun (positional arguments)
  (let go ((left arguments) (out Nil))
    (def (Cons a rest) left
      (list-reverse out))
    (cond
      ;; The flags that take a value, and the value with them.
      ((or (= a "--git") (or (= a "--path") (= a "--at-least")))
       (match rest
         (Nil (list-reverse out))
         ((Cons _ more) (go more out))))
      ((string-starts-with? a "-") (go rest out))
      (else (go rest (Cons a out))))))

(: unknown-flag (-> (List string) (Option string)))
(defun (unknown-flag arguments)
  (find #(and (string-starts-with? & "-")
              (not (or (= & "--git")
                       (or (= & "--path")
                           (or (= & "--at-least") (= & "--dev"))))))
        arguments))

;; The one name these commands take.
(: one-name (-> string (List string) (Result string (List Symbol))))
(defun (one-name command arguments)
  (match (positional arguments)
    (Nil (Err (str "bjo " command ": which package? Name one, as in 'bjo " command " bjorsec'.")))
    ((Cons only Nil) (parse-package-name only))
    (_ (Err (str "bjo " command ": takes one package name.")))))

;; Checks a name may be depended on at all before anything is written.
(: usable-name? (-> Project (List Symbol) (Result string Unit)))
(defun (usable-name? project name)
  (cond
    ((reserved-name? name)
     (Err (str "bjo add: " (name->string name)
               " is part of the standard library, so it is there already.")))
    ((= (name->string name) (name->string (record-ref (project-package project) name)))
     (Err (str "bjo add: " (name->string name) " is this project itself.")))
    (else (Ok unit))))

;; `bjo add <name> --git <url> [--at-least <version>] [--dev]`
;; `bjo add <name> --path <dir> [--dev]`
;;
;; With a git source and no version, the newest release is what you get: the
;; tags are read, the highest is written as a lower bound, and minimal version
;; selection then keeps that version until something asks for more. A
;; repository with no `vX.Y.Z` tag cannot be depended on and says so here,
;; where the alternative — a path source — is still easy to write.
(: cmd-add #:sync (-> Project (List string) (Result string string)))
(defun (cmd-add project arguments)
  (with-return ret
    (def (None) (unknown-flag arguments)
      :fail (((Some flag) (Err (str "bjo add: unknown flag '" flag "'. It takes"
                                    " --git <url>, --path <dir>, --at-least <version> and --dev.")))))
    (def (Ok name) (one-name "add" arguments) :propagate)
    (def (Ok fine) (usable-name? project name) :propagate)

    (def dev? (has-flag? arguments "--dev"))
    (def at-least (flag-value arguments "--at-least"))

    (match (flag-value arguments "--path")
      ((Some dir)
       (when (some? (flag-value arguments "--git"))
         (ret (Err "bjo add: --git and --path are two answers to the same question.")))
       (def (Ok added)
         (add-to-manifest project (Wanted (wanted-name name)
                                          (wanted-source (str "(path (dir \"" dir "\"))"))
                                          (wanted-req None)
                                          (wanted-dev? dev?)))
         :propagate)
       (Ok (str "Added " (name->string name) " from " dir)))

      (None
       (def (Some url) (flag-value arguments "--git")
         (Err (str "bjo add: where does " (name->string name) " come from?"
                   " Write --git <url> to fetch it, or --path <dir> for a copy on this disk.")))
       (def (Ok req) (git-requirement project name url at-least) :propagate)
       (def (Ok added)
         (add-to-manifest project (Wanted (wanted-name name)
                                          (wanted-source (str "(git (url \"" url "\"))"))
                                          (wanted-req (Some req))
                                          (wanted-dev? dev?)))
         :propagate)
       (Ok (str "Added " (name->string name) " " req " from " url))))))

;; The constraint an added git dependency gets: the one that was asked for, or
;; the newest release there is.
(: git-requirement #:sync (-> Project (List Symbol) string (Option string) (Result string string)))
(defun (git-requirement project name url at-least)
  (match at-least
    ((Some written)
     (match (parse-version written)
       ((Err why) (Err (str "bjo add: --at-least " written ": " why)))
       ((Ok v) (Ok (str "(version-at-least \"" (version->string v) "\")")))))
    (None
     (def tool (tool-for (project-tmp project)))
     (def (Ok clone) (ensure-clone tool (project-dot-bjo project) url name) :propagate)
     (def (Ok fetched) (fetch-tags tool clone) :propagate)
     (def (Ok tags) (version-tags tool clone) :propagate)
     (match (newest tags)
       (None (Err (str "bjo add: " url " has no vX.Y.Z tag, so there is no version to"
                       " depend on. Tag a release there, or depend on a copy on this"
                       " disk with --path.")))
       ((Some v) (Ok (str "(version-at-least \"" (version->string v) "\")")))))))

;; `list-foldl` hands the item first and the accumulator second.
(: newest (-> (List Version) (Option Version)))
(defun (newest versions)
  (list-foldl (fun (v best)
                (match best
                  (None (Some v))
                  ((Some had) (if (> (version-compare v had) 0) (Some v) best))))
              None
              versions))

;; `bjo remove <name>`
(: cmd-remove #:sync (-> Project (List string) (Result string string)))
(defun (cmd-remove project arguments)
  (def (Ok name) (one-name "remove" arguments) :propagate)
  (def (Ok gone) (remove-from-manifest project name) :propagate)
  (Ok (str "Removed " (name->string name))))

;; Which dependency clause a name refers to. A signature of its own, because a
;; lambda's parameter has no type until something gives it one, and `name` is a
;; field of three of the records in scope here.
(: dep-named? (-> Dep (List Symbol) bool))
(defun (dep-named? dep wanted)
  (= (name->string (record-ref dep name)) (name->string wanted)))

;; `bjo update [name]`
;;
;; Under minimal version selection a build does not drift: the version in the
;; lock is the one the manifests ask for, and a new release changes nothing
;; until a manifest asks for it. This is that asking — it raises *your* lower
;; bounds to what the repositories have now, which is the one thing that
;; cannot happen by itself.
(: cmd-update #:sync (-> Project (List string) (Result string string)))
(defun (cmd-update project arguments)
  (with-return ret
    (def package (project-package project))
    (def clauses (list-append (record-ref package depends) (record-ref package dev-depends)))
    (def wanted (positional arguments))

    (def chosen
      (match wanted
        (Nil (Ok clauses))
        ((Cons only Nil)
         (def (Ok name) (parse-package-name only) :propagate)
         (match (find #(dep-named? & name) clauses)
           (None (Err (str "bjo update: " (name->string name) " is not a dependency of "
                           (name->string (record-ref package name)) ".")))
           ((Some dep) (Ok (Cons dep Nil)))))
        (_ (Err "bjo update: takes one package name, or none for all of them."))))

    (def (Ok deps) chosen :propagate)
    (def tool (tool-for (project-tmp project)))
    (update-each project tool deps Nil)))

(: update-each #:sync (-> Project Tool (List Dep) (List string) (Result string string)))
(defun (update-each project tool deps said)
  (match deps
    (Nil (Ok (if (empty? said)
                 "Nothing to update: every dependency is at the newest release there is."
                 (string-join (list->vec (list-reverse said)) "\n"))))
    ((Cons dep rest)
     (def name (record-ref dep name))
     (match (record-ref dep source)
       ;; A path dependency is whatever is in that directory today, so there is
       ;; no version here to raise.
       ((Some (FromGit source))
        (def (Ok line) (update-one project tool name (record-ref source url) (record-ref dep version))
          :propagate)
        (update-each project tool rest (match line
                                         ((Some text) (Cons text said))
                                         (None said))))
       (_ (update-each project tool rest said))))))

(: update-one #:sync (-> Project Tool (List Symbol) string (Option VersionReq)
                         (Result string (Option string))))
(defun (update-one project tool name url had)
  (with-return ret
    (def (Ok clone) (ensure-clone tool (project-dot-bjo project) url name) :propagate)
    (def (Ok fetched) (fetch-tags tool clone) :propagate)
    (def (Ok tags) (version-tags tool clone) :propagate)

    (def (Some best) (newest tags)
      (Err (str "bjo update: " url " has no vX.Y.Z tag, so " (name->string name)
                " has no version to be raised to.")))

    (def was (match had
               (None (version 0 0 0))
               ((Some (AtLeast lo)) lo)
               ((Some (Between lo hi)) lo)
               ((Some (AtMost hi)) (version 0 0 0))))

    (when (<= (version-compare best was) 0) (ret (Ok None)))

    (def (Ok written) (set-requirement project name best) :propagate)
    (Ok (Some (str "  " (name->string name) " at least " (version->string best)
                   " (was " (version->string was) ")")))))
