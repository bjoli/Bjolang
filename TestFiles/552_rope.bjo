(import (std prelude))
(import (std simpletest))
(import (std rope))

;; A text of `n` numbered lines, a few characters of them not ASCII.
(: (-> int string))
(defun (lines-of n)
  (def b (stringbuilder-empty))
  (loop (:for i (range 0 n)) (:do (stringbuilder-add-string! b #"line ${i}: blåbär €\n")))
  (stringbuilder->string b))

(: (-> (-> void) string))
(defun (outcome f)
  (def inner (fun () (match (try (f) #:catch (System.ArgumentOutOfRangeException)) ((Ok _) "done") ((Err _) "out of range"))))
  (match (try (inner) #:catch (System.ArgumentException)) ((Ok s) s) ((Err _) "mid-character")))

(: (-> int string string))
(defun (repeated n s)
  (def b (stringbuilder-empty))
  (loop (:for _ (range 0 n)) (:do (stringbuilder-add-string! b s)))
  (stringbuilder->string b))

(defun (main)
  ;; The module's example.
  (def r (string->rope "hello world\nsecond line"))
  (def r2 (rope-insert r 5 ","))
  (expect "insert" (rope->string r2) "hello, world\nsecond line")
  (expect "delete" (rope->string (rope-delete r2 5 6)) "hello world\nsecond line")
  (expect "a line" (rope-line r2 1) "second line")
  (expect "the line of an offset" (rope-line-of r2 15) 1)
  (expect "search" (rope-index-of r2 "world") (Some 7))
  (expect "the old rope is unchanged" (rope->string r) "hello world\nsecond line")

  ;; A rope of many chunks.
  (def text (lines-of 2000))
  (def big (string->rope text))
  (expect "a tree" (> (rope-height big) 0) #t)
  (expect "sound" (rope-check big) None)
  (expect "bytes" (rope-length big) (string-length text))
  (expect "characters" (rope-char-count big) (.Count text))
  (expect "lines" (rope-line-count big) 2001)
  (expect "line 1234" (rope-line big 1234) "line 1234: blåbär €")
  (expect "the line of its start" (rope-line-of big (rope-line-start big 1234)) 1234)
  (def (Tuple a b) (rope-split big (rope-line-start big 1500)))
  (expect "split and join" (= (rope-concat a b) big) #t)
  (expect "equal texts hash alike" (= (eq-hash (rope-concat a b)) (eq-hash big)) #t)
  (def s5 (rope-line-start big 5))
  (def s10 (rope-line-start big 10))
  (expect "a slice" (rope->string (rope-slice big s5 s10)) (string-copy (.SliceBytes text s5 (- s10 s5))))
  (expect "a match across chunks" (rope-index-of big "line 1999: ") (Some (rope-line-start big 1999)))

  ;; Typing into a transient, with a rope taken halfway.
  (def t (rope->transientrope big))
  (def at (rope-line-start big 1000))
  (loop (:for i (range 0 500)) (:do (transientrope-insert! t (+ at i) "x")))
  (def mid (transientrope->rope t))
  (loop (:for _ (range 0 200)) (:do (transientrope-delete! t (+ at 299) (+ at 300))))
  (transientrope-insert! t at "€")
  (def done (transientrope->rope t))
  (expect "the transient's length" (transientrope-length t) (+ (string-length text) 303))
  (expect "the rope taken halfway" (rope-substring mid at (+ at 500)) (repeated 500 "x"))
  (expect "is sound" (rope-check mid) None)
  (expect "the rope at the end" (rope-line done 1000) #"€${(repeated 300 "x")}line 1000: blåbär €")
  (expect "is sound too" (rope-check done) None)
  (expect "the first rope is unchanged" (rope->string big) text)

  ;; Cursors.
  (def tr (string->rope "one two\nthree"))
  (def c (option-ref (rope-cursor-search (rope-cursor-start tr) "two")))
  (expect "a cursor found" (rope-cursor-offset c) 4)
  (expect "its character" (rope-cursor-ref c) #\t)
  (expect "four on" (rope-cursor-line (rope-cursor-forward c 4)) 1)
  (expect "a loop from it" (loop (:for ch c) (:acc (stringing ch))) "two\nthree")
  (expect "a loop back from it" (loop (:for ch (rope-backward c)) (:acc (stringing ch))) " eno")
  (expect "the column" (rope-cursor-column (rope-cursor-forward c 6)) 2)
  (expect "a line down, same column"
          (rope-cursor-offset (rope-cursor-at-line tr 1 #:column (rope-cursor-column c))) 12)
  (expect "the end of its line" (rope-cursor-offset (rope-cursor-line-end c)) 7)
  (expect "back to a space" (rope-cursor-offset (option-ref (rope-cursor-find-backward char-whitespace? c))) 3)
  (expect "between two cursors" (rope-cursor-substring c (rope-cursor-line-end c)) "two")
  (def bc (rope-cursor-at big (rope-line-start big 1500)))
  (expect "a search back across chunks"
          (rope-cursor-offset (option-ref (rope-cursor-search-backward bc "line 1234: "))) (rope-line-start big 1234))
  (expect "steps across chunks"
          (rope-cursor-offset (rope-cursor-back (rope-cursor-forward bc 5000) 5000)) (rope-cursor-offset bc))
  (expect "cursors compare" (rope-cursor<? (rope-cursor-start big) bc) #t)

  ;; Errors.
  (expect "an offset in a character" (outcome (fun () (ignore (rope-insert big 14 "x")))) "mid-character")
  (expect "an offset outside" (outcome (fun () (ignore (rope-delete big 0 (+ (rope-length big) 1))))) "out of range")
  (expect "a transient offset in a character" (outcome (fun () (transientrope-insert! t (+ at 1) "x"))) "mid-character")
  (expect "the transient is unchanged" (transientrope->rope t) done)
  0)
