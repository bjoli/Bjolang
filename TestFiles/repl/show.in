;; Before the import, random-int is not a name an entry could write.
:show random-int
(import (std random))
:show random-int
;; Other visible names containing the text, in any case, with their summaries.
:show RANDOM-U
;; A prefixed import: the visible name, and the one it has where it is defined.
(import (prefix (std random) "r/"))
:show r/random-bool
;; Visible, but not documented.
:show fold-left
;; A doc written at the prompt.
(: twice (-> int int)) (defun (twice x) (* 2 x)) (:doc twice (summary "Doubles.") (arg x "A number.") (returns "2x."))
:show twice
:show no-such-name-anywhere
:show
(twice 4)
