;; A call of a function written #:inline that takes keyword parameters is
;; copied, also from another module: the call is gone, and a default the call
;; leaves out is in the copy.

(export scaled-here noted-here)

(import (std prelude))
(import "../inc/keyword_inline.bjo")

;; EXPECT-NO-CS: \bscaled\(
;; EXPECT-CS: keyword_inline_Module\.secretsubbonus\(x\)
(: (-> int int))
(defun (scaled-here x) (scaled x #:by 3))

;; EXPECT-NO-CS: notedsubsum\(
;; EXPECT-CS: note_BANG\(t, __Literals\.\w+\.Value, 5\)
(: (-> Trace int))
(defun (noted-here t) (noted-sum t 1))
