(type
  (: Point (Struct 
             (: x int) 
             (: y int))))

(defun (main args)
    (def p1 (Point (x 10) (y 20)))
    (displayln (int->string (struct-get p1 x)))
    (displayln (int->string (struct-get p1 y)))

    (def p2 (struct-set p1 (x 100)))
    (displayln (int->string (struct-get p2 x)))
    (displayln (int->string (struct-get p2 y)))

    0)
