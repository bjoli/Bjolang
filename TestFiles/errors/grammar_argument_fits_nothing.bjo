;; A value given where a production is expected, of a type no alternative
;; takes, is refused with what the grammar takes.
;; EXPECT-ERROR: Piece: expected a string, an int or a (Vec
;; EXPECT-ERROR: found 'x', a number with a fraction.
(import (std prelude))

(def/grammar Piece
  (:or (: PStr string) (: PInt int) (: PMany (Vec Piece))))

(: (-> Piece int))
(defun (f p) 1)

(defun (main)
  (def x 1.5)
  (println (f x))
  0)
