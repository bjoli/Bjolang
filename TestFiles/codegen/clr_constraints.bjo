;; What a CLR constraint compiles to.
;;
;; The whole point of one is that it costs nothing at runtime, and no
;; behavioural test can see the difference between that and a dictionary: both
;; produce the right answer. What is being pinned is that the constraint becomes
;; a `where` clause and the body stays the C# operator.

(import (std prelude))

(def/trait (Num %a)
  (#:clr-constraint (System.Numerics.INumber %a)))

;; A `where` clause on the type parameter, no dictionary parameter, and a plain
;; `+` in the body. A dictionary would show up as an extra first argument.
;; EXPECT-CS: T_a addsubthem<T_a>\(T_a a, T_a b\) where T_a : System.Numerics.INumber<T_a>
;; EXPECT-CS: return \(a \+ b\);
(: add-them (-> %a %a %a) (where (Num %a)))
(defun (add-them a b) (+ a b))

;; One clause per constrained variable.
;; EXPECT-CS: where T_a : System.Numerics.INumber<T_a> where T_b : System.Numerics.INumber<T_b>
(: both (-> %a %b %a) (where (Num %a) (Num %b)))
(defun (both a b) (+ a a))

;; A caller at a concrete type passes no evidence: `int` satisfies the interface
;; or it does not, and either way there is nothing to hand over.
;; EXPECT-CS: return clr_constraints_Module\.addsubthem\(1, 2\);
(: at-int (-> int))
(defun (at-int) (add-them 1 2))

;; The trait itself emits no C# interface — the one it names already exists in
;; the framework. That cannot be written as an `EXPECT-CS`, which only asserts
;; matches; what stands in for it is `add-them` above having two parameters
;; rather than three, since an emitted interface is only ever reached through a
;; dictionary that would be the third.

;; ---------------------------------------------------------------------------
;; Members
;; ---------------------------------------------------------------------------

;; The trait emits one generic method per member, constrained by the interface.
;; `zeroish` is the reason they exist rather than emitting `int.IsZero(x)`
;; directly: `IsZero` is an *explicit* interface implementation on the
;; primitives, so that spelling does not compile, while through a constrained
;; type parameter every member is reachable.
;; EXPECT-CS: public static class Arith_Clr \{
;; EXPECT-CS: public static T_a bare<T_a>\(T_a a0\) where T_a : System.Numerics.INumber<T_a> => T_a\.Abs\(a0\);
;; EXPECT-CS: public static bool zeroish<T_a>\(T_a a0\) where T_a : System.Numerics.INumber<T_a> => T_a\.IsZero\(a0\);
(def/trait (Arith %a)
  (#:clr-constraint (System.Numerics.INumber %a))
  (: bare    (-> %a %a)   #:clr-member Abs)
  (: zeroish (-> %a bool) #:clr-member IsZero))

;; An instance member takes its receiver from the first argument, so the helper
;; body is a call *on* the value rather than on the type.
;; EXPECT-CS: public static int rel<T_a>\(T_a a0, T_a a1\) where T_a : System.IComparable<T_a> => a0\.CompareTo\(a1\);
(def/trait (Order %a)
  (#:clr-constraint (System.IComparable %a))
  (: rel (-> %a %a int) #:clr-member CompareTo))

;; Every call goes through the helper, and the concrete case differs from the
;; generic one only in the type argument.
;; EXPECT-CS: return Arith_Clr\.bare<int>\(-5\);
(: at-a-type (-> int))
(defun (at-a-type) (bare -5))

;; EXPECT-CS: return Arith_Clr\.bare<T_a>\(x\);
(: at-a-variable (-> %a %a) (where (Arith %a)))
(defun (at-a-variable x) (bare x))

;; `string` reaches `Order`, which no System.Numerics constraint would allow.
;; EXPECT-CS: where T_a : System.IComparable<T_a>
(: compare-them (-> %a %a int) (where (Order %a)))
(defun (compare-them a b) (rel a b))
