;; An implementation whose method adds at its own type variable needs
;; `(where (Num %a))` on the implementation, which has the class's type
;; parameter. A method has no signature of its own to write it in.

;; EXPECT-ERROR: which the implementation does not declare

(import (std prelude))

(def/trait (Grow %s)
  (type %elem)
  (: grow (-> %s %elem %elem)))

(type (: (By %a) (Union (: by %a))))

(impl (Grow (By %a))
  (type %elem %a)
  (defun (grow s x)
    (match s ((by k) (+ k x)))))

(defun (main args) 0)
