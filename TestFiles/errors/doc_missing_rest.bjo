;; A rest parameter is documented like an argument.

;; EXPECT-ERROR: does not document the rest parameter xs

(import (std prelude))

(:doc total (summary "Adds.") (returns "The sum."))
(: total (-> #:rest int int))
(defun (total #:rest xs) (loop (:for x xs) (:acc s (summing x))))

(defun (main args) 0)
