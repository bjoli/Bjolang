;; The else body runs because a clause did not match, so nothing any clause
;; would have bound is in scope in it.
;;
;; `x` is bound by the first clause and is visible in the second clause's
;; scrutinee and in the sequel — but not here, where the reason for running is
;; that some clause failed. Which one failed is not known, so no binding from
;; any of them can be relied on.

;; EXPECT-ERROR: Unbound variable: x

(import (std prelude))

(: f (-> (Option int) (Option int) string))
(defun (f a b)
  (def/else* (((Some x) a)
              ((Some y) b))
    (int->string x))
  (int->string (+ x y)))
