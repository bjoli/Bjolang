(import (std prelude))

;; Sound, and still rejected. `Nil` is a syntactic value, so generalizing it is
;; perfectly legitimate — but a module-level value compiles to a static field,
;; and a static field cannot be generic: there is no class for the type
;; parameter to belong to.
;;
;; EXPECT-ERROR: the type of 'bleh' is still open
;; EXPECT-ERROR: which cannot be generic
;;
;; The fixes the message names both work:
;;   (: bleh (List int)) above the def, or
;;   (defun (bleh) '()) instead of a value.
(def bleh '())

(defun (main args)
  (displayln (int->string (list-length bleh)))
  0)
