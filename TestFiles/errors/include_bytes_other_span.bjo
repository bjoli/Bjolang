;; EXPECT-ERROR: 'x' is a module-level definition of type (System.ReadOnlySpan byte). A module-level value is a static field, and a span cannot be one
;;
;; A module-level span that is not an include-bytes is still a field.
(import (std prelude))
(def x (ro-span-slice (include-bytes "../assets/include-bytes/bytes.bin") #:to 2))
(defun (main) 0)
