;; `list`, the variadic list constructor — a special form and a first-class value.
;;
;; `(list e1 e2 ...)` is a *special form* desugared by the parser to an `EList`
;; node, identically to how `[e1 e2 ...]` produces `EVec`. That means:
;;   - It cannot be shadowed in call position (just like `if` or `when`).
;;   - It does not go through the rest-argument machinery at call sites.
;;
;; `list` in *value position* (bare, not applied) is still an ordinary prelude
;; function with type `(-> (Array %a) (List %a))`. That is the type `#:rest`
;; always resolves to, and it is what aliases and higher-order uses see.
;;
;; Two things here were broken before and are the point of the test:
;;
;;   - `def` never registered `FunMeta`, so aliasing a variadic function bound
;;     its array form and `(f 1 2 3)` failed on arity.
;;   - A rest call handed `TApply` its arguments spread flat and relied on C#
;;     `params` to reassemble them. That works only when the callee is emitted
;;     as a real `params` method; through a delegate it produced C# that did
;;     not compile.
(import (std prelude))
(import (std simpletest))

(: same? (-> (List int) (List int) bool))
(defun (same? a b)
  (if (list-empty? a)
      (list-empty? b)
      (if (list-empty? b)
          #f
          (if (= (list-head a) (list-head b))
              (same? (list-tail a) (list-tail b))
              #f))))

;; An alias needs a signature: `def` cannot guess a call's shape, and a
;; module-level value may not have an open type — a static field cannot be
;; generic. So the element type is pinned here rather than left polymorphic.
(: f (-> #:rest int (List int)))
(def f list)

;; The same function at the type it actually has. `#:rest` is a property of the
;; call site, not of the type, so as a value `list` takes the array.
(: g (-> (Array int) (List int)))
(def g list)

;; Shadowing `list` as a local name is fine — only the bare reference is
;; affected, not the special form. The special form `(list ...)` is always
;; parsed as a list literal regardless of what `list` is bound to.
(: shadowed (-> int))
(defun (shadowed)
  (let ((add1 (fun (n) (+ n 1))))
    (add1 5)))

(defun (main)
  ;; Variadic calls, at several arities and element types.
  (expect "three ints" (list-length (list 1 2 3)) 3)
  (expect "empty" (list-length (list)) 0)
  (expect "head" (list-head (list 7 8 9)) 7)
  (expect "strings" (list-head (list "a" "b")) "a")

  ;; The nested call is an ordinary argument, not a flattened one.
  (expect "nested" (list-length (list (list 1 2) (list 3))) 2)

  ;; Same value as the Cons spelling it replaces.
  (expect "agrees with Cons"
          (if (same? (list 1 2 3) (Cons 1 (Cons 2 (Cons 3 Nil)))) "yes" "no")
          "yes")

  ;; The alias spreads at its own call sites.
  (expect "aliased variadic" (list-length (f 1 2 3 4 5)) 5)
  (expect "aliased empty" (list-length (f)) 0)
  (expect "alias agrees with list"
          (if (same? (f 1 2 3) (list 1 2 3)) "yes" "no")
          "yes")

  ;; Value position: `list` really is the array function.
  (let ((arr (make-array 3)))
    (array-set! arr 0 10)
    (array-set! arr 1 20)
    (array-set! arr 2 30)
    (expect "array form" (if (same? (g arr) (list 10 20 30)) "yes" "no") "yes")
    (expect "array form length" (list-length (g arr)) 3))

  ;; A local binding over a different name; the special form is unaffected.
  (expect "shadowed" (shadowed) 6)

  ;; The special form works anywhere.
  (expect "still works" (list-length (list 1 2)) 2)
  0)
