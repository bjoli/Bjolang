;; A redirection missing one of its two arguments.
;;
;; `into-file` is `(FInto string Form)`: a file name and the one form to run.
;; The tag is consumed and its arguments are read where the literal is written,
;; so a form with one of them is refused there — the same shape of error a
;; misspelled tag or a stray stage now gets, rather than an `Err` from `run`.

;; EXPECT-ERROR: takes 2 arguments

(import (std prelude))
(import (std run))

(defun (main args)
  (match (run/string '(into-file "out.txt"))
    ((Ok s) 0)
    ((Err e) 0))
  0)
