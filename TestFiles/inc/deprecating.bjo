;; A module that deprecates one of its functions, for
;; warnings/deprecated_imported.bjo to import. The text travels with the
;; binding.
(import (std prelude))

(export old-double new-double)

(: new-double (-> int int))
(defun (new-double x) (* 2 x))

(: old-double (-> int int))
(defun (old-double x) (new-double x))
(:deprecated old-double "use `new-double`")
