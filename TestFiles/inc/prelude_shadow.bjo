;; A module whose exports take over names the prelude exports too, for
;; `243_imported_def_shadow.bjo`.
;;
;; `list-append` keeps the prelude's own type, so nothing but the name says which
;; of the two a call means. `getenv` is an operation of the prelude's `Env`
;; effect, taken over at another type.
(import (std prelude))

(export list-append getenv twice inside)

;; The other way round: `ys` first.
(: list-append (-> (List %a) (List %a) (List %a)))
(defun (list-append xs ys) (list-foldr Cons xs ys))

(: getenv (-> string string))
(defun (getenv name) (string-append "no " name))

;; `prelude_shadow_b.bjo` exports this name at this type as well.
(: twice (-> int int))
(defun (twice n) (* n 2))

(: inside (-> (List int)))
(defun (inside) (list-append (list 1) (list 2)))
