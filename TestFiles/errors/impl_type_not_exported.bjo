;; A library publishing an implementation whose associated type it did not
;; export.
;;
;; Refused where the library is built, for the same reason as
;; `type_not_exported.bjo`. The message has to name the implementation: the
;; export list does not mention impls, so a reader told only the type is left
;; grepping for whatever dragged it across.

;; EXPECT-ERROR: the implementation of 'Peek' for 'Shown'
;; EXPECT-ERROR: names the type 'Hidden'
;; EXPECT-ERROR: declares and does not export

(import "../srcimport/leaky_impl.bjo")

(defun (main args)
  (println (->str (peek (Shown (n 1)))))
  0)
