;; EXPECT-ERROR: They differ inside the phantom_tag_mismatch/Id: phantom_tag_mismatch/User against phantom_tag_mismatch/Order.
;;
;; An `(Id Order)` is no `(Id User)`, though both are an int when the program
;; runs.

(import (std prelude))

(type (: User (Union)))
(type (: Order (Union)))
(type (: (Id %a) (Newtype int)))

(: lookup-user (-> (Id User) string))
(defun (lookup-user i) "ada")

(: order-id (Id Order))
(def order-id (Id 7))

(defun (main)
  (println (lookup-user order-id))
  0)
