;; Docs for std/atomic.bjo, read through (:doc #:file "atomic.bjodoc"). The
;; texts are samizdat markup: code in prose is @code{...}.

(:doc #:module
  (summary "Lock-free atomic references with hardware-accelerated integer operations for int, uint, long, and ulong.")
  (see make-atomic atomic-update! atomic-compare-and-swap! AtomicInteger)
  (example """
    (import (std atomic))

    (def hits (make-atomic 0L))
    (atomic-increment! hits)                 ; 1L
    (atomic-add! hits 10L)                   ; 11L
    (atomic-swap! hits 0L)                   ; 11L, hits reset to 0L

    (def names (make-atomic (list "ada")))
    (atomic-update! names (fun (ns) (Cons "bea" ns)))   ; ("bea" "ada")
    """)
  (reference """
    @code{(Atomic T)} holds a single value of type T. All operations are
    atomic and memory-fenced; concurrent accesses across threads execute
    sequentially without tearing.

    @strong{Return values.} @code{atomic-swap!} and
    @code{atomic-compare-and-swap!} return the value prior to modification.
    @code{atomic-update!}, @code{atomic-increment!},
    @code{atomic-decrement!}, @code{atomic-add!}, and @code{atomic-sub!}
    return the updated value.

    @strong{Equality comparisons.} @code{atomic-compare-and-swap!} compares
    the current value against an expected value. Reference types (records,
    lists, strings) compare by reference identity (@code{eq?}). Value types
    (structs, @code{Option}, primitive integers) compare by value.

    @strong{Reference vs content safety.} Atomicity applies strictly to the
    stored reference or struct value itself. Internal mutations to mutable
    objects referenced by the cell (such as arrays or mutable vectors) are not
    synchronized. Use persistent structures updated via @code{atomic-update!}
    for thread-safe compound state.

    @strong{Integer operations.} The @code{AtomicInteger} trait provides
    @code{atomic-increment!}, @code{atomic-decrement!}, @code{atomic-add!},
    and @code{atomic-sub!}. Implementations for @code{int}, @code{uint},
    @code{long}, and @code{ulong} delegate directly to
    @code{System.Threading.Interlocked}. Operations wrap on overflow (two's
    complement arithmetic). Using integer operations on unsupported types
    produces compile errors.

    @strong{Integer width.} Width is determined by type inference or literal
    suffixes. Use @code{0L} or @code{0UL}, or explicit type annotations like
    @code{(: hits (Atomic ulong))}, to avoid overflow on large counters.
    """))

(:doc Atomic
  (summary "Thread-safe atomic reference cell holding a value of type %a.")
  (tparam %a "The type of the contained value.")
  (see make-atomic atomic-ref AtomicInteger))

(:doc make-atomic
  (summary "Creates a new atomic cell initialized with a value.")
  (arg value "Initial value stored in the cell.")
  (returns "A new atomic reference cell.")
  (example """
    (make-atomic 0)            ; an (Atomic int)
    (make-atomic 0L)           ; an (Atomic long)
    (make-atomic 0UL)          ; an (Atomic ulong)
    (make-atomic (list 1 2))   ; an (Atomic (List int))
    """)
  (reference """
    The cell's type is inferred from @code{value}. Untyped integer literals
    default to @code{int}. Use @code{0L} or @code{0UL} for 64-bit counters to
    prevent wrapping.
    """))

(:doc atomic-ref
  (summary "Returns the current value in the atomic cell.")
  (arg a "The atomic cell.")
  (returns "The currently stored value."))

(:doc atomic-set!
  (summary "Stores a value in the atomic cell with a full memory barrier.")
  (arg a "The atomic cell to update.")
  (arg value "The new value to store.")
  (reference """
    Emits a full memory barrier. Preceding and subsequent memory operations on
    the executing thread cannot be reordered across this store.
    """))

(:doc atomic-swap!
  (summary "Replaces the value in the atomic cell, returning the previous value.")
  (arg a "The atomic cell to update.")
  (arg value "The new value to store.")
  (returns "The value held immediately before the swap."))

(:doc atomic-compare-and-swap!
  (summary "Stores desired if current value equals expected, returning previous value.")
  (arg a "The atomic cell.")
  (arg expected "Value expected to be currently in the cell.")
  (arg desired "New value to store if comparison succeeds.")
  (returns "The value held before the operation. The store succeeded if and only if this equals expected.")
  (example """
    (def a (make-atomic 5))
    (atomic-compare-and-swap! a 5 6)   ; 5 (succeeded; a now holds 6)
    (atomic-compare-and-swap! a 5 7)   ; 6 (failed; a unchanged at 6)
    """)
  (reference """
    Reference types compare by reference identity (@code{eq?}). Value types
    compare by value.
    """))

(:doc atomic-update!
  (summary "Applies a pure function to the value using a compare-and-swap retry loop.")
  (arg a "The atomic cell to update.")
  (arg f "Pure transformation function mapping old value to new value.")
  (returns "The updated value stored in the cell.")
  (example """
    (def seen (make-atomic (list)))
    (atomic-update! seen (fun (xs) (Cons 3 xs)))   ; (3)
    """)
  (reference """
    Retries in a loop if concurrent threads modify the value between read and
    store. Under contention, f may execute multiple times. Function f must be
    free of side effects (no I/O, mutation, or logging).
    """))

(:doc AtomicInteger
  (summary "Trait providing atomic arithmetic operations (increment, decrement, add, subtract).")
  (tparam %a "The integer type in the atomic cell.")
  (see atomic-increment! atomic-add! atomic-update!)
  (reference """
    Implemented for @code{int}, @code{uint}, @code{long}, and @code{ulong} via
    direct calls to @code{System.Threading.Interlocked}.

    Custom types may implement this trait using @code{atomic-update!}.

    Implementations must uphold these invariants:

    @itemlist{
      @item{Operations must execute atomically.}
      @item{Operations must return the updated value.}
      @item{Built-in integer operations wrap on overflow using two's complement
        arithmetic.}
    }
    """)
  (example """
    (type (: Score (Struct (: points int))))

    (impl (AtomicInteger Score)
      (defun (atomic-increment! a) (atomic-add! a (Score (points 1))))
      (defun (atomic-decrement! a) (atomic-sub! a (Score (points 1))))
      (defun (atomic-add! a n)
        (atomic-update! a (fun (s) (Score (points (+ (.points s) (.points n)))))))
      (defun (atomic-sub! a n)
        (atomic-update! a (fun (s) (Score (points (- (.points s) (.points n))))))))
    """))

(:doc atomic-increment!
  (summary "Increments the integer in the atomic cell by 1, returning the new value.")
  (arg a "The atomic cell.")
  (returns "The updated value after incrementing."))

(:doc atomic-decrement!
  (summary "Decrements the integer in the atomic cell by 1, returning the new value.")
  (arg a "The atomic cell.")
  (returns "The updated value after decrementing."))

(:doc atomic-add!
  (summary "Adds n to the integer in the atomic cell, returning the new value.")
  (arg a "The atomic cell.")
  (arg n "The value to add.")
  (returns "The updated value after adding n."))

(:doc atomic-sub!
  (summary "Subtracts n from the integer in the atomic cell, returning the new value.")
  (arg a "The atomic cell.")
  (arg n "The value to subtract.")
  (returns "The updated value after subtracting n."))
