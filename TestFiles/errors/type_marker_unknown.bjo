;; An unrecognised marker on a type definition.
;;
;; Named rather than ignored, for the reason `#:literal` and `#:mutable` are:
;; a marker that silently did nothing would be a declaration the author believed
;; they had written.

;; EXPECT-ERROR: Unknown marker #:banana
;; EXPECT-ERROR: The only one is #:opaque

(type (: Crate #:banana (Union MkCrate)))

(defun (main args) 0)
