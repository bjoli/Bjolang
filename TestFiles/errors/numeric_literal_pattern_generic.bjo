;; EXPECT-ERROR: is matched against a generic type
;;
;; A pattern is emitted as a C# `case` label, so a literal in one has to have
;; its type settled where it is written: there is no obligation for it to carry
;; and no `CreateChecked` a constant expression could be built by. An expression
;; literal reaches a type variable and a pattern literal cannot, and the
;; difference is worth a diagnostic that says which one this is.
(import (std prelude))

(: name-of (-> %a string))
(defun (name-of x)
  (match x
    (5 "five")
    (_ "other")))

(defun (main)
  (displayln (name-of 5))
  0)
