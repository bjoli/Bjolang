;; An id per kind of thing, for `463_phantom_newtype.bjo`: a newtype whose
;; type parameter its representation does not use, and functions generic over
;; that parameter, called from another module.
(export Id id-value next-id)

(import (std prelude))

(type/derive (Eq Ord)
  (: (Id %a) (Newtype int)))

(: id-value (-> (Id %a) int))
(defun (id-value i) (match i ((Id n) n)))

(: next-id (-> (Id %a) (Id %a)))
(defun (next-id i) (match i ((Id n) (Id (+ n 1)))))
