;; A main that does not return an int exits with 0: here it ends in a
;; println, and the run succeeds. A main that returns an int exits with it,
;; as every other test's 0 does.
(import (std prelude))
(import (std simpletest))

(defun (main)
  (expect "a main may end in what is not an int" (+ 1 1) 2)
  (println "done"))
