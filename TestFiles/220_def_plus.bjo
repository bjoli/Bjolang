;; `def+` produces the value of the whole form.
;;
;; An arm is the form's other arm, exactly as an `if`'s is: whichever arm runs,
;; its value is the form's. It jumps nowhere by itself, so a body that means to
;; leave an enclosing block writes the `(ret ...)` that leaves it, and that
;; `ret` is an ordinary tail-position form there.
;;
;; `219_with_return.bjo` covers the form as it behaves inside a block; this file
;; covers it as a value, and covers what the arms are for: they match the same
;; scrutinee the binder does, so an arm may bind what the failure carried, and
;; between them they have to cover the type.

(import (std prelude))
(import (std simpletest))

(: parse-int (-> string (Result string int)))
(defun (parse-int s)
  (if (= s "12") (Ok 12) (Err (str "not a number: " s))))

;; --- Outside any block: the arm is simply the other branch -----------------
(: label (-> string string))
(defun (label s)
  (def+ ((Ok n) (parse-int s))
        ((Err _) "unparseable"))
  (str "n = " (int->string n)))

;; --- An arm binds what the failure carried ---------------------------------
;;
;; The arms match the same scrutinee, so `(Err why)` is an ordinary pattern over
;; it and `why` is in scope in that arm. Nothing the *binder* would have bound
;; is: `errors/def_plus_arm_sees_no_binding.bjo` is where that half lives.
(: explain (-> string string))
(defun (explain s)
  (def+ ((Ok n) (parse-int s))
        ((Err why) (str "refused (" why ")")))
  (str "accepted " (int->string n)))

;; --- Arms that need no wildcard --------------------------------------------
;;
;; `Cons` and `Nil` are the whole of `List`, so the two of them cover it and
;; there is nothing left to write an `_` for. A value that reached neither would
;; be `errors/def_plus_not_exhaustive.bjo`.
(: head-or (-> (List string) string))
(defun (head-or xs)
  (def+ ((Cons first _) xs)
        (Nil "empty"))
  (str "first = " first))

;; --- Three arms over one scrutinee ------------------------------------------
(type (: Colour (Union Red Green Blue)))

(: warm? (-> Colour string))
(defun (warm? c)
  (def+ (Red c)
        (Green "cool")
        (Blue "cool"))
  "warm")

;; --- Inside a block, with the escape written out ---------------------------
;;
;; What an implicit jump would have done, said in the ordinary way. `(ret ...)`
;; is in tail position of the arm, which is where `checkEscapeUses` allows it.
(: inside (-> string (Result string int)))
(defun (inside s)
  (with-return ret
    (def+ ((Ok n) (parse-int s))
          ((Err _) (ret (Err "bad input"))))
    (Ok (+ n 1))))

;; --- A void body ------------------------------------------------------------
;;
;; The sequel produces nothing, so an arm may not produce anything either.
(: shout (-> (Option string) void))
(defun (shout o)
  (def+ ((Some msg) o)
        (None (println "nothing to shout")))
  (println msg))

;; --- Not in tail position: the declare-and-assign path ---------------------
;;
;; The `let`'s body is a subexpression, so it is generated into a declared local
;; and every arm assigns it. The declaration carries `default!` for the sake of
;; an arm that never assigns at all — one ending in a `ret` or a `panic!` —
;; which C# would otherwise call CS0165 about code no user wrote.
(: described (-> (Option int) string))
(defun (described o)
  (str "n is "
       (let ((zero 0))
         (def+ ((Some n) o)
               (None "nothing"))
         (int->string (+ n zero)))))

;; --- Leaving an *outer* block from an arm ----------------------------------
(: outer-from-inner (-> (Option int) string))
(defun (outer-from-inner o)
  (with-return outer
    (with-return inner
      (def+ ((Some n) o)
            (None (outer "left the outer block")))
      (str "inner got " (int->string n)))))

(defun (main)
  (expect "outside any block, matching" (label "12") "n = 12")
  (expect "outside any block, the arm" (label "xx") "unparseable")

  (expect "an arm binding what the failure carried"
          (explain "xx")
          "refused (not a number: xx)")
  (expect "and the binder still binding its own"
          (explain "12")
          "accepted 12")

  (expect "two arms covering a list, matching" (head-or (list "a" "b")) "first = a")
  (expect "two arms covering a list, empty" (head-or Nil) "empty")

  (expect "three arms over one scrutinee, the binder" (warm? Red) "warm")
  (expect "three arms over one scrutinee, an arm" (warm? Green) "cool")
  (expect "three arms over one scrutinee, the last" (warm? Blue) "cool")

  (expect "inside a block, matching"
          (match (inside "12") ((Ok n) (int->string n)) ((Err e) e))
          "13")
  (expect "inside a block, the explicit ret"
          (match (inside "zz") ((Ok n) (int->string n)) ((Err e) e))
          "bad input")

  (expect "not in tail position, matching" (described (Some 4)) "n is 4")
  (expect "not in tail position, the arm" (described None) "n is nothing")

  (expect "the inner block falls through" (outer-from-inner (Some 7)) "inner got 7")
  (expect "an arm leaves the outer block"
          (outer-from-inner None)
          "left the outer block")

  (shout (Some "a void body ran to its end"))

  (println "220 ok")
  0)
