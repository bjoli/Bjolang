;; `#` introduces a reader form; it is not a name character.
;;
;; The reader used to fall back to reading anything after `#` as a symbol, which
;; made `#banana` an ordinary identifier. Bjolang accepted it the whole way
;; through and C# refused it, because `#` there begins a preprocessor directive —
;; so the diagnostic was a CS1040 against a generated file, naming neither this
;; line nor this language.

;; EXPECT-ERROR: Unknown reader syntax

(import (std prelude))

(def #banana 5)

(defun (main args) 0)
