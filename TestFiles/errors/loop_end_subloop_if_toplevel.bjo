;; The deprecated spelling of `:abandon` is refused at the outermost level too,
;; and the error names it as written.

;; EXPECT-ERROR: `:end-subloop-if` has no level above here; use `:finish`.

(import (std prelude))

(: f (-> (List int) int))
(defun (f xs)
  (loop (:for x xs)
        (:end-subloop-if (> x 2))
        (:acc s (summing x))
        => s))

(defun (main) (println (int->string (f '(1 2 3)))) 0)
