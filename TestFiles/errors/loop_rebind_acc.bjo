;; A loop variable may not reuse an accumulator's name.

;; EXPECT-ERROR: 's' at loop_rebind_acc.bjo:11 is already an accumulator of this loop.

(import (std prelude))

(: f (-> (List int) int))
(defun (f xs)
  (loop (:for x xs)
        (:acc s (summing x))
        (:let s (* x 2))
        (:do (ignore s))
        => s))

(defun (main) (println (int->string (f '(1 2 3)))) 0)
