;; A date has no time of day, so a date's format has no hours to ask for, and
;; the report lists the fields it does have.

;; EXPECT-ERROR: `hours` is not a tag of the union datetime/DatePart
;; EXPECT-ERROR: year, month, day, weekday, yday, week or week-year

(import (std datetime))

(defun (main)
  (match (date 2026 10 25)
    ((Some d) (println (date->text d '((year 4) " " (hours 2)))))
    (None (println "none")))
  0)
