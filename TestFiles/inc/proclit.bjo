;; For 101_literal_across_dll.bjo: a grammar that reads quoted literals,
;; published from a library.
;;
;; Two of its cases carry a list. A written list is a Sub. An Args is only a
;; spliced (List string). The grammar travels with the type into the
;; metadata, so the importer reads a nested literal as this module does. The
;; importing module never sees this source.
(import (std prelude))

(export Item show-items)

(def/grammar Item
  (:or (: Sym symbol)
       (: Str string)
       (: Sub (Item ...))
       (: Args ,(List string))))

(: (-> Item string))
(defun (show-item i)
  (match i
    ((Sym s) (symbol->string s))
    ((Str s) s)
    ((Args a) (string-append "args:" (int->string (list-length a))))
    ((Sub items) (string-append "(" (string-append (show-items items) ")")))))

(: (-> (List Item) string))
(defun (show-items items)
  (match items
    (Nil "")
    ((Cons x Nil) (show-item x))
    ((Cons x rest) (string-append (show-item x) (string-append " " (show-items rest))))))
