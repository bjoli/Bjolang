;; EXPECT-ERROR: Unbound variable: helper
;;
;; `helper` is private to `implicit_a.bjo`. Its published bodies name it, so it
;; is published as an implicit export, but an importer cannot call it.

(import (std prelude))
(import "../inc/implicit_a.bjo")

(defun (main args)
  (a-register! 1)
  (println (displayed (helper 3)))
  0)
