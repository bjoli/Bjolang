;; Both spellings of the same signature.
;;
;; They declare the same thing, so writing both is a mistake rather than a
;; refinement. It used to be unanswerable: signatures are collected into a map,
;; so whichever came last won and the other was dropped without a word — which
;; became reachable the moment a `defun` could write its own.

;; EXPECT-ERROR: 'double' has more than one type signature

(import (std prelude))

(: double (-> int int))
(defun (double (: x int)) : int
  (* x 2))

(defun (main args)
  (println (double 21))
  0)
