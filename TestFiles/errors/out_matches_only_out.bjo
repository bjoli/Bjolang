;; (out T) matches an out parameter, and a ref parameter is not one.
;; Interlocked.Increment takes `ref int`.
;; EXPECT-ERROR: (out T) matches only an out parameter
;; EXPECT-ERROR: is ref, not out
(import (std prelude))

(import/extern
  (increment (: System.Threading.Interlocked.Increment (-> (out int) int))))

(defun (main args) 0)
