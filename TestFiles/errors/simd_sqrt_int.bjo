;; The square root, division and rounding are for float lanes: `SimdFloat` is
;; implemented where the lanes are `FloatLane`.

;; EXPECT-ERROR: no implementation of trait 'FloatLane' for 'int', needed by the implementation of 'SimdFloat'

(import (std prelude))
(import (std simd))

(defun (main)
  (println (simd-ref (simd-sqrt (simd128-splat 16)) 0))
  0)
