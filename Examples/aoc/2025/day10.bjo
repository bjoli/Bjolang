;; Day 10: Factory. Part 1: the fewest presses that light the pattern, a press
;; toggling its lights. Part 2: the fewest presses that bring each counter to
;; its target, a press adding one to its counters. Summed over the machines.
(import (std maths) (std mutable map) "common.bjo")

;; A machine as its lights (one bit each), its buttons and its targets.
(: parse-machine (-> string (Tuple int (Vec (Vec int)) (Vec int))))
(defun (parse-machine line)
  (def* (toks (string-split line " ")) (n (length toks)))
  ;; The text of token i without its first and last characters: "(1,3)" is "1,3".
  (defun (inner i) (string-drop (string-drop-right (ref toks i) 1) 1))
  (defun (nums i) (vec-map string->int (string-split (inner i) ",")))
  (Tuple {summing (if (char=? c #\#) bit 0) (:for c (inner 0)) (:with bit 1 (* bit 2))}
         {vecing (nums i) (:for i (range 1 (- n 1)))}
         (nums (- n 1))))

(: fewest-toggles (-> int (Vec (Vec int)) int))
(defun (fewest-toggles lights buttons)
  (def* (masks (vec-map (fun (b) {summing (shift-left 1 i) (:for i b)}) buttons))
        (nb (length masks)))
  (loop (:for s (range 0 (shift-left 1 nb)))
        (:let lit (loop (:for i (range 0 nb))
                        (:when (= 1 (bitwise-and (shift-right s i) 1)))
                        (:acc x (folding 0 (bitwise-xor x (ref masks i))))
                        => x))
        (:when (= lit lights))
        (:acc best (folding 1000000 (min best (popcount s))))
        => best))

;; The buttons pressed an odd number of times must give the targets' parity;
;; what is left is even, and is half the problem, pressed twice.
(: fewest-presses (-> (Vec (Vec int)) (Vec int) int))
(defun (fewest-presses buttons targets)
  (def* (k (length targets)) (nb (length buttons)) (none 1000000000))
  (defun (parity a) {summing (shift-left (bitwise-and (ref a c) 1) c) (:for c (range 0 k))})
  ;; Every subset of the buttons, pressed once each: what it adds, and how many
  ;; presses. The subsets are grouped by the parity of what they add.
  (def by-parity (mutablemap))
  (loop (:for s (range 0 (shift-left 1 nb)))
        (:let adds (make-array k))
        (:do (loop (:for i (range 0 nb))
                   (:when (= 1 (bitwise-and (shift-right s i) 1)))
                   (:subloop)
                   (:for c (ref buttons i))
                   (:do (array-set! adds c (+ 1 (ref adds c))))))
        (:let p (parity adds))
        (:do (mutablemap-set! by-parity p (Cons (Tuple adds (popcount s))
                                                (mutablemap-ref-or by-parity p Nil)))))
  (def memo (mutablemap))
  (defun (solve (: t (Array int)))
    (def key (string-join {vecing (int->string x) (:for x t)} ","))
    (cond ((all? #(= & 0) t) 0)
          ((mutablemap-contains? memo key) (mutablemap-ref memo key))
          (else
           (def best
             (loop (:for (Tuple adds n) (mutablemap-ref-or by-parity (parity t) Nil))
                   (:when (all? #(<= (ref adds &) (ref t &)) (range 0 k)))
                   (:let half (make-array k))
                   (:do (loop (:for c (range 0 k))
                              (:do (array-set! half c (/ (- (ref t c) (ref adds c)) 2)))))
                   (:let rest (solve half))
                   (:acc best (folding none (if (< rest none) (min best (+ n (* 2 rest))) best)))
                   => best))
           (mutablemap-set! memo key best)
           best)))
  (solve (vec->array targets)))

(defun (main args)
  (def machines (vec-map parse-machine (input-lines args)))
  (println {summing (fewest-toggles l b) (:for (Tuple l b _) machines)})
  (println {summing (fewest-presses b t) (:for (Tuple _ b t) machines)})
  0)
