;; `#:tag` on a union case is gone. A grammar reads a quoted literal now, so
;; the compiler refuses the old marker and tells what to write.
;; EXPECT-ERROR: is gone. A quoted literal is read by a grammar now
(import (std prelude))

(type (: Q (Union (: CFrom Symbol #:tag from)
                  (: CPlain (List Symbol)))))

(defun (main args) 0)
