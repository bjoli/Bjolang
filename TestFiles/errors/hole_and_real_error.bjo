;; EXPECT-ERROR: '_' stands for a value of type (-> int string).
;; EXPECT-ERROR: the 2nd argument to '+' has the wrong type.
;;
;; A hole whose type is known does not hide another error in its declaration:
;; it cannot be the hole's doing.

(import (std prelude))

(: k (-> int string))
(defun (k x)
  (begin
    (println (string-count (_ x)))
    (+ x "s")))

(defun (main) 0)
