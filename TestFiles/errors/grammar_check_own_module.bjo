;; A check runs from a compiled module, so the module that declares it can not
;; have a literal it checks.
;; EXPECT-ERROR: which this module declares
(import (std prelude))
(type (: Port (Record (: number int))))
(: (-> int (Result string Port)))
(defun (port n) (Ok (Port (number n))))
(def/grammar Conn (Conn (conn (: port Port))) (Port (int #:check port)))
(defun (main args)
  (def (: c Conn) '(conn 80))
  0)
