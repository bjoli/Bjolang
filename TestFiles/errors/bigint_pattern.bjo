;; A pattern is a C# constant, and a bigint has none. Comparing with = is the
;; way to test for one.

;; EXPECT-ERROR: is matched against a 'bigint', and a pattern is a C# constant

(import (std prelude))

(: zero? (-> bigint bool))
(defun (zero? n) (match n (0 #t) (_ #f)))

(defun (main args) (println (zero? 1I)) 0)
