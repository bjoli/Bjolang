;; mandelbrot: the Mandelbrot set as a portable bitmap (PBM P4).
;; Argument: the width and height in pixels.

(import (only (std ports) write-bytes!))

;; Whether the point (cr, ci) stays inside radius 2 for 50 iterations.
(: inside? (-> double double bool))
(defun (inside? cr ci)
  (let go ((i 0) (zr 0.0) (zi 0.0) (tr 0.0) (ti 0.0))
    (if (and (< i 50) (<= (+ tr ti) 4.0))
        (let* ((zi (+ (* 2.0 (* zr zi)) ci))
               (zr (+ (- tr ti) cr)))
          (go (+ i 1) zr zi (* zr zr) (* zi zi)))
        (<= (+ tr ti) 4.0))))

(defun (main args)
  (def n (string->int (vec-ref args 0)))
  (def row-bytes (/ (+ n 7) 8))
  (def bitmap (make-array (* row-bytes n)))
  (def size (cast System.Double n))
  (loop (:for y (range 0 n))
        (:let ci (- (/ (* 2.0 (cast System.Double y)) size) 1.0))
        (:do (let go ((x 0) (bits 0) (at (* y row-bytes)))
               (cond
                 ((= x n)
                  (when (not (= 0 (% n 8)))
                    (array-set! bitmap at (cast System.Byte (shift-left bits (- 8 (% n 8)))))))
                 (else
                  (def cr (- (/ (* 2.0 (cast System.Double x)) size) 1.5))
                  (def bits (+ (shift-left bits 1) (if (inside? cr ci) 1 0)))
                  (if (= 7 (% x 8))
                      (let ()
                        (array-set! bitmap at (cast System.Byte bits))
                        (go (+ x 1) 0 (+ at 1)))
                      (go (+ x 1) bits at)))))))
  (def out (parameter-ref current-output-port))
  (write-string out #"P4\n${n} ${n}\n")
  (write-bytes! out bitmap)
  0)
