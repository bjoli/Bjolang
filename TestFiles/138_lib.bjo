;; A library publishing a trait that stands for a .NET interface.
;;
;; The trait has to survive the assembly boundary, and it carries no impl class
;; to link against — nothing about it exists in this .dll but the metadata. What
;; crosses is the interface name, which is what the *importing* module needs to
;; emit its own `where` clause.
(export Numeric scaled magnitude Order rank)

;; Methods too: the `#:clr-member` binding has to cross, or the importing
;; module has a method it cannot emit.
(def/trait (Numeric %a)
  (#:clr-constraint (System.Numerics.INumber %a))
  (: magnitude (-> %a %a) #:clr-member Abs))

;; The instance-member half, which emits a receiver call rather than a call on
;; the type.
(def/trait (Order %a)
  (#:clr-constraint (System.IComparable %a))
  (: rank (-> %a %a int) #:clr-member CompareTo))

;; A constrained generic compiled here, called from over there. The dictionary
;; that is not passed has to be not passed on both sides of the boundary.
(: scaled (-> %a %a %a) (where (Numeric %a) (Num %a)))
(defun (scaled x k) (* x k))
