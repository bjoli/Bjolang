;; The form runs in a method of its own, so an escape cannot leave through it.
;; EXPECT-ERROR: it cannot use the escape of a (with-return ...) around it
(import (std prelude))

(: pick (-> int))
(defun (pick)
  (with-return ret
    (please-hoist-i-promise-i-am-not-naughty (let () (ret 1) 2))))

(defun (main) (pick))
