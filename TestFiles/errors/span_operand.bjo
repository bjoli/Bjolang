;; A span argument cannot wait for a later argument that suspends.
;; EXPECT-ERROR: this argument is a (System.Span long), and a later argument of the same call suspends
(import (std prelude))
(import/extern
  (whole (: System.MemoryExtensions.AsSpan (-> (Array %a) (System.Span %a))))
  (sleep (: System.Threading.Tasks.Task.Delay (-> int void) #:async #:uncancellable)))
(: (-> (System.Span long) int))
(defun (len s) (.-Length s))

(: (-> (System.Span long) int int))
(defun (h s n) n)
(: (-bjo-> int))
(defbjo (one) (sleep 1) 1)
(defbjo (main) (def xs (vec->array [1L])) (println (h (whole xs) (one))) 0)
