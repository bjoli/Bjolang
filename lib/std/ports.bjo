;; std/ports.bjo — draining and streaming a port, its bytes, and byte output.
;;
;; An `InputPort` is bytes, as a Racket port is: `read-line` and `read-char`
;; decode UTF-8 from it, and `read-some`, `read-bytes` and `peek-bytes` take
;; the bytes themselves, on the same port and in any order. The byte reads are
;; CML events, so a read can be a branch of a `choose`.
;;
;; The invariant the port turns on, and the reason a read is safe inside a
;; `choose`:
;;
;;   Every byte that leaves the operating system lands in the port's buffer. A
;;   read never takes bytes from the underlying stream — it takes them from the
;;   buffer, and only when it wins.
;;
;; `BjolangRuntime/BjoInputPort.cs` is where that is done.
;;
;; An `OutputPort` is bytes too: `write-string` and `write-char` write UTF-8
;; to it, and `write-bytes!` writes bytes as they are, on the same port and in
;; any order.

(export
  ;; Draining
  port->list port->vec port->lines
  ;; Streaming
  port->seq file->seq 
  port->chan chan-next

  ;; --- Bytes ---------------------------------------------------------------

  ;; The types. `Encoding` is the prelude's, its values `(text encodings)`'s.
  Stream

  ;; Reading, as events. These are what go in a `choose`.
  read-some-evt read-bytes-evt eof-evt
  ;; Reading, for when there is nothing to choose between.
  read-some read-bytes
  ;; Looking without taking.
  peek-bytes

  ;; Writing.
  write-bytes!

  ;; The half-close.
  shutdown!

  ;; Composition.
  limited byte-pipe

  ;; Sources.
  stream->input-port stream->output-port

  ;; Encodings.
  reencode-input-port reencode-output-port)

(import (std prelude))

;; Exception import.
(import/class
  (Exception (: System.Exception)))

;; ---------------------------------------------------------------------------
;; Draining
;; ---------------------------------------------------------------------------
;;
;; Drains items.


;; Drains a port.
(: port->list (-> (-?-> InputPort %a) InputPort (List %a)))
(defun (port->list reader p)
  (loop (:with i 1 1)
        (:finish (port-eof? p))
        (:acc lst (listing (reader p)))))



(: port->vec (-> (-?-> InputPort %a) InputPort (Vec %a)))
(defun (port->vec reader p)
  (loop (:with i 1 1)
        (:finish (port-eof? p))
        (:acc vec (vecing (reader p)))))

;; The lines left in `port`, ended as `#:mode` says (`Any` by default), as
;; Racket's `port->lines` takes a `#:line-mode`.
(: port->lines (-> InputPort (#:mode LineMode) (Vec string)))
(defun (port->lines port #:mode Any)
  (port->vec (fun (p) (read-line p #:mode mode)) port))

;; ---------------------------------------------------------------------------
;; Streaming
;; ---------------------------------------------------------------------------

;; Streams items from port as a Seq.
(: port->seq #:sync (-> (-> InputPort %a) InputPort (Seq %a)))
(defun (port->seq reader p)
  (seql (:with i 0 0)
        (:finish (port-eof? p))
        (:yield (reader p))))

;; ---------------------------------------------------------------------------
;; Streaming that suspends
;; ---------------------------------------------------------------------------
;;
;; Streaming that suspends.
;; Returns a channel and end-of-stream promise.

;; Reads port on a fiber into a channel.
(: port->chan (-> (-bjo-> InputPort %a) InputPort (Tuple (Chan %a) (Promise int))))
(defun (port->chan reader p)
  (def c (make-chan))
  (Tuple c (bjo (port-fill c reader p))))

;; Reader loop run on fiber.
(: port-fill (-bjo-> (Chan %a) (-bjo-> InputPort %a) InputPort int))
(defbjo (port-fill c reader p)
  (let go ((n 0))
    (cond
      ((port-eof? p) n)
      (else
        ;; Send item.
        (ignore (sync (chan-send c (reader p))))
        (go (+ n 1))))))

;; Gets next item or None.
(: chan-next (-bjo-> (Chan %a) (Promise int) (Option %a)))
(defbjo (chan-next c done)
  (sync (choose (wrap (chan-recv c) (fun (x) (Some x)))
                (wrap (promise-join done) (fun (r) None)))))

;; Streams file contents as Seq.
(: file->seq #:sync (-> (-> InputPort %a) string (Result Exception (Seq %a))))
(defun (file->seq reader path)
  (match (open-input-file path)
    ((Ok probe)
     ;; First we just check if the file exists
     (close-input-port probe)
     (Ok (file-read/seq reader path)))
    ((Err e) (Err e))))

;; ===========================================================================
;; Bytes
;; ===========================================================================
;;
;; An input port owns its buffer, and a read is a cursor move inside that
;; buffer and nothing else — which is what makes a read safe inside a
;; `choose`, and why a refill that lands after its branch has already lost is
;; harmless rather than data loss.
;;
;; The port is a class in `BjolangRuntime/BjoInputPort.cs`, the way `Inbox` is
;; a class with `(std inbox)` over it, and its type, `InputPort`, is the
;; prelude's. What is here is the typed surface of its byte reads.
;;
;; This module still imports `(std prelude)` and nothing else, so it keeps its
;; place in `build_std.sh` above `(std inbox)`: the event vocabulary is all
;; prelude builtins, and the runtime class is reached by `import/extern`, which
;; is not a module dependency.

(import/class
  ;; The pipe object, which exists only so that `byte-pipe` can take its two
  ;; halves off it. Not exported: a pipe *is* its two ports.
  (BytePipe       (: Bjolang.Runtime.BjoBytePipe))
  (Stream         (: System.IO.Stream)))

(import/extern
  ;; Sources.
  (clr-from-stream (: Bjolang.Runtime.BytePorts.FromStream (-> Stream InputPort)))
  (clr-to-stream   (: Bjolang.Runtime.OutputPorts.FromStream (-> Stream OutputPort)))
  (clr-make-pipe   (: Bjolang.Runtime.BytePorts.MakePipe   (-> BytePipe)))
  (clr-pipe-in     (: Bjolang.Runtime.BytePorts.PipeInput  (-> BytePipe InputPort)))
  (clr-pipe-out    (: Bjolang.Runtime.BytePorts.PipeOutput (-> BytePipe OutputPort)))
  (clr-limited     (: Bjolang.Runtime.BytePorts.Limited    (-> InputPort int InputPort)))

  ;; The events.
  (clr-read-some-evt  (: Bjolang.Runtime.BytePorts.ReadSomeEvent
                         (-> InputPort (Event (Result Exception (Option (Array byte)))))))
  (clr-read-bytes-evt (: Bjolang.Runtime.BytePorts.ReadBytesEvent
                         (-> InputPort int (Event (Result Exception (Option (Array byte)))))))
  (clr-eof-evt        (: Bjolang.Runtime.BytePorts.EofEvent (-> InputPort (Event Unit))))

  ;; The questions that are not events, in sync/async pairs.
  (clr-peek           (: Bjolang.Runtime.BytePorts.PeekBytes
                         (-> InputPort int int (Option (Array byte))) #:blocking))
  (clr-peek-await     (: Bjolang.Runtime.BytePorts.PeekBytesAsync
                         (-> InputPort int int (Option (Array byte))) #:async))

  ;; Writing.
  (clr-write-bytes       (: Bjolang.Runtime.OutputPorts.WriteBytes
                            (-> OutputPort (Array byte) void) #:blocking))
  (clr-write-bytes-await (: Bjolang.Runtime.OutputPorts.WriteBytesAsync
                            (-> OutputPort (Array byte) void) #:async))
  (clr-shutdown          (: Bjolang.Runtime.OutputPorts.Shutdown (-> OutputPort void) #:blocking))
  (clr-shutdown-await    (: Bjolang.Runtime.OutputPorts.ShutdownAsync (-> OutputPort void) #:async))

  ;; Encodings.
  (clr-reencode  (: Bjolang.Runtime.InputPorts.Reencode (-> InputPort Encoding InputPort)))
  (clr-reencode-out (: Bjolang.Runtime.OutputPorts.Reencode (-> OutputPort Encoding OutputPort))))

;; ---------------------------------------------------------------------------
;; Reading, as events
;; ---------------------------------------------------------------------------
;;
;; These are what go in a `choose`, and they are real CML events: a branch that
;; loses consumes nothing, and the bytes stay in the buffer for the next reader.
;; They are also *ephemeral* — each `sync` asks the port a new question, so a
;; loop over one reads successive bytes rather than winning with a remembered
;; answer forever. That is exactly what `(task->event ...)` cannot do, which is
;; why a read is not one.
;;
;; WHY THE VALUE IS A `Result`. A stream can fail, and the CML resume path
;; carries a value rather than a raise — so a failure that lands while a fiber
;; is parked in a `choose` has to arrive as one. `promise-join`, `blocking` and
;; `task->event` all answer a `Result` for the same reason. `read-some` and
;; `read-bytes` below unwrap it and raise on the fiber's own stack, which is
;; what an ordinary read wants.

;; Whatever is available, never an empty array, and `None` once there is no more.
(: read-some-evt (-> InputPort (Event (Result Exception (Option (Array byte))))))
(defun (read-some-evt p) (clr-read-some-evt p))

;; Exactly `n` bytes. At end of input the short remainder comes back as
;; `(Some ...)` and the call after it as `None`, so the two are separate facts
;; rather than one ambiguous answer.
;;
;; `n` must be at least 1.
(: read-bytes-evt (-> InputPort int (Event (Result Exception (Option (Array byte))))))
(defun (read-bytes-evt p n) (clr-read-bytes-evt p n))

;; Fires once the port is finished — cleanly, or because it failed. It says only
;; that, which is what makes it the thing to wait on for "the other end has gone
;; away"; a read beside it is what says which of the two happened.
(: eof-evt (-> InputPort (Event Unit)))
(defun (eof-evt p) (clr-eof-evt p))

;; ---------------------------------------------------------------------------
;; Reading, for when there is nothing to choose between
;; ---------------------------------------------------------------------------
;;
;; Defined by syncing the events above: conveniences, not a second
;; implementation. The `defbjouble` is what picks the right kind of wait —
;; `sync/blocking` parks the calling thread for an ordinary `defun`, `sync`
;; suspends the fiber — and the raise happens after either of them returns, on
;; the caller's own stack.

(: byte-read-or-raise (-> (Result Exception (Option (Array byte))) (Option (Array byte))))
(defun (byte-read-or-raise r)
  (match r
    ((Ok bytes) bytes)
    ((Err e) (raise e))))

;; Whatever is available, waiting for at least one byte. `None` at end of input.
(: read-some (-> InputPort (Option (Array byte))))
(defbjouble (read-some p)
  (#:sync (byte-read-or-raise (sync/blocking (clr-read-some-evt p))))
  (#:bjo  (byte-read-or-raise (sync (clr-read-some-evt p)))))

;; Exactly `n` bytes, or the short remainder at end of input, or `None`.
(: read-bytes (-> InputPort int (Option (Array byte))))
(defbjouble (read-bytes p n)
  (#:sync (byte-read-or-raise (sync/blocking (clr-read-bytes-evt p n))))
  (#:bjo  (byte-read-or-raise (sync (clr-read-bytes-evt p n)))))

;; ---------------------------------------------------------------------------
;; Looking without taking
;; ---------------------------------------------------------------------------

;; `skip` bytes past the cursor, then `count` of them, leaving the cursor where
;; it was. Short at end of input, and `None` when there is nothing at all beyond
;; the skip.
;;
;; This is the mechanism a read is, with the cursor move left out — which is why
;; "peek, decide, then read" loses nothing: the sniffed bytes are still in the
;; buffer, for `read-bytes` and `read-line` alike.
(: peek-bytes (-> InputPort int int (Option (Array byte))))
(defbjouble (peek-bytes p skip count)
  (#:sync (clr-peek p skip count))
  (#:bjo  (clr-peek-await p skip count)))

;; ---------------------------------------------------------------------------
;; Writing
;; ---------------------------------------------------------------------------
;;
;; Buffered, so most writes are a copy. A write that fills the buffer drains it,
;; and that is a syscall — which is why these have suspending twins at all.

(: write-bytes! (-> OutputPort (Array byte) void))
(defbjouble (write-bytes! p bytes)
  (#:sync (clr-write-bytes p bytes))
  (#:bjo  (clr-write-bytes-await p bytes)))


;; `flush-port` and `close-output-port` are the prelude's: there is one kind of
;; output port.

;; ---------------------------------------------------------------------------
;; The half-close
;; ---------------------------------------------------------------------------

;; Ends the write side and leaves the read side open.
;;
;; A protocol needs this and `close` cannot say it: "I have finished speaking,
;; now answer me" is a half-close, not a closed connection. Everything buffered
;; goes out first, and a write after it is refused rather than dropped. A stream
;; with no half-close of its own gets the flush and nothing more, which is the
;; most that can honestly be done for a file.
(: shutdown! (-> OutputPort void))
(defbjouble (shutdown! p)
  (#:sync (clr-shutdown p))
  (#:bjo  (clr-shutdown-await p)))

;; ---------------------------------------------------------------------------
;; Composition
;; ---------------------------------------------------------------------------

;; At most `n` bytes of `p`, and then end of input. Once the bound is reached,
;; `p` itself is positioned exactly where the limit ended — the limited port
;; reads *through* `p` rather than around it, so nothing it buffered is lost or
;; double-counted.
;;
;; The result owns nothing: closing it does not close `p`.
(: limited (-> InputPort int InputPort))
(defun (limited p n) (clr-limited p n))

;; A port pair with nothing underneath: what is written to the output can be
;; read from the input.
;;
;; Unbounded and in memory, which is what a string port is one layer up — the GC
;; prices it, nothing registers it on a scope, and a write never waits. Closing
;; the output half, or `shutdown!` on it, is what the input half sees as end of
;; input.
(: byte-pipe (-> (Tuple InputPort OutputPort)))
(defun (byte-pipe)
  (def pipe (clr-make-pipe))
  (Tuple (clr-pipe-in pipe) (clr-pipe-out pipe)))

;; ---------------------------------------------------------------------------
;; Sources
;; ---------------------------------------------------------------------------
;;
;; A file is opened with the prelude's `open-input-file` and `open-output-file`:
;; there is one kind of input port and one kind of output port, and a file port
;; takes bytes as readily as text.

;; A port over a `Stream` somebody else handed over — a `NetworkStream`, a
;; request body, a `MemoryStream`. This pair is what `(std net)` and a web
;; framework reach for, and it is the only way into this module from outside it.
;;
;; Owned like a file, because a `Stream` is a handle in every case that matters.
(: stream->input-port (-> Stream InputPort))
(defun (stream->input-port s)
  (ignore (current-scope))
  (clr-from-stream s))

(: stream->output-port (-> Stream OutputPort))
(defun (stream->output-port s)
  (ignore (current-scope))
  (clr-to-stream s))

;; ---------------------------------------------------------------------------
;; Encodings
;; ---------------------------------------------------------------------------

;; A port whose bytes are `p`'s read as `encoding` and re-encoded as UTF-8, as
;; Racket's `reencode-input-port` makes one: the way to read text that is not
;; UTF-8, since every port's text reads decode UTF-8.
;;
;; Reads *through* `p`, so whatever `p` had buffered — from a `peek-bytes`, or
;; a refill that overshot — is not skipped: sniff the first bytes, then
;; re-encode the rest. Closing the new port does not close `p`.
;;
;; `encoding` is any value from `(text encodings)`. Bytes that do not decode
;; read as U+FFFD, as they do on every port; `bytes->string` is the strict
;; one. A byte order mark is not treated specially.
(: reencode-input-port (-> InputPort Encoding InputPort))
(defun (reencode-input-port p encoding)
  (clr-reencode p encoding))

;; Output's counterpart, as Racket's `reencode-output-port` makes one: what is
;; written to the new port is UTF-8 re-encoded as `encoding` on its way into
;; `p`. A character the encoding lacks is written as its replacement. Closing
;; the new port flushes it into `p` and leaves `p` open.
(: reencode-output-port (-> OutputPort Encoding OutputPort))
(defun (reencode-output-port p encoding)
  (clr-reencode-out p encoding))
