;; Without (out T) an out method is not callable, and the error says how to
;; declare the out.
;; EXPECT-ERROR: bool int.TryParse(string s, out int result)
;; EXPECT-ERROR: An out parameter is imported by declaring it (out T)
(import (std prelude))

(import/extern
  (parse (: System.Int32.TryParse (-> string (Option int)))))

(defun (main args)
  (parse "1")
  0)
