;; A name the compiler wrote resolves where it was written.
;;
;; Several forms are desugarings, and a desugaring calls things by name: a loop
;; calls `iterable-next`, an `:acc` clause constructs a `folding`, string
;; interpolation calls `->str`, a record's synthesised equality calls `=` and
;; `hash-combine`, an empty `(begin)` is `unit`. Every one of those names went
;; into the user's scope to be looked up like any other, so binding one captured
;; the compiler's own reference to it.
;;
;; Each `let` below binds such a name to something useless and then asks whether
;; the thing the compiler wrote still works. On a compiler without `EResolved`
;; the first one alone is a type error: `int` against `(-> %a (Folding %a))`.
(import (std prelude))
(import (std simpletest))

(type/derive (Eq) (: P (Record (: x int) (: y int))))

;; Out here, where `=` is not shadowed, so that the arm below tests the
;; *synthesised* equality rather than its own call.
(: same? (-> P P bool))
(defun (same? a b) (= a b))

(defun (main)
  ;; `folding` is a union constructor, not a trait method, and is written by
  ;; both the `:acc` desugaring and `:final`.
  (let ((folding 5))
    (expect "an accumulator"
            (loop (:for x (list 1 2 3)) (:acc s (folding 0 (+ s x))) => s)
            6)
    (expect "and a comprehension with :final"
            {counting a (:for a (range 0 100)) (:final (>= a 3))}
            4))

  ;; `->str` is a trait method, and interpolation is a *reader* feature: it
  ;; expands to tokens, so its `->str` is marked in the lexer rather than in the
  ;; parser.
  (let ((->str 7))
    (expect "interpolation" #"a ${(+ 1 2)} b" "a 3 b"))

  ;; The two halves of a record's synthesised `Eq`.
  (let ((= 1) (hash-combine 2))
    (expect "a derived equality" (same? (P (x 1) (y 2)) (P (x 1) (y 2))) #t)
    (expect "and one that differs" (same? (P (x 1) (y 2)) (P (x 9) (y 2))) #f))

  ;; `unit` is what an empty `(begin)` is.
  (let ((unit 3))
    (begin)
    (expect "an empty begin" 1 1))

  ;; The loop protocol, under the names it was given to keep it out of the way.
  (let ((iterable-next 4) (collector-init 5) (iterable-done? 6))
    (expect "a loop"
            (list-length (loop (:for x (list 1 2 3)) (:acc o (listing x)) => o))
            3))

  ;; A unary `-` and `/` are `negate` and `recip`.
  (let ((negate 8) (recip 9))
    (expect "unary minus" (- 5) -5)
    (expect "unary divide" (double->string (/ 2.0)) "0.5"))
  0)
