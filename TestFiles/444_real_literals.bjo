;; A real literal without a suffix, `2.5` or `1e3`, takes the type it is used
;; at, as a whole number does: a double, a float, a decimal, or a newtype of
;; one of these that is a number. With nothing to say otherwise it is a double.
(import (std prelude))
(import (std simpletest))

(type (: Meters (Newtype double)))
(impl (Num Meters) #:via double)
(impl (Ordered Meters) #:via double)

(: (-> Meters double))
(defun (metres (Meters d)) d)

(: f float)
(def f 2.5)

(: tenth decimal)
(def tenth 0.1)

(def unsaid 2.5)

;; A whole number and a real one together: both are doubles.
(def mixed (+ 1 2.5))

(: (-> float float))
(defun (halve x) (* x 0.5))

(: (-> double string))
(defun (classify x)
  (match x
    (0.5 "half")
    (_ "other")))

(: (-> float string))
(defun (classify-float x)
  (match x
    (0.25 "quarter")
    (_ "other")))

(defun (main)
  (expect "at a newtype of double" (metres (+ (Meters 1.5) 2.0)) 3.5)
  (expect "at a float" (displayed f) "2.5")
  (expect "at a float, in a function" (displayed (halve 3.0)) "1.5")
  ;; A decimal, so the sum is exact, as it would not be at a double.
  (expect "at a decimal" (+ tenth 0.2) 0.3)
  (expect "an exponent" (displayed (+ tenth 1e1)) "10.1")
  (expect "a double when nothing says" (displayed unsaid) "2.5")
  (expect "with a whole number" (displayed mixed) "3.5")
  (expect "as a pattern" (classify 0.5) "half")
  (expect "as a pattern on a float" (classify-float 0.25) "quarter")
  0)
