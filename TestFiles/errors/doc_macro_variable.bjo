;; Every variable in a macro's forms is documented.

;; EXPECT-ERROR: does not document seed, a variable in its forms: (arg seed

(import (std prelude))

(import (std syntax-match))

(:doc with-seed (summary "Runs with a seed.") (form (with-seed seed body ...)) (rest body "What to run."))
(def/macro (with-seed form inject compare)
  (syntax-match form
    ((_ seed body ...) #'(begin ,@body))))

(defun (main args) 0)
