;; EXPECT-ERROR: (query ...) is given twice
;;
;; A URL has one query. In a `(url ...)`, the path has only segments, so a
;; second query in it is not possible. A second `(query ...)` after the host
;; is a compile error.

(import (std url))

(defun (main args)
  (println (link '(url https "a.com" (query (k "1")) (query (j "2")))))
  0)
