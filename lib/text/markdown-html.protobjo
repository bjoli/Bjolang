;; The HTML writer of (text markdown), included by markdown.bjo. It writes
;; what the CommonMark spec's examples show, which is what commonmark.js
;; writes:
;;
;; - A block starts on a line of its own. `cr!` adds a newline unless the
;;   output already ends with one.
;; - The paragraphs of a tight list's items have no <p>.
;; - A link's destination is percent-encoded as a URL; text and attributes
;;   are escaped.

;; The output.
(type (: HtmlOut (Record (: sb StringBuilder)
                         ;; The tag filter of GitHub Flavored Markdown.
                         (: tag-filter bool)
                         ;; The number of references written to each footnote.
                         (: note-refs (TransientMap int int)))))

;; The id of the `k`th reference to footnote `n`, from 1: fnref-N for the
;; first and fnref-N-K for the others.
(: (-> int int string))
(defun (note-ref-id n k)
  (if (= k 1) #"fnref-${n}" #"fnref-${n}-${k}"))

;; Adds `text` as it is.
(: (-> HtmlOut string void))
(defun (lit! o text) (stringbuilder-add-string! (record-ref o sb) text))

;; Adds a newline unless the output is empty or ends with one.
(: (-> HtmlOut void))
(defun (cr! o)
  (def sb (record-ref o sb))
  (def len (stringbuilder-length sb))
  (unless (or (= len 0) (= (cast System.Int32 (stringbuilder-byte-ref sb (- len 1))) 10))
    (stringbuilder-add! sb #\newline)))

;; The characters that HTML text and attributes have as entities.
(: string)
(def html-specials "&<>\"")

;; Adds `text` with &, <, > and " as entities. The runs between them are
;; copied whole.
(: (-> HtmlOut string void))
(defun (escaped! o text)
  (def sb (record-ref o sb))
  (let go ((from (string-cursor-start text)))
    (match (string-search-any text html-specials from)
      (None (stringbuilder-add-substring! sb text from (string-cursor-end text)))
      ((Some c)
       (stringbuilder-add-substring! sb text from c)
       (def ch (string-cursor-ref text c))
       (stringbuilder-add-string! sb (cond ((char=? ch #\&) "&amp;")
                                           ((char=? ch #\<) "&lt;")
                                           ((char=? ch #\>) "&gt;")
                                           (else "&quot;")))
       (go (string-cursor-next text c))))))

;; The punctuation that a URL keeps as it is.
(: ByteString)
(def url-safe-bytes (string->bytestring ";/?:@&=+$,-_.!~*'()#"))

;; Adds byte `b` as %XX, with upper-case hex digits.
(: (-> StringBuilder int void))
(defun (percent-byte! sb b)
  (def digit! (fun (d) (stringbuilder-add! sb (int->char (if (< d 10) (+ d 48) (+ d 55))))))
  (stringbuilder-add! sb #\%)
  (digit! (bitwise-and (shift-right b 4) 15))
  (digit! (bitwise-and b 15)))

;; Adds `url` percent-encoded and escaped as an attribute.
;;
;; - An ASCII letter, a digit and `url-safe-bytes` are kept, and & is
;;   &amp;. Every other byte of the UTF-8 encoding is %XX.
;; - A % that starts an escape already is kept.
(: (-> HtmlOut string void))
(defun (url! o url)
  (def sb (record-ref o sb))
  (def hex-at?
    (fun (c) (and (not (string-cursor-end? url c))
                  (ascii-hex-digit? (char->int (string-cursor-ref url c))))))
  (let go ((c (string-cursor-start url)))
    (unless (string-cursor-end? url c)
      (def ch (string-cursor-ref url c))
      (def b (char->int ch))
      (def next (string-cursor-next url c))
      (cond
        ((and (= b (char->int #\%)) (hex-at? next) (hex-at? (string-cursor-next url next)))
         (stringbuilder-add! sb #\%)
         (go next))
        ((= b (char->int #\&)) (stringbuilder-add-string! sb "&amp;") (go next))
        ((or (ascii-alphanumeric? b) (byte-in? b url-safe-bytes))
         (stringbuilder-add! sb ch)
         (go next))
        ((< b 128) (percent-byte! sb b) (go next))
        (else
         (def bytes (string->bytestring (substring/slice url c next)))
         (loop (:for k (range 0 (bytestring-length bytes))) (:do (percent-byte! sb (at bytes k))))
         (go next))))))

;; The tags that the tag filter disables.
(: (Vec string))
(def filtered-tags
  ["title" "textarea" "style" "xmp" "iframe" "noembed" "noframes" "script" "plaintext"])

;; Whether the < at `c` of `html` opens or closes a tag of `filtered-tags`:
;; the name, then whitespace, >, / or the end.
(: (-> string StringCursor bool))
(defun (filtered-tag-at? html c)
  (def after-lt (string-cursor-next html c))
  (def name-from
    (if (and (not (string-cursor-end? html after-lt)) (char=? (string-cursor-ref html after-lt) #\/))
        (string-cursor-next html after-lt)
        after-lt))
  (def name-end
    (let go ((k name-from))
      (if (and (not (string-cursor-end? html k)) (ascii-alphanumeric? (char->int (string-cursor-ref html k))))
          (go (string-cursor-next html k))
          k)))
  (and (vec-contains? filtered-tags (string-downcase (substring/slice html name-from name-end)))
       (or (string-cursor-end? html name-end)
           (let ((b (char->int (string-cursor-ref html name-end))))
             (or (ascii-whitespace? b) (= b (char->int #\>)) (= b (char->int #\/)))))))

;; Adds raw HTML. With the tag filter on, the < of a tag of
;; `filtered-tags` is &lt;.
(: (-> HtmlOut string void))
(defun (raw-html! o html)
  (def sb (record-ref o sb))
  (cond
    ((not (record-ref o tag-filter)) (stringbuilder-add-string! sb html))
    (else
     (let go ((from (string-cursor-start html)) (search (string-cursor-start html)))
       (match (string-search-any html "<" search)
         (None (stringbuilder-add-substring! sb html from (string-cursor-end html)))
         ((Some c)
          (def next (string-cursor-next html c))
          (cond
            ((filtered-tag-at? html c)
             (stringbuilder-add-substring! sb html from c)
             (stringbuilder-add-string! sb "&lt;")
             (go next next))
            (else (go from next)))))))))

;; Adds the text of inlines to `sb`, without their markup.
(: (-> StringBuilder (Vec MdInline) void))
(defun (add-plain-text! sb xs)
  (loop (:for x xs)
        (:do (match x
               ((MdText t) (stringbuilder-add-string! sb t))
               ((MdCode t) (stringbuilder-add-string! sb t))
               ((MdEmph ys) (add-plain-text! sb ys))
               ((MdStrong ys) (add-plain-text! sb ys))
               ((MdStrike ys) (add-plain-text! sb ys))
               ((MdLink _ _ ys) (add-plain-text! sb ys))
               ((MdImage _ _ ys) (add-plain-text! sb ys))
               (MdSoftBreak (stringbuilder-add! sb #\newline))
               (MdHardBreak (stringbuilder-add! sb #\newline))
               ((MdHtml t) (stringbuilder-add-string! sb t))
               ((MdCheckbox _) unit)
               ((MdFootnoteRef n) (stringbuilder-add-long! sb (cast System.Int64 n)))))))

;; The text of inlines, without their markup.
(: (-> (Vec MdInline) string))
(defun (inlines->plain-text xs)
  (def sb (stringbuilder-empty))
  (add-plain-text! sb xs)
  (stringbuilder->string sb))

;; Adds the text of inlines without their markup, escaped: the alt text of
;; an image.
(: (-> HtmlOut (Vec MdInline) void))
(defun (alt-text! o xs)
  (loop (:for x xs)
        (:do (match x
               ((MdText t) (escaped! o t))
               ((MdCode t) (escaped! o t))
               ((MdEmph ys) (alt-text! o ys))
               ((MdStrong ys) (alt-text! o ys))
               ((MdStrike ys) (alt-text! o ys))
               ((MdLink _ _ ys) (alt-text! o ys))
               ((MdImage _ _ ys) (alt-text! o ys))
               (MdSoftBreak (lit! o "\n"))
               (MdHardBreak (lit! o "\n"))
               ((MdHtml t) (escaped! o t))
               ((MdCheckbox _) unit)
               ((MdFootnoteRef n) (stringbuilder-add-long! (record-ref o sb) (cast System.Int64 n)))))))

;; Adds ` title="..."` when `title` is not empty.
(: (-> HtmlOut string void))
(defun (title-attribute! o title)
  (unless (string-empty? title)
    (lit! o " title=\"")
    (escaped! o title)
    (lit! o "\"")))

(: (-> HtmlOut (Vec MdInline) void))
(defun (write-inlines! o xs)
  (loop (:for x xs) (:do (write-inline! o x))))

(: (-> HtmlOut MdInline void))
(defun (write-inline! o x)
  (match x
    ((MdText t) (escaped! o t))
    ((MdCode t) (lit! o "<code>") (escaped! o t) (lit! o "</code>"))
    ((MdEmph ys) (lit! o "<em>") (write-inlines! o ys) (lit! o "</em>"))
    ((MdStrong ys) (lit! o "<strong>") (write-inlines! o ys) (lit! o "</strong>"))
    ((MdStrike ys) (lit! o "<del>") (write-inlines! o ys) (lit! o "</del>"))
    ((MdLink dest title ys)
     (lit! o "<a href=\"")
     (url! o dest)
     (lit! o "\"")
     (title-attribute! o title)
     (lit! o ">")
     (write-inlines! o ys)
     (lit! o "</a>"))
    ((MdImage dest title ys)
     (lit! o "<img src=\"")
     (url! o dest)
     (lit! o "\" alt=\"")
     (alt-text! o ys)
     (lit! o "\"")
     (title-attribute! o title)
     (lit! o " />"))
    (MdSoftBreak (lit! o "\n"))
    (MdHardBreak (lit! o "<br />\n"))
    ((MdHtml t) (raw-html! o t))
    ((MdCheckbox checked)
     (lit! o (if checked "<input checked=\"\" disabled=\"\" type=\"checkbox\">"
                 "<input disabled=\"\" type=\"checkbox\">")))
    ((MdFootnoteRef n)
     (def refs (record-ref o note-refs))
     (def k (+ (transientmap-ref-or refs n 0) 1))
     (transientmap-set! refs n k)
     (lit! o #"<sup class=\"footnote-ref\"><a href=\"#fn-${n}\" id=\"${(note-ref-id n k)}\" data-footnote-ref>${n}</a></sup>"))))

;; The open and close tags of the headings, by level.
(: (Vec (Tuple string string)))
(def heading-tags
  [(Tuple "<h1>" "</h1>") (Tuple "<h2>" "</h2>") (Tuple "<h3>" "</h3>")
   (Tuple "<h4>" "</h4>") (Tuple "<h5>" "</h5>") (Tuple "<h6>" "</h6>")])

;; Writes blocks. `tight` is whether they are the blocks of a tight list's
;; item, whose paragraphs have no <p>.
(: (-> HtmlOut (Vec MdBlock) bool void))
(defun (write-blocks! o bs tight)
  (loop (:for b bs) (:do (write-block! o b tight))))

(: (-> HtmlOut MdBlock bool void))
(defun (write-block! o b tight)
  (match b
    ((MdParagraph xs)
     (cond
       (tight (write-inlines! o xs))
       (else (cr! o) (lit! o "<p>") (write-inlines! o xs) (lit! o "</p>") (cr! o))))
    ((MdHeading level xs)
     (def (Tuple open close) (vec-ref heading-tags (- level 1)))
     (cr! o) (lit! o open) (write-inlines! o xs) (lit! o close) (cr! o))
    ((MdCodeBlock info code)
     ;; The language is the first word of the info string.
     (def lang (match (string-search-any info " \t" (string-cursor-start info))
                 ((Some c) (substring/slice info (string-cursor-start info) c))
                 (None info)))
     (cr! o)
     (cond
       ((string-empty? lang) (lit! o "<pre><code>"))
       (else (lit! o "<pre><code class=\"language-") (escaped! o lang) (lit! o "\">")))
     (escaped! o code)
     (lit! o "</code></pre>")
     (cr! o))
    ((MdQuote bs)
     (cr! o) (lit! o "<blockquote>") (cr! o) (write-blocks! o bs #f) (cr! o) (lit! o "</blockquote>") (cr! o))
    ((MdListBlock l)
     (def ordered (record-ref l ordered))
     (cr! o)
     (cond
       ((and ordered (not (= (record-ref l start) 1)))
        (lit! o "<ol start=\"")
        (stringbuilder-add-long! (record-ref o sb) (cast System.Int64 (record-ref l start)))
        (lit! o "\">"))
       (else (lit! o (if ordered "<ol>" "<ul>"))))
     (cr! o)
     (loop (:for item (record-ref l items))
           (:do (lit! o "<li>")
                (write-blocks! o item (not (record-ref l loose)))
                (lit! o "</li>")
                (cr! o)))
     (cr! o) (lit! o (if ordered "</ol>" "</ul>")) (cr! o))
    (MdRule (cr! o) (lit! o "<hr />") (cr! o))
    ((MdHtmlBlock html) (cr! o) (raw-html! o html) (cr! o))
    ((MdTableBlock t) (write-table! o t))))

;; The open tag of a table cell, by its tag and its column's alignment.
(: (-> string MdAlign string))
(defun (cell-open-tag tag a)
  (def head (= tag "th"))
  (match a
    (MdAlignNone (if head "<th>" "<td>"))
    (MdAlignLeft (if head "<th align=\"left\">" "<td align=\"left\">"))
    (MdAlignCenter (if head "<th align=\"center\">" "<td align=\"center\">"))
    (MdAlignRight (if head "<th align=\"right\">" "<td align=\"right\">"))))

(: (-> HtmlOut MdTable void))
(defun (write-table! o t)
  (def aligns (record-ref t aligns))
  (def write-row!
    (fun (cells tag)
      (lit! o "<tr>\n")
      (loop (:for k (range 0 (vec-length cells)))
            (:do (lit! o (cell-open-tag tag (vec-ref aligns k)))
                 (write-inlines! o (vec-ref cells k))
                 (lit! o (if (= tag "th") "</th>\n" "</td>\n"))))
      (lit! o "</tr>\n")))
  (cr! o)
  (lit! o "<table>\n<thead>\n")
  (write-row! (record-ref t head) "th")
  (lit! o "</thead>\n")
  (unless (vec-empty? (record-ref t body))
    (lit! o "<tbody>\n")
    (loop (:for row (record-ref t body)) (:do (write-row! row "td")))
    (lit! o "</tbody>\n"))
  (lit! o "</table>\n"))

;; The links from footnote `n` back to its references, one for each.
(: (-> HtmlOut int string))
(defun (back-links o n)
  (def count (transientmap-ref-or (record-ref o note-refs) n 0))
  (string-join
   {vecing #"<a href=\"#${(note-ref-id n k)}\" class=\"footnote-backref\" data-footnote-backref data-footnote-backref-idx=\"${(if (= k 1) (int->string n) #"${n}-${k}")}\" aria-label=\"Back to reference ${(if (= k 1) (int->string n) #"${n}-${k}")}\">\u{21A9}${(if (= k 1) "" #"<sup class=\"footnote-ref\">${k}</sup>")}</a>"
           (:for k (range 1 (+ count 1)))}
   " "))

;; Writes the blocks of footnote `n`. Its back links go at the end of its
;; last block when that is a paragraph, else after its blocks.
(: (-> HtmlOut int (Vec MdBlock) void))
(defun (write-note-blocks! o n bs)
  (def links (back-links o n))
  (def last (- (vec-length bs) 1))
  (match (if (>= last 0) (Some (vec-ref bs last)) None)
    ((Some (MdParagraph xs))
     (write-blocks! o (vec-take bs last) #f)
     (cr! o) (lit! o "<p>") (write-inlines! o xs)
     (lit! o (str (if (string-empty? links) "" (str " " links)) "</p>")) (cr! o))
    (_
     (write-blocks! o bs #f)
     (cr! o)
     (unless (string-empty? links) (lit! o (str links "\n"))))))

;; Writes a document as HTML.
;;
;; - `#:tag-filter` disables the tags that GitHub Flavored Markdown does
;;   not allow in raw HTML, such as <script> and <title>.
;; - The footnotes are a <section> at the end, each with a link back to its
;;   reference.
(: (-> MdDocument (#:tag-filter bool) string))
(defun (markdown->html doc #:tag-filter #f)
  (def o (HtmlOut (sb (stringbuilder-empty)) (tag-filter tag-filter) (note-refs (transientmap-empty))))
  (write-blocks! o (record-ref doc blocks) #f)
  (def notes (record-ref doc footnotes))
  (unless (vec-empty? notes)
    (cr! o)
    (lit! o "<section class=\"footnotes\" data-footnotes>\n<ol>\n")
    (loop (:for (Tuple n bs) notes)
          (:do (lit! o #"<li id=\"fn-${n}\">\n")
               (write-note-blocks! o n bs)
               (lit! o "</li>\n")))
    (lit! o "</ol>\n</section>\n"))
  (stringbuilder->string (record-ref o sb)))
