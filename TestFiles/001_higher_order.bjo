
(import (std prelude))

(: id (-> %a %a))
(defun (id x) x)



      
;; Higher-order function returning a captured closure with generics
(: make-mapper (-> (-> %a %b) (-> (List %a) (List %b))))
(defun (make-mapper f)
  (fun (lst) (list-map f lst)))

(defun (main args)
  (def my-list (Cons "hej" (Cons "då" Nil)))
  (defun (my-mapper lst)
    (let ((mapper (make-mapper id)))
     (mapper lst)))
  (def h (my-mapper my-list))
  (displayln "h generated!")
  (displayln (list-head h))
  0)
