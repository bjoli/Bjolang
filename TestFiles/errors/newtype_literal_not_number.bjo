;; A number literal is a value of a newtype only if the newtype is a number.

;; EXPECT-ERROR: '3' is a number, and it is being used where a 'newtype_literal_not_number/Banana' is wanted.

(import (std prelude))

(type (: Banana (Newtype int)))

(: (-> Banana int))
(defun (peel b) (def (Banana n) b) n)

(defun (main args)
  (println (displayed (peel 3)))
  0)
