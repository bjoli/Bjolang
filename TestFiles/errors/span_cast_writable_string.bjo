;; A string's bytes are read-only, and ro-span-> gives a read-only span. There
;; is no way from them to a writable one.

;; EXPECT-ERROR: the 1st argument to 'span->' has the wrong type

(import (std prelude))
(import/extern (string-bytes (: BjoString.Utf8String.AsSpan (-> string (RoSpan byte)))))
(defun (main)
  (def s (span-> (string-bytes "abc")))
  (span-set! s 0 1uy))
