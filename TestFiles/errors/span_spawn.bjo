;; (bjo ...) cannot hand a span to a new fiber.
;; EXPECT-ERROR: (bjo ...) hands its arguments to a new fiber
(import (std prelude))
(import/extern
  (whole (: System.MemoryExtensions.AsSpan (-> (Array %a) (System.Span %a))))
  (sleep (: System.Threading.Tasks.Task.Delay (-> int void) #:async #:uncancellable)))
(: (-> (System.Span long) int))
(defun (len s) (.-Length s))

(: (-> (System.Span long) void))
(defun (g s) (println (len s)))
(defbjo (main) (def xs (vec->array [1L])) (ignore (bjo (g (whole xs)))) (sleep 1) 0)
