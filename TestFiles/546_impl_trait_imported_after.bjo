;; A module that imports the trait after the type whose module implements
;; it. The implementation applies here.

(import (std prelude))
(import "inc/pending_type.bjo")
(import "inc/pending_trait.bjo")

(defun (main args)
  (def got (+ (weigh (crate 2)) (weigh-both (crate 1) (crate 2))))
  (if (= got 50)
      0
      (begin (println (str "FAILURE: got " (displayed got) ", want 50")) 1)))
