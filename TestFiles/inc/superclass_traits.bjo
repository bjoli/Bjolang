;; Traits with superclasses, published for another module to implement and
;; call through.
(export Named name-of Greet greeting introduce)

(def/trait (Named %a)
  (: name-of (-> %a string)))

(def/trait (Greet %a)
  (where (Named %a))
  (: greeting (-> %a string)))

(: introduce (-> %a string) (where (Greet %a)))
(defun (introduce x) (str (name-of x) " says " (greeting x)))
