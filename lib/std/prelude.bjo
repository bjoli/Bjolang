;; std/prelude.bjo
;; Standard library entry point
;; Macros defined here CANNOT be used in this file.
(export
  ;; Types.
  Map MapBuilder TransientMap MapCursor TransientVec
  Range RangeBy
  ArraySlice ReverseArraySlice VecSlice ReverseVecSlice
  VecBackCursor StringWalk ListTails PortReads UpFrom DownFrom
  Enumerated Zipped Cycled Pairwise Repeated Chained
  Listing ListingReverse Vecing VecingSmall Mapping Stringing Summing Counting Folding
  VecingInto ListingInto ListingReverseInto MappingInto
  InputPort OutputPort Exception Encoding

  ;; Iterable
  iterable-start iterable-done? iterable-current iterable-next iterable-end iterable-cleanup
  fold map filter take drop take-while drop-while
  seq-enumerate flat-map any? all? find for-each ->seq
  ->list ->vec count first ->map
  ;; Adapters
  enumerate zip in-cycle pairwise in-repeat chain
  ;; Cursor.
  cursor-start cursor-end cursor-end? cursor-ref cursor-next cursor-prev
  ;; Collector
  collector-init collector-step collector-finish
  ;; `#:into` on a collector
  collector-into
  ;; Collection
  length empty?
  ;; Addable! and Addable
  add! add-all!
  add add-all
  ;; Discard.
  ignore
  ;; Range
  range range-by
  ;; Iterating part of a collection, or backwards, or without one.
  ;; Written in iterators.protobjo, which this file includes.
  in-array in-reverse-array in-vec in-reverse-vec
  over-list in-port up-from down-from
  int-max int-min
  ;; The cursors those walk with, named because an inlined impl body reaches them
  vec-back-cursor vec-back-cursor-done? vec-back-cursor-current vec-back-cursor-next
  string-walk string-walk-done? string-walk-current string-walk-next

  print println ->str list->str
  ;; Written and Displayed
  written write-into displayed display-into
  elements-print-into entries-print-into
  list-append

  ;; List operations.
  list-map list-filter list-foldl list-foldr list-for-each list-unfold

  ;; Vec operations.
  vec-take vec-drop vec-reverse vec->array
  vec-add vec-add-first
  vec-map vec-filter vec-fold vec-reduce
  vec-for-each vec-for-each/range vec-iter

  ;; Seq operations.
  seq-fold seq-for-each

  ;; Maps. 
  map-empty map-ref map-ref-or map-try-ref
  map-set map-add-new map-try-add-new map-set-all map-remove map-remove-all
  map-contains? map-has-key? map-length map-empty? map-clear
  map-keys map-values map-merge map-merge-with
  ;; Walking and rebuilding
  map-map map-map-values map-filter map-fold
  map-for-each map-iter map-any? map-find map-try-find
  ;; The cursor `Iterable` walks with
  map-cursor map-cursor-done? map-cursor-current map-cursor-next
  ;; Conversions.
  list->map list->vec map->list vec->list vec->map map->vec seq->map map->seq
  map->str map-entry->str
  ;; Builders.
  mapbuilder-empty map->mapbuilder mapbuilder-add! mapbuilder-add-all!
  mapbuilder-length mapbuilder->map
  ;; The vec's transient.
  transientvec-empty vec->transientvec transientvec->vec
  transientvec-length transientvec-empty? transientvec-ref transientvec-set!
  transientvec-add! transientvec-add-all! transientvec-pop!
  transientvec-add-first! transientvec-pop-first!
  ;; The immutable array.
  IArray
  iarray-empty iarray-length iarray-empty? iarray-ref iarray-try-ref
  iarray-set iarray-add iarray-map
  subarray->iarray array->iarray iarray->array seq->iarray iarray->seq
  vec->iarray iarray->vec list->iarray iarray->list
  ;; Transients.
  transientmap-empty map->transientmap transientmap->map
  transientmap-set! transientmap-set-all! transientmap-remove!
  transientmap-remove-all! transientmap-contains? transientmap-ref
  transientmap-ref-or transientmap-try-ref transientmap-length
  transientmap-empty? transientmap-filter!

  ;; Results
  ok? err? result-map
  option-value
  ;; Pairs
  fst snd

  ;; Box
  Box
  make-box box-ref box-set!

  ;; Refable, Settable, Settable!, Derefable, Derefable!
  ref try-ref
  ref-set
  ref-set!
  deref try-deref
  deref-set!

  ;; Strings
  str string-append string-length
  string-contains? string-starts-with? string-ends-with? string-replace
  string-upcase string-downcase
  string-trim string-trim-left string-trim-right
  string-trim/slice string-trim-left/slice string-trim-right/slice string-copy
  string-pad-left string-pad-right
  string-split string-split/slice string-join
  string-split-once string-split-once/slice
  ;; Taking and dropping characters.
  string-take string-drop string-take-right string-drop-right
  string-take/slice string-drop/slice string-take-right/slice string-drop-right/slice
  string-cursor-forward string-cursor-back
  ;; Characters.
  char->integer integer->char
  char=? char<? char>? char<=? char>=?
  char-ci=? char-ci<? char-ci>? char-ci<=? char-ci>=?
  ;; String cursors.
  string-cursor=? string-cursor<? string-cursor>? string-cursor<=? string-cursor>=?
  string-fold string-fold-right string-for-each string-index
  string->list list->string string->vec string-reverse
  ;; Conversions
  int->string long->string double->string byte->string number->string
  string->int string->long string->double
  decimal->string string->decimal bigint->string string->bigint
  int128->string string->int128 uint128->string string->uint128
  bytes->string string->bytes bytes-utf-8?
  ;; Math.
  sqrt
  ;; Files
  file-read-text file-write-text file-append-text file-exists? file-delete file-move
  file-info file-copy file-read-bytes file-write-bytes file-append-bytes
  file-read-lines file-write-lines
  file-read/seq file-read-lines/seq
  ;; Paths
  path-absolute path-combine path-filename path-file-extension
  ;; Directories
  directory-exists? directory-create directory-delete directory-delete-tree
  directory-files directory-subdirectories directory-walk
  ;; The environment
  get-environment-variable set-environment-variable!
  current-directory set-current-directory!
  ;; Open ports.
  open-input-file open-input-string open-output-file open-output-string
  ;; Ports — closing
  close-input-port close-output-port flush-port
  ;; Ports — the openers past the FS effect
  open-input-file/raw open-output-file/raw WriteMode
  call-with-input-file call-with-output-file
  ;; The FS effect: its operations, their cells, and the defaults
  FsKind FsInfo MoveMode
  open-read-stream op/open-read-stream open-read-stream/raw
  open-write-stream op/open-write-stream open-write-stream/raw
  fs-info op/fs-info fs-info/raw
  fs-list op/fs-list fs-list/raw
  fs-create-directory op/fs-create-directory fs-create-directory/raw
  fs-delete-file op/fs-delete-file fs-delete-file/raw
  fs-delete-directory op/fs-delete-directory fs-delete-directory/raw
  fs-move op/fs-move fs-move/raw
  ;; Ports — input
  port-eof? read-line read-line/opt LineMode read-char read-char/opt
  peek-char peek-char/opt read-all port-fold
  ;; Ports — output
  write-string write-char writeln get-output-string get-output-bytes

  ;; Durations, which every timer takes.
  Duration ticks->duration duration-ticks milliseconds seconds minutes hours
  timeout duration->timer-ms

  ;; Effects the standard library performs. The `op/` name of each is the
  ;; parameter `with-handler` binds, and is exported for that reason.
  warn op/warn
  log op/log
  getenv op/getenv

  ;; The clock
  Clock make-clock system-clock current-clock monotonic-ms monotonic-ns

  promise-join/sync panic!

  ;; What a grammar's checked literal calls. See (def/grammar ...).
  grammar-checked)


(import/extern (clr-panic (: BjolangRuntime.Panic (-> string int %a))))


(: (-> string (#:exit-code int) %a))
(defun (panic! msg #:exit-code 1)
  (clr-panic msg exit-code))

;; The value of a grammar's check on a literal. The compiler ran the same
;; check on the same literal and refused an Err, so the Err case is not
;; reached unless the check gives different results for one value.
(: (-> (Result string %a) %a))
(defun (grammar-checked r)
  (match r
    ((Ok v) v)
    ((Err e) (panic! (str "a check of a grammar gave Err for a literal it gave Ok for when compiled: " e)))))


;; The `written` fallback, invariant. `System.Convert.ToString` reads the ambient
;; culture, which is how a `short` or a `float` — types with no conversion of
;; their own below — would print differently on a differently configured
;; machine. Generic, because a union case that is `null` at run time is named
;; by the type the value has, and the value alone does not say it.
(import/extern
  (clr-show (: Bjolang.Runtime.BjoNum.Show (-> %a string))))

;; The docs: the prelude's own definitions and the builtins beside them, by
;; area. The builtins are documented here because every program gets them with
;; the prelude, and their docs are published in its assembly.
(:doc #:file "prelude.bjodoc")
(:doc #:file "prelude-core.bjodoc")
(:doc #:file "prelude-seqs.bjodoc")
(:doc #:file "prelude-lists.bjodoc")
(:doc #:file "prelude-vecs.bjodoc")
(:doc #:file "prelude-maps.bjodoc")
(:doc #:file "prelude-strings.bjodoc")
(:doc #:file "prelude-chars.bjodoc")
(:doc #:file "prelude-files.bjodoc")
(:doc #:file "prelude-ports.bjodoc")
(:doc #:file "prelude-concurrency.bjodoc")
(:doc #:file "prelude-syntax.bjodoc")

;; First, and before the includes. = is a trait and needs to be imported
(import (std eq))
;; re-export ord and eq traits
(re-export = eq-hash
           compare less? greater? at-most? at-least?
                       least greatest list-sort vec-sort vec-sort-by list-min list-max)


;; List append.
(: (-> (List %a) (List %a) (List %a)))
(defun (list-append xs ys)
  (list-foldr Cons ys xs))

;; ---------------------------------------------------------------------------
;; Written and Displayed
;; ---------------------------------------------------------------------------
;; `written` is a value as the reader reads it, as Scheme's `write` writes
;; it: a string in quotes, a char as `#\a`, a long as `21L`. `displayed` is
;; the value for a person to read, as `display` writes it: a string is its
;; text. Every type is written; a type is displayed as it is written unless
;; it says otherwise.
;;
;; Each trait has two methods. `write-into` adds the value to a builder, and
;; is what a container calls on its elements, so that a nested value is
;; written into one buffer. `written` answers a string, through `write-into`
;; and a builder the thread keeps. A type whose text it has at hand, such as
;; a number, gives `written` too, and no builder is used.
(import/extern
  (clr-builder-rent   (: Bjolang.Runtime.BjoShow.Rent))
  (clr-builder-finish (: Bjolang.Runtime.BjoShow.Finish))
  (clr-write-string-into (: Bjolang.Runtime.BjoShow.WriteStringInto))
  (clr-written-char   (: Bjolang.Runtime.BjoShow.WrittenChar))
  (clr-written-double (: Bjolang.Runtime.BjoShow.WrittenDouble))
  (clr-written-number (: Bjolang.Runtime.BjoShow.WrittenNumber (-> %a string string))))

(def/trait (Written %a)
  (: write-into (-> %a StringBuilder void))
  (: written (-> %a string))
  (defun (written x)
    (def b (clr-builder-rent))
    (write-into x b)
    (clr-builder-finish b)))

(def/trait (Displayed %a)
  (where (Written %a))
  (: display-into (-> %a StringBuilder void))
  (: displayed (-> %a string))
  (defun (displayed x)
    (def b (clr-builder-rent))
    (display-into x b)
    (clr-builder-finish b)))

;; A .NET type is written as it writes itself, in the invariant culture.
(impl (Written %a)
  (defun (written x) (clr-show x))
  (defun (write-into x b) (stringbuilder-add-string! b (clr-show x))))

;; Every type is displayed as it is written, unless it says otherwise.
(impl (Displayed %a)
  (defun (displayed x) (written x))
  (defun (display-into x b) (write-into x b)))

;; A function, as Scheme writes one. No blanket reaches a function type, so it
;; is written and displayed by these, inside a container as well.
(impl (Written Procedure)
  (defun (written f) "#<procedure>")
  (defun (write-into f b) (stringbuilder-add-string! b "#<procedure>")))

(impl (Displayed Procedure)
  (defun (displayed f) "#<procedure>")
  (defun (display-into f b) (stringbuilder-add-string! b "#<procedure>")))

;; Each number with the suffix that gives its type back, and displayed
;; without it.
(impl (Written int)
  (defun (written n) (int->string n))
  (defun (write-into n b) (stringbuilder-add-string! b (int->string n))))

(impl (Written long)
  (defun (written n) (clr-written-number n "L"))
  (defun (write-into n b) (stringbuilder-add-string! b (written n))))

(impl (Displayed long)
  (defun (displayed n) (long->string n))
  (defun (display-into n b) (stringbuilder-add-long! b n)))

(impl (Written byte)
  (defun (written n) (clr-written-number n "uy"))
  (defun (write-into n b) (stringbuilder-add-string! b (written n))))

(impl (Displayed byte)
  (defun (displayed n) (byte->string n))
  (defun (display-into n b) (stringbuilder-add-string! b (byte->string n))))

(impl (Written short)
  (defun (written n) (clr-written-number n "s"))
  (defun (write-into n b) (stringbuilder-add-string! b (written n))))

(impl (Displayed short)
  (defun (displayed n) (clr-show n))
  (defun (display-into n b) (stringbuilder-add-string! b (clr-show n))))

(impl (Written ushort)
  (defun (written n) (clr-written-number n "us"))
  (defun (write-into n b) (stringbuilder-add-string! b (written n))))

(impl (Displayed ushort)
  (defun (displayed n) (clr-show n))
  (defun (display-into n b) (stringbuilder-add-string! b (clr-show n))))

(impl (Written uint)
  (defun (written n) (clr-written-number n "u"))
  (defun (write-into n b) (stringbuilder-add-string! b (written n))))

(impl (Displayed uint)
  (defun (displayed n) (clr-show n))
  (defun (display-into n b) (stringbuilder-add-string! b (clr-show n))))

(impl (Written ulong)
  (defun (written n) (clr-written-number n "UL"))
  (defun (write-into n b) (stringbuilder-add-string! b (written n))))

(impl (Displayed ulong)
  (defun (displayed n) (clr-show n))
  (defun (display-into n b) (stringbuilder-add-string! b (clr-show n))))

(impl (Written decimal)
  (defun (written n) (clr-written-number n "M"))
  (defun (write-into n b) (stringbuilder-add-string! b (written n))))

(impl (Displayed decimal)
  (defun (displayed n) (clr-show n))
  (defun (display-into n b) (stringbuilder-add-string! b (clr-show n))))

(impl (Written bigint)
  (defun (written n) (clr-written-number n "I"))
  (defun (write-into n b) (stringbuilder-add-string! b (written n))))

(impl (Displayed bigint)
  (defun (displayed n) (clr-show n))
  (defun (display-into n b) (stringbuilder-add-string! b (clr-show n))))

;; A float, an int128 and a uint128 have no suffix, so each is written with
;; its type, as a value with its type written is read: `(: 2.5 float)`.
(import/extern
  (clr-written-single (: Bjolang.Runtime.BjoShow.WrittenSingle)))

(impl (Written float)
  (defun (written n) (str "(: " (clr-written-single n) " float)"))
  (defun (write-into n b) (stringbuilder-add-string! b (written n))))

(impl (Displayed float)
  (defun (displayed n) (clr-show n))
  (defun (display-into n b) (stringbuilder-add-string! b (clr-show n))))

(impl (Written int128)
  (defun (written n) (str "(: " (clr-written-number n "") " int128)"))
  (defun (write-into n b) (stringbuilder-add-string! b (written n))))

(impl (Displayed int128)
  (defun (displayed n) (clr-show n))
  (defun (display-into n b) (stringbuilder-add-string! b (clr-show n))))

(impl (Written uint128)
  (defun (written n) (str "(: " (clr-written-number n "") " uint128)"))
  (defun (write-into n b) (stringbuilder-add-string! b (written n))))

(impl (Displayed uint128)
  (defun (displayed n) (clr-show n))
  (defun (display-into n b) (stringbuilder-add-string! b (clr-show n))))

;; A double is written with a point, so that it is not read back as an int.
(impl (Written double)
  (defun (written n) (clr-written-double n))
  (defun (write-into n b) (stringbuilder-add-string! b (clr-written-double n))))

(impl (Displayed double)
  (defun (displayed n) (double->string n))
  (defun (display-into n b) (stringbuilder-add-double! b n)))

;; As the language writes a boolean, not as .NET does.
(impl (Written bool)
  (defun (written b) (if b "#t" "#f"))
  (defun (write-into x b) (stringbuilder-add-string! b (if x "#t" "#f"))))

;; A string in quotes, and displayed as its text.
(impl (Written string)
  (defun (write-into s b) (clr-write-string-into b s)))

(impl (Displayed string)
  (defun (displayed s) s)
  (defun (display-into s b) (stringbuilder-add-string! b s)))

(impl (Written Char)
  (defun (written c) (clr-written-char c))
  (defun (write-into c b) (stringbuilder-add-string! b (clr-written-char c))))

(impl (Displayed Char)
  (defun (displayed c) (char->string c))
  (defun (display-into c b) (stringbuilder-add! b c)))

(impl (Written Keyword)
  (defun (written k) (str "#:" (keyword->string k)))
  (defun (write-into k b)
    (stringbuilder-add-string! b "#:")
    (stringbuilder-add-string! b (keyword->string k))))

(impl (Displayed Keyword)
  (defun (displayed k) (keyword->string k))
  (defun (display-into k b) (stringbuilder-add-string! b (keyword->string k))))

(impl (Written Symbol)
  (defun (written s) (symbol->string s))
  (defun (write-into s b) (stringbuilder-add-string! b (symbol->string s))))

;; Container formats are further down.

;; ---------------------------------------------------------------------------
;; ->str
;; ---------------------------------------------------------------------------
;; What `displayed` was called before there was `written`. An implementation
;; of its own is still called by `->str`, but not by `displayed`, `println`
;; or an interpolation, which is why it is deprecated.
(def/trait (->str %a)
  (where (Displayed %a))
  (: ->str (-> %a string)))

(impl (->str %a)
  (defun (->str x) (displayed x)))

(:deprecated ->str "use `displayed`, and implement `Displayed` or `Written`")


;; ---------------------------------------------------------------------------
;; Discard
;; ---------------------------------------------------------------------------
;; Discard value.
(def/trait (Discard %a)
  (: ignore (-> %a void)))

(impl (Discard %a)
  (defun (ignore x) unit))

;; Detach promise.
(impl (Discard (Promise %a))
  (defun (ignore p) (detach p)))

;; Writes a value as `displayed` gives it.
(: (-> %a void))
(defun (print x)
  (display (displayed x)))

(: (-> %a void))
(defun (println x)
  (displayln (displayed x)))


;; ---------------------------------------------------------------------------
;; TransientVec — a vec changed in place
;; ---------------------------------------------------------------------------
;; The builder a `VecBuilder` is, under its own name, with the ends a builder
;; has no use for.
(import/class
  ((TransientVec %a) (: Collections.RrbTransient)))

(import/extern
  (transientvec-empty      (: Collections.TransientVecModule.Empty    (-> (TransientVec %a))))
  (vec->transientvec       (: Collections.TransientVecModule.FromList (-> (Vec %a) (TransientVec %a))))
  (transientvec->vec       (: Collections.TransientVecModule.ToList   (-> (TransientVec %a) (Vec %a))))
  (transientvec-length     (: Collections.TransientVecModule.Count    (-> (TransientVec %a) int)))
  (transientvec-empty?     (: Collections.TransientVecModule.IsEmpty  (-> (TransientVec %a) bool)))
  (transientvec-ref        (: Collections.TransientVecModule.Ref      (-> (TransientVec %a) int %a)))
  (transientvec-set!       (: Collections.TransientVecModule.Set      (-> (TransientVec %a) int %a void)))
  (transientvec-add!       (: Collections.TransientVecModule.Add      (-> (TransientVec %a) %a void)))
  (transientvec-add-all!   (: Collections.TransientVecModule.AddRange (-> (TransientVec %a) (Seq %a) void)))
  (transientvec-add-first! (: Collections.TransientVecModule.Prepend  (-> (TransientVec %a) %a void)))
  (transientvec-pop!       (: Collections.TransientVecModule.Pop      (-> (TransientVec %a) %a)))
  (transientvec-pop-first! (: Collections.TransientVecModule.PopFirst (-> (TransientVec %a) %a))))

;; ---------------------------------------------------------------------------
;; IArray — the immutable array
;; ---------------------------------------------------------------------------
;; A struct around .NET's `ImmutableArray<T>`: one array that is not written
;; after it is made. Indexing is an array read, and the value is one reference
;; wide. Every change copies the whole array, so it is for values that are
;; built once and then read. `Vec` is the one to change. The impls are with
;; those of `Array`. Why it is a wrapper is in `BjoIArray.cs`.
(import/class
  ((IArray %a) (: Bjolang.Runtime.IArray)))

(import/extern
  (iarray-empty     (: Bjolang.Runtime.IArrayModule.Empty          (-> (IArray %a))))
  (iarray-length    (: Bjolang.Runtime.IArrayModule.Count          (-> (IArray %a) int)))
  (iarray-empty?    (: Bjolang.Runtime.IArrayModule.IsEmpty        (-> (IArray %a) bool)))
  ;; Throws when the index is out of range. `iarray-try-ref` is the checked one.
  (iarray-ref       (: Bjolang.Runtime.IArrayModule.Get            (-> (IArray %a) int %a)))
  (iarray-try-ref   (: Bjolang.Runtime.IArrayModule.TryGet         (-> (IArray %a) int (out %a) (Option %a))))
  ;; A copy with one element replaced, or one added at the end.
  (iarray-set       (: Bjolang.Runtime.IArrayModule.SetItem        (-> (IArray %a) int %a (IArray %a))))
  (iarray-add       (: Bjolang.Runtime.IArrayModule.Add            (-> (IArray %a) %a (IArray %a))))
  (iarray-map       (: Bjolang.Runtime.IArrayModule.Map            (-> (-> %a %b) (IArray %a) (IArray %b))))
  ;; The array, start and count, as `subarray->vec` takes them. The elements
  ;; are copied, so the array can be written again.
  (subarray->iarray (: Bjolang.Runtime.IArrayModule.FromSubarray   (-> (Array %a) int int (IArray %a))))
  (array->iarray    (: Bjolang.Runtime.IArrayModule.FromArray      (-> (Array %a) (IArray %a))))
  ;; A new array, which the caller can write.
  (iarray->array    (: Bjolang.Runtime.IArrayModule.ToArray        (-> (IArray %a) (Array %a))))
  (seq->iarray      (: Bjolang.Runtime.IArrayModule.FromEnumerable (-> (Seq %a) (IArray %a))))
  (iarray->seq      (: Bjolang.Runtime.IArrayModule.AsEnumerable   (-> (IArray %a) (Seq %a)))))

(: (-> (Vec %a) (IArray %a)))
(defun (vec->iarray v) (seq->iarray (vec->seq v)))

(: (-> (List %a) (IArray %a)))
(defun (list->iarray xs) (seq->iarray (list->seq xs)))

;; ---------------------------------------------------------------------------
;; Map — the unordered map
;; ---------------------------------------------------------------------------
;; Hash map.
(import/class
  ((Map %k %v)          (: Map.Map))
  ((MapBuilder %k %v)   (: Map.MapBuilder))
  ((TransientMap %k %v) (: Map.TransientMap))
  ((MapCursor %k %v)    (: Map.MapCursor))
  ;; What a map compares its keys with. See `eq-comparer`.
  ((EqualityComparer %a) (: System.Collections.Generic.IEqualityComparer)))

(import/extern
  (clr-map-empty  (: Map.MapModule.Empty       (-> (EqualityComparer %k) (Map %k %v))))
  (clr-map-comparer (: Map.MapModule.Comparer  (-> (Map %k %v) (EqualityComparer %k))))
  ;; Lookup.
  (map-ref        (: Map.MapModule.Ref         (-> (Map %k %v) %k %v)))
  (map-ref-or     (: Map.MapModule.RefOr       (-> (Map %k %v) %k %v %v)))
  (map-set        (: Map.MapModule.Set         (-> (Map %k %v) %k %v (Map %k %v))))
  ;; Adds a key that must be new, and raises when it is not.
  (map-add-new    (: Map.MapModule.Add         (-> (Map %k %v) %k %v (Map %k %v))))
  ;; Set multiple.
  (map-set-all    (: Map.MapModule.SetRange    (-> (Map %k %v) (Seq (Tuple %k %v)) (Map %k %v))))
  (map-remove     (: Map.MapModule.Remove      (-> (Map %k %v) %k (Map %k %v))))
  (map-remove-all (: Map.MapModule.RemoveRange (-> (Map %k %v) (Seq %k) (Map %k %v))))
  (map-contains?  (: Map.MapModule.ContainsKey (-> (Map %k %v) %k bool)))
  (map-length     (: Map.MapModule.Count       (-> (Map %k %v) int)))
  (map-empty?     (: Map.MapModule.IsEmpty     (-> (Map %k %v) bool)))
  (map-clear      (: Map.MapModule.Clear       (-> (Map %k %v) (Map %k %v))))
  (map-keys       (: Map.MapModule.Keys        (-> (Map %k %v) (Seq %k))))
  (map-values     (: Map.MapModule.Values      (-> (Map %k %v) (Seq %v))))
  ;; Merge.
  (map-merge      (: Map.MapModule.Merge       (-> (Map %k %v) (Map %k %v) (Map %k %v))))
  ;; Merge with function.
  (map-merge-with (: Map.MapModule.MergeWith   (-> (-> %k %v %v %v) (Map %k %v) (Map %k %v) (Map %k %v))))

  ;; Lookup value.
  (map-try-ref    (: Map.MapModule.TryGetValue (-> (Map %k %v) %k (out %v) (Option %v))))

  ;; --- Walking ---
  ;; Walk map.
  (clr-map-map        (: Map.MapModule.Map       (-> (-> %k %v %w) (Map %k %v) (Map %k %w))))
  ;; Map values.
  (clr-map-map-values (: Map.MapModule.MapValues (-> (-> %v %w) (Map %k %v) (Map %k %w))))
  (clr-map-filter     (: Map.MapModule.Filter    (-> (-> %k %v bool) (Map %k %v) (Map %k %v))))
  (clr-map-fold       (: Map.MapModule.Fold      (-> (-> %k %v %s %s) %s (Map %k %v) %s)))
  ;; Walk until false.
  (clr-map-iter       (: Map.MapModule.Iter      (-> (-> %k %v bool) (Map %k %v) bool)))
  (map-any?       (: Map.MapModule.Exists    (-> (-> %k %v bool) (Map %k %v) bool)))
  (map-try-find   (: Map.MapModule.TryFind   (-> (-> %k %v bool) (Map %k %v) (out %k) (out %v) (Option (Tuple %k %v)))))

  (clr-seq->map (: Map.MapModule.FromEnumerable (-> (Seq (Tuple %k %v)) (EqualityComparer %k) (Map %k %v))))
  (map->seq (: Map.MapModule.AsEnumerable   (-> (Map %k %v) (Seq (Tuple %k %v)))))

  ;; Cursor.
  (map-cursor         (: Map.MapModule.Cursor        (-> (Map %k %v) (MapCursor %k %v))))
  (map-cursor-done?   (: Map.MapModule.CursorDone    (-> (MapCursor %k %v) bool)))
  (map-cursor-current (: Map.MapModule.CursorCurrent (-> (MapCursor %k %v) (Tuple %k %v))))
  (map-cursor-next    (: Map.MapModule.CursorNext    (-> (MapCursor %k %v) (MapCursor %k %v))))

  ;; --- Builders ---
  ;; Build map.
  (clr-mapbuilder-empty (: Map.MapBuilderModule.Empty   (-> (EqualityComparer %k) (MapBuilder %k %v))))
  (map->mapbuilder     (: Map.MapBuilderModule.FromMap  (-> (Map %k %v) (MapBuilder %k %v))))
  (mapbuilder-add!     (: Map.MapBuilderModule.Add      (-> (MapBuilder %k %v) %k %v void)))
  (mapbuilder-add-all! (: Map.MapBuilderModule.AddRange (-> (MapBuilder %k %v) (Seq (Tuple %k %v)) void)))
  ;; Length.
  (mapbuilder-length   (: Map.MapBuilderModule.Count    (-> (MapBuilder %k %v) int)))
  (mapbuilder->map     (: Map.MapBuilderModule.Build    (-> (MapBuilder %k %v) (Map %k %v))))

  ;; --- Transients ---
  (clr-transientmap-empty   (: Map.TransientMapModule.Empty          (-> (EqualityComparer %k) (TransientMap %k %v))))
  (map->transientmap        (: Map.TransientMapModule.FromPersistent (-> (Map %k %v) (TransientMap %k %v))))
  ;; Convert.
  (transientmap->map        (: Map.TransientMapModule.ToPersistent   (-> (TransientMap %k %v) (Map %k %v))))
  (transientmap-set!        (: Map.TransientMapModule.Set            (-> (TransientMap %k %v) %k %v void)))
  (transientmap-set-all!    (: Map.TransientMapModule.SetRange       (-> (TransientMap %k %v) (Seq (Tuple %k %v)) void)))
  (transientmap-remove!     (: Map.TransientMapModule.Remove         (-> (TransientMap %k %v) %k void)))
  (transientmap-remove-all! (: Map.TransientMapModule.RemoveRange    (-> (TransientMap %k %v) (Seq %k) void)))
  (transientmap-contains?   (: Map.TransientMapModule.ContainsKey    (-> (TransientMap %k %v) %k bool)))
  (transientmap-ref         (: Map.TransientMapModule.Ref            (-> (TransientMap %k %v) %k %v)))
  (transientmap-ref-or      (: Map.TransientMapModule.RefOr          (-> (TransientMap %k %v) %k %v %v)))
  (transientmap-length      (: Map.TransientMapModule.Count          (-> (TransientMap %k %v) int)))
  (transientmap-empty?      (: Map.TransientMapModule.IsEmpty        (-> (TransientMap %k %v) bool)))
  (transientmap-filter!     (: Map.TransientMapModule.FilterInPlace  (-> (-> %k %v bool) (TransientMap %k %v) void)))
  (transientmap-try-ref     (: Map.TransientMapModule.TryGetValue    (-> (TransientMap %k %v) %k (out %v) (Option %v)))))


(: (-> (Map %k %v) %k bool))
(defun (map-has-key? m key) (map-contains? m key))

;; `map-add-new` with the failure as a value: `(Err v)` carries the value the
;; key already has. Two lookups where `map-add-new` does one, because the trie
;; module has no call that adds and reports in one.
(: (-> (Map %k %v) %k %v (Result %v (Map %k %v))))
(defun (map-try-add-new m k v)
  (match (map-try-ref m k)
    ((Some old) (Err old))
    (None (Ok (map-set m k v)))))

;; Find first. The same as `map-try-find`.
(: (-> (-> %k %v bool) (Map %k %v) (Option (Tuple %k %v))))
(defun (map-find pred m) (map-try-find pred m))

;; What makes a map out of nothing asks for the key's Eq, and the map compares
;; keys with it — the same answer `=` gives, also for two cases of a union that
;; `=` equates. One made from a map keeps that map's.
(: (-> (Map %k %v)) (where (Eq %k)))
(defun (map-empty) (clr-map-empty (eq-comparer)))

(: (-> (Seq (Tuple %k %v)) (Map %k %v)) (where (Eq %k)))
(defun (seq->map xs) (clr-seq->map xs (eq-comparer)))
(:deprecated seq->map "use `->map`, which takes any iterable of pairs")

(: (-> (MapBuilder %k %v)) (where (Eq %k)))
(defun (mapbuilder-empty) (clr-mapbuilder-empty (eq-comparer)))

(: (-> (TransientMap %k %v)) (where (Eq %k)))
(defun (transientmap-empty) (clr-transientmap-empty (eq-comparer)))


;; ---------------------------------------------------------------------------
;; Maps, where the callback may suspend
;; ---------------------------------------------------------------------------

(: (-> (-?-> %k %v %w) (Map %k %v) (Map %k %w)))
(defbjouble (map-map f m)
  (#:sync (clr-map-map f m))
  (#:bjo
    ;; (loop (:for (k v) m)
    ;;       (:acc acc (mapping (Tuple k (f k v)))))
    (let ((b (clr-mapbuilder-empty (clr-map-comparer m))))
      (let go ((c (map-cursor m)))
        (if (map-cursor-done? c)
            (mapbuilder->map b)
            (let ()
              (def (k v) (map-cursor-current c))
              (mapbuilder-add! b k (f k v))
              (go (map-cursor-next c))))))))

(: (-> (-?-> %v %w) (Map %k %v) (Map %k %w)))
(defbjouble (map-map-values f m)
  (#:sync (clr-map-map-values f m))
  (#:bjo
    (let ((b (clr-mapbuilder-empty (clr-map-comparer m))))
      (let go ((c (map-cursor m)))
        (if (map-cursor-done? c)
            (mapbuilder->map b)
            (let ()
              (def (k v) (map-cursor-current c))
              (mapbuilder-add! b k (f v))
              (go (map-cursor-next c))))))))

(: (-> (-?-> %k %v bool) (Map %k %v) (Map %k %v)))
(defbjouble (map-filter keep? m)
  (#:sync (clr-map-filter keep? m))
  (#:bjo
    ;; (loop (:for (k v) m)
    ;;       (:when (keep? k v))
    ;;       (:acc new-map (mapping (Tuple k v))))
    (let ((b (clr-mapbuilder-empty (clr-map-comparer m))))
      (let go ((c (map-cursor m)))
        (if (map-cursor-done? c)
            (mapbuilder->map b)
            (let ()
              (def (k v) (map-cursor-current c))
              (when (keep? k v)
                (mapbuilder-add! b k v))
              (go (map-cursor-next c))))))))

(: (-> (-?-> %k %v %s %s) %s (Map %k %v) %s))
(defbjouble (map-fold f init m)
  (#:sync (clr-map-fold f init m))
  (#:bjo
    ;; (loop (:for (k v) m)
    ;;       (:acc acc (folding init (f k v acc))))
    ;; `f` before the step: arguments are evaluated in order, and a value made
    ;; before a call that may leave the inlined path must live across it. The
    ;; JIT then keeps it on the stack. The step reads only the cursor.
    (let go ((acc init) (c (map-cursor m)))
      (if (map-cursor-done? c)
          acc
          (let ()
            (def (k v) (map-cursor-current c))
            (go (f k v acc) (map-cursor-next c)))))))

(: (-> (-?-> %k %v bool) (Map %k %v) bool))
(defbjouble (map-iter f m)
  (#:sync (clr-map-iter f m))
  (#:bjo
    ;; (loop (:for (k v) m)
    ;;       (:acc acc (folding #t (f k v)))
    ;;       (:finish (not acc)))
    (let go ((c (map-cursor m)))
      (if (map-cursor-done? c)
          #t
          (let ()
            (def (k v) (map-cursor-current c))
            (if (f k v)
                (go (map-cursor-next c))
                #f))))))

(: (-> (-?-> %k %v void) (Map %k %v) void))
(defun (map-for-each f m)
  ;; (loop (:for (k v) m)
  ;;       (:do (f k v)))
  (let go ((c (map-cursor m)))
    (if (map-cursor-done? c)
        unit
        (let ()
          (def (k v) (map-cursor-current c))
          (f k v)
          (go (map-cursor-next c))))))

;; Two maps are equal when they hold the same entries.

(impl (Eq (Map %k %v))
  (where (Eq %k) (Eq %v))
  (defun (= a b)
    (and (= (map-length a) (map-length b))
         (map-iter (fun (k v)
                     (match (map-try-ref b k)
                       ((Some w) (= v w))
                       (None #f)))
                   a)))
  ;; Hash map.
  (defun (eq-hash m)
    (map-fold (fun (k v h) (bitwise-xor h (hash-combine (eq-hash k) (eq-hash v)))) 0 m)))

;; Two immutable arrays are equal when they hold equal elements in the same
;; order. The value cannot change, so it has a hash.
(impl (Eq (IArray %a))
  (where (Eq %a))
  (defun (= a b)
    (def len (iarray-length a))
    (if (= len (iarray-length b))
        (let go ((i 0))
          (if (= i len)
              #t
              (if (= (iarray-ref a i) (iarray-ref b i))
                  (go (+ i 1))
                  #f)))
        #f))
  (defun (eq-hash xs)
    (def len (iarray-length xs))
    (let go ((i 0) (h 17))
      (if (= i len)
          h
          (go (+ i 1) (hash-combine h (eq-hash (iarray-ref xs i))))))))




;; ---------------------------------------------------------------------------
;; Collector
;; ---------------------------------------------------------------------------

;; Collector interface.
(def/trait (Collector %c)
  (type %elem)
  (type %acc)
  (type %out)
  (: collector-init (-> %c %acc))
  (: collector-step (-> %c %acc %elem %acc))
  (: collector-finish (-> %c %acc %out)))

;; Collectors.

(type (: (Listing %a) (Union listing)))

;; Listing.
(impl (Collector (Listing %a))
  (type %elem %a)
  (type %acc (ListBuilder %a))
  (type %out (List %a))
  (defun (collector-init c) (listbuilder-empty))
  (defun (collector-step c acc x) (listbuilder-add! acc x) acc)
  (defun (collector-finish c acc) (listbuilder->list acc)))

;; Listing in reverse: each value consed onto the list so far, so the list is
;; the values last first, and there is no builder to finish.
(type (: (ListingReverse %a) (Union listing/reverse)))

(impl (Collector (ListingReverse %a))
  (type %elem %a)
  (type %acc (List %a))
  (type %out (List %a))
  (defun (collector-init c) Nil)
  (defun (collector-step c acc x) (Cons x acc))
  (defun (collector-finish c acc) acc))

;; Vecing.
(type (: (Vecing %a) (Union vecing)))

(impl (Collector (Vecing %a))
  (type %elem %a)
  (type %acc (VecBuilder %a))
  (type %out (Vec %a))
  (defun (collector-init c) (vecbuilder-empty))
  (defun (collector-step c acc x) (vecbuilder-add! acc x) acc)
  (defun (collector-finish c acc) (vecbuilder->vec acc)))

;; Vecing into a builder for a vec that is likely small: its tail starts at 4
;; items and doubles, where `vecing` takes a leaf of 32 at the first item.
(type (: (VecingSmall %a) (Union vecing/small)))

(impl (Collector (VecingSmall %a))
  (type %elem %a)
  (type %acc (VecBuilder %a))
  (type %out (Vec %a))
  (defun (collector-init c) (vecbuilder-empty/small))
  (defun (collector-step c acc x) (vecbuilder-add! acc x) acc)
  (defun (collector-finish c acc) (vecbuilder->vec acc)))

;; Mapping.
(type (: (Mapping %k %v) (Union mapping)))

(impl (Collector (Mapping %k %v))
  (where (Eq %k))
  (type %elem (Tuple %k %v))
  (type %acc (MapBuilder %k %v))
  (type %out (Map %k %v))
  (defun (collector-init c) (mapbuilder-empty))
  (defun (collector-step c acc kv)
    (def (k v) kv)
    (mapbuilder-add! acc k v)
    acc)
  (defun (collector-finish c acc) (mapbuilder->map acc)))

;; --- Starting from a collection: `#:into` ---
;;
;; `(vecing x #:into v)` adds to the back of `v` rather than to an empty vec,
;; and so do `listing` to a list and `mapping` to a map; `listing/reverse`
;; conses onto the front of its list, which costs nothing at all. The loop
;; makes the collector as `(collector-into vecing v)`, and the builder is made
;; from `v` once, before the first element: every step is the step it was.
;;
;; A collector takes `#:into` by implementing this, which says what it can
;; start from and what collector that makes. One that does not is a type error
;; naming it.
(def/trait (CollectorInto %c)
  (type %seed)
  (type %into)
  (: collector-into (-> %c %seed %into)))

(type (: (VecingInto %a) (Struct (: seed (Vec %a)))))

(impl (Collector (VecingInto %a))
  (type %elem %a)
  (type %acc (VecBuilder %a))
  (type %out (Vec %a))
  (defun (collector-init c) (vec->vecbuilder (record-ref c seed)))
  (defun (collector-step c acc x) (vecbuilder-add! acc x) acc)
  (defun (collector-finish c acc) (vecbuilder->vec acc)))

(impl (CollectorInto (Vecing %a))
  (type %seed (Vec %a))
  (type %into (VecingInto %a))
  (defun (collector-into c seed) (VecingInto (seed seed))))

;; The vec it starts from says how big it is, so `/small' has nothing to add.
(impl (CollectorInto (VecingSmall %a))
  (type %seed (Vec %a))
  (type %into (VecingInto %a))
  (defun (collector-into c seed) (VecingInto (seed seed))))

;; A list grows only at the front, so adding to its back copies it, once.
(type (: (ListingInto %a) (Struct (: seed (List %a)))))

(impl (Collector (ListingInto %a))
  (type %elem %a)
  (type %acc (ListBuilder %a))
  (type %out (List %a))
  (defun (collector-init c) (list->listbuilder (record-ref c seed)))
  (defun (collector-step c acc x) (listbuilder-add! acc x) acc)
  (defun (collector-finish c acc) (listbuilder->list acc)))

(impl (CollectorInto (Listing %a))
  (type %seed (List %a))
  (type %into (ListingInto %a))
  (defun (collector-into c seed) (ListingInto (seed seed))))

;; Consing onto the front shares the list it starts from: nothing is copied.
(type (: (ListingReverseInto %a) (Struct (: seed (List %a)))))

(impl (Collector (ListingReverseInto %a))
  (type %elem %a)
  (type %acc (List %a))
  (type %out (List %a))
  (defun (collector-init c) (record-ref c seed))
  (defun (collector-step c acc x) (Cons x acc))
  (defun (collector-finish c acc) acc))

(impl (CollectorInto (ListingReverse %a))
  (type %seed (List %a))
  (type %into (ListingReverseInto %a))
  (defun (collector-into c seed) (ListingReverseInto (seed seed))))

;; The map's own key comparer goes with it, so no `Eq' is asked for.
(type (: (MappingInto %k %v) (Struct (: seed (Map %k %v)))))

(impl (Collector (MappingInto %k %v))
  (type %elem (Tuple %k %v))
  (type %acc (MapBuilder %k %v))
  (type %out (Map %k %v))
  (defun (collector-init c) (map->mapbuilder (record-ref c seed)))
  (defun (collector-step c acc kv)
    (def (k v) kv)
    (mapbuilder-add! acc k v)
    acc)
  (defun (collector-finish c acc) (mapbuilder->map acc)))

(impl (CollectorInto (Mapping %k %v))
  (type %seed (Map %k %v))
  (type %into (MappingInto %k %v))
  (defun (collector-into c seed) (MappingInto (seed seed))))

;; Stringing.
(type (: Stringing (Union stringing)))

(impl (Collector Stringing)
  (type %elem char)
  (type %acc StringBuilder)
  (type %out string)
  (defun (collector-init c) (stringbuilder-empty))
  (defun (collector-step c acc x) (stringbuilder-add! acc x) acc)
  (defun (collector-finish c acc) (stringbuilder->string acc)))

;; Summing and counting work at every numeric type. A sum has the type of what
;; it adds. A count has the type its use asks for, and is an int when nothing
;; asks, as a literal is.
(type (: (Summing %a) (Union summing)))

(impl (Collector (Summing %a))
  (where (Num %a))
  (type %elem %a)
  (type %acc %a)
  (type %out %a)
  (defun (collector-init c) 0)
  (defun (collector-step c acc x) (+ acc x))
  (defun (collector-finish c acc) acc))

(type (: (Counting %a %n) (Union counting)))

(impl (Collector (Counting %a %n))
  (where (Num %n))
  (type %elem %a)
  (type %acc %n)
  (type %out %n)
  (defun (collector-init c) 0)
  (defun (collector-step c acc x) (+ acc 1))
  (defun (collector-finish c acc) acc))

;; Folding.
(type (: (Folding %a) (Union (: folding %a))))

(impl (Collector (Folding %a))
  (type %elem %a)
  (type %acc %a)
  (type %out %a)
  (defun (collector-init c) (match c ((folding s) s)))
  (defun (collector-step c acc x) x)
  (defun (collector-finish c acc) acc))




;; ---------------------------------------------------------------------------
;; Iterable
;; ---------------------------------------------------------------------------
;; Iterable protocol. What the compiler does, is that it fuses
;; subsequent seql, so doing (-> an-iterable map map map filter map take) should fuse
;; to only ONE IEnumerable, meaning only one of the shitty awful state machines.
(def/trait (Iterable %s)
  (type %elem)
  (type %cursor)
  (: iterable-start (-> %s %cursor))
  ;; A walk calls this once per step, before `current`. So a cursor may be a
  ;; .NET enumerator that steps here, as the `Seq` impl's does; its
  ;; `iterable-next` then answers the same enumerator.
  (: iterable-done? (-> %s %cursor bool))
  (: iterable-current (-> %s %cursor %elem))
  (: iterable-next (-> %s %cursor %cursor))
  ;; A loop calls this on each cursor it stops before `done?` answered true:
  ;; at a `:finish`, an `:abandon`, or when another driver of the level ended
  ;; first. It may also come after `done?` answered true, or a second time,
  ;; and must then do nothing: a `zip` ends the longer side when the shorter
  ;; one ends. A cursor that holds a resource for the walk releases it here.
  (: iterable-end (-> %s %cursor void))
  ;; A loop calls this, in place of `iterable-end`, on each cursor that is
  ;; live when an exception or a non-local exit (such as `ret` of a
  ;; `with-return`) leaves it. A cursor that holds a resource releases it here
  ;; as well. With the default, which does nothing, the loop has no `try`
  ;; around it and keeps no record of its cursors.
  (: iterable-cleanup (-> %s %cursor void))
  (: ->seq  (-> %s (Seq %elem)))
  (: fold (-> (-> %elem %acc %acc) %acc %s %acc))
  (: map    (-> (-> %elem %b) %s (Seq %b)))
  (: filter (-> (-> %elem bool) %s (Seq %elem)))
  (: take (-> int %s (Seq %elem)))
  (: drop (-> int %s (Seq %elem)))
  (: take-while (-> (-> %elem bool) %s (Seq %elem)))
  (: drop-while (-> (-> %elem bool) %s (Seq %elem)))
  (: seq-enumerate (-> %s (Seq (Tuple int %elem))))
  (: flat-map (-> (-> %elem (Seq %b)) %s (Seq %b)))
  ;; The methods below return a value rather than a sequence, so their defaults
  ;; are ordinary loops instead of `seql`s. A `seql` becomes a C# iterator,
  ;; which cannot await, so only these can take a callback of either colour.
  (: any? (-> (-?-> %elem bool) %s bool))
  (: all? (-> (-?-> %elem bool) %s bool))
  (: find (-> (-?-> %elem bool) %s (Option %elem)))
  (: for-each (-> (-?-> %elem void) %s void))
  (: ->list (-> %s (List %elem)))
  (: ->vec (-> %s (Vec %elem)))
  (: count (-> %s int))
  (: first (-> %s (Option %elem)))

  ;; Most cursors hold nothing that needs release.
  (defun (iterable-end s c) (when #f ()))
  (defun (iterable-cleanup s c) (when #f ()))
  (defun (->seq s)
    (seql (:for e s)
          (:yield e)))
  (defun (fold f acc coll)
    (loop (:for elem coll)
          (:acc res (folding acc (f elem res)))))
  (defun (map f s)
    (seql (:for e s)
          (:yield (f e))))
  (defun (filter f s)
    (seql (:for e s)
          (:when (f e))
          (:yield e)))
  ;; The count is tested before the walk pulls, so the element after the n-th
  ;; is never asked for: over a port it stays for the next reader.
  (defun (take n s)
    (seql (:with i 0 (+ i 1) (>= i n))
          (:for elem s)
          (:yield elem)))
  ;; this is of course not efficient, but hey. 
  (defun (drop n s)
    (seql (:with i 1 (+ i 1))
          (:for elem s)
          (:when (> i n))
          (:yield elem)))
  (defun (take-while f s)
    (seql (:for elem s)
          (:finish (not (f elem)))
          (:yield elem)))

  ;; The flag is made inside the `seq`, whose body runs once per walk, so that
  ;; walking the result twice drops the same elements both times.
  (defun (drop-while f s)
    (seq
      (def/mutable dropping #t)
      (loop (:for elem s)
            (:do (when (and dropping (not (f elem)))
                   (set! dropping #f)))
            (:when (not dropping))
            (:do (yield elem)))))

  ;; A `seql`, so that a loop over it fuses with a chain of others, as
  ;; `(seq-enumerate (map f xs))` does. `enumerate` makes an adapter instead.
  (defun (seq-enumerate s)
    (seql (:with i 0 (+ i 1))
          (:for e s)
          (:yield (Tuple i e))))

  (defun (flat-map f s)
    (seql (:for e s)
          (:subloop)
          (:for x (f e))
          (:yield x)))

  ;; `folding` keeps the last stepped value, so the accumulator holds the
  ;; current element's answer and `:finish` stops on it.
  (defun (any? f s)
    (loop (:for e s)
          (:acc found (folding #f (f e)))
          (:finish found)))

  (defun (all? f s)
    (loop (:for e s)
          (:acc ok (folding #t (f e)))
          (:finish (not ok))))

  (defun (find f s)
    (loop (:for e s)
          (:acc got (folding None (if (f e) (Some e) None)))
          (:finish (match got ((Some _) #t) (None #f)))))

  (defun (for-each f s)
    (loop (:for e s)
          (:do (ignore (f e)))))

  (defun (->list s)
    (loop (:for e s)
          (:acc xs (listing e))))

  (defun (->vec s)
    (loop (:for e s)
          (:acc xs (vecing e))))

  ;; Walks the whole of `s`. A collection that knows its length answers it.
  (defun (count s)
    (loop (:for e s)
          (:acc n (counting e))))

  ;; Stops on the first element, so the walk pulls only that one.
  (defun (first s)
    (loop (:for e s)
          (:acc got (folding None (Some e)))
          (:finish #t)))
  )

;; Declared before the other implementations because the inherited
;; `flat-map` default walks the `(Seq %b)` its callback returns, and an
;; implementation is only in scope for the ones checked after it.
(impl (Iterable (Seq %a))
  (type %elem %a)
  ;; The walk's cursor is the enumerator itself. The protocol calls `done?`
  ;; once per step, before `current`, so `done?` is where it steps, and
  ;; `next` has nothing left to do.
  (type %cursor (SeqEnumerator %a))
  (defun (iterable-start s) (seq-enumerator s))
  (defun (iterable-done? s e) (not (seq-enumerator-next! e)))
  (defun (iterable-current s e) (seq-enumerator-current e))
  (defun (iterable-next s e) e)
  ;; Disposes the enumerator, which closes a file the sequence opened for
  ;; this walk.
  (defun (iterable-end s e) (seq-enumerator-end! e))
  ;; The same on an exception, so that a file is closed then too.
  (defun (iterable-cleanup s e) (seq-enumerator-end! e))

  (defun (->seq s) s))

(impl (Iterable (List %a))
  (type %elem %a)
  (type %cursor (List %a))
  (defun (iterable-start s) s)
  (defun (iterable-done? s c) (list-empty? c))
  (defun (iterable-current s c) (list-head c))
  (defun (iterable-next s c) (list-tail c))
  (defun (->list s) s))

;; A struct cursor that walks the vec's leaf arrays: an array read per
;; element, and nothing allocated for the walk.
(impl (Iterable (Vec %a))
  (type %elem %a)
  (type %cursor (VecCursor %a))
  (defun (iterable-start s) (vec-cursor s))
  (defun (iterable-done? s c) (vec-cursor-done? c))
  (defun (iterable-current s c) (vec-cursor-current c))
  (defun (iterable-next s c) (vec-cursor-next c))
  (defun (->vec s) s)
  (defun (count s) (vec-length s)))

;; `>=` rather than `=`: the JIT drops the bounds check on `array-ref` only
;; when the loop test is `index < length`.
(impl (Iterable (Array %a))
  (type %elem %a)
  (type %cursor int)
  (defun (iterable-start s) 0)
  (defun (iterable-done? s index) (>= index (array-length s)))
  (defun (iterable-current s index) (array-ref s index))
  (defun (iterable-next s index) (+ index 1))
  (defun (count s) (array-length s)))

;; An `int` cursor, as `Array` has.
(impl (Iterable (IArray %a))
  (type %elem %a)
  (type %cursor int)
  (defun (iterable-start s) 0)
  (defun (iterable-done? s index) (>= index (iarray-length s)))
  (defun (iterable-current s index) (iarray-ref s index))
  (defun (iterable-next s index) (+ index 1))
  (defun (count s) (iarray-length s)))

(: (-> (IArray %a) (Vec %a)))
(defun (iarray->vec xs) (->vec xs))

(: (-> (IArray %a) (List %a)))
(defun (iarray->list xs) (->list xs))

;; Range of ints, in steps of one. A step of one reaches `hi` before it can
;; pass `int-max`, so the walk tests `(>= c hi)`, the test the JIT knows from a
;; loop over an array's indices.
(type (: Range (Struct (: lo int) (: hi int))))

(: (-> int int Range))
(defun (range lo hi)
  (Range (lo lo) (hi hi)))

(impl (Iterable Range)
  (type %elem int)
  (type %cursor int)
  (defun (iterable-start s) (record-ref s lo))
  (defun (iterable-done? s c) (>= c (record-ref s hi)))
  (defun (iterable-current s c) c)
  (defun (iterable-next s c) (+ c 1)))

;; Range of ints, in steps of `by`. A step past the last value can pass
;; `int-max`, so the walk counts in a long, where it cannot wrap round below
;; `hi`: a value below `hi` and a step of at most `int-max` stay far below
;; `long-max`.
(type (: RangeBy (Struct (: lo int) (: hi int) (: by int))))

;; A range counts up, so a step of zero or less would never reach `hi`. The
;; message is made in `range-by-panic`, so that `range-by` is small enough for
;; the JIT to inline at the start of a loop.
(: (-> int int int RangeBy))
(defun (range-by lo hi by)
  (when (<= by 0)
    (range-by-panic by))
  (RangeBy (lo lo) (hi hi) (by by)))

(: (-> int void))
(defun (range-by-panic by)
  (panic! #"range-by: the step is ${by}, and a range counts up from lo to hi. down-from counts down."))

;; How many values a non-empty range holds, in longs, where `hi - lo` cannot
;; overflow.
(: (-> int int int long))
(defun (range-by-count lo hi by)
  (+ (/ (- (- (cast long hi) (cast long lo)) 1L) (cast long by)) 1L))

(impl (Iterable RangeBy)
  (type %elem int)
  (type %cursor long)
  (defun (iterable-start s) (cast long (record-ref s lo)))
  (defun (iterable-done? s c) (>= c (cast long (record-ref s hi))))
  (defun (iterable-current s c) (cast int c))
  (defun (iterable-next s c) (+ c (cast long (record-ref s by)))))

;; Map elements.
(impl (Iterable (Map %k %v))
  (type %elem (Tuple %k %v))
  (type %cursor (MapCursor %k %v))
  (defun (iterable-start s) (map-cursor s))
  (defun (iterable-done? s c) (map-cursor-done? c))
  (defun (iterable-current s c) (map-cursor-current c))
  (defun (iterable-next s c) (map-cursor-next c))
  (defun (count s) (map-length s)))

;; String characters. Not a `StringCursor`, which asks the string at every
;; step whether it is a slice: a walk takes its bytes once and decodes each
;; character as it steps onto it.
(import/class
  (StringWalk (: Bjolang.Runtime.StringWalk)))

(import/extern
  (string-walk         (: Bjolang.Runtime.StringWalks.Start   (-> string StringWalk)))
  (string-walk-done?   (: Bjolang.Runtime.StringWalks.Done    (-> StringWalk bool)))
  (string-walk-current (: Bjolang.Runtime.StringWalks.Current (-> StringWalk char)))
  (string-walk-next    (: Bjolang.Runtime.StringWalks.Next    (-> StringWalk StringWalk))))

(impl (Iterable string)
  (type %elem char)
  (type %cursor StringWalk)
  (defun (iterable-start s) (string-walk s))
  (defun (iterable-done? s c) (string-walk-done? c))
  (defun (iterable-current s c) (string-walk-current c))
  (defun (iterable-next s c) (string-walk-next c)))

;; An iterable of pairs as a map. Not a method of `Iterable`: its where clause
;; says the element is a pair, and a member may not constrain the
;; implementor. Copied into the call, so that it fuses with a chain under it.
(: (-> %s (Map %k %v)) (where (Eq %k) (Iterable %s #:elem (Tuple %k %v))))
(defun (->map s) #:inline
  (loop (:for e s)
        (:acc m (mapping e))))

;; ---------------------------------------------------------------------------
;; Adapters
;; ---------------------------------------------------------------------------
;;
;; An adapter is a struct around iterables, and an iterable itself: its
;; element and cursor types are made from theirs, and its methods call
;; theirs. A loop over one at a known type inlines it with what it wraps, so
;; it allocates nothing; through a dictionary its class holds the dictionaries
;; of what it wraps. `iterable-end` and `iterable-cleanup` are passed on, so
;; an adapter over a sequence that holds a file closes it as the sequence
;; would, and one over iterables that hold nothing keeps the loop free of a
;; guard. The cursor is taken apart with a `def` rather than `fst` and `snd`
;; where it is passed on: `Simplify` can see that the binding does nothing,
;; and so that a cleanup which does nothing leaves no guard.

;; The elements of `inner`, each with its index from 0.
(type (: (Enumerated %s) (Struct (: inner %s))))

(: (-> %s (Enumerated %s)) (where (Iterable %s)))
(defun (enumerate s) (Enumerated (inner s)))

(impl (Iterable (Enumerated %s)) (where (Iterable %s))
  (type %elem (Tuple int (assoc Iterable elem %s)))
  (type %cursor (Tuple int (assoc Iterable cursor %s)))
  (defun (iterable-start e) (Tuple 0 (iterable-start (record-ref e inner))))
  (defun (iterable-done? e c) (iterable-done? (record-ref e inner) (snd c)))
  (defun (iterable-current e c) (Tuple (fst c) (iterable-current (record-ref e inner) (snd c))))
  (defun (iterable-next e c) (Tuple (+ (fst c) 1) (iterable-next (record-ref e inner) (snd c))))
  (defun (iterable-end e c)
    (def (Tuple _ k) c)
    (iterable-end (record-ref e inner) k))
  (defun (iterable-cleanup e c)
    (def (Tuple _ k) c)
    (iterable-cleanup (record-ref e inner) k)))

;; The elements of `left` and `right` in pairs, until either ends.
(type (: (Zipped %l %r) (Struct (: left %l) (: right %r))))

(: (-> %l %r (Zipped %l %r)) (where (Iterable %l) (Iterable %r)))
(defun (zip l r) (Zipped (left l) (right r)))

;; `done?` asks the left side first. When one side ends, the other is ended
;; there and then, so that a sequence holding a file is closed although its
;; walk did not finish; the loop ends no cursor whose `done?` answered true.
;; When the right side is the shorter, the left has read one element more,
;; which nothing uses.
(impl (Iterable (Zipped %l %r)) (where (Iterable %l) (Iterable %r))
  (type %elem (Tuple (assoc Iterable elem %l) (assoc Iterable elem %r)))
  (type %cursor (Tuple (assoc Iterable cursor %l) (assoc Iterable cursor %r)))
  (defun (iterable-start z)
    (Tuple (iterable-start (record-ref z left)) (iterable-start (record-ref z right))))
  ;; Written with `or` and `and` rather than `if`s: where both ends do nothing,
  ;; `Simplify` drops them, and the test is one expression, as two lockstep
  ;; `:for`s would make it.
  (defun (iterable-done? z c)
    (def (Tuple kl kr) c)
    (or (and (iterable-done? (record-ref z left) kl)
             (begin (iterable-end (record-ref z right) kr) #t))
        (and (iterable-done? (record-ref z right) kr)
             (begin (iterable-end (record-ref z left) kl) #t))))
  (defun (iterable-current z c)
    (Tuple (iterable-current (record-ref z left) (fst c))
           (iterable-current (record-ref z right) (snd c))))
  (defun (iterable-next z c)
    (Tuple (iterable-next (record-ref z left) (fst c))
           (iterable-next (record-ref z right) (snd c))))
  (defun (iterable-end z c)
    (def (Tuple kl kr) c)
    (iterable-end (record-ref z left) kl)
    (iterable-end (record-ref z right) kr))
  (defun (iterable-cleanup z c)
    (def (Tuple kl kr) c)
    (iterable-cleanup (record-ref z left) kl)
    (iterable-cleanup (record-ref z right) kr)))

;; Each element of `inner` with the one after it: (Tuple a b), one fewer
;; than `inner` has, in one walk of it.
(type (: (Pairwise %s) (Struct (: inner %s))))

(: (-> %s (Pairwise %s)) (where (Iterable %s)))
(defun (pairwise s) (Pairwise (inner s)))

;; The cursor is the element before and the inner cursor at the one after.
;; `start` takes the first element, so it asks the inner `done?` of the first
;; cursor itself; `None` before says the inner iterable was empty, and no
;; `done?` is asked again of that cursor. `current` and `next` both read the
;; element at the inner cursor.
(impl (Iterable (Pairwise %s)) (where (Iterable %s))
  (type %elem (Tuple (assoc Iterable elem %s) (assoc Iterable elem %s)))
  (type %cursor (Tuple (Option (assoc Iterable elem %s)) (assoc Iterable cursor %s)))
  ;; One tuple, not one per branch, and `done?` with `or` rather than a
  ;; `match`: over an array, the loop is then faster than one that indexes
  ;; the array twice.
  (defun (iterable-start w)
    (def k (iterable-start (record-ref w inner)))
    (def empty (iterable-done? (record-ref w inner) k))
    (Tuple (if empty None (Some (iterable-current (record-ref w inner) k)))
           (if empty k (iterable-next (record-ref w inner) k))))
  (defun (iterable-done? w c)
    (def (Tuple before k) c)
    (or (none? before) (iterable-done? (record-ref w inner) k)))
  (defun (iterable-current w c)
    (def (Tuple before k) c)
    (Tuple (option-ref before) (iterable-current (record-ref w inner) k)))
  (defun (iterable-next w c)
    (def (Tuple _ k) c)
    (Tuple (Some (iterable-current (record-ref w inner) k))
           (iterable-next (record-ref w inner) k)))
  (defun (iterable-end w c)
    (def (Tuple _ k) c)
    (iterable-end (record-ref w inner) k))
  (defun (iterable-cleanup w c)
    (def (Tuple _ k) c)
    (iterable-cleanup (record-ref w inner) k)))

;; The elements of `first` and then those of `second`: two iterables with one
;; element type, of any two kinds.
(type (: (Chained %a %b) (Struct (: first %a) (: second %b))))

(: (-> %a %b (Chained %a %b)) (where (Iterable %a #:elem %e) (Iterable %b #:elem %e)))
(defun (chain a b) (Chained (first a) (second b)))

;; The cursor is a flag, which says the walk is on the second, and a cursor
;; for each side. A first's `done?` that answers true moves the walk to the
;; second, which a `done?` of this adapter cannot do, since it answers no
;; cursor: so the first's is asked where the cursor is made, by `start` and
;; by `next`, once for each of its cursors, and on the first side this
;; `done?` answers false without asking. So `next` reads the element after
;; the current one before a loop does, as `in-cycle` does. The second side's
;; cursor is made at the start, and its `done?` is the one a loop asks. The
;; pin is what lets `current` answer either side's element as one type.
(impl (Iterable (Chained %a %b))
  (where (Iterable %a) (Iterable %b #:elem (assoc Iterable elem %a)))
  (type %elem (assoc Iterable elem %a))
  (type %cursor (Tuple bool (assoc Iterable cursor %a) (assoc Iterable cursor %b)))
  (defun (iterable-start h)
    (def ka (iterable-start (record-ref h first)))
    (Tuple (iterable-done? (record-ref h first) ka) ka (iterable-start (record-ref h second))))
  (defun (iterable-done? h c)
    (def (Tuple on-second _ kb) c)
    (and on-second (iterable-done? (record-ref h second) kb)))
  (defun (iterable-current h c)
    (def (Tuple on-second ka kb) c)
    (if on-second
        (iterable-current (record-ref h second) kb)
        (iterable-current (record-ref h first) ka)))
  (defun (iterable-next h c)
    (def (Tuple on-second ka kb) c)
    (if on-second
        (Tuple #t ka (iterable-next (record-ref h second) kb))
        (let ((next-a (iterable-next (record-ref h first) ka)))
          (Tuple (iterable-done? (record-ref h first) next-a) next-a kb))))
  ;; Both sides, whichever the walk is on: an end of a cursor whose `done?`
  ;; answered true does nothing, as the protocol says, and with no test
  ;; here, ends that do nothing leave the loop no guard.
  (defun (iterable-end h c)
    (def (Tuple _ ka kb) c)
    (iterable-end (record-ref h first) ka)
    (iterable-end (record-ref h second) kb))
  (defun (iterable-cleanup h c)
    (def (Tuple _ ka kb) c)
    (iterable-cleanup (record-ref h first) ka)
    (iterable-cleanup (record-ref h second) kb)))

;; `item`, `times` times, or without end when `times` is `repeat-endless`,
;; which is what `in-repeat` gives when no count is written. It is
;; `int-min`, which no count written as a count is.
(type (: (Repeated %a) (Struct (: item %a) (: times int))))

(: int)
(def repeat-endless -2147483648)

(: (-> %a (#:times int) (Repeated %a)))
(defun (in-repeat x #:times repeat-endless) (Repeated (item x) (times times)))

(impl (Iterable (Repeated %a))
  (type %elem %a)
  (type %cursor int)
  (defun (iterable-start r) 0)
  (defun (iterable-done? r i)
    (and (not (= (record-ref r times) repeat-endless)) (>= i (record-ref r times))))
  (defun (iterable-current r i) (record-ref r item))
  (defun (iterable-next r i) (+ i 1)))

;; The elements of `inner`, over and over: when a walk of it ends, the next
;; one starts. It ends when a walk yields nothing, so the cycle of an empty
;; iterable is empty, and so is the next pass over a port that is used up.
(type (: (Cycled %s) (Struct (: inner %s))))

(: (-> %s (Cycled %s)) (where (Iterable %s)))
(defun (in-cycle s) (Cycled (inner s)))

;; `done?` of the inner iterable is asked once for each of its cursors, as
;; the protocol wants: a cursor over a sequence pulls when asked. So `next`
;; asks it of the cursor it makes, and the flag in the cursor says that it
;; answered false; when it answered true, `next` starts the next walk, and
;; `done?` asks of that cursor in turn. `next` therefore pulls the element
;; after the current one before a loop asks for it, as `zip` does on its
;; left side.
(impl (Iterable (Cycled %s)) (where (Iterable %s))
  (type %elem (assoc Iterable elem %s))
  (type %cursor (Tuple bool (assoc Iterable cursor %s)))
  (defun (iterable-start y) (Tuple #f (iterable-start (record-ref y inner))))
  (defun (iterable-done? y c)
    (def (Tuple asked k) c)
    (and (not asked) (iterable-done? (record-ref y inner) k)))
  (defun (iterable-current y c) (iterable-current (record-ref y inner) (snd c)))
  (defun (iterable-next y c)
    (def (Tuple _ k) c)
    (def n (iterable-next (record-ref y inner) k))
    (if (iterable-done? (record-ref y inner) n)
        (Tuple #f (iterable-start (record-ref y inner)))
        (Tuple #t n)))
  (defun (iterable-end y c)
    (def (Tuple _ k) c)
    (iterable-end (record-ref y inner) k))
  (defun (iterable-cleanup y c)
    (def (Tuple _ k) c)
    (iterable-cleanup (record-ref y inner) k)))


;; ---------------------------------------------------------------------------
;; Cursor
;; ---------------------------------------------------------------------------

;; Cursor.
(def/trait (Cursor %s)
  (type %elem)
  (type %cursor)
  (: cursor-start (-> %s %cursor))
  (: cursor-end (-> %s %cursor))
  (: cursor-end? (-> %s %cursor bool))
  (: cursor-ref (-> %s %cursor %elem))
  (: cursor-next (-> %s %cursor %cursor))
  (: cursor-prev (-> %s %cursor %cursor)))

(impl (Cursor string)
  (type %elem char)
  (type %cursor StringCursor)
  (defun (cursor-start s) (string-cursor-start s))
  (defun (cursor-end s) (string-cursor-end s))
  (defun (cursor-end? s c) (string-cursor-end? s c))
  (defun (cursor-ref s c) (string-cursor-ref s c))
  (defun (cursor-next s c) (string-cursor-next s c))
  (defun (cursor-prev s c) (string-cursor-prev s c)))


;; ---------------------------------------------------------------------------
;; Lists, where the callback may suspend
;; ---------------------------------------------------------------------------
;; The walks below are written #:inline where their body is past the size the
;; compiler copies by itself: copied, the loop is in the caller with the
;; callback's body in it, and no delegate is made or called.
;;
;; List map.
(: (-> (-?-> %a %b) (List %a) (List %b)))
(defun (list-map f xs)
  (loop (:for elem xs)
        (:acc lst (listing (f elem)))))

(: (-> (-?-> %a bool) (List %a) (List %a)))
(defun (list-filter keep? xs) #:inline
  (loop (:for elem xs)
        (:when (keep? elem))
        (:acc acc (listing elem))))

;; List foldl.
(: (-> (-?-> %a %b %b) %b (List %a) %b))
(defun (list-foldl f init xs) #:inline
  (loop (:for elem xs)
        (:acc acc (folding init (f elem acc)))))

;; List foldr.
(: (-> (-?-> %a %b %b) %b (List %a) %b))
(defun (list-foldr f init xs) #:inline
  (loop (:for elem (list-reverse xs))
        (:acc acc (folding init (f elem acc)))))

(: (-> (-?-> %a Unit) (List %a) Unit))
(defun (list-for-each f xs)
  (loop (:for elem xs)
        (:do (f elem))))

;; The list seq-unfold would make, without the lazy seq. The update is
;; evaluated after the iteration, so it reads the state the :finish-let bound.
(: (-> (-?-> %s (Option (Tuple %a %s))) %s (List %a)))
(defun (list-unfold f state)
  (loop (:with step (f state) (f next))
        (:finish-let (Some (Tuple x next)) step)
        (:acc out (listing x))))

;; ---------------------------------------------------------------------------
;; Vecs, where the callback may suspend
;; ---------------------------------------------------------------------------
;; Vec functions.

(import/extern
  (clr-vec-map            (: BjolangRuntime.RrbMap          (-> (-> %a %b) (Vec %a) (Vec %b))))
  ;; A vec of the same shape as the first, holding the array's items in
  ;; order: what `clr-vec-map` makes, for items made by a function that may
  ;; suspend, which no extern can call.
  (clr-vec-map-shape      (: Collections.RrbFun.MapShape    (-> (Vec %a) (Array %b) (Vec %b))))
  (clr-vec-filter         (: BjolangRuntime.RrbFilter       (-> (-> %a bool) (Vec %a) (Vec %a))))
  (clr-vec-fold           (: BjolangRuntime.RrbFold         (-> (-> %a %b %b) %b (Vec %a) %b)))
  (clr-vec-reduce         (: BjolangRuntime.RrbReduce       (-> (-> %a %a %a) (Vec %a) %a)))
  (clr-vec-for-each       (: BjolangRuntime.RrbForEach      (-> (-> %a Unit) (Vec %a) Unit)))
  (clr-vec-for-each/range (: BjolangRuntime.RrbForEachRange (-> (-> %a Unit) (Vec %a) int int Unit)))
  (clr-vec-iter           (: BjolangRuntime.RrbIter         (-> (-> %a bool) (Vec %a) bool)))
  ;; The checks the ordinary copies make, for the suspending copies to make
  ;; too, so that both raise the same thing.
  (clr-vec-check-reduce   (: BjolangRuntime.RrbCheckReduce  (-> (Vec %a) Unit)))
  (clr-vec-check-range    (: BjolangRuntime.RrbCheckRange   (-> (Vec %a) int int Unit)))
  ;; Append one element at the end — the persistent counterpart of
  ;; `vecbuilder-add!`, and what `Addable`'s impl for Vec delegates to.
  (vec-add                (: Collections.RrbFun.Add         (-> (Vec %a) %a (Vec %a))))
  ;; Add one element at the front — the persistent counterpart of
  ;; `transientvec-add-first!`, as `vec-pop-first` is of `transientvec-pop-first!`.
  (vec-add-first          (: Collections.RrbFun.Prepend     (-> (Vec %a) %a (Vec %a)))))

;; Vec map.
(: (-> (-?-> %a %b) (Vec %a) (Vec %b)))
;;
;; Not inlined: `clr-vec-map` copies the vec's arrays at their exact size, and
;; for the short vecs most programs map that is faster than a loop into a
;; builder, even with the call through the delegate.
;;
;; The suspending copy keeps the vec's shape too: the items go into an array
;; in order, and `clr-vec-map-shape` lays them out as `v` is laid out. So the
;; halves of a split, mapped in bjoroutines, merge back into a dense vec.
(defbjouble (vec-map f v)
  #:no-inline
  (#:sync (clr-vec-map f v))
  (#:bjo
    (def out (make-array (vec-length v)))
    (loop (:for elem v)
          (:with i 0 (+ i 1))
          (:do (array-set! out i (f elem))))
    (clr-vec-map-shape v out)))

(: (-> (-?-> %a bool) (Vec %a) (Vec %a)))
(defbjouble (vec-filter keep? v)
  #:inline
  (#:sync (clr-vec-filter keep? v))
  (#:bjo
    (loop (:for elem v)
          (:when (keep? elem))
          (:acc acc (vecing/small elem)))))

(: (-> (-?-> %a %b %b) %b (Vec %a) %b))
(defbjouble (vec-fold f init v)
  #:inline
  (#:sync (clr-vec-fold f init v))
  (#:bjo
    (loop (:for elem v)
          (:acc acc (folding init (f elem acc))))))

;; Vec reduce.
(: (-> (-?-> %a %a %a) (Vec %a) %a))
(defbjouble (vec-reduce f v)
  (#:sync (clr-vec-reduce f v))
  (#:bjo
    (ignore (clr-vec-check-reduce v))
    (let go ((i 1) (acc (vec-ref v 0)))
      (if (= i (vec-length v))
          acc
          (go (+ i 1) (f (vec-ref v i) acc))))))

(: (-> (-?-> %a Unit) (Vec %a) Unit))
(defbjouble (vec-for-each f v)
  (#:sync (clr-vec-for-each f v))
  (#:bjo
    (loop (:for elem v)
          (:do (f elem)))))

(: (-> (-?-> %a Unit) (Vec %a) int int Unit))
(defbjouble (vec-for-each/range f v index count)
  (#:sync (clr-vec-for-each/range f v index count))
  (#:bjo
    (ignore (clr-vec-check-range v index count))
    (let go ((i index) (left count))
      (if (= left 0)
          unit
          (let ()
            (ignore (f (vec-ref v i)))
            (go (+ i 1) (- left 1)))))))

;; Vec iter.
(: (-> (-?-> %a bool) (Vec %a) bool))
(defbjouble (vec-iter f v)
  #:inline
  (#:sync (clr-vec-iter f v))
  (#:bjo
    (loop (:for elem v)
          (:acc acc (folding #t (f elem)))
          (:finish (not acc)))))

;; ---------------------------------------------------------------------------
;; Seqs, where the callback may suspend
;; ---------------------------------------------------------------------------
;;
;; The eager two. `seq-unfold` is lazy and stays a builtin: its callback runs
;; when the walker pulls, which is somewhere else.

(: (-> (-?-> %a %b %b) %b (Seq %a) %b))
(defun (seq-fold f init s)
  (let ((e (seq-enumerator s)))
    (let go ((acc init))
      (if (seq-enumerator-next! e)
          (go (f (seq-enumerator-current e) acc))
          acc))))

(: (-> (-?-> %a Unit) (Seq %a) Unit))
(defun (seq-for-each f s)
  (let ((e (seq-enumerator s)))
    (let go ()
      (if (seq-enumerator-next! e)
          (let ()
            (ignore (f (seq-enumerator-current e)))
            (go))
          unit))))


;; ---------------------------------------------------------------------------
;; Conversions
;; ---------------------------------------------------------------------------
;; Conversions.

(: (-> (List (Tuple %k %v)) (Map %k %v)))
(defun (list->map xs)
  (loop (:for kvp xs)
        (:acc map (mapping kvp))))

(: (-> (List %a) (Vec %a)))
(defun (list->vec lst)
  {vecing e (:for e lst)})

(: (-> (Map %k %v) (List (Tuple %k %v))))
(defun (map->list m)
  {listing kvp (:for kvp m)})

(: (-> (Vec (Tuple %k %v)) (Map %k %v)))
(defun (vec->map v)
  (loop (:for kvp v)
        (:acc map (mapping kvp))))

;; This can actually be faster than the loop, since list-for-each
;; uses internal iteration.
(: (-> (Vec %a) (List %a)))
(defun (vec->list v)
  (def b (listbuilder-empty))
  (vec-for-each (fun (elem) (listbuilder-add! b elem)) v )
  (listbuilder->list b))

(: (-> (Map %k %v) (Vec (Tuple %k %v))))
(defun (map->vec m)
  {vecing kvp (:for kvp m)})


;; --------------------------------------------------------------------------
;; Results and options
;; --------------------------------------------------------------------------

;; `some?` and `none?`, for the other two-case builtin.

(: (-> (Result %e %a) bool))
(defun (ok? r)
  (match r
    ((Ok v) #t)
    ((Err e) #f)))

(: (-> (Result %e %a) bool))
(defun (err? r)
  (match r
    ((Ok v) #f)
    ((Err e) #t)))

;; If Err, return the same value, otherwise return Ok (f unwrapped-ok-value)
(: (-> (-?-> %a %b) (Result %e %a) (Result %e %b)))
(defun (result-map f r)
  (match r
    ((Ok v) (Ok (f v)))
    ((Err e) (Err e))))

(: (-> (Option %a) %a %a))
(defun (option-value opt fallback)
  (match opt
    ((Some v) v)
    (None fallback)))

;; --- Pairs ---

(: (-> (Tuple %a %b) %a))
(defun (fst p)
  (match p ((Tuple a _) a)))

(: (-> (Tuple %a %b) %b))
(defun (snd p)
  (match p ((Tuple _ b) b)))


;; --------------------------------------------------------------------------
;; Boxes - a 1-width array
;; --------------------------------------------------------------------------

(type (: (Box %a) #:opaque (Struct (: field (Array %a)))))
(impl (Written (Box %a))
  (where (Written %a))
  (defun (write-into box b)
    (stringbuilder-add-string! b "(Box ")
    (write-into (box-ref box) b)
    (stringbuilder-add-string! b ")")))

(impl (Displayed (Box %a))
  (where (Displayed %a))
  (defun (display-into box b)
    (stringbuilder-add-string! b "(Box ")
    (display-into (box-ref box) b)
    (stringbuilder-add-string! b ")")))
(: (-> %a (Box %a)))
(defun (make-box elem)
  (def arr (make-array 1))
  (array-set! arr 0 elem)
  (Box (field arr)))

(: (-> (Box %a) %a))
(defun (box-ref b)
  (-> (struct-ref b field)
      (array-ref & 0)))

(: (-> (Box %a) %a Unit))
(defun (box-set! box val)
  (def arr (struct-ref box field))
  (array-set! arr 0 val))



;; --------------------------------------------------------------------------
;; Refable and Derefable trait - a "generic" ref function
;; --------------------------------------------------------------------------
(def/trait (Refable %c)
  (type %index)
  (type %out)
  (: ref (-> %c %index %out))
  (: try-ref (-> %c %index (Option %out)))

  ;; For things like arrays, a ref with index out of bounds should fail
  ;; regardless of Option, so this is here to not have to write those impls
  (defun (try-ref coll i)
    (Some (ref coll i))))

(impl (Refable (Array %i))
  (type %index int)
  (type %out %i)
  (defun (ref arr i)
    (array-ref arr i)))

(impl (Refable (IArray %i))
  (type %index int)
  (type %out %i)
  (defun (ref xs i)
    (iarray-ref xs i))
  (defun (try-ref xs i)
    (iarray-try-ref xs i)))

(impl (Refable (Vec %i))
  (type %index int)
  (type %out %i)
  (defun (ref vec i)
    (vec-ref vec i))
  (defun (try-ref vec i)
    (if (and (>= i 0) (< i (vec-length vec)))
        (Some (vec-ref vec i))
        None)))

(impl (Refable (Map %k %v))
  (type %index %k)
  (type %out %v)
  (defun (ref map k)
    (map-ref map k))
  (defun (try-ref map k)
    (map-try-ref map k)))

(impl (Refable string)
  (type %index StringCursor)
  (type %out char)
  (defun (ref str cur)
    (string-cursor-ref str cur))
  (defun (try-ref str cur)
    (if (string-cursor-end? str cur)
        None
        (Some (string-cursor-ref str cur)))))

;; The collections written in place, read by the same `ref`, so that `get`
;; and `try-get` read them and a `set!` path can go through them.
(impl (Refable (VecBuilder %i))
  (type %index int)
  (type %out %i)
  (defun (ref vb i)
    (vecbuilder-ref vb i))
  (defun (try-ref vb i)
    (if (and (>= i 0) (< i (vecbuilder-length vb)))
        (Some (vecbuilder-ref vb i))
        None)))

(impl (Refable (TransientVec %i))
  (type %index int)
  (type %out %i)
  (defun (ref t i)
    (transientvec-ref t i))
  (defun (try-ref t i)
    (if (and (>= i 0) (< i (transientvec-length t)))
        (Some (transientvec-ref t i))
        None)))

(impl (Refable (TransientMap %k %v))
  (type %index %k)
  (type %out %v)
  (defun (ref t k)
    (transientmap-ref t k))
  (defun (try-ref t k)
    (transientmap-try-ref t k)))

;; Settable — the persistent write that goes with `ref`
;;
;; `(ref-set coll i x)` answers a copy of `coll` with `x` at `i`, and leaves
;; `coll` alone. It is a trait of its own rather than a method of `Refable`
;; because many things that can be read by index cannot sensibly be copied
;; with one slot changed: a string read by cursor, a set read by membership,
;; or a mutable collection, whose write is `!` and in place.
;;
;; `set` and `update` write through it. A Map gains a key it did not have; a
;; Vec index out of range throws.
(def/trait (Settable %c)
  (type %index)
  (type %in)
  (: ref-set (-> %c %index %in %c)))

(impl (Settable (Vec %i))
  (type %index int)
  (type %in %i)
  (defun (ref-set vec i x)
    (vec-set vec i x)))

(impl (Settable (Map %k %v))
  (type %index %k)
  (type %in %v)
  (defun (ref-set map k v)
    (map-set map k v)))

;; Settable! — the write in place that goes with `ref`
;;
;; `(ref-set! coll i x)` writes `x` at `i` in `coll` itself, as `Addable!`
;; adds to a collection in place where `Addable` answers a copy. `set!` with a
;; path writes its last key through it. A persistent collection has no impl,
;; because it has no place to write: `ref-set` answers its copy.
;;
;; A Map, transient or mutable, gains a key it did not have; an Array or a Vec
;; index out of range throws.
(def/trait (Settable! %c)
  (type %index)
  (type %in)
  (: ref-set! (-> %c %index %in void)))

(impl (Settable! (Array %i))
  (type %index int)
  (type %in %i)
  (defun (ref-set! arr i x)
    (array-set! arr i x)))

(impl (Settable! (VecBuilder %i))
  (type %index int)
  (type %in %i)
  (defun (ref-set! vb i x)
    (vecbuilder-set! vb i x)))

(impl (Settable! (TransientVec %i))
  (type %index int)
  (type %in %i)
  (defun (ref-set! t i x)
    (transientvec-set! t i x)))

(impl (Settable! (TransientMap %k %v))
  (type %index %k)
  (type %in %v)
  (defun (ref-set! t k v)
    (transientmap-set! t k v)))

(def/trait (Derefable %a)
  (type %out)
  (: deref (-> %a %out))
  (: try-deref (-> %a (Option %out)))
  (defun (try-deref p) (Some (deref p))))

(impl (Derefable (Param %b))
  (type %out %b)
  (defun (deref p) (parameter-ref p)))

(impl (Derefable (Box %b))
  (type %out %b)
  (defun (deref b) (box-ref b)))

;; Derefable! — the write in place that goes with `deref`
;;
;; `(deref-set! cell x)` puts `x` in `cell`, as `Settable!` goes with
;; `Settable`. `(set! name value)` writes through it when `name` is not a
;; `def/mutable`: the binding cannot change, so what it holds does. A Param has
;; no impl, since a Param is rebound for an extent with `parameterize` and
;; not written.
(def/trait (Derefable! %a)
  (type %in)
  (: deref-set! (-> %a %in void)))

(impl (Derefable! (Box %b))
  (type %in %b)
  (defun (deref-set! b x) (box-set! b x)))


;; ---------------------------------------------------------------------------
;; Maths
;; ---------------------------------------------------------------------------

;; Math.

(import (std maths))

;; Remember: exporting one trait function exposes ALL functions.
(re-export abs sign min max clamp zero?)

;; Square root.
(import/extern
  (sqrt (: System.Math.Sqrt)))

;; ---------------------------------------------------------------------------
;; Strings, conversions, files and paths
;; ---------------------------------------------------------------------------
;; Wrappers.

;; --- Strings ---

;; Invariant throughout. The ambient culture reads and writes "1.5" as "1,5"
;; where the decimal separator is a comma, and writes -100 as "−100" with
;; U+2212 where sv-SE does, so a number written by one machine is unreadable on
;; the next.
(import/extern
  (clr-concat        (: BjoString.Utf8String.Concat))
  (clr-concat-all    (: BjolangRuntime.StringConcat))
  (clr-parse-int     (: Bjolang.Runtime.BjoNum.ParseInt))
  (clr-parse-long    (: Bjolang.Runtime.BjoNum.ParseLong))
  (clr-parse-double  (: Bjolang.Runtime.BjoNum.ParseDouble))
  (clr-double-string (: Bjolang.Runtime.BjoNum.DoubleToString))
  (clr-int-string    (: Bjolang.Runtime.BjoNum.IntToString))
  (clr-long-string   (: Bjolang.Runtime.BjoNum.LongToString))
  (clr-byte-string   (: Bjolang.Runtime.BjoNum.ByteToString))
  (clr-parse-decimal (: Bjolang.Runtime.BjoNum.ParseDecimal))
  (clr-parse-bigint  (: Bjolang.Runtime.BjoNum.ParseInteger (-> string bigint)))
  (clr-parse-int128  (: Bjolang.Runtime.BjoNum.ParseInteger (-> string int128)))
  (clr-parse-uint128 (: Bjolang.Runtime.BjoNum.ParseInteger (-> string uint128)))
  (clr-format-number (: Bjolang.Runtime.BjoNum.FormatNumber (-> %a string))))

(: (-> string string string))
(defun (string-append a b) (clr-concat a b))

;; Variadic concatenation.
(: (-> #:rest string string))
(defun (str #:rest parts) (clr-concat-all parts))

;; String length in storage units: bytes of UTF-8.
(: (-> string int))
(defun (string-length s) (.-ByteLength s))

;; --- Searching and rewriting -----------------------------------------------
;; Ordinal: bytes of UTF-8 compared as they are.

(import/extern
  (clr-contains    (: BjolangRuntime.StringContains))
  (clr-starts-with (: BjolangRuntime.StringStartsWith))
  (clr-ends-with   (: BjolangRuntime.StringEndsWith))
  (clr-replace     (: BjolangRuntime.StringReplace)))

(: (-> string string bool))
(defun (string-contains? s needle) (clr-contains s needle))

(: (-> string string bool))
(defun (string-starts-with? s prefix) (clr-starts-with s prefix))

(: (-> string string bool))
(defun (string-ends-with? s suffix) (clr-ends-with s suffix))

;; String replace.
(: (-> string string string string))
(defun (string-replace s old new) (clr-replace s old new))

;; --- Case ------------------------------------------------------------------
;; Invariant case.
(: (-> string string))
(defun (string-upcase s) (.ToUpperInvariant s))

(: (-> string string))
(defun (string-downcase s) (.ToLowerInvariant s))

;; --- Trimming and padding --------------------------------------------------
;; Trim whitespace.
(: (-> string string))
(defun (string-trim s) (.Trim s))

(: (-> string string))
(defun (string-trim-left s) (.TrimStart s))

(: (-> string string))
(defun (string-trim-right s) (.TrimEnd s))

;; The /slice forms share the string's bytes rather than copying them, so
;; what they answer keeps the whole string alive. `string-copy` gives such a
;; string bytes of its own, and is the string itself when it has them.
(: (-> string string))
(defun (string-trim/slice s) (.TrimSlice s))

(: (-> string string))
(defun (string-trim-left/slice s) (.TrimStartSlice s))

(: (-> string string))
(defun (string-trim-right/slice s) (.TrimEndSlice s))

(: (-> string string))
(defun (string-copy s) (.Copy s))

;; --- Taking and dropping characters ----------------------------------------
;; A count of characters from one end of a string. The cursors walk the count,
;; so the cost is in the count and not in the length of the string. A count
;; past the end takes or drops the whole string; a negative count is refused.
;; The /slice forms share the string's bytes, as the trims' do.

(: (-> string int void))
(defun (check-count who n)
  (when (< n 0)
    (count-panic who n)))

(: (-> string int void))
(defun (count-panic who n)
  (panic! #"${who}: the count is ${n}, and a count of characters or elements is 0 or more."))

;; The cursor n characters after c, or the end when there are fewer.
(: (-> string StringCursor int StringCursor))
(defun (forward-at-most s c n)
  (let go ((c c) (k n))
    (if (or (= k 0) (string-cursor-end? s c))
        c
        (go (string-cursor-next s c) (- k 1)))))

;; The cursor n characters before c, or the start when there are fewer.
(: (-> string StringCursor int StringCursor))
(defun (back-at-most s c n)
  (def start (string-cursor-start s))
  (let go ((c c) (k n))
    (if (or (= k 0) (string-cursor=? c start))
        c
        (go (string-cursor-prev s c) (- k 1)))))

(: (-> string StringCursor int StringCursor))
(defun (string-cursor-forward s c n)
  (check-count "string-cursor-forward" n)
  (let go ((c c) (k n))
    (if (= k 0) c (go (string-cursor-next s c) (- k 1)))))

(: (-> string StringCursor int StringCursor))
(defun (string-cursor-back s c n)
  (check-count "string-cursor-back" n)
  (let go ((c c) (k n))
    (if (= k 0) c (go (string-cursor-prev s c) (- k 1)))))

(: (-> string int string))
(defun (string-take s n)
  (check-count "string-take" n)
  (substring s (string-cursor-start s) (forward-at-most s (string-cursor-start s) n)))

(: (-> string int string))
(defun (string-drop s n)
  (check-count "string-drop" n)
  (substring s (forward-at-most s (string-cursor-start s) n) (string-cursor-end s)))

(: (-> string int string))
(defun (string-take-right s n)
  (check-count "string-take-right" n)
  (substring s (back-at-most s (string-cursor-end s) n) (string-cursor-end s)))

(: (-> string int string))
(defun (string-drop-right s n)
  (check-count "string-drop-right" n)
  (substring s (string-cursor-start s) (back-at-most s (string-cursor-end s) n)))

(: (-> string int string))
(defun (string-take/slice s n)
  (check-count "string-take/slice" n)
  (substring/slice s (string-cursor-start s) (forward-at-most s (string-cursor-start s) n)))

(: (-> string int string))
(defun (string-drop/slice s n)
  (check-count "string-drop/slice" n)
  (substring/slice s (forward-at-most s (string-cursor-start s) n) (string-cursor-end s)))

(: (-> string int string))
(defun (string-take-right/slice s n)
  (check-count "string-take-right/slice" n)
  (substring/slice s (back-at-most s (string-cursor-end s) n) (string-cursor-end s)))

(: (-> string int string))
(defun (string-drop-right/slice s n)
  (check-count "string-drop-right/slice" n)
  (substring/slice s (string-cursor-start s) (back-at-most s (string-cursor-end s) n)))

;; The text before the first sep and the text after it, or None when sep is
;; not in s.
(: (-> string string (Option (Tuple string string))))
(defun (string-split-once s sep)
  (match (string-search s sep)
    ((Some c)
     (Some (Tuple (substring s (string-cursor-start s) c)
                  (substring s (string-cursor-forward s c (string-count sep)) (string-cursor-end s)))))
    (None None)))

(: (-> string string (Option (Tuple string string))))
(defun (string-split-once/slice s sep)
  (match (string-search s sep)
    ((Some c)
     (Some (Tuple (substring/slice s (string-cursor-start s) c)
                  (substring/slice s (string-cursor-forward s c (string-count sep)) (string-cursor-end s)))))
    (None None)))

;; Pad width.
(: (-> string int (#:with char) string))
(defun (string-pad-left s width #:with #\space)
  (let ((b (stringbuilder-empty)))
    (string-pad-fill! b with (- width (string-count s)))
    (stringbuilder-add-string! b s)
    (stringbuilder->string b)))

(: (-> string int (#:with char) string))
(defun (string-pad-right s width #:with #\space)
  (let ((b (stringbuilder-empty)))
    (stringbuilder-add-string! b s)
    (string-pad-fill! b with (- width (string-count s)))
    (stringbuilder->string b)))

;; Pad fill.
(: (-> StringBuilder char int void))
(defun (string-pad-fill! b c n)
  (let fill ((i 0))
    (when (< i n)
      (stringbuilder-add! b c)
      (fill (+ i 1)))))

;; --- Splitting and joining -------------------------------------------------

;; String split, empty fields kept. The runtime gives the array the split
;; makes to the vec without copying it, which only it can do safely.
(import/extern
  (clr-split        (: BjolangRuntime.SplitToVec (-> string string (Vec string))))
  (clr-split/slices (: BjolangRuntime.SplitSlicesToVec (-> string string (Vec string)))))

(: (-> string string (Vec string)))
(defun (string-split s sep) (clr-split s sep))

;; The fields as slices of `s`, sharing its bytes.
(: (-> string string (Vec string)))
(defun (string-split/slice s sep) (clr-split/slices s sep))

(: (-> (Vec string) string string))
(defun (string-join parts sep)
  (def b (stringbuilder-empty))
  (loop (:with first? #t #f)
        (:for part parts)
        (:do (unless first? (stringbuilder-add-string! b sep))
             (stringbuilder-add-string! b part)))
  (stringbuilder->string b))

;; --- Conversions ---
;; ToString wrappers. Each is invariant, so each round-trips through the
;; matching reader on any machine. See the externs above.

(: (-> int string))
(defun (int->string n) (clr-int-string n))

(: (-> long string))
(defun (long->string n) (clr-long-string n))

(: (-> double string))
(defun (double->string n) (clr-double-string n))

(: (-> byte string))
(defun (byte->string n) (clr-byte-string n))

;; Number to string.
(: (-> int string))
(defun (number->string n) (int->string n))

(: (-> string int))
(defun (string->int s) (clr-parse-int s))

(: (-> string long))
(defun (string->long s) (clr-parse-long s))

(: (-> string double))
(defun (string->double s) (clr-parse-double s))

;; The four numbers past the eight. A decimal is written and read with a point
;; and no exponent when it has none: (decimal->string 1.50M) is "1.50", as
;; .NET keeps a decimal's scale.
(: (-> decimal string))
(defun (decimal->string n) (clr-format-number n))

(: (-> string decimal))
(defun (string->decimal s) (clr-parse-decimal s))

(: (-> bigint string))
(defun (bigint->string n) (clr-format-number n))

(: (-> string bigint))
(defun (string->bigint s) (clr-parse-bigint s))

(: (-> int128 string))
(defun (int128->string n) (clr-format-number n))

(: (-> string int128))
(defun (string->int128 s) (clr-parse-int128 s))

(: (-> uint128 string))
(defun (uint128->string n) (clr-format-number n))

(: (-> string uint128))
(defun (string->uint128 s) (clr-parse-uint128 s))

;; --- Bytes and strings ---
;;
;; An encoding is a .NET `System.Text.Encoding`. `(text encodings)` has one
;; value for each encoding .NET knows, and finds them by name; UTF-8 is the
;; default here and needs no import.
;;
;; Both directions are strict, as Racket's `bytes->string/utf-8` is: what
;; does not decode, or has no bytes in the encoding, is an error naming its
;; offset. `#:replace (Some c)` puts `c` there instead. A port is the
;; lenient one: it reads what does not decode as U+FFFD.

(type (: Encoding System.Text.Encoding))

(import/extern
  (clr-utf-8          (: Bjolang.Runtime.Encodings.Cp65001 #:get))
  (clr-decode         (: Bjolang.Runtime.Encodings.Decode (-> (Array byte) int int Encoding string)))
  (clr-decode/replace (: Bjolang.Runtime.Encodings.Decode (-> (Array byte) int int Encoding char string)))
  (clr-encode         (: Bjolang.Runtime.Encodings.Encode (-> string Encoding (Array byte))))
  (clr-encode/replace (: Bjolang.Runtime.Encodings.Encode (-> string Encoding char (Array byte))))
  ;; Whether the bytes from `start` to `end` are UTF-8, which is what
  ;; `bytes->string` would accept. Vectorized: a reader that copies runs of
  ;; bytes checks a run with it in one call.
  (bytes-utf-8?       (: Bjolang.Runtime.Encodings.IsUtf8 (-> (Array byte) int int bool))))

;; The text of the bytes from `#:start` to `#:end`, in `#:encoding`. A string
;; is UTF-8, so from UTF-8 this checks the bytes and copies them. A byte order
;; mark is a character like any other.
(: (-> (Array byte) (#:encoding Encoding) (#:start int) (#:end int) (#:replace (Option char)) string))
(defun (bytes->string bytes #:encoding clr-utf-8 #:start 0 #:end (array-length bytes) #:replace None)
  (match replace
    (None (clr-decode bytes start end encoding))
    ((Some c) (clr-decode/replace bytes start end encoding c))))

;; The string's bytes in `#:encoding`, without a byte order mark. To UTF-8
;; this is a copy of the string's own bytes.
(: (-> string (#:encoding Encoding) (#:replace (Option char)) (Array byte)))
(defun (string->bytes s #:encoding clr-utf-8 #:replace None)
  (match replace
    (None (clr-encode s encoding))
    ((Some c) (clr-encode/replace s encoding c))))

;; ---------------------------------------------------------------------------
;; Characters
;; ---------------------------------------------------------------------------
;; Unicode characters.
(: (-> char int))
(defun (char->integer c) (char->int c))

(: (-> int char))
(defun (integer->char n) (int->char n))

;; Character ordering.
(: (-> char char bool))
(defun (char=? a b) (= a b))

(: (-> char char bool))
(defun (char<? a b) (< a b))

(: (-> char char bool))
(defun (char>? a b) (> a b))

(: (-> char char bool))
(defun (char<=? a b) (<= a b))

(: (-> char char bool))
(defun (char>=? a b) (>= a b))

;; Case-insensitive comparison.
(: (-> char char bool))
(defun (char-ci=? a b) (= (char-foldcase a) (char-foldcase b)))

(: (-> char char bool))
(defun (char-ci<? a b) (< (char-foldcase a) (char-foldcase b)))

(: (-> char char bool))
(defun (char-ci>? a b) (> (char-foldcase a) (char-foldcase b)))

(: (-> char char bool))
(defun (char-ci<=? a b) (<= (char-foldcase a) (char-foldcase b)))

(: (-> char char bool))
(defun (char-ci>=? a b) (>= (char-foldcase a) (char-foldcase b)))

;; ---------------------------------------------------------------------------
;; String cursors
;; ---------------------------------------------------------------------------
;; String cursors.
(: (-> StringCursor StringCursor bool))
(defun (string-cursor=? a b) (= a b))

(: (-> StringCursor StringCursor bool))
(defun (string-cursor<? a b) (< a b))

(: (-> StringCursor StringCursor bool))
(defun (string-cursor>? a b) (> a b))

(: (-> StringCursor StringCursor bool))
(defun (string-cursor<=? a b) (<= a b))

(: (-> StringCursor StringCursor bool))
(defun (string-cursor>=? a b) (>= a b))

;; --- Traversal -------------------------------------------------------------

;; String fold.
;; The forward walks below ask for the character and the step in one call, so
;; that the unit at the cursor is read and bounds-checked once per character
;; rather than twice.
(: (-> (-> char %a %a) %a string %a))
(defun (string-fold f init s)
  (let loop ((c (string-cursor-start s)) (acc init))
    (if (string-cursor-end? s c)
        acc
        (match (string-cursor-ref+next s c)
          ((Tuple ch next) (loop next (f ch acc)))))))

;; String fold right.
(: (-> (-> char %a %a) %a string %a))
(defun (string-fold-right f init s)
  (let loop ((c (string-cursor-end s)) (acc init))
    (if (string-cursor=? c (string-cursor-start s))
        acc
        (let ((p (string-cursor-prev s c)))
          (loop p (f (string-cursor-ref s p) acc))))))

(: (-> (-> char void) string void))
(defun (string-for-each f s)
  ;; (loop (:for ch s)
  ;;       (:do (f ch)))
  (let loop ((c (string-cursor-start s)))
    (unless (string-cursor-end? s c)
      (def (Tuple ch next) (string-cursor-ref+next s c))
      (f ch)
      (loop next))))

;; String index.
(: (-> (-> char bool) string (Option StringCursor)))
(defun (string-index pred s)
  (let loop ((c (string-cursor-start s)))
    (if (string-cursor-end? s c)
        None
        (match (string-cursor-ref+next s c)
          ((Tuple ch next)
           (if (pred ch)
               (Some c)
               (loop next)))))))

;; --- Conversions -----------------------------------------------------------

(: (-> string (List char)))
(defun (string->list s)
  (string-fold-right cons Nil s))

(: (-> (List char) string))
(defun (list->string cs)
  (def b (stringbuilder-empty))
  (list-for-each #(stringbuilder-add! b &1) cs)
  (stringbuilder->string b))

(: (-> string (Vec char)))
(defun (string->vec s)
  (def b (vecbuilder-empty))
  (string-for-each #(vecbuilder-add! b &1) s)
  (vecbuilder->vec b))

;; Reverse string.
(: (-> string string))
(defun (string-reverse s) (.Reverse s))

;; --- File operations.
;;
;; Everything in this section and the directory one below reaches the disk
;; through the operations of the `FS` effect, declared with the ports further
;; down, so a fake filesystem answers for all of it.

;; How an output file is opened.
;;
;; - `Truncate`: create the file, or empty it if it exists.
;; - `Append`: create the file, or write after what it holds.
;; - `CreateNew`: create the file, and fail if it exists. The check and the
;;   create are one system call, so two writers cannot both succeed.
(type (: WriteMode (Union Truncate Append CreateNew)))

;; What a path names, when it names anything.
(type (: FsKind (Union FsFile FsDirectory)))

;; What a move does when something is already at the target.
;;
;; - `MoveNew`: fails, and changes nothing.
;; - `MoveReplace`: a file at the target is replaced, in the one rename that
;;   moves the new one there, so nothing ever sees the target missing. A
;;   directory is never replaced, whichever of the two it is.
(type (: MoveMode (Union MoveNew MoveReplace)))

;; What `(fs-info path)` answers about a path that names something. One answer
;; to one question, so that a handler cannot say a path is a file and then
;; forget to say how big it is.
;;
;; - `size`: in bytes. 0 for a directory.
;; - `modified-ms`: the last write, in Unix milliseconds, UTC. Milliseconds
;;   because `(std datetime)`'s `unix-milliseconds->instant` takes them, and
;;   the prelude cannot name an `Instant` itself.
;; - `link?`: the path itself is a symbolic link. The other fields are what
;;   .NET reports for it; `directory-walk` does not enter one, so a link back up
;;   the tree cannot loop it.
(type (: FsInfo (Record (: kind FsKind)
                        (: size long)
                        (: modified-ms long)
                        (: link? bool))))

;; The operations answer a `Result`; the functions in these two sections raise
;; the `Err`, as the .NET methods they replaced did.
(: (-> (Result System.Exception %a) %a))
(defun (raise-err r)
  (match r
    ((Ok v) v)
    ((Err e) (raise e))))

;; Read all text.
(: (-> string string))
(defun (file-read-text path)
  (match (open-input-file path)
    ((Ok opened) (with-open ((p opened)) (read-all p)))
    ((Err e) (raise e))))

;; The flush is explicit so that the suspending copy awaits it. Closing would
;; flush too, but synchronously, on whatever thread runs the close.
(: (-> string string WriteMode void))
(defun (write-whole-file path contents mode)
  (match (open-output-file path #:mode mode)
    ((Ok opened) (with-open ((p opened))
                   (write-string p contents)
                   (flush-port p)))
    ((Err e) (raise e))))

;; Write text.
(: (-> string string void))
(defun (file-write-text path contents) (write-whole-file path contents Truncate))

(: (-> string string void))
(defun (file-append-text path contents) (write-whole-file path contents Append))

(: (-> string (Option FsInfo)))
(defun (file-info path) (fs-info path))

;; What a path names, for the functions below that only ask that.
(: (-> string (Option FsKind)))
(defun (kind-of path)
  (match (fs-info path)
    ((Some info) (Some (record-ref info kind)))
    (None None)))

(: (-> string bool))
(defun (file-exists? path)
  (match (kind-of path)
    ((Some FsFile) #t)
    (_ #f)))

;; A missing file is not an error, as with `File.Delete`.
(: (-> string void))
(defun (file-delete path) (raise-err (fs-delete-file path)))

;; Moves or renames a file or a directory. Fails if `to` exists, unless
;; `#:mode MoveReplace` says to replace a file there.
(: (-> string string (#:mode MoveMode) void))
(defun (file-move from to #:mode MoveNew) (raise-err (fs-move from to mode)))

;; --- Paths ---
;; Path strings.

(import/extern
  (clr-full-path      (: System.IO.Path.GetFullPath))
  (clr-path-combine   (: System.IO.Path.Combine))
  (clr-file-name      (: System.IO.Path.GetFileName))
  (clr-file-extension (: System.IO.Path.GetExtension)))

(: (-> string string))
(defun (path-absolute path) (clr-full-path path))

;; Path combine.
(: (-> #:rest string string))
(defun (path-combine #:rest parts) (clr-path-combine parts))

;; Path filename.
(: (-> string (Option string)))
(defun (path-filename path)
  (def name (clr-file-name path))
  (if (string-empty? name) None (Some name)))

;; File extension.
(: (-> string (Option string)))
(defun (path-file-extension path)
  (def ext (clr-file-extension path))
  (if (string-empty? ext) None (Some ext)))

;; --- Directories ---

(: (-> string bool))
(defun (directory-exists? path)
  (match (kind-of path)
    ((Some FsDirectory) #t)
    (_ #f)))

;; Create directory.
(: (-> string void))
(defun (directory-create path) (raise-err (fs-create-directory path)))

;; Delete directory.
(: (-> string void))
(defun (directory-delete path) (raise-err (fs-delete-directory path)))

;; Built from the operations rather than handed to `Directory.Delete` with its
;; recursive flag, so that a handler sees every deletion.
;;
;; A symbolic link to a directory is removed as a link and never entered, and
;; that includes `path` itself. Entering one would delete what it points at: a
;; link to the home directory inside a build directory would empty the home
;; directory, and a link back up the tree would never end.
(: (-> string void))
(defun (directory-delete-tree path)
  (if (directory-link? path)
      (directory-delete path)
      (let ()
        (loop (:for entry (raise-err (fs-list path)))
              (:do (match (fs-info entry)
                     ((Some info)
                      (match (record-ref info kind)
                        (FsDirectory (directory-delete-tree entry))
                        (FsFile (file-delete entry))))
                     ;; A link to nothing, which `file-delete` removes.
                     (None (file-delete entry)))))
        (directory-delete path))))

(: (-> string bool))
(defun (directory-link? path)
  (match (fs-info path)
    ((Some info) (and (record-ref info link?)
                      (match (record-ref info kind) (FsDirectory #t) (FsFile #f))))
    (None #f)))

(: (-> string FsKind (Vec string)))
(defun (entries-of-kind path kind)
  (loop (:for entry (raise-err (fs-list path)))
        (:when (match (Tuple (kind-of entry) kind)
                 ((Tuple (Some FsFile) FsFile) #t)
                 ((Tuple (Some FsDirectory) FsDirectory) #t)
                 (_ #f)))
        (:acc found (vecing entry))))

;; Directory files.
(: (-> string (Vec string)))
(defun (directory-files path) (entries-of-kind path FsFile))

(: (-> string (Vec string)))
(defun (directory-subdirectories path) (entries-of-kind path FsDirectory))

;; --- The environment ---

(import/extern
  (clr-get-env      (: System.Environment.GetEnvironmentVariable))
  (clr-set-env      (: System.Environment.SetEnvironmentVariable))
  (clr-empty?       (: System.String.IsNullOrEmpty))
  (clr-cwd          (: System.Environment.CurrentDirectory #:get))
  (clr-set-cwd      (: System.Environment.CurrentDirectory #:set)))

(: (-> string (Option string)))
(defun (get-environment-variable name)
  (def value (clr-get-env name))
  (if (clr-empty? value)
      None
      (Some value)))

;; Set environment variable.
(: (-> string string void))
(defun (set-environment-variable! name value) (clr-set-env name value))

(: (-> string))
(defun (current-directory) clr-cwd)

(: (-> string void))
(defun (set-current-directory! path) (clr-set-cwd path))

;; ---------------------------------------------------------------------------
;; Ports
;; ---------------------------------------------------------------------------

(import/class
  ;; What the `FS` effect's openers answer, and what a file port is over.
  (Stream (: System.IO.Stream))
  ;; `IOException` covers `CreateNew` finding the file already there, as well
  ;; as the not-found exceptions below it.
  (FileStream (: System.IO.FileStream (-> string FileMode FileAccess FileShare FileStream)
                 #:exceptions (System.IO.IOException
                               System.UnauthorizedAccessException)))
  (FileMode (: System.IO.FileMode))
  (FileAccess (: System.IO.FileAccess))
  (FileShare (: System.IO.FileShare))

  (Exception (: System.Exception)))

;; Port types.
;;
;; One input port type and one output port type, as in Racket: a port is
;; bytes. Text reads decode UTF-8 from an input port, and text writes encode
;; UTF-8 into an output port, so byte and text operations mix on one port.
;; They are also a `System.IO.TextReader` and a `System.IO.TextWriter`, so a
;; .NET API that takes one takes a port.
(type
  (: InputPort Bjolang.Runtime.BjoInputPort)
  (: OutputPort Bjolang.Runtime.BjoOutputPort))

;; What ends a line: Racket's `read-line` modes. `Any` is the default
;; everywhere a line is read.
(type (: LineMode (Union Any AnyOne Linefeed Return ReturnLinefeed)))

;; --- Opening ---
;;
;; A file port is owned by the ambient scope: when the scope returns, the file
;; is closed, whether the program said so or not. A string port is not - it is
;; memory, and the GC prices memory.
;;
;; The scope is read before the file is opened, so a program with no scope to
;; put the port in fails without having opened anything.

(import/extern
  ;; A port over a stream, registered on the ambient scope.
  (owned-port-over (: Bjolang.Runtime.BytePorts.FromStream (-> Stream InputPort)))
  (string-port  (: Bjolang.Runtime.InputPorts.FromString (-> string InputPort)))
  (owned-port-out (: Bjolang.Runtime.OutputPorts.FromStream (-> Stream OutputPort)))
  (string-port-out (: Bjolang.Runtime.OutputPorts.OpenString (-> OutputPort)))
  (output-bytes (: Bjolang.Runtime.OutputPorts.GetBytes (-> OutputPort (Array byte))))
  (close-in     (: BjolangRuntime.CloseInput  (-> InputPort void)))
  (close-out    (: BjolangRuntime.CloseOutput (-> OutputPort void)))
  (close-out-await (: Bjolang.Runtime.OutputPorts.CloseAsync (-> OutputPort void) #:async)))

;; An input port over a stream an opener answered, registered on the ambient
;; scope. Whatever the stream is - a file, or a `MemoryStream` a fake
;; filesystem made - the port is owned the same way.
(: (-> (Result Exception Stream) (Result Exception InputPort)))
(defun (stream->input-port opened)
  (match opened
    ((Ok s) (Ok (owned-port-over s)))
    ((Err e) (Err e))))

;; The same for an output port: a file port is buffered a block at a time, and
;; closing it, or its scope ending, writes what is left.
(: (-> (Result Exception Stream) (Result Exception OutputPort)))
(defun (stream->output-port opened)
  (match opened
    ((Ok s) (Ok (owned-port-out s)))
    ((Err e) (Err e))))

;; Open input string: a port over the string's own UTF-8 bytes, shared rather
;; than copied. Memory only, so nothing registers it.
(: (-> string InputPort))
(defun (open-input-string contents)
  (string-port contents))

;; Open output string: a port that keeps what is written to it, read back with
;; `get-output-string` or `get-output-bytes`. Memory only, so nothing
;; registers it.
(: (-> OutputPort))
(defun (open-output-string)
  (string-port-out))

;; --- Closing ---
;;
;; Closing goes through the owner handle rather than calling `.Dispose`. A
;; direct dispose would close the stream and leave the registration on the
;; scope's list, so a long-lived scope would collect one spent entry per file it
;; had already finished with.
;;
;; On a port nothing owns this disposes, which is what a string port wants. On
;; one of the standard ports it flushes and stops: nothing in the language
;; should be able to take stdout away from the rest of the program.
(: (-> InputPort void))
(defun (close-input-port p) (close-in p))

;; What is still buffered goes out first. On a fiber that write suspends, so the
;; close works over a stream that refuses blocking I/O, as Kestrel's do; the
;; port is closed even when the write fails, and the failure raised after.
;; `with-open` and a scope ending close with a blocking write, which after a
;; `flush-port` has nothing left to do.
(: (-> OutputPort void))
(defbjouble (close-output-port p)
  (#:sync (close-out p))
  (#:bjo  (close-out-await p)))

;; --- The filesystem is an effect ---
;;
;; Everything in this file that reaches the disk goes through these operations,
;; so a handler can answer for the disk: a test runs against a fake, a sandbox
;; refuses writes, a build step records what it read. With no handler installed
;; each is its `/raw` default, which does what the .NET call does.
;;
;; The openers answer a `Stream` rather than a port. The port over it is built
;; and registered on the ambient scope by `open-input-file` and its neighbours -
;; and by `(std ports)`' byte openers - so one handler serves text and bytes
;; alike, and a stream a handler made in memory is owned exactly as a file is.
;;
;; All of them are synchronous. Reading and writing are what wait, and those are
;; the ports' own suspending methods. None is performed in a loop, so all are
;; `#:cold`.
;;
;; The operations answer a `Result`. The functions above over them raise, as the
;; .NET methods they replaced do.

(import/class
  (DirectoryInfo (: System.IO.DirectoryInfo (-> string DirectoryInfo)))
  (FileInfo (: System.IO.FileInfo (-> string FileInfo))))

(import/extern
  (clr-file-exists (: System.IO.File.Exists (-> string bool)))
  (clr-dir-exists  (: System.IO.Directory.Exists (-> string bool)))
  (clr-dir-entries (: System.IO.Directory.GetFileSystemEntries (-> string (Array string))
                      #:exceptions (System.IO.IOException System.UnauthorizedAccessException)))
  (clr-dir-create  (: System.IO.Directory.CreateDirectory (-> string DirectoryInfo)
                      #:exceptions (System.IO.IOException System.UnauthorizedAccessException)))
  (clr-file-delete (: System.IO.File.Delete (-> string void)
                      #:exceptions (System.IO.IOException System.UnauthorizedAccessException)))
  (clr-dir-delete  (: System.IO.Directory.Delete (-> string void)
                      #:exceptions (System.IO.IOException System.UnauthorizedAccessException)))
  (clr-file-move   (: System.IO.File.Move (-> string string bool void)
                      #:exceptions (System.IO.IOException System.UnauthorizedAccessException)))
  (clr-dir-move    (: System.IO.Directory.Move (-> string string void)
                      #:exceptions (System.IO.IOException System.UnauthorizedAccessException))))

;; Read-only, and other readers allowed alongside, as `StreamReader`'s own
;; path constructor opens.
(: (-> string (Result Exception Stream)))
(defun (open-read-stream/raw path)
  (match (FileStream. path FileMode.Open FileAccess.Read FileShare.Read)
    ((Ok s) (Ok (cast Stream s)))
    ((Err e) (Err e))))

(: (-> WriteMode FileMode))
(defun (write-mode->file-mode mode)
  (match mode
    (Truncate FileMode.Create)
    (Append FileMode.Append)
    (CreateNew FileMode.CreateNew)))

;; Write-only, readers allowed alongside, as `StreamWriter`'s path constructor
;; opens.
(: (-> string WriteMode (Result Exception Stream)))
(defun (open-write-stream/raw path mode)
  (match (FileStream. path (write-mode->file-mode mode) FileAccess.Write FileShare.Read)
    ((Ok s) (Ok (cast Stream s)))
    ((Err e) (Err e))))

;; .NET ticks at 1970-01-01T00:00Z, and per millisecond.
(: long)
(def unix-epoch-ticks 621355968000000000L)

;; Rounds toward the past, so a write just before 1970 is -1 and not 0.
(: (-> long long))
(defun (ticks->unix-ms ticks)
  (def d (- ticks unix-epoch-ticks))
  (def q (/ d 10000L))
  (if (< (% d 10000L) 0L) (- q 1L) q))

;; `File.Exists` and `Directory.Exists` first, because they never throw: a
;; path that is no path at all, "" say, is `None` rather than an
;; `ArgumentException` out of the `FileInfo` constructor. The info object then
;; reads the path once, on its first property, so size and time agree with
;; each other; a file deleted in between is `None`.
;; Where a chain of symbolic links ends: `path` itself when it is no link. A
;; link's target is relative to the directory the link is in. At most 40
;; steps, as Linux allows, so that a loop of links ends. Read step by step
;; because `ResolveLinkTarget` answers null for a link to nothing, and there is
;; no null to test here.
(: (-> string string))
(defun (link-end path)
  (let loop ((p path) (steps 0))
    (def target (.-LinkTarget (FileInfo. p)))
    (if (or (clr-empty? target) (= steps 40))
        p
        (loop (match (path-directory p)
                ((Some dir) (path-combine dir target))
                (None target))
              (+ steps 1)))))

;; A link's size and time are those of the file it leads to, which is what
;; reading it reads; `link?` is what says it is one. A link to nothing keeps
;; its own.
(: (-> string (Option FsInfo)))
(defun (file-info/raw path)
  (def own (FileInfo. path))
  (def link (not (clr-empty? (.-LinkTarget own))))
  (def end (if link (FileInfo. (link-end path)) own))
  (def f (if (.-Exists end) end own))
  (if (.-Exists own)
      (Some (FsInfo (kind FsFile)
                    (size (.-Length f))
                    (modified-ms (ticks->unix-ms (.-Ticks (.-LastWriteTimeUtc f))))
                    (link? link)))
      None))

(: (-> string (Option FsInfo)))
(defun (directory-info/raw path)
  (def own (DirectoryInfo. path))
  (def link (not (clr-empty? (.-LinkTarget own))))
  (def end (if link (DirectoryInfo. (link-end path)) own))
  (def d (if (.-Exists end) end own))
  (if (.-Exists own)
      (Some (FsInfo (kind FsDirectory)
                    (size 0L)
                    (modified-ms (ticks->unix-ms (.-Ticks (.-LastWriteTimeUtc d))))
                    (link? link)))
      None))

(: (-> string (Option FsInfo)))
(defun (fs-info/raw path)
  (if (clr-file-exists path)
      (file-info/raw path)
      (if (clr-dir-exists path) (directory-info/raw path) None)))

;; Whole paths, files and directories both, in the order the OS gives them.
(: (-> string (Result Exception (Vec string))))
(defun (fs-list/raw path)
  (match (clr-dir-entries path)
    ((Ok names) (Ok (loop (:for name names) (:acc found (vecing name)))))
    ((Err e) (Err e))))

;; Creates every missing directory along the path. One that is already there is
;; not an error.
(: (-> string (Result Exception Unit)))
(defun (fs-create-directory/raw path)
  (match (clr-dir-create path)
    ((Ok _) (Ok unit))
    ((Err e) (Err e))))

;; What a guarded `void` call answers, as the `Unit` an operation declares.
(: (-> (Result Exception %a) (Result Exception Unit)))
(defun (unit-result r)
  (match r
    ((Ok _) (Ok unit))
    ((Err e) (Err e))))

;; A missing file is not an error.
(: (-> string (Result Exception Unit)))
(defun (fs-delete-file/raw path) (unit-result (clr-file-delete path)))

;; An empty directory. A missing or non-empty one is an `IOException`.
(: (-> string (Result Exception Unit)))
(defun (fs-delete-directory/raw path) (unit-result (clr-dir-delete path)))

;; A file or a directory. Fails if `to` exists, unless `MoveReplace` asks to
;; replace a file there. `Directory.Move` never replaces, which is the rule.
(: (-> string string MoveMode (Result Exception Unit)))
(defun (fs-move/raw from to mode)
  (unit-result (if (clr-dir-exists from)
                   (clr-dir-move from to)
                   (clr-file-move from to (match mode (MoveNew #f) (MoveReplace #t))))))

(defeffect FS
  (open-read-stream    (-> string (Result Exception Stream)))
  (open-write-stream   (-> string WriteMode (Result Exception Stream)))
  (fs-info             (-> string (Option FsInfo)))
  (fs-list             (-> string (Result Exception (Vec string))))
  (fs-create-directory (-> string (Result Exception Unit)))
  (fs-delete-file      (-> string (Result Exception Unit)))
  (fs-delete-directory (-> string (Result Exception Unit)))
  (fs-move             (-> string string MoveMode (Result Exception Unit)))
  #:default ((open-read-stream open-read-stream/raw)
             (open-write-stream open-write-stream/raw)
             (fs-info fs-info/raw)
             (fs-list fs-list/raw)
             (fs-create-directory fs-create-directory/raw)
             (fs-delete-file fs-delete-file/raw)
             (fs-delete-directory fs-delete-directory/raw)
             (fs-move fs-move/raw))
  #:cold (open-read-stream open-write-stream fs-info fs-list
          fs-create-directory fs-delete-file fs-delete-directory fs-move))

;; --- Opening a file port ---
;;
;; The scope is read before the perform, so a program with nowhere to put the
;; port fails without having opened anything.

(: (-> string (Result Exception InputPort)))
(defun (open-input-file path)
  (ignore (current-scope))
  (stream->input-port (open-read-stream path)))

;; `(open-output-file path)` truncates; `#:mode Append` or `#:mode CreateNew`
;; says otherwise.
(: (-> string (#:mode WriteMode) (Result Exception OutputPort)))
(defun (open-output-file path #:mode Truncate)
  (ignore (current-scope))
  (stream->output-port (open-write-stream path mode)))

;; The same, past whatever handler is installed. The `/raw` says so.
(: (-> string (Result Exception InputPort)))
(defun (open-input-file/raw path)
  (ignore (current-scope))
  (stream->input-port (open-read-stream/raw path)))

(: (-> string WriteMode (Result Exception OutputPort)))
(defun (open-output-file/raw path mode)
  (ignore (current-scope))
  (stream->output-port (open-write-stream/raw path mode)))

;; `(call-with-input-file path proc)` - open, hand the port to `proc`, close.
;;
;; The port is closed however the body ends, through the owner handle, so the
;; scope's list comes back to the length it had. `with-open` and not
;; `with-scope`: the guarantee is the same and this one neither suspends nor
;; allocates a scope, so an ordinary `defun` can still call it.
;;
;; `proc` is `-?->`, so it may be either colour and both copies are generated.
;; A suspending body gets the same closing.
(: (-> string (-?-> InputPort %a) (Result Exception %a)))
(defun (call-with-input-file path proc)
  (match (open-input-file path)
    ((Ok p) (with-open ((it p)) (Ok (proc it))))
    ((Err e) (Err e))))

(: (-> string (-?-> OutputPort %a) (#:mode WriteMode) (Result Exception %a)))
(defun (call-with-output-file path proc #:mode Truncate)
  (match (open-output-file path #:mode mode)
    ((Ok p) (with-open ((it p)) (Ok (proc it))))
    ((Err e) (Err e))))

;; --- Bytes, copies and lines ---
;;
;; Bytes and copies go over the streams the `FS` openers answer, since the
;; prelude has no byte port. Each has a suspending copy through the streams'
;; own async methods, as the text functions have through the ports'. A stream
;; is disposed by `with-open` however the body ends; it is flushed first, so
;; that the suspending copy awaits the write rather than leaving it to a
;; synchronous dispose.

(import/class
  (MemoryStream (: System.IO.MemoryStream (-> MemoryStream)))
  (IOException (: System.IO.IOException (-> string IOException))))

(import/extern
  (clr-copy-to            (: System.IO.Stream.CopyTo      (-> Stream Stream void) #:blocking))
  (clr-copy-to-await      (: System.IO.Stream.CopyToAsync (-> Stream Stream void) #:async))
  (clr-stream-write       (: System.IO.Stream.Write       (-> Stream (Array byte) int int void) #:blocking))
  (clr-stream-write-await (: System.IO.Stream.WriteAsync  (-> Stream (Array byte) int int void) #:async))
  (clr-stream-flush       (: System.IO.Stream.Flush       (-> Stream void) #:blocking))
  (clr-stream-flush-await (: System.IO.Stream.FlushAsync  (-> Stream void) #:async)))

(: (-> Stream Stream void))
(defbjouble (stream-copy! from to)
  (#:sync (clr-copy-to from to))
  (#:bjo  (clr-copy-to-await from to)))

(: (-> Stream (Array byte) void))
(defbjouble (stream-write! s bytes)
  (#:sync (clr-stream-write s bytes 0 (array-length bytes)))
  (#:bjo  (clr-stream-write-await s bytes 0 (array-length bytes))))

(: (-> Stream void))
(defbjouble (stream-flush! s)
  (#:sync (clr-stream-flush s))
  (#:bjo  (clr-stream-flush-await s)))

(import/extern
  (clr-copy-count       (: Bjolang.Runtime.BjoStreams.CopyCount      (-> Stream Stream long void) #:blocking))
  (clr-copy-count-await (: Bjolang.Runtime.BjoStreams.CopyCountAsync (-> Stream Stream long void) #:async))
  (clr-stream-length    (: System.IO.Stream.Length (-> Stream long) #:get))
  (clr-new-guid         (: System.Guid.NewGuid (-> System.Guid)))
  (clr-guid-text        (: System.Guid.ToString (-> System.Guid string string))))

;; At most `count` bytes: what the source held when it was opened.
(: (-> Stream Stream long void))
(defbjouble (stream-copy-count! from to count)
  (#:sync (clr-copy-count from to count))
  (#:bjo  (clr-copy-count-await from to count)))

;; Copies a file. `#:mode` is how `to` is written: `CreateNew`, the default,
;; fails if it exists, so a copy never loses a file by accident; `Truncate`
;; replaces it and `Append` adds to it. The source is opened first, so a
;; missing one leaves `to` as it was. A copy onto its own path is refused.
;;
;; `to` may be the source under another name - a link, or a path the
;; filesystem folds to the same file - and the path's text cannot tell. So
;; nothing is ever opened that could empty the source: `Truncate` copies into a
;; new file beside `to` and moves it over `to`, and `Append` copies the length
;; the source had when it was opened, so that appending a file to itself ends.
;; Replacing by a move means a link at `to` is replaced, not written through.
;; The copy is a new file, with a modified time of its own.
(: (-> string string (#:mode WriteMode) void))
(defun (file-copy from to #:mode CreateNew)
  (when (= (path-absolute from) (path-absolute to))
    (raise (cast Exception (IOException. (string-append "cannot copy a file onto itself: " from)))))
  (with-open ((in (raise-err (open-read-stream from))))
    (def count (clr-stream-length in))
    (match mode
      (Truncate
       (def fresh (str to ".copy-" (clr-guid-text (clr-new-guid) "N")))
       (match (try (begin
                     (with-open ((out (raise-err (open-write-stream fresh CreateNew))))
                       (stream-copy-count! in out count)
                       (stream-flush! out))
                     (raise-err (fs-move fresh to MoveReplace)))
                   #:catch (System.Exception))
         ((Ok _) unit)
         ((Err e)
          (ignore (fs-delete-file fresh))
          (raise e))))
      (_
       (with-open ((out (raise-err (open-write-stream to mode))))
         (stream-copy-count! in out count)
         (stream-flush! out))))))

(: (-> string (Array byte)))
(defun (file-read-bytes path)
  (with-open ((in (raise-err (open-read-stream path))))
    (def buffer (MemoryStream.))
    (stream-copy! in (cast Stream buffer))
    (.ToArray buffer)))

(: (-> string (Array byte) WriteMode void))
(defun (write-whole-bytes path bytes mode)
  (with-open ((out (raise-err (open-write-stream path mode))))
    (stream-write! out bytes)
    (stream-flush! out)))

(: (-> string (Array byte) void))
(defun (file-write-bytes path bytes) (write-whole-bytes path bytes Truncate))

(: (-> string (Array byte) void))
(defun (file-append-bytes path bytes) (write-whole-bytes path bytes Append))

;; The lines, without their line ends. What ends a line is `#:mode`'s to say;
;; by default "\n", "\r" and "\r\n" all do. A last line needs no end, and a
;; final line end makes no empty line after it.
(: (-> string (#:mode LineMode) (Vec string)))
(defun (file-read-lines path #:mode Any)
  (match (open-input-file path)
    ((Ok opened) (with-open ((p opened))
                   (def lines (vecbuilder-empty))
                   (let next ()
                     (unless (port-eof? p)
                       (vecbuilder-add! lines (read-line p #:mode mode))
                       (next)))
                   (vecbuilder->vec lines)))
    ((Err e) (raise e))))

;; Each line followed by "\n", the last one too, on every OS: the same lines
;; make the same bytes wherever they are written, and `file-read-lines` gives
;; them back as long as none holds a line end of its own.
(: (-> string (Vec string) void))
(defun (file-write-lines path lines)
  (match (open-output-file path)
    ((Ok opened) (with-open ((p opened))
                   (loop (:for line lines)
                         (:do (write-string p line)
                              (write-string p "\n")))
                   (flush-port p)))
    ((Err e) (raise e))))
 
;; The items `reader` reads, pulled lazily. The file is opened inside the `seq`,
;; so every walk opens it afresh and reads from the start, and closed when the
;; walk ends - at the end of the file, when a loop walking it stops early,
;; through `iterable-end`, or when an exception leaves the loop, through
;; `iterable-cleanup`. A walk that is never ended stays open until the scope
;; that was ambient at the first pull ends, because `open-input-file`
;; registers the port there. A missing file raises on the first pull;
;; `(std ports)`' `file->seq` reports it at the call instead.
(: file-read/seq #:sync (-> (-> InputPort %a) string (Seq %a)))
(defun (file-read/seq reader path)
  (seq
    (def file (raise-err (open-input-file path)))
    (with-open ((p file))
      (let loop ()
        (unless (port-eof? p)
          (yield (reader p))
          (loop))))))

(: file-read-lines/seq #:sync (-> string (#:mode LineMode) (Seq string)))
(defun (file-read-lines/seq path #:mode Any)
  (file-read/seq (fun (p) (read-line p #:mode mode)) path))

;; The files under `dir`, depth first, pulled lazily.
;;
;; Each directory's entries are taken in ordinal order, so a walk is the same
;; on every OS and on a fake: a tool that hashes the files in walk order gets
;; the same hash everywhere. `into?` is asked about each directory before the
;; walk goes into it, which is how `.git` is left out. A directory that is a
;; symbolic link is never entered, so a link back up the tree cannot loop the
;; walk. Listing happens when the sequence is walked, so the handler installed
;; at the walk answers, and a walk that stops early lists nothing more. An
;; error on the way raises, as `directory-files` does.
;;
;; A `seq` body is one iterator, so the walk keeps its own list of what is
;; left rather than recursing: a directory's entries go in front of the rest.
(: (-> string (List string)))
(defun (sorted-entries dir) (list-sort (vec->list (raise-err (fs-list dir)))))

(: directory-walk #:sync (-> string (#:into? (-> string bool)) (Seq string)))
(defun (directory-walk dir #:into? (fun (d) #t))
  (seq
    (let loop ((todo (sorted-entries dir)))
      (unless (list-empty? todo)
        (def entry (list-head todo))
        (def rest (list-tail todo))
        (match (fs-info entry)
          ((Some info)
           (match (record-ref info kind)
             (FsFile (yield entry)
                     (loop rest))
             (FsDirectory
              (if (and (not (record-ref info link?)) (into? entry))
                  (loop (list-append (sorted-entries entry) rest))
                  (loop rest)))))
          ;; Gone since it was listed.
          (None (loop rest)))))))

;; Flush.
(import/extern
  (clr-flush       (: Bjolang.Runtime.OutputPorts.Flush      (-> OutputPort void) #:blocking))
  (clr-flush-await (: Bjolang.Runtime.OutputPorts.FlushAsync (-> OutputPort void) #:async)))

(: (-> OutputPort void))
(defbjouble (flush-port p)
  (#:sync (clr-flush p))
  (#:bjo  (clr-flush-await p)))

;; --- Input ---
;; These are the leaves of our IO. The bottom calls, so to say. 
(import/extern
  (clr-eof        (: Bjolang.Runtime.InputPorts.PortEof            (-> InputPort bool)   #:blocking))
  (clr-eof-await  (: Bjolang.Runtime.InputPorts.PortEofAsync       (-> InputPort bool)   #:async))
  (clr-line       (: Bjolang.Runtime.InputPorts.ReadLineOrThrow    (-> InputPort int string) #:blocking))
  (clr-line-await (: Bjolang.Runtime.InputPorts.ReadLineOrThrowAsync (-> InputPort int string) #:async))
  (clr-char       (: Bjolang.Runtime.InputPorts.ReadCharOrThrow    (-> InputPort char)   #:blocking))
  (clr-char-await (: Bjolang.Runtime.InputPorts.ReadCharOrThrowAsync (-> InputPort char) #:async))
  (clr-rest       (: Bjolang.Runtime.InputPorts.ReadRest           (-> InputPort string) #:blocking))
  (clr-rest-await (: Bjolang.Runtime.InputPorts.ReadRestAsync      (-> InputPort string) #:async))
  (clr-line-opt       (: Bjolang.Runtime.InputPorts.ReadLineOpt      (-> InputPort int (Option string)) #:blocking))
  (clr-line-opt-await (: Bjolang.Runtime.InputPorts.ReadLineOptAsync (-> InputPort int (Option string)) #:async))
  (clr-char-opt       (: Bjolang.Runtime.InputPorts.ReadCharOpt      (-> InputPort (Option char)) #:blocking))
  (clr-char-opt-await (: Bjolang.Runtime.InputPorts.ReadCharOptAsync (-> InputPort (Option char)) #:async))
  (clr-peek-char       (: Bjolang.Runtime.InputPorts.PeekCharOrThrow      (-> InputPort char) #:blocking))
  (clr-peek-char-await (: Bjolang.Runtime.InputPorts.PeekCharOrThrowAsync (-> InputPort char) #:async))
  (clr-peek-char-opt       (: Bjolang.Runtime.InputPorts.PeekCharOpt      (-> InputPort (Option char)) #:blocking))
  (clr-peek-char-opt-await (: Bjolang.Runtime.InputPorts.PeekCharOptAsync (-> InputPort (Option char)) #:async)))

;; Port eof.
(: (-> InputPort bool))
(defbjouble (port-eof? p)
  (#:sync (clr-eof p))
  (#:bjo  (clr-eof-await p)))

;; `LineMode` as `Bjolang.Runtime.LineMode` numbers it.
(: (-> LineMode int))
(defun (line-mode-code mode)
  (match mode
    (Any 0)
    (AnyOne 1)
    (Linefeed 2)
    (Return 3)
    (ReturnLinefeed 4)))

;; Where a reader of one argument is expected, `read-line` is the function
;; that calls it with the port, and the mode is `Any`: `(port->list read-line
;; p)`. For another mode, hand it over as `(fun (p) (read-line p #:mode m))`.
(: (-> InputPort (#:mode LineMode) string))
(defbjouble (read-line p #:mode Any)
  (#:sync (clr-line p (line-mode-code mode)))
  (#:bjo  (clr-line-await p (line-mode-code mode))))

;; One read, not `port-eof?` and then `read-line`: between those two another
;; fiber reading the same port can take the last line.
(: (-> InputPort (#:mode LineMode) (Option string)))
(defbjouble (read-line/opt p #:mode Any)
  (#:sync (clr-line-opt p (line-mode-code mode)))
  (#:bjo  (clr-line-opt-await p (line-mode-code mode))))

(: (-> InputPort char))
(defbjouble (read-char p)
  (#:sync (clr-char p))
  (#:bjo  (clr-char-await p)))

;; One read, for the reason `read-line/opt` is.
(: (-> InputPort (Option char)))
(defbjouble (read-char/opt p)
  (#:sync (clr-char-opt p))
  (#:bjo  (clr-char-opt-await p)))

;; The character `read-char` would answer, left in the port, as Racket's
;; `peek-char`. Decoded from the port's buffer: it waits for the bytes a
;; character needs and takes none of them.
(: (-> InputPort char))
(defbjouble (peek-char p)
  (#:sync (clr-peek-char p))
  (#:bjo  (clr-peek-char-await p)))

(: (-> InputPort (Option char)))
(defbjouble (peek-char/opt p)
  (#:sync (clr-peek-char-opt p))
  (#:bjo  (clr-peek-char-opt-await p)))

;; Drains a port
(: (-> InputPort string))
(defbjouble (read-all p)
  (#:sync (clr-rest p))
  (#:bjo  (clr-rest-await p)))

;; Port fold.
(: (-> (-?-> InputPort %a %a) %a InputPort %a))
(defun (port-fold f init port)
  (let loop ((acc init))
    (if (port-eof? port)
        acc
        (loop (f port acc)))))

;; --- Output ---

;; Output bindings with synchronous and asynchronous (bjoroutine) pairs.
;; 
;; It is crucial to have asynchronous variants for writes. Even though writes 
;; are buffered, a write that fills the buffer will trigger a drain (syscall).
;; The async variant ensures this drain suspends rather than blocking a thread.
;;
;; Note that output functions carry a colour (effect). Because `write-string` 
;; has an async twin, any function that uses it will also become async. For this 
;; reason, string building operations like `written` use a `StringBuilder` 
;; instead of a string port to ensure string formatting remains pure and synchronous.
(import/extern
  (clr-write         (: Bjolang.Runtime.OutputPorts.Write          (-> OutputPort string void) #:blocking))
  (clr-write-await   (: Bjolang.Runtime.OutputPorts.WriteAsync     (-> OutputPort string void) #:async))
  (clr-writec        (: Bjolang.Runtime.OutputPorts.WriteChar      (-> OutputPort char void)   #:blocking))
  (clr-writec-await  (: Bjolang.Runtime.OutputPorts.WriteCharAsync (-> OutputPort char void)   #:async))
  (clr-writeln       (: Bjolang.Runtime.OutputPorts.WriteLine      (-> OutputPort string void) #:blocking))
  (clr-writeln-await (: Bjolang.Runtime.OutputPorts.WriteLineAsync (-> OutputPort string void) #:async)))

(: (-> OutputPort string void))
(defbjouble (write-string p s)
  (#:sync (clr-write p s))
  (#:bjo  (clr-write-await p s)))

;; Write char.
(: (-> OutputPort char void))
(defbjouble (write-char p c)
  (#:sync (clr-writec p c))
  (#:bjo  (clr-writec-await p c)))

(: (-> OutputPort string void))
(defbjouble (writeln p s)
  (#:sync (clr-writeln p s))
  (#:bjo  (clr-writeln-await p s)))

;; What a string port has been given, as text. Bytes written to it with
;; `write-bytes!` that are not UTF-8 read as U+FFFD, as Racket's do.
(: (-> OutputPort string))
(defun (get-output-string p) (writer->string p))

;; What a string port has been given, as bytes.
(: (-> OutputPort (Array byte)))
(defun (get-output-bytes p) (output-bytes p))


;; ---------------------------------------------------------------------------
;; Effects
;; ---------------------------------------------------------------------------
;;
;; An operation is a parameter holding a function, and performing an effect
;; calls that function on the performer's own stack.
;; (std effect) has the whole of the mechanism; what is here is the handful
;; of operations the standard library performs itself.
;;
;; What is an effect and what is a parameter?
;; If the thing is a value the caller reads, it is a parameter. If it is a
;; behaviour the caller decides - with a default worth naming, a possible
;; abort, and a signature worth checking - it is an effect. So errors stay
;; try/raise, state stays parameterize and def/mutable, the three
;; standard ports stay parameters, and random stays the parameter
;; (std random) already has: it is swappable, it has no abort case, and an
;; effect would put a wrapper function over a read that is already one.
;; The clock is a parameter for the same reason.
;;
;; Installing a handler needs (import (std effect)) for with-handler. A
;; macro is not a binding, so it cannot be re-exported from here.

(import (std effect))

;; `(warn "...")` - something is wrong, and carrying on is the default.
;;
;; Warn continues by default, but this is overridable.
;;
;; (log "...") - a line of diagnostics, and nobody's decision.
;;
;; Both are sync. If you want a -bjo-> effect, the best course of action
;; is to return a promise or something that is acted on using the parallell
;; facilities.
(defeffect Diagnostics
  (warn (-> string void))
  (log (-> string void))
  #:default ((warn (fun (s) (writeln (parameter-ref current-error-port) s)))
             (log (fun (s) (writeln (parameter-ref current-error-port) s)))))

;; (getenv "HOME") - the process environment, as an effect so that a test can
;; answer for it without writing to the real one.
;;
;; Cold: read at startup, not in a loop.
(defeffect Env
  (getenv (-> string (Option string)))
  #:default ((getenv get-environment-variable))
  #:cold (getenv))


;; ---------------------------------------------------------------------------
;; The clock
;; ---------------------------------------------------------------------------
;;
;; A `Clock` is a record of functions, so a program can make its own.
;; `monotonic-ms` and `monotonic-ns` read it here, and (std datetime)'s `now`
;; and `today` read the same one, so binding `current-clock` moves both.
;;
;; - `read-monotonic-ms`: milliseconds from an unspecified start. Never
;;   decreases; only differences mean anything.
;; - `read-monotonic-ns`: the same clock in nanoseconds, at the resolution
;;   the clock has. A clock made with only `#:monotonic-ms` reads it as its
;;   milliseconds times a million, so a fake clock gives the same exact
;;   elapsed time in both units.
;; - `read-utc-ticks`: the wall clock, in .NET ticks since 0001-01-01 UTC. May
;;   step back.
;; - `read-zone`: the zone (std datetime)'s `today` is in.
;; - `advance-ticks`: what (std datetime)'s `clock-advance!` calls, with a
;;   number of ticks. `None` for a clock that cannot be moved.
(type (: Clock (Record (: read-monotonic-ms (-> long))
                       (: read-monotonic-ns (-> long))
                       (: read-utc-ticks (-> long))
                       (: read-zone (-> System.TimeZoneInfo))
                       (: advance-ticks (Option (-> long void))))))

(import/extern
  (clock-ms (: BjolangRuntime.ClockMs (-> long)))
  (clock-ns (: BjolangRuntime.ClockNs (-> long)))
  (clr-utc-now (: System.DateTime.UtcNow #:get))
  (clr-local-zone (: System.TimeZoneInfo.Local #:get)))

(: (-> long))
(defun (system-utc-ticks) (.-Ticks clr-utc-now))

(: (-> System.TimeZoneInfo))
(defun (system-zone) clr-local-zone)

;; Each part not given is the system clock's, but for the nanoseconds: when
;; `#:monotonic-ns` is not given, they are read from the milliseconds, so that
;; a clock given only `#:monotonic-ms` agrees with itself.
(: (-> (#:monotonic-ms (-> long))
       (#:monotonic-ns (Option (-> long)))
       (#:utc-ticks (-> long))
       (#:zone (-> System.TimeZoneInfo))
       (#:advance (Option (-> long void)))
       Clock))
(defun (make-clock #:monotonic-ms clock-ms #:monotonic-ns None #:utc-ticks system-utc-ticks
                   #:zone system-zone #:advance None)
  (Clock (read-monotonic-ms monotonic-ms)
         (read-monotonic-ns (match monotonic-ns
                              ((Some ns) ns)
                              (None (fun () (* (monotonic-ms) 1000000L)))))
         (read-utc-ticks utc-ticks)
         (read-zone zone)
         (advance-ticks advance)))

;; The machine's clock, in the machine's zone.
(: Clock)
(def system-clock (make-clock #:monotonic-ns (Some clock-ns)))

;; Cold: nothing reads the time in a loop.
(: (Param Clock))
(def current-clock (make-cold-parameter system-clock))

;; Not called `now`: that is (std datetime)'s wall-clock `Instant`.
(: (-> (#:clock Clock) long))
(defun (monotonic-ms #:clock (parameter-ref current-clock))
  ((record-ref clock read-monotonic-ms)))

;; Nanoseconds on the same clock: for timing what takes less than a
;; millisecond.
(: (-> (#:clock Clock) long))
(defun (monotonic-ns #:clock (parameter-ref current-clock))
  ((record-ref clock read-monotonic-ns)))


;; ---------------------------------------------------------------------------
;; Iterating something other than the whole of a collection
;; ---------------------------------------------------------------------------
;;
;; `in-array`, `in-vec` and their reverses, `over-list`, `in-port`, `up-from`
;; and `down-from`. Included rather than imported: they are `Iterable`
;; implementations, and an implementation belongs with the trait — a module of
;; its own would have to import the prelude it is part of. What is above stays
;; here: the walk of a whole collection is what the collection itself is for.
;;
;; Here rather than beside those implementations because `in-port` names
;; `InputPort`, which the section above introduces.
(include "iterators.protobjo")


;; ---------------------------------------------------------------------------
;; Collection
;; ---------------------------------------------------------------------------
;;
;; Collection trait.
(def/trait (Collection %a)
  (type %content)
  (: length (-> %a int))
  (: empty? (-> %a bool)))

(impl (Collection (List %a))
  (type %content %a)
  (defun (length lst)
    (list-length lst))
  (defun (empty? lst)
    (list-empty? lst)))

(impl (Collection (Array %a))
  (type %content %a)
  (defun (length arr)
    (array-length arr))
  (defun (empty? arr)
    (= 0 (array-length arr))))

(impl (Collection (IArray %a))
  (type %content %a)
  (defun (length xs)
    (iarray-length xs))
  (defun (empty? xs)
    (iarray-empty? xs)))

(impl (Collection (Vec %a))
  (type %content %a)
  (defun (length vec)
    (vec-length vec))
  (defun (empty? vec)
    (vec-empty? vec)))

(impl (Collection (VecBuilder %a))
  (type %content %a)
  (defun (length vb)
    (vecbuilder-length vb))
  (defun (empty? vb)
    (= (vecbuilder-length vb) 0)))

(impl (Collection (TransientVec %a))
  (type %content %a)
  (defun (length t)
    (transientvec-length t))
  (defun (empty? t)
    (transientvec-empty? t)))

(impl (Collection (ListBuilder %a))
  (type %content %a)
  (defun (length lb)
    (listbuilder-length lb))
  (defun (empty? lb)
    (= (listbuilder-length lb) 0)))

;; Map collection.
(impl (Collection (Map %k %v))
  (type %content (Tuple %k %v))
  (defun (length m)
    (map-length m))
  (defun (empty? m)
    (map-empty? m)))

(impl (Collection (TransientMap %k %v))
  (type %content (%k . %v))
  (defun (length tm)
    (transientmap-length tm))
  (defun (empty? tm)
    (transientmap-empty? tm)))
(impl (Collection (MapBuilder %k %v))
  (type %content (%k . %v))
  (defun (length mb)
    (mapbuilder-length mb))
  (defun (empty? mb)
    (= (mapbuilder-length mb) 0)))

;; Range collection.
(impl (Collection Range)
  (type %content int)
  (defun (length r)
    (def lo (record-ref r lo))
    (def hi (record-ref r hi))
    (if (<= hi lo)
        0
        (range-length-of (- (cast long hi) (cast long lo)))))
  (defun (empty? r)
    (>= (record-ref r lo) (record-ref r hi))))

(impl (Collection RangeBy)
  (type %content int)
  (defun (length r)
    (def lo (record-ref r lo))
    (def hi (record-ref r hi))
    (if (<= hi lo)
        0
        (range-length-of (range-by-count lo hi (record-ref r by)))))
  (defun (empty? r)
    (>= (record-ref r lo) (record-ref r hi))))

;; A range from below zero to above it can hold more than `int-max` values,
;; which a length cannot give.
(: (-> long int))
(defun (range-length-of n)
  (when (> n (cast long int-max))
    (panic! #"length: the range holds ${n} values, more than an int can count."))
  (cast int n))

;; String collection.
(impl (Collection string)
  (type %content char)
  (defun (length s)
    (string-count s))
  (defun (empty? s)
    (string-empty? s)))

;; Seq collection.
(impl (Collection (Seq %a))
  (type %content %a)
  (defun (length s)
    (count s))
  (defun (empty? s)
    (seq-empty? s)))


;;----------------------------------------------------------------------------
;; Addable! trait
;; ---------------------------------------------------------------------------
;;
;; `add!` never fails. Afterwards the sink holds the element: a sequence has
;; it appended, a set has it as a member (which it may already have been),
;; and a map has the key mapped to the value, replacing an older one. An
;; operation that refuses what is already there is named `add-new` and is
;; not part of the trait.
(def/trait (Addable! %coll)
  (type %elem)
  (: add! (-> %coll %elem void))
  ;; Everything an `Iterable` holds, added in the order it yields. The
  ;; `(where ...)` is member-level: each call site brings its own source type,
  ;; with `#:elem` pinned to this trait's `%elem` — the element the source
  ;; yields *is* the element the sink takes, which no function-level clause
  ;; can say. The cursor is nobody's business, so it is pinned to a fresh
  ;; variable.
  (: add-all! (-> %coll %s void)
     (where (Iterable %s #:elem %elem #:cursor %k)))
  (defun (add-all! coll xs)
    (let go ((cur (iterable-start xs)))
      (unless (iterable-done? xs cur)
        (add! coll (iterable-current xs cur))
        (go (iterable-next xs cur))))))

(impl (Addable! StringBuilder)
  (type %elem Char)
  (defun (add! sb s)
    (stringbuilder-add! sb s)))

(impl (Addable! (VecBuilder %a))
  (type %elem %a)
  (defun (add! vb elem)
    (vecbuilder-add! vb elem)))

(impl (Addable! (TransientVec %a))
  (type %elem %a)
  (defun (add! t elem)
    (transientvec-add! t elem)))

(impl (Addable! (TransientMap %k %v))
  (type %elem (%k . %v))
  (defun (add! tm tup)
    (let (((k v) tup))
      (transientmap-set! tm k v))))

(impl (Addable! (MapBuilder %k %v))
  (type %elem (%k . %v))
  (defun (add! mb tup)
    (let (((k v) tup))
      (mapbuilder-add! mb k v))))

(impl (Addable! (ListBuilder %a))
  (type %elem %a)
  (defun (add! lb elem)
    (listbuilder-add! lb elem)))

;; The set and ordered-collection sinks live with their types, in (std hashset),
;; (std orderedset) and (std orderedmap): `Addable!` is this module's trait,
;; so a module that owns the type may implement it.

;;----------------------------------------------------------------------------
;; Addable — the persistent counterpart
;; ---------------------------------------------------------------------------
;;
;; The same shape without the `!`: `add` answers a new collection and touches
;; nothing. It never fails, as `add!` never does: a map-shaped collection
;; replaces a key already there, and a set already holding the element
;; answers an equal set. A caller who wants a duplicate key refused writes
;; `map-add-new`, which raises, or `map-try-add-new`, which answers a Result.
(def/trait (Addable %coll)
  (type %elem)
  (: add (-> %coll %elem %coll))
  (: add-all (-> %coll %s %coll)
     (where (Iterable %s #:elem %elem #:cursor %k)))
  ;; A mutable cell rather than a named-let accumulator, deliberately: the
  ;; cell is initialised from `coll`, so its type is the implementor's from
  ;; the first line, and `(add acc e)` resolves before the loop is even
  ;; checked. A let-bound accumulator is a fresh variable at the moment the
  ;; recursive call is inferred, which leaves `add`'s element projection
  ;; nothing to resolve against.
  (defun (add-all coll xs)
    (def/mutable acc coll)
    (let go ((cur (iterable-start xs)))
      (unless (iterable-done? xs cur)
        (set! acc (add acc (iterable-current xs cur)))
        (go (iterable-next xs cur))))
    acc))

(impl (Addable (Vec %a))
  (type %elem %a)
  (defun (add v elem)
    (vec-add v elem)))

(impl (Addable (Map %k %v))
  (type %elem (%k . %v))
  (defun (add m tup)
    (let (((k v) tup))
      (map-set m k v))))

;; As with the sinks, the set and ordered-collection impls live with their
;; types, in (std hashset), (std orderedset) and (std orderedmap).



;; ---------------------------------------------------------------------------
;; Control
;; ---------------------------------------------------------------------------
;;
;; Macros.
(import (std syntax-match))

;; `(cond (test body ...) ... (:def pattern expr) ... (else body ...))`
;;
;; Cond requires else.
;;
;; `(:match pattern expr body ...)`, with an optional `#:when guard` after
;; `expr`, is a test that binds: it answers when `expr` matches and the guard
;; holds, and falls through to the next clause otherwise. What it binds is in
;; scope in its guard and body only.
;;
;; Two clauses do not answer anything. `(:def pattern expr)` binds, and
;; `(:do body ...)` runs something; both are reached only when every test
;; above them has failed, and what a `:def` binds is in scope in every clause
;; below it. They exist because the alternative is a new `(else ...)` and a
;; new `cond` inside it for every value a later test needs — the same
;; decisions, indented once per binding.
;;
;; A `:def` clause *is* a `def`: the sequel it swallows is the rest of the
;; cond, so a refutable pattern takes the same failure part it takes anywhere
;; else: `(:def (Ok v) (parse s) :propagate)` makes the whole cond the `Err`,
;; and `(:def (Some n) (lookup k) :default 0)` binds `n` and never answers.
(def/macro (cond form inject compare)
  (syntax-match form
    ((_ clause ...) (cond-arms clause form))
    (bad (syntax-error bad "cond takes clauses: (cond (test body ...) ... (else body ...))"))))

(: (-> (List Syntax) Syntax Syntax))
(defun (cond-arms clauses whole)
  (match clauses
    (Nil
     (syntax-error whole "cond needs a final (else ...) clause: every arm answers something, so there has to be a last answer."))
    ((Cons clause rest)
     (syntax-match clause
       ;; Binds. The rest of the cond is the body the `def` swallows, which is
       ;; what puts the name in scope below and nowhere else.
       ((:def pattern expr fail ...)
        #'(let () (def ,pattern ,expr ,@fail) ,(cond-arms rest whole)))
       ((:def junk ...)
        (syntax-error clause "(:def ...) binds: (:def name expr), or (:def pattern expr failure-part), such as :default value or :propagate."))
       ;; Answers when `expr` matches, and falls through to the next clause
       ;; when it does not. Unlike `:def` it swallows nothing: what it binds
       ;; is in scope in its guard and body only. The rest of the cond is the
       ;; fallback arm, so it is written once.
       ((:match pattern expr #:when guard body ...)
        #'(match ,expr
            (,pattern #:when ,guard ,(one-form body clause))
            (,(SSym (string->symbol "_")) ,(cond-arms rest whole))))
       ((:match pattern expr body ...)
        #'(match ,expr
            (,pattern ,(one-form body clause))
            (,(SSym (string->symbol "_")) ,(cond-arms rest whole))))
       ((:match junk ...)
        (syntax-error clause "(:match ...) is (:match pattern expr body ...), or (:match pattern expr #:when guard body ...)."))
       ;; Runs.
       ((:do first body ...)
        #'(let () ,first ,@body ,(cond-arms rest whole)))
       ((:do)
        (syntax-error clause "(:do ...) needs something to run."))
       ;; Else clause. It always answers, so a clause after it could never be
       ;; reached.
       (('else body ...)
        (match rest
          (Nil (one-form body clause))
          ((Cons after _)
           (syntax-error after "This clause comes after (else ...), so it is never reached. Move it above the else, or remove it."))))
       ((test body ...) #'(if ,test ,(one-form body clause) ,(cond-arms rest whole)))
       (bad (syntax-error bad "A cond clause is (test body ...), (:match pattern expr body ...) to answer on a match, (:def pattern expr) to bind, (:do body ...) to run something, or (else body ...) for the last one."))))))

;; Several forms as one.
(: (-> (List Syntax) Syntax Syntax))
(defun (one-form body whole)
  (match body
    (Nil (syntax-error whole "This clause has nothing to do."))
    ((Cons only Nil) only)
    (_ #'(let () ,@body))))

;; `(if-let ((name expr)) then else)`
;;
;; binds name to whatever is in ,value if it is some, otherwise run the None branch.
(def/macro (if-let form inject compare)
  (syntax-match form
    ((_ (name value) then else)
     #'(match ,value ((Some ,name) ,then) (None ,else)))
    (bad (syntax-error bad "if-let takes one binding, a then and an else: (if-let (name expr) then else)"))))

;; `(when-let (name expr) body ...)`
;; tests an option result. if it is some, unwraps it and bind the result to name
(def/macro (when-let form inject compare)
  (syntax-match form
    ((_ (name value) first body ...)
     ;; Evaluate value once.
     #'(let ((found ,value))
         (when (some? found)
           (let ((,name (option-ref found)))
             ,first
             ,@body))))
    (bad (syntax-error bad "when-let takes one binding and a body: (when-let (name expr) body ...)"))))

;; `(some-> value step ...)` — `->`, stopping at the first `None`.
;;
;; Threading option.
(def/macro (some-> form inject compare)
  (syntax-match form
    ((_ value step ...) (some-steps value step))
    (bad (syntax-error bad "some-> takes a value and steps: (some-> value (f &) (g &))"))))

(: (-> Syntax (List Syntax) Syntax))
(defun (some-steps value steps)
  (match steps
    ;; No steps.
    (Nil #'(Some ,value))
    ;; Last step.
    ((Cons step Nil) #'(-> ,value ,step))
    ((Cons step rest)
     ;; Step binding.
     #'(match (-> ,value ,step)
        (None None)
        ((Some it) ,(some-steps #'it rest))))))

;; `(try-> value step ...)` — `->`, stopping at the first `Err`.
;;
;; Threading result. Same as some-> but for Result.
(def/macro (try-> form inject compare)
  (syntax-match form
    ((_ value step ...) (try-steps value step))
    (bad (syntax-error bad "try-> takes a value and steps: (try-> value (f &) (g &))"))))

(: (-> Syntax (List Syntax) Syntax))
(defun (try-steps value steps)
  (match steps
    ;; No steps.
    (Nil #'(Ok ,value))
    ;; Last step.
    ((Cons step Nil) #'(-> ,value ,step))
    ((Cons step rest)
     ;; The error is rebuilt rather than passed along, because the two Results
     ;; differ in their Ok type.
     #'(match (-> ,value ,step)
        ((Err e) (Err e))
        ((Ok it) ,(try-steps #'it rest))))))

;; ---------------------------------------------------------------------------
;; Paths: get, try-get, set, update and set!
;; ---------------------------------------------------------------------------
;;
;; `(get target step ...)` reads along a path. `(set target step ... value)` and
;; `(update target step ... f)` answer a copy of `target` in which the value at
;; the end of the path is replaced, and leave `target` alone.
;;
;; A step is a field step, `.name`, or a key, which is any other expression.
;; These expand before anything has a type, so which kind a step is depends
;; only on how it is written:
;;
;;   * A field step reads with `(.name x)`, so it means whatever `.name` means
;;     on that value: a record or struct field, or a .NET member. It writes
;;     with `record-set`, so only a field can be written through one.
;;   * A key step reads with `ref` (`Refable`) and writes with `ref-set`
;;     (`Settable`).
;;
;; `try-get` answers an Option, which is `None` at the first key that is
;; missing; the keys after it are not evaluated. Missing is what `try-ref`
;; says it is: a Map key that is absent, or a Vec index out of range. A field
;; step cannot be missing. A field that holds an Option is answered as one, inside the `Some`.
;;
;; `set` and `update` evaluate the target, then each key from left to right,
;; then the value or the function, each exactly once. A key that is missing
;; before the last step throws, as `ref` does. `set` does not read the last
;; key, so on a Map it adds a key that was not there.
;;
;; `set!` with a path is `set` in place: nothing is copied, the steps before
;; the last are read, and the last is written with `ref-set!` (`Settable!`) or
;; `record-set!`. See `#set!` below.
;;
;; Each step's code carries that step's source position, so an error in it is
;; reported at the step rather than at the whole form.

;; `(get target step ...)`, and `(get target)`, which is `(deref target)`.
(def/macro (get form inject compare)
  (syntax-match form
    ((_ target)
     #'(deref ,target))
    ((_ target first rest ...)
     (path-reads target (Cons first rest)))
    (bad (syntax-error bad "get needs a target: (get target step ...), where a step is .field or a key, or (get target) to read a Box or a Param."))))

;; `(try-get target step ...)`
(def/macro (try-get form inject compare)
  (syntax-match form
    ((_ target first rest ...)
     (path-tries target (Cons first rest)))
    (bad (syntax-error bad "try-get reads along a path and needs at least one step: (try-get target step ...), where a step is .field or a key."))))

;; `(set target step ... value)`
(def/macro (set form inject compare)
  (syntax-match form
    ((_ target first second rest ...)
     (path-write inject target (Cons first (Cons second rest)) #f))
    (bad (syntax-error bad "set needs a target, at least one step and a value: (set target step ... value)."))))

;; `(update target step ... f)`
(def/macro (update form inject compare)
  (syntax-match form
    ((_ target first second rest ...)
     (path-write inject target (Cons first (Cons second rest)) #t))
    (bad (syntax-error bad "update needs a target, at least one step and a function: (update target step ... f)."))))

;; True for a field step: an identifier written with a leading dot. `...` and a
;; lone `.` are punctuation, not identifiers, so they never get here.
(: (-> Syntax bool))
(defun (path-dotted? step)
  (match step
    ((SSym s)
     (let ((name (symbol->string s)))
       (and (> (string-length name) 1) (string-starts-with? name "."))))
    (_ #f)))

;; A `.-Name` step, which reads a .NET property.
(: (-> Syntax bool))
(defun (path-property? step)
  (match step
    ((SSym s) (string-starts-with? (symbol->string s) ".-"))
    (_ #f)))

;; Rejects a step that cannot be read: punctuation such as `.` or `...`.
(: (-> Syntax Syntax))
(defun (path-check step)
  (match step
    ((SPunct p)
     (syntax-error step (str "'" p "' is not a path step. A step is .field or a key expression.")))
    (_ step)))

;; One step's read of `acc`.
(: (-> Syntax Syntax Syntax))
(defun (path-read acc step)
  (syntax-at
    (if (path-dotted? (path-check step))
        #'(,step ,acc)
        #'(ref ,acc ,step))
    step))

(: (-> Syntax (List Syntax) Syntax))
(defun (path-reads acc steps)
  (match steps
    (Nil acc)
    ((Cons step rest) (path-reads (path-read acc step) rest))))

;; Every key read is a `try-ref`, and the first `None` is the answer. The last
;; key's Option is already the answer, so it is not taken apart and rebuilt.
(: (-> Syntax (List Syntax) Syntax))
(defun (path-tries acc steps)
  (match steps
    (Nil #'(Some ,acc))
    ((Cons step rest)
     ;; cond is not available here.
     (if (path-dotted? (path-check step))
         (path-tries (path-read acc step) rest)
         (let ((probe (syntax-at #'(try-ref ,acc ,step) step)))
           (match rest
             (Nil probe)
             (_ #'(match ,probe
                    (None None)
                    ((Some it) ,(path-tries #'it rest))))))))))

;; A name for the expansion's own temporaries. Built from a string so that each
;; depth gets a name of its own: hygiene gives every distinct name one fresh
;; spelling per expansion, so a single template name would shadow itself.
(: (-> string int Syntax))
(defun (path-temp prefix i)
  (SSym (string->symbol (str prefix (displayed i)))))

;; The field a `.name` step writes. A hygiene mark — `.name__37`, when the
;; step was written in another macro's template — is stripped, since a field
;; name is never renamed. Injected, so that this macro's hygiene leaves it
;; alone too.
(: (-> (-> Symbol Syntax) Syntax Syntax))
(defun (path-field inject step)
  (def name
    (match step
      ((SSym s)
       (def dotted (symbol->string s))
       (substring dotted (string-cursor-next dotted (string-cursor-start dotted)) (string-cursor-end dotted)))
      (_ "")))
  (def start (string-cursor-start name))
  (inject
    (string->symbol
      (match (string-search-backward name "__")
        ((Some mark)
         (if (and (string-cursor>? mark start)
                  (path-digits? name (string-cursor-next name (string-cursor-next name mark))))
             (substring name start mark)
             name))
        (None name)))))

;; Is everything in `s` from `c` on an ASCII digit, and is there anything?
(: (-> string StringCursor bool))
(defun (path-digits? s c)
  (and (not (string-cursor-end? s c))
       (let go ((c c))
         (if (string-cursor-end? s c)
             #t
             (let ((ch (string-cursor-ref s c)))
               (and (char>=? ch #\0) (char<=? ch #\9) (go (string-cursor-next s c))))))))

;; `set` and `update`. `items` is the steps followed by the value or function.
;;
;; Everything that is evaluated is bound first, in order — the target, each
;; key, then the value — and the copy is then built from the bound names, so
;; that nothing is evaluated twice or out of order.
(: (-> (-> Symbol Syntax) Syntax (List Syntax) bool Syntax))
(defun (path-write inject target items update?)
  (def reversed (list-reverse items))
  (def value (list-head reversed))
  (def steps (list-reverse (list-tail reversed)))
  (def named (path-key-names steps 1 #t))
  (def obj (path-temp "obj" 0))
  (def new (path-temp "new" 0))
  (def (: leaf (-> Syntax Syntax))
    (if update?
        (fun (old) #'(,new ,old))
        (fun (old) new)))
  (def body (path-body inject obj 0 named steps leaf))
  #'(let ((,obj ,target))
      ,(list-foldr (fun (binding inner) #'(let (,binding) ,inner))
                   #'(let ((,new ,value)) ,body)
                   (path-key-bindings named steps))))

;; The steps, each key replaced by the name it is bound to. A field step is
;; kept. When `copying?`, a .NET property is refused: `set` copies with
;; `record-set`, which has no way to copy a .NET object. `set!` copies nothing
;; and only reads the steps before its last, so it reads a property there.
(: (-> (List Syntax) int bool (List Syntax)))
(defun (path-key-names steps i copying?)
  (match steps
    (Nil Nil)
    ((Cons step rest)
     (if (path-dotted? (path-check step))
         (if (and copying? (path-property? step))
             (Cons (syntax-error step
                     (str (syntax->string step) " is a .NET property. set and update copy along the path with record-set, which only copies a Bjolang record or struct; set the property itself, or build the new value with get."))
                   Nil)
             (Cons step (path-key-names rest (+ i 1) copying?)))
         (Cons (path-temp "key" i) (path-key-names rest (+ i 1) copying?))))))

;; `(key-n expr)` for each key step, in order.
(: (-> (List Syntax) (List Syntax) (List Syntax)))
(defun (path-key-bindings named steps)
  (match named
    (Nil Nil)
    ((Cons name names)
     (def step (list-head steps))
     (def rest (path-key-bindings names (list-tail steps)))
     (if (path-dotted? step)
         rest
         (Cons #'(,name ,step) rest)))))

;; The copy of `obj` with the rest of the path written. `named` and `steps` run
;; side by side: `named` is what the code uses, and `steps` is where each step
;; was written.
(: (-> (-> Symbol Syntax) Syntax int (List Syntax) (List Syntax) (-> Syntax Syntax) Syntax))
(defun (path-body inject obj depth named steps leaf)
  (match named
    (Nil (syntax-error obj "internal error: a path ran out of steps."))
    ((Cons key names)
     (def step (list-head steps))
     (def rest (list-tail steps))
     (def inner (path-temp "obj" (+ depth 1)))
     (def field? (path-dotted? step))
     (def old (if field? #'(,step ,obj) #'(ref ,obj ,key)))
     (def value
       (match rest
         (Nil (leaf old))
         (_ #'(let ((,inner ,old))
                ,(path-body inject inner (+ depth 1) names rest leaf)))))
     (syntax-at
       (if field?
           #'(record-set ,obj (,(path-field inject step) ,value))
           #'(ref-set ,obj ,key ,value))
       step))))

;; `(set! target step ... value)`: the parser hands `set!` with three or more
;; operands here, and keeps `(set! name value)`, which writes a variable.
;;
;; Nothing is copied. The steps before the last are read, as `get` reads them,
;; and the last is written in place: a key with `ref-set!` (`Settable!`), a
;; field with `record-set!`, so the field has to be `#:mutable`. The target,
;; each key from left to right and then the value are each evaluated once,
;; before anything is read, as in `set`.
(def/hash-extend (set! form inject compare)
  (syntax-match form
    ((_ target first second rest ...)
     (path-write! inject target (Cons first (Cons second rest))))
    (bad (syntax-error bad "set! writes a variable, (set! name value), or along a path in place, (set! target step ... value), where a step is .field or a key."))))

(: (-> (-> Symbol Syntax) Syntax (List Syntax) Syntax))
(defun (path-write! inject target items)
  (def reversed (list-reverse items))
  (def value (list-head reversed))
  (def steps (list-reverse (list-tail reversed)))
  (def named (path-key-names steps 1 #f))
  (def obj (path-temp "obj" 0))
  (def new (path-temp "new" 0))
  #'(let ((,obj ,target))
      ,(list-foldr (fun (binding inner) #'(let (,binding) ,inner))
                   #'(let ((,new ,value)) ,(path-store! inject obj named steps new))
                   (path-key-bindings named steps))))

;; The reads of the steps before the last, then the write of the last. The
;; container a field is written in is bound to a name first, because
;; `record-set!` takes the name of a record and not an expression.
(: (-> (-> Symbol Syntax) Syntax (List Syntax) (List Syntax) Syntax Syntax))
(defun (path-store! inject acc named steps new)
  (match named
    (Nil (syntax-error acc "internal error: a path ran out of steps."))
    ((Cons key names)
     (def step (list-head steps))
     (def rest (list-tail steps))
     (def field? (path-dotted? step))
     (match rest
       (Nil
        ;; cond is not available here.
        (syntax-at
          (if (not field?)
              #'(ref-set! ,acc ,key ,new)
              (if (path-property? step)
                  (syntax-error step
                    (str (syntax->string step) " is a .NET property, and set! writes the last step with record-set!, which writes a field of a Bjolang record. Call the property's setter, (.set_Name obj value), instead."))
                  ;; The write carries the step's position, which is also
                  ;; what makes it the writing module's: `record-set!` may
                  ;; write only the fields of a record its own module declared.
                  (let ((dest (path-temp "dest" 0)))
                    #'(let ((,dest ,acc))
                        ,(syntax-at #'(record-set! ,dest (,(path-field inject step) ,new)) step)))))
          step))
       (_
        (def read (syntax-at (if field? #'(,step ,acc) #'(ref ,acc ,key)) step))
        (path-store! inject read names rest new))))))

;; ---------------------------------------------------------------------------
;; Hash macros
;; ---------------------------------------------------------------------------
;;
;; `#name(args...)` calls a hash macro, its own namespace beside the functions:
;; `#map` and `map` are two things. `(def/hash-extend (name form inject compare)
;; body)` writes one; like any macro it cannot be used in the module that
;; defines it, so nothing below uses these four.
;;
;; The parser hands an operator with three or more operands to the first three:
;; `(+ a b c)` is `#fl(+ a b c)` and `(< a b c)` is `#ch(< a b c)`.

;; `#fl(op a b c ...)` — `(op (op a b) c)`, folded left.
(def/hash-extend (fl form inject compare)
  (syntax-match form
    ((_ op a b rest ...) (fold-left-forms op #'(,op ,a ,b) rest))
    (bad (syntax-error bad "#fl takes an operator and at least two operands: #fl(+ a b c)."))))

(: (-> Syntax Syntax (List Syntax) Syntax))
(defun (fold-left-forms op acc rest)
  (match rest
    (Nil acc)
    ((Cons x more) (fold-left-forms op #'(,op ,acc ,x) more))))

;; `#fr(op a b c ...)` — `(op a (op b c))`, folded right.
(def/hash-extend (fr form inject compare)
  (syntax-match form
    ((_ op a b rest ...) (fold-right-forms op a (Cons b rest)))
    (bad (syntax-error bad "#fr takes an operator and at least two operands: #fr(Cons 1 2 Nil)."))))

(: (-> Syntax Syntax (List Syntax) Syntax))
(defun (fold-right-forms op x rest)
  (match rest
    (Nil x)
    ((Cons y more) #'(,op ,x ,(fold-right-forms op y more)))))

;; `#ch(op a b c ...)` — `(op a b)`, and `(op b c)`, and so on, each tested only
;; if the one before it held. A middle operand that is not an atom is bound
;; once, right before its first use. The operands are evaluated left to right:
;; with three or more, a first operand that is not an atom is bound before the
;; second is evaluated, and a name is read before the operand after it is.
;;
;; Three template names for the temporaries. `t` and `u` hold operands and are
;; taken in turn: hygiene gives a template name one fresh spelling per
;; expansion, so a single name would shadow itself and `(op t t)` would compare
;; a value to itself. `s` holds a name's value, and is never needed again once
;; the operand after the name is bound.
(def/hash-extend (ch form inject compare)
  (syntax-match form
    ((_ op a b) #'(,op ,a ,b))
    ((_ op a b rest ...)
     (if (syntax-atom? a)
         (chain-forms op a (syntax-constant? a) (Cons b rest) #t)
         #'(let ((u ,a)) ,(chain-forms op #'u #t (Cons b rest) #t))))
    (bad (syntax-error bad "#ch takes an operator and at least two operands: #ch(< a b c)."))))

;; `prev` is safe to read twice: the first operand, an atom, or a temporary.
;; `fixed` says whether reading it later gives what reading it now would: a
;; constant and a temporary do, and a name does not if the operand after it
;; sets it. So a name is bound before an operand that is not an atom is
;; evaluated. The last comparison needs no binding: a call evaluates its
;; arguments left to right.
;; `use-t` says which temporary is free; the other may be `prev`.
(: (-> Syntax Syntax bool (List Syntax) bool Syntax))
(defun (chain-forms op prev fixed rest use-t)
  (match rest
    (Nil prev)
    ((Cons x Nil) #'(,op ,prev ,x))
    ((Cons x more)
     (if (syntax-atom? x)
         #'(if (,op ,prev ,x) ,(chain-forms op x (syntax-constant? x) more use-t) #f)
         (if (not fixed)
             #'(let ((s ,prev)) ,(chain-forms op #'s #t rest use-t))
             (if use-t
                 #'(let ((t ,x)) (if (,op ,prev t) ,(chain-forms op #'t #t more #f) #f))
                 #'(let ((u ,x)) (if (,op ,prev u) ,(chain-forms op #'u #t more #t) #f))))))))

;; Cheap to evaluate twice: anything but a list.
(: (-> Syntax bool))
(defun (syntax-atom? s)
  (match s
    ((SList _) #f)
    (_ #t)))

;; The same each time it is evaluated: an atom that is not a name.
(: (-> Syntax bool))
(defun (syntax-constant? s)
  (match s
    ((SList _) #f)
    ((SSym _) #f)
    (_ #t)))

;; `#map((k v) ...)` — a `Map`. An entry is `(k v)`, `[k v]` or `(k . v)`.
(def/hash-extend (map form inject compare)
  (syntax-match form
    ((_) #'(map-empty))
    ((_ entry ...) #'(list->map ,(map-entries entry)))))

(: (-> (List Syntax) Syntax))
(defun (map-entries entries)
  (match entries
    (Nil #'Nil)
    ((Cons entry rest)
     (syntax-match entry
       (('vec-literal k v) #'(Cons (Tuple ,k ,v) ,(map-entries rest)))
       (('Tuple k v) #'(Cons (Tuple ,k ,v) ,(map-entries rest)))
       ((k v) #'(Cons (Tuple ,k ,v) ,(map-entries rest)))
       (bad (syntax-error bad "A map entry is (key value), [key value] or (key . value)."))))))

;; ---------------------------------------------------------------------------
;; Cancellation scopes
;; ---------------------------------------------------------------------------
;;
;; A scope owns the fibers started inside it. `(spawn ...)` and `(bjo ...)` put
;; a fiber into the current scope, and the scope does not return until every one
;; of those fibers has finished. So this
;;
;;     (with-cancel (cancel)
;;       (spawn (process a))
;;       (spawn (process b)))
;;
;; waits for both, and the work is over when the form returns.
;;
;; Stopping early is what the cancel thunk is for:
;;
;;     (with-cancel (cancel)
;;       (spawn (worker jobs answers))
;;       (def answer (sync (chan-recv answers)))
;;       (cancel (Requested "got it"))
;;       answer)
;;
;; The cost of waiting first rather than cancelling first: a scope whose children
;; never end, and which never calls `cancel`, hangs here. That is the intended
;; trade. A hang says where it is; a scope that returned while its children ran
;; on says nothing at all.
;;
;; Waiting is the whole of what the four forms do. In a bjoroutine the wait
;; suspends; in ordinary code it parks the thread, as the end of a `defun`
;; `main` does. `scope-form` writes both, with `by-colour`.

;; The shared expansion of `with-cancel`, `with-deadline` and `with-shield`.
;;
;; `opener` is the call that makes the scope, and it is the only difference
;; between the three: a linked scope, a linked scope with a timer, or an
;; unlinked one. Everything after that — install, run, close, restore — is the
;; same, which is the point of writing it once.
;;
;; The two nested `try`s are one mechanism each. The inner one turns a failure in
;; the body into a value, so that the close can be told about it and can cancel
;; the other children before waiting for them. The outer one restores the
;; dynamic binding however the form is left; a fired token left installed would
;; make every later scope look cancelled.
;;
;; `(raise failure)` puts the body's exception back with the stack it arrived
;; with. It is not reached when the close raised first, which is what happens
;; when children failed too — the close reports them together.
(def/macro (scope-form form inject compare)
  (syntax-match form
    ((_ opener (cancel) first body ...)
     #'(let ()
         (def scope ,opener)
         (def saved (scope-push! scope))
         (def ,cancel (scope-canceller scope))
         (try
             (match (try (let () ,first ,@body) #:catch (System.Exception))
               ((Ok answer)
                (by-colour (#:sync (scope-close!/blocking scope None))
                           (#:bjo (scope-close! scope None)))
                answer)
               ((Err failure)
                (by-colour (#:sync (scope-close!/blocking scope (Some failure)))
                           (#:bjo (scope-close! scope (Some failure))))
                (raise failure)))
           #:finally (dyn-restore! saved))))
    (bad (syntax-error bad "scope-form takes an opener, a cancel thunk name and a body. It is what with-scope, with-cancel, with-deadline and with-shield expand to; write one of those."))))

;; `(with-scope body ...)` - a scope with no cancel thunk.
;;
;; The plain form, and the one to put around resources. Everything the other
;; three do about fibers it does too: it waits for what was spawned in it, and
;; it releases what was owned in it, newest first.
;;
;; The cancel thunk is bound to a name the template made up, so nothing in the
;; body can reach it. A scope that wants to stop early says so with
;; `with-cancel`; a scope that only wants ownership says so with this.
(def/macro (with-scope form inject compare)
  (syntax-match form
    ((_ first body ...)
     #'(scope-form (scope-open! 0) (no-cancel) ,first ,@body))
    (bad (syntax-error bad "with-scope takes a body: (with-scope body ...). For a cancel thunk write with-cancel."))))

;; `(with-cancel (cancel) body ...)` — a scope that owns what it starts.
(def/macro (with-cancel form inject compare)
  (syntax-match form
    ((_ (cancel) first body ...)
     #'(scope-form (scope-open! 0) (,cancel) ,first ,@body))
    (bad (syntax-error bad "with-cancel names its cancel thunk and takes a body: (with-cancel (cancel) body ...)"))))

;; `(with-deadline duration body ...)` — the same scope, whose token also fires
;; on its own once `duration` has passed, with `Deadline`.
;;
;; The timer belongs to the scope rather than to a fiber racing it. A watcher
;; fiber cannot work here: the scope waits for its children before it fires its
;; token, and the watcher would be waiting for that token — so each would be
;; waiting for the other.
(def/macro (with-deadline form inject compare)
  (syntax-match form
    ((_ ms first body ...)
     #'(scope-form (deadline-open! (duration->timer-ms ,ms)) (fire) ,first ,@body))
    (bad (syntax-error bad "with-deadline takes a Duration and a body: (with-deadline (seconds 5) body ...)"))))

;; `(with-shield body ...)` and `(with-shield #:within ms body ...)` — a scope
;; whose token is *not* linked to its parent's.
;;
;; This is how cleanup runs after a cancellation. Every `sync` consults the
;; ambient token, so once a scope has been cancelled every `sync` in it raises —
;; including the ones in the code that is trying to tidy up. Inside a shield the
;; ambient token is a fresh one that has not fired, so a `sync` works again:
;;
;;     (with-shield #:within (seconds 5)
;;       (spawn (flush-buffer a))
;;       (spawn (flush-buffer b)))
;;
;; It is the same object as any other scope with one flag different, and that is
;; deliberate: `(current-cancel)` inside a shield also reads as "not cancelled",
;; so a hand-written `until-cancelled` agrees with what `sync` is doing rather
;; than contradicting it.
;;
;; The deadline is not optional and defaults to thirty seconds. A shield with no
;; deadline is unreachable from outside by construction, which would make the
;; program impossible to kill.
;;
;; A shield is a scope, so it waits for its own children like any other.
(def/macro (with-shield form inject compare)
  (syntax-match form
    ((_ #:within ms first body ...)
     #'(scope-form (shield-open! (duration->timer-ms ,ms)) (fire) ,first ,@body))
    ((_ first body ...)
     #'(with-shield #:within (seconds 30) ,first ,@body))
    (bad (syntax-error bad "with-shield takes a body and an optional deadline: (with-shield #:within (seconds 5) body ...)"))))

;; ---------------------------------------------------------------------------
;; What a scope owns besides fibers
;; ---------------------------------------------------------------------------
;;
;; Own things the GC cannot price: OS handles, permits, subscriptions, state
;; that has to be put back. Do not own memory - that is what the GC is for.
;;
;;     (with-scope
;;       (match (open-input-file "notes.txt")
;;         ((Ok p) (read-all p))
;;         ((Err e) "")))
;;
;; Releases run when the scope returns, after every fiber has landed, newest
;; first - so a port wrapped around a stream closes before the stream. A release
;; that throws is recorded and the walk carries on.
;;
;; A release is a plain thunk. It cannot suspend, so it cannot be abandoned, so
;; a release that blocks blocks the close. That is the same trade `with-cancel`
;; makes for a child that never lands: a hang says where it is.
;;
;; A closing scope ignores `spawn`, and a finished one refuses `own!`. The two
;; differ because the consequences do: a fiber that was never started leaks
;; nothing, but a resource that was opened and then not registered is a leak
;; with nobody to release it, so the only safe answer is to refuse before the
;; caller lets go. They also differ in when: a spawn is refused once closing
;; begins, an `own!` only once the releases have run - a child still running
;; during the drain can open a file, and the walk will close it.
;;
;; **Fibers are not scopes.** A file opened inside `(spawn ...)` or `(bjo ...)`
;; belongs to the enclosing scope, not to the fiber, and outlives it:
;;
;;     (with-scope
;;       (spawn (fetch-into "a.txt"))    ;; the port it opens lives until
;;       (spawn (fetch-into "b.txt")))   ;; this form returns, not until the
;;                                       ;; fiber lands
;;
;; That is deliberate - a scope per spawn would be an allocation per spawn - and
;; it is the reason for the advice below.
;;
;; For many short-lived resources under one long-lived scope, open a child scope
;; per unit of work rather than `own!`/`release!` into the parent. The parent
;; then holds a count and not a list, and the close is a drain rather than a
;; walk. See the scale rows in bench/BASELINE.md.
;;
;; A handle returned out of the block that owned it is dangling. Nothing checks
;; that; what makes it harmless is that there is nothing to read off it.

;; `(in-scope s body ...)` - run the body with `s` as the ambient scope.
;;
;; The way to own something in a scope other than the innermost one, and the
;; way back in from a .NET callback, which runs on a foreign thread with no
;; ambient scope at all:
;;
;;     (def home (current-scope))
;;     (on-event (fun (e) (in-scope home (handle e))))
;;
;; This installs a scope; it does not open or close one. Whoever opened `s` is
;; still the one that waits for it.
;;
;; A form and not a keyword argument on `spawn` and `own!`: Bjolang has no
;; rest-keywords, so a `#:scope` could not be forwarded through a wrapper, and
;; the two would drift apart.
(def/macro (in-scope form inject compare)
  (syntax-match form
    ((_ scope first body ...)
     #'(let ()
         (def saved (scope-push! ,scope))
         (try (let () ,first ,@body)
           #:finally (dyn-restore! saved))))
    (bad (syntax-error bad "in-scope takes a scope and a body: (in-scope s body ...)"))))

;; `(own-disposable x)` - register `.Dispose` on the ambient scope, and hand
;; `x` straight back.
;;
;; A form rather than a function so that `.Dispose` is resolved at the call
;; site, the way `with-open` resolves it. A function would need the whole
;; `System.IDisposable` constraint apparatus to say the same thing.
;;
;; `with-open` is the other spelling: that one for a resource whose lifetime is
;; one block, this one for a resource whose lifetime is the scope's.
(def/macro (own-disposable form inject compare)
  (syntax-match form
    ((_ x)
     ;; `unit` after the call, not the call itself: `.Dispose` is a void .NET
     ;; method, so it has no value for the thunk to return.
     #'(let ((it ,x))
         (ignore (own! (fun () (.Dispose it) unit)))
         it))
    (bad (syntax-error bad "own-disposable takes one expression: (own-disposable (StreamReader. path))"))))

;; ---------------------------------------------------------------------------
;; Durations
;; ---------------------------------------------------------------------------
;;
;; A length of time, which is what every timer takes. A number of milliseconds
;; is a number whose unit is in no type: `5000` is easy to misread, and a count
;; that overflows becomes a different deadline without a word. A Duration has
;; its unit, and making one past its range raises.
;;
;; In .NET ticks of 100 ns, within ±long-max ticks, about ±29 227 years. Leaving
;; out long's minimum gives every duration a negation, so each one prints and
;; reads back. (std datetime) adds the arithmetic, the calendar and the text.

(import/class
  (DurationSpan (: System.TimeSpan (-> long DurationSpan)))
  (DurationOverflow (: System.OverflowException (-> string DurationOverflow))))

(import/extern
  (clr-duration-span-ticks (: System.TimeSpan.Ticks (-> DurationSpan long) #:get)))

(type (: Duration #:opaque (Struct (: v DurationSpan))))

(: (-> %a))
(defun (duration-overflow)
  (raise (cast Exception (DurationOverflow. "a duration is outside ±29 227 years (±9 223 372 036 854 775 807 ticks)"))))

;; The duration of `t` ticks. Raises at long's minimum, the one tick count
;; with no negation.
(: (-> long Duration))
(defun (ticks->duration t)
  (when (= t -9223372036854775808L) (duration-overflow))
  (Duration (v (DurationSpan. t))))

(: (-> Duration long))
(defun (duration-ticks d) (clr-duration-span-ticks (struct-ref d v)))

;; n units of `unit` ticks, or a raise past the range of a Duration.
(: (-> long long Duration))
(defun (units->duration n unit)
  (def limit (/ 9223372036854775807L unit))
  (when (or (> n limit) (< n (- limit))) (duration-overflow))
  (Duration (v (DurationSpan. (* n unit)))))

(: (-> long Duration))
(defun (milliseconds n) (units->duration n 10000L))

(: (-> long Duration))
(defun (seconds n) (units->duration n 10000000L))

(: (-> long Duration))
(defun (minutes n) (units->duration n 600000000L))

(: (-> long Duration))
(defun (hours n) (units->duration n 36000000000L))

(impl (Ord Duration)
  (defun (compare a b) (compare (duration-ticks a) (duration-ticks b))))

;; ISO 8601: PT26H30M, PT0.5S, with one leading sign: -PT1H30M.
(impl (Written Duration)
  (defun (written d) (duration->iso (duration-ticks d)))
  (defun (write-into d b) (stringbuilder-add-string! b (written d))))

(: (-> long string))
(defun (duration->iso t)
  (if (= t 0L)
      "PT0S"
      (let ()
        (def a (if (< t 0L) (- t) t))
        (def h (/ a 36000000000L))
        (def m (% (/ a 600000000L) 60L))
        (def s (% (/ a 10000000L) 60L))
        (def f (% a 10000000L))
        (string-append
          (if (< t 0L) "-PT" "PT")
          (string-append
            (if (= h 0L) "" #"${h}H")
            (string-append
              (if (= m 0L) "" #"${m}M")
              (if (and (= s 0L) (= f 0L)) "" #"${s}${(tick-fraction f)}S")))))))

;; ".5" for half a second: up to seven digits, without trailing zeros, and
;; nothing for a whole second.
(: (-> long string))
(defun (tick-fraction f)
  (if (= f 0L)
      ""
      (let trim ((f f) (width 7))
        (if (= (% f 10L) 0L)
            (trim (/ f 10L) (- width 1))
            (let pad ((digits (displayed f)))
              (if (< (string-length digits) width)
                  (pad (string-append "0" digits))
                  (string-append "." digits)))))))

;; Milliseconds for a timer, which counts them in a long. A part of a
;; millisecond counts as a whole one, so that a positive duration does not
;; become zero, which a timer takes as a time already passed.
(: (-> Duration long))
(defun (duration->timer-ms d)
  (def t (duration-ticks d))
  (if (<= t 0L) 0L (+ (/ (- t 1L) 10000L) 1L)))

(import/extern
  (clr-timeout-ms (: BjolangRuntime.timeout (-> long (Event Unit)))))

;; An event that is ready `d` after each sync of it. Zero or less is ready at
;; once.
(: (-> Duration (Event Unit)))
(defun (timeout d) (clr-timeout-ms (duration->timer-ms d)))


;; ---------------------------------------------------------------------------
;; Container formats
;; ---------------------------------------------------------------------------
;; A container is written with its elements written, and displayed with them
;; displayed, as Scheme's `write` and `display` do: `(written (list "a"))` is
;; `("a")` and `(displayed (list "a"))` is `(a)`. One function lays out each
;; kind of container, and is given the method that adds an element.

;; The elements of `xs` between `open` and `close`, with a space between two.
(: (-> string %s string StringBuilder (-> %a StringBuilder void) void)
   (where (Iterable %s #:elem %a)))
(defun (elements-print-into open xs close b each)
  (stringbuilder-add-string! b open)
  (loop (:with first? #t #f)
        (:for x xs)
        (:do (unless first? (stringbuilder-add-string! b " "))
             (each x b)))
  (stringbuilder-add-string! b close))

;; `(1 2 3)`. No quote, so a nested list is `((1) (2 3))` and the empty list
;; is `()`.
(impl (Written (List %a))
  (where (Written %a))
  (defun (write-into l b) (elements-print-into "(" l ")" b (fun (x b) (write-into x b)))))

(impl (Displayed (List %a))
  (where (Displayed %a))
  (defun (display-into l b) (elements-print-into "(" l ")" b (fun (x b) (display-into x b)))))

;; `[1 2 3]`, as the literal writes it.
(impl (Written (Vec %a))
  (where (Written %a))
  (defun (write-into v b) (elements-print-into "[" v "]" b (fun (x b) (write-into x b)))))

(impl (Displayed (Vec %a))
  (where (Displayed %a))
  (defun (display-into v b) (elements-print-into "[" v "]" b (fun (x b) (display-into x b)))))

;; `#[1 2 3]`, as the literal writes it.
(impl (Written (Array %a))
  (where (Written %a))
  (defun (write-into a b) (elements-print-into "#[" a "]" b (fun (x b) (write-into x b)))))

(impl (Displayed (Array %a))
  (where (Displayed %a))
  (defun (display-into a b) (elements-print-into "#[" a "]" b (fun (x b) (display-into x b)))))

;; `#iarray[1 2 3]`. There is no literal; the name says which collection it is.
(impl (Written (IArray %a))
  (where (Written %a))
  (defun (write-into a b) (elements-print-into "#iarray[" a "]" b (fun (x b) (write-into x b)))))

(impl (Displayed (IArray %a))
  (where (Displayed %a))
  (defun (display-into a b) (elements-print-into "#iarray[" a "]" b (fun (x b) (display-into x b)))))

;; A sequence is not walked: walking it could do anything, or never end.
(impl (Written (Seq %a))
  (defun (written s) "(Seq ...)")
  (defun (write-into s b) (stringbuilder-add-string! b "(Seq ...)")))

;; The entries of `xs` between `open` and `close`, each in parentheses, a key
;; and its value with a space between.
(: (-> string %s string StringBuilder (-> %k StringBuilder void) (-> %v StringBuilder void) void)
   (where (Iterable %s #:elem (Tuple %k %v))))
(defun (entries-print-into open xs close b each-key each-value)
  (stringbuilder-add-string! b open)
  (loop (:with first? #t #f)
        (:for entry xs)
        (:do (def (k v) entry)
             (unless first? (stringbuilder-add-string! b " "))
             (stringbuilder-add-string! b "(")
             (each-key k b)
             (stringbuilder-add-string! b " ")
             (each-value v b)
             (stringbuilder-add-string! b ")")))
  (stringbuilder-add-string! b close))

;; `#map((k v) ...)`, as the `#map` literal writes it.
(impl (Written (Map %k %v))
  (where (Written %k) (Written %v))
  (defun (write-into m b)
    (entries-print-into "#map(" m ")" b (fun (k b) (write-into k b)) (fun (v b) (write-into v b)))))

(impl (Displayed (Map %k %v))
  (where (Displayed %k) (Displayed %v))
  (defun (display-into m b)
    (entries-print-into "#map(" m ")" b (fun (k b) (display-into k b)) (fun (v b) (display-into v b)))))

;; A case of a union the runtime declares, in constructor syntax: `(Some 1)`
;; and `None`, `(Ok 1)` and `(Err "no")`.
(: (-> string %a StringBuilder (-> %a StringBuilder void) void))
(defun (case-print-into name x b each)
  (stringbuilder-add-string! b "(")
  (stringbuilder-add-string! b name)
  (stringbuilder-add-string! b " ")
  (each x b)
  (stringbuilder-add-string! b ")"))

(impl (Written (Option %a))
  (where (Written %a))
  (defun (write-into o b)
    (match o
      ((Some x) (case-print-into "Some" x b (fun (x b) (write-into x b))))
      (None (stringbuilder-add-string! b "None")))))

(impl (Displayed (Option %a))
  (where (Displayed %a))
  (defun (display-into o b)
    (match o
      ((Some x) (case-print-into "Some" x b (fun (x b) (display-into x b))))
      (None (stringbuilder-add-string! b "None")))))

(impl (Written (Result %e %a))
  (where (Written %e) (Written %a))
  (defun (write-into r b)
    (match r
      ((Ok x) (case-print-into "Ok" x b (fun (x b) (write-into x b))))
      ((Err e) (case-print-into "Err" e b (fun (e b) (write-into e b)))))))

(impl (Displayed (Result %e %a))
  (where (Displayed %e) (Displayed %a))
  (defun (display-into r b)
    (match r
      ((Ok x) (case-print-into "Ok" x b (fun (x b) (display-into x b))))
      ((Err e) (case-print-into "Err" e b (fun (e b) (display-into e b)))))))

;; `(Tuple 1 "a")`, as a tuple is built.
(impl (Written (Tuple %a %b))
  (where (Written %a) (Written %b))
  (defun (write-into t b)
    (def (x y) t)
    (stringbuilder-add-string! b "(Tuple ")
    (write-into x b)
    (stringbuilder-add-string! b " ")
    (write-into y b)
    (stringbuilder-add-string! b ")")))

(impl (Displayed (Tuple %a %b))
  (where (Displayed %a) (Displayed %b))
  (defun (display-into t b)
    (def (x y) t)
    (stringbuilder-add-string! b "(Tuple ")
    (display-into x b)
    (stringbuilder-add-string! b " ")
    (display-into y b)
    (stringbuilder-add-string! b ")")))

(impl (Written (Tuple %a %b %c))
  (where (Written %a) (Written %b) (Written %c))
  (defun (write-into t b)
    (def (Tuple x y z) t)
    (stringbuilder-add-string! b "(Tuple ")
    (write-into x b)
    (stringbuilder-add-string! b " ")
    (write-into y b)
    (stringbuilder-add-string! b " ")
    (write-into z b)
    (stringbuilder-add-string! b ")")))

(impl (Displayed (Tuple %a %b %c))
  (where (Displayed %a) (Displayed %b) (Displayed %c))
  (defun (display-into t b)
    (def (Tuple x y z) t)
    (stringbuilder-add-string! b "(Tuple ")
    (display-into x b)
    (stringbuilder-add-string! b " ")
    (display-into y b)
    (stringbuilder-add-string! b " ")
    (display-into z b)
    (stringbuilder-add-string! b ")")))

;; Four elements, as far as `Eq` and `Ord` go.
(impl (Written (Tuple %a %b %c %d))
  (where (Written %a) (Written %b) (Written %c) (Written %d))
  (defun (write-into t b)
    (def (Tuple w x y z) t)
    (stringbuilder-add-string! b "(Tuple ")
    (write-into w b)
    (stringbuilder-add-string! b " ")
    (write-into x b)
    (stringbuilder-add-string! b " ")
    (write-into y b)
    (stringbuilder-add-string! b " ")
    (write-into z b)
    (stringbuilder-add-string! b ")")))

(impl (Displayed (Tuple %a %b %c %d))
  (where (Displayed %a) (Displayed %b) (Displayed %c) (Displayed %d))
  (defun (display-into t b)
    (def (Tuple w x y z) t)
    (stringbuilder-add-string! b "(Tuple ")
    (display-into w b)
    (stringbuilder-add-string! b " ")
    (display-into x b)
    (stringbuilder-add-string! b " ")
    (display-into y b)
    (stringbuilder-add-string! b " ")
    (display-into z b)
    (stringbuilder-add-string! b ")")))

;; What `displayed` was called for these before it took every type.
(: (-> (List %a) string) (where (Displayed %a)))
(defun (list->str l) (displayed l))

(: (-> (Map %k %v) string) (where (Displayed %k) (Displayed %v)))
(defun (map->str m) (displayed m))

(: (-> (Tuple %k %v) string) (where (Displayed %k) (Displayed %v)))
(defun (map-entry->str entry)
  (def (k v) entry)
  (str (displayed k) " " (displayed v)))

(:deprecated list->str "use `displayed`")
(:deprecated map->str "use `displayed`")
(:deprecated map-entry->str "use `displayed` on the key and the value")

;; Sequential binding
;;
;; Sequential binding macros.

;; `(let* ((a 1) (b (+ a 1))) ...)` — each binding is in scope for the next.
(def/macro (let* form compare inject)
  (syntax-match form
    ((_ () body ...)
     #'(let () ,@body))
    ((_ (bind) body ...)
     #'(let (,bind) ,@body))
    ((_ (bind binds ...) body ...)
     #'(let (,bind)
         (let* (,@binds) ,@body)))))

;; parameterize* behavior.
(def/macro (parameterize* form compare inject)
  (syntax-match form
    ((_ () body ...)
     #'(let () ,@body))
    ((_ (bind) body ...)
     #'(parameterize (,bind) ,@body))
    ((_ (bind binds ...) body ...)
     #'(parameterize (,bind)
        (parameterize* (,@binds) ,@body)))))

;; ---------------------------------------------------------------------------
;; type/derive
;; ---------------------------------------------------------------------------

(: (-> string Syntax))
(defun (derive-sym name) (SSym (string->symbol name)))

;; Refuse invalid syntax.
(: (-> Syntax string (List Syntax)))
(defun (derive-fail form message)
  (ignore (syntax-error form message))
  Nil)

;; Head type variables.
(: (-> Syntax (List Syntax)))
(defun (derive-head-vars head)
  (match head
    ((SList items)
     (match items
       (Nil Nil)
       ((Cons _ vars) vars)))
    (_ Nil)))

;; Type name.
(: (-> Syntax Syntax))
(defun (derive-head-name head)
  (match head
    ((SList items)
     (match items
       ((Cons name _) name)
       (Nil head)))
    (_ head)))

;; Hash combine fold.
(: (-> (List Syntax) Syntax Syntax))
(defun (derive-hash-fold parts acc)
  (match parts
    (Nil acc)
    ((Cons p rest) (derive-hash-fold rest #'(hash-combine ,acc ,p)))))

;; --- Records and structs ---

;; Field names.
(: (-> (List Syntax) (List Syntax)))
(defun (derive-field-names fields)
  (list-map (fun (f)
              (syntax-match f
                ((_ name _ marker ...) name)
                (bad (syntax-error bad "a record field is written (: name type), optionally followed by #:mutable."))))
            fields))

;; Any mutable fields.
(: (-> (List Syntax) bool))
(defun (derive-any-mutable? fields)
  (def (Cons f rest) fields
    :leave-with #f)
  (if (syntax-match f
        ((_ _ _ marker markers ...) #t)
        (_ #f))
      #t
      (derive-any-mutable? rest)))

;; Eq record methods.
(: (-> Syntax (List Syntax) bool (List Syntax)))
(defun (derive-eq-record head names mutable?)
  (def equals
    #'(defun (= a b)
        (and ,@(list-map (fun (n) #'(= (record-ref a ,n) (record-ref b ,n))) names))))
  (def hashed
    (if mutable?
        #'(defun (eq-hash v) (unhashable ,(SStr (syntax->string (derive-head-name head)))))
        #'(defun (eq-hash v)
            ,(derive-hash-fold (list-map (fun (n) #'(eq-hash (record-ref v ,n))) names) #'17))))
  (Cons equals (Cons hashed Nil)))

;; --- Unions ---

;; A case is a bare name or `(: Name type ... markers ...)`.
(: (-> Syntax Syntax))
(defun (derive-case-name c)
  (def* ((SList items) c :leave-with c)
        ((Cons _ (Cons name _)) items :leave-with c))
  name)

;; The payload types, which end at the first marker: `#:tag` takes a name after
;; it, which is not a type.
(: (-> Syntax (List Syntax)))
(defun (derive-payload c)
  (def* ((SList items) c :leave-with Nil)
        ((Cons _ (Cons _ rest)) items :leave-with Nil))
  (derive-types-before-markers rest))

(: (-> (List Syntax) (List Syntax)))
(defun (derive-types-before-markers items)
  (match items
    ((Cons (SKey _) _) Nil)
    ((Cons t rest) (Cons t (derive-types-before-markers rest)))
    (Nil Nil)))

;; Binders.
(: (-> string int int (List Syntax)))
(defun (derive-binders side i n)
  (if (= i n)
      Nil
      (Cons (derive-sym (string-append side (int->string i)))
            (derive-binders side (+ i 1) n))))

(: (-> (List Syntax) (List Syntax) (List Syntax)))
(defun (derive-eq-pairs ls rs)
  (def* ((Cons l lrest) ls :leave-with Nil)
        ((Cons r rrest) rs :leave-with Nil))
  (Cons #'(= ,l ,r) (derive-eq-pairs lrest rrest)))

;; Union arm eq.
(: (-> Syntax Syntax))
(defun (derive-eq-union-arm c)
  (def name (derive-case-name c))
  (def n (list-length (derive-payload c)))
  (def ls (derive-binders "__derived-l" 0 n))
  (def rs (derive-binders "__derived-r" 0 n))
  #'((,name ,@ls)
     (match b
       ((,name ,@rs) (and ,@(derive-eq-pairs ls rs)))
       (,(derive-sym "_") #f))))

;; Hash union arms.
(: (-> (List Syntax) int (List Syntax)))
(defun (derive-hash-union-arms cases index)
  (def (Cons c rest) cases :leave-with Nil)
  (def name (derive-case-name c))
  (def ls (derive-binders "__derived-l" 0 (list-length (derive-payload c))))
  (def tag (SInt (int->string index)))
  (Cons #'((,name ,@ls)
           ,(derive-hash-fold (list-map (fun (l) #'(eq-hash ,l)) ls) tag))
        (derive-hash-union-arms rest (+ index 1))))

(: (-> (List Syntax) (List Syntax)))
(defun (derive-eq-union cases)
  (def equals
    #'(defun (= a b) (match a ,@(list-map derive-eq-union-arm cases))))
  (def hashed
    #'(defun (eq-hash v) (match v ,@(derive-hash-union-arms cases 0))))
  (Cons equals (Cons hashed Nil)))

;; --- Ordering ---

;; Ord chain.
(: (-> (List Syntax) int Syntax))
(defun (derive-ord-chain parts i)
  (def* ((Cons p rest) parts :leave-with #'0)
        (c (derive-sym (string-append "__derived-c" (int->string i)))))
  (if (list-empty? rest)
      p
      #'(let ((,c ,p))
          (if (= ,c 0) ,(derive-ord-chain rest (+ i 1)) ,c))))

;; Ord record.
(: (-> (List Syntax) (List Syntax)))
(defun (derive-ord-record names)
  (Cons #'(defun (compare a b)
            ,(derive-ord-chain
              (list-map (fun (n) #'(compare (record-ref a ,n) (record-ref b ,n))) names)
              0))
        Nil))

;; Wildcards.
(: (-> int (List Syntax)))
(defun (derive-wildcards n)
  (if (= n 0)
      Nil
      (Cons (derive-sym "_") (derive-wildcards (- n 1)))))

;; Index arms.
(: (-> (List Syntax) int (List Syntax)))
(defun (derive-ord-index-arms cases index)
  (def (Cons c rest) cases :leave-with Nil)
  (Cons #'((,(derive-case-name c) ,@(derive-wildcards (list-length (derive-payload c))))
           ,(SInt (int->string index)))
        (derive-ord-index-arms rest (+ index 1))))

(: (-> (List Syntax) (List Syntax) (List Syntax)))
(defun (derive-ord-pairs ls rs)
  (def* ((Cons l lrest) ls :leave-with Nil)
        ((Cons r rrest) rs :leave-with Nil))
  (Cons #'(compare ,l ,r) (derive-ord-pairs lrest rrest)))

;; Ord union arm.
(: (-> Syntax Syntax))
(defun (derive-ord-union-arm c)
  (def name (derive-case-name c))
  (def n (list-length (derive-payload c)))
  (def ls (derive-binders "__derived-l" 0 n))
  (def rs (derive-binders "__derived-r" 0 n))
  #'((,name ,@ls)
     (match b
       ((,name ,@rs) ,(derive-ord-chain (derive-ord-pairs ls rs) 0))
       (,(derive-sym "_") 0))))

;; Ord union.
(: (-> (List Syntax) (List Syntax)))
(defun (derive-ord-union cases)
  (def ia (derive-sym "__derived-ia"))
  (def ib (derive-sym "__derived-ib"))
  (def index-arms (derive-ord-index-arms cases 0))
  (Cons #'(defun (compare a b)
            (let ((,ia (match a ,@index-arms))
                  (,ib (match b ,@index-arms)))
              (if (= ,ia ,ib)
                  (match a ,@(list-map derive-ord-union-arm cases))
                  (compare ,ia ,ib))))
        Nil))

;; --- Putting one implementation together ---

;; Shape error.
(: (-> Syntax (List Syntax)))
(defun (derive-shape-error bad)
  (derive-fail bad "a type that derives has to be a Record, a Struct or a Union. An alias is a second spelling of a type rather than a type of its own — derive for the type it names."))

;; Eq methods.
(: (-> Syntax Syntax (List Syntax)))
(defun (derive-eq-methods head shape)
  (syntax-match shape
    (('Record fields ...) (derive-eq-record head (derive-field-names fields) (derive-any-mutable? fields)))
    (('Struct fields ...) (derive-eq-record head (derive-field-names fields) (derive-any-mutable? fields)))
    (('Union cases ...) (derive-eq-union cases))
    (('Enum cases ...) (derive-eq-union cases))
    (('Sum cases ...) (derive-eq-union cases))
    (bad (derive-shape-error bad))))

(: (-> Syntax (List Syntax)))
(defun (derive-ord-methods shape)
  (syntax-match shape
    (('Record fields ...) (derive-ord-record (derive-field-names fields)))
    (('Struct fields ...) (derive-ord-record (derive-field-names fields)))
    (('Union cases ...) (derive-ord-union cases))
    (('Enum cases ...) (derive-ord-union cases))
    (('Sum cases ...) (derive-ord-union cases))
    (bad (derive-shape-error bad))))

(: (-> Syntax Syntax Syntax (List Syntax)))
(defun (derive-methods trait head shape)
  (if (syntax-ident=? trait (derive-sym "Eq"))
      (derive-eq-methods head shape)
      (if (syntax-ident=? trait (derive-sym "Ord"))
          (derive-ord-methods shape)
          (derive-fail trait "the traits that can be derived are Eq and Ord."))))

;; Derive conditional implementation. A newtype's is the type it wraps,
;; whatever the trait.
(: (-> Syntax Syntax Syntax))
(defun (derive-impl trait typedef)
  (syntax-match typedef
    ((_ head ('Newtype underlying))
     #'(impl (,trait ,head) #:via ,underlying))
    ((_ head shape)
     #'(impl (,trait ,head)
        (where ,@(list-map (fun (v) #'(,trait ,v)) (derive-head-vars head)))
        ,@(derive-methods trait head shape)))
    (bad (syntax-error bad "a type declaration is written (: Name (Record ...))."))))

(: (-> (List Syntax) (List Syntax) (List Syntax)))
(defun (derive-impls traits typedefs)
  (match traits
    (Nil Nil)
    ((Cons t rest)
     (list-append (list-map (fun (td) (derive-impl t td)) typedefs)
                  (derive-impls rest typedefs)))))

(def/macro (type/derive form inject compare)
  (syntax-match form
    ((_ (trait ...) typedef ...)
     #'(begin
         (type ,@typedef)
         ,@(derive-impls trait typedef)))
    (bad (syntax-error bad "type/derive takes a list of traits and one or more type declarations, as in (type/derive (Eq) (: Point (Record (: x int))))."))))

;; -------------------------------------------------------------
;; Extra thingies for cml
;;

(: (-> (Promise %a) %a))
(defun (promise-join/sync p)
  (match (sync/blocking (promise-join p))
    ((Err e) (raise e))
    ((Ok v) v)))


;; Pattern matching thingies
;;
;; Has is useful when matching against Refable. It matches they key and binds the key if it exists
;; (match my-map
;; ((Has :my-key pat) (println #"The value of :my-key is ${pat}"))
;; (_ (panic! "it didn't have it")))
(def/pattern (Has form inject compare)
  (syntax-match form
    ((_ key p) #'(:view (try-ref & ,key) (Some ,p)))
    (bad (syntax-error bad "(Has key pattern) matches a Refable that holds key."))))

(def/pattern (Has* form inject compare)
  (syntax-match form
    ((_) (syntax-error form "(Has* (key pattern) ...) needs at least one key."))
    ((_ (key pat) ...)
     #'(and ,@{listing #'(Has ,k ,p) (:for k key) (:for p pat)}))
    (bad (syntax-error bad "(Has* (key pattern) ...) pairs each key with a pattern for its value."))))

;; ---------------------------------------------------------------------------
;; Taking, dropping and reversing a vec
;; ---------------------------------------------------------------------------
;;
;; A count past the end takes or drops the whole vec, as for a string; a
;; negative count is refused.

(: (-> (Vec %a) int (Vec %a)))
(defun (vec-take v n)
  (check-count "vec-take" n)
  (def len (vec-length v))
  (vec-slice v 0 (if (< n len) n len)))

(: (-> (Vec %a) int (Vec %a)))
(defun (vec-drop v n)
  (check-count "vec-drop" n)
  (def len (vec-length v))
  (def k (if (< n len) n len))
  (vec-slice v k (- len k)))

(: (-> (Vec %a) (Vec %a)))
(defun (vec-reverse v)
  {vecing x (:for x (in-reverse-vec v))})

;; The elements in a new array, which the vec does not share. The runtime's,
;; which copies the leaves in one pass.
(import/extern
  (vec->array (: BjolangRuntime.vecsubgtarray (-> (Vec %a) (Array %a)))))
