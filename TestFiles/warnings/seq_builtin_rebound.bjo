;; A program's own `seq-map` is not the deprecated builtin, and a use of it
;; does not warn.

;; EXPECT-NO-WARNING: deprecated

(import (std prelude))
(import (std simpletest))

(: (-> int int))
(defun (seq-map x) (* 2 x))

(defun (main)
  (defun (seq-take n) (+ n 1))
  (expect "the module's own" (seq-map 4) 8)
  (expect "a local one" (seq-take 4) 5)
  0)
