;; EXPECT-ERROR: #:clr-member` is not implemented yet
;;
;; A method of a CLR-constraint trait has to name the interface member it
;; dispatches to, and that emitter is not written. Rejected rather than accepted
;; and silently left without an implementation.
(import (std prelude))

(def/trait (Num %a)
  (#:clr-constraint (System.Numerics.INumber %a))
  (: abs (-> %a %a)))

(defun (main) 0)
