;; Constructing an `#:opaque` record from outside.
;;
;; A record is built by its own type name, and a type name — unlike a hidden
;; union case — does have a spelling registered, so this arrives at the lookup
;; already resolved to the key. That is why `lookup` tests `OpaqueTypes` as well
;; as `HiddenMembers`.

;; EXPECT-ERROR: Unbound variable: vault__Ledger
;; EXPECT-ERROR: vault/Ledger is exported #:opaque
;; EXPECT-ERROR: cannot be constructed here

(import "../inc/vault.bjo")

(defun (main args)
  (println (int->string (ledger-total (Ledger (total 1) (note "x")))))
  0)
