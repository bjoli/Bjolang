;; Imports the type, the case and the trait in the order opposite to 454's.
(import (std prelude))
(import "greet_type.bjo")
(import "greet_case.bjo")
(import "greet_trait.bjo")
(export both)

(type (: Dog (Struct (: name string))))
(impl (Greet Dog) (defun (greeting d) "woof"))

(: (-> Greet string))
(defun (shown g) (match g ((Hi) "hi") ((Ho) "ho")))

(: (-> string))
(defun (both) (str (greeting (Dog (name "rex"))) " " (written (Greet 2)) " " (shown (hi))))
