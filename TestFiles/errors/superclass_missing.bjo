;; An implementation of a trait whose superclass does not hold at its type.

;; EXPECT-ERROR: 'Greet' requires 'Named' of every implementor, and 'Named' does not hold for superclass_missing/Dog here. Write an implementation of 'Named' for superclass_missing/Dog.

(import (std prelude))

(def/trait (Named %a)
  (: name-of (-> %a string)))

(def/trait (Greet %a)
  (where (Named %a))
  (: greeting (-> %a string)))

(type (: Dog (Struct (: n int))))

(impl (Greet Dog)
  (defun (greeting d) "woof"))

(defun (main args) 0)
