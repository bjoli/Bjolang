;; EXPECT-ERROR: this string writes \u{...}, which a published doc cannot
;; A doc is published as written, into bjodat, which writes a code point as
;; \u0041 and not as \u{41}.
(import (std prelude))

(:doc twice
  (summary "Doubles a number, n \u{D7} 2.")
  (arg n "The number.")
  (returns "Twice n."))
(: (-> int int))
(defun (twice n) (* 2 n))

(defun (main args) 0)
