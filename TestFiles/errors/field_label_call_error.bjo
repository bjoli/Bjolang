;; EXPECT-ERROR: Invalid cast syntax

;; (cast 1) has the shape of a field, so its error is kept until inference
;; knows the head. Some is not a record type, so it is a call to cast, and
;; the error of cast is reported as before.

(import (std prelude))

(defun (main args)
  (println (Some (cast 1)))
  0)
