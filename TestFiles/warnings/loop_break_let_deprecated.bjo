;; `:break-let` is the old spelling of `:finish-let`. It still works, and says so.

;; EXPECT-WARNING: `:break-let` at loop_break_let_deprecated.bjo:11 is deprecated, use `:finish-let`.

(import (std prelude))
(import (std simpletest))

(: f (-> (List (Option int)) int))
(defun (f xs)
  (loop (:for x xs)
        (:break-let (Some v) x)
        (:acc s (summing v))
        => s))

(defun (main)
  (expect "break-let stops at the first None" (f (list (Some 1) (Some 2) None (Some 4))) 3)
  0)
