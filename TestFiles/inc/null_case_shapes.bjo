;; Unions for 334_null_case.bjo, from a module of their own: each has a case
;; that is `null` at run time, and an importer has to agree on that.

(type/derive (Eq Ord) (: Shape (Union (: Dot int) (: Box int int) Nothing)))
(type (: (Box %a) (Union Shut (: Open %a (Box %a)))))

(: area (-> Shape int))
(defun (area s)
  (match s
    ((Dot _) 0)
    ((Box w h) (* w h))
    (Nothing -1)))

(export Shape Box area)
