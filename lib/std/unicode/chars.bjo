;; std/unicode/chars.bjo — the Unicode properties and case mappings of one
;; character, R6RS section 11.11.
;;
;; - (std prelude) re-exports all of it, so a program has these names without
;;   an import.
;; - The tables are generated by gen_chars.py into chars-table.protobjo from
;;   the Unicode Character Database, and decoded once when the module is
;;   initialized. They do not depend on .NET or ICU, and are of the same
;;   version as the tables of (std unicode normalize), casefold and grapheme.
;; - Every function is one lookup in a two-stage table: the kind of the code
;;   point, then a property or a delta of the kind.

(export
  chars-unicode-version
  ;; Case
  char-upcase char-downcase char-titlecase char-foldcase
  ;; Classification
  char-alphabetic? char-numeric? char-whitespace?
  char-upper-case? char-lower-case? char-title-case?
  digit-value char-general-category
  ;; Comparison without case
  char-ci=? char-ci<? char-ci>? char-ci<=? char-ci>=?)

;; The core, so that (std prelude) can import this module.
(import (std prelude core))

(:doc #:file "chars.bjodoc")

(include "chars-table.protobjo")

;; ---------------------------------------------------------------------------
;; The tables
;; ---------------------------------------------------------------------------

(: string)
(def chars-unicode-version unicode-version)

;; The bytes a generated text of hex digits is, two digits to a byte. The
;; texts are indented over many lines; the decoder skips the white space.
(import/extern
  (byte-table (: BjolangRuntime.hexBytes (-> string (Array byte)))))

;; The block of each 256 code points.
(: (Array byte))
(def stage1 (byte-table stage1-text))

;; The kind of each code point, by block.
(: (Array byte))
(def stage2 (byte-table stage2-text))

;; The kinds, decoded: the properties of each, and its four deltas.
(type (: Kinds (Record (: props (Array int))
                       (: upper (Array int))
                       (: lower (Array int))
                       (: title (Array int))
                       (: fold (Array int)))))

;; The width of a kind in the bytes of `kinds-text`, and the bias of a delta.
(def kind-width 14)
(def delta-bias 0x800000)

(: Kinds)
(def kinds
  (begin
    (def bytes (byte-table kinds-text))
    (def n (/ (array-length bytes) kind-width))
    ;; The big-endian number of the `len` bytes at `i` of kind `k`.
    (: field (-> int int int int))
    (defun (field k i len)
      (loop (:for j (range 0 len))
            (:acc v (folding 0 (+ (* 256 v) (cast int (array-ref bytes (+ (* k kind-width) i j))))))))
    (: deltas (-> int (Array int)))
    (defun (deltas i)
      (def (: out (Array int)) (make-array n))
      (loop (:for k (range 0 n)) (:do (array-set! out k (- (field k i 3) delta-bias))))
      out)
    (def (: props (Array int)) (make-array n))
    (loop (:for k (range 0 n)) (:do (array-set! props k (field k 0 2))))
    (Kinds (props props) (upper (deltas 2)) (lower (deltas 5)) (title (deltas 8)) (fold (deltas 11)))))

;; The kind of a code point.
(: (-> int int) #:inline)
(defun (kind-of cp)
  (cast int (array-ref stage2 (+ (shift-left (cast int (array-ref stage1 (shift-right cp 8))) 8)
                                 (bitwise-and cp 255)))))

;; The properties of a character: bits 0-4 the general category, bit 5
;; Alphabetic, bit 6 White_Space, bit 7 Uppercase, bit 8 Lowercase, bits 9-12
;; the decimal digit value or 15.
(: (-> char int) #:inline)
(defun (props-of c)
  (array-ref (record-ref kinds props) (kind-of (char->int c))))

(: (-> char int bool) #:inline)
(defun (has? c bit)
  (not (= 0 (bitwise-and (props-of c) (shift-left 1 bit)))))

;; A character moved by the delta of its kind in `deltas`.
(: (-> (Array int) char char) #:inline)
(defun (mapped deltas c)
  (def cp (char->int c))
  (def d (array-ref deltas (kind-of cp)))
  (if (= d 0) c (int->char (+ cp d))))

;; ---------------------------------------------------------------------------
;; Case
;; ---------------------------------------------------------------------------

(: (-> char char))
(defun (char-upcase c) (mapped (record-ref kinds upper) c))

(: (-> char char))
(defun (char-downcase c) (mapped (record-ref kinds lower) c))

(: (-> char char))
(defun (char-titlecase c) (mapped (record-ref kinds title) c))

(: (-> char char))
(defun (char-foldcase c) (mapped (record-ref kinds fold) c))

;; ---------------------------------------------------------------------------
;; Classification
;; ---------------------------------------------------------------------------

(: (-> char bool))
(defun (char-alphabetic? c) (has? c 5))

(: (-> char bool))
(defun (char-whitespace? c) (has? c 6))

(: (-> char bool))
(defun (char-upper-case? c) (has? c 7))

(: (-> char bool))
(defun (char-lower-case? c) (has? c 8))

;; The index of the category, as `category-symbol` takes it.
(: (-> char int) #:inline)
(defun (category-of c) (bitwise-and (props-of c) 31))

;; Lt, Nd and No, by their index in `category-symbol`.
(def lt 2)
(def nd 8)
(def no 10)

(: (-> char bool))
(defun (char-title-case? c) (= (category-of c) lt))

(: (-> char bool))
(defun (char-numeric? c)
  (def g (category-of c))
  (and (>= g nd) (<= g no)))

(: (-> char (Option int)))
(defun (digit-value c)
  (def d (shift-right (props-of c) 9))
  (if (= d 15) None (Some d)))

(: (-> char Symbol))
(defun (char-general-category c) (category-symbol (category-of c)))

;; ---------------------------------------------------------------------------
;; Comparison without case
;; ---------------------------------------------------------------------------

(: (-> char char bool))
(defun (char-ci=? a b) (= (char-foldcase a) (char-foldcase b)))

(: (-> char char bool))
(defun (char-ci<? a b) (< (char-foldcase a) (char-foldcase b)))

(: (-> char char bool))
(defun (char-ci>? a b) (> (char-foldcase a) (char-foldcase b)))

(: (-> char char bool))
(defun (char-ci<=? a b) (<= (char-foldcase a) (char-foldcase b)))

(: (-> char char bool))
(defun (char-ci>=? a b) (>= (char-foldcase a) (char-foldcase b)))
