;; What `with-return` and a refutable `def` compile to.
;;
;; Two shapes, read off the generated C# by hand once and pinned here.
;;
;; **The tail case emits neither a slot nor a label.** When the block *is* the
;; function's value, an escape is a plain `return`, and a `def` is the `if` /
;; `else if` chain its arms describe:
;;
;;   var __bound__12 = o;
;;   if (__bound__12 is { Tag: 1, Value: var n }) {
;;       if (n < 0) { return "negative"; }
;;       return "positive";
;;   }
;;   else if (__bound__12 is { Tag: 0 }) { return "none"; }
;;   else { throw new Exception("Match failure at ..."); }
;;
;; The final `else` is unreachable — `Exhaustiveness` has already refused a form
;; whose arms leave a value uncovered — and is emitted for the reason a switch
;; statement's `default:` carries one: C# cannot see that the chain always takes
;; a branch, and without it a `def` in return position is CS0161.
;;
;; Anywhere else a block's value goes to a slot and control jumps past the body.
;; The slot is declared, and the label emitted, in the block the form stands in
;; rather than in one of its own: a `goto` whose label ends up in a sibling
;; block is CS0159. The `default!` is there because a path that falls through
;; without assigning is CS0165 about code no user wrote.
;;
;;   string __ret__20 = default!;
;;   ...
;;   __ret__20 = "small"; goto __ret_end__21;
;;   ...
;;   __ret_end__21: ;

(import (std prelude))

;; Tail position: no slot, no `__ret_end`.
(: classify (-> (Option int) string))
(defun (classify o)
  (with-return ret
    (def (Some n) o :fail ((None "none")))
    (when (< n 0) (ret "negative"))
    "positive"))

;; Not tail position: slot and label.
(: described (-> int string))
(defun (described n)
  (str "n is "
       (with-return ret
         (when (< n 10) (ret "small"))
         "large")))

;; Chained: each `def` holds the rest of the body, so the second is generated
;; inside the first's binding branch and the third inside the second's. Written
;; as a `def*`, which is the same nesting said once.
(: triple (-> (Option int) (Option int) (Option int) string))
(defun (triple a b c)
  (with-return ret
    (def* ((Some x) a (ret "missing"))
          ((Some y) b (ret "missing"))
          ((Some z) c (ret "missing")))
    (int->string (+ x (+ y z)))))

(defun (main)
  (println (classify (Some 1)))
  (println (described 3))
  (println (triple (Some 1) (Some 2) (Some 3)))
  0)
