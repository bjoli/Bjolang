;; A keyword the grammar does not have is reported with what could come.
;; EXPECT-ERROR: expected (port ...), (limit ...) or the end of the list; found (prot ...)
(import (std prelude))
(def/grammar Conn
  (Conn (conn (: host string) (: rest Opts)))
  (Opts (:each (: port (:? (port int))) (: limit (:? (limit int))))))
(defun (main args)
  (def (: c Conn) '(conn "h" (prot 80)))
  0)
