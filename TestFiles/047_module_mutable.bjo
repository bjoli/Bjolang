;; Module-level `def/mutable`: a static field rather than a `static readonly`
;; one, assigned by the module's static constructor in declaration order.
(import "047_lib.bjo")
(import (std prelude))
(import (std simpletest))

(def/mutable counter 0)

;; Declaration order is initialization order, so each of these sees the one
;; above it already assigned. Swept up a kind at a time they would not: a `def`
;; reading a `def/mutable` would have seen the field's zero value instead.
(def/mutable base "start")
(def derived (string-append base "-derived"))
(def/mutable copied derived)

;; A mutable binding is not generalized — a cell that can be assigned has to
;; have a settled type — so this one is pinned down by its uses below.
(def/mutable pending Nil)

(: bump (-> int))
(defun (bump)
  (set! counter (+ counter 1))
  counter)

;; A local mutable is not generalized either, for the same reason.
(: local-cell (-> int))
(defun (local-cell)
  (def/mutable cell Nil)
  (set! cell (Cons 7 (Cons 8 Nil)))
  (list-length cell))

(defun (main args)
  (expect-true "initialized" (= 0 counter))
  (expect-true "written by a function" (= 1 (bump)))
  (expect-true "and again" (= 2 (bump)))
  (expect-true "read back" (= 2 counter))

  (set! counter 100)
  (expect-true "written from outside" (= 100 counter))

  ;; The initializer above ran after `base` was assigned, not before.
  (expect-true "declaration order" (= derived "start-derived"))
  (expect-true "and carries forward" (= copied "start-derived"))

  ;; Reassigning the mutable does not disturb what was derived from it.
  (set! base "changed")
  (expect-true "later assignment is independent" (= derived "start-derived"))
  (expect-true "the mutable itself changed" (= base "changed"))

  (set! pending (Cons 1 (Cons 2 (Cons 3 Nil))))
  (expect-true "monomorphic mutable" (= 3 (list-length pending)))
  (expect-true "local mutable" (= 2 (local-cell)))

  ;; Another module's mutable is that module's single field, not a copy.
  (expect-true "cross-module tick" (= 1 (tick)))
  (expect-true "cross-module tick again" (= 2 (tick)))
  (expect-true "cross-module read" (= 2 reads))
  (reset)
  (expect-true "cross-module write" (= 0 reads))
  0)
