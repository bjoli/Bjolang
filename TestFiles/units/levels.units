; A metavariable bound to a term lowers the term's metavariables to its level.
level ?inner 3
level ?other 3
level ?outer 1
?outer = ?inner^2 m
show-level ?inner
show-level ?other
; The newest metavariable is the one bound.
level ?old 2
level ?new 4
?old = ?new s
show ?new
show-level ?old
; A failure binds nothing and lowers nothing.
level ?a 1
level ?b 5
?a ?a^-1 m = s
show-level ?b
