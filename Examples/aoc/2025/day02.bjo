;; Day 2: Gift Shop. An ID is invalid when its digits are one block repeated:
;; exactly twice in part 1, at least twice in part 2. Sums the invalid IDs.
(import (std scan) "common.bjo")

;; Whether the digits ds are the first k digits repeated.
(: (-> (Vec char) int bool))
(defun (repeats? ds k)
  (all? #(char=? (ref ds &) (ref ds (- & k))) (range k (length ds))))

(: (-> (Vec char) bool))
(defun (twice? ds)
  (def n (length ds))
  (and (= 0 (% n 2)) (repeats? ds (/ n 2))))

(: (-> (Vec char) bool))
(defun (some-repeat? ds)
  (def n (length ds))
  (any? #(and (= 0 (% n &)) (repeats? ds &)) (range 1 (+ (/ n 2) 1))))

(defun (main args)
  (def (part1 part2)
    (loop (:for (lo . hi) (scan (ref (input-lines args) 0) '((long "-" long) ... #:sep "," " ")))
          (:subloop)
          (:for id (up-from lo #:to (+ 1L hi)))
          (:let ds (string->vec (long->string id)))
          (:acc part1 (summing id) #:when (twice? ds))
          (:acc part2 (summing id) #:when (some-repeat? ds))
          => (Tuple part1 part2)))
  (println part1)
  (println part2)
  0)
