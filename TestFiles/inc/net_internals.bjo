;; What a facade stands in front of. Nothing imports this directly.
;;
;; The names are deliberately the ones a library ends up with rather than the
;; ones its callers want to write: a version suffix, and a spelling that says
;; how the thing is implemented rather than what it does.
(export http-get/async+fixed-headers ping/v2)

(: http-get/async+fixed-headers (-> string (#:timeout int) string))
(defun (http-get/async+fixed-headers url #:timeout 30)
  (string-append url (string-append " @" (int->string timeout))))

(: ping/v2 (-> string string))
(defun (ping/v2 host)
  (string-append "pong:" host))
