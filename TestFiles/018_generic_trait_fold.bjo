;; The method is called `fold-col` because a method name may belong to only one
;; trait, and the prelude's `Iterable` already declares `fold`.
(def/trait (Foldable %col)
  (type %item)
  (: fold-col (-> (-> %acc %item %acc) %acc %col %acc)))


(impl (Foldable (List %a))
  (type %item %a)
  (defun (fold-col f acc col)
    (list-foldl f acc col)))

(impl (Foldable (Vec %a))
  (type %item %a)
  (defun (fold-col f acc col)
    (vec-fold f acc col)))

;; Egen liten kontroll. Modulen importerar ingenting med flit, så den kan inte
;; använda `expect` ur (std simpletest); den skriver "ok:"/"FAILURE:" själv.
(: check (-> string bool void))
(defun (check label ok)
  (if ok
      (displayln (string-append "ok: " label))
      (displayln (string-append "FAILURE: " label))))

(defun (main)
  (def lst (Cons 1 (Cons 2 Nil)))
  (def v [1 2 3])
  (def s "test")

  ;; These should compile to generic C# calls, and both results are *used*:
  ;; §8.2's must-use rule wants a dropped value to say so with `ignore`, and
  ;; this module imports nothing on purpose, so it has no `ignore` to say it
  ;; with. Using the answers is the better fix anyway — 3 + 6 - 9 = 0.
  ;;
  ;; Foldable_List<int>.Instance.foldsubcol(...)
  (def from-list (fold-col + 0 lst))

  ;; Foldable_Vec<int>.Instance.foldsubcol(...)
  (def from-vec (fold-col + 0 v))

  ;; Vad de två foldarna faktiskt räknar ut, inte bara att de kompilerar.
  (check "the List impl folds 1 + 2" (= from-list 3))
  (check "the Vec impl folds 1 + 2 + 3" (= from-vec 6))
  (check "the string is still the one that was bound" (= s "test"))

  (- (+ from-list from-vec) 9))
