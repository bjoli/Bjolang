(import (std prelude))
(import (std simpletest))

;; Tail-recursive match: must compile to a switch STATEMENT with `continue`.
(: sum-len (-> (List int) int int))
(defun (sum-len lst acc)
  (match lst
    ((Cons h t) (sum-len t (+ acc h)))
    (Nil acc)))

;; Match nested inside a call: must compile to a C# switch EXPRESSION.
(: describe (-> (List int) string))
(defun (describe lst)
  (int->string
    (match lst
      (Nil 0)
      ((Cons h t) 1))))

;; Literal patterns plus a catch-all binding.
(: classify (-> int string))
(defun (classify n)
  (match n
    (0 "zero")
    (1 "one")
    (x (if (< x 0) "negative" "many"))))

;; Nested constructor patterns.
(: second (-> (List int) int))
(defun (second lst)
  (match lst
    ((Cons a (Cons b rest)) b)
    (_ (- 0 1))))

(defun (main args)
  (def xs (Cons 1 (Cons 2 (Cons 3 Nil))))
  (expect "tail-recursive match visits every element" (sum-len xs 0) 6)
  (expect "match in argument position, Cons arm" (describe xs) "1")
  (expect "match in argument position, Nil arm" (describe Nil) "0")
  (expect "literal pattern 0" (classify 0) "zero")
  (expect "literal pattern 1" (classify 1) "one")
  (expect "catch-all binding, positive" (classify 7) "many")
  (expect "catch-all binding, negative" (classify (- 0 5)) "negative")
  (expect "nested constructor pattern binds the second element" (second xs) 2)
  (expect "nested constructor pattern falls through on Nil" (second Nil) -1)
  0)
