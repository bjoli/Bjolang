;; A `decimal` keeps trailing zeros as scale, but `1.00` and `1.0` are still the same value.

;; EXPECT-ERROR: this clause can never run

(import (std prelude))

(: (-> decimal string))
(defun (f n)
  (match n
    (1.0 "one")
    (1.00 "one again")
    (_ "other")))

(defun (main args)
  (println (f 3))
  0)
