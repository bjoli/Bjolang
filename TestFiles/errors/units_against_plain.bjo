;; A number type without a unit has unit 1.

;; EXPECT-ERROR: (double m)
;; EXPECT-ERROR: Their units differ: m and 1.

(import (std prelude))

(def/dimension length #:base m)
(def/dimension time #:base s)

(: same (-> (double m) (double m)))
(defun (same x) x)

(: bad (-> double (double m)))
(defun (bad x) (same x))

(defun (main) 0)
