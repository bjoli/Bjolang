;; A field's unit can not be a parameter of its record: the parameters of a
;; type are types. The error names the form that works.

;; EXPECT-ERROR: the field 'x' of Vec2 has the type (double %u), and its unit %u is a variable
;; EXPECT-ERROR: write (Vec2 (double m)) where the type is used

(import (std prelude))

(def/dimension length #:base m)

(type (: (Vec2 %u) (Record (: x (double %u)) (: y (double %u)))))

(defun (main) 0)
