;; in such object code or executable form without complying with the source code
;; availability requirements or notice obligations of Section 3 of the MPL 2.0.

;; std/rx.bjo — regular expressions in s-expression notation.
;;
;;     #rx(seq :bos (+ :digit) (lit "-") ($ (** 4 4 :digit)) :eos)
;;
;; `#rx(...)` is read, checked and compiled to a .NET pattern string at compile
;; time; a bad pattern is a compile error pointing at the sub-form that is
;; wrong. What the expansion evaluates is `(rx-compile "<pattern>" "<names>")`.
;;
;; Two spelling rules, and they are what let the reader tell the parts apart
;; without a name table. Anything that takes no argument is a keyword — `:bos`,
;; `:any`, `:digit`. Anything that takes one is a symbol heading a form —
;; `(seq ...)`, `(+ ...)`, `(in ...)`. A string or a character literal is
;; itself: a literal sequence in pattern position, the set of its characters
;; inside `(in ...)`.
;;
;; The matching is `System.Text.RegularExpressions`, under
;; `NonBacktracking | ExplicitCapture | CultureInvariant`, and the pattern this
;; file writes stays inside the subset that mode accepts. That is not only
;; about the linear-time guarantee: the mode refuses backreferences,
;; lookarounds, atomic groups and conditionals, which are the constructs that
;; would tie Bjolang to a backtracking engine for good. Nothing here can emit
;; one, so nothing can come to depend on one.
;;
;; The emitted pattern never contains `.`, `^`, `$`, `\d`, `\w`, `\s` or
;; `\p{...}`. Each of those means something .NET decides — `\d` is every
;; Unicode decimal digit, `$` matches before a trailing newline, `.` matches
;; `\r` but not `\n` — and the Unicode ones move when the runtime's tables are
;; updated. Classes are written out as explicit `\uXXXX` ranges from the tables
;; at the bottom of this file instead, so a compiled program means the same
;; thing on every runtime and the meaning is readable here.
;;
;; The alphabet is the Unicode scalar, as it is for `char` and the string
;; cursors, but .NET's regex engine works in UTF-16 code units. So `:any` and
;; every complemented set are emitted as an alternation that takes a surrogate
;; pair as one unit, and a match boundary can never land inside a pair. See
;; `BjolangRuntime/BjoRegex.cs`, which checks it.

(export
  ;; The types.
  Rx RxMatch

  ;; Matching.
  rx-match rx-match? rx-search rx-search? rx-matches
  rx-replace rx-replace-with rx-split

  ;; Reading a match.
  rx-text rx-input rx-start rx-end
  rx-group rx-group-start rx-group-end rx-group/n rx-group-count

  ;; What `#rx(...)` expands into, and what a test reads back.
  rx-compile rx-pattern)

(import (std prelude))
(import (std syntax-match))

(import/class
  (Rx      (: Bjolang.Runtime.BjoRegex))
  (RxMatch (: Bjolang.Runtime.BjoMatch)))

(import/extern
  (clr-rx-compile   (: Bjolang.Runtime.BjoRegexModule.Compile          (-> string string Rx)))
  (clr-rx-pattern   (: Bjolang.Runtime.BjoRegexModule.Pattern          (-> Rx string)))
  (clr-rx-search    (: Bjolang.Runtime.BjoRegexModule.Search           (-> Rx string (Option RxMatch))))
  (clr-rx-search?   (: Bjolang.Runtime.BjoRegexModule.IsSearchMatch    (-> Rx string bool)))
  (clr-rx-whole     (: Bjolang.Runtime.BjoRegexModule.MatchWhole       (-> Rx string (Option RxMatch))))
  (clr-rx-whole?    (: Bjolang.Runtime.BjoRegexModule.IsWholeMatch     (-> Rx string bool)))
  (clr-rx-matches   (: Bjolang.Runtime.BjoRegexModule.Matches          (-> Rx string (Array RxMatch))))
  (clr-rx-replace   (: Bjolang.Runtime.BjoRegexModule.Replace          (-> Rx string string string)))
  (clr-rx-replace-with
                    (: Bjolang.Runtime.BjoRegexModule.ReplaceWith      (-> Rx string (-> RxMatch string) string)))
  (clr-rx-split     (: Bjolang.Runtime.BjoRegexModule.Split            (-> Rx string (Array string))))
  (clr-rx-text      (: Bjolang.Runtime.BjoRegexModule.Text             (-> RxMatch string)))
  (clr-rx-input     (: Bjolang.Runtime.BjoRegexModule.Input            (-> RxMatch string)))
  (clr-rx-start     (: Bjolang.Runtime.BjoRegexModule.Start            (-> RxMatch StringCursor)))
  (clr-rx-end       (: Bjolang.Runtime.BjoRegexModule.End              (-> RxMatch StringCursor)))
  (clr-rx-count     (: Bjolang.Runtime.BjoRegexModule.Count            (-> RxMatch int)))
  (clr-rx-group-text  (: Bjolang.Runtime.BjoRegexModule.GroupText      (-> RxMatch int (Option string))))
  (clr-rx-group-start (: Bjolang.Runtime.BjoRegexModule.GroupStart     (-> RxMatch int (Option StringCursor))))
  (clr-rx-group-end   (: Bjolang.Runtime.BjoRegexModule.GroupEnd       (-> RxMatch int (Option StringCursor))))
  (clr-rx-index-of    (: Bjolang.Runtime.BjoRegexModule.MatchIndexOfName (-> RxMatch string int))))

;; ---------------------------------------------------------------------------
;; The runtime surface
;; ---------------------------------------------------------------------------
;;
;; Wrappers rather than the `import/extern` aliases directly, because a macro
;; template naming one of these resolves it to this module by the second
;; renaming rule, and there has to be a def of this module to resolve to.

;; Compiles a pattern. `names` is the Bjolang name of each capture group in
;; order, comma-separated — a group `($ ...)` left unnamed contributes an empty
;; one. Commas cannot occur in a keyword, so they cannot occur in a name.
(: rx-compile (-> string string Rx))
(defun (rx-compile pattern names) (clr-rx-compile pattern names))

;; The .NET pattern this was compiled to. Here so a test can assert what was
;; emitted rather than only what it matches.
(: rx-pattern (-> Rx string))
(defun (rx-pattern rx) (clr-rx-pattern rx))

;; The leftmost match anywhere in the string.
(: rx-search (-> Rx string (Option RxMatch)))
(defun (rx-search rx s) (clr-rx-search rx s))

(: rx-search? (-> Rx string bool))
(defun (rx-search? rx s) (clr-rx-search? rx s))

;; The match against the whole string, anchored at both ends.
(: rx-match (-> Rx string (Option RxMatch)))
(defun (rx-match rx s) (clr-rx-whole rx s))

(: rx-match? (-> Rx string bool))
(defun (rx-match? rx s) (clr-rx-whole? rx s))

;; Every non-overlapping match, left to right.
(: rx-matches (-> Rx string (Vec RxMatch)))
(defun (rx-matches rx s) (array->vec (clr-rx-matches rx s)))

;; Every match replaced by `replacement`, which is literal text: there is no
;; `$1` substitution syntax, because that would be a second pattern language
;; arriving without being decided on. Use `rx-replace-with` to build the
;; replacement from the match.
(: rx-replace (-> Rx string string string))
(defun (rx-replace rx s replacement) (clr-rx-replace rx s replacement))

(: rx-replace-with (-> Rx string (-> RxMatch string) string))
(defun (rx-replace-with rx s f) (clr-rx-replace-with rx s f))

;; The pieces between the matches. An empty match is not a separator, so a
;; pattern that can match nothing does not split between every character.
(: rx-split (-> Rx string (Vec string)))
(defun (rx-split rx s) (array->vec (clr-rx-split rx s)))

(: rx-text (-> RxMatch string))
(defun (rx-text m) (clr-rx-text m))

(: rx-input (-> RxMatch string))
(defun (rx-input m) (clr-rx-input m))

(: rx-start (-> RxMatch StringCursor))
(defun (rx-start m) (clr-rx-start m))

(: rx-end (-> RxMatch StringCursor))
(defun (rx-end m) (clr-rx-end m))

(: rx-group-count (-> RxMatch int))
(defun (rx-group-count m) (clr-rx-count m))

;; The text of the group `(=> :name ...)` named, or `None` if that group took
;; no part in the match. An unknown name is `None` as well.
(: rx-group (-> RxMatch Keyword (Option string)))
(defun (rx-group m name) (clr-rx-group-text m (clr-rx-index-of m (keyword->string name))))

(: rx-group-start (-> RxMatch Keyword (Option StringCursor)))
(defun (rx-group-start m name) (clr-rx-group-start m (clr-rx-index-of m (keyword->string name))))

(: rx-group-end (-> RxMatch Keyword (Option StringCursor)))
(defun (rx-group-end m name) (clr-rx-group-end m (clr-rx-index-of m (keyword->string name))))

;; The text of the nth group, counted from zero in the order the groups open.
(: rx-group/n (-> RxMatch int (Option string)))
(defun (rx-group/n m n) (clr-rx-group-text m n))

;; ---------------------------------------------------------------------------
;; Character sets
;; ---------------------------------------------------------------------------
;;
;; A set is a sorted, disjoint list of inclusive BMP ranges, plus whether it
;; holds every astral scalar. The flag is what keeps complement total without
;; the range list having to describe 16 further planes: an astral scalar is a
;; surrogate pair in UTF-16, so it is emitted as an alternation branch rather
;; than as class members, and one branch covers all of them.
;;
;; The range list never contains a surrogate code point. `BjoChar` rejects
;; those, so no set the language can write holds one, and a positive class that
;; excludes them can never match half a pair.

(type
  (: Cset (Record (: ranges (List (Tuple int int)))
                  (: all-astral bool))))

;; U+0000–U+D7FF and U+E000–U+FFFF: the BMP without the surrogate block.
(def bmp-universe (list (Tuple 0 55295) (Tuple 57344 65535)))

(: range-lo (-> (Tuple int int) int))
(defun (range-lo r) (match r ((Tuple lo _) lo)))

(: range-hi (-> (Tuple int int) int))
(defun (range-hi r) (match r ((Tuple _ hi) hi)))

(: imin (-> int int int))
(defun (imin a b) (if (< a b) a b))

(: imax (-> int int int))
(defun (imax a b) (if (> a b) a b))

(: ranges-insert (-> (Tuple int int) (List (Tuple int int)) (List (Tuple int int))))
(defun (ranges-insert r sorted)
  (if (list-empty? sorted)
      (list r)
      (if (<= (range-lo r) (range-lo (list-head sorted)))
          (Cons r sorted)
          (Cons (list-head sorted) (ranges-insert r (list-tail sorted))))))

;; Insertion sort: a set written by hand has a handful of ranges, and a table
;; read out of the hex below is already ascending, so this is the best case
;; either way.
(: ranges-sort (-> (List (Tuple int int)) (List (Tuple int int))))
(defun (ranges-sort rs)
  (match rs
    (Nil Nil)
    ((Cons r more) (ranges-insert r (ranges-sort more)))))

;; Adjacent as well as overlapping runs are merged, so that `[a-b][c-d]` with
;; `c = b + 1` comes out as one range and two sets built differently compare
;; the same.
(: ranges-merge (-> (List (Tuple int int)) (List (Tuple int int))))
(defun (ranges-merge rs)
  (match rs
    (Nil Nil)
    ((Cons r Nil) (list r))
    ((Cons a (Cons b more))
     (if (<= (range-lo b) (+ (range-hi a) 1))
         (ranges-merge (Cons (Tuple (range-lo a) (imax (range-hi a) (range-hi b))) more))
         (Cons a (ranges-merge (Cons b more)))))))

(: ranges-norm (-> (List (Tuple int int)) (List (Tuple int int))))
(defun (ranges-norm rs) (ranges-merge (ranges-sort rs)))

;; The parts of `lo`–`hi` that `rs` does not cover.
(: ranges-gaps (-> int int (List (Tuple int int)) (List (Tuple int int))))
(defun (ranges-gaps lo hi rs)
  (match rs
    (Nil (if (<= lo hi) (list (Tuple lo hi)) Nil))
    ((Cons r more)
     (def before (if (< lo (range-lo r)) (list (Tuple lo (imin hi (- (range-lo r) 1)))) Nil))
     (list-append before (ranges-gaps (imax lo (+ (range-hi r) 1)) hi more)))))

(: ranges-inter (-> (List (Tuple int int)) (List (Tuple int int)) (List (Tuple int int))))
(defun (ranges-inter a b)
  (if (or (list-empty? a) (list-empty? b))
      Nil
      (let ((x (list-head a)) (y (list-head b)))
        (def lo (imax (range-lo x) (range-lo y)))
        (def hi (imin (range-hi x) (range-hi y)))
        (def rest (if (< (range-hi x) (range-hi y))
                      (ranges-inter (list-tail a) b)
                      (ranges-inter a (list-tail b))))
        (if (<= lo hi) (Cons (Tuple lo hi) rest) rest))))

;; Normalizing and clipping to the universe here is what lets every other
;; operation assume both.
(: cs-make (-> (List (Tuple int int)) bool Cset))
(defun (cs-make rs all)
  (Cset (ranges (ranges-inter (ranges-norm rs) bmp-universe)) (all-astral all)))

(: cs-ranges (-> Cset (List (Tuple int int))))
(defun (cs-ranges c) (record-ref c ranges))

(: cs-astral? (-> Cset bool))
(defun (cs-astral? c) (record-ref c all-astral))

(: cs-union (-> Cset Cset Cset))
(defun (cs-union a b)
  (cs-make (list-append (cs-ranges a) (cs-ranges b))
           (or (cs-astral? a) (cs-astral? b))))

(: cs-inter (-> Cset Cset Cset))
(defun (cs-inter a b)
  (cs-make (ranges-inter (cs-ranges a) (cs-ranges b))
           (and (cs-astral? a) (cs-astral? b))))

(: cs-complement (-> Cset Cset))
(defun (cs-complement a)
  (cs-make (ranges-gaps 0 65535 (cs-ranges a)) (not (cs-astral? a))))

(: cs-diff (-> Cset Cset Cset))
(defun (cs-diff a b) (cs-inter a (cs-complement b)))

(: cs-empty? (-> Cset bool))
(defun (cs-empty? c) (and (list-empty? (cs-ranges c)) (not (cs-astral? c))))

(: cs-char (-> int Cset))
(defun (cs-char n) (cs-make (list (Tuple n n)) #f))

;; ---------------------------------------------------------------------------
;; Reading the tables
;; ---------------------------------------------------------------------------
;;
;; A table is one hex string, four digits per endpoint and eight per inclusive
;; range, rather than a list of literal tuples. Six hundred ranges written out
;; as forms is six hundred forms for the compiler to read on every build of
;; this module, and the answer is the same every time.

(: hex-val (-> char int))
(defun (hex-val c)
  (def n (char->int c))
  (cond ((and (>= n 48) (<= n 57)) (- n 48))
        ((and (>= n 65) (<= n 70)) (+ 10 (- n 65)))
        (else 0)))

(: hex4-val (-> char char char char int))
(defun (hex4-val a b c d)
  (+ (* 4096 (hex-val a))
     (+ (* 256 (hex-val b))
        (+ (* 16 (hex-val c)) (hex-val d)))))

(: hex-chunks (-> (List char) (List (Tuple int int))))
(defun (hex-chunks cs)
  (match cs
    ((Cons a (Cons b (Cons c (Cons d (Cons e (Cons f (Cons g (Cons h rest))))))))
     (Cons (Tuple (hex4-val a b c d) (hex4-val e f g h)) (hex-chunks rest)))
    (_ Nil)))

(: hex-ranges (-> string (List (Tuple int int))))
(defun (hex-ranges text) (hex-chunks (string->list text)))

(: table-set (-> string Cset))
(defun (table-set text) (cs-make (hex-ranges text) #f))

;; ---------------------------------------------------------------------------
;; The tree
;; ---------------------------------------------------------------------------

(type
  (: Rxn (Union
           RxEmpty
           (RxLit string)
           (RxSet Cset)
           (RxSeq (List Rxn))
           (RxAlt (List Rxn))
           ;; body, least, most (-1 for unbounded), greedy
           (RxRep Rxn int int bool)
           ;; the name the user gave, "" for `($ ...)`
           (RxGroup string Rxn)
           RxBos
           RxEos)))

;; ---------------------------------------------------------------------------
;; Emitting
;; ---------------------------------------------------------------------------
;;
;; Every `emit` answers a pattern that is one regex atom, so a caller may
;; concatenate or quantify it without asking what it is made of.

(def astral-pair "[\\uD800-\\uDBFF][\\uDC00-\\uDFFF]")

(: hex-digit-string (-> int string))
(defun (hex-digit-string n)
  (def d (% n 16))
  (char->string (if (< d 10) (int->char (+ 48 d)) (int->char (+ 55 d)))))

;; `\uXXXX`, and it is written for every character rather than only the ones
;; that need it. A whitelist of what to escape is a list that can be wrong; a
;; hex escape is right for every scalar, and sidesteps `]`, `^`, `-`, `\` and
;; `RegexOptions.IgnorePatternWhitespace` in one go.
(: unit-escape (-> int string))
(defun (unit-escape n)
  (str "\\u" (hex-digit-string (/ n 4096)) (hex-digit-string (/ n 256))
             (hex-digit-string (/ n 16)) (hex-digit-string n)))

;; A scalar as the UTF-16 units .NET's engine will see.
(: scalar-escape (-> int string))
(defun (scalar-escape n)
  (if (< n 65536)
      (unit-escape n)
      (let ((v (- n 65536)))
        (str (unit-escape (+ 55296 (/ v 1024)))
             (unit-escape (+ 56320 (% v 1024)))))))

(: concat-strings (-> (List string) string))
(defun (concat-strings parts) (list-foldl string-append "" parts))

(: join-strings (-> (List string) string string))
(defun (join-strings parts sep)
  (match parts
    (Nil "")
    ((Cons p Nil) p)
    ((Cons p more) (str p sep (join-strings more sep)))))

(: class-body (-> (List (Tuple int int)) string))
(defun (class-body rs)
  (concat-strings
    (list-map (fun (r)
                (if (= (range-lo r) (range-hi r))
                    (unit-escape (range-lo r))
                    (str (unit-escape (range-lo r)) "-" (unit-escape (range-hi r)))))
              rs)))

(: emit-set (-> Cset string))
(defun (emit-set c)
  (cond
    ((list-empty? (cs-ranges c)) (str "(?:" astral-pair ")"))
    ((cs-astral? c) (str "(?:" astral-pair "|[" (class-body (cs-ranges c)) "])"))
    (else (str "[" (class-body (cs-ranges c)) "]"))))

(: emit-lit (-> string string))
(defun (emit-lit text)
  (def scalars (string->list text))
  (def body (concat-strings (list-map (fun (c) (scalar-escape (char->int c))) scalars)))
  ;; One BMP scalar is already an atom. Anything else — nothing, a pair, or
  ;; several characters — has to be grouped before it can be quantified.
  (if (and (= (list-length scalars) 1) (< (char->int (list-head scalars)) 65536))
      body
      (str "(?:" body ")")))

(: rep-suffix (-> int int bool string))
(defun (rep-suffix least most greedy)
  (def core
    (cond
      ((and (= least 0) (= most -1)) "*")
      ((and (= least 1) (= most -1)) "+")
      ((and (= least 0) (= most 1)) "?")
      ((= most -1) (str "{" (int->string least) ",}"))
      ((= least most) (str "{" (int->string least) "}"))
      (else (str "{" (int->string least) "," (int->string most) "}"))))
  (if greedy core (str core "?")))

;; `names` accumulates the Bjolang name of each group, most recent first. A
;; group's number is how many were open before it, so the count is read before
;; the body is walked and nested groups number after their parent — which is
;; the order .NET numbers them in too.
(: emit (-> Rxn (Box (List string)) string))
(defun (emit node names)
  (match node
    (RxEmpty "(?:)")
    ((RxLit text) (emit-lit text))
    ((RxSet c) (emit-set c))
    ((RxSeq parts)
     (match parts
       (Nil "(?:)")
       ((Cons p Nil) (emit p names))
       (_ (str "(?:" (concat-strings (list-map (fun (p) (emit p names)) parts)) ")"))))
    ((RxAlt parts)
     (match parts
       (Nil "(?:)")
       ((Cons p Nil) (emit p names))
       (_ (str "(?:" (join-strings (list-map (fun (p) (emit p names)) parts) "|") ")"))))
    ((RxRep body least most greedy)
     (str "(?:" (emit body names) (rep-suffix least most greedy) ")"))
    ((RxGroup name body)
     (def n (list-length (box-ref names)))
     (box-set! names (Cons name (box-ref names)))
     (str "(?<g" (int->string n) ">" (emit body names) ")"))
    (RxBos "\\A")
    (RxEos "\\z")))

;; ---------------------------------------------------------------------------
;; Reading a set
;; ---------------------------------------------------------------------------

(: head-name (-> Syntax (Option string)))
(defun (head-name form)
  (match form
    ((SList items)
     (if (list-empty? items)
         None
         (match (list-head items)
           ((SSym s) (Some (symbol->string s)))
           (_ None))))
    (_ None)))

(: form-args (-> Syntax (List Syntax)))
(defun (form-args form)
  (match form
    ((SList items) (if (list-empty? items) Nil (list-tail items)))
    (_ Nil)))

;; A character usable as a set member or a range endpoint. Astral scalars are
;; refused here and only here: .NET's classes are written in UTF-16 units and
;; have no way to name a scalar above U+FFFF, so a range that crossed the
;; boundary could not be emitted at all.
(: set-scalar (-> Syntax char int))
(defun (set-scalar form c)
  (def n (char->int c))
  (if (> n 65535)
      (ignore-int
        (syntax-error form
          (str "A character set is limited to U+0000..U+FFFF, and "
               (char->string c) " is above it. Match it with (lit \"" (char->string c)
               "\") instead.")))
      n))

;; `syntax-error` types as a `Syntax` and never returns, so a branch that owes
;; an `int` has to discard it.
(: ignore-int (-> Syntax int))
(defun (ignore-int s) (ignore s) 0)

(: ignore-cset (-> Syntax Cset))
(defun (ignore-cset s) (ignore s) (cs-make Nil #f))

(: chars-of (-> Syntax (List Syntax) (List int)))
(defun (chars-of whole items)
  (match items
    (Nil Nil)
    ((Cons item more)
     (list-append
       (match item
         ((SChar c) (list (set-scalar item c)))
         ((SStr text) (list-map (fun (c) (set-scalar item c)) (string->list text)))
         (_ (list (ignore-int
                    (syntax-error item
                      "A range endpoint is a character or a string of them: (/ #\\a #\\z) or (/ \"az\").")))))
       (chars-of whole more)))))

;; `(/ #\a #\z #\0 #\9)` and `(/ "az09")` are the same set: the endpoints are
;; taken in pairs however they were written.
(: pairs->cset (-> Syntax (List int) Cset))
(defun (pairs->cset whole ns)
  (match ns
    (Nil (cs-make Nil #f))
    ((Cons lo (Cons hi more))
     (if (> lo hi)
         (ignore-cset
           (syntax-error whole "A range runs upwards, and this one does not."))
         (cs-union (cs-make (list (Tuple lo hi)) #f) (pairs->cset whole more))))
    (_ (ignore-cset
         (syntax-error whole "A range takes its endpoints in pairs, and this one has an odd number.")))))

(: union-of (-> (List Syntax) Cset))
(defun (union-of items)
  (list-foldl (fun (acc item) (cs-union acc (parse-set item))) (cs-make Nil #f) items))

(: parse-set (-> Syntax Cset))
(defun (parse-set form)
  (match form
    ((SChar c) (cs-char (set-scalar form c)))
    ((SStr text) (list-foldl (fun (acc c) (cs-union acc (cs-char (set-scalar form c))))
                             (cs-make Nil #f)
                             (string->list text)))
    ((SKey k)
     (match (named-class (keyword->string k))
       ((Some c) c)
       (None (ignore-cset
               (syntax-error form (str "There is no character set called "
                                       (keyword->string k) "."))))))
    ((SList _) (parse-set-form form))
    (_ (ignore-cset
         (syntax-error form
           "A character set is a character, a string, a named set like :digit, or a form like (in ...), (/ ...), (~ ...), (- ...) or (& ...).")))))

(: parse-set-form (-> Syntax Cset))
(defun (parse-set-form form)
  (def args (form-args form))
  (match (head-name form)
    (None (ignore-cset (syntax-error form "A character set form is headed by a name.")))
    ((Some name)
     (cond
       ((= name "in") (union-of args))
       ((= name "or") (union-of args))
       ((= name "/") (pairs->cset form (chars-of form args)))
       ((= name "~") (cs-complement (union-of args)))
       ((= name "-") (set-difference form args))
       ((= name "&") (set-intersection form args))
       (else (ignore-cset
               (syntax-error form
                 (str "'" name "' is not a character set operation. Use (in ...), (/ ...), (~ ...), (- ...) or (& ...)."))))))))

(: set-difference (-> Syntax (List Syntax) Cset))
(defun (set-difference form args)
  (if (list-empty? args)
      (ignore-cset (syntax-error form "(- ...) takes a set to subtract from."))
      (cs-diff (parse-set (list-head args)) (union-of (list-tail args)))))

(: set-intersection (-> Syntax (List Syntax) Cset))
(defun (set-intersection form args)
  (if (list-empty? args)
      (ignore-cset (syntax-error form "(& ...) takes at least one set."))
      (list-foldl (fun (acc item) (cs-inter acc (parse-set item)))
                  (parse-set (list-head args))
                  (list-tail args))))

;; A set reaching pattern position has to be able to match something, and an
;; empty one is a mistake that would otherwise be an unreadable .NET error
;; about an empty character class.
(: set-node (-> Syntax Cset Rxn))
(defun (set-node form c)
  (if (cs-empty? c)
      (ignore-node (syntax-error form "This character set is empty, so it can never match."))
      (RxSet c)))

(: ignore-node (-> Syntax Rxn))
(defun (ignore-node s) (ignore s) RxEmpty)

;; ---------------------------------------------------------------------------
;; Reading a pattern
;; ---------------------------------------------------------------------------

(: parse (-> Syntax Rxn))
(defun (parse form)
  (match form
    ((SStr text) (RxLit text))
    ((SChar c) (RxLit (char->string c)))
    ((SKey k) (parse-atom form (keyword->string k)))
    ((SList _) (parse-form form))
    ((SSym s)
     (ignore-node
       (syntax-error form
         (str "'" (symbol->string s) "' is a symbol, and an rx that takes no argument is a keyword. Did you mean :"
              (symbol->string s) "?"))))
    ((SPunct _)
     (ignore-node
       (syntax-error form
         "An rx is built at compile time, so it cannot splice a value in. Dynamically built patterns are not supported.")))
    (_ (ignore-node (syntax-error form "This is not an rx.")))))

(: parse-atom (-> Syntax string Rxn))
(defun (parse-atom form name)
  (cond
    ((= name "bos") RxBos)
    ((= name "eos") RxEos)
    (else
      (match (named-class name)
        ((Some c) (set-node form c))
        (None
          (ignore-node
            (syntax-error form
              (str "There is no rx called :" name
                   ". The ones taking no argument are :bos :eos :any :nonl and the named sets."))))))))

(: parse-all (-> (List Syntax) (List Rxn)))
(defun (parse-all items) (list-map parse items))

(: parse-form (-> Syntax Rxn))
(defun (parse-form form)
  (def args (form-args form))
  (match (head-name form)
    (None
     (ignore-node
       (syntax-error form
         "An rx form is headed by a name: (seq ...), (or ...), (+ ...), (in ...) and so on.")))
    ((Some name)
     (cond
       ((= name "seq") (RxSeq (parse-all args)))
       ((= name "or") (RxAlt (parse-all args)))
       ((= name "lit") (RxLit (literal-text form args)))
       ((= name "*") (RxRep (one-arg form args) 0 -1 #t))
       ((= name "+") (RxRep (one-arg form args) 1 -1 #t))
       ((= name "?") (RxRep (one-arg form args) 0 1 #t))
       ((= name "*?") (RxRep (one-arg form args) 0 -1 #f))
       ((= name "+?") (RxRep (one-arg form args) 1 -1 #f))
       ((= name "??") (RxRep (one-arg form args) 0 1 #f))
       ((= name "**") (bounded form args))
       ((= name "=") (exactly form args))
       ((= name ">=") (at-least form args))
       ((= name "$") (RxGroup "" (RxSeq (parse-all args))))
       ((= name "=>") (named-group form args))
       ((= name "in") (set-node form (union-of args)))
       ((= name "/") (set-node form (pairs->cset form (chars-of form args))))
       ((= name "~") (set-node form (cs-complement (union-of args))))
       ((= name "-") (set-node form (set-difference form args)))
       ((= name "&") (set-node form (set-intersection form args)))
       (else
         (ignore-node
           (syntax-error form
             (str "'" name "' is not an rx form. If you meant a set or an anchor, those are keywords: :"
                  name "."))))))))

(: one-arg (-> Syntax (List Syntax) Rxn))
(defun (one-arg form args)
  (match args
    ((Cons a Nil) (parse a))
    (_ (RxSeq (parse-all args)))))

(: literal-text (-> Syntax (List Syntax) string))
(defun (literal-text form args)
  (match args
    ((Cons a Nil)
     (match a
       ((SStr text) text)
       ((SChar c) (char->string c))
       (_ (ignore-string (syntax-error form "(lit ...) takes one string.")))))
    (_ (ignore-string (syntax-error form "(lit ...) takes one string.")))))

(: ignore-string (-> Syntax string))
(defun (ignore-string s) (ignore s) "")

(: count-of (-> Syntax Syntax int))
(defun (count-of whole s)
  (match s
    ((SInt text) (string->int text))
    (_ (ignore-int (syntax-error whole "A repetition count is a whole number.")))))

(: bounded (-> Syntax (List Syntax) Rxn))
(defun (bounded form args)
  (match args
    ((Cons lo (Cons hi rest))
     (RxRep (one-arg form rest) (count-of form lo) (count-of form hi) #t))
    (_ (ignore-node (syntax-error form "(** least most rx) takes two counts and a pattern.")))))

(: exactly (-> Syntax (List Syntax) Rxn))
(defun (exactly form args)
  (match args
    ((Cons n rest) (let ((k (count-of form n))) (RxRep (one-arg form rest) k k #t)))
    (_ (ignore-node (syntax-error form "(= n rx) takes a count and a pattern.")))))

(: at-least (-> Syntax (List Syntax) Rxn))
(defun (at-least form args)
  (match args
    ((Cons n rest) (RxRep (one-arg form rest) (count-of form n) -1 #t))
    (_ (ignore-node (syntax-error form "(>= n rx) takes a count and a pattern.")))))

;; The name is a keyword for the same reason every other constant of this
;; sublanguage is one: it is a name used as data, not a binding, and a keyword
;; can never be mistaken for one.
(: named-group (-> Syntax (List Syntax) Rxn))
(defun (named-group form args)
  (match args
    ((Cons n rest)
     (match n
       ((SKey k) (RxGroup (keyword->string k) (RxSeq (parse-all rest))))
       (_ (ignore-node
            (syntax-error form "(=> :name rx) names its group with a keyword.")))))
    (_ (ignore-node (syntax-error form "(=> :name rx) takes a name and a pattern.")))))

;; ---------------------------------------------------------------------------
;; The macros
;; ---------------------------------------------------------------------------

(: names-text (-> (List string) string))
(defun (names-text names) (join-strings names ","))

;; `#rx(seq a b)` reads as `(#rx seq a b)`, so the arguments are the form's own
;; contents. One argument is the form itself, which is what makes `#rx(:digit)`
;; and `#rx((+ :digit))` work as well as `#rx(+ :digit)`.
(: rx-expansion (-> Syntax Syntax))
(defun (rx-expansion form)
  (def node (parse form))
  (def names (make-box Nil))
  (def pattern (emit node names))
  #'(rx-compile ,(SStr pattern) ,(SStr (names-text (list-reverse (box-ref names))))))

(def/hash-extend (rx form inject compare)
  (match (form-args form)
    (Nil (syntax-error form "#rx takes a pattern: #rx(seq :bos (+ :digit) :eos)."))
    ((Cons only Nil) (rx-expansion only))
    (items (rx-expansion (SList items)))))

;; `(Rx re p)` matches `re` against the whole string, `(RxIn re p)` searches for
;; it. Both hand the inner pattern an `(Option RxMatch)`, so a clause reads
;; `(Rx phone (Some m))`.
;;
;; A view covers nothing for exhaustiveness, so a `match` using either still
;; needs a clause that matches anything.
(def/pattern (Rx form inject compare)
  (syntax-match form
    ((_ re p) #'(:view (rx-match ,re &) ,p))
    (bad (syntax-error bad "(Rx regex pattern) matches regex against the whole string."))))

(def/pattern (RxIn form inject compare)
  (syntax-match form
    ((_ re p) #'(:view (rx-search ,re &) ,p))
    (bad (syntax-error bad "(RxIn regex pattern) searches the string for regex."))))

