;; An `Ord` implementation for an `import/class` alias.
;;
;; The orphan rule refuses it: a .NET type is declared by no module, so only
;; the module that declares `Ord` may implement it. It would also answer
;; `compare` while the ordered collections ask the type itself. The way out is
;; a wrapper type. (`std/clr-ord` keeps its impls: the standard library is
;; excepted from the rule.)

;; EXPECT-ERROR: is a .NET type, so 'Ord' cannot be implemented for it
;; EXPECT-ERROR: wrapper type

(import (std prelude))

(import/class
  (Uri (: System.Uri)))

(impl (Ord Uri)
  (defun (compare a b) 0))

(defun (main args) 0)
