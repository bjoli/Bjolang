;; The outer constructor is covered and the inner one is not, so the
;; counterexample has to name both.

;; EXPECT-ERROR: does not cover every value
;; EXPECT-ERROR: (Ok None) reaches no clause

(import (std prelude))

(: describe (-> (Result string (Option int)) string))
(defun (describe r)
  (match r
    ((Ok (Some n)) (->str n))
    ((Err e) e)))

(defun (main args)
  (println (describe (Err "x")))
  0)
