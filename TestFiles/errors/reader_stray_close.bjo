;; A closing bracket with nothing open.
;;
;; At the top level one used to end the file: the reader stopped there, and
;; every form after it was silently not compiled. Here that would have hidden
;; the unbound name below, and the program would have built.
;;
;; EXPECT-ERROR: reader_stray_close.bjo:9: this ')' closes nothing

(defun (main) 0))

(def unreachable no-such-name)
