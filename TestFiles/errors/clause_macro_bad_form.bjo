;; A clause macro's transformer refuses a form with `syntax-error`, reported at
;; the :for clause that called it.
;;
;; EXPECT-ERROR: The clause macro 'in-evens' failed
;; EXPECT-ERROR: (:for x (in-evens seq))

(import "../inc/clause_macros.bjo")

(defun (main args)
  (println (int->string {summing x (:for x (in-evens [1 2] [3]))}))
  0)
