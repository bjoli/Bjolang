;; Names whose C# spelling needed a second look, published to 280_csharp_names.bjo.
(export Main stringsubsearch smörgås 😀)

(: (-> int))
(defun (Main) 1)

;; `string-search` is `stringsubsearch` in C#.
(: (-> int int))
(defun (stringsubsearch x) (+ x 1))

(: (-> int))
(defun (smörgås) 3)

(: (-> int))
(defun (😀) 4)
