;; The handler of a #:event import is a function of the event's arguments.
;; EXPECT-ERROR: the handler of the event 'System.ComponentModel.Component.Disposed' is to be a function of the event's arguments
(import (std prelude))
(import/class
  (Component (: System.ComponentModel.Component (-> Component))))
(import/extern
  (on-disposed! (: System.ComponentModel.Component.Disposed #:event)))

(defun (main)
  (ignore (on-disposed! (Component.) (fun (x) (+ x 1))))
  0)
