;; `set` copies along the path with `record-set`, which cannot copy a .NET
;; object, so a `.-Property` step is refused rather than left to fail inside
;; the expansion.
;; EXPECT-ERROR: .-Length is a .NET property
(import (std prelude))

(type (: Named (Record (: name string))))

(defun (main)
  (def n (Named (name "plum")))
  (ignore (set n .name .-Length 0))
  0)
