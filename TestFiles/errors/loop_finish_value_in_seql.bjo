;; A `seql` has no result, so `:finish` there takes no value.

;; EXPECT-ERROR: (:finish test value)
;; EXPECT-ERROR: has no meaning in a (seql ...)

(import (std prelude))

(: f (-> (Seq int)))
(defun (f)
  (seql (:for x (range 0 10))
        (:finish (> x 2) 7)
        (:yield x)))

(defun (main) (println (int->string (seq-length (f)))) 0)
