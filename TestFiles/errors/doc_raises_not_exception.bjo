;; (raises ...) names an exception type.

;; EXPECT-ERROR: names a type that does not derive from System.Exception

(import (std prelude))

(:doc twice (summary "Doubles.") (arg x "The number.") (returns "Twice x.") (raises System.String "Never."))
(: twice (-> int int))
(defun (twice x) (* 2 x))

(defun (main args) 0)
