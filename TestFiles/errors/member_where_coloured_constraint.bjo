;; A member constrained over a trait whose method suspends.
;;
;; The colour decision, made rather than left: a call through the constraint
;; would be a yield point the member's own arrow never declares, so the wrong
;; program is an error instead of a silent suspension.

;; EXPECT-ERROR: declares 'fetch' with -bjo->

(import (std prelude))

(def/trait (Fetch %f)
  (: fetch (-bjo-> %f int)))

(def/trait (Gather %c)
  (: gather (-> %c %s int)
     (where (Fetch %s))))

(defun (main) 0)
