;; For 545_impl_without_trait.bjo and 546_impl_trait_imported_after.bjo. A
;; trait whose implementation for `Crate` is in `pending_type.bjo`, the
;; module of the type.

(export Weigh weigh weigh-both)
(import (std prelude))

(def/trait (Weigh %a)
  (: weigh (-> %a int)))

(impl (Weigh int)
  (defun (weigh x) x))

(: (-> %a %a int) (where (Weigh %a)))
(defun (weigh-both x y) (+ (weigh x) (weigh y)))
