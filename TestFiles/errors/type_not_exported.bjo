;; A library exporting a binding whose type it did not export.
;;
;; Refused where the library is built, not where it is used. That is the point
;; of checking it: the alternative is an unresolvable token in somebody else's
;; signature, failing in the importing module at a call whose author never saw
;; the type.

;; EXPECT-ERROR: names the type 'Crate'
;; EXPECT-ERROR: declares and does not export
;; EXPECT-ERROR: #:opaque

(import "../srcimport/leaky.bjo")

(defun (main args)
  (println (->str (make-crate 1)))
  0)
