(import (std prelude))
(defun (main args)
  ;; Casts
  (def byte-val (cast byte 255))
  (def double-val (cast double 3))
  (def long-val (cast long -100))

  ;; Conversions -> string
  (displayln (byte->string byte-val))
  (displayln (double->string double-val))
  (displayln (long->string long-val))

  ;; Conversions string -> 
  (def parsed-int (string->int "42"))
  (def parsed-double (string->double "3.14159"))

  (displayln (int->string parsed-int))
  (displayln (double->string parsed-double))
  
  0)
