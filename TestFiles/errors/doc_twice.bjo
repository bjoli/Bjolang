;; One doc per name.

;; EXPECT-ERROR: (:doc twice) is a second doc of the same thing

(import (std prelude))

(:doc twice (summary "Doubles.") (arg x "The number.") (returns "Twice x."))
(:doc twice (summary "Doubles again.") (arg x "The number.") (returns "Twice x."))
(: twice (-> int int))
(defun (twice x) (* 2 x))

(defun (main args) 0)
