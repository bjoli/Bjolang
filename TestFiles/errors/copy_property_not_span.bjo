;; #:copy on a property that is not a span.
;; EXPECT-ERROR: is imported #:copy, but its type is int, not a span
(import (std prelude))

(import/class
  (Encoding (: System.Text.Encoding)))

(import/extern
  (utf8 (: System.Text.Encoding.UTF8 #:get))
  (code-page (: System.Text.Encoding.CodePage (-> Encoding int) #:get #:copy)))

(defun (main)
  (println (code-page utf8))
  0)
