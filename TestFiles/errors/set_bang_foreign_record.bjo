;; `set!` writes a field at the end of a path with `record-set!`, under the same
;; rule: only the module that declared the record may write its fields. The
;; write is the user's, at the step, not the prelude's, where `#set!` is.

;; EXPECT-ERROR: was declared in another module
;; EXPECT-ERROR: may not write its fields

(import (std prelude))
(import "../inc/cell.bjo")

(defun (main args)
  (def c (cell 1))
  (set! c .held 2)
  0)
