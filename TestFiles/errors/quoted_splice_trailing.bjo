;; `,@` with nothing after it.
;;
;; The same shape of mistake as a trailing `,`, and reported the same way: the
;; marker takes the form that follows it, and at the end of a list there is
;; none.

;; EXPECT-ERROR: Unexpected ,@ at end of a quoted list

(import (std prelude))

(defun (main args)
  (def (: xs (List int)) (list 1 2))
  (def (: bad (List int)) '(0 ,@))
  (println (int->string (list-length bad)))
  0)
