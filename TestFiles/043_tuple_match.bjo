(import (std prelude))
(import (std simpletest))

(def (top-a . top-b) (10 . 20))

(: test-match-dot (-> (int . int) int))
(defun (test-match-dot pair)
  (match pair
    ((a . b) (+ a b))))

(: test-match-tuple (-> (Tuple int int) int))
(defun (test-match-tuple pair)
  (match pair
    ((Tuple a b) (* a b))))

(: test-match-literal (-> (int . string) string))
(defun (test-match-literal pair)
  (match pair
    ((1 . "one") "matched literal 1")
    ((2 . s) (string-append "matched 2 and " s))
    ((_ . _) "other")))

(: test-match-nested (-> (int . (int . int)) int))
(defun (test-match-nested triplet)
  (match triplet
    ((a . (b . c)) (+ a (+ b c)))))

;; A tuple pattern of names and wildcards cannot fail — a tuple has one shape —
;; so the match is exhaustive and must emit no fallback arm. C# proves the same
;; thing and rejects one it can reach no way (CS8510), which is what makes this
;; worth a test rather than a nicety.
(: pair (-> (Tuple int int)))
(defun (pair) (Tuple 3 4))

;; The arm needs a statement, so this compiles as a switch *statement*, where an
;; unreachable `default` is legal and still wanted for definite assignment.
(: exhaustive-with-statements (-> int))
(defun (exhaustive-with-statements)
  (match (pair)
    ((Tuple a b)
     (def doubled (* a 2))
     (+ doubled b))))

;; A guard makes even a tuple clause refutable, so the second arm is live.
(: guarded-tuple (-> int))
(defun (guarded-tuple)
  (match (pair)
    ((Tuple a b) #:when (> a 10) (+ a b))
    ((Tuple a b) (- b a))))

(defun (main args)
  ;; Top level def with dotted pair
  (expect "top-level dotted def, car" top-a 10)
  (expect "top-level dotted def, cdr" top-b 20)

  ;; Match with dotted pair
  (expect "match with dotted pair" (test-match-dot (5 . 7)) 12)

  ;; Match with (Tuple a b)
  (expect "match with (Tuple a b)" (test-match-tuple (Tuple 3 4)) 12)

  ;; Match literals / guards / fallthrough
  (expect "both components literal" (test-match-literal (1 . "one")) "matched literal 1")
  (expect "literal car, bound cdr" (test-match-literal (2 . "two")) "matched 2 and two")
  (expect "fallthrough to the wildcard pair" (test-match-literal (3 . "three")) "other")

  ;; Match nested tuples
  (expect "nested dotted pattern" (test-match-nested (10 . (20 . 30))) 60)

  ;; Exhaustive tuple matches, in argument position so they really are C#
  ;; switch *expressions* — the shape that rejects an unreachable arm.
  (expect "irrefutable tuple arm, both bound" (match (pair) ((Tuple a b) (+ a b))) 7)
  (expect "irrefutable tuple arm with a wildcard" (match (pair) ((Tuple a _) a)) 3)
  (expect "nested Tuple pattern"
          (match (Tuple 1 (Tuple 2 3)) ((Tuple a (Tuple b c)) (+ a (+ b c))))
          6)
  ;; The clause after an irrefutable one is dead and is dropped.
  (expect "the dead clause is never taken" (match (pair) ((Tuple a b) (+ a b)) (_ 999)) 7)
  (expect "tuple match as a switch statement" (exhaustive-with-statements) 10)
  ;; Vakten faller (3 > 10 är falskt), så andra armen ger (- 4 3).
  (expect "a guard makes the second tuple arm live" (guarded-tuple) 1)

  ;; Local def with dotted pair
  (def (local-x . local-y) (50 . 60))
  (expect "local dotted def" (+ local-x local-y) 110)

  ;; Let with dotted pair
  (def result-let
    (let (((lx . ly) (100 . 200)))
      (+ lx ly)))
  (expect "let with a dotted pattern" result-let 300)

  ;; Backwards compatibility with (a b)
  (def (compat-a compat-b) (7 . 8))
  (expect "the (a b) spelling still destructures a dotted pair" (+ compat-a compat-b) 15)

  (def result-compat-let
    (let (((cl-a cl-b) (Tuple 30 40)))
      (+ cl-a cl-b)))
  (expect "the (a b) spelling in a let" result-compat-let 70)

  0)
