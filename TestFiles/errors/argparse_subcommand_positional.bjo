;; def/cmdline: a subcommand beside positional fields.
;;
;; EXPECT-ERROR: has no positional fields

(import (std prelude))
(import (std argparse))

(def/cmdline (: B (Record (: x bool))))
(def/cmdline-commands (: C (Union (: Go B))))
(def/cmdline (: O (Record (: file string #:positional)
                          (: c C #:subcommand))))

(defun (main args) 0)
