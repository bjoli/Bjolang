;; EXPECT-ERROR: 'b' is used before its definition

;; An impl method's definitions follow the rule a defun's do.

(import (std prelude))

(def/trait (Speak %a)
  (: speak (-> %a int)))

(type (: Dog (Record (: n int))))

(impl (Speak Dog)
  (defun (speak d)
    (def a (+ b 1))
    (def b (.n d))
    a))

(defun (main args)
  (println (->str (speak (Dog (n 41)))))
  0)
