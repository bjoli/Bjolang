;; Out imports exported from a library. What crosses is the import clause, with
;; its `(out T)` parameters back in place, and the importing module resolves it
;; again and emits the call itself.
(export lib-dict-try-get lib-div-rem lib-parse-int lib-kv-parts)

(import/class
  ((Dict %k %v) (: System.Collections.Generic.Dictionary))
  ((KeyValuePair %k %v) (: System.Collections.Generic.KeyValuePair)))

(import/extern
  (lib-parse-int (: System.Int32.TryParse (-> string (out int) (Option int))))
  (lib-dict-try-get (: System.Collections.Generic.Dictionary.TryGetValue
                       (-> (Dict %k %v) %k (out %v) (Option %v))))
  (lib-div-rem (: System.Math.DivRem (-> int int (out int) (Tuple int int))))
  (lib-kv-parts (: System.Collections.Generic.KeyValuePair.Deconstruct
                   (-> (KeyValuePair %k %v) (out %k) (out %v) (Tuple %k %v)))))
