;; A clause below an irrefutable one. Nothing reaches it, and the compiler used
;; to drop it silently.

;; EXPECT-ERROR: this clause can never run

(import (std prelude))

(: (-> (Option int) string))
(defun (describe o)
  (match o
    (_ "anything")
    ((Some n) (displayed n))))

(defun (main args)
  (println (describe None))
  0)
