;; An error in a step is reported where that step is written, not at the start
;; of the whole form.
;; EXPECT-ERROR: path_step_position.bjo:16
(import (std prelude))

(type (: Inner (Record (: count int))))
(type (: Outer (Record (: inner Inner))))

(: outer (-> Outer))
(defun (outer) (Outer (inner (Inner (count 1)))))

(defun (main)
  (println
    (->str
      (get (outer) .inner
           .colour)))
  0)
