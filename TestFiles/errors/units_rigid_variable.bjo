;; A unit variable of a signature is rigid in the body: %u is not m.

;; EXPECT-ERROR: Their units differ: m and %u.

(import (std prelude))

(: same (-> (units double m^1) (units double m^1)))
(defun (same x) x)

(: bad (-> (units double %u^1) (units double %u^1)))
(defun (bad x) (same x))

(defun (main) 0)
