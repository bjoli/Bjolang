;; A re-export carries a union's cases, and an `#:opaque` union's stay its
;; declaring module's.
;;
;; `Sealed` is declared `#:opaque` in `inc/reexport_origin.bjo` and re-exported
;; by `inc/reexport_facade.bjo`. The facade passes the declaration on as the
;; origin wrote it, and it is registered here as the origin's, so the code that
;; may take one apart is still `reexport_origin`'s and not the facade's.

;; EXPECT-ERROR: reexport_origin/Sealed, which cannot be taken apart here
;; EXPECT-ERROR: visible only to the code of reexport_origin

(import (std prelude))
(import "../inc/reexport_facade.bjo")

(: peek (-> Sealed int))
(defun (peek s)
  (match s
    ((Locked n) n)
    (Open 0)))

(defun (main args) 0)
