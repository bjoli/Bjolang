;; As 525, with the trait's own module imported too: one trait, so the
;; facade's implementation is the one a function of (std parallel) finds.
(import (std prelude))
(import (std simpletest))
(import "inc/stdtrait_facade.bjo")
(import (std parallel))

(defun (main)
  (expect "a method of the trait, at the facade's type" (chunk-size (span5 7)) 7)
  (expect "in-parts runs a part for each of the facade's parts"
          (in-parts (span5 12) (fun (r) (count r)))
          [5 5 2])
  0)
