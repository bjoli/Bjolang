;; A loose `:when` written among the clauses.
;;
;; The loose `:when` gates the accumulation and the parenthesized one skips the
;; iteration — two different things. Written side by side among the clauses they
;; differ by a pair of parentheses and nothing else, which is not enough to read.
;;
;; So the loose one is written where it belongs, with the accumulator it guards,
;; and among the clauses it is an error naming where it goes.

;; EXPECT-ERROR: must be written (:when ...) here
;; EXPECT-ERROR: goes before the first clause

(import (std prelude))

(defun (main args)
  (println (int->string {counting a (:for a (range 0 10)) :when (= 0 (% a 2))}))
  0)
