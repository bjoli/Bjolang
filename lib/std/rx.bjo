;; ---------------------------------------------------------------------------
;; The named sets
;; ---------------------------------------------------------------------------

(def cs-alpha   (table-set tbl-alpha))
(def cs-digit   (table-set tbl-digit))
(def cs-alnum   (table-set tbl-alnum))
(def cs-upper   (table-set tbl-upper))
(def cs-lower   (table-set tbl-lower))
(def cs-space   (table-set tbl-space))
(def cs-word    (table-set tbl-word))
(def cs-control (table-set tbl-control))

(def cs-ascii     (cs-make (list (Tuple 0 127)) #f))
(def cs-hex-digit (cs-make (list (Tuple 48 57) (Tuple 65 70) (Tuple 97 102)) #f))

;; `:digit` is every Unicode decimal digit, which is what `numeric` means in
;; SRE and what `char-numeric?` answers. A program that wants the ten ASCII
;; ones usually means exactly that, so the narrowing has a name of its own
;; rather than being spelled `(& :digit :ascii)` at every use.
(def cs-ascii-digit (cs-inter cs-digit cs-ascii))
(def cs-ascii-alpha (cs-inter cs-alpha cs-ascii))
(def cs-ascii-alnum (cs-inter cs-alnum cs-ascii))

;; One scalar, whatever it is. `:nonl` is the same set without U+000A, which is
;; the only character either of them treats as a line break: the emitted
;; pattern never uses `.`, so .NET's rule that `.` matches `\r` does not apply.
(def cs-any  (cs-make bmp-universe #t))
(def cs-nonl (cs-make (ranges-gaps 0 65535 (list (Tuple 10 10))) #t))

(: named-class (-> string (Option Cset)))
(defun (named-class name)
  (cond
    ((= name "any") (Some cs-any))
    ((= name "nonl") (Some cs-nonl))
    ((= name "alpha") (Some cs-alpha))
    ((= name "alphabetic") (Some cs-alpha))
    ((= name "digit") (Some cs-digit))
    ((= name "numeric") (Some cs-digit))
    ((= name "alnum") (Some cs-alnum))
    ((= name "alphanumeric") (Some cs-alnum))
    ((= name "upper") (Some cs-upper))
    ((= name "upper-case") (Some cs-upper))
    ((= name "lower") (Some cs-lower))
    ((= name "lower-case") (Some cs-lower))
    ((= name "space") (Some cs-space))
    ((= name "whitespace") (Some cs-space))
    ((= name "word") (Some cs-word))
    ((= name "control") (Some cs-control))
    ((= name "ascii") (Some cs-ascii))
    ((= name "hex-digit") (Some cs-hex-digit))
    ((= name "ascii-digit") (Some cs-ascii-digit))
    ((= name "ascii-alpha") (Some cs-ascii-alpha))
    ((= name "ascii-alnum") (Some cs-ascii-alnum))
    (else None)))
