;; A union case is a constructor named at module level, so two unions in one
;; module cannot share a case name. This used to reach the C# compiler.

;; EXPECT-ERROR: Red is already a case of union_case_in_two_unions/Light
;; EXPECT-NO-ERROR: CS0111

(import (std prelude))

(type (: Light (Union Red Amber Green)))
(type (: Suit (Union Red Black)))

(defun (main args) 0)
