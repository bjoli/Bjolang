;; A newtype has only what is implemented for it. Its wrapped type is a number
;; to .NET, and that does not make the newtype one.

;; EXPECT-ERROR: 'newtype_num_not_given/Banana' does not satisfy 'Num', needed to call '+'. A newtype has only what is implemented for it, and this is not: write (impl (Num Banana) #:via int).

(import (std prelude))

(type (: Banana (Newtype int)))

(defun (main args)
  (println (displayed (+ (Banana 1) (Banana 2))))
  0)
