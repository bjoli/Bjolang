;; A number bound by def without a type is not known to be an int. The
;; message names the variable, not the literal it comes from.
;; EXPECT-ERROR: Block: 'total' is a number, and nothing says yet whether it is an int
(import (std prelude))
(import (std fmt))
(defun (main) (def total (+ 1 2)) (show [total nl]) 0)
