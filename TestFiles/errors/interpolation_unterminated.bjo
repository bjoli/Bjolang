;; A `#"` that never closes.
;;
;; Reported by the reader rather than left to run off the end of the file and
;; be reported as some unbalanced parenthesis a hundred lines later. The
;; position given is the opening `#"`, which is the thing that is wrong.

;; EXPECT-ERROR: Unterminated interpolated string

(import (std prelude))

(defun (main args)
  (println #"this one never ends)
  0)
