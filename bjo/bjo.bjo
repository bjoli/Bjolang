;; bjo — the command that runs Bjolang.
;;
;; The commands all end in the compiler: `run`, `build`, `check`, `repl`, and
;; `init` and `fetch`, which prepare what the others compile. What is here
;; rather than in the compiler is what a compiler cannot do for itself — decide
;; whether to start one at all, find the project a command was run inside,
;; fetch what its manifest names, and hand the console to what it starts.
;;
;; A *project* is a directory with a `manifest.bjodat`. Inside one, every
;; command compiles against the project's `.bjo/roots`, which says which
;; directory each package name means; outside one, every command behaves as it
;; did before there were projects. What a project is and how its dependencies
;; are resolved is in `project.bjo`, `resolve.bjo`, `git.bjo` and `lock.bjo` —
;; this file is the command line and the compiler processes, and stays that.
;;
;; `bjo` does not compile dependencies one at a time. The compiler builds an
;; imported module itself, in dependency order, so what `bjo` has to do is make
;; the modules findable — the roots file — and then compile the one entry.
;;
;; Staleness is *read*, not worked out. A build writes `<source>.bjobuild`
;; naming the mode it produced, the artefact, the compiler, and every source and
;; module it read; see `Build.writeBuildRecord`. So the question "is there
;; anything to do?" is a timestamp comparison over a list, and nothing here has
;; to know what an `include` is or where a module path resolves to. Those are
;; the compiler's to know. A driver that reads them out of the source again —
;; as `bjor` does, with `grep` and `awk` — is a second answer to a question that
;; already has one, and the two can differ.
;;
;; Children inherit this process's console, which is why `(std run)` is not used
;; here: it redirects stdin and stdout in order to read them, and the output of
;; a program run under `bjo` belongs to whoever ran it. The REPL needs a
;; terminal on both ends for the same reason.
;;
;; Everything that waits for a child is `#:sync`, down from `dispatch`. Waiting
;; is what this command does and it has one thread to do it on, so a suspending
;; copy of any of it would be a body nothing here ever calls — reported, rightly,
;; as parking a thread that is nobody's to yield.
;;
;; A command line is a sequence of refusals before it is a command, so most of
;; what follows is written as guards: `def` binds the case that carries on and
;; says what the body produces when it does not, and `with-return` is what a
;; failure that ends the command leaves through. The alternative is the same
;; decisions as nesting, indented once per thing that can go wrong.
;;
;; Where the failing case has nothing to say for itself — two `Option`s in a row
;; and no answer but `None` — it is a `(do ...)` block instead, and neither
;; failure is written down at all.

(import (std prelude))
;; The manifest types, for the fields this file reads out of a `Package`:
;; `record-ref` needs the declaration, and an import of `project.bjo` alone
;; does not bring it. `(text bjodat)` comes with them — the manifest's own
;; instances are written against its traits.
(import (text bjodat))
(import "manifest.bjo")
(import "project.bjo")
(import "resolve.bjo")

;; ---------------------------------------------------------------------------
;; Interop
;; ---------------------------------------------------------------------------

(import/class
  (Process (: System.Diagnostics.Process))
  (ProcessStartInfo (: System.Diagnostics.ProcessStartInfo (-> ProcessStartInfo)))
  (DateTime (: System.DateTime)))

(import/extern
  (settings-program!   (: System.Diagnostics.ProcessStartInfo.FileName
                          (-> ProcessStartInfo string void) #:set))
  (settings-use-shell! (: System.Diagnostics.ProcessStartInfo.UseShellExecute
                          (-> ProcessStartInfo bool void) #:set))
  (settings-argument   (: BjoProc.AddArgument
                          (-> ProcessStartInfo string ProcessStartInfo)))
  (process-start (: System.Diagnostics.Process.Start (-> ProcessStartInfo Process)
                    #:exceptions (System.ComponentModel.Win32Exception
                                  System.InvalidOperationException)))
  ;; The synchronous wait, and deliberately: `bjo` has nothing to do until the
  ;; child is done, and the thread it parks is the process's own.
  (process-wait  (: System.Diagnostics.Process.WaitForExit (-> Process void) #:blocking))
  (process-code  (: System.Diagnostics.Process.ExitCode (-> Process int) #:get))
  (error-message (: System.Exception.Message (-> Exception string) #:get))
  (clr-mtime     (: System.IO.File.GetLastWriteTimeUtc (-> string DateTime)))
  (clr-ticks     (: System.DateTime.Ticks (-> DateTime long) #:get))
  (clr-change-extension (: System.IO.Path.ChangeExtension (-> string string string)))
  ;; Where this executable sits, for an installation that was not told where it
  ;; is. See `root`.
  (clr-base-dir  (: System.AppContext.BaseDirectory #:get)))


;; ---------------------------------------------------------------------------
;; Starting something, and waiting for it
;; ---------------------------------------------------------------------------

;; Runs `program` and answers its exit code.
;;
;; No redirection anywhere: the child writes to the terminal `bjo` was started
;; from, reads from the same stdin, and is not a pipe stage. `UseShellExecute`
;; off is what makes the program name resolve against PATH.
(: exec #:sync (-> string (Vec string) int))
(defun (exec program arguments)
  (def settings (ProcessStartInfo.))
  (settings-program! settings program)
  (settings-use-shell! settings #f)
  (loop (:for a arguments)
        (:do (ignore (settings-argument settings a))))
  (match (process-start settings)
    ((Err e)
     (println #"bjo: could not start ${program}: ${(error-message e)}")
     ;; What a shell answers for a command it could not run.
     127)
    ((Ok child)
     (process-wait child)
     (process-code child))))


;; ---------------------------------------------------------------------------
;; Timestamps
;; ---------------------------------------------------------------------------

;; A file's last write, in ticks. A file that is not there is as old as anything
;; can be, so a dependency that has been deleted is not newer than the artefact
;; and does not force a rebuild that would fail for the same reason.
(: mtime (-> string long))
(defun (mtime path)
  (if (file-exists? path) (clr-ticks (clr-mtime path)) 0L))

(: newer? (-> string string bool))
(defun (newer? a b) (> (mtime a) (mtime b)))


;; ---------------------------------------------------------------------------
;; The installation
;; ---------------------------------------------------------------------------

;; The directory the compiler and its sources live in.
;;
;; `BJO_ROOT` is what the launcher exports. Without it, this executable was
;; started some other way, and the one thing it knows about itself is where it
;; sits: a build puts the binary beside its source, so `bjo.exe` is in
;; `<root>/bjo`.
(: root string)
(def root
  (match (get-environment-variable "BJO_ROOT")
    ((Some dir) dir)
    (None (path-absolute (path-combine clr-base-dir "..")))))

(: compiler-dll string)
(def compiler-dll (path-combine root "bin" "Release" "net10.0" "Bjolang.dll"))


;; ---------------------------------------------------------------------------
;; The compiler binary
;; ---------------------------------------------------------------------------

;; Is there a compiler to use at all?
(: have-compiler? (-> bool))
(defun (have-compiler?)
  (cond
    ((file-exists? compiler-dll) #t)
    (else
     (println "bjo: there is no compiler built here yet. Run 'bjo rebjo'.")
     #f)))


;; ---------------------------------------------------------------------------
;; The build record
;; ---------------------------------------------------------------------------

;; What a build wrote down about itself. `compiler`, `source` and `dep` lines
;; are read into one list: they are all files the artefact must be newer than,
;; and nothing here has a reason to tell them apart.
(type
  (: BuildRecord (Record (: mode string)
                         (: output string)
                         (: inputs (List string))
                         ;; The .NET shared frameworks the file's package
                         ;; declared when it was built. Not a file, so not an
                         ;; input: a declaration that is *removed* deletes the
                         ;; declarations file, and a file that is not there is
                         ;; newer than nothing.
                         (: frameworks (List string))
                         ;; The declarations file this was built against, or ""
                         ;; where there was none. It is an input as well — a
                         ;; rewrite is a change the timestamps can see — and
                         ;; this is for the change they cannot: the file
                         ;; appearing, or going away with the last declaration
                         ;; in the whole graph.
                         (: declaration-file string))))

(: record-file (-> string string))
(defun (record-file file) (clr-change-extension file ".bjobuild"))

;; A line is `key value`, and the value may contain spaces — a path is allowed
;; them — so it is everything after the first one rather than a field of a
;; split. A line with no space at all is no line, which is the `None` the bind
;; short-circuits to.
(: split-line (-> string (Option (Tuple string string))))
(defun (split-line line)
  (match (string-index #(char=? & #\space) line)
    ((Some space)
     (Some (Tuple (substring/cursors line (string-cursor-start line) space)
                  (substring/cursors line (string-cursor-next line space)
                                     (string-cursor-end line)))))
    (None None)))

;; The keys that name a file the artefact must be newer than. What they are
;; called apart is nothing this has to know.
;; `roots` is an input like any other: it says which directory each package name
;; means, so a build made against a different one is a build against different
;; code — and the `dep` lines here are the files the old one chose.
(: input-key? (-> string bool))
(defun (input-key? key)
  (case key
    (("source" "dep" "compiler" "roots" "frameworks") #t)
    (else #f)))

;; `None` when there is no record, or when what is there names no artefact —
;; which is a record written by a newer `bjo` or a truncated one, and either way
;; not something to decide against.
(: read-record (-> string (Option BuildRecord)))
(defun (read-record file)
  (with-return ret
    (def path (record-file file))
    (unless (file-exists? path) (ret None))

    (loop (:for line (string-split (file-read-text path) "\n"))
          ;; A line with no key at all is not one. `:when-let` skips it, and an
          ;; accumulator that is not stepped keeps what it had.
          (:when-let (Some (Tuple key value)) (split-line (string-trim line)))
          (:acc mode (folding "" (if (= key "mode") value mode)))
          (:acc artefact (folding "" (if (= key "output") value artefact)))
          ;; A key this `bjo` does not know is a record from a later one, and is
          ;; accumulated nowhere: the three fields here are what a decision is
          ;; made of, and they are all present.
          (:acc inputs (listing value) #:when (input-key? key))
          (:acc frameworks (listing value) #:when (= key "framework"))
          (:acc declarations (folding "" (if (= key "frameworks") value declarations)))
          => (if (= artefact "")
                 None
                 (Some (BuildRecord (mode mode)
                                    (output artefact)
                                    (inputs inputs)
                                    (frameworks (list-sort frameworks))
                                    (declaration-file declarations)))))))

;; ---------------------------------------------------------------------------
;; Compiling
;; ---------------------------------------------------------------------------

;; The source a name refers to. A bare `foo` is `foo.bjo` when that exists,
;; which is what makes `bjo run examples/vec` work.
(: resolve-source (-> string (Option string)))
(defun (resolve-source name)
  (cond
    ((file-exists? name) (Some name))
    ((file-exists? (str name ".bjo")) (Some (str name ".bjo")))
    (else None)))

;; `--roots <file>` where there is a project, and nothing where there is not.
;; The compiler records the file as an input of what it builds, so a build made
;; against other packages is stale by the same comparison every other change is.
;; What a compile is made against: where the packages are, and which of them
;; declared a .NET shared framework. Carried together because every command
;; that passes one passes the other, and two things a caller has to keep in
;; step are two things a caller can get out of step.
;;
;; Both are `None` outside a project, and the second is `None` inside one where
;; no package declared anything — which is the ordinary case, and is what keeps
;; such a project's command line exactly what it was before frameworks existed.
(type (: Against (Record (: roots (Option string)) (: frameworks (Option string)))))

(: nothing-against Against)
(def nothing-against (Against (roots None) (frameworks None)))

(: prepared-against (-> Prepared Against))
(defun (prepared-against ready)
  (Against (roots (Some (prepared-roots-file ready)))
           (frameworks (prepared-frameworks-file ready))))

(: flag-for (-> string (Option string) (List string)))
(defun (flag-for flag path)
  (match path
    ((Some p) (Cons flag (Cons p Nil)))
    (None Nil)))

;; The compiler records both files as inputs of what it builds, so a build made
;; against other packages — or against another set of declarations — is stale by
;; the same comparison every other change is.
(: against-flags (-> Against (List string)))
(defun (against-flags a)
  (list-append (flag-for "--roots" (record-ref a roots))
               (flag-for "--frameworks" (record-ref a frameworks))))

;; What the frameworks file says the package holding `file` declares.
;;
;; The longest directory that contains the file wins, which is the rule the
;; compiler uses to decide the same question — and has to be, because a
;; dependency fetched into `.bjo/pkg` lives *under* the root project.
(: declared-for (-> Against string (List string)))
(defun (declared-for against file)
  (match (record-ref against frameworks)
    (None Nil)
    ((Some path)
     (if (not (file-exists? path))
         Nil
         (let ((full (path-absolute file))
               (lines (string-split (file-read-text path) "\n")))
           ;; Two passes rather than one: the package a file belongs to is the
           ;; longest directory containing it, and which that is cannot be known
           ;; until every line has been seen.
           (def owner
             (loop (:for line lines)
                   (:when-let (Some (Tuple dir name)) (split-tab (string-trim line)))
                   (:acc out (folding "" (if (and (string-starts-with? full (str dir "/"))
                                                  (> (string-length dir) (string-length out)))
                                             dir
                                             out)))
                   => out))
           (if (= owner "")
               Nil
               (list-sort
                 (loop (:for line lines)
                       (:when-let (Some (Tuple dir name)) (split-tab (string-trim line)))
                       (:acc out (listing name) #:when (= dir owner))
                       => out))))))))

;; A frameworks-file line: a directory, a tab, a framework name.
(: split-tab (-> string (Option (Tuple string string))))
(defun (split-tab line)
  (match (string-index #(char=? & #\tab) line)
    ((Some tab)
     (Some (Tuple (substring/cursors line (string-cursor-start line) tab)
                  (substring/cursors line (string-cursor-next line tab)
                                     (string-cursor-end line)))))
    (None None)))

;; Is there anything to do before the artefact can be used?
(: stale? (-> string string Against bool))
(defun (stale? file wanted against)
  ;; No record at all is *stale*, not current: there is nothing that says what
  ;; the artefact was built from, so the only safe answer is to build it. `#f`
  ;; here makes `ensure-built` serve a record that is not there, and fail with
  ;; an exit code and no message.
  (def* ((Some rec) (read-record file) #t)
        (artefact (record-ref rec output)))
  (or (not (= (record-ref rec mode) wanted))
      (not (file-exists? artefact))
      ;; A changed declaration is a changed build: what a module may *name*
      ;; follows from it, so one built under another set has to be built again
      ;; — and told, if it now names something it may not.
      (not (= (record-ref rec frameworks) (declared-for against file)))
      ;; And the same for the file itself coming or going. The last
      ;; declaration in a graph being taken out deletes it, and a file that is
      ;; not there is newer than nothing — while the dependency that used to
      ;; declare it still has to be built again, which is the compiler's own
      ;; comparison and only runs if this one sends it there.
      (not (= (record-ref rec declaration-file)
              (match (record-ref against frameworks)
                ((Some path) path)
                (None ""))))
      (any? #(newer? & artefact) (record-ref rec inputs))))


(: compile #:sync (-> string bool bool Against int))
(defun (compile file debug? lib? roots)
  (def flags (list-append (if lib? (Cons "--lib" Nil) Nil)
                          (list-append (if debug? (Cons "-d" Nil) Nil)
                                       (against-flags roots))))
  (exec "dotnet" (list->vec (Cons compiler-dll (list-append flags (Cons file Nil))))))

;; Every module of a library, in one compiler process.
;;
;; `--if-stale` leaves out what is current, and `--batch` pays the compiler's
;; half-second start once rather than once per module. A library has no entry
;; to compile *from*, so this is the only way its modules get built at all.
(: compile-batch #:sync (-> (List string) bool Against int))
(defun (compile-batch files debug? roots)
  (def flags (list-append (Cons "--batch" (Cons "--if-stale" Nil))
                          (list-append (if debug? (Cons "-d" Nil) Nil)
                                       (against-flags roots))))
  (exec "dotnet" (list->vec (Cons compiler-dll (list-append flags files)))))

;; The artefact as it already stands, for a file that needs no building.
;;
;; Only reached when `stale?` has answered from a record, so there is one to
;; read; `None` is the file having gone away between the two reads.
(: record-as-built (-> string (Result int (Tuple BuildRecord bool))))
(defun (record-as-built file)
  (match (read-record file)
    ((Some rec) (Ok (rec . #f)))
    ;; Only reachable when `stale?` answered from a record that has gone away
    ;; since, and the exit code alone would be a command that failed without
    ;; saying anything at all.
    (None (Err (fail #"bjo: the build record for ${file} went away while it was being read.")))))

;; Compiles `file` if it needs it, and answers the record the build left — which
;; is where the artefact's name comes from. A file with no `main` is a library
;; whether or not `--lib` was passed, so the compiler is the only one that knows
;; whether it produced a `.exe` or a `.dll`.
;;
;; `Err` carries an exit code, so a failed compile leaves through here with the
;; compiler's own status rather than a made-up one. The `bool` says whether this
;; call is what built it.
(: ensure-built #:sync (-> string bool bool bool Against (Result int (Tuple BuildRecord bool))))
(defun (ensure-built file debug? lib? force? roots)
  (with-return ret
    (unless (have-compiler?) (ret (Err 1)))

    ;; A debug build is never served from the record: the dumps `-d` asks for
    ;; are produced by compiling, so a cached one has nothing to show.
    (def wanted (if debug? "debug" "release"))
    (unless (or force? debug? (stale? file wanted roots))
      (ret (record-as-built file)))

    (def status (compile file debug? lib? roots))
    (unless (= status 0) (ret (Err status)))

    ;; The compiler said it succeeded and left no record. It writes one after
    ;; every build that did, so this is a compiler too old for this `bjo`.
    (def (Some built) (read-record file)
      :fail ((None
              (println #"bjo: ${file} compiled, but left no build record.")
              (Err 1))))

    (Ok (Tuple built #t))))


;; ---------------------------------------------------------------------------
;; The commands
;; ---------------------------------------------------------------------------

;; Everything after the source file belongs to the program, which is the only
;; reading that lets a program have flags of its own.
(: cmd-run #:sync (-> string (List string) bool bool Against int))
(defun (cmd-run file program-args debug? force? roots)
  (match (ensure-built file debug? #f force? roots)
    ((Err status) status)
    ((Ok (Tuple rec _)) #:when (string-ends-with? (record-ref rec output) ".dll")
     (println #"bjo: ${file} has no main, so it builds a library: ${(record-ref rec output)}")
     (println "bjo: there is nothing to run. Use 'bjo build' for a library.")
     1)
    ((Ok (Tuple rec _))
     (exec "dotnet" (list->vec (Cons (record-ref rec output) program-args))))))

(: cmd-build #:sync (-> string bool bool bool Against int))
(defun (cmd-build file debug? lib? force? roots)
  (match (ensure-built file debug? lib? force? roots)
    ((Err status) status)
    ((Ok (Tuple rec built?))
     (def what (if built? "Built" "Up to date"))
     (println #"${what}: ${(record-ref rec output)}")
     0)))

;; Nothing is written, so no record is read and none is left. A dependency is
;; still built — checking a module against an import means reading that import's
;; metadata, and the metadata is in the `.dll` — but that is the compiler's
;; business rather than this one's.
;;
;; Many files go to one compiler process: a cold one costs about half a second
;; before it does anything, and `--batch` pays that once instead of per file.
(: cmd-check #:sync (-> (List string) Against int))
(defun (cmd-check files roots)
  (if (not (have-compiler?))
      1
      (let ((batch (match files
                     ((Cons _ (Cons _ _)) (Cons "--batch" Nil))
                     (_ Nil))))
        (exec "dotnet"
              (list->vec (Cons compiler-dll
                               (Cons "--check"
                                     (list-append (against-flags roots)
                                                  (list-append batch files)))))))))
  
;; The compiler's REPL has no line editing of its own, so it is run under
;; `rlwrap` where there is one. `-a` forces it on: the prompt is written by the
;; REPL rather than by a terminal rlwrap can recognise.
(: cmd-repl #:sync (-> Against int))
(defun (cmd-repl roots)
  (def flags (against-flags roots))
  (if (not (have-compiler?))
      1
      (match (which "rlwrap")
        ((Some rlwrap)
         (exec rlwrap (list->vec (Cons "-a" (Cons "dotnet" (Cons compiler-dll
                                                                 (list-append flags (Cons "--repl" Nil))))))))
        (None (println "bjo: no rlwrap in PATH, so the REPL has no line editing")
              (exec "dotnet" (list->vec (Cons compiler-dll
                                              (list-append flags (Cons "--repl" Nil)))))))))


;; ---------------------------------------------------------------------------
;; Projects
;; ---------------------------------------------------------------------------

;; The flags a command was given, and what was left after them. Declared here
;; rather than beside the parser below it, because the project commands take
;; one and a signature cannot name a type that has not been declared yet.
(type
  (: Cmdline (Record (: debug bool)
                     (: force bool)
                     (: lib bool)
                     (: locked bool)
                     (: rest (List string)))))

;; The directory a file sits in, for the walk upward that finds a project.
(: file-directory (-> string string))
(defun (file-directory file)
  (match (parent-directory (path-absolute file))
    ((Some dir) dir)
    (None (path-absolute file))))

;; The project a directory is inside, if it is inside one.
(: project-around #:sync (-> string (Result string (Option Project))))
(defun (project-around where)
  (match (find-project-dir where)
    (None (Ok None))
    ((Some dir)
     (def (Ok project) (project-at dir) :propagate)
     (Ok (Some project)))))

;; The project a command that named no file was run in. Not finding one is an
;; error here, because the command had nothing else to work on.
(: project-here #:sync (-> string (Result string Project)))
(defun (project-here command)
  (def (Ok (Some project)) (project-around (current-directory))
    :fail (((Ok None)
            (Err (str #"bjo ${command}: this is not a project — there is no ${manifest-name} "
                      "here or in any directory above. Name a file, or make a project with 'bjo init'.")))
           ((Err why) (Err why))))
  (Ok project))

;; The roots a command compiles against, from where it was run.
;;
;; `None` outside a project, which is every command behaving as it did before
;; there were projects. Inside one, the project is resolved and fetched first:
;; a file in a project imports the project's packages whether it is reached as
;; `src/main.bjo` or as the entry.
(: roots-near #:sync (-> string bool (Result string Against)))
(defun (roots-near where locked?)
  (def (Ok (Some project)) (project-around where)
    :fail (((Ok None) (Ok nothing-against))
           ((Err why) (Err why))))
  (def (Ok ready) (prepare project locked?) :propagate)
  (Ok (prepared-against ready)))

(: roots-for-file #:sync (-> string bool (Result string Against)))
(defun (roots-for-file file locked?)
  (roots-near (file-directory file) locked?))

;; Builds a project, and answers the entry's build record where there is one.
;;
;; The entry decides the shape. A program is one compile of one file: the
;; compiler follows its imports and builds what they name, in order. A library
;; has no entry to follow, so every module under `src/` is named instead.
;;
;; `say?` is off for `run`, which has the program's own output to show and
;; nothing to add to it.
(: build-project #:sync (-> Project Cmdline bool (Result int (Option BuildRecord))))
(defun (build-project project line say?)
  (with-return ret
    (def (Ok ready) (prepare project (record-ref line locked))
      :fail (((Err why) (Err (fail why)))))
    (def roots (prepared-against ready))

    (unless (project-has-entry? project)
      (ret (build-library project line roots say?)))

    (match (ensure-built (project-entry project)
                         (record-ref line debug) #f (record-ref line force) roots)
      ((Err status) (Err status))
      ((Ok (Tuple rec built?))
       (when say?
         (println (str (if built? "Built" "Up to date") ": " (record-ref rec output))))
       (Ok (Some rec))))))

(: package-name-of (-> Project string))
(defun (package-name-of project)
  (name->string (record-ref (project-package project) name)))

(: build-library #:sync (-> Project Cmdline Against bool (Result int (Option BuildRecord))))
(defun (build-library project line roots say?)
  (with-return ret
    (def sources (sources-under (project-src project)))
    (when (empty? sources)
      (ret (Err (fail #"bjo build: there are no modules under ${(project-src project)}."))))

    (def status (compile-batch sources (record-ref line debug) roots))
    (unless (= status 0) (ret (Err status)))

    (when say?
      (def n (length sources))
      (println (str (package-name-of project) " is a library: "
                    (int->string n) (if (= n 1) " module" " modules")
                    " under src/, all current.")))
    (Ok None)))

(: build-and-say #:sync (-> Project Cmdline int))
(defun (build-and-say project line)
  (match (build-project project line #t)
    ((Err status) status)
    ((Ok _) 0)))

;; `bjo run` on a project: build it, then start the entry's artefact.
(: run-project #:sync (-> Project Cmdline (List string) int))
(defun (run-project project line arguments)
  (with-return ret
    (unless (project-has-entry? project)
      (ret (fail (str "bjo run: " (package-name-of project) " is a library — there is no "
                      (record-ref (project-package project) entry)
                      " to run. 'bjo build' builds it."))))

    (match (build-project project line #f)
      ((Err status) status)
      ;; A project with an entry always answers with its record.
      ((Ok None) 1)
      ((Ok (Some rec))
       (def out (record-ref rec output))
       (if (string-ends-with? out ".dll")
           (fail (str "bjo run: " (project-entry project) " has no main, so it builds a library: " out))
           (exec "dotnet" (list->vec (Cons out arguments))))))))

;; `bjo check` with no file, inside a project: everything the project holds.
(: check-project #:sync (-> Project Cmdline int))
(defun (check-project project line)
  (with-return ret
    (def (Ok ready) (prepare project (record-ref line locked))
      :fail (((Err why) (fail why))))
    (def sources (sources-under (project-src project)))
    (def files (if (and (project-has-entry? project)
                        (not (any? #(= & (project-entry project)) sources)))
                   (Cons (project-entry project) sources)
                   sources))
    (when (empty? files)
      (ret (fail #"bjo check: there are no modules under ${(project-src project)}.")))
    (cmd-check files (prepared-against ready))))


;; ---------------------------------------------------------------------------
;; The command line
;; ---------------------------------------------------------------------------

;; Flags come before the source file, and `--` ends them for a file whose name
;; begins with a dash. The first thing that is not a flag ends them too, and
;; everything from there on is positional — so `bjo run prog.bjo -d` passes `-d`
;; to the program rather than to the compiler.
(: parse-flags (-> (List string) (Result string Cmdline)))
(defun (parse-flags argv)
  (let go ((left argv) (debug #f) (force #f) (lib #f) (locked #f))
    (match left
      (Nil (Ok (Cmdline (debug debug) (force force) (lib lib) (locked locked) (rest Nil))))
      ((Cons a more)
       (case a
         ("--" (Ok (Cmdline (debug debug) (force force) (lib lib) (locked locked) (rest more))))
         (("-d" "--debug") (go more #t force lib locked))
         (("-c" "--compile") (go more debug #t lib locked))
         ("--lib" (go more debug force #t locked))
         ("--locked" (go more debug force lib #t))
         (else
          (if (string-starts-with? a "-")
              (Err #"bjo: unknown flag '${a}'")
              (Ok (Cmdline (debug debug) (force force) (lib lib) (locked locked) (rest left))))))))))

(: usage (-> void))
(defun (usage)
  (println "bjo - the Bjolang command")
  (println "")
  (println "Usage:")
  (println "  bjo init [name] [--lib]                 Make a project here. The name defaults to")
  (println "                                          this directory's; --lib makes a library.")
  (println "  bjo fetch [--locked]                    Fetch what the manifest names. Compiles nothing.")
  (println "  bjo run [-d] [-c] [args...]             Build this project and run it.")
  (println "  bjo run . [args...]                     The same, when the program takes arguments.")
  (println "  bjo run [-d] [-c] <file.bjo> [args...]  Compile one file if it needs it, then run it.")
  (println "                                          Arguments after the file go to the program.")
  (println "  bjo build [-d] [-c] [--locked]          Build this project.")
  (println "  bjo build [-d] [-c] [--lib] <file.bjo>  Compile one file if it needs it, and stop.")
  (println "  bjo check [<file.bjo>...]               Report errors without building anything.")
  (println "                                          With no file, every module of this project.")
  (println "  bjo repl                                Start a REPL, under rlwrap where there is one.")
  (println "  bjo rebjo                               Rebuild the compiler and bjo itself.")
  (println "  bjo help                                Show this message.")
  (println "")
  (println "Flags:")
  (println "  -d, --debug    Unoptimized, with the typed AST and the generated C# dumped.")
  (println "                 Always recompiles, since the dumps are made by compiling.")
  (println "  -c, --compile  Compile even when nothing has changed.")
  (println "  --lib          Build a .dll. A file with no main builds one anyway.")
  (println "  --locked       Refuse to change bjo.lock: any difference from it is an error.")
  (println "                 For a build that must be the one the lock describes.")
  (println "  --             End of flags, for a file whose name begins with a dash.")
  (println "")
  (println "A project is a directory with a manifest.bjodat in it, found by looking")
  (println "upward from where you stand. Its modules are in src/: src/lexer.bjo of a")
  (println "package called (myapp) is the module (myapp lexer). Outside a project every")
  (println "command works on the file it is given, as it always has.")
  (println "")
  (println "Nothing is rebuilt when the artefact is newer than everything the last")
  (println "build read: the compiler records that, and bjo compares timestamps.")
  (println "")
  (println "The compiler is not one of the things bjo keeps current: it is not asked")
  (println "whether it is behind its own sources, on the way to anything. Editing it")
  (println "is 'bjo rebjo', which builds it and this command — and that makes every")
  (println "artefact stale the way any other edit does."))

;; Every name resolved, or the first that names nothing. Resolved here rather
;; than left to the compiler, so that a misspelling is reported as one by the
;; command that was given it.
(: resolve-all (-> string (List string) (Result string (List string))))
(defun (resolve-all command names)
  (with-return ret
    (Ok (loop (:for name names)
              (:let resolved (resolve-source name))
              ;; The one exit a loop cannot take by itself: not the end of the
              ;; loop but the end of the command. `ret` is a statement here
              ;; because that is the only place it may stand.
              (:do (unless (some? resolved)
                     (ret (Err #"bjo ${command}: no such file '${name}'."))))
              (:when-let (Some file) resolved)
              (:acc out (listing file))
              => out))))

(: dispatch #:sync (-> string Cmdline int))
(defun (dispatch command line)
  (def* (debug? (record-ref line debug))
        (force? (record-ref line force))
        (lib? (record-ref line lib))
        (locked? (record-ref line locked))
        (rest (record-ref line rest)))

  (case command
    ("init"
     (with-return ret
       (when (or debug? force? locked?)
         (ret (fail "bjo init: writes files and compiles nothing, so it takes no build flags.")))
       (cmd-init rest lib?)))

    ;; Resolve, fetch and write the roots file, and stop there. What `build`
    ;; does first, for a checkout that is about to be built offline or by
    ;; something that is not `bjo`.
    ("fetch"
     (with-return ret
       (when (or debug? force? lib?)
         (ret (fail "bjo fetch: compiles nothing, so it takes no build flags.")))
       (unless (empty? rest) (ret (fail "bjo fetch: takes no arguments.")))
       (def (Ok project) (project-here "fetch") :fail (((Err why) (fail why))))
       (def (Ok ready) (prepare project locked?) :fail (((Err why) (fail why))))
       (println (str (package-name-of project) ": "
                     (int->string (prepared-dependencies ready)) " dependencies ready."))
       0))

    ("run"
     (with-return ret
       (when lib?
         (ret (fail "bjo run: --lib builds a library, and a library does not run.")))
       ;; No file names this project. So does `.`, which exists only so that
       ;; arguments can follow it: everything after the file belongs to the
       ;; program, and a project with no file named has nothing to put them
       ;; after.
       (def (Cons name args) rest
         :fail ((Nil (match (project-here "run")
                       ((Err why) (fail why))
                       ((Ok project) (run-project project line Nil))))))
       (when (= name ".")
         (ret (match (project-here "run")
                ((Err why) (fail why))
                ((Ok project) (run-project project line args)))))
       (def (Some file) (resolve-source name)
         (fail #"bjo run: no such file '${name}'."))
       (def (Ok roots) (roots-for-file file locked?) :fail (((Err why) (fail why))))
       (cmd-run file args debug? force? roots)))

    ("build"
     (with-return ret
       (def (Cons name more) rest
         :fail ((Nil (match (project-here "build")
                       ((Err why) (fail why))
                       ((Ok project) (build-and-say project line))))))
       (when (= name ".")
         (ret (cond
                ((not (empty? more))
                 (fail "bjo build: '.' is the whole project, so nothing may follow it."))
                (else (match (project-here "build")
                        ((Err why) (fail why))
                        ((Ok project) (build-and-say project line)))))))
       (unless (empty? more) (ret (fail "bjo build: takes one source file.")))
       (def (Some file) (resolve-source name)
         (fail #"bjo build: no such file '${name}'."))
       (def (Ok roots) (roots-for-file file locked?) :fail (((Err why) (fail why))))
       (cmd-build file debug? lib? force? roots)))

    ("check"
     (with-return ret
       (when (or debug? force? lib?)
         (ret (fail "bjo check: builds nothing, so it takes no build flags.")))
       (when (empty? rest)
         (ret (match (project-here "check")
                ((Err why) (fail why))
                ((Ok project) (check-project project line)))))
       (def (Ok resolved) (resolve-all "check" rest)
         :fail (((Err message) (fail message))))
       (def (Cons first _) resolved
         (fail "bjo check: no source file. Try 'bjo help'."))
       (def (Ok roots) (roots-for-file first locked?) :fail (((Err why) (fail why))))
       (cmd-check resolved roots)))

    ("repl"
     (with-return ret
       (when (or debug? force? lib?) (ret (fail "bjo repl: takes no build flags.")))
       (unless (empty? rest) (ret (fail "bjo repl: takes no arguments.")))
       ;; Inside a project the prompt sees the project's packages, which is
       ;; what makes `(import (myapp lexer))` work there.
       (def (Ok roots) (roots-near (current-directory) locked?)
         :fail (((Err why) (fail why))))
       (cmd-repl roots)))

    ;; Reached only when this binary was started directly. The launcher takes
    ;; `rebjo` before it gets here, and has to: the command rebuilds `bjo.exe`,
    ;; which is the file this process is running from.
    ("rebjo"
     (fail "bjo rebjo: run it through the bjo launcher — it rebuilds this binary, which is running."))

    (("help" "-h" "--help") (usage) 0)

    (else (fail #"bjo: '${command}' is not a command. Try 'bjo help'."))))

(defun (main args)
  ;; Before any git process is started. `(std run)` redirects a child's stdin
  ;; in order to write to it, so a repository that wants a password would read
  ;; from a pipe nobody writes to and wait there forever. With this set, git
  ;; fails instead, and says what it wanted.
  (set-environment-variable! "GIT_TERMINAL_PROMPT" "0")

  ;; The command comes first and is never a flag, so the flags of the command
  ;; are what follows it.
  (def (Cons command rest) (vec->list args)
    :fail ((Nil (usage) 1)))
  (match (parse-flags rest)
    ((Err message) (fail message))
    ((Ok line) (dispatch command line))))
