;; Three declarations that each fail to check, all reported by one compilation.
;;
;; Each has a written signature, so each is forward-declared before the group is
;; checked and none of the three depends on another having succeeded. What the
;; barrier buys is that the second and third are found at all: the fold used to
;; stop at the first.

;; EXPECT-ERROR: multi_type_errors.bjo:15
;; EXPECT-ERROR: multi_type_errors.bjo:18
;; EXPECT-ERROR: multi_type_errors.bjo:21

(import (std prelude))

(: alpha (-> int int))
(defun (alpha x) "not an int")

(: beta (-> int int))
(defun (beta x) (+ x "a string"))

(: gamma (-> int int))
(defun (gamma x) #t)

(defun (main args) 0)
