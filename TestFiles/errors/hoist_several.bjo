;; Every reason is listed at once, in one error for the form.
;; EXPECT-ERROR: it cannot refer to the local `n`
;; EXPECT-ERROR: it cannot read `counter`, a def/mutable
;; EXPECT-ERROR: it cannot produce an Array
(import (std prelude))

(def/mutable counter 0)

(: f (-> int (Array int)))
(defun (f n) (please-hoist-i-promise-i-am-not-naughty #[n counter]))

(defun (main) 0)
