;; A re-export carries a union's cases — and an `#:opaque` type has none to
;; carry.
;;
;; `Sealed` is declared `#:opaque` in `inc/reexport_origin.bjo` and re-exported
;; by `inc/reexport_facade.bjo`. What crosses the first boundary is a head, so
;; what crosses the second is the same head: opacity is a property of the
;; declaration, and a facade passes the declaration on rather than rebuilding
;; it. `Locked` is no more nameable here than it is one module closer.

;; EXPECT-ERROR: which is exported #:opaque

(import (std prelude))
(import "../inc/reexport_facade.bjo")

(: peek (-> Sealed int))
(defun (peek s)
  (match s
    ((Locked n) n)
    (Open 0)))

(defun (main args) 0)
