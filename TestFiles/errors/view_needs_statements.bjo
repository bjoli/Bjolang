;; A view's step is emitted inside the clause's `when`, where C# has no
;; statement position — the same limit a `#:when` guard has, and reported the
;; same way. A `let` in the step is what runs into it.
;;
;; EXPECT-ERROR: this view's step needs statements to evaluate

(: pick (-> int string))
(defun (pick n)
  (match n
    ((:view (fun (x) (let ((doubled (* x 2))) (< 10 doubled))) #t) "big")
    (_ "small")))

(defun (main args)
  (println (pick 9))
  0)
