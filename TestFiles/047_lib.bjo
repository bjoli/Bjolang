;; A library module with state of its own, to check that a module-level
;; `def/mutable` survives the module boundary rather than being copied.
(export tick reads reset)

(: int)
(def/mutable reads 0)

(: (-> int))
(defun (tick)
  (set! reads (+ reads 1))
  reads)

(: (-> void))
(defun (reset)
  (set! reads 0))
