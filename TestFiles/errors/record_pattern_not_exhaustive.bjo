;; A record's fields are covered like a constructor's arguments, and the
;; counterexample names the field that is not.

;; EXPECT-ERROR: this match does not cover every value
;; EXPECT-ERROR: (Car (colour Blue)) reaches no clause

(import (std prelude))

(type (: Colour (Union Red Green Blue)))
(type (: Car (Record (: brand string) (: colour Colour))))

(: f (-> Car string))
(defun (f c)
  (match c
    ((Car (colour Red)) "red")
    ((Car (colour Green)) "green")))

(defun (main args)
  (println (f (Car (brand "a") (colour Red))))
  0)
