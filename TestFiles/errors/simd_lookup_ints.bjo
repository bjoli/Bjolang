;; A lookup's indices are bytes: each picks one of the table's 16.

;; EXPECT-ERROR: no implementation of trait 'ByteLane' for 'int', needed by the implementation of 'SimdLookup'

(import (std prelude))
(import (std simd))

(defun (main)
  (def table (simd128-splat 7uy))
  (println (simd-ref (simd-lookup table (simd128-of 1 2 3 4)) 0))
  0)
