;; A type variable that among the parameters only a keyword one mentions.
;;
;; A generic keyword parameter arrives in C# as an `Option`, which an argument
;; reaches through an implicit conversion, and C# type inference does not look
;; through that. An omitted keyword is no argument at all. So such a call has
;; its type arguments written out, as a call to a function whose type variable
;; only the result mentions does.

(import (std prelude))
(import (std simpletest))
(import "inc/kwgeneric.bjo")

;; The variable is the keyword's type and the result's.
(: seeded (-> (-> %a %a) (#:seed %a) %a))
(defun (seeded f #:seed (panic! "seeded needs #:seed"))
  (f seed))

;; The variable is in keyword handlers only, as a case analysis has it. `#:else`
;; comes first because the other defaults name it.
(: sign-case (-> int (#:else (-> int %r)) (#:negative (-> int %r)) (#:zero (-> %r))
                 (#:positive (-> int %r)) %r))
(defun (sign-case n #:else (fun (k) (panic! "sign-case: no clause"))
                    #:negative (fun (k) (else k)) #:zero (fun () (else 0))
                    #:positive (fun (k) (else k)))
  (if (< n 0)
      (negative n)
      (if (= n 0) (zero) (positive n))))

(defun (main)
  (expect "a keyword seed, int" (seeded (fun (x) (+ x 1)) #:seed 41) 42)
  (expect "a keyword seed, string" (seeded (fun (s) (str s "!")) #:seed "hi") "hi!")

  (expect "every clause given"
          (sign-case -3 #:negative (fun (k) "neg") #:zero (fun () "zero") #:positive (fun (k) "pos"))
          "neg")
  (expect "one clause and else"
          (sign-case 0 #:zero (fun () 0) #:else (fun (k) 1))
          0)
  (expect "else answers for the rest"
          (sign-case 5 #:zero (fun () 0.0) #:else (fun (k) 1.5))
          1.5)

  (expect "across a module, one clause and else"
          (shape-case (circle 2.0) #:circle (fun (r) "circle") #:else (fun (s) "other"))
          "circle")
  (expect "across a module, else"
          (shape-case (square 1.0) #:circle (fun (r) 0) #:else (fun (s) 7))
          7)
  0)
