;; A number where a stage belongs.
;;
;; A pipeline's stages are `run/Form`s, and a number is no form: none of the
;; cases carries one. The literal is elaborated where it is written, so the
;; position is checked there rather than by `run` at start-up, and the report
;; lists the cases that were on offer.

;; EXPECT-ERROR: no case of the union run/Form carries a number

(import (std prelude))
(import (std run))

(defun (main args)
  (match (run/string '(pipe (echo "x") 7))
    ((Ok s) 0)
    ((Err e) 0))
  0)
