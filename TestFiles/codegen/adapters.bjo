;; `enumerate` and `zip` in loops over known types. The adapter inlines, its
;; tuple cursor is one local per part (LoopLowering's `splitTupleSlots`), and,
;; where what it wraps cleans up nothing, the loop has no guard. That is the
;; loop two lockstep `:for`s, or an index beside a `:for`, would make.
;; `seq-enumerate` is a `seql`, and fuses with the `seql` it walks.
(import (std prelude))

;; EXPECT-NO-CS: ValueTuple<int, int> loopcur
;; EXPECT-NO-CS: looplive.*Enumerated<int\[\]>
;; EXPECT-CS: int loopcur\w*_0\w*;
(: weighted (-> (Array int) long))
(defun (weighted a)
  {summing (cast long (* i x)) (:for (Tuple i x) (enumerate a))})

;; EXPECT-NO-CS: looplive.*Zipped<int\[\], double\[\]>
(: dot (-> (Array int) (Array double) double))
(defun (dot a b)
  {summing (* (cast double x) y) (:for (Tuple x y) (zip a b))})

;; A tuple cursor whose parts are not ints is split too.
;; EXPECT-CS: SchemeList.SchemeList<BjoString.Utf8String> loopcur\w*_1\w*;
(: labelled (-> (List string) (List string)))
(defun (labelled names)
  {listing (str (->str i) name) (:for (Tuple i name) (enumerate names))})

;; Fused: no cursor over the `map`'s sequence is left.
;; EXPECT-NO-CS: SeqCursor<int> loopcur
(: indexed-squares (-> (Array int) int))
(defun (indexed-squares a)
  {summing (* i x) (:for (Tuple i x) (seq-enumerate (map (fun (y) (* y y)) a)))})
