;; Docs for std/text.bjo, read through (:doc #:file "text.bjodoc").
;; The texts are samizdat markup: code in prose is @code{...}.

(:doc #:module
  (summary "Persistent text for editing: a B+ tree of UTF-8 chunks, with builder and transient.")
  (see Text TextCursor text-insert text-delete text-substring text-split-at text-append text-cursor-forward text-cursor-at-line TransientText TextBuilder Texting text-replace text-split)
  (example """
    (import (std text))

    (def r (string->text "hello world\nsecond line"))
    (def c (text-cursor-forward r (text-cursor-start r) 5))
    (def r2 (text-insert r c ","))                   ; "hello, world\nsecond line"
    (text->string (text-line r2 1))                  ; "second line"
    (def w (option-ref (text-search r2 "world")))
    (text-cursor-line r2 w)                          ; 0
    (text->string (text-substring r2 w (text-cursor-end r2)))   ; "world\nsecond line"
    (text->string r)                                 ; r is unchanged
    """)
  (reference """
    A @code{Text} is immutable text that is cheap to edit at any position.
    Inserting, deleting, splitting, appending and taking substrings take
    O(log n) time and share every chunk and node they do not change, so old
    versions stay valid and cost only what differs.

    @strong{As a string.} The API is a string's: the functions a string has
    are here under the same names, with a text where the string was, and
    return what the string's return. @code{text-length} is in bytes, as
    @code{string-length} is, and @code{text-count} counts characters, in O(1)
    time. Positions are cursors, as in a string, and no function takes or
    returns a byte offset.

    @strong{Cursors.} A @code{TextCursor} is a position that holds the chunk
    it is in, so stepping it reads that chunk's bytes and does not search the
    tree again. The cursor functions take the text and the cursor, as the
    string cursor functions take the string. Every node keeps the characters
    of its children, so @code{text-cursor-forward} and
    @code{text-cursor-back} move any number of characters in O(log n) time:
    character n of a text is @code{(text-cursor-forward r (text-cursor-start r) n)}.
    A cursor starts a loop: @code{(:for c cursor)} goes to the end, and
    @code{(:for c (text-backward r cursor))} goes back to the start.

    @strong{Edits.} @code{text-insert}, @code{text-delete},
    @code{text-replace-range} and @code{text-split-at} take cursors of the
    text they edit. A cursor belongs to one text: the text an edit returns
    needs cursors of its own.

    @strong{Lines.} Every node keeps the newlines of its children, so
    @code{text-cursor-at-line} and @code{text-cursor-line} take O(log n)
    time. Lines are separated by @code{"\n"} and counted from 0; a text has
    one line more than it has newlines.

    @strong{Structure.} Text is held in chunks of at most 1024 bytes, in
    nodes of up to 16 children, each with the bytes, newlines and characters
    of every child. A text of at most 1024 bytes is a single string and no
    tree. Only the nodes are C# (@code{Bjolang.Runtime.TextTree}), because
    they hold their slots in inline arrays; every operation is Bjolang.

    @strong{Batch edits.} A @code{TransientText} edits nodes it owns in place
    and keeps the chunk being edited in a mutable buffer: a run of edits close
    together, such as typing, allocates nothing. Its positions are character
    indices. A @code{TextBuilder} appends strings and builds the tree in one
    pass, and the @code{texting} collector does that in a loop.

    @strong{Traits.} Implements @code{Eq}, @code{Ord}, @code{Iterable} (the
    characters), @code{Collection} (whose length is the character count),
    @code{Refable} and @code{Cursor} (by @code{TextCursor}), @code{Written},
    @code{Displayed} and @code{Addable} (of strings, at the end). Equality,
    order and hashing depend on the characters only, not on how they are
    split into chunks. @code{TextBuilder} and @code{TransientText} implement
    @code{Addable!}.
    """))

;; ---------------------------------------------------------------------------
;; Types
;; ---------------------------------------------------------------------------

(:doc Text
  (summary "Immutable text as a balanced tree of UTF-8 chunks.")
  (see string->text text->string text-insert text-delete TransientText)
  (example """
    (def r (text "abc" "déf"))
    (text-count r)                   ; 6
    (text-length r)                  ; 7, in bytes
    (= r (string->text "abcdéf"))    ; #t
    (loop (:for c r) (:do (display c)))
    """))

(:doc TextWalk
  (summary "The cursor of a loop over a text's characters.")
  (see Text)
  (reference """
    A struct holding the cursor of the current chunk; a loop with
    @code{(:for c r)} uses it and allocates nothing.
    """))

(:doc TextCursor
  (summary "A position in a text, on a character boundary, that steps by characters.")
  (see text-cursor-start text-cursor-forward text-cursor-next text-cursor-prev text-cursor-search text-backward)
  (example """
    (def r (string->text "one two\nthree"))
    (def c (option-ref (text-search r "two")))
    (text-cursor-ref r c)                            ; #\t
    (text-cursor-line r (text-cursor-forward r c 4)) ; 1
    (loop (:for ch c) (:acc (stringing ch)))         ; "two\nthree"
    """)
  (reference """
    A struct of the text, the chunk the position is in, and the position in
    it. The functions on it take the text first, as the string cursor
    functions take the string; the cursor must be one of that text. It
    stays valid for as long as the text does: texts do not change.

    A step inside the chunk reads its bytes and allocates nothing; a step out
    of it looks up the next chunk from the root, once per chunk. A move of
    more than a few characters looks its character up from the root by the
    character counts.

    @code{=} and @code{compare} compare the positions. So do
    @code{text-cursor<?} and the rest, since @code{<} is for numbers. Cursors
    of two texts compare without complaint and mean nothing.

    As an @code{Iterable}, a cursor is the characters from it to the end.
    """))

(:doc TextBackward
  (summary "The characters before a cursor, last first, as a loop goes over them.")
  (see text-backward TextCursor))

(:doc TextBackwardStep
  (summary "The step of a loop over a TextBackward.")
  (see TextBackward)
  (reference "A struct of the cursor on the current character. Exported because the loop that uses it is compiled where it is written."))

(:doc TextBuilder
  (summary "Mutable builder that appends text and returns a text.")
  (see textbuilder-empty textbuilder-add! textbuilder->text)
  (example """
    (def b (textbuilder-empty))
    (textbuilder-add! b "first line\n")
    (textbuilder-add! b "second line\n")
    (textbuilder->text b)
    """))

(:doc Texting
  (summary "The collector that gathers characters or strings into a text.")
  (case texting "Written in an :acc clause with the character or string to add.")
  (see TextBuilder TextingInto TextPiece Stringing)
  (example """
    (loop (:for line lines)
          (:acc t (texting #"${line}\n"))
          => t)                                     ; a text of the lines
    (loop (:for w words) (:acc (texting w #:into t)))   ; t with the words after it
    (loop (:for c t) (:acc (texting (char-upcase c))))  ; a map over a text
    """)
  (reference """
    The pieces are of one type, as @code{TextPiece} gives: a loop adds
    characters, as @code{stringing} does, or strings. Its accumulator is a
    @code{TextBuilder}, so the text is built in one pass and long strings are
    shared, not copied. @code{#:into} starts from a text: its chunks are
    added first, and it is not changed.
    """))

(:doc TextPiece
  (summary "What a text builder takes a piece of text as: a string or a character.")
  (see Texting textbuilder-add-piece!))

(:doc textbuilder-add-piece!
  (summary "Adds a string or a character to the end of a builder.")
  (arg b "The builder.")
  (arg x "The string or character.")
  (see textbuilder-add! textbuilder-add-char! Texting))

(:doc TextingInto
  (summary "The collector a texting clause with #:into makes: it starts from a text.")
  (field seed "The text to start from, which is not changed.")
  (see Texting))

(:doc TransientText
  (summary "Mutable text for batch edits in place, at character indices.")
  (see text->transienttext transienttext->text transienttext-insert! transienttext-delete!)
  (example """
    (def t (text->transienttext r))
    (transienttext-insert! t 0 "# ")
    (transienttext-delete! t 10 12)    ; characters 10 and 11
    (transienttext->text t)
    """)
  (reference """
    Positions are character indices, from 0 to @code{transienttext-count}:
    a cursor would not survive the edits.

    Edits copy each node they do not own once, and then edit it in place.
    The chunk of the last edit is kept in a mutable buffer: an edit inside it,
    or within 64 characters of the edit before, moves bytes in the buffer and
    allocates nothing. An edit finds its byte in the buffer by stepping from
    where the last one ended, or at once in a chunk of ASCII. Not safe to use
    from two threads at once.
    """))

;; ---------------------------------------------------------------------------
;; Texts
;; ---------------------------------------------------------------------------

(:doc text-empty
  (summary "The empty text.")
  (returns "A text of no text.")
  (see text string->text))

(:doc text
  (summary "A text of strings joined in order.")
  (rest parts "The strings.")
  (returns "A text of the strings, one after the other.")
  (see string->text textbuilder-empty)
  (example """
    (text->string (text "ab" "" "cd"))   ; "abcd"
    """))

(:doc string->text
  (summary "A text of a string's text.")
  (arg s "The text. Chunks of a long string share its bytes.")
  (returns "A text of the text of s.")
  (see text->string text))

(:doc text->string
  (summary "The text of a text as one string.")
  (arg r "The text.")
  (returns "A string of the text of r, made in one allocation of its size.")
  (see string->text text-substring))

(:doc text-length
  (summary "The length of a text in bytes of UTF-8, as string-length is.")
  (arg r "The text.")
  (returns "The number of bytes of r's UTF-8 text, in O(1) time.")
  (see text-count text-line-count))

(:doc text-count
  (summary "The number of characters in a text.")
  (arg r "The text.")
  (returns "How many characters r holds, in O(1) time: every node keeps the characters of its children.")
  (see text-length))

(:doc text-empty?
  (summary "Whether a text has no characters.")
  (arg r "The text.")
  (returns "#t for the empty text.")
  (see text-length text-count))

(:doc text-line-count
  (summary "The number of lines in a text.")
  (arg r "The text.")
  (returns "One more than the number of newlines in r, in O(1) time. The empty text has one line.")
  (see text-line text-cursor-at-line))

(:doc text-substring
  (summary "The characters between two cursors, as a text.")
  (arg r "The text (unmodified).")
  (arg a "Where it begins, a cursor of r.")
  (arg b "Where it ends, not included: a cursor of r, not before a.")
  (returns "A text of the characters from a to b, in O(log n) time.")
  (raises System.ArgumentOutOfRangeException "When b is before a.")
  (see text-split-at text-take text-drop text->string)
  (reference """
    A substring of up to 1024 bytes is a string of its own. A longer one
    shares r's chunks: those in at most 16 chunks are pieces of them in one
    node, and the rest are cut from r's tree. @code{text->string} gives it as
    a string.
    """))

(:doc text-split-at
  (summary "A text split in two at a cursor.")
  (arg r "The text (unmodified).")
  (arg c "The cursor to split at, a cursor of r.")
  (returns "(Tuple before after): the texts of the characters before c and from c, in O(log n) time.")
  (see text-append text-substring text-split)
  (example """
    (def r (string->text "hello world"))
    (def (Tuple a b) (text-split-at r (text-cursor-forward r (text-cursor-start r) 5)))
    (text->string b)   ; " world"
    """))

(:doc text-append
  (summary "Two texts joined, as string-append joins two strings.")
  (arg a "The first text (unmodified).")
  (arg b "The second text (unmodified).")
  (returns "A text of the text of a and then b, sharing their nodes, in O(log n) time.")
  (see text-split-at text-insert-text text-join))

(:doc text-insert
  (summary "A text with a string inserted at a cursor.")
  (arg r "The text (unmodified).")
  (arg c "Where to insert, a cursor of r.")
  (arg s "The string to insert.")
  (returns "A text of r's text with s before the character at c, in O(log n) time. Copies the nodes on the path and one chunk.")
  (see text-insert-text text-delete text-replace-range transienttext-insert!))

(:doc text-insert-text
  (summary "A text with another text inserted at a cursor.")
  (arg r "The text (unmodified).")
  (arg c "Where to insert, a cursor of r.")
  (arg x "The text to insert (unmodified).")
  (returns "A text of r's text with x's before the character at c, sharing x's nodes.")
  (see text-insert text-append))

(:doc text-delete
  (summary "A text with the characters between two cursors removed.")
  (arg r "The text (unmodified).")
  (arg a "The first character to remove, a cursor of r.")
  (arg b "The cursor after the last to remove, not before a.")
  (returns "A text of r's text without the characters from a to b, in O(log n) time.")
  (raises System.ArgumentOutOfRangeException "When b is before a.")
  (see text-insert text-replace-range transienttext-delete!))

(:doc text-replace-range
  (summary "A text with the characters between two cursors replaced by a string.")
  (arg r "The text (unmodified).")
  (arg a "The first character to replace, a cursor of r.")
  (arg b "The cursor after the last to replace, not before a.")
  (arg s "The string to put in their place.")
  (returns "A text of r's text with the characters from a to b replaced by s.")
  (raises System.ArgumentOutOfRangeException "When b is before a.")
  (see text-insert text-delete text-replace transienttext-replace-range!))

;; ---------------------------------------------------------------------------
;; As a string has them
;; ---------------------------------------------------------------------------

(:doc text-take
  (summary "The first characters of a text.")
  (arg r "The text (unmodified).")
  (arg n "How many characters.")
  (returns "A text of the first n characters of r, or r when it has fewer. Shares r's chunks, in O(log n) time.")
  (raises System.ArgumentException "When n is negative.")
  (see text-drop text-take-right text-split-at))

(:doc text-drop
  (summary "A text without its first characters.")
  (arg r "The text (unmodified).")
  (arg n "How many characters to leave out.")
  (returns "A text of r after its first n characters, or the empty text when it has fewer.")
  (raises System.ArgumentException "When n is negative.")
  (see text-take text-drop-right text-split-at))

(:doc text-take-right
  (summary "The last characters of a text.")
  (arg r "The text (unmodified).")
  (arg n "How many characters.")
  (returns "A text of the last n characters of r, or r when it has fewer.")
  (raises System.ArgumentException "When n is negative.")
  (see text-drop-right text-take))

(:doc text-drop-right
  (summary "A text without its last characters.")
  (arg r "The text (unmodified).")
  (arg n "How many characters to leave out.")
  (returns "A text of r before its last n characters, or the empty text when it has fewer.")
  (raises System.ArgumentException "When n is negative.")
  (see text-take-right text-drop))

(:doc text-contains?
  (summary "Whether a text contains a string.")
  (arg r "The text.")
  (arg s "The string to find.")
  (returns "#t when s occurs in r. Finds matches that span chunks.")
  (see text-search text-starts-with?))

(:doc text-starts-with?
  (summary "Whether a text starts with a string.")
  (arg r "The text.")
  (arg s "The string.")
  (returns "#t when r's first characters are those of s.")
  (see text-ends-with? text-search))

(:doc text-ends-with?
  (summary "Whether a text ends with a string.")
  (arg r "The text.")
  (arg s "The string.")
  (returns "#t when r's last characters are those of s.")
  (see text-starts-with?))

(:doc text-replace
  (summary "A text with every occurrence of one string replaced by another.")
  (arg r "The text (unmodified).")
  (arg old "The string to replace.")
  (arg new "The string to put in its place.")
  (returns "A text of r with each old, from the start and not overlapping, replaced by new. r itself when there is none.")
  (raises System.ArgumentException "When old is empty.")
  (see text-replace-range text-search text-split)
  (example """
    (text->string (text-replace (string->text "a-b-c") "-" ", "))   ; "a, b, c"
    """)
  (reference """
    Searches through one iteration of r's chunks, and adds the text between
    the matches from another, so the result is built in one pass and shares
    the arrays of the chunks it keeps whole.
    """))

(:doc text-split
  (summary "The fields of a text between occurrences of a separator.")
  (arg r "The text (unmodified).")
  (arg sep "The separator.")
  (returns "The fields in order, empty ones kept: one more than the separators in r. An empty separator gives r as the one field.")
  (see text-split-once text-join text-split-at)
  (example """
    (vec-length (text-split (string->text "a,,b") ","))   ; 3
    (text-split r "\n")                                    ; the lines of r
    """)
  (reference """
    A field inside one chunk shares the chunk's bytes; a field across chunks
    is a string of its own up to 1024 bytes, and shares r's chunks after.
    """))

(:doc text-split-once
  (summary "A text split around the first occurrence of a separator.")
  (arg r "The text (unmodified).")
  (arg sep "The separator.")
  (returns "(Some (Tuple before after)), the texts before and after the first sep, or None when there is none.")
  (see text-split text-split-at))

(:doc text-join
  (summary "Texts joined with a separator between them.")
  (arg parts "The texts, in order (unmodified).")
  (arg sep "The separator.")
  (returns "A text of the parts with sep between each two, built in one pass.")
  (see text-split text-append Texting))

(:doc text-search
  (summary "Where the first occurrence of a string in a text starts.")
  (arg r "The text.")
  (arg needle "The string to look for.")
  (returns "(Some cursor) on the start of the first needle, or None. An empty needle is found at the start.")
  (see text-search-backward text-cursor-search text-index text-contains?))

(:doc text-search-backward
  (summary "Where the last occurrence of a string in a text starts.")
  (arg r "The text.")
  (arg needle "The string to look for.")
  (returns "(Some cursor) on the start of the last needle, or None. An empty needle is found at the end.")
  (see text-search text-cursor-search-backward))

(:doc text-search-any
  (summary "Where the first character of a set is, at or after a cursor.")
  (arg r "The text to search.")
  (arg chars "The set, as a string of its characters. Their order does not matter.")
  (arg start "Where to start, a cursor of r.")
  (returns "(Some cursor) on the first character at or after start that is in chars, or None. An empty set is never found.")
  (see text-search text-index text-cursor-find)
  (reference """
    A set of ASCII characters is searched for in each chunk's bytes, many at
    a time.
    """))

(:doc text-index
  (summary "Where the first character satisfying a predicate is.")
  (arg pred "The test, given each character in turn from the start.")
  (arg r "The text.")
  (returns "(Some cursor) on the first character pred holds for, or None.")
  (see text-cursor-find text-search-any))

(:doc text-trim
  (summary "A text without the white space at both ends.")
  (arg r "The text (unmodified).")
  (returns "A text of r without its leading and trailing white space, as char-whitespace? says. r itself when there is none.")
  (see text-trim-left text-trim-right))

(:doc text-trim-left
  (summary "A text without the white space at its start.")
  (arg r "The text (unmodified).")
  (returns "A text of r from its first character that is not white space.")
  (see text-trim text-trim-right))

(:doc text-trim-right
  (summary "A text without the white space at its end.")
  (arg r "The text (unmodified).")
  (returns "A text of r up to its last character that is not white space.")
  (see text-trim text-trim-left))

(:doc text-pad-left
  (summary "A text padded at the start to a width in characters.")
  (arg r "The text (unmodified).")
  (arg width "The width to pad to.")
  (key with "The character to pad with, a space by default.")
  (returns "A text of r with copies of with before it until it is width characters long; r when it is that long already.")
  (see text-pad-right))

(:doc text-pad-right
  (summary "A text padded at the end to a width in characters.")
  (arg r "The text (unmodified).")
  (arg width "The width to pad to.")
  (key with "The character to pad with, a space by default.")
  (returns "A text of r with copies of with after it until it is width characters long; r when it is that long already.")
  (see text-pad-left))

(:doc text-upcase
  (summary "A text in upper case.")
  (arg r "The text (unmodified).")
  (returns "A text of r with each character uppercased in the invariant culture.")
  (see text-downcase))

(:doc text-downcase
  (summary "A text in lower case.")
  (arg r "The text (unmodified).")
  (returns "A text of r with each character lowercased in the invariant culture.")
  (see text-upcase))

(:doc text-reverse
  (summary "A text with its characters in reverse order.")
  (arg r "The text (unmodified).")
  (returns "A text of r's characters, last first.")
  (see text-backward))

(:doc text-fold
  (summary "Folds over the characters of a text, first to last.")
  (arg f "Called with each character and the accumulator, and returns the next accumulator.")
  (arg init "The first accumulator.")
  (arg r "The text.")
  (returns "The last accumulator.")
  (see text-fold-right text-for-each text-fold-chunks))

(:doc text-fold-right
  (summary "Folds over the characters of a text, last to first.")
  (arg f "Called with each character and the accumulator, and returns the next accumulator.")
  (arg init "The first accumulator.")
  (arg r "The text.")
  (returns "The last accumulator.")
  (see text-fold text-backward))

(:doc text-for-each
  (summary "Calls a function with each character of a text in order.")
  (arg f "Called with each character.")
  (arg r "The text.")
  (see text-fold))

(:doc text->list
  (summary "The characters of a text as a list.")
  (arg r "The text.")
  (returns "A list of r's characters in order.")
  (see text->vec))

(:doc text->vec
  (summary "The characters of a text as a vec.")
  (arg r "The text.")
  (returns "A vec of r's characters in order.")
  (see text->list))

;; ---------------------------------------------------------------------------
;; Lines
;; ---------------------------------------------------------------------------

(:doc text-line
  (summary "The text of a line.")
  (arg r "The text (unmodified).")
  (arg n "The line, counting from 0.")
  (returns "A text of line n, without its newline.")
  (raises System.ArgumentOutOfRangeException "When r has no line n.")
  (see text-cursor-at-line text-line-count text-substring)
  (example """
    (text->string (text-line (string->text "one\ntwo\n") 1))   ; "two"
    (text->string (text-line (string->text "one\ntwo\n") 2))   ; ""
    """))

;; ---------------------------------------------------------------------------
;; Cursors
;; ---------------------------------------------------------------------------

(:doc text-cursor-start
  (summary "A cursor on the first character of a text.")
  (arg r "The text.")
  (returns "The cursor on its first character. For the empty text it is also the end.")
  (see text-cursor-end text-cursor-next text-cursor-forward)
  (example """
    (let go ((c (text-cursor-start r)))
      (unless (text-cursor-end? r c)
        (println (char->string (text-cursor-ref r c)))
        (go (text-cursor-next r c))))
    """))

(:doc text-cursor-end
  (summary "The past-the-end cursor of a text.")
  (arg r "The text.")
  (returns "The cursor after the last character.")
  (see text-cursor-end? text-cursor-prev text-backward))

(:doc text-cursor-at-line
  (summary "A cursor on a line, a number of characters in.")
  (arg r "The text.")
  (arg n "The line, counting from 0.")
  (key column "How many characters into the line. Default 0.")
  (returns "The cursor column characters after the start of line n, or at the end of the line when it is shorter.")
  (raises System.ArgumentOutOfRangeException "When r has no line n.")
  (see text-cursor-line text-cursor-column text-line)
  (example """
    ;; One line down, in the same column, as an editor moves.
    (text-cursor-at-line r (+ (text-cursor-line r c) 1) #:column (text-cursor-column r c))
    """)
  (reference "Finds the line in O(log n) time, then steps through the column."))

(:doc text-cursor-start?
  (summary "Whether a cursor is at the start of its text.")
  (arg r "The text.")
  (arg c "A cursor of r.")
  (returns "#t when there is no character before c.")
  (see text-cursor-end? text-cursor-prev))

(:doc text-cursor-end?
  (summary "Whether a cursor has reached the end of its text.")
  (arg r "The text.")
  (arg c "A cursor of r.")
  (returns "#t when c is the past-the-end cursor, and there is no character at it.")
  (see text-cursor-start? text-cursor-ref))

(:doc text-cursor-ref
  (summary "The character at a cursor.")
  (arg r "The text.")
  (arg c "A cursor of r, not at the end.")
  (returns "The character c is on.")
  (raises System.ArgumentOutOfRangeException "When c is at the end of r.")
  (see text-cursor-ref+next text-cursor-end?))

(:doc text-cursor-next
  (summary "The cursor on the next character.")
  (arg r "The text.")
  (arg c "A cursor of r, not at the end.")
  (returns "The cursor after the character at c, which is the end after the last one.")
  (raises System.ArgumentOutOfRangeException "When c is at the end of r.")
  (see text-cursor-prev text-cursor-ref+next text-cursor-forward))

(:doc text-cursor-prev
  (summary "The cursor on the previous character.")
  (arg r "The text.")
  (arg c "A cursor of r, not at the start.")
  (returns "The cursor on the character before c.")
  (raises System.ArgumentOutOfRangeException "When c is at the start of r.")
  (see text-cursor-next text-cursor-back text-backward))

(:doc text-cursor-ref+next
  (summary "The character at a cursor and the cursor after it, in one call.")
  (arg r "The text.")
  (arg c "A cursor of r, not at the end.")
  (returns "A tuple of the character at c and the cursor on the next one.")
  (raises System.ArgumentOutOfRangeException "When c is at the end of r.")
  (see text-cursor-ref text-cursor-next)
  (example """
    (def (Tuple ch next) (text-cursor-ref+next r c))
    """)
  (reference "One read of the chunk gives both, so it is the fastest step of a loop that wants the characters."))

(:doc text-cursor-forward
  (summary "The cursor n characters after another.")
  (arg r "The text.")
  (arg c "A cursor of r.")
  (arg n "How many characters, 0 or more.")
  (returns "The cursor after the n characters from c.")
  (raises System.ArgumentOutOfRangeException "When there are fewer than n characters after c.")
  (raises System.ArgumentException "When n is negative.")
  (see text-cursor-back text-cursor-next)
  (example """
    (text-cursor-forward r (text-cursor-start r) 1000)   ; character 1000
    """)
  (reference """
    Up to 16 characters are stepped over. A longer move finds its character
    from the root by the character counts of the nodes, in O(log n) time, and
    then in its chunk by counting 8 bytes at a time.
    """))

(:doc text-cursor-back
  (summary "The cursor n characters before another.")
  (arg r "The text.")
  (arg c "A cursor of r.")
  (arg n "How many characters, 0 or more.")
  (returns "The cursor n characters before c.")
  (raises System.ArgumentOutOfRangeException "When there are fewer than n characters before c.")
  (raises System.ArgumentException "When n is negative.")
  (see text-cursor-forward text-cursor-prev)
  (reference "Steps or looks up as text-cursor-forward does."))

(:doc text-cursor-line
  (summary "The line a cursor is on.")
  (arg r "The text.")
  (arg c "A cursor of r.")
  (returns "Its line, counting from 0: the newlines before it. O(log n) time.")
  (see text-cursor-column text-cursor-line-start text-cursor-at-line))

(:doc text-cursor-column
  (summary "How many characters a cursor is into its line.")
  (arg r "The text.")
  (arg c "A cursor of r.")
  (returns "The characters between the start of its line and c, in O(log n) time.")
  (see text-cursor-line text-cursor-at-line))

(:doc text-cursor-line-start
  (summary "The cursor at the start of a cursor's line.")
  (arg r "The text.")
  (arg c "A cursor of r.")
  (returns "The cursor on the first character of its line.")
  (see text-cursor-line-end text-cursor-at-line))

(:doc text-cursor-line-end
  (summary "The cursor at the end of a cursor's line.")
  (arg r "The text.")
  (arg c "A cursor of r.")
  (returns "The cursor on the newline that ends its line, or the end cursor on the last line.")
  (see text-cursor-line-start))

(:doc text-cursor-search
  (summary "Where the first occurrence of a string at or after a cursor starts.")
  (arg r "The text.")
  (arg c "The cursor of r to search from.")
  (arg s "The string to find.")
  (returns "(Some cursor) on the start of the first occurrence that starts at or after c, or None. An empty s is found at c.")
  (see text-cursor-search-backward text-search text-cursor-find))

(:doc text-cursor-search-backward
  (summary "Where the last occurrence of a string before a cursor starts.")
  (arg r "The text.")
  (arg c "The cursor of r to search back from.")
  (arg s "The string to find.")
  (returns "(Some cursor) on the start of the last occurrence that ends at or before c, or None. An empty s is found at c.")
  (see text-cursor-search text-search-backward))

(:doc text-cursor-find
  (summary "The first character at or after a cursor that satisfies a predicate.")
  (arg pred "The test, given each character in turn.")
  (arg r "The text.")
  (arg c "The cursor of r to start at.")
  (returns "(Some cursor) on the first character from c that pred returns #t for, or None.")
  (see text-cursor-find-backward text-cursor-search text-index)
  (example """
    (text-cursor-find char-whitespace? r c)   ; the next space, tab or newline
    """))

(:doc text-cursor-find-backward
  (summary "The last character before a cursor that satisfies a predicate.")
  (arg pred "The test, given each character in turn, going back.")
  (arg r "The text.")
  (arg c "The cursor of r to search back from.")
  (returns "(Some cursor) on the last character before c that pred returns #t for, or None.")
  (see text-cursor-find))

(:doc text-cursor=?
  (summary "Whether two cursors are at the same position.")
  (arg a "A cursor.")
  (arg b "A cursor of the same text.")
  (returns "#t when they are at the same position. The same as =.")
  (see text-cursor<?))

(:doc text-cursor<?
  (summary "Whether one cursor is before another.")
  (arg a "A cursor.")
  (arg b "A cursor of the same text.")
  (returns "#t when a is before b.")
  (see text-cursor<=? text-cursor>? text-cursor=?))

(:doc text-cursor>?
  (summary "Whether one cursor is after another.")
  (arg a "A cursor.")
  (arg b "A cursor of the same text.")
  (returns "#t when a is after b.")
  (see text-cursor>=? text-cursor<?))

(:doc text-cursor<=?
  (summary "Whether one cursor is before another or at it.")
  (arg a "A cursor.")
  (arg b "A cursor of the same text.")
  (returns "#t when a is not after b.")
  (see text-cursor<? text-cursor>=?))

(:doc text-cursor>=?
  (summary "Whether one cursor is after another or at it.")
  (arg a "A cursor.")
  (arg b "A cursor of the same text.")
  (returns "#t when a is not before b.")
  (see text-cursor>? text-cursor<=?))

(:doc text-backward
  (summary "The characters before a cursor, last first, for a loop.")
  (arg r "The text.")
  (arg c "A cursor of r.")
  (returns "A TextBackward: (:for ch (text-backward r c)) goes from the character before c back to the first.")
  (see TextCursor text-cursor-prev text-cursor-find-backward)
  (example """
    (loop (:for ch (text-backward r (text-cursor-end r))) (:acc (stringing ch)))   ; r reversed
    """))

;; ---------------------------------------------------------------------------
;; Chunks
;; ---------------------------------------------------------------------------

(:doc text-fold-chunks
  (summary "Folds over a text's chunks in order.")
  (arg f "Called with each chunk and the accumulator, and returns the next accumulator.")
  (arg init "The first accumulator.")
  (arg r "The text.")
  (returns "The last accumulator.")
  (see text-for-each-chunk text-chunk-count text-fold)
  (reference """
    The chunks are strings that start and end on character boundaries. How
    a text is split into chunks depends on its history; the empty text has
    none.
    """))

(:doc text-for-each-chunk
  (summary "Calls a function with each of a text's chunks in order.")
  (arg f "Called with each chunk.")
  (arg r "The text.")
  (see text-fold-chunks))

(:doc text-chunk-count
  (summary "The number of chunks of a text.")
  (arg r "The text.")
  (returns "The number of chunks r's text is held in.")
  (see text-fold-chunks))

;; ---------------------------------------------------------------------------
;; Builders
;; ---------------------------------------------------------------------------

(:doc textbuilder-empty
  (summary "A new, empty text builder.")
  (returns "A builder with no text.")
  (see textbuilder-add! textbuilder->text))

(:doc textbuilder-add!
  (summary "Adds a string to the end of a builder.")
  (arg b "The builder.")
  (arg s "The string. The chunks of a long string share its bytes.")
  (see textbuilder-add-text! textbuilder->text))

(:doc textbuilder-add-char!
  (summary "Adds a character to the end of a builder.")
  (arg b "The builder.")
  (arg ch "The character.")
  (see textbuilder-add! textbuilder-add-piece!))

(:doc textbuilder-add-text!
  (summary "Adds the text of a text to the end of a builder.")
  (arg b "The builder.")
  (arg r "The text, whose chunks are added in order.")
  (see textbuilder-add!))

(:doc textbuilder-length
  (summary "The bytes added to a builder.")
  (arg b "The builder.")
  (returns "The number of bytes added since it was made or last emptied.")
  (see textbuilder-add!))

(:doc textbuilder->text
  (summary "The text of a builder's text, emptying the builder.")
  (arg b "The builder.")
  (returns "A text of the text added, in order. The builder is then empty and can be used again.")
  (see textbuilder-empty))

;; ---------------------------------------------------------------------------
;; Transients
;; ---------------------------------------------------------------------------

(:doc text->transienttext
  (summary "A transient that starts from a text.")
  (arg r "The text, which the transient's edits do not change.")
  (returns "A transient holding r's text.")
  (see transienttext->text TransientText))

(:doc transienttext->text
  (summary "The text of a transient's text.")
  (arg t "The transient.")
  (returns "A text of t's text. Later edits to t do not change it, and t can be edited further.")
  (see text->transienttext))

(:doc transienttext-insert!
  (summary "Inserts a string into a transient before a character.")
  (arg t "The transient.")
  (arg n "The index of the character to insert before, from 0 to the characters t holds.")
  (arg s "The string to insert.")
  (raises System.ArgumentOutOfRangeException "When n is outside t's text.")
  (see transienttext-delete! text-insert))

(:doc transienttext-delete!
  (summary "Removes a range of characters from a transient.")
  (arg t "The transient.")
  (arg from "The index of the first character to remove.")
  (arg to "The index after the last to remove.")
  (raises System.ArgumentOutOfRangeException "When the range is not in t's text, or ends before it starts.")
  (see transienttext-insert! text-delete))

(:doc transienttext-replace-range!
  (summary "Replaces a range of characters of a transient with a string.")
  (arg t "The transient.")
  (arg from "The index of the first character to replace.")
  (arg to "The index after the last to replace.")
  (arg s "The string to put in their place.")
  (raises System.ArgumentOutOfRangeException "When the range is not in t's text, or ends before it starts.")
  (see transienttext-insert! transienttext-delete! text-replace-range))

(:doc transienttext-append!
  (summary "Adds a string to the end of a transient.")
  (arg t "The transient.")
  (arg s "The string to add.")
  (see transienttext-insert!))

(:doc transienttext-length
  (summary "The length of a transient's text in bytes.")
  (arg t "The transient.")
  (returns "The number of bytes of t's text, in O(1) time.")
  (see transienttext-count text-length))

(:doc transienttext-count
  (summary "The number of characters in a transient's text.")
  (arg t "The transient.")
  (returns "How many characters t holds, in O(1) time: the end of the range its indices take.")
  (see transienttext-length text-count))

;; ---------------------------------------------------------------------------
;; Checks
;; ---------------------------------------------------------------------------

(:doc text-check
  (summary "What is wrong with a text's tree, if anything. For tests.")
  (arg r "The text.")
  (returns "None when r's tree is sound, otherwise (Some why) for the first problem found.")
  (reference """
    Checks the heights, the number of children of every node, the size of
    every chunk, and the byte, newline and character counts. O(n) time.
    """)
  (see text-height))

(:doc text-height
  (summary "The height of a text's tree. For tests.")
  (arg r "The text.")
  (returns "0 for a text that is one string, otherwise the levels of nodes above the chunks.")
  (see text-check))
