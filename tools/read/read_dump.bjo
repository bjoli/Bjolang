;; tools/read/read_dump.bjo — writes the forms of each file named on the
;; command line as (std read) reads them, after a line `== path`. The text is
;; the text of `bjolang --dump-read`. Run by tools/read_conformance.py.

(import (std prelude))
(import (std read))

(defun (main args)
  (loop (:for path args)
        (:do (print (str "== " path "\n"))
             (match (read-source-file path)
               ((Ok forms) (print (syntax-dump forms)))
               ((Err e) (print (str "error: " (read-error-message e) "\n"))))))
  0)
