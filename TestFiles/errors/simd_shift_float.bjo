;; The shifts are for integer lanes: `SimdShift` is implemented where the
;; lanes are `IntLane`. A shift of a double lane would shift the bits of its
;; encoding.

;; EXPECT-ERROR: no implementation of trait 'IntLane' for 'double', needed by the implementation of 'SimdShift'

(import (std prelude))
(import (std simd))

(: half (-> Float64x4 Float64x4))
(defun (half v) (simd-shift-right v 1))

(defun (main)
  (println (simd-ref (half (simd256-splat 4.0)) 0))
  0)
