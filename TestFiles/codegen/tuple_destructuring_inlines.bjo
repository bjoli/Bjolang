;; Imported trait methods whose bodies destructure with `(def (a b) pair)` are
;; spliced, not called.
;;
;; EXPECT-CS: mapbuildersubadd_BANG\(m__[0-9]+, k__[0-9]+, v__[0-9]+\)
;; EXPECT-NO-CS: collectorsubstep
;; EXPECT-NO-CS: Eq_Tuple2

(import (std prelude))

(export squares same?)

(: (-> int (Map int int)))
(defun (squares n)
  (loop (:for i (range 0 n)) (:acc m (mapping (Tuple i (* i i))))))

(: (-> (Tuple int int) (Tuple int int) bool))
(defun (same? a b)
  (= a b))
