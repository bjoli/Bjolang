;; For 238_tag_delegation.bjo: a generic grammar. The importer gives the
;; grammar of the leaves. The metadata carries the grammar, so an importing
;; module reads the leaf's keywords through `Leaf` as this module does.

(import (std prelude))

(export Cond render-cond)

(def/grammar (Cond %leaf)
  (:or (: And (and (Cond %leaf) ...))
       (: Not (not (Cond %leaf)))
       (: Leaf %leaf)))

(: render-cond (-> (-> %leaf string) (Cond %leaf) string))
(defun (render-cond leaf c)
  (match c
    ((And cs) (str "and(" (string-join (list->vec (list-map #(render-cond leaf &) cs)) " ") ")"))
    ((Not c) (str "not(" (render-cond leaf c) ")"))
    ((Leaf l) (leaf l))))
