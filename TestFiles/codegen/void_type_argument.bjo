;; A generic call whose type argument is written out, at void, is
;; instantiated at the unit: void is not a C# type argument. Here the type
;; parameter of `tx-retry` is only in its return type, and the call is in a
;; void position.
;;
;; EXPECT-CS: StmModule\.Retry<Bjoml\.Unit>\(tx\)
;; EXPECT-NO-CS: <void>
(import (std prelude))
(import (std stm))

(export wait-for)

(: wait-for (-> Tx (Loc bool) void))
(defun (wait-for tx l)
  (if (tx-ref tx l) unit (tx-retry tx)))
