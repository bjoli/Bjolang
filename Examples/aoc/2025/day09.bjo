;; Day 9: Movie Theater. Red tiles in order around a loop of horizontal and
;; vertical sides. Part 1: the largest rectangle with red tiles at two opposite
;; corners. Part 2: the largest such rectangle inside the loop.
(import "common.bjo")

(defun (main args)
  (def ps {vecing (let ((v (vec-map parse-long (string-split l ",")))) (Tuple (ref v 0) (ref v 1)))
                  (:for l (input-lines args))})
  (def n (length ps))
  ;; Each side as its box x0, x1, y0, y1.
  (def sides {vecing (Tuple (min ax bx) (max ax bx) (min ay by) (max ay by))
                     (:for i (range 0 n))
                     (:let (Tuple ax ay) (ref ps i))
                     (:let (Tuple bx by) (ref ps (% (+ i 1) n)))})
  ;; Whether a side passes through the open inside of the rectangle.
  (defun (crossed? x0 x1 y0 y1)
    (any? (fun ((Tuple ex0 ex1 ey0 ey1)) (and (< ex0 x1) (> ex1 x0) (< ey0 y1) (> ey1 y0))) sides))
  ;; Whether (px + 1/2, py + 1/2) is inside, by counting the sides to its right.
  (defun (inside? px py)
    (= 1 (% {counting ex0 (:for (Tuple ex0 ex1 ey0 ey1) sides)
                         (:when (and (= ex0 ex1) (> ex0 px) (<= ey0 py) (> ey1 py)))}
            2)))
  (def (part1 part2)
    (loop (:for i (range 0 n))
          (:subloop)
          (:for j (range (+ i 1) n))
          (:let (Tuple ax ay) (ref ps i))
          (:let (Tuple bx by) (ref ps j))
          (:let x0 (min ax bx))
          (:let x1 (max ax bx))
          (:let y0 (min ay by))
          (:let y1 (max ay by))
          (:let s (* (+ 1L (- x1 x0)) (+ 1L (- y1 y0))))
          (:acc part1 (folding 0L (max part1 s)))
          ;; A rectangle of one row or column has no inside to test; the
          ;; largest one is never that thin.
          (:acc part2 (folding 0L (if (and (> s part2) (< x0 x1) (< y0 y1)
                                           (not (crossed? x0 x1 y0 y1))
                                           (inside? x0 y0))
                                      s
                                      part2)))
          => (Tuple part1 part2)))
  (println part1)
  (println part2)
  0)
