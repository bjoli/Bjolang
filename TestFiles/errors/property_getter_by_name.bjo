;; A plain property's accessor called by its name was a C# error (CS0571).
;; Bjolang has two spellings for one, and the error names them.
;; EXPECT-ERROR: 'get_Length' is the getter of the property 'Length', which is read with (.-Length x)
(import/extern (len (: System.String.get_Length (-> System.String int))))

(defun (main args) (println (len (string->clr-string "abc"))) 0)
