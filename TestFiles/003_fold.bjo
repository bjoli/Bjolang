(import (std prelude))
(: foldl (-> (-> %a %b %b) %b (List %a) %b))
(defun (foldl f init lst)
  (if (list-empty? lst)
      init
      (foldl f (f (list-head lst) init) (list-tail lst))))

(defun (main argv)
  (def lst (Cons 1 (Cons 2 (Cons 3 Nil))))
  (displayln (int->string (foldl (fun (x acc) (+ acc x)) 0 lst)))
  0)
