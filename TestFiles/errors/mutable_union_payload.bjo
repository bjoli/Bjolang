;; A union case's payload may not be mutable.
;;
;; A payload is positional and unnamed, so there would be nothing for a write to
;; name: `record-set!` names a field, and a case has none. Refused with the
;; alternative rather than as an unknown marker, because wanting it is
;; reasonable — a case that needs mutable state carries a Record that has it.

;; EXPECT-ERROR: #:mutable on the union case
;; EXPECT-ERROR: a case payload is positional
;; EXPECT-ERROR: Give the case a Record

(import (std prelude))

(type
  (: Shape (Union Empty (Circle int #:mutable))))

(defun (main args) 0)
