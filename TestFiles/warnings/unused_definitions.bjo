;; A definition nothing uses is a warning: a top-level one the module neither
;; exports nor reads, and a local binding its scope never reads. A recursive
;; call does not count as a use. A name starting with _ is kept on purpose,
;; and what a macro wrote is not the program's to answer for.

;; EXPECT-WARNING: 'stale' is defined at unused_definitions.bjo:24:1 and nothing uses it
;; EXPECT-WARNING: 'spin' is defined at unused_definitions.bjo:27:1 and nothing uses it
;; EXPECT-WARNING: 'scratch' is bound to the value at unused_definitions.bjo:46:16 and nothing reads it
;; EXPECT-WARNING: 'b' is bound to the value at unused_definitions.bjo:43:16 and nothing reads it
;; EXPECT-NO-WARNING: 'shown'
;; EXPECT-NO-WARNING: 'helper'
;; EXPECT-NO-WARNING: 'count-down'
;; EXPECT-NO-WARNING: '_kept'
;; EXPECT-NO-WARNING: 'main'
;; EXPECT-NO-WARNING: 'n'
;; EXPECT-NO-WARNING: 'a'
;; EXPECT-NO-WARNING: 'tmp'

(import (std prelude))

(export shown)

(: stale (-> int int))
(defun (stale x) (* x 2))

(: spin (-> int int))
(defun (spin n) (if (= n 0) 0 (spin (- n 1))))

(: helper (-> int int))
(defun (helper x) (+ x 1))

(: shown (-> int string))
(defun (shown x) (int->string (helper x)))

(: count-down (-> int int))
(defun (count-down n) (if (= n 0) 0 (count-down (- n 1))))

(: _kept (-> int int))
(defun (_kept x) x)

(: first-of (-> (Tuple int int) int))
(defun (first-of t)
  (let (((a b) t)) a))

(defun (main)
  (def scratch (* 6 7))
  (def n (count-down 3))
  (loop (:for _ (range 0 2)) (:do (println (shown n))))
  (println (first-of (Tuple 1 2)))
  0)
