;; A signature written without a name, (: type), takes the name of the
;; definition directly below it: a defun, defbjo, def or def/mutable, at the
;; top level, inside a begin, or in a body.
(import (std prelude))
(import (std simpletest))
(import "inc/nameless.bjo")

(: (-> int int))
(defun (add1 x) (+ x 1))

(: (-> %a %a %a) (where (Num %a)))
(defun (plus a b) (+ a b))

;; The arrow of a bjoroutine is written -bjo->, as in a named signature.
(: (-bjo-> int int))
(defbjo (later x) (+ x 2))

(: int)
(def seven 7)

(: (List int))
(def/mutable box '())

(begin
  (: (-> string string))
  (defun (shout s) (str s "!")))

;; A named signature and a nameless one side by side.
(: named (-> int int))
(defun (named x) x)
(: (-> int int))
(defun (unnamed x) x)

(defbjo (main)
  (expect "a defun" (add1 1) 2)
  (expect "with a where clause" (plus 1.5 2.0) 3.5)
  (expect "a defbjo" (later 1) 3)
  (expect "a def" seven 7)
  (set! box (list 1))
  (expect "a def/mutable" box '(1))
  (expect "inside a begin" (shout "hej") "hej!")
  (expect "beside a named one" (+ (named 1) (unnamed 2)) 3)

  ;; In a body.
  (: (-> int int))
  (defun (square x) (* x x))
  (: string)
  (def greeting "hej")
  (expect "a body-local defun" (square 4) 16)
  (expect "a body-local def" greeting "hej")

  ;; From another module.
  (expect "imported" (triple 3) 9)
  (expect "imported, with a pin" (sum-of [1 2 3]) 6)
  0)
