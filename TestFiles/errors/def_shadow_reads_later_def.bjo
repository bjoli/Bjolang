;; EXPECT-ERROR: 'y' is used before its definition

;; The defs after the println are one group, and the group's y is the one
;; written below. Reading it from the def above it is reading it before it has
;; a value, not reading the outer y.

(import (std prelude))

(defun (main args)
  (def y 10)
  (println "between")
  (def a y)
  (def y 20)
  (println (->str a))
  0)
