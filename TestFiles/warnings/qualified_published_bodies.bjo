;; The ->bjodat bodies def/bjodat-type wrote in `inc/bjodat_tagged.bjo` name
;; (text bjodat)'s functions by qualified binding, `Module::name`. Read back
;; from the metadata the name was three tokens, and the bodies could not be
;; inlined here.

;; EXPECT-NO-WARNING: could not inline

(import (std prelude))
(import (text bjodat))
(import "../inc/bjodat_tagged.bjo")

(defun (main)
  (println (bjodat->string (->bjodat (Spot (name "here")))))
  (println (bjodat->string (->bjodat (Place (city "Lund") (zip None)))))
  0)
