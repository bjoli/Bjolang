;; EXPECT-ERROR: has no member 'Absolute'
;;
;; The member is resolved against the interface at the declaration, so a name
;; the interface does not have is reported where it was written rather than at
;; whatever call site first needed it.
(import (std prelude))

(def/trait (Arith %a)
  (#:clr-constraint (System.Numerics.INumber %a))
  (: bare (-> %a %a) #:clr-member Absolute))

(defun (main) 0)
