;; SUMFP, idiomatic: a `loop` with a `:with` counter and a `folding` sum.
;; Arguments: count n expected

(import "../bjolang/common.bjo")

(: run (-> double double))
(defun (run n)
  (loop (:with i n (- i 1.0) (< i 0.0))
        (:acc sum (folding 0.0 (+ sum i)))
        => sum))

(defun (main args)
  (def n (arg-double args 1))
  (def expected (arg-double args 2))
  (run-benchmark "sumfp" (arg-int args 0) (fun () (run n)) #(= & expected)))
