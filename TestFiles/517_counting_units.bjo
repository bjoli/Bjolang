;; Two counts compared, with nothing to say what type they are: the count of
;; a (counting x) is a number its Num settles at unit 1, and an int.
(import (std prelude))
(import (std simpletest))

(: mostly-big? (-> (Vec int) bool))
(defun (mostly-big? xs)
  (match (loop (:for x xs)
               (:acc (counting x))
               (:acc (counting x) #:when (> x 2)))
    ((Tuple all big) (> (* 2 big) all))))

(defun (main)
  (expect "more than half" (mostly-big? [1 3 4 5]) #t)
  (expect "half or fewer" (mostly-big? [1 2 3 4]) #f)
  0)
