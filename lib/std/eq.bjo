;; std/eq.bjo — equality and hashing.
(export = eq-hash
        Ord compare less? greater? at-most? at-least?
        least greatest list-sort list-min list-max)

;; ---------------------------------------------------------------------------
;; Eq — the one equality
;; ---------------------------------------------------------------------------
;; Trait for equality and hashing.
(def/trait (Eq %a)
  (: = (-> %a %a bool))
  (: eq-hash (-> %a int)))


;; ---------------------------------------------------------------------------
;; Ord — the one ordering
;; ---------------------------------------------------------------------------
;; Trait for ordering.
(def/trait (Ord %a)
  (: compare (-> %a %a int)))

;; Ord predicates.
(: less? (-> %a %a bool) (where (Ord %a)))
(defun (less? a b) (< (compare a b) 0))

(: greater? (-> %a %a bool) (where (Ord %a)))
(defun (greater? a b) (> (compare a b) 0))

(: at-most? (-> %a %a bool) (where (Ord %a)))
(defun (at-most? a b) (<= (compare a b) 0))

(: at-least? (-> %a %a bool) (where (Ord %a)))
(defun (at-least? a b) (>= (compare a b) 0))

;; least and greatest (ties to left).
(: least (-> %a %a %a) (where (Ord %a)))
(defun (least a b) (if (at-most? a b) a b))

(: greatest (-> %a %a %a) (where (Ord %a)))
(defun (greatest a b) (if (at-least? a b) a b))

;; --- Sorting ---------------------------------------------------------------
;; Merge sort. Stable. Uses builtins only.
(: list-sort (-> (List %a) (List %a)) (where (Ord %a)))
(defun (list-sort xs)
  (defun (merge as bs)
    (if (list-empty? as)
        bs
        (if (list-empty? bs)
            as
            (if (at-most? (list-head as) (list-head bs))
                (Cons (list-head as) (merge (list-tail as) bs))
                (Cons (list-head bs) (merge as (list-tail bs)))))))

  ;; Uses (< n 1) instead of (= n 0).
  (defun (take n ys)
    (if (< n 1)
        Nil
        (if (list-empty? ys)
            Nil
            (Cons (list-head ys) (take (- n 1) (list-tail ys))))))

  (defun (drop n ys)
    (if (< n 1)
        ys
        (if (list-empty? ys)
            ys
            (drop (- n 1) (list-tail ys)))))

  (def n (list-length xs))
  ;; Base case.
  (if (< n 2)
      xs
      (merge (list-sort (take (/ n 2) xs))
             (list-sort (drop (/ n 2) xs)))))

;; Private left fold for list min/max.
(: fold-left (-> (-> %b %a %b) %b (List %a) %b))
(defun (fold-left f init xs)
  (let go ((rest xs) (acc init))
    (if (list-empty? rest)
        acc
        (go (list-tail rest) (f acc (list-head rest))))))

(: list-min (-> (List %a) (Option %a)) (where (Ord %a)))
(defun (list-min xs)
  (if (list-empty? xs)
      None
      (Some (fold-left least (list-head xs) (list-tail xs)))))

(: list-max (-> (List %a) (Option %a)) (where (Ord %a)))
(defun (list-max xs)
  (if (list-empty? xs)
      None
      (Some (fold-left greatest (list-head xs) (list-tail xs)))))


;; --- The blanket -----------------------------------------------------------
;; Default to .NET equality.
(def/impl (Eq %a)
  (defun (= a b) (clr-equals a b))
  (defun (eq-hash a) (clr-hash a)))


;; --- The primitives --------------------------------------------------------
;; Eq for primitives.

(def/impl (Eq int)
  (defun (= a b) (clr-eq a b))
  (defun (eq-hash a) (clr-hash a)))

(def/impl (Eq long)
  (defun (= a b) (clr-eq a b))
  (defun (eq-hash a) (clr-hash a)))

(def/impl (Eq short)
  (defun (= a b) (clr-eq a b))
  (defun (eq-hash a) (clr-hash a)))

(def/impl (Eq byte)
  (defun (= a b) (clr-eq a b))
  (defun (eq-hash a) (clr-hash a)))

(def/impl (Eq uint)
  (defun (= a b) (clr-eq a b))
  (defun (eq-hash a) (clr-hash a)))

(def/impl (Eq ulong)
  (defun (= a b) (clr-eq a b))
  (defun (eq-hash a) (clr-hash a)))

(def/impl (Eq ushort)
  (defun (= a b) (clr-eq a b))
  (defun (eq-hash a) (clr-hash a)))

;; Eq for double uses Equals (NaN == NaN).
(def/impl (Eq double)
  (defun (= a b) (clr-equals a b))
  (defun (eq-hash a) (clr-hash a)))

(def/impl (Eq bool)
  (defun (= a b) (clr-eq a b))
  (defun (eq-hash a) (clr-hash a)))

;; Eq for string.
(def/impl (Eq string)
  (defun (= a b) (clr-eq a b))
  (defun (eq-hash a) (clr-hash a)))

(def/impl (Eq char)
  (defun (= a b) (clr-eq a b))
  (defun (eq-hash a) (clr-hash a)))

;; Eq for Keyword and Symbol.
(def/impl (Eq Keyword)
  (defun (= a b) (clr-eq a b))
  (defun (eq-hash a) (clr-hash a)))

(def/impl (Eq Symbol)
  (defun (= a b) (clr-eq a b))
  (defun (eq-hash a) (clr-hash a)))

(def/impl (Eq StringCursor)
  (defun (= a b) (clr-eq a b))
  (defun (eq-hash a) (clr-hash a)))

;; Eq for void.
(def/impl (Eq void)
  (defun (= a b) #t)
  (defun (eq-hash a) 0))


;; --- Ord for the primitives ------------------------------------------------
;; Delegates to IComparable.

(def/impl (Ord int)    (defun (compare a b) (.CompareTo a b)))
(def/impl (Ord long)   (defun (compare a b) (.CompareTo a b)))
(def/impl (Ord short)  (defun (compare a b) (.CompareTo a b)))
(def/impl (Ord byte)   (defun (compare a b) (.CompareTo a b)))
(def/impl (Ord uint)   (defun (compare a b) (.CompareTo a b)))
(def/impl (Ord ulong)  (defun (compare a b) (.CompareTo a b)))
(def/impl (Ord ushort) (defun (compare a b) (.CompareTo a b)))

;; Ord for double uses CompareTo.
(def/impl (Ord double) (defun (compare a b) (.CompareTo a b)))

(def/impl (Ord bool)   (defun (compare a b) (.CompareTo a b)))

;; Ord for string uses CompareTo.
(def/impl (Ord string) (defun (compare a b) (.CompareTo a b)))

(def/impl (Ord char)   (defun (compare a b) (.CompareTo a b)))


;; --- The containers --------------------------------------------------------
;; Container equality using element Eq. Uses builtins only.

(def/impl (Eq (List %a))
  (where (Eq %a))
  (defun (= xs ys)
    (if (list-empty? xs)
        (list-empty? ys)
        (and (not (list-empty? ys))
             (and (= (list-head xs) (list-head ys))
                  (= (list-tail xs) (list-tail ys))))))
  (defun (eq-hash xs)
    (fold-left (fun (h x) (hash-combine h (eq-hash x))) 17 xs)))

(def/impl (Eq (Vec %a))
  (where (Eq %a))
  (defun (= xs ys)
    (defun (same-from i)
      (if (= i (vec-length xs))
          #t
          (and (= (vec-ref xs i) (vec-ref ys i))
               (same-from (+ i 1)))))
    (and (= (vec-length xs) (vec-length ys))
         (same-from 0)))
  ;; Manual indexing.
  (defun (eq-hash xs)
    (defun (hash-from i h)
      (if (= i (vec-length xs))
          h
          (hash-from (+ i 1) (hash-combine h (eq-hash (vec-ref xs i))))))
    (hash-from 0 17)))

(def/impl (Eq (Option %a))
  (where (Eq %a))
  (defun (= a b)
    (match a
      ((Some x)
       (match b
         ((Some y) (= x y))
         (None #f)))
      (None (none? b))))
  (defun (eq-hash o)
    (match o
      ((Some x) (hash-combine 1 (eq-hash x)))
      (None 0))))

;; Eq for Tuples.
(def/impl (Eq (Tuple %a %b))
  (where (Eq %a) (Eq %b))
  (defun (= x y)
    (def (a1 b1) x)
    (def (a2 b2) y)
    (and (= a1 a2) (= b1 b2)))
  (defun (eq-hash x)
    (def (a b) x)
    (hash-combine (eq-hash a) (eq-hash b))))

(def/impl (Eq (Tuple %a %b %c))
  (where (Eq %a) (Eq %b) (Eq %c))
  (defun (= x y)
    (def (a1 b1 c1) x)
    (def (a2 b2 c2) y)
    (and (= a1 a2) (and (= b1 b2) (= c1 c2))))
  (defun (eq-hash x)
    (def (a b c) x)
    (hash-combine (hash-combine (eq-hash a) (eq-hash b)) (eq-hash c))))

(def/impl (Eq (Tuple %a %b %c %d))
  (where (Eq %a) (Eq %b) (Eq %c) (Eq %d))
  (defun (= x y)
    (def (a1 b1 c1 d1) x)
    (def (a2 b2 c2 d2) y)
    (and (and (= a1 a2) (= b1 b2)) (and (= c1 c2) (= d1 d2))))
  (defun (eq-hash x)
    (def (a b c d) x)
    (hash-combine (hash-combine (eq-hash a) (eq-hash b))
                  (hash-combine (eq-hash c) (eq-hash d)))))

(def/impl (Eq (Result %e %a))
  (where (Eq %e) (Eq %a))
  (defun (= a b)
    (match a
      ((Ok x)
       (match b
         ((Ok y) (= x y))
         ((Err _) #f)))
      ((Err x)
       (match b
         ((Ok _) #f)
         ((Err y) (= x y))))))
  (defun (eq-hash r)
    (match r
      ((Ok x) (hash-combine 1 (eq-hash x)))
      ((Err e) (hash-combine 2 (eq-hash e))))))
