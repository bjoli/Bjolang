;; std/orderedmap.bjo — the sorted map: a persistent B+ tree, keyed in the keys'
;; order. Lookups are O(log n).
;;
;; - The tree is a B+ tree over the C# nodes of the `BjoOrderedMap` assembly,
;;   through `OrderedMap.NodeOps`. The nodes stay in C# because an internal node
;;   holds its keys and children in inline arrays.
;; - Everything that spans several nodes is here: descent, splits, merges,
;;   rotations, iteration, building and joining trees.
;; - A leaf holds up to 64 entries, an internal node up to 31 keys and 32
;;   children. An edit that leaves a node other than the root with fewer
;;   than 8 keys takes a key from a sibling or merges with it. A tree that is
;;   built, split or joined may have smaller nodes at its right edge.
;; - An edit copies the nodes on its path. A transient's owner lets it edit
;;   the nodes it copied in place. The owner `owner-none` makes `editable`
;;   copy every node it is given.
;; - A leaf's value type is not in its C# base type. Every leaf is annotated
;;   with `(Leaf %k %v)` where a `%v` is in scope, and a function with no
;;   `%v` in its signature otherwise takes `vt`, a `(Option %v)` that is
;;   always `None` and only names the type.

(import (std prelude))

(:doc #:file "orderedmap.bjodoc")

(export
  OrderedMap OrderedMapCursor OrderedMapRange OrderedMapBuilder TransientOrderedMap OrderedMapping
  ;; Maps
  orderedmap-empty orderedmap-length orderedmap-empty? orderedmap-clear
  orderedmap-ref orderedmap-ref-or orderedmap-try-ref orderedmap-contains? orderedmap-has-key?
  orderedmap-set orderedmap-set-all orderedmap-remove orderedmap-remove-all
  orderedmap-keys orderedmap-values
  orderedmap-merge orderedmap-merge-with
  ;; Order
  orderedmap-min orderedmap-max orderedmap-successor orderedmap-predecessor
  orderedmap-range orderedmap-from orderedmap-until
  ;; Iteration and rebuilding
  orderedmap-map orderedmap-map-values orderedmap-filter orderedmap-fold
  orderedmap-for-each orderedmap-iter orderedmap-any? orderedmap-find
  orderedmap-cursor orderedmap-cursor-done? orderedmap-cursor-current orderedmap-cursor-next
  ;; Parts, for work on them at the same time
  orderedmap-split orderedmap-concat
  ;; Conversions
  list->orderedmap orderedmap->list vec->orderedmap orderedmap->vec seq->orderedmap orderedmap->seq
  map->orderedmap orderedmap->map orderedmap->str
  ;; Builders
  orderedmapbuilder-empty orderedmap->orderedmapbuilder orderedmapbuilder-add! orderedmapbuilder-add-all!
  orderedmapbuilder-length orderedmapbuilder->orderedmap
  ;; Transients
  transientorderedmap-empty orderedmap->transientorderedmap transientorderedmap->orderedmap
  transientorderedmap-set! transientorderedmap-set-all! transientorderedmap-remove!
  transientorderedmap-remove-all! transientorderedmap-contains? transientorderedmap-ref
  transientorderedmap-ref-or transientorderedmap-try-ref transientorderedmap-length
  transientorderedmap-empty? transientorderedmap-filter!)

(import/class
  (Exception (: System.Exception))
  (KeyNotFoundException (: System.Collections.Generic.KeyNotFoundException))
  (ArgumentException (: System.ArgumentException))
  (InvalidOperationException (: System.InvalidOperationException))
  ((Node %k) (: OrderedMap.Node))
  ((Leaf %k %v) (: OrderedMap.LeafNode))
  (Owner (: OrderedMap.OwnerId))
  ((Comparer %a) (: System.Collections.Generic.IComparer)))

(import/extern
  (owner-none      (: OrderedMap.NodeOps.OwnerNone    (-> Owner)))
  (owner-next      (: OrderedMap.NodeOps.OwnerNext    (-> Owner)))
  (editable        (: OrderedMap.NodeOps.Editable     (-> (Node %k) Owner (Node %k))))
  (new-leaf        (: OrderedMap.NodeOps.NewLeaf      (-> Owner (Leaf %k %v))))
  (new-internal    (: OrderedMap.NodeOps.NewInternal  (-> Owner (Node %k))))
  (as-leaf         (: OrderedMap.NodeOps.AsLeaf       (-> (Node %k) (Leaf %k %v))))
  (leaf-node       (: OrderedMap.NodeOps.LeafAsNode   (-> (Leaf %k %v) (Node %k))))
  (leaf?           (: OrderedMap.NodeOps.IsLeaf       (-> (Node %k) bool)))
  (node-count      (: OrderedMap.NodeOps.Count        (-> (Node %k) int)))
  (leaf-key        (: OrderedMap.NodeOps.LeafKey      (-> (Leaf %k %v) int %k)))
  (leaf-value      (: OrderedMap.NodeOps.LeafValue    (-> (Leaf %k %v) int %v)))
  (leaf-keys       (: OrderedMap.NodeOps.LeafKeys     (-> (Leaf %k %v) (Array %k))))
  (leaf-values     (: OrderedMap.NodeOps.LeafValues   (-> (Leaf %k %v) (Array %v))))
  (node-key        (: OrderedMap.NodeOps.Key          (-> (Node %k) int %k)))
  (key-of          (: OrderedMap.NodeOps.KeyOf        (-> (Node %k) int %k)))
  (child           (: OrderedMap.NodeOps.Child        (-> (Node %k) int (Node %k))))
  (leaf-find       (: OrderedMap.NodeOps.LeafFind     (-> (Leaf %k %v) %k (Comparer %k) int)))
  (route           (: OrderedMap.NodeOps.Route        (-> (Node %k) %k (Comparer %k) int)))
  (compare-keys    (: OrderedMap.NodeOps.Compare      (-> (Comparer %k) %k %k int)))
  (set-count!      (: OrderedMap.NodeOps.SetCount     (-> (Node %k) int void)))
  (leaf-set!       (: OrderedMap.NodeOps.LeafSet      (-> (Leaf %k %v) int %k %v void)))
  (leaf-set-value! (: OrderedMap.NodeOps.LeafSetValue (-> (Leaf %k %v) int %v void)))
  (set-key!        (: OrderedMap.NodeOps.SetKey       (-> (Node %k) int %k void)))
  (set-child!      (: OrderedMap.NodeOps.SetChild     (-> (Node %k) int (Node %k) void)))
  (leaf-move!      (: OrderedMap.NodeOps.LeafMove     (-> (Leaf %k %v) int (Leaf %k %v) int int void)))
  (key-move!       (: OrderedMap.NodeOps.KeyMove      (-> (Node %k) int (Node %k) int int void)))
  (child-move!     (: OrderedMap.NodeOps.ChildMove    (-> (Node %k) int (Node %k) int int void))))

;; Raise the .NET exceptions the C# map raised, so that a caller's handler
;; still catches them.
(: (-> %a))
(defun (key-not-found)
  (raise (cast Exception (KeyNotFoundException. "The key is not in the map."))))

(: (-> string %a))
(defun (bad-argument why) (raise (cast Exception (ArgumentException. why))))

(def leaf-capacity 64)
(def internal-capacity 32)
(def merge-threshold 8)

;; ---------------------------------------------------------------------------
;; The map
;; ---------------------------------------------------------------------------

;; `%v` is the value type of the leaves under `root`.
(type (: (OrderedMap %k %v) #:opaque
         (Record (: root (Node %k))
                 (: count int)
                 (: comparer (Comparer %k)))))

(: (-> (Comparer %k) (OrderedMap %k %v)))
(defun (empty-with cmp)
  (def (: l (Leaf %k %v)) (new-leaf (owner-none)))
  (OrderedMap (root (leaf-node l)) (count 0) (comparer cmp)))

(: (-> (OrderedMap %k %v)) (where (Ord %k)))
(defun (orderedmap-empty) (empty-with (ord-comparer)))

;; An empty map with the order of `m`.
(: (-> (OrderedMap %k %v) (OrderedMap %k %v)))
(defun (orderedmap-clear m) (empty-with (.comparer m)))

(: (-> (OrderedMap %k %v) int))
(defun (orderedmap-length m) (.count m))

(: (-> (OrderedMap %k %v) bool))
(defun (orderedmap-empty? m) (= (.count m) 0))

;; ---------------------------------------------------------------------------
;; Lookups
;; ---------------------------------------------------------------------------

;; The leaf under `node` that `key` belongs in.
(: (-> (Comparer %k) (Node %k) %k (Leaf %k %v)))
(defun (leaf-for cmp node key)
  (if (leaf? node)
      (as-leaf node)
      (leaf-for cmp (child node (route node key cmp)) key)))

(: (-> (Comparer %k) (Node %k) %k (Option %v)))
(defun (try-ref-in cmp root key)
  (def (: l (Leaf %k %v)) (leaf-for cmp root key))
  (def i (leaf-find l key cmp))
  (if (>= i 0) (Some (leaf-value l i)) None))

(: (-> (Comparer %k) (Node %k) %k %v %v))
(defun (ref-or-in cmp root key fallback)
  (def (: l (Leaf %k %v)) (leaf-for cmp root key))
  (def i (leaf-find l key cmp))
  (if (>= i 0) (leaf-value l i) fallback))

(: (-> (Comparer %k) (Node %k) %k %v))
(defun (ref-in cmp root key)
  (def (: l (Leaf %k %v)) (leaf-for cmp root key))
  (def i (leaf-find l key cmp))
  (if (>= i 0) (leaf-value l i) (key-not-found)))

(: (-> (Comparer %k) (Node %k) %k (Option %v) bool))
(defun (contains-in? cmp root key vt)
  (def (: l (Leaf %k %v)) (leaf-for cmp root key))
  (>= (leaf-find l key cmp) 0))

(: (-> (OrderedMap %k %v) %k (Option %v)))
(defun (orderedmap-try-ref m k) (try-ref-in (.comparer m) (.root m) k))

;; Raises when `key` is not in `m`.
(: (-> (OrderedMap %k %v) %k %v))
(defun (orderedmap-ref m k) (ref-in (.comparer m) (.root m) k))

(: (-> (OrderedMap %k %v) %k %v %v))
(defun (orderedmap-ref-or m k default) (ref-or-in (.comparer m) (.root m) k default))

(: (-> (OrderedMap %k %v) %k bool))
(defun (orderedmap-contains? m k)
  (def (: vt (Option %v)) None)
  (contains-in? (.comparer m) (.root m) k vt))

(: (-> (OrderedMap %k %v) %k bool))
(defun (orderedmap-has-key? m key) (orderedmap-contains? m key))

(: (-> (Node %k) (Node %k)))
(defun (leftmost node) (if (leaf? node) node (leftmost (child node 0))))

(: (-> (Node %k) (Node %k)))
(defun (rightmost node) (if (leaf? node) node (rightmost (child node (node-count node)))))

(: (-> (Node %k) %k))
(defun (first-key node) (key-of (leftmost node) 0))

(: (-> (Node %k) (Option (Tuple %k %v))))
(defun (min-in node)
  (def (: l (Leaf %k %v)) (as-leaf (leftmost node)))
  (if (= (leaf-count l) 0) None (Some (Tuple (leaf-key l 0) (leaf-value l 0)))))

(: (-> (Node %k) (Option (Tuple %k %v))))
(defun (max-in node)
  (def (: l (Leaf %k %v)) (as-leaf (rightmost node)))
  (def n (leaf-count l))
  (if (= n 0) None (Some (Tuple (leaf-key l (- n 1)) (leaf-value l (- n 1))))))

(: (-> (OrderedMap %k %v) (Option (Tuple %k %v))))
(defun (orderedmap-min m) (min-in (.root m)))

(: (-> (OrderedMap %k %v) (Option (Tuple %k %v))))
(defun (orderedmap-max m) (max-in (.root m)))

;; The entry with the least key greater than `key`.
(: (-> (OrderedMap %k %v) %k (Option (Tuple %k %v))))
(defun (orderedmap-successor m k) (successor-in (.comparer m) (.root m) k))

(: (-> (Comparer %k) (Node %k) %k (Option (Tuple %k %v))))
(defun (successor-in cmp node key)
  (if (leaf? node)
      (begin
        (def (: l (Leaf %k %v)) (as-leaf node))
        (def i (leaf-find l key cmp))
        (def at (if (>= i 0) (+ i 1) (- -1 i)))
        (if (< at (leaf-count l)) (Some (Tuple (leaf-key l at) (leaf-value l at))) None))
      (begin
        (def r (route node key cmp))
        (def found (successor-in cmp (child node r) key))
        (if (and (none? found) (< r (node-count node)))
            (min-in (child node (+ r 1)))
            found))))

;; The entry with the greatest key less than `key`.
(: (-> (OrderedMap %k %v) %k (Option (Tuple %k %v))))
(defun (orderedmap-predecessor m k) (predecessor-in (.comparer m) (.root m) k))

(: (-> (Comparer %k) (Node %k) %k (Option (Tuple %k %v))))
(defun (predecessor-in cmp node key)
  (if (leaf? node)
      (begin
        (def (: l (Leaf %k %v)) (as-leaf node))
        (def i (leaf-find l key cmp))
        (def at (if (>= i 0) i (- -1 i)))
        (if (> at 0) (Some (Tuple (leaf-key l (- at 1)) (leaf-value l (- at 1)))) None))
      (begin
        (def r (route node key cmp))
        (def found (predecessor-in cmp (child node r) key))
        (if (and (none? found) (> r 0))
            (max-in (child node (- r 1)))
            found))))

;; ---------------------------------------------------------------------------
;; Slots in one node
;; ---------------------------------------------------------------------------

(: (-> (Leaf %k %v) int))
(defun (leaf-count l) (node-count (leaf-node l)))

(: (-> (Leaf %k %v) int %k %v void))
(defun (leaf-insert! l i key value)
  (def n (leaf-count l))
  (when (< i n) (leaf-move! l i l (+ i 1) (- n i)))
  (leaf-set! l i key value)
  (set-count! (leaf-node l) (+ n 1)))

(: (-> (Leaf %k %v) int void))
(defun (leaf-remove! l i)
  (def n (leaf-count l))
  (when (> (- n i 1) 0) (leaf-move! l (+ i 1) l i (- n i 1)))
  (set-count! (leaf-node l) (- n 1)))

;; Puts `sep` at key slot `i` and `right` at child slot `i + 1`.
(: (-> (Node %k) int %k (Node %k) void))
(defun (internal-insert! node i sep right)
  (def n (node-count node))
  (when (< i n)
    (key-move! node i node (+ i 1) (- n i))
    (child-move! node (+ i 1) node (+ i 2) (- n i)))
  (set-key! node i sep)
  (set-child! node (+ i 1) right)
  (set-count! node (+ n 1)))

;; ---------------------------------------------------------------------------
;; Set
;; ---------------------------------------------------------------------------

;; What `insert!` did:
;; - `(Tuple 0 _ _)`: the key was there, and its value is replaced.
;; - `(Tuple 1 _ _)`: the key is added.
;; - `(Tuple 2 right sep)`: the key is added and the node split. `right` is
;;   the new right half, and `sep` its first key.
(: (-> (Comparer %k) (Node %k) %k %v Owner (Tuple int (Node %k) %k)))
(defun (insert! cmp node key value owner)
  (if (leaf? node)
      (insert-leaf! cmp (as-leaf node) key value owner)
      (begin
        (def i (route node key cmp))
        (def c (editable (child node i) owner))
        (set-child! node i c)
        (def r (insert! cmp c key value owner))
        (def (Tuple code right sep) r)
        (cond
          ((< code 2) r)
          ((< (node-count node) (- internal-capacity 1))
           (internal-insert! node i sep right)
           (Tuple 1 node key))
          (else (split-internal! node i sep right owner))))))

(: (-> (Comparer %k) (Leaf %k %v) %k %v Owner (Tuple int (Node %k) %k)))
(defun (insert-leaf! cmp l key value owner)
  (def i (leaf-find l key cmp))
  (cond
    ((>= i 0)
     (leaf-set-value! l i value)
     (Tuple 0 (leaf-node l) key))
    ((< (leaf-count l) leaf-capacity)
     (leaf-insert! l (- -1 i) key value)
     (Tuple 1 (leaf-node l) key))
    (else (split-leaf! l (- -1 i) key value owner))))

;; Splits a full leaf and inserts at slot `i`. An insert at either end
;; leaves the full half as it is, so that ascending or descending inserts
;; fill their leaves.
(: (-> (Leaf %k %v) int %k %v Owner (Tuple int (Node %k) %k)))
(defun (split-leaf! left i key value owner)
  (def (: right (Leaf %k %v)) (new-leaf owner))
  (def total (leaf-count left))
  (def at (cond ((= i total) total) ((= i 0) 0) (else (shift-right-logical total 1))))
  (def moving (- total at))
  (when (> moving 0) (leaf-move! left at right 0 moving))
  (set-count! (leaf-node left) at)
  (set-count! (leaf-node right) moving)
  (if (or (< i at) (and (= at 0) (= i 0)))
      (leaf-insert! left i key value)
      (leaf-insert! right (- i at) key value))
  (Tuple 2 (leaf-node right) (leaf-key right 0)))

;; Splits a full internal node, and puts `sep` and `new-child` at slot `i`.
(: (-> (Node %k) int %k (Node %k) Owner (Tuple int (Node %k) %k)))
(defun (split-internal! left i sep new-child owner)
  (def right (new-internal owner))
  (def n (node-count left))
  (def at (shift-right-logical n 1))
  (def up (node-key left at))
  (def moving (- n at 1))
  (key-move! left (+ at 1) right 0 moving)
  (child-move! left (+ at 1) right 0 (+ moving 1))
  (set-count! left at)
  (set-count! right moving)
  (if (<= i at)
      (internal-insert! left i sep new-child)
      (internal-insert! right (- i (+ at 1)) sep new-child))
  (Tuple 2 right up))

(: (-> (Node %k) %k (Node %k) Owner (Node %k)))
(defun (new-root left sep right owner)
  (def r (new-internal owner))
  (set-key! r 0 sep)
  (set-child! r 0 left)
  (set-child! r 1 right)
  (set-count! r 1)
  r)

;; Sets `key` in the tree under `root`. Returns the new root, and whether
;; the key is new.
(: (-> (Comparer %k) (Node %k) %k %v Owner (Tuple (Node %k) bool)))
(defun (set-in cmp root key value owner)
  (def r (editable root owner))
  (def (Tuple code right sep) (insert! cmp r key value owner))
  (Tuple (if (= code 2) (new-root r sep right owner) r) (> code 0)))

(: (-> (OrderedMap %k %v) %k %v (OrderedMap %k %v)))
(defun (orderedmap-set m k v)
  (def (Tuple root added?) (set-in (.comparer m) (.root m) k v (owner-none)))
  (OrderedMap (root root)
        (count (if added? (+ (.count m) 1) (.count m)))
        (comparer (.comparer m))))

;; ---------------------------------------------------------------------------
;; Remove
;; ---------------------------------------------------------------------------

;; Removes `key` under `node`, which `owner` may edit. Returns 0 if the key
;; is not there, 1 if it is removed, and 2 if it is removed and `node` is
;; left with fewer than `merge-threshold` keys.
(: (-> (Comparer %k) (Node %k) %k Owner (Option %v) int))
(defun (remove! cmp node key owner vt)
  (if (leaf? node)
      (begin
        (def (: l (Leaf %k %v)) (as-leaf node))
        (def i (leaf-find l key cmp))
        (cond
          ((< i 0) 0)
          (else
           (leaf-remove! l i)
           (if (< (leaf-count l) merge-threshold) 2 1))))
      (begin
        (def i (route node key cmp))
        (def c (editable (child node i) owner))
        (set-child! node i c)
        (def r (remove! cmp c key owner vt))
        (cond
          ((< r 2) r)
          ((underflow! node i owner vt) 2)
          (else 1)))))

(: (-> (Node %k) bool))
(defun (can-lend? node) (> (node-count node) (+ merge-threshold 1)))

;; Child `i` of `parent` has too few keys. Takes one from a sibling that has
;; enough, or else merges with a sibling. Returns whether `parent` has too few
;; keys after.
(: (-> (Node %k) int Owner (Option %v) bool))
(defun (underflow! parent i owner vt)
  (cond
    ((< i (node-count parent))
     (def right (editable (child parent (+ i 1)) owner))
     (set-child! parent (+ i 1) right)
     (balance! parent i (child parent i) right #t vt))
    ((> i 0)
     (def left (editable (child parent (- i 1)) owner))
     (set-child! parent (- i 1) left)
     (balance! parent (- i 1) left (child parent i) #f vt))
    (else #t)))

;; `left` and `right` are the children on each side of key `s` of `parent`.
;; The one `from-right?` names lends a key, or the two merge.
(: (-> (Node %k) int (Node %k) (Node %k) bool (Option %v) bool))
(defun (balance! parent s left right from-right? vt)
  (cond
    ((and from-right? (can-lend? right)) (rotate-left! parent s left right vt) #f)
    ((and (not from-right?) (can-lend? left)) (rotate-right! parent s left right vt) #f)
    (else
     (merge! parent s left right vt)
     (< (node-count parent) merge-threshold))))

;; Moves the first entry of `right` to the end of `left`.
(: (-> (Node %k) int (Node %k) (Node %k) (Option %v) void))
(defun (rotate-left! parent s left right vt)
  (if (leaf? left)
      (begin
        (def (: l (Leaf %k %v)) (as-leaf left))
        (def (: r (Leaf %k %v)) (as-leaf right))
        (leaf-insert! l (leaf-count l) (leaf-key r 0) (leaf-value r 0))
        (leaf-remove! r 0)
        (set-key! parent s (leaf-key r 0)))
      (begin
        (internal-insert! left (node-count left) (node-key parent s) (child right 0))
        (set-key! parent s (node-key right 0))
        (def rn (node-count right))
        (child-move! right 1 right 0 rn)
        (when (> rn 1) (key-move! right 1 right 0 (- rn 1)))
        (set-count! right (- rn 1)))))

;; Moves the last entry of `left` to the front of `right`.
(: (-> (Node %k) int (Node %k) (Node %k) (Option %v) void))
(defun (rotate-right! parent s left right vt)
  (if (leaf? left)
      (begin
        (def (: l (Leaf %k %v)) (as-leaf left))
        (def (: r (Leaf %k %v)) (as-leaf right))
        (def last (- (leaf-count l) 1))
        (leaf-insert! r 0 (leaf-key l last) (leaf-value l last))
        (leaf-remove! l last)
        (set-key! parent s (leaf-key r 0)))
      (begin
        (def last (- (node-count left) 1))
        (def rn (node-count right))
        (key-move! right 0 right 1 rn)
        (set-key! right 0 (node-key parent s))
        (child-move! right 0 right 1 (+ rn 1))
        (set-child! right 0 (child left (+ last 1)))
        (set-count! right (+ rn 1))
        (set-key! parent s (node-key left last))
        (set-count! left last))))

;; Moves all of `right` to the end of `left`, and removes key `s` of
;; `parent` and the child after it.
(: (-> (Node %k) int (Node %k) (Node %k) (Option %v) void))
(defun (merge! parent s left right vt)
  (def ln (node-count left))
  (def rn (node-count right))
  (if (leaf? left)
      (begin
        (def (: l (Leaf %k %v)) (as-leaf left))
        (def (: r (Leaf %k %v)) (as-leaf right))
        (leaf-move! r 0 l ln rn)
        (set-count! left (+ ln rn)))
      (begin
        (set-key! left ln (node-key parent s))
        (key-move! right 0 left (+ ln 1) rn)
        (child-move! right 0 left (+ ln 1) (+ rn 1))
        (set-count! left (+ ln 1 rn))))
  (def pn (node-count parent))
  (def moving (- pn s 1))
  (when (> moving 0)
    (key-move! parent (+ s 1) parent s moving)
    (child-move! parent (+ s 2) parent (+ s 1) moving))
  (set-count! parent (- pn 1)))

;; Removes `key` from the tree under `root`. Returns the new root, and
;; whether the key was there. When it was not, the root is `root`.
(: (-> (Comparer %k) (Node %k) %k Owner (Option %v) (Tuple (Node %k) bool)))
(defun (remove-in cmp root key owner vt)
  (def r (editable root owner))
  (def code (remove! cmp r key owner vt))
  (cond
    ((= code 0) (Tuple root #f))
    ((and (= code 2) (not (leaf? r)) (= (node-count r) 0)) (Tuple (child r 0) #t))
    (else (Tuple r #t))))

(: (-> (OrderedMap %k %v) %k (OrderedMap %k %v)))
(defun (orderedmap-remove m k)
  (def (: vt (Option %v)) None)
  (def (Tuple root removed?) (remove-in (.comparer m) (.root m) k (owner-none) vt))
  (if removed?
      (OrderedMap (root root) (count (- (.count m) 1)) (comparer (.comparer m)))
      m))

;; ---------------------------------------------------------------------------
;; The cursor
;; ---------------------------------------------------------------------------

;; A position in an iteration in key order. A value: `orderedmap-cursor-next` returns
;; the next one.
;;
;; - It holds the key and value arrays of one leaf, so a step inside a leaf
;;   is an increment and a compare.
;; - `path` is the child index at each level above the leaf, 6 bits a level
;;   above the low 4 bits, which hold the leaf's depth. `last-leaf` marks a
;;   leaf with no leaf after it.
;; - At the end of a leaf, `cursor-after` follows `path` from the root again.
(type (: (OrderedMapCursor %k %v) #:opaque
         (Struct (: keys (Array %k))
                 (: values (Array %v))
                 (: i int)
                 (: end int)
                 (: root (Node %k))
                 (: path long))))

(def depth-bits 4)
(def index-bits 6)
(def max-depth 10)
(: last-leaf long)
(def last-leaf -1)

(: (-> long int int))
(defun (index-at path level)
  (cast System.Int32 (bitwise-and (shift-right-logical path (+ depth-bits (* index-bits level))) 63)))

(: (-> long int int long))
(defun (with-index path level index)
  (def shift (+ depth-bits (* index-bits level)))
  (def (: mask long) (shift-left 63 shift))
  (bitwise-ior (bitwise-and path (bitwise-not mask))
               (shift-left (cast System.Int64 index) shift)))

(: (-> long int long))
(defun (with-depth path depth)
  (def (: depth-mask long) 15)
  (bitwise-ior (bitwise-and path (bitwise-not depth-mask)) (cast System.Int64 depth)))

(: (-> (Leaf %k %v) int (Node %k) long (OrderedMapCursor %k %v)))
(defun (cursor-at l i root path)
  (OrderedMapCursor (keys (leaf-keys l)) (values (leaf-values l)) (i i) (end (leaf-count l))
              (root root) (path path)))

(: (-> (Node %k) (OrderedMapCursor %k %v)))
(defun (cursor-of root)
  (if (leaf? root)
      (begin
        (def (: l (Leaf %k %v)) (as-leaf root))
        (cursor-at l 0 root last-leaf))
      (descend root root 0 0)))

(: (-> (OrderedMap %k %v) (OrderedMapCursor %k %v)))
(defun (orderedmap-cursor m) (cursor-of (.root m)))

;; The cursor on the first entry of the leftmost leaf under `node`, which is
;; at `level`, or on the entry after it if that leaf is empty.
(: (-> (Node %k) (Node %k) int long (OrderedMapCursor %k %v)))
(defun (descend node root level path)
  (cond
    ((leaf? node)
     (def (: l (Leaf %k %v)) (as-leaf node))
     (def at (with-depth path level))
     (if (> (leaf-count l) 0)
         (cursor-at l 0 root at)
         (advance l root at)))
    ((= level max-depth)
     (raise (cast Exception (InvalidOperationException. "The map is deeper than a cursor can walk."))))
    (else (descend (child node 0) root (+ level 1) (with-index path level 0)))))

;; The cursor on the first entry after the leaf `l` at `path`, or a done
;; cursor on `l`.
(: (-> (Leaf %k %v) (Node %k) long (OrderedMapCursor %k %v)))
(defun (advance l root path)
  (def depth (cast System.Int32 (bitwise-and path 15)))
  ;; The deepest level whose child index can move right, and its node.
  (def/mutable level -1)
  (def/mutable parent root)
  (def/mutable node root)
  (loop (:for d (range 0 depth))
        (:do (def i (index-at path d))
             (when (< i (node-count node))
               (set! level d)
               (set! parent node))
             (set! node (child node i))))
  (if (< level 0)
      (cursor-at l (leaf-count l) root last-leaf)
      (begin
        (def next (+ (index-at path level) 1))
        (descend (child parent next) root (+ level 1) (with-index path level next)))))

;; The cursor on the first entry whose key is not less than `key`, or with
;; `after?` greater than `key`.
(: (-> (Comparer %k) (Node %k) (Node %k) %k bool int long (OrderedMapCursor %k %v)))
(defun (cursor-from cmp node root key after? level path)
  (if (leaf? node)
      (begin
        (def (: l (Leaf %k %v)) (as-leaf node))
        (def i (leaf-find l key cmp))
        (def at (cond ((< i 0) (- -1 i)) (after? (+ i 1)) (else i)))
        (def p (if (= level 0) last-leaf (with-depth path level)))
        (if (or (< at (leaf-count l)) (= level 0))
            (cursor-at l at root p)
            (advance l root p)))
      (begin
        (def r (route node key cmp))
        (cursor-from cmp (child node r) root key after? (+ level 1) (with-index path level r)))))

(: (-> (OrderedMapCursor %k %v) bool))
(defun (orderedmap-cursor-done? c) (>= (.i c) (.end c)))

(: (-> (OrderedMapCursor %k %v) (Tuple %k %v)))
(defun (orderedmap-cursor-current c)
  (Tuple (array-ref (.keys c) (.i c)) (array-ref (.values c) (.i c))))

(: (-> (OrderedMapCursor %k %v) %k))
(defun (cursor-key c) (array-ref (.keys c) (.i c)))

(: (-> (OrderedMapCursor %k %v) (OrderedMapCursor %k %v)))
(defun (orderedmap-cursor-next c)
  (def i (+ (.i c) 1))
  (if (or (< i (.end c)) (= (.path c) last-leaf))
      (record-set c (i i))
      (cursor-after c)))

;; Out of line, so that a step inside a leaf stays small.
(: (-> (OrderedMapCursor %k %v) (OrderedMapCursor %k %v)))
(defun (cursor-after c)
  (def root (.root c))
  (def depth (cast System.Int32 (bitwise-and (.path c) 15)))
  (def/mutable node root)
  (loop (:for d (range 0 depth)) (:do (set! node (child node (index-at (.path c) d)))))
  (def (: l (Leaf %k %v)) (as-leaf node))
  (advance l root (.path c)))

(impl (Iterable (OrderedMap %k %v))
  (type %elem (Tuple %k %v))
  (type %cursor (OrderedMapCursor %k %v))
  (defun (iterable-start m) (orderedmap-cursor m))
  (defun (iterable-done? m c) (orderedmap-cursor-done? c))
  (defun (iterable-current m c) (orderedmap-cursor-current c))
  (defun (iterable-next m c) (orderedmap-cursor-next c))
  (defun (count m) (orderedmap-length m)))

;; ---------------------------------------------------------------------------
;; Ranges
;; ---------------------------------------------------------------------------

;; The entries from `from` to `to`, both included. `orderedmap-range`,
;; `orderedmap-from` and `orderedmap-until` return one, not a `Seq`: a loop over it
;; inlines the cursor. `(->seq r)` returns a `Seq` of it.
;;
;; - `start` is the cursor on the first entry.
;; - `end-i` and `end-path` are the position of the first entry after the
;;   range. A cursor's position is its slot and path, and two cursors on one
;;   entry have the same position, so a step compares two numbers and no key.
;; - With no upper bound, `end-i` is -1, which no cursor has.
;; - When `from` is greater than `to`, `start` is the end.
(type (: (OrderedMapRange %k %v) #:opaque
         (Struct (: start (OrderedMapCursor %k %v)) (: end-i int) (: end-path long))))

(impl (Iterable (OrderedMapRange %k %v))
  (type %elem (Tuple %k %v))
  (type %cursor (OrderedMapCursor %k %v))
  (defun (iterable-start r) (.start r))
  (defun (iterable-done? r c)
    (or (orderedmap-cursor-done? c) (and (= (.i c) (.end-i r)) (= (.path c) (.end-path r)))))
  (defun (iterable-current r c) (orderedmap-cursor-current c))
  (defun (iterable-next r c) (orderedmap-cursor-next c)))

(: (-> (OrderedMap %k %v) %k bool (OrderedMapCursor %k %v)))
(defun (cursor-at-key m key after?) (cursor-from (.comparer m) (.root m) (.root m) key after? 0 0))

(: (-> (OrderedMapCursor %k %v) (OrderedMapCursor %k %v) (OrderedMapRange %k %v)))
(defun (range-of start end)
  (OrderedMapRange (start start) (end-i (.i end)) (end-path (.path end))))

(: (-> (OrderedMap %k %v) %k %k (OrderedMapRange %k %v)))
(defun (orderedmap-range m lo hi)
  (def end (cursor-at-key m hi #t))
  (range-of (if (> (compare-keys (.comparer m) lo hi) 0) end (cursor-at-key m lo #f)) end))

(: (-> (OrderedMap %k %v) %k (OrderedMapRange %k %v)))
(defun (orderedmap-from m lo)
  (OrderedMapRange (start (cursor-at-key m lo #f)) (end-i -1) (end-path 0)))

(: (-> (OrderedMap %k %v) %k (OrderedMapRange %k %v)))
(defun (orderedmap-until m hi) (range-of (orderedmap-cursor m) (cursor-at-key m hi #t)))

(: (-> (OrderedMap %k %v) (Seq %k)))
(defun (orderedmap-keys m) (seql (:for (Tuple k _) m) (:yield k)))

(: (-> (OrderedMap %k %v) (Seq %v)))
(defun (orderedmap-values m) (seql (:for (Tuple _ v) m) (:yield v)))

;; ---------------------------------------------------------------------------
;; Building trees
;; ---------------------------------------------------------------------------

;; One tree over nodes of one depth, in key order: internal nodes of up to 32
;; children each, as even as they can be, level by level up to one root.
(: (-> (Array (Node %k)) (Node %k)))
(defun (over nodes)
  (def n (array-length nodes))
  (if (= n 1)
      (array-ref nodes 0)
      (begin
        (def parents (/ (+ n (- internal-capacity 1)) internal-capacity))
        (def up (make-array parents))
        (def/mutable offset 0)
        (loop (:for p (range 0 parents))
              (:do (def size (+ (/ n parents) (if (< p (% n parents)) 1 0)))
                   (def parent (new-internal (owner-none)))
                   (loop (:for c (range 0 size))
                         (:do (def node (array-ref nodes (+ offset c)))
                              (set-child! parent c node)
                              (when (> c 0) (set-key! parent (- c 1) (first-key node)))))
                   (set-count! parent (- size 1))
                   (array-set! up p parent)
                   (set! offset (+ offset size))))
        (over up))))

;; A map of the first `n` keys and values, in ascending key order, in full
;; leaves.
(: (-> (Array %k) (Array %v) int (Comparer %k) (OrderedMap %k %v)))
(defun (from-sorted ks vs n cmp)
  (if (= n 0)
      (empty-with cmp)
      (begin
        (def count (/ (+ n (- leaf-capacity 1)) leaf-capacity))
        (def leaves (make-array count))
        (loop (:for i (range 0 count))
              (:do (def (: l (Leaf %k %v)) (new-leaf (owner-none)))
                   (def at (* i leaf-capacity))
                   (def size (min leaf-capacity (- n at)))
                   (array-copy! ks at (leaf-keys l) 0 size)
                   (array-copy! vs at (leaf-values l) 0 size)
                   (set-count! (leaf-node l) size)
                   (array-set! leaves i (leaf-node l))))
        (OrderedMap (root (over leaves)) (count n) (comparer cmp)))))

;; ---------------------------------------------------------------------------
;; Builders
;; ---------------------------------------------------------------------------

;; Entries added in any order, made into a map at the end. The last value of
;; a key wins. Entries added in ascending key order need no sort.
(type (: (OrderedMapBuilder %k %v) #:opaque
         (Record (: keys (Array %k) #:mutable)
                 (: values (Array %v) #:mutable)
                 (: count int #:mutable)
                 (: ascending? bool #:mutable)
                 (: comparer (Comparer %k)))))

(: (-> (Comparer %k) int (OrderedMapBuilder %k %v)))
(defun (builder-with cmp capacity)
  (OrderedMapBuilder (keys (make-array capacity)) (values (make-array capacity)) (count 0)
               (ascending? #t) (comparer cmp)))

(: (-> (OrderedMapBuilder %k %v)) (where (Ord %k)))
(defun (orderedmapbuilder-empty) (builder-with (ord-comparer) 16))

;; A builder that holds the entries of `m`.
(: (-> (OrderedMap %k %v) (OrderedMapBuilder %k %v)))
(defun (orderedmap->orderedmapbuilder m)
  (def b (builder-with (.comparer m) (max 16 (.count m))))
  (loop (:for (Tuple k v) m) (:do (orderedmapbuilder-add! b k v)))
  b)

(: (-> (OrderedMapBuilder %k %v) %k %v void))
(defun (orderedmapbuilder-add! b k v)
  (def n (.count b))
  (when (= n (array-length (.keys b)))
    (record-set! b (keys (array-resize (.keys b) (* 2 n))) (values (array-resize (.values b) (* 2 n)))))
  (when (and (.ascending? b) (> n 0)
             (>= (compare-keys (.comparer b) (array-ref (.keys b) (- n 1)) k) 0))
    (record-set! b (ascending? #f)))
  (array-set! (.keys b) n k)
  (array-set! (.values b) n v)
  (record-set! b (count (+ n 1))))

(: (-> (OrderedMapBuilder %k %v) (Seq (Tuple %k %v)) void))
(defun (orderedmapbuilder-add-all! b kvs)
  (loop (:for (Tuple k v) kvs) (:do (orderedmapbuilder-add! b k v))))

;; The number of entries added, a key added twice counted twice.
(: (-> (OrderedMapBuilder %k %v) int))
(defun (orderedmapbuilder-length b) (.count b))

(: (-> (OrderedMapBuilder %k %v) (OrderedMap %k %v)))
(defun (orderedmapbuilder->orderedmap b)
  (def cmp (.comparer b))
  (def n (.count b))
  (def ks (.keys b))
  (def vs (.values b))
  (if (.ascending? b)
      (from-sorted ks vs n cmp)
      (begin
        ;; The slots in key order, equal keys in the order they were added.
        (def order (loop (:for i (range 0 n)) (:acc (arraying i))))
        (array-sort-by! (fun (x y) (compare-keys cmp (array-ref ks x) (array-ref ks y))) order)
        (def uk (make-array n))
        (def uv (make-array n))
        (def/mutable u 0)
        (loop (:for j order)
              (:do (when (or (= u 0) (not (= (compare-keys cmp (array-ref ks j) (array-ref uk (- u 1))) 0)))
                     (set! u (+ u 1)))
                   (array-set! uk (- u 1) (array-ref ks j))
                   (array-set! uv (- u 1) (array-ref vs j))))
        (from-sorted uk uv u cmp))))

;; ---------------------------------------------------------------------------
;; Transients
;; ---------------------------------------------------------------------------

;; A map that edits in place the nodes it copied. `transientorderedmap->orderedmap`
;; returns a map of its contents and gives it a new owner, so that the map
;; does not change after.
(type (: (TransientOrderedMap %k %v) #:opaque
         (Record (: root (Node %k) #:mutable)
                 (: count int #:mutable)
                 (: owner Owner #:mutable)
                 (: comparer (Comparer %k)))))

(: (-> (TransientOrderedMap %k %v)) (where (Ord %k)))
(defun (transientorderedmap-empty) (orderedmap->transientorderedmap (orderedmap-empty)))

(: (-> (OrderedMap %k %v) (TransientOrderedMap %k %v)))
(defun (orderedmap->transientorderedmap m)
  (TransientOrderedMap (root (.root m)) (count (.count m)) (owner (owner-next)) (comparer (.comparer m))))

(: (-> (TransientOrderedMap %k %v) (OrderedMap %k %v)))
(defun (transientorderedmap->orderedmap t)
  (record-set! t (owner (owner-next)))
  (OrderedMap (root (.root t)) (count (.count t)) (comparer (.comparer t))))

(: (-> (TransientOrderedMap %k %v) %k %v void))
(defun (transientorderedmap-set! t k v)
  (def (Tuple root added?) (set-in (.comparer t) (.root t) k v (.owner t)))
  (record-set! t (root root))
  (when added? (record-set! t (count (+ (.count t) 1)))))

(: (-> (TransientOrderedMap %k %v) %k void))
(defun (transientorderedmap-remove! t k)
  (def (: vt (Option %v)) None)
  (def (Tuple root removed?) (remove-in (.comparer t) (.root t) k (.owner t) vt))
  (when removed? (record-set! t (root root) (count (- (.count t) 1)))))

(: (-> (TransientOrderedMap %k %v) (Seq (Tuple %k %v)) void))
(defun (transientorderedmap-set-all! t kvs)
  (loop (:for (Tuple k v) kvs) (:do (transientorderedmap-set! t k v))))

(: (-> (TransientOrderedMap %k %v) (Seq %k) void))
(defun (transientorderedmap-remove-all! t ks)
  (loop (:for k ks) (:do (transientorderedmap-remove! t k))))

(: (-> (TransientOrderedMap %k %v) %k bool))
(defun (transientorderedmap-contains? t k)
  (def (: vt (Option %v)) None)
  (contains-in? (.comparer t) (.root t) k vt))

(: (-> (TransientOrderedMap %k %v) %k %v))
(defun (transientorderedmap-ref t k) (ref-in (.comparer t) (.root t) k))

(: (-> (TransientOrderedMap %k %v) %k %v %v))
(defun (transientorderedmap-ref-or t k default) (ref-or-in (.comparer t) (.root t) k default))

(: (-> (TransientOrderedMap %k %v) %k (Option %v)))
(defun (transientorderedmap-try-ref t k) (try-ref-in (.comparer t) (.root t) k))

(: (-> (TransientOrderedMap %k %v) int))
(defun (transientorderedmap-length t) (.count t))

(: (-> (TransientOrderedMap %k %v) bool))
(defun (transientorderedmap-empty? t) (= (.count t) 0))

;; Removes the entries `keep?` rejects. Calls it in key order, before it
;; removes any.
(: (-> (-?-> %k %v bool) (TransientOrderedMap %k %v) void))
(defun (transientorderedmap-filter! keep? t)
  (def/mutable dropped '())
  (loop (:for (Tuple k v) (OrderedMap (root (.root t)) (count (.count t)) (comparer (.comparer t))))
        (:do (unless (keep? k v) (set! dropped (cons k dropped)))))
  (loop (:for k dropped) (:do (transientorderedmap-remove! t k))))

;; ---------------------------------------------------------------------------
;; Iteration
;; ---------------------------------------------------------------------------

;; Folds `f` over the entries in key order. Recursive over the tree, which
;; is about twice as fast as the cursor: it reads each leaf's arrays once.
(: (-> (-?-> %k %v %s %s) %s (OrderedMap %k %v) %s))
(defun (orderedmap-fold f init m) (fold-node f init (.root m)))

(: (-> (-?-> %k %v %s %s) %s (Node %k) %s))
(defun (fold-node f acc node)
  (if (leaf? node)
      (begin
        (def (: l (Leaf %k %v)) (as-leaf node))
        (def ks (leaf-keys l))
        (def vs (leaf-values l))
        (loop (:for i (range 0 (leaf-count l)))
              (:acc s (folding acc (f (array-ref ks i) (array-ref vs i) s)))
              => s))
      (loop (:for i (range 0 (+ (node-count node) 1)))
            (:acc s (folding acc (fold-node f s (child node i))))
            => s)))

(: (-> (-?-> %k %v void) (OrderedMap %k %v) void))
(defun (orderedmap-for-each f m)
  (loop (:for (Tuple k v) m) (:do (f k v))))

;; Calls `f` in key order until it returns #f. Returns whether it never did.
(: (-> (-?-> %k %v bool) (OrderedMap %k %v) bool))
(defun (orderedmap-iter f m)
  (let go ((c (orderedmap-cursor m)))
    (cond
      ((orderedmap-cursor-done? c) #t)
      (:def (Tuple k v) (orderedmap-cursor-current c))
      ((f k v) (go (orderedmap-cursor-next c)))
      (else #f))))

(: (-> (-?-> %k %v bool) (OrderedMap %k %v) bool))
(defun (orderedmap-any? pred m)
  (let go ((c (orderedmap-cursor m)))
    (cond
      ((orderedmap-cursor-done? c) #f)
      (:def (Tuple k v) (orderedmap-cursor-current c))
      ((pred k v) #t)
      (else (go (orderedmap-cursor-next c))))))

;; The first entry in key order that `pred` accepts.
(: (-> (-?-> %k %v bool) (OrderedMap %k %v) (Option (Tuple %k %v))))
(defun (orderedmap-find pred m)
  (let go ((c (orderedmap-cursor m)))
    (cond
      ((orderedmap-cursor-done? c) None)
      (:def (Tuple k v) (orderedmap-cursor-current c))
      ((pred k v) (Some (Tuple k v)))
      (else (go (orderedmap-cursor-next c))))))

;; A map of the same keys, with `f` of each entry. A tree of the same shape:
;; the keys are copied and `f` is called in key order.
(: (-> (-?-> %k %v %w) (OrderedMap %k %v) (OrderedMap %k %w)))
(defun (orderedmap-map f m)
  (def (: vt (Option %v)) None)
  (def (: wt (Option %w)) None)
  (OrderedMap (root (map-node f (.root m) vt wt)) (count (.count m)) (comparer (.comparer m))))

(: (-> (-?-> %k %v %w) (Node %k) (Option %v) (Option %w) (Node %k)))
(defun (map-node f node vt wt)
  (if (leaf? node)
      (begin
        (def (: l (Leaf %k %v)) (as-leaf node))
        (def (: out (Leaf %k %w)) (new-leaf (owner-none)))
        (def n (leaf-count l))
        (def ks (leaf-keys l))
        (def vs (leaf-values l))
        (def ws (leaf-values out))
        (array-copy! ks 0 (leaf-keys out) 0 n)
        (loop (:for i (range 0 n)) (:do (array-set! ws i (f (array-ref ks i) (array-ref vs i)))))
        (set-count! (leaf-node out) n)
        (leaf-node out))
      (begin
        (def out (new-internal (owner-none)))
        (def n (node-count node))
        (key-move! node 0 out 0 n)
        (loop (:for i (range 0 (+ n 1))) (:do (set-child! out i (map-node f (child node i) vt wt))))
        (set-count! out n)
        out)))

(: (-> (-?-> %v %w) (OrderedMap %k %v) (OrderedMap %k %w)))
(defun (orderedmap-map-values f m)
  (def (: vt (Option %v)) None)
  (def (: wt (Option %w)) None)
  (OrderedMap (root (map-values-node f (.root m) vt wt)) (count (.count m)) (comparer (.comparer m))))

(: (-> (-?-> %v %w) (Node %k) (Option %v) (Option %w) (Node %k)))
(defun (map-values-node f node vt wt)
  (if (leaf? node)
      (begin
        (def (: l (Leaf %k %v)) (as-leaf node))
        (def (: out (Leaf %k %w)) (new-leaf (owner-none)))
        (def n (leaf-count l))
        (def vs (leaf-values l))
        (def ws (leaf-values out))
        (array-copy! (leaf-keys l) 0 (leaf-keys out) 0 n)
        (loop (:for i (range 0 n)) (:do (array-set! ws i (f (array-ref vs i)))))
        (set-count! (leaf-node out) n)
        (leaf-node out))
      (begin
        (def out (new-internal (owner-none)))
        (def n (node-count node))
        (key-move! node 0 out 0 n)
        (loop (:for i (range 0 (+ n 1))) (:do (set-child! out i (map-values-node f (child node i) vt wt))))
        (set-count! out n)
        out)))

;; The entries `keep?` accepts, in new leaves filled one after the other.
;; Returns `m` when it accepts every entry.
(: (-> (-?-> %k %v bool) (OrderedMap %k %v) (OrderedMap %k %v)))
(defun (orderedmap-filter keep? m)
  (def n (.count m))
  (def (: ks (Array %k)) (make-array n))
  (def (: vs (Array %v)) (make-array n))
  (def/mutable kept 0)
  (loop (:for (Tuple k v) m)
        (:do (when (keep? k v)
               (array-set! ks kept k)
               (array-set! vs kept v)
               (set! kept (+ kept 1)))))
  (if (= kept n) m (from-sorted ks vs kept (.comparer m))))

;; ---------------------------------------------------------------------------
;; Merges
;; ---------------------------------------------------------------------------

;; The entries of all the maps. The last map's value of a key wins.
(: (-> (OrderedMap %k %v) (OrderedMap %k %v) #:rest (OrderedMap %k %v) (OrderedMap %k %v)))
(defun (orderedmap-merge m other #:rest more)
  (merge-all (fun (k a b) b) (inputs-of m other more)))

;; The entries of all the maps. The values of a key are combined by `f`,
;; first to last.
(: (-> (-?-> %k %v %v %v) (OrderedMap %k %v) (OrderedMap %k %v) #:rest (OrderedMap %k %v) (OrderedMap %k %v)))
(defun (orderedmap-merge-with f m other #:rest more)
  (merge-all f (inputs-of m other more)))

(: (-> (OrderedMap %k %v) (OrderedMap %k %v) (Array (OrderedMap %k %v)) (Array (OrderedMap %k %v))))
(defun (inputs-of m other more)
  (def all (cons m (cons other (loop (:for x more) (:acc (listing x))))))
  (def kept (loop (:for x all) (:when (> (.count x) 0)) (:acc (arraying x))))
  (if (= (array-length kept) 0) (vec->array [m]) kept))

;; At most this many inputs are iterated at once, and only when the inputs
;; other than the biggest hold this percent of the keys or more. Else the
;; others are set into a transient of the biggest.
(def merge-max-inputs 32)
(def merge-percent 30)

(: (-> (-?-> %k %v %v %v) (Array (OrderedMap %k %v)) (OrderedMap %k %v)))
(defun (merge-all f inputs)
  (def k (array-length inputs))
  (cond
    ((= k 1) (array-ref inputs 0))
    (else
     (def total (loop (:for x inputs) (:acc (summing (.count x)))))
     (def biggest (loop (:for x inputs) (:acc b (folding 0 (max b (.count x)))) => b))
     (if (and (<= k merge-max-inputs) (>= (* 100 (- total biggest)) (* merge-percent total)))
         (merge-walk f inputs total)
         (merge-into f inputs)))))

;; The inputs set one after the other into a transient of the first, the
;; values of a key combined in input order.
(: (-> (-?-> %k %v %v %v) (Array (OrderedMap %k %v)) (OrderedMap %k %v)))
(defun (merge-into f inputs)
  (def t (orderedmap->transientorderedmap (array-ref inputs 0)))
  (loop (:for i (range 1 (array-length inputs)))
        (:do (loop (:for (Tuple k v) (array-ref inputs i))
                   (:do (match (transientorderedmap-try-ref t k)
                          ((Some old) (transientorderedmap-set! t k (f k old v)))
                          (None (transientorderedmap-set! t k v)))))))
  (transientorderedmap->orderedmap t))

;; The inputs iterated in key order at once into a builder, which needs no
;; sort. The least key is found by a scan of the cursors.
(: (-> (-?-> %k %v %v %v) (Array (OrderedMap %k %v)) int (OrderedMap %k %v)))
(defun (merge-walk f inputs total)
  (def k (array-length inputs))
  (def cmp (.comparer (array-ref inputs 0)))
  (def cursors (loop (:for x inputs) (:acc (arraying (orderedmap-cursor x)))))
  (def b (builder-with cmp total))
  (def/mutable live k)
  (loop (:while (> live 0))
        (:do
         ;; The least key of the cursors that are not done.
         (def/mutable least -1)
         (loop (:for i (range 0 k))
               (:do (def c (array-ref cursors i))
                    (when (and (not (orderedmap-cursor-done? c))
                               (or (< least 0)
                                   (< (compare-keys cmp (cursor-key c) (cursor-key (array-ref cursors least))) 0)))
                      (set! least i))))
         (def key (cursor-key (array-ref cursors least)))
         ;; Its values, in input order, and the cursors stepped past it.
         (def/mutable value (tuple-second (orderedmap-cursor-current (array-ref cursors least))))
         (array-set! cursors least (orderedmap-cursor-next (array-ref cursors least)))
         (when (orderedmap-cursor-done? (array-ref cursors least)) (set! live (- live 1)))
         (loop (:for i (range (+ least 1) k))
               (:do (def c (array-ref cursors i))
                    (when (and (not (orderedmap-cursor-done? c)) (= (compare-keys cmp (cursor-key c) key) 0))
                      (set! value (f key value (tuple-second (orderedmap-cursor-current c))))
                      (array-set! cursors i (orderedmap-cursor-next c))
                      (when (orderedmap-cursor-done? (array-ref cursors i)) (set! live (- live 1))))))
         (orderedmapbuilder-add! b key value)))
  (orderedmapbuilder->orderedmap b))

(: (-> (Tuple %a %b) %b))
(defun (tuple-second t) (def (Tuple _ b) t) b)

;; ---------------------------------------------------------------------------
;; Parts
;; ---------------------------------------------------------------------------

(: (-> (Node %k) int))
(defun (count-keys node)
  (if (leaf? node)
      (node-count node)
      (loop (:for i (range 0 (+ (node-count node) 1))) (:acc (summing (count-keys (child node i)))))))

;; The leaves under an internal node, or the keys of a leaf.
(: (-> (Node %k) int))
(defun (weight node)
  (cond
    ((leaf? node) (node-count node))
    ((leaf? (child node 0)) (+ (node-count node) 1))
    (else (loop (:for i (range 0 (+ (node-count node) 1))) (:acc (summing (weight (child node i))))))))

;; About `k` maps in key order that together hold the entries of `m` once.
;; They share its nodes: a part is a run of the nodes of the highest level
;; with at least `k` nodes, under new internal nodes. The runs are cut where
;; the running weight passes i * total / k, so the parts are close in size.
(: (-> (OrderedMap %k %v) int (Array (OrderedMap %k %v))))
(defun (orderedmap-split m k)
  (def root (.root m))
  (if (or (<= k 1) (leaf? root))
      (vec->array [m])
      (begin
        (def level (level-of (vec->array [root]) k))
        (def n (array-length level))
        (if (= n 1)
            (vec->array [m])
            (begin
              (def weights (loop (:for x level) (:acc (arraying (weight x)))))
              (def total (loop (:for w weights) (:acc (summing w))))
              (def parts (min k n))
              (def/mutable out '())
              (def/mutable made 0)
              (def/mutable start 0)
              (def/mutable done 0)
              (loop (:for j (range 0 n))
                    (:do (set! done (+ done (array-ref weights j)))
                         (when (or (= j (- n 1))
                                   (and (< made (- parts 1))
                                        (>= (* (cast System.Int64 done) (cast System.Int64 parts))
                                            (* (cast System.Int64 total) (cast System.Int64 (+ made 1))))))
                           (def node (over (loop (:for x (range start (+ j 1))) (:acc (arraying (array-ref level x))))))
                           (set! out (cons (OrderedMap (root node) (count (count-keys node)) (comparer (.comparer m))) out))
                           (set! made (+ made 1))
                           (set! start (+ j 1)))))
              (loop (:for x (list-reverse out)) (:acc (arraying x))))))))

;; The highest level, from `level` down, with at least `k` nodes, or the
;; leaves.
(: (-> (Array (Node %k)) int (Array (Node %k))))
(defun (level-of level k)
  (if (or (>= (array-length level) k) (leaf? (array-ref level 0)))
      level
      (begin
        (def/mutable below '())
        (loop (:for x level)
              (:do (loop (:for i (range 0 (+ (node-count x) 1)))
                         (:do (set! below (cons (child x i) below))))))
        (level-of (list->nodes (list-reverse below)) k))))

;; One map of the maps' entries, in order. Each map's keys must be less than
;; every key of the next. The leaves are kept: an empty one is dropped, and
;; a small one is copied together with its neighbour when the two fit in one
;; leaf.
(: (-> (Array (OrderedMap %k %v)) (OrderedMap %k %v)))
(defun (orderedmap-concat maps)
  (when (= (array-length maps) 0) (bad-argument "orderedmap-concat needs at least one map."))
  (def cmp (.comparer (array-ref maps 0)))
  (def (: vt (Option %v)) None)
  (def/mutable leaves '())
  (def/mutable count 0)
  (def/mutable (: last (Option %k)) None)
  (loop (:for m maps)
        (:when (> (.count m) 0))
        (:do (def lo (first-key (.root m)))
             (when (and (some? last) (>= (compare-keys cmp (option-ref-or last lo) lo) 0))
               (bad-argument "The maps are not in key order: a key of one is not less than every key of the next."))
             (def hi (key-of (rightmost (.root m)) (- (node-count (rightmost (.root m))) 1)))
             (set! last (Some hi))
             (set! leaves (leaves-of (.root m) leaves))
             (set! count (+ count (.count m)))))
  (def joined (join-small (list-reverse leaves) vt))
  (if (list-empty? joined)
      (empty-with cmp)
      (OrderedMap (root (over (list->nodes joined))) (count count) (comparer cmp))))

(: (-> (List (Node %k)) (Array (Node %k))))
(defun (list->nodes xs) (loop (:for x xs) (:acc (arraying x))))

;; The non-empty leaves under `node`, in reverse key order, onto `acc`.
(: (-> (Node %k) (List (Node %k)) (List (Node %k))))
(defun (leaves-of node acc)
  (cond
    ((leaf? node) (if (> (node-count node) 0) (cons node acc) acc))
    (else (loop (:for i (range 0 (+ (node-count node) 1)))
                (:acc a (folding acc (leaves-of (child node i) a)))
                => a))))

;; `leaves` with each small leaf copied together with the one before it when
;; the two fit in one leaf.
(: (-> (List (Node %k)) (Option %v) (List (Node %k))))
(defun (join-small leaves vt)
  (list-reverse
   (loop (:for x leaves)
         (:acc out (folding '()
                            (if (and (not (list-empty? out))
                                     (or (< (node-count (list-head out)) merge-threshold)
                                         (< (node-count x) merge-threshold))
                                     (<= (+ (node-count (list-head out)) (node-count x)) leaf-capacity))
                                (cons (both (list-head out) x vt) (list-tail out))
                                (cons x out))))
         => out)))

;; A new leaf with the entries of `a` and then those of `b`.
(: (-> (Node %k) (Node %k) (Option %v) (Node %k)))
(defun (both a b vt)
  (def (: la (Leaf %k %v)) (as-leaf a))
  (def (: lb (Leaf %k %v)) (as-leaf b))
  (def (: l (Leaf %k %v)) (new-leaf (owner-none)))
  (def na (leaf-count la))
  (def nb (leaf-count lb))
  (leaf-move! la 0 l 0 na)
  (leaf-move! lb 0 l na nb)
  (set-count! (leaf-node l) (+ na nb))
  (leaf-node l))

;; ---------------------------------------------------------------------------
;; Conversions
;; ---------------------------------------------------------------------------

;; Sets each entry, in order, by a transient.
(: (-> (OrderedMap %k %v) (Seq (Tuple %k %v)) (OrderedMap %k %v)))
(defun (orderedmap-set-all m kvs)
  (def t (orderedmap->transientorderedmap m))
  (transientorderedmap-set-all! t kvs)
  (transientorderedmap->orderedmap t))

(: (-> (OrderedMap %k %v) (Seq %k) (OrderedMap %k %v)))
(defun (orderedmap-remove-all m ks)
  (def t (orderedmap->transientorderedmap m))
  (transientorderedmap-remove-all! t ks)
  (transientorderedmap->orderedmap t))

(: (-> (List (Tuple %k %v)) (OrderedMap %k %v)) (where (Ord %k)))
(defun (list->orderedmap xs)
  (def b (orderedmapbuilder-empty))
  (loop (:for (Tuple k v) xs) (:do (orderedmapbuilder-add! b k v)))
  (orderedmapbuilder->orderedmap b))

(: (-> (Vec (Tuple %k %v)) (OrderedMap %k %v)) (where (Ord %k)))
(defun (vec->orderedmap v)
  (def b (orderedmapbuilder-empty))
  (loop (:for (Tuple key value) v) (:do (orderedmapbuilder-add! b key value)))
  (orderedmapbuilder->orderedmap b))

(: (-> (Seq (Tuple %k %v)) (OrderedMap %k %v)) (where (Ord %k)))
(defun (seq->orderedmap xs)
  (def b (orderedmapbuilder-empty))
  (loop (:for (Tuple k v) xs) (:do (orderedmapbuilder-add! b k v)))
  (orderedmapbuilder->orderedmap b))

(: (-> (Map %k %v) (OrderedMap %k %v)) (where (Ord %k)))
(defun (map->orderedmap m)
  (def b (orderedmapbuilder-empty))
  (map-for-each (fun (k v) (orderedmapbuilder-add! b k v)) m)
  (orderedmapbuilder->orderedmap b))

(: (-> (OrderedMap %k %v) (List (Tuple %k %v))))
(defun (orderedmap->list m) (->list m))

(: (-> (OrderedMap %k %v) (Vec (Tuple %k %v))))
(defun (orderedmap->vec m) (->vec m))

(: (-> (OrderedMap %k %v) (Seq (Tuple %k %v))))
(defun (orderedmap->seq m) (->seq m))

(: (-> (OrderedMap %k %v) (Map %k %v)))
(defun (orderedmap->map m)
  (def mb (mapbuilder-empty))
  (loop (:for (Tuple k v) m) (:do (mapbuilder-add! mb k v)))
  (mapbuilder->map mb))

;; ---------------------------------------------------------------------------
;; The traits
;; ---------------------------------------------------------------------------

(impl (Refable (OrderedMap %k %v))
  (type %index %k)
  (type %out %v)
  (defun (ref m key) (orderedmap-ref m key))
  (defun (try-ref m key) (orderedmap-try-ref m key)))

(impl (Settable (OrderedMap %k %v))
  (type %index %k)
  (type %in %v)
  (defun (ref-set m key v) (orderedmap-set m key v)))

(impl (Refable (TransientOrderedMap %k %v))
  (type %index %k)
  (type %out %v)
  (defun (ref t key) (transientorderedmap-ref t key))
  (defun (try-ref t key) (transientorderedmap-try-ref t key)))

(impl (Collection (OrderedMap %k %v))
  (type %content (Tuple %k %v))
  (defun (length m) (orderedmap-length m))
  (defun (empty? m) (orderedmap-empty? m)))

(type (: (OrderedMapping %k %v) (Union ordered-mapping)))

(impl (Collector (OrderedMapping %k %v))
  (where (Ord %k))
  (type %elem (Tuple %k %v))
  (type %acc (OrderedMapBuilder %k %v))
  (type %out (OrderedMap %k %v))
  (defun (collector-init c) (orderedmapbuilder-empty))
  (defun (collector-step c acc kv)
    (def (Tuple k v) kv)
    (orderedmapbuilder-add! acc k v)
    acc)
  (defun (collector-finish c acc) (orderedmapbuilder->orderedmap acc)))

(impl (Addable! (OrderedMapBuilder %k %v))
  (type %elem (Tuple %k %v))
  (defun (add! b kv) (def (Tuple k v) kv) (orderedmapbuilder-add! b k v)))

(impl (Addable! (TransientOrderedMap %k %v))
  (type %elem (Tuple %k %v))
  (defun (add! t kv) (def (Tuple k v) kv) (transientorderedmap-set! t k v)))

(impl (Addable (OrderedMap %k %v))
  (type %elem (Tuple %k %v))
  (defun (add m kv) (def (Tuple k v) kv) (orderedmap-set m k v)))

;; In the type's module, so that it is the map's .NET `Equals` and
;; `GetHashCode` too.
(impl (Eq (OrderedMap %k %v))
  (where (Eq %k) (Eq %v))
  (defun (= a b)
    (and (= (orderedmap-length a) (orderedmap-length b))
         (= (orderedmap->list a) (orderedmap->list b))))
  (defun (eq-hash m)
    (orderedmap-fold (fun (k v h) (hash-combine h (hash-combine (eq-hash k) (eq-hash v)))) 17 m)))

;; `#map((k v) ...)` in ascending key order, as a `Map` prints.
(impl (Written (OrderedMap %k %v))
  (where (Written %k) (Written %v))
  (defun (write-into m b)
    (entries-print-into "#map(" m ")" b (fun (k b) (write-into k b)) (fun (v b) (write-into v b)))))

(impl (Displayed (OrderedMap %k %v))
  (where (Displayed %k) (Displayed %v))
  (defun (display-into m b)
    (entries-print-into "#map(" m ")" b (fun (k b) (display-into k b)) (fun (v b) (display-into v b)))))

(: (-> (OrderedMap %k %v) string) (where (Displayed %k) (Displayed %v)))
(defun (orderedmap->str m) (displayed m))

(:deprecated orderedmap->str "use `displayed`")
