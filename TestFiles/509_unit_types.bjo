;; Number types with units, before anything can write a unit value: the types
;; cross a module boundary, unify, generalize and are erased. The program only
;; has to compile and run. The units are the imported module's.
(import (std prelude))
(import (std simpletest))
(import "inc/unit_types.bjo")

;; A local function inferred at (double m), and one generic in the unit used
;; at m and at s.
(: both (-> (double m) (double s) (Tuple (double m) (double s))))
(defun (both a b)
  (defun (twice x) (same (same x)))
  (defun (self x) (pick x x))
  (Tuple (twice (self a)) (self (sec b))))

;; A unit inside a tuple, and a product of two atoms.
(: second-of (-> (Tuple (double m) (double m/s)) (double m/s)))
(defun (second-of t) (match t ((Tuple _ v) (ratio (pick v v)))))

;; The same atoms in another order are the same unit.
(: reordered (-> (double s^-1 m) (double m/s)))
(defun (reordered v) (ratio v))

;; A unit variable of this module's own signature.
(: keep (-> (double %v) (double %v)))
(defun (keep x) (pick x x))

(defun (main)
  (expect-true "both is a function" (not (= (written both) "")))
  (expect-true "second-of is a function" (not (= (written second-of) "")))
  (expect-true "reordered is a function" (not (= (written reordered) "")))
  (expect-true "keep is a function" (not (= (written keep) "")))
  0)
