;; Sammanslagen fixtur: 067_char.bjo, 084_string_cursor.bjo och 111_strings.bjo.
;; Ett ämne i tre avsnitt: teckenliteraler, R6RS-teckenprocedurer med
;; strängmarkörer, och preludens omslag runt .NET-strängar.
;; Hänvisningen till `067_char.bjo` i det andra avsnittets rubrik avser numera
;; det första avsnittet i den här filen.

(import (std prelude))
(import (std simpletest))

;; ===========================================================================
;; Avsnitt 1 — tecken (från 067_char.bjo)
;; ===========================================================================

;; Characters: `#\a` literals, `char` in signatures, pattern matching, and the
;; conversions.
;;
;; A Bjolang `char` is a Unicode *scalar value* backed by `Bjolang.Runtime.BjoChar`,
;; not a C# `char`. A C# char is a 16-bit UTF-16 code unit and cannot hold an
;; astral codepoint on its own, so an emoji written literally in source arrives
;; as a surrogate pair and has to be recombined by the lexer into one codepoint.
;;
;; There is deliberately no `string-ref` or other index-based accessor. Indexing
;; a UTF-16 string by codepoint is O(n), so a loop that looks linear is
;; quadratic. String traversal belongs to a cursor.

;; `char` is an ordinary type name, usable in a signature.
(: vowel? (-> char bool))
(defun (vowel? c)
  (match c
    (#\a #t)
    (#\e #t)
    (#\i #t)
    (#\o #t)
    (#\u #t)
    (_ #f)))

;; Named characters and punctuation match like any other literal.
(: describe (-> char string))
(defun (describe c)
  (match c
    (#\space "space")
    (#\newline "newline")
    (#\tab "tab")
    (#\( "open paren")
    (#\; "semicolon")
    (_ "other")))

(: test-chars (-> void))
(defun (test-chars)
  ;; Literals and codepoints.
  (expect "plain literal" (char->int #\a) 97)
  (expect "uppercase" (char->int #\A) 65)
  (expect "digit char" (char->int #\7) 55)

  ;; Named characters.
  (expect "space" (char->int #\space) 32)
  (expect "newline" (char->int #\newline) 10)
  (expect "tab" (char->int #\tab) 9)
  (expect "null" (char->int #\null) 0)
  (expect "delete" (char->int #\delete) 127)

  ;; Hex escapes, lower and upper case digits.
  (expect "hex 41" (char->int #\x41) 65)
  (expect "hex ff" (char->int #\xff) 255)

  ;; A character that is not a symbol character still lexes.
  (expect "open paren" (char->int #\() 40)
  (expect "semicolon" (char->int #\;) 59)
  (expect "quote char" (char->int #\') 39)

  ;; Astral plane: one codepoint, spelled with a surrogate pair in the source.
  (expect "emoji literal" (char->int #\😀) 128512)
  (expect "emoji hex" (char->int #\x1F600) 128512)

  ;; Equality. `=` is `Eq`'s implementation for `char`, which is C# `==` and
  ;; which a record struct provides; `eq?` dispatches on IsValueType and so
  ;; compares by value here too.
  (expect "= same" (if (= #\a #\a) "yes" "no") "yes")
  (expect "= different" (if (= #\a #\b) "yes" "no") "no")
  (expect "eq? same" (if (eq? #\z #\z) "yes" "no") "yes")
  (expect "eq? different" (if (eq? #\z #\y) "yes" "no") "no")
  (expect "= astral" (if (= #\😀 #\x1F600) "yes" "no") "yes")

  ;; Round-tripping through int, including above the BMP.
  (expect "int round trip" (char->int (int->char 65)) 65)
  (expect "astral round trip" (char->int (int->char 128512)) 128512)

  ;; char->string, where the astral case is the one that catches a 16-bit
  ;; assumption: it must produce a two-code-unit string, not a broken half.
  (expect "char->string ascii" (char->string #\a) "a")
  (expect "char->string length" (string-length (char->string #\a)) 1)
  (expect "char->string astral length"
          (string-length (char->string #\😀)) 2)

  ;; Pattern matching.
  (expect "vowel yes" (if (vowel? #\e) "yes" "no") "yes")
  (expect "vowel no" (if (vowel? #\q) "yes" "no") "no")
  (expect "describe space" (describe #\space) "space")
  (expect "describe newline" (describe #\newline) "newline")
  (expect "describe paren" (describe #\() "open paren")
  (expect "describe other" (describe #\Z) "other"))

;; ===========================================================================
;; Avsnitt 2 — teckenprocedurer och markörer (från 084_string_cursor.bjo)
;; ===========================================================================

;; R6RS character procedures, and string cursors.
;;
;; The cursor is the answer to the question `067_char.bjo` left open: there is no
;; `string-ref`, because indexing UTF-16 by codepoint is O(n) and makes an
;; index loop quadratic. A cursor is an *opaque* position — a struct holding an
;; offset into the string's storage — so the same traversal is linear, and the
;; offset is free to mean UTF-16 code units today and UTF-8 bytes later without
;; any program here changing.
;;
;; The astral cases are the ones that matter. A character is a Unicode scalar
;; value, so an emoji is one `char` occupying two units of UTF-16 storage: any
;; test below that distinguishes `string-length` from `string-count`, or that
;; reverses a string, is checking that nothing is counting or cutting in the
;; wrong currency.

(: expect-int (-> string int int void))
(defun (expect-int label actual wanted)
  (expect label (int->string actual) (int->string wanted)))

(: expect-bool (-> string bool bool void))
(defun (expect-bool label actual wanted)
  (expect label (if actual "yes" "no") (if wanted "yes" "no")))

(: expect-char (-> string char char void))
(defun (expect-char label actual wanted)
  (expect label (char->string actual) (char->string wanted)))

;; A folder that counts. Named rather than written `#(+ &1 1)`, because a
;; shorthand's arity is the highest `&n` it mentions — that one is unary, and a
;; folder takes the accumulator *and* the element.
(: tally (-> int char int))
(defun (tally acc c) (+ acc 1))

;; Walk a string with the raw cursor API and count what comes past. The loop a
;; cursor is *for*: one `next` per character, no indexing, no rescanning.
(: count-by-cursor (-> string int))
(defun (count-by-cursor s)
  (let loop ((c (string-cursor-start s)) (n 0))
    (if (string-cursor-end? s c)
        n
        (loop (string-cursor-next s c) (+ n 1)))))

;; The same walk backwards, which `string-cursor-prev` makes O(1) per step.
(: count-backwards (-> string int))
(defun (count-backwards s)
  (let loop ((c (string-cursor-end s)) (n 0))
    (if (string-cursor=? c (string-cursor-start s))
        n
        (loop (string-cursor-prev s c) (+ n 1)))))

(: test-string-cursors (-> void))
(defun (test-string-cursors)
  ;; ---- R6RS comparisons ---------------------------------------------------
  (expect-bool "char=? same" (char=? #\a #\a) #t)
  (expect-bool "char=? different" (char=? #\a #\b) #f)
  (expect-bool "char<?" (char<? #\a #\b) #t)
  (expect-bool "char>?" (char>? #\b #\a) #t)
  (expect-bool "char<=? equal" (char<=? #\a #\a) #t)
  (expect-bool "char>=? equal" (char>=? #\a #\a) #t)

  ;; `<` is the operator, so it chains n-arily where the named forms are binary.
  (expect-bool "chained <" (< #\a #\b #\c) #t)
  (expect-bool "chained < broken" (< #\a #\c #\b) #f)

  ;; Ordering is by codepoint. Comparing UTF-16 text would sort the emoji by its
  ;; high surrogate (0xD83D) and put it *below* U+FFFD; by codepoint it is above
  ;; every BMP character.
  (expect-bool "astral orders above ascii" (char<? #\z #\😀) #t)

  ;; ---- Case-insensitive comparison ----------------------------------------
  (expect-bool "char-ci=? across case" (char-ci=? #\A #\a) #t)
  (expect-bool "char-ci=? different" (char-ci=? #\A #\b) #f)
  (expect-bool "char-ci<?" (char-ci<? #\A #\b) #t)
  (expect-bool "char-ci>=?" (char-ci>=? #\B #\a) #t)

  ;; ---- Case conversion ----------------------------------------------------
  (expect-char "char-upcase" (char-upcase #\a) #\A)
  (expect-char "char-downcase" (char-downcase #\Z) #\z)
  (expect-char "char-foldcase" (char-foldcase #\A) #\a)
  (expect-char "char-upcase non-letter" (char-upcase #\7) #\7)
  ;; Beyond ASCII, which is where a byte-wise implementation would give up.
  (expect-char "char-upcase accented" (char-upcase #\é) #\É)
  (expect-char "char-downcase greek" (char-downcase #\Σ) #\σ)

  ;; ---- Classification -----------------------------------------------------
  (expect-bool "alphabetic yes" (char-alphabetic? #\a) #t)
  (expect-bool "alphabetic no" (char-alphabetic? #\1) #f)
  (expect-bool "alphabetic non-ascii" (char-alphabetic? #\é) #t)
  (expect-bool "numeric yes" (char-numeric? #\7) #t)
  (expect-bool "numeric no" (char-numeric? #\a) #f)
  (expect-bool "whitespace space" (char-whitespace? #\space) #t)
  (expect-bool "whitespace newline" (char-whitespace? #\newline) #t)
  (expect-bool "whitespace no" (char-whitespace? #\a) #f)
  (expect-bool "upper-case yes" (char-upper-case? #\A) #t)
  (expect-bool "upper-case no" (char-lower-case? #\A) #f)
  (expect-bool "lower-case yes" (char-lower-case? #\a) #t)

  ;; `digit-value` is narrower than `char-numeric?`, and the pair of answers
  ;; here is the reason both exist.
  (expect-int "digit-value 7" (option-ref-or (digit-value #\7) -1) 7)
  (expect-int "digit-value non-digit" (option-ref-or (digit-value #\a) -1) -1)
  (expect-bool "digit-value none? on letter" (none? (digit-value #\a)) #t)

  ;; ---- General category ---------------------------------------------------
  (expect "category lowercase" (symbol->string (char-general-category #\a)) "Ll")
  (expect "category uppercase" (symbol->string (char-general-category #\A)) "Lu")
  (expect "category digit" (symbol->string (char-general-category #\7)) "Nd")
  (expect "category space" (symbol->string (char-general-category #\space)) "Zs")

  ;; ---- Cursors, the basics ------------------------------------------------
  (expect-char "ref at start" (string-cursor-ref "hello" (string-cursor-start "hello")) #\h)
  (expect-char "ref after next"
               (string-cursor-ref "hello" (string-cursor-next "hello" (string-cursor-start "hello")))
               #\e)
  (expect-bool "end? at end" (string-cursor-end? "hi" (string-cursor-end "hi")) #t)
  (expect-bool "end? at start" (string-cursor-end? "hi" (string-cursor-start "hi")) #f)
  ;; An empty string is where start and end coincide.
  (expect-bool "empty string is immediately done"
               (string-cursor-end? "" (string-cursor-start "")) #t)

  ;; Cursor comparison, which is what bounds a hand-written traversal.
  (expect-bool "cursor=? start end on empty"
               (string-cursor=? (string-cursor-start "") (string-cursor-end "")) #t)
  (expect-bool "cursor<? start before end"
               (string-cursor<? (string-cursor-start "hi") (string-cursor-end "hi")) #t)

  ;; ---- Storage units against characters -----------------------------------
  ;;
  ;; The heart of it. "a😀b" is three characters in four UTF-16 code units, and
  ;; every operation below has to agree about which of those two numbers it
  ;; deals in.
  (expect-int "string-length counts storage" (string-length "a😀b") 4)
  (expect-int "string-count counts characters" (string-count "a😀b") 3)
  (expect-int "cursor walk counts characters" (count-by-cursor "a😀b") 3)
  (expect-int "backward walk agrees" (count-backwards "a😀b") 3)
  (expect-int "ascii: the two agree" (string-length "abc") (string-count "abc"))

  ;; The emoji arrives whole from the middle of the string, not as a surrogate.
  (expect-char "astral char read whole"
               (string-cursor-ref "a😀b"
                 (string-cursor-next "a😀b" (string-cursor-start "a😀b")))
               #\😀)
  ;; And one `next` steps over both of its storage units.
  (expect-char "next steps over the whole character"
               (string-cursor-ref "a😀b"
                 (string-cursor-next "a😀b"
                   (string-cursor-next "a😀b" (string-cursor-start "a😀b"))))
               #\b)

  ;; ---- substring/cursors --------------------------------------------------
  (expect "substring whole"
          (substring/cursors "hello" (string-cursor-start "hello") (string-cursor-end "hello"))
          "hello")
  (expect "substring empty at start"
          (substring/cursors "hello" (string-cursor-start "hello") (string-cursor-start "hello"))
          "")
  (expect "substring drops first char"
          (substring/cursors "hello"
            (string-cursor-next "hello" (string-cursor-start "hello"))
            (string-cursor-end "hello"))
          "ello")

  ;; ---- Folds --------------------------------------------------------------
  (expect-int "string-fold counts" (string-fold tally 0 "hello") 5)
  (expect-int "string-fold over astral" (string-fold tally 0 "a😀b") 3)
  ;; Left and right fold differ in the order they visit, which is the whole
  ;; point of having both: consing on the way left reverses, on the way right
  ;; does not.
  (expect "string-fold builds reversed"
          (list->string (string-fold #(cons &2 &1) Nil "abc"))
          "cba")
  (expect "string-fold-right preserves order"
          (list->string (string-fold-right cons Nil "abc"))
          "abc")

  ;; ---- for-each -----------------------------------------------------------
  (let ((b (stringbuilder-empty)))
    (string-for-each #(stringbuilder-add! b (char-upcase &1)) "hi there")
    (expect "string-for-each" (stringbuilder->string b) "HI THERE"))

  ;; ---- Conversions --------------------------------------------------------
  (expect "string->list and back" (list->string (string->list "round trip")) "round trip")
  (expect "round trip keeps astral" (list->string (string->list "a😀b")) "a😀b")
  (expect-int "string->list length" (list-length (string->list "a😀b")) 3)
  (expect-int "string->vec length" (vec-length (string->vec "a😀b")) 3)
  (expect-char "string->vec element" (vec-ref (string->vec "a😀b") 1) #\😀)

  ;; Reversing by character. Reversing the *storage* would split the emoji into
  ;; two surrogates and swap them, producing text no longer well-formed — this
  ;; is the test that catches it.
  (expect "string-reverse ascii" (string-reverse "abc") "cba")
  (expect "string-reverse astral" (string-reverse "a😀b") "b😀a")
  (expect "string-reverse empty" (string-reverse "") "")

  ;; ---- string-index -------------------------------------------------------
  ;; The result is a cursor, so it can be used to cut without converting back.
  (expect "index finds and slices"
          (substring/cursors "hello world"
            (option-ref (string-index char-whitespace? "hello world"))
            (string-cursor-end "hello world"))
          " world")
  (expect-bool "index missing" (none? (string-index char-numeric? "no digits here")) #t)

  ;; ---- Iterating a string with `loop` -------------------------------------
  ;;
  ;; `:for` over a string uses the `Iterable` impl and `:acc ... (stringing ...)`
  ;; the `Collector` one, so neither the loop nor the accumulator knows anything
  ;; about encodings.
  (expect "loop over string"
          (loop (:for c "hello")
                (:acc out (stringing (char-upcase c)))
                => out)
          "HELLO")
  (expect "loop keeps astral whole"
          (loop (:for c "a😀b")
                (:acc out (stringing c))
                => out)
          "a😀b")
  (expect-int "loop counts characters"
              (loop (:for c "a😀b")
                    (:acc n (counting c))
                    => n)
              3)
  ;; Filtering mid-loop, to show the character is an ordinary value.
  (expect "loop filters"
          (loop (:for c "h3ll0 w0rld")
                (:when (char-alphabetic? c))
                (:acc out (stringing c))
                => out)
          "hllwrld")

  ;; ---- The Collection and Foldable traits ---------------------------------
  ;;
  ;; `length` is the character count, so that it agrees with what `->seq` gives.
  (expect-int "Collection length" (length "a😀b") 3)
  (expect-bool "Collection empty? yes" (empty? "") #t)
  (expect-bool "Collection empty? no" (empty? "a") #f)
  (expect-int "Collection ->seq agrees" (seq-length (->seq "a😀b")) 3)
  (expect-int "Foldable fold" (fold tally 0 "hello") 5)

  ;; ---- ->str --------------------------------------------------------------
  (expect "->str of a char" (->str #\a) "a")
  (expect "->str of an astral char" (->str #\😀) "😀"))

;; ===========================================================================
;; Avsnitt 3 — strängbiblioteket (från 111_strings.bjo)
;; ===========================================================================

;; The string operations the prelude wraps around .NET: searching, case,
;; trimming, padding, splitting and joining.
;;
;; What is being asserted beyond "the call works" is that every comparison is
;; ordinal and every case mapping invariant, so the answers below are the same
;; on every machine, and that `string-split` and `string-join` are inverses.

(: expect-false (-> string bool void))
(defun (expect-false label actual)
  (expect label actual #f))

(: test-strings (-> void))
(defun (test-strings)
  ;; --- Searching -----------------------------------------------------------
  (expect-true  "contains" (string-contains? "hello world" "o w"))
  (expect-false "and does not" (string-contains? "hello world" "ow"))
  (expect-true  "the empty needle is everywhere" (string-contains? "hello" ""))
  (expect-true  "starts with" (string-starts-with? "hello" "hell"))
  (expect-false "and does not" (string-starts-with? "hello" "Hell"))
  (expect-true  "ends with" (string-ends-with? "hello" "llo"))
  (expect-false "and does not" (string-ends-with? "hello" "LLO"))

  ;; Ordinal, not cultural. The first literal below holds a bare "e" followed
  ;; by a combining acute accent; the needle is a precomposed "é". They are the
  ;; same text to a collator and two different strings to storage, and it is
  ;; storage that answers here — on every machine, in every locale.
  (expect-false "comparison is ordinal" (string-contains? "éclair" "é"))

  ;; --- Rewriting -----------------------------------------------------------
  (expect "replace" (string-replace "a-b-c" "-" "+") "a+b+c")
  (expect "replace with nothing deletes" (string-replace "a-b-c" "-" "") "abc")
  (expect "and a needle that is not there changes nothing"
          (string-replace "abc" "-" "+") "abc")

  ;; --- Case ----------------------------------------------------------------
  ;; ß upcases to itself rather than to SS: the invariant mapping is
  ;; character-for-character, and the expansion is a locale's rule, not
  ;; Unicode's simple one.
  (expect "upcase" (string-upcase "Straße road") "STRAßE ROAD")
  (expect "downcase" (string-downcase "LOUD Noise") "loud noise")

  ;; --- Trimming and padding ------------------------------------------------
  (expect "trim" (string-trim "  padded\t\n") "padded")
  (expect "trim-start" (string-trim-start "  padded  ") "padded  ")
  (expect "trim-end" (string-trim-end "  padded  ") "  padded")
  (expect "pad-left" (string-pad-left "7" 3) "  7")
  (expect "pad-right" (string-pad-right "7" 3) "7  ")
  (expect "padding never truncates" (string-pad-left "wide" 2) "wide")
  (expect "and a pad of one's own" (string-pad-left "7" 3 #:with #\0) "007")
  (expect "on the right too" (string-pad-right "7" 3 #:with #\.) "7..")

  ;; Width is in characters, so a pad outside the BMP is one of them and a
  ;; string containing one is as wide as it looks.
  (expect "an astral pad is one character"
          (string-pad-left "a" 3 #:with #\😀) "😀😀a")
  (expect "and an astral character is one character wide"
          (string-pad-left "😀" 3) "  😀")

  ;; --- Splitting and joining -----------------------------------------------
  (def fields (string-split "a,b,c" ","))
  (expect "split" (length fields) 3)
  (expect "and its fields" (vec-ref fields 1) "b")

  ;; Empty fields are kept, which is what makes the two inverses.
  (def sparse (string-split "a,,b" ","))
  (expect "an empty field is a field" (length sparse) 3)
  (expect "join undoes split" (string-join sparse ",") "a,,b")

  (expect "a separator that is not there splits into one field"
          (int->string (length (string-split "abc" ","))) "1")
  (expect "a multi-character separator"
          (string-join (string-split "a::b::c" "::") "/") "a/b/c")
  (expect "joining nothing is nothing"
          (string-join (vec-empty) ",") "")

  ;; Splitting is by storage, joining by nothing at all, so text outside the
  ;; BMP survives both.
  (expect "and an astral character is not cut in half"
          (int->string (length (string-split "a😀b" "😀"))) "2")

  ;; --- Composition ---------------------------------------------------------
  ;;
  ;; The wrappers are ordinary functions, so they compose with `->` and with
  ;; the collection operations like anything else.
  (expect "a pipeline"
          (-> "  Alpha, Beta ,Gamma  "
              (string-trim)
              (string-split & ",")
              (vec-map string-trim &)
              (vec-map string-downcase &)
              (string-join & "|"))
          "alpha|beta|gamma"))

(defun (main)
  (test-chars)
  (test-string-cursors)
  (test-strings)
  0)
