;; Three broken top-level forms, all reported by one compilation.
;;
;; The forms are independent and the reader has already decided where each of
;; them ends, so a form that fails to parse costs the declarations it would have
;; produced and nothing else. Before the parse barrier existed, the first of
;; these ended the build and the other two were found one recompilation at a
;; time.

;; EXPECT-ERROR: multi_parse_errors.bjo:13
;; EXPECT-ERROR: multi_parse_errors.bjo:15
;; EXPECT-ERROR: multi_parse_errors.bjo:17

(defun)

(defun (second 1 2) 3)

(nonsense-declaration foo bar)

(defun (main args) 0)
