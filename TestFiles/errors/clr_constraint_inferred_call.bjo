;; A generic function gets the constraints of the .NET generics it uses, and a
;; call of it at a type that breaks one is a Bjolang error at the call.
;; EXPECT-ERROR: 'all-values' needs its type variable %a to be a value type (struct), for the .NET generics it uses %a with, and here %a is (Array int).
(import (std prelude))
(import/extern (enum-values (: System.Enum.GetValues (-> (Array %a)))))

(: (-> (Array %a)))
(defun (all-values) (enum-values))

(: (-> (Array (Array int))))
(defun (arrays) (all-values))

(defun (main) (println (array-length (arrays))) 0)
