;; `.ToString` on a record. The field is looked for first, and there is no
;; fallback to the .NET methods of the C# record behind it: `(.ToString c)`
;; was an error before `.name` read fields, so it reports a missing field
;; exactly as `(record-ref c ToString)` does.

;; EXPECT-ERROR: Field 'ToString' does not belong to record

(import (std prelude))

(type (: Car (Record (: brand string))))

(defun (main args)
  (def c (Car (brand "banana")))
  (println (.ToString c))
  0)
