;; Day 3: Lobby. Each line is a bank of batteries, one digit each. Turn on k
;; of them, in order, to make the largest number: k = 2 in part 1, 12 in
;; part 2. The answer is the sum over the banks.
(import (std prelude))
(import "common.bjo")

;; The index of the first largest digit in ds[from, to).
(: best-at (-> (Vec int) int int int))
(defun (best-at ds from to)
  (loop (:for i (range from to))
        (:acc best (folding from (if (> (vec-ref ds i) (vec-ref ds best)) i best)))
        => best))

;; The largest number made of k digits of ds, in order.
(: joltage (-> (Vec int) int long))
(defun (joltage ds k)
  (def n (vec-length ds))
  (let pick ((j 0) (from 0) (acc 0L))
    (if (= j k)
        acc
        (let ()
          ;; Leave room for the k - j - 1 digits still to pick.
          (def i (best-at ds from (- n (- k j 1))))
          (pick (+ j 1) (+ i 1) (+ (* acc 10L) (cast System.Int64 (vec-ref ds i))))))))

(defun (main args)
  (def banks {vecing (vec-map digit (string->vec line)) (:for line (input-lines args))})
  (println {summing (joltage b 2) (:for b banks)})
  (println {summing (joltage b 12) (:for b banks)})
  0)
