;; DIVITER, idiomatic: every other element of a vec, by a `loop` over the
;; even indices.
;; Arguments: count n expected-length

(import "../bjolang/common.bjo")

(: div2 (-> (Vec int) (Vec int)))
(defun (div2 v)
  (loop (:for i (range-by 0 (vec-length v) 2))
        (:acc out (vecing (vec-ref v i)))
        => out))

(defun (main args)
  (def v {vecing 0 (:for i (range 0 (arg-int args 1)))})
  (def expected (arg-int args 2))
  (run-benchmark "diviter" (arg-int args 0) (fun () (div2 v)) #(= (vec-length &) expected)))
