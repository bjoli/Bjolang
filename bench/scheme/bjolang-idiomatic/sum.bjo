;; SUM, idiomatic: a `summing` comprehension over a range.
;; Arguments: count n expected

(import "../bjolang/common.bjo")

(: run (-> int int))
(defun (run n)
  {summing i (:for i (range 0 (+ n 1)))})

(defun (main args)
  (def n (arg-int args 1))
  (def expected (arg-int args 2))
  (run-benchmark "sum" (arg-int args 0) (fun () (run n)) #(= & expected)))
