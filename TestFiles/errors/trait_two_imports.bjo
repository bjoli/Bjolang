;; Two imports offer Pretty, two different traits. Naming the bare trait is
;; refused: the program has to say which it means, with a prefix.
;; EXPECT-ERROR: 'Pretty' is imported from pretty_a and pretty_b, and they are two different things
;; EXPECT-ERROR: (prefix-types ...)
(import (std prelude))
(import "../inc/pretty_a.bjo")
(import "../inc/pretty_b.bjo")

(: (-> %a %a) (where (Pretty %a)))
(defun (same x) x)

(defun (main args)
  (println (same "x"))
  0)
