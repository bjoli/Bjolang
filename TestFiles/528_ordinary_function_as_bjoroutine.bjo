;; An ordinary function is accepted where a bjoroutine is expected when it is
;; the value itself, and is then wrapped in a bjoroutine: an argument, an
;; element of a literal, a field or a return value. A bjoroutine lambda given
;; to a generic function keeps its delegate type.
;;
;; Before, an element of a literal was accepted and not wrapped, and C#
;; rejected the lambda (CS0029). A bjoroutine lambda given to `Some` was
;; emitted as a `Func<Task<T>>`, and C# rejected the option (CS1503).
;; Inside another type, where no value can be wrapped, see
;; errors/ordinary_function_inside_option.bjo and the two next to it.
(import (std prelude))
(import (std simpletest))

(: twice (-> int int))
(defun (twice x) (* 2 x))

(: sum-all (-bjo-> (Vec (-bjo-> int int)) int int))
(defbjo (sum-all fs x) (loop (:for f fs) (:acc s (summing (f x)))))

(: call-it (-bjo-> (-bjo-> int int) int int))
(defbjo (call-it f x) (f x))

(: call-each (-bjo-> (List (-bjo-> int int)) int int))
(defbjo (call-each fs x)
  (match fs
    (Nil 0)
    ((Cons f rest) (+ (f x) (call-each rest x)))))

(: call-option (-bjo-> (Option (-bjo-> double)) double))
(defbjo (call-option o)
  (match o
    ((Some f) (f))
    (None 0.0)))

(defbjo (main)
  (def (: fs (Vec (-bjo-> int int))) [(fun (x) x) twice (bjoroutine (x) (+ x 1))])
  (expect "a vec literal of an ordinary lambda, a name and a bjoroutine"
          (sum-all fs 10)
          41)
  (expect "a vec literal as an argument"
          (sum-all [twice (fun (x) (* x x))] 3)
          15)
  (expect "a list made by list"
          (call-each (list (fun (x) x) twice) 5)
          15)
  (expect "a name as an argument"
          (call-it twice 21)
          42)
  (expect "a bjoroutine lambda in Some"
          (call-option (Some (bjoroutine () 1.5)))
          1.5))
