    (15 'Pi)
    (16 'Pf)
    (17 'Po)
    (18 'Sm)
    (19 'Sc)
    (20 'Sk)
    (21 'So)
    (22 'Zs)
    (23 'Zl)
    (24 'Zp)
    (25 'Cc)
    (26 'Cf)
    (27 'Cs)
    (28 'Co)
    (_ 'Cn)))
