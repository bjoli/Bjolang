;; std/mutable/set.bjo — the hash set, written in place.
;;
;; A `MutableSet` *is* a .NET `HashSet<T>`. O(1) expected membership, and set
;; algebra that rewrites the receiver rather than building a new set.
;;
;; **This is the mutable one.** `(mutableset-add! s x)` writes `s`; everyone
;; holding `s` sees the change. `HashSet` is the persistent structure of the same
;; shape, and `TransientHashSet` is a `HashSet` being built — made from one, filled, and
;; frozen back. This is the one that is never frozen.
;;
;; **The set algebra writes the left-hand side.** `(mutableset-union! a b)` is
;; `a` becoming the union, not a third set: rebuilding is what the persistent
;; `hashset-union` is for, and doing it in place is the reason to reach for this.
;;
;; **Members are filed under .NET's equality**, `EqualityComparer<T>.Default`,
;; not under the `Eq` implementation in `std/eq` — the same equality `Map` and
;; `HashSet` file their keys under.
(import (std prelude))
;; For `hashset->seq` and `seq->hashset`, which the two conversions at the bottom are
;; written with. The persistent set is a module of its own.
(import (std hashset))

(:doc #:file "set.bjodoc")

(export
  MutableSet MutableSetEnumerator
  mutableset
  mutableset-length mutableset-empty?
  mutableset-add! mutableset-add-new! mutableset-try-add-new!
  mutableset-add-all! mutableset-remove! mutableset-remove-all!
  mutableset-remove-where! mutableset-clear! mutableset-contains?
  mutableset-union! mutableset-intersect! mutableset-difference!
  mutableset-symmetric-difference!
  mutableset-subset? mutableset-superset? mutableset-overlaps?
  mutableset-copy
  mutableset-enumerator mutableset-enumerator-next! mutableset-enumerator-current
  mutableset-for-each
  list->mutableset mutableset->list vec->mutableset mutableset->vec
  seq->mutableset mutableset->seq hashset->mutableset mutableset->hashset
  mutableset->str)

;; The type is .NET's, so a `MutableSet` handed to any other `import/extern`
;; taking a `HashSet<T>` is accepted as it stands.
(import/class
  ((MutableSet %a) (: System.Collections.Generic.HashSet))
  ((MutableSetEnumerator %a) (: Bjolang.Runtime.MutableSetEnumerator)))

;; ---------------------------------------------------------------------------
;; The set
;; ---------------------------------------------------------------------------

(import/extern
  (mutableset            (: Bjolang.Runtime.MutableSetModule.Empty       (-> (MutableSet %a))))
  (mutableset-length     (: Bjolang.Runtime.MutableSetModule.Count       (-> (MutableSet %a) int)))
  (mutableset-empty?     (: Bjolang.Runtime.MutableSetModule.IsEmpty     (-> (MutableSet %a) bool)))
  ;; Makes x a member. Adding one that is already a member is not a failure:
  ;; afterwards it is a member, which is all `add!` says.
  (mutableset-add!       (: Bjolang.Runtime.MutableSetModule.Add         (-> (MutableSet %a) %a void)))
  ;; Adds an element that must be new, and raises when it is not.
  (mutableset-add-new!   (: Bjolang.Runtime.MutableSetModule.AddNew      (-> (MutableSet %a) %a void)))
  ;; The equal element already there, or None when x was added. What
  ;; `mutableset-try-add-new!` is made of.
  (add-or-existing!      (: Bjolang.Runtime.MutableSetModule.AddOrExisting (-> (MutableSet %a) %a (out %a) (Option %a))))
  (mutableset-add-all!   (: Bjolang.Runtime.MutableSetModule.AddRange    (-> (MutableSet %a) (Seq %a) void)))
  (mutableset-remove!    (: Bjolang.Runtime.MutableSetModule.Remove      (-> (MutableSet %a) %a bool)))
  (mutableset-remove-all! (: Bjolang.Runtime.MutableSetModule.RemoveRange (-> (MutableSet %a) (Seq %a) void)))
  ;; How many went.
  (mutableset-remove-where! (: Bjolang.Runtime.MutableSetModule.RemoveWhere (-> (MutableSet %a) (-> %a bool) int)))
  (mutableset-clear!     (: Bjolang.Runtime.MutableSetModule.Clear       (-> (MutableSet %a) void)))
  (mutableset-contains?  (: Bjolang.Runtime.MutableSetModule.Contains    (-> (MutableSet %a) %a bool)))
  (mutableset-copy       (: Bjolang.Runtime.MutableSetModule.Copy        (-> (MutableSet %a) (MutableSet %a))))
  (mutableset->seq       (: Bjolang.Runtime.MutableSetModule.AsEnumerable   (-> (MutableSet %a) (Seq %a))))
  (seq->mutableset       (: Bjolang.Runtime.MutableSetModule.FromEnumerable (-> (Seq %a) (MutableSet %a))))

  ;; --- Set algebra, written into the first argument ---
  (mutableset-union!                (: Bjolang.Runtime.MutableSetModule.Union           (-> (MutableSet %a) (MutableSet %a) void)))
  (mutableset-intersect!            (: Bjolang.Runtime.MutableSetModule.Intersect       (-> (MutableSet %a) (MutableSet %a) void)))
  (mutableset-difference!           (: Bjolang.Runtime.MutableSetModule.Except          (-> (MutableSet %a) (MutableSet %a) void)))
  (mutableset-symmetric-difference! (: Bjolang.Runtime.MutableSetModule.SymmetricExcept (-> (MutableSet %a) (MutableSet %a) void)))

  ;; --- Comparisons, which write nothing ---
  (mutableset-subset?    (: Bjolang.Runtime.MutableSetModule.IsSubsetOf   (-> (MutableSet %a) (MutableSet %a) bool)))
  (mutableset-superset?  (: Bjolang.Runtime.MutableSetModule.IsSupersetOf (-> (MutableSet %a) (MutableSet %a) bool)))
  (mutableset-overlaps?  (: Bjolang.Runtime.MutableSetModule.Overlaps     (-> (MutableSet %a) (MutableSet %a) bool)))

  ;; A walk with .NET's protocol: `next!` is `MoveNext`, `current` is `Current`.
  (mutableset-enumerator         (: Bjolang.Runtime.MutableSetModule.Enumerator (-> (MutableSet %a) (MutableSetEnumerator %a))))
  (mutableset-enumerator-next!   (: Bjolang.Runtime.MutableSetModule.MoveNext   (-> (MutableSetEnumerator %a) bool)))
  (mutableset-enumerator-current (: Bjolang.Runtime.MutableSetModule.Current    (-> (MutableSetEnumerator %a) %a))))

;; `mutableset-add-new!` with the failure as a value: `(Err y)` carries the
;; equal element already in the set, which is what interning a value needs.
(: (-> (MutableSet %a) %a (Result %a Unit)))
(defun (mutableset-try-add-new! s x)
  (match (add-or-existing! s x)
    ((Some old) (Err old))
    (None (Ok unit))))

;; A walk whose callback may suspend. The `Iterable` default would do as well;
;; this one names the set first, matching `hashset-for-each`.
(: (-> (-?-> %a void) (MutableSet %a) void))
(defun (mutableset-for-each f s)
  (def e (mutableset-enumerator s))
  (let go ()
    (when (mutableset-enumerator-next! e)
      (f (mutableset-enumerator-current e))
      (go))))

;; ---------------------------------------------------------------------------
;; Conversions
;; ---------------------------------------------------------------------------

(: (-> (List %a) (MutableSet %a)))
(defun (list->mutableset xs) (seq->mutableset (list->seq xs)))

(: (-> (MutableSet %a) (List %a)))
(defun (mutableset->list s) (->list (mutableset->seq s)))

(: (-> (Vec %a) (MutableSet %a)))
(defun (vec->mutableset v) (seq->mutableset (vec->seq v)))

(: (-> (MutableSet %a) (Vec %a)))
(defun (mutableset->vec s) (->vec (mutableset->seq s)))

(: (-> (HashSet %a) (MutableSet %a)))
(defun (hashset->mutableset s) (seq->mutableset (hashset->seq s)))

(: (-> (MutableSet %a) (HashSet %a)))
(defun (mutableset->hashset s) (seq->hashset (mutableset->seq s)))

;; ---------------------------------------------------------------------------
;; The traits
;; ---------------------------------------------------------------------------

(impl (Refable (MutableSet %a))
  (type %index %a)
  (type %out bool)
  (defun (ref s elem)
    (mutableset-contains? s elem)))

(impl (Iterable (MutableSet %a))
  (type %elem %a)
  ;; The enumerator is the cursor, and it steps in `done?`, which the
  ;; protocol calls once per step before `current`. See the `Seq` impl.
  (type %cursor (MutableSetEnumerator %a))
  (defun (iterable-start s) (mutableset-enumerator s))
  (defun (iterable-done? s e) (not (mutableset-enumerator-next! e)))
  (defun (iterable-current s e) (mutableset-enumerator-current e))
  (defun (iterable-next s e) e))

(impl (Collection (MutableSet %a))
  (type %content %a)
  (defun (length s) (mutableset-length s))
  (defun (empty? s) (mutableset-empty? s)))

(impl (Addable! (MutableSet %a))
  (type %elem %a)
  (defun (add! s elem)
    (mutableset-add! s elem)))

;; Two sets are equal when they hold the same elements. Same size, and every
;; element of `a` in `b` — which leaves `b` no room for one of its own.
;;
;; Membership is .NET's equality, since finding an element is a lookup. Without
;; this implementation the whole comparison would be .NET's too, and for a
;; `HashSet<T>` that is reference identity. `eq-hash` refuses, as `Deque`'s does.
(impl (Eq (MutableSet %a))
  (defun (= a b)
    (and (= (mutableset-length a) (mutableset-length b))
         (let ((e (mutableset-enumerator a)))
           (let go ()
             (cond
               ((not (mutableset-enumerator-next! e)) #t)
               ((mutableset-contains? b (mutableset-enumerator-current e)) (go))
               (else #f))))))
  (defun (eq-hash s) (unhashable "MutableSet")))

;; `#mset(a b c)`, in whatever order the table holds them.
(impl (Written (MutableSet %a))
  (where (Written %a))
  (defun (write-into s b) (elements-print-into "#mset(" s ")" b (fun (x b) (write-into x b)))))

(impl (Displayed (MutableSet %a))
  (where (Displayed %a))
  (defun (display-into s b) (elements-print-into "#mset(" s ")" b (fun (x b) (display-into x b)))))

(: (-> (MutableSet %a) string) (where (Displayed %a)))
(defun (mutableset->str s) (displayed s))

(:deprecated mutableset->str "use `displayed`")
