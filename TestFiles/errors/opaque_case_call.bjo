;; The same case in expression position. A constructor is an ordinary binding,
;; so calling one an opaque type kept back is an unbound variable — and the
;; message says whose it is rather than leaving it looking like a typo.

;; EXPECT-ERROR: Unbound variable: Live
;; EXPECT-ERROR: vault/Handle
;; EXPECT-ERROR: exported #:opaque

(import "../inc/vault.bjo")

(defun (main args)
  (println (int->string (handle-tag (Live 1 2))))
  0)
