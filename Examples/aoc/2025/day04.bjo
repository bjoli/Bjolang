;; Day 4: Printing Department. A roll (@) is reachable with fewer than four
;; rolls among its eight neighbours. Part 1 counts them; part 2 removes
;; reachable rolls until none are left to reach.
(import "common.bjo")

(defun (main args)
  (def* (lines (input-lines args))
        (w (length (ref lines 0)))
        (h (length lines))
        (cells (make-array (* w h))))
  (loop (:for line lines) (:with y 0 (+ y 1))
        (:subloop)
        (:for c line) (:with x 0 (+ x 1))
        (:do (array-set! cells (+ x (* y w)) (char=? c #\@))))
  (defun (roll? x y)
    (and (>= x 0) (< x w) (>= y 0) (< y h) (ref cells (+ x (* y w)))))
  (defun (neighbours x y)
    {counting dx :when (and (not (and (= dx 0) (= dy 0))) (roll? (+ x dx) (+ y dy)))
     (:for dy (range -1 2)) (:subloop) (:for dx (range -1 2))})
  ;; The rolls that can be reached now, as cell indices.
  (defun (reachable)
    {listing (+ x (* y w))
     (:for y (range 0 h)) (:subloop) (:for x (range 0 w))
     (:when (and (roll? x y) (< (neighbours x y) 4)))})
  (defun (remove-all removed)
    (match (reachable)
      (Nil removed)
      (rs (list-for-each #(array-set! cells & #f) rs)
          (remove-all (+ removed (length rs))))))
  (println (length (reachable)))
  (println (remove-all 0))
  0)
