(import (std prelude))
(import (std simpletest))
(defun (main args)
  ;; 4 -> 9 -> 6 -> 12. Mellansteget använder `&`, så värdet hamnar som andra
  ;; argument i stället för första — utan det vore svaret -3 ... 2.
  (expect "threading, with an explicit & in the middle"
          (-> 4
              (+ 5)
              (- & 3)
              (* 2))
          12)
  0)
