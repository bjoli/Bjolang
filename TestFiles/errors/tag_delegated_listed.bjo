;; A misspelled tag where a union delegates: the report lists the tags on
;; offer through the carrying case as well as the union's own.
;; EXPECT-ERROR: Through tag_delegated_listed/Leaf, those of tag_delegated_listed/Test: id or name
(import (std prelude))

(type (: Test (Union (TId int #:tag id) (TName string #:tag name))))
(type-rec
  (: Cond (Union (And (List Cond) #:tag and #:rest)
                 (Leaf Test))))

(: f (-> Cond int))
(defun (f c) 0)

(defun (main args)
  (f '(and (id 1) (nmae "x"))))
