;; The declared result is checked against what the form produces, never
;; rewritten: here the two outs are in the wrong order.
;; EXPECT-ERROR: The declared result must be exactly what the form produces
;; EXPECT-ERROR: the tuple form of this method produces (Tuple %TKey %TValue)
(import (std prelude))

(import/class
  ((KeyValuePair %k %v) (: System.Collections.Generic.KeyValuePair)))

(import/extern
  (kv-parts (: System.Collections.Generic.KeyValuePair.Deconstruct
               (-> (KeyValuePair %k %v) (out %k) (out %v) (Tuple %v %k)))))

(defun (main args) 0)
