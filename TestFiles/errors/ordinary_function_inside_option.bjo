;; EXPECT-ERROR: They differ inside the Option: (-bjo-> int int) against (-> ?a ?a).
;; EXPECT-ERROR: Inside another type it is not.
;;
;; `Some` makes an option of an ordinary function, and the option is then
;; given where an option of a bjoroutine is expected. The function is not the
;; value, so nothing can wrap it, and C# has no conversion between the two
;; delegate types.
(import (std prelude))

(defbjo (main)
  (def (: _o (Option (-bjo-> int int))) (Some (fun (x) x)))
  (println "x"))
