;; Docs for the prelude's iteration: the Iterable, Cursor, Collector,
;; Collection, Addable and Addable! traits, ranges and counting walks, and the
;; lazy Seq builtins. Read through (:doc #:file "prelude-seqs.bjodoc"). The
;; texts are samizdat markup: code in prose is @code{...}.

;; ---------------------------------------------------------------------------
;; Iterable: the walk protocol
;; ---------------------------------------------------------------------------

(:doc iterable-start
  (summary "Returns a cursor positioned at the start of an iterable sequence.")
  (arg s "The iterable collection or sequence.")
  (returns "A cursor before or on the first element. Check iterable-done? before advancing.")
  (see iterable-done? iterable-current iterable-next)
  (reference """
    One of the four methods @code{(:for x s)} is built on. A program may call
    them directly, but typically uses @code{loop}, @code{fold}, or
    comprehensions instead.
    """))

(:doc iterable-done?
  (summary "Whether iteration has finished.")
  (arg s "The iterable collection or sequence.")
  (arg c "The cursor.")
  (returns "#t if the iteration has completed or no element exists at c; #f otherwise.")
  (see iterable-start iterable-current iterable-next)
  (reference """
    Call once before each @code{iterable-current}. For @code{Vec}, @code{Seq},
    and @code{Map}, this call advances the underlying enumerator:
    @code{iterable-next} returns the cursor passed to it, and calling
    @code{iterable-done?} twice advances past an element.
    """))

(:doc iterable-current
  (summary "The element at the current cursor position.")
  (arg s "The iterable collection or sequence.")
  (arg c "The cursor (after iterable-done? returned #f).")
  (returns "The element at c.")
  (see iterable-done? iterable-next))

(:doc iterable-next
  (summary "Returns the cursor for the next element.")
  (arg s "The iterable collection or sequence.")
  (arg c "The cursor.")
  (returns "The cursor for the next element, or past-the-end.")
  (see iterable-start iterable-done?)
  (reference """
    For cursors that wrap an enumerator (such as @code{Vec}, @code{Seq}, and
    @code{Map}), this returns the cursor itself, while @code{iterable-done?}
    advances the position.
    """))

(:doc Iterable
  (summary "Trait for sequentially iterable collections, used by (:for x s) loops.")
  (tparam %s "The iterable collection or sequence type.")
  (see iterable-start iterable-done? iterable-current iterable-next fold map ->seq)
  (example """
    (loop (:for x '(1 2 3))
          (:acc (summing x)))          ; 6

    (seq->list (map (fun (x) (* x x)) (range 0 4)))   ; (0 1 4 9)
    """)
  (reference """
    An implementation defines two associated types: @code{%elem} (the element
    yielded) and @code{%cursor} (the cursor type), and implements the four core
    methods: @code{iterable-start}, @code{iterable-done?},
    @code{iterable-current}, and @code{iterable-next}.

    Default implementations are provided for @code{fold}, @code{map},
    @code{filter}, @code{take}, @code{drop}, @code{take-while},
    @code{drop-while}, @code{enumerate}, @code{flat-map}, @code{any?},
    @code{all?}, @code{find}, @code{for-each}, and @code{->seq}. Methods
    returning a @code{Seq} are lazy; @code{fold}, @code{any?}, @code{all?},
    @code{find}, and @code{for-each} execute eagerly.
    """))

;; ---------------------------------------------------------------------------
;; Iterable: the operations over it
;; ---------------------------------------------------------------------------

(:doc fold
  (summary "Combines every element of an iterable into one value, front to back.")
  (arg f "The accumulator function: (f elem acc) returning the next accumulator.")
  (arg acc "The initial value.")
  (arg s "The iterable collection or sequence.")
  (returns "The accumulated result, or acc if s is empty.")
  (see seq-fold for-each)
  (example """
    (fold + 0 '(1 2 3))                         ; 6
    (fold (fun (x acc) (Cons x acc)) '() [1 2 3]) ; (3 2 1)
    """)
  (reference """
    A loop, not a @code{Seq}: it runs at once. The callback is an ordinary
    function; @code{seq-fold} takes one that may suspend, over a
    @code{Seq}.
    """))

(:doc map
  (summary "A lazy sequence of a function applied to each element.")
  (arg f "The transformation function.")
  (arg s "The iterable collection or sequence.")
  (returns "A Seq of the transformed elements, in order.")
  (see filter flat-map seq-map seq->list)
  (example """
    (seq->list (map (fun (x) (* 2 x)) '(1 2 3)))   ; (2 4 6)
    """)
  (reference """
    Returns a @code{Seq} regardless of @code{s}'s concrete collection type:
    elements are produced lazily as the sequence is evaluated, and @code{f}
    runs on each traversal. Use @code{seq->list} or @code{seq->vec} to collect
    results into a concrete data structure.
    """))

(:doc filter
  (summary "A lazy sequence of the elements that satisfy a predicate.")
  (arg f "The predicate function.")
  (arg s "The iterable collection or sequence.")
  (returns "A Seq of elements matching the predicate, in order.")
  (see map take-while seq-filter))

(:doc take
  (summary "A lazy sequence of the first n elements.")
  (arg n "The number of elements to take (0 or negative yields an empty sequence).")
  (arg s "The iterable collection or sequence.")
  (returns "A Seq of s's first n elements, or all elements if s contains fewer.")
  (see drop take-while seq-take)
  (reference """
    Stops after the n-th element without pulling additional elements from s,
    making it safe for endless sequences and stream ports.
    """))

(:doc drop
  (summary "A lazy sequence skipping the first n elements.")
  (arg n "The number of elements to skip.")
  (arg s "The iterable collection or sequence.")
  (returns "A Seq of s without its first n elements; empty if s has no more than n elements.")
  (see take drop-while seq-drop))

(:doc take-while
  (summary "A lazy sequence of elements taken while a predicate holds true.")
  (arg f "The predicate function.")
  (arg s "The iterable collection or sequence.")
  (returns "A Seq of s's leading elements while (f x) is true.")
  (see drop-while take filter))

(:doc drop-while
  (summary "A lazy sequence skipping elements while a predicate holds true.")
  (arg f "The predicate function.")
  (arg s "The iterable collection or sequence.")
  (returns "A Seq of s starting from the first element where (f x) returns #f.")
  (see take-while drop)
  (reference """
    Each traversal re-evaluates @code{s} from the start, skipping leading
    elements where @code{f} returns #t.
    """))

(:doc enumerate
  (summary "A lazy sequence of each element paired with its index.")
  (arg s "The iterable collection or sequence.")
  (returns "A Seq of (Tuple i x), with index i counting from 0.")
  (see map up-from)
  (example """
    (seq->list (enumerate "ab"))   ; the pairs 0 and #\a, 1 and #\b
    """))

(:doc flat-map
  (summary "A lazy sequence flattening the sub-sequences returned by a function.")
  (arg f "A function taking each element and returning a Seq.")
  (arg s "The iterable collection or sequence.")
  (returns "A Seq concatenating the elements of each sequence returned by f.")
  (see map seq-append))

(:doc any?
  (summary "Whether at least one element satisfies a predicate.")
  (arg f "The predicate. It may suspend.")
  (arg s "The iterable collection or sequence.")
  (returns "#t if (f x) is true for any element; #f if none match or s is empty.")
  (see all? find)
  (reference """
    Stops at the first match; @code{f} is not called on subsequent elements.
    """))

(:doc all?
  (summary "Whether all elements satisfy a predicate.")
  (arg f "The predicate. It may suspend.")
  (arg s "The iterable collection or sequence.")
  (returns "#t if (f x) is true for all elements (or s is empty); #f if any element returns false.")
  (see any? find))

(:doc find
  (summary "Finds the first element that satisfies a predicate.")
  (arg f "The predicate. It may suspend.")
  (arg s "The iterable collection or sequence.")
  (returns "(Some x) for the first element satisfying f; None otherwise.")
  (see any? filter))

(:doc for-each
  (summary "Calls a function on each element for its side effects.")
  (arg f "The procedure to call. It may suspend.")
  (arg s "The iterable collection or sequence.")
  (see fold seq-for-each))

(:doc ->seq
  (summary "Converts an iterable into a lazy sequence.")
  (arg s "The iterable collection or sequence.")
  (returns "A Seq of s's elements, in order. Passing a Seq returns the sequence itself.")
  (see seq->list seq->vec list->seq vec->seq))

;; ---------------------------------------------------------------------------
;; Cursor
;; ---------------------------------------------------------------------------

(:doc Cursor
  (summary "Bidirectional cursor trait for collections navigable forward and backward.")
  (tparam %s "The collection type.")
  (see cursor-start cursor-end cursor-ref cursor-next cursor-prev string-cursor-start)
  (reference """
    An implementation defines @code{%elem} and @code{%cursor} and provides the six
    core cursor methods. Every method takes the collection as well as the cursor.

    The prelude implements it for @code{string}, with @code{StringCursor} as
    the cursor type.
    """))

(:doc cursor-start
  (summary "Returns a cursor positioned at the first element.")
  (arg s "The collection.")
  (returns "A cursor; at the end if s is empty.")
  (see cursor-end cursor-next))

(:doc cursor-end
  (summary "Returns a cursor positioned past the last element.")
  (arg s "The collection.")
  (returns "The cursor after the last element: the terminating boundary.")
  (see cursor-end? cursor-prev))

(:doc cursor-end?
  (summary "Whether a cursor has reached the terminating boundary.")
  (arg s "The collection.")
  (arg c "The cursor.")
  (returns "#t if at the past-the-end position; #f otherwise.")
  (see cursor-end cursor-ref))

(:doc cursor-ref
  (summary "The element at the current cursor position.")
  (arg s "The collection.")
  (arg c "The cursor. Must not be at the end.")
  (returns "The element at c.")
  (see cursor-end? string-cursor-ref))

(:doc cursor-next
  (summary "Returns the cursor for the next element.")
  (arg s "The collection.")
  (arg c "The cursor.")
  (returns "The cursor after c.")
  (see cursor-prev cursor-end?))

(:doc cursor-prev
  (summary "Returns the cursor for the previous element.")
  (arg s "The collection.")
  (arg c "The cursor.")
  (returns "The cursor before c.")
  (see cursor-next cursor-start))

;; ---------------------------------------------------------------------------
;; Collector
;; ---------------------------------------------------------------------------

(:doc collector-init
  (summary "The accumulator a collector starts from.")
  (arg c "The collector.")
  (returns "The empty accumulator.")
  (see collector-step collector-finish))

(:doc collector-step
  (summary "An accumulator with one more value taken in.")
  (arg c "The collector.")
  (arg acc "The accumulator so far.")
  (arg x "The value to take in.")
  (returns "The updated accumulator. A mutable builder-backed collector modifies in place and returns the same builder.")
  (see collector-init collector-finish))

(:doc collector-finish
  (summary "What a collector delivers from its accumulator.")
  (arg c "The collector.")
  (arg acc "The accumulator, after the last step.")
  (returns "The finished value: a list for listing, a sum for summing, and so on.")
  (see collector-init collector-step))

(:doc Summing
  (summary "The collector that adds up numbers.")
  (tparam %a "The type of the numbers, and of the sum.")
  (case summing "The collector: (summing x) adds x each step.")
  (see Counting Folding collector-step)
  (example """
    {summing x (:for x (range 1 5))}   ; 10
    {summing x (:for x [0.5 0.25])}    ; 0.75
    """)
  (reference """
    Starts from 0, and its result is the total. It works at every numeric
    type, through @code{(where (Num %a))} on its implementation: the sum has
    the type of the values it adds, and a sum of anything else is a type
    error at the loop.
    """))

(:doc Counting
  (summary "The collector that counts its steps.")
  (tparam %a "The type of the stepped value, which is ignored.")
  (tparam %n "The type of the count.")
  (case counting "The collector: (counting x) adds one each step, whatever x is.")
  (see Summing Folding)
  (example """
    (loop (:for x xs)
          (:acc n (counting x) #:when (even? x))
          => n)                     ; how many are even
    """)
  (reference """
    Starts from 0. The step expression is evaluated and its value dropped.
    The count is a number of the type its use asks for, a @code{long} say,
    and an @code{int} when nothing asks, as a literal is.
    """))

(:doc Folding
  (summary "The collector that keeps the last value stepped into it.")
  (tparam %a "The type of the value kept.")
  (case folding "The collector, with the value to start from: (folding init expr).")
  (see fold Summing Counting)
  (example """
    (loop (:for x xs)
          (:acc total (folding 0 (+ x total)))
          => total)                 ; a fold, written as a loop
    """)
  (reference """
    @code{(:acc name (folding init expr))} starts @code{name} at
    @code{init} and replaces it with @code{expr}'s value at every step. Since
    @code{expr} may read @code{name}, that is a fold, and it is how
    @code{fold}, @code{any?}, @code{all?} and @code{find} are written.
    @code{:final} uses one too.
    """))

;; ---------------------------------------------------------------------------
;; Collection
;; ---------------------------------------------------------------------------

(:doc length
  (summary "How many elements a collection holds.")
  (arg c "The collection.")
  (returns "The number of elements: characters for a string, pairs for a map.")
  (see empty? seq-length)
  (reference """
    A method of the @code{Collection} trait, implemented in the prelude for
    @code{List}, @code{Array}, @code{Vec}, @code{Map}, @code{Range},
    @code{string}, @code{Seq} and the builders and transients
    (@code{VecBuilder}, @code{ListBuilder}, @code{MapBuilder},
    @code{TransientMap}), and in their own modules for the sets and ordered
    collections.

    A @code{List} is walked to count it. A string is too, since it counts
    characters, which is @code{string-count} rather than
    @code{string-length}. A @code{Seq} is walked, which for one over a port
    or a file is reading it to the end. A @code{Range}'s is computed from
    its bounds and step.
    """))

(:doc empty?
  (summary "Whether a collection holds nothing.")
  (arg c "The collection.")
  (returns "#t when it has no elements.")
  (see length seq-empty?)
  (reference """
    For a @code{Seq} this starts a walk and pulls at most one element. For a
    @code{Range} it compares the bounds only: lo not below hi.
    """))

;; ---------------------------------------------------------------------------
;; Addable and Addable!
;; ---------------------------------------------------------------------------

(:doc add
  (summary "A new collection with one more element.")
  (arg coll "The collection, which is left as it was.")
  (arg x "The element. For a map, a pair (k . v).")
  (returns "The new collection.")
  (see add-all add! vec-add map-set)
  (reference """
    A method of the persistent @code{Addable} trait. A @code{Vec} appends at
    the end. A @code{Map} has set semantics: a key already there takes the
    new value; @code{map-add}, which refuses a duplicate, keeps its own name.
    The sets and ordered collections implement it in their own modules, where
    adding an element already present changes nothing.

    @code{List} has no implementation: a cheap add would prepend, and an
    in-order one costs a walk per element. Build one with a
    @code{ListBuilder}.
    """))

(:doc add-all
  (summary "A new collection with all elements from an iterable added.")
  (arg coll "The persistent collection to add to (unmodified).")
  (arg xs "An Iterable whose elements match coll's element type.")
  (returns "The new collection, with xs's elements added in order.")
  (see add add-all!)
  (example """
    (add-all [1 2] '(3 4))   ; [1 2 3 4]
    """)
  (reference """
    The default implementation calls @code{add} once per element. The element type of
    @code{xs} must match the collection's element type.
    """))

(:doc add!
  (summary "Adds an element to a builder or transient, in place.")
  (arg coll "The builder or transient.")
  (arg x "The element. For a map-shaped one, a pair (k . v).")
  (see add-all! add)
  (reference """
    A method of @code{Addable!}, the trait over every mutable sink, so that
    filling a collection does not care which one it fills. The prelude
    implements it for @code{VecBuilder}, @code{ListBuilder},
    @code{StringBuilder} (whose element is a @code{char}),
    @code{MapBuilder} and @code{TransientMap}; the set and
    ordered-collection builders and transients implement it in their own
    modules.
    """))

(:doc add-all!
  (summary "Adds everything an iterable yields to a builder or transient, in place.")
  (arg coll "The builder or transient.")
  (arg xs "An Iterable whose elements match coll's element type.")
  (see add! add-all)
  (reference """
    In the order @code{xs} yields them. The source may be a @code{List}, a
    @code{Vec}, a @code{Range}, a string or a @code{Map}, or anything else
    @code{Iterable}; an element type that does not match the sink's is
    refused at the call.
    """))

;; ---------------------------------------------------------------------------
;; Ranges and counting
;; ---------------------------------------------------------------------------

(:doc Range
  (summary "An integer range from lo up to but not including hi.")
  (field lo "The first integer, included.")
  (field hi "The upper bound, not included.")
  (field by "The positive step.")
  (see range range-by up-from)
  (reference """
    Implements @code{Iterable} and @code{Collection}. Traversal stops at the first
    value at or above @code{hi}, counting upward only. @code{range-by} requires
    a step strictly greater than zero. Use @code{down-from} to count downward.
    """))

(:doc range
  (summary "The integers from lo up to but not including hi.")
  (arg lo "The first integer, included.")
  (arg hi "The bound, not included. At or below lo, the range is empty.")
  (returns "A Range with step 1.")
  (see range-by up-from seq-range)
  (example """
    {listing i (:for i (range 0 4))}   ; (0 1 2 3)
    """))

(:doc range-by
  (summary "Every by-th integer from lo up to but not including hi.")
  (arg lo "The first integer, included.")
  (arg hi "The bound, not included.")
  (arg by "The positive step size. Must be greater than zero.")
  (returns "A Range.")
  (see range up-from down-from)
  (example """
    {listing i (:for i (range-by 0 10 3))}   ; (0 3 6 9)
    """))

(:doc UpFrom
  (summary "An iterable sequence of ints counting upward; returned by up-from.")
  (field from "The first int.")
  (field to "The bound, not included.")
  (field by "The step, positive.")
  (see up-from DownFrom))

(:doc DownFrom
  (summary "An iterable sequence of ints counting downward; returned by down-from.")
  (field from "The first int.")
  (field to "The bound, included.")
  (field by "The distance subtracted each step, positive.")
  (see down-from UpFrom))

(:doc up-from
  (summary "The ints counting up from a start, with or without a bound.")
  (arg from "The first int.")
  (key #:to "Where to stop, not included. Defaults to int-max.")
  (key #:by "The positive step.")
  (returns "An iterable sequence for (:for ...) loops.")
  (see down-from range int-max)
  (example """
    (loop (:for i (up-from 0))          ; no #:to: the port running out ends it
          (:for line (in-port p (fun (q) (read-line/opt q))))
          (:do (println (Tuple i line))))
    """)
  (reference """
    @code{range} written the way a loop reads. @code{(up-from 0 #:to n)} is
    the indices of something of length @code{n}. Without @code{#:to} it is
    what @code{:finish}, @code{:final} and @code{:until-cancelled} end.

    A @code{#:by} of zero or less is a panic, since the walk would never
    move. The struct is a value, so a loop over one allocates nothing for
    it.
    """))

(:doc down-from
  (summary "The ints counting down from a start, with or without a bound.")
  (arg from "The first int.")
  (key #:to "Where to stop, included. Defaults to int-min.")
  (key #:by "The distance to subtract each step. Positive.")
  (returns "An iterable sequence for (:for ...) loops.")
  (see up-from range int-min)
  (example """
    {listing i (:for i (down-from 3 #:to 0))}   ; (3 2 1 0)
    """)
  (reference """
    Unlike @code{up-from}'s, its @code{#:to} is included:
    @code{(down-from n #:to 0)} counts down to zero and says zero.
    @code{#:by} is a distance, positive here too; zero or less is a panic.
    """))

(:doc int-max
  (summary "The largest int, 2147483647.")
  (see int-min up-from)
  (reference """
    @code{System.Int32.MaxValue}. It is @code{up-from}'s default
    @code{#:to}, and exported because a default is evaluated where the call
    is written.
    """))

(:doc int-min
  (summary "The smallest int, -2147483648.")
  (see int-max down-from)
  (reference """
    @code{System.Int32.MinValue}, @code{down-from}'s default @code{#:to}.
    """))

;; ---------------------------------------------------------------------------
;; Seq: lazy sequences
;; ---------------------------------------------------------------------------

(:doc seq-empty
  (summary "The empty sequence.")
  (returns "A Seq with no elements.")
  (see seq-empty? seq-unfold))

(:doc seq-empty?
  (summary "Whether a sequence has no elements.")
  (arg s "The sequence.")
  (returns "#t when it yields nothing.")
  (see seq-head empty?)
  (reference """
    Starts a walk of @code{s} and pulls at most one element, so over a
    source with effects it runs them as far as that element.
    """))

(:doc seq-head
  (summary "The first element of a sequence.")
  (arg s "The sequence. Not empty.")
  (returns "The first element it yields.")
  (raises System.InvalidOperationException "When s is empty.")
  (see seq-empty? seq-drop find)
  (reference """
    Pulls one element and no more: @code{(seq-head (seq-map f xs))} calls
    @code{f} once. There is no @code{seq-tail}, since a @code{Seq} has no
    rest to step to; @code{(seq-drop s 1)} is the sequence without its
    first element.
    """))

(:doc seq-map
  (summary "A sequence of a function applied to each element, lazily.")
  (arg f "The function.")
  (arg s "The sequence.")
  (returns "A Seq of the transformed elements, evaluated as pulled.")
  (see map seq-filter))

(:doc seq-filter
  (summary "A sequence of the elements that satisfy a predicate, lazily.")
  (arg f "The predicate.")
  (arg s "The sequence.")
  (returns "A Seq of the elements where (f x) is true.")
  (see filter seq-map))

(:doc seq-take
  (summary "A sequence of the first n elements, lazily.")
  (arg s "The sequence.")
  (arg n "How many. Zero or less gives the empty sequence.")
  (returns "A Seq of s's first n elements, or all of them if it has fewer.")
  (see seq-drop take)
  (reference """
    After the n-th element it stops without pulling another from @code{s},
    so it is safe on an endless sequence.
    """))

(:doc seq-drop
  (summary "A sequence without its first n elements, lazily.")
  (arg s "The sequence.")
  (arg n "How many to skip. Zero or less skips none.")
  (returns "A Seq of what follows; empty when s has no more than n.")
  (see seq-take drop seq-head)
  (reference """
    What a @code{seq-tail} would have been: @code{(seq-drop s 1)}. To walk a
    sequence, use @code{loop} rather than dropping one at a time, which
    starts over from the beginning each time.
    """))

(:doc seq-unfold
  (summary "A sequence generated from a state, lazily.")
  (arg f "Maps a state to (Some (Tuple x next-state)), the next element and the state after it, or to None to end.")
  (arg state "The first state.")
  (returns "A Seq of the elements f produces, until it returns None.")
  (see seq-range seq-empty)
  (example """
    (seq-take (seq-unfold (fun (n) (Some (Tuple n (* 2 n)))) 1) 5)
    ; 1 2 4 8 16
    """))

(:doc seq-range
  (summary "The ints from start up to but not including stop, as a sequence.")
  (arg start "The first, included.")
  (arg stop "The bound, not included. At or below start, the sequence is empty.")
  (returns "A lazy Seq of ints.")
  (see range seq-unfold))

(:doc seq-append
  (summary "One sequence followed by another, lazily.")
  (arg s1 "The first.")
  (arg s2 "The second, walked once s1 is exhausted.")
  (returns "A Seq of s1's elements, then s2's.")
  (see flat-map))

(:doc seq-length
  (summary "How many elements a sequence yields.")
  (arg s "The sequence.")
  (returns "The count.")
  (see length seq-empty?)
  (reference """
    It walks @code{s} to the end. Over a source with effects that is a
    consumption: the length of a @code{port->seq} is read from the port.
    """))

(:doc seq->list
  (summary "A sequence's elements as a list.")
  (arg s "The sequence, walked to the end.")
  (returns "A list of its elements, in order.")
  (see seq->vec list->seq ->seq))

(:doc seq->vec
  (summary "A sequence's elements as a vec.")
  (arg s "The sequence, walked to the end.")
  (returns "A vec of its elements, in order.")
  (see seq->list vec->seq ->seq))

(:doc seq-fold
  (summary "Combines every element of a sequence into one value, front to back.")
  (arg f "Called with an element and the current accumulator; returns the next value. It may suspend.")
  (arg init "The value to start from.")
  (arg s "The sequence.")
  (returns "The final accumulated value, or init when s is empty.")
  (see fold seq-for-each)
  (reference """
    Eager, unlike the sequence builtins, so its callback may be of either
    colour: it runs here, not wherever the sequence is pulled.
    """))

(:doc seq-for-each
  (summary "Calls a function on each element of a sequence, for its effect.")
  (arg f "The function. It may suspend.")
  (arg s "The sequence.")
  (see for-each seq-fold))

;; ---------------------------------------------------------------------------
;; Seq cursors
;; ---------------------------------------------------------------------------

(:doc seq-cursor
  (summary "A cursor for one traversal of a sequence.")
  (arg s "The sequence.")
  (returns "A cursor holding a fresh enumerator of s.")
  (see seq-cursor-done? seq-cursor-current)
  (reference """
    What @code{Iterable}'s implementation for @code{Seq} traverses with. Holding
    the enumerator allows each element to be evaluated once, rather than
    re-evaluating earlier elements. The cursor is stateful and consumed during
    iteration; create a new cursor for repeated traversals.
    """))

(:doc seq-cursor-done?
  (summary "Advances a seq cursor to its next element, returning #t if exhausted.")
  (arg c "The cursor.")
  (returns "#t when the sequence is exhausted; #f if an element is available.")
  (see seq-cursor seq-cursor-current)
  (reference """
    Advances the cursor: call once before each @code{seq-cursor-current}. When
    it returns @code{#t}, the sequence is exhausted and the underlying enumerator
    is disposed, closing any underlying file or stream resources. Calling it
    again continues to return @code{#t}.
    """))

(:doc seq-cursor-current
  (summary "The element at the current seq cursor position.")
  (arg c "The cursor, after seq-cursor-done? returned #f.")
  (returns "The element.")
  (see seq-cursor-done?))
