;; The entry point takes the arguments as a (Vec string), and a signature is
;; the only way to write a different type for them.
;;
;; `(Array string)` is what the arguments arrive as in C#, so it looks like the
;; obvious thing to ask for — and it used to compile, then fail in the generated
;; entry point with a CS1503 about converting an int, because a `main` of an
;; unrecognized shape was handed a zero.

;; EXPECT-ERROR: 'main' is a program's entry point and takes the arguments, a (Vec string)
;; EXPECT-ERROR: This one is (-> (Array string) int)

(import (std prelude))

(: (-> (Array string) int))
(defun (main args)
  (println (int->string (array-length args)))
  0)
