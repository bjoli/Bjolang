;; `-?->` as a return type.
;;
;; A function that hands a function back has already decided which one it built.
;; There is no later moment at which the caller's context could pick, because
;; the value exists by then — and a delegate's colour is its type.
;;
;; Saying "whichever colour my argument was" is a real thing to want, and it is
;; what an effect variable with a *name* would express. There is one arrow head
;; reserved for that day and nothing that constructs it.

;; EXPECT-ERROR: this is the return type

(import (std prelude))

(: adder (-> int (-?-> int int)))
(defun (adder n) (fun (x) (+ x n)))

(defun (main args) 0)
