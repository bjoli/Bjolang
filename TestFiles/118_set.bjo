;; `(std set)`: the unordered set, its builder and its transient.
;;
;; Everything here reaches the collection through `import/extern` clauses in the
;; library — there is no builtin in the path — so what is being tested is as
;; much the generic interop as the data structure: a .NET generic type named by
;; `import/class`, generic static methods resolved from their declared
;; signatures, and the type arguments written out at every call.

(import (std prelude))
(import (std set))
(import (std simpletest))

(: expect-bool (-> string bool bool void))
(defun (expect-bool label actual wanted)
  (if (= actual wanted)
      (println (str "ok: " label))
      (println (str "FAILURE: " label))))

(: expect-str (-> string string string void))
(defun (expect-str label actual wanted)
  (if (string=? actual wanted)
      (println (str "ok: " label))
      (println (str "FAILURE: " label " gave " actual " but wanted " wanted))))

(: string=? (-> string string bool))
(defun (string=? a b) (= a b))

;; The type is the library's, written in a signature here — which is what an
;; exported `import/class` alias buys.
(: numbers (-> (Set int)))
(defun (numbers)
  (set-add (set-add (set-add (set-empty) 1) 2) 3))

;; --- The set ---------------------------------------------------------------

(: test-set (-> void))
(defun (test-set)
  (def s (numbers))
  (expect "length" (set-length s) 3)
  (expect-bool "contains a member" (set-contains? s 2) #t)
  (expect-bool "contains a stranger" (set-contains? s 9) #f)
  (expect-bool "empty? of a set with elements" (set-empty? s) #f)
  (expect-bool "empty? of the empty set" (set-empty? (set-clear s)) #t)

  ;; Adding an element twice is adding it once: that is what makes it a set.
  (expect "add is idempotent" (set-length (set-add s 1)) 3)
  (expect "remove" (set-length (set-remove s 1)) 2)
  (expect "remove of a stranger" (set-length (set-remove s 9)) 3)

  (expect "add-all" (set-length (set-add-all s (list->seq (list 3 4 5)))) 5)
  (expect "remove-all" (set-length (set-remove-all s (list->seq (list 1 2)))) 1)

  (def other (set-add (set-add (set-empty) 3) 4))
  (expect "union" (set-length (set-union s other)) 4)

  (expect "filter" (set-length (set-filter #(> &1 1) s)) 2)
  (expect "fold" (set-fold + 0 s) 6)
  ;; A mapping that collides merges, which a list's map cannot do.
  (expect "map" (set-length (set-map #(% &1 2) s)) 2)
  (expect-bool "any?" (set-any? #(= &1 3) s) #t)
  (expect-bool "any? with no hit" (set-any? #(= &1 30) s) #f)
  ;; `iter` reports whether the walk ran to the end, so a predicate that fails
  ;; somewhere answers false.
  (expect-bool "iter runs out" (set-iter #(< &1 10) s) #t)
  (expect-bool "iter stops early" (set-iter #(< &1 3) s) #f)

  (match (set-find #(> &1 2) s)
    ((Some found) (expect "find" found 3))
    (None (println "FAILURE: find found nothing")))

  (match (set-find #(> &1 20) s)
    ((Some _) (println "FAILURE: find found something"))
    (None (println "ok: find comes up empty")))

  (def b (vecbuilder-empty))
  (set-for-each #(vecbuilder-add! b &1) s)
  (expect "for-each" (vec-fold + 0 (vecbuilder->vec b)) 6))

;; --- Conversions and traits ------------------------------------------------

(: test-traits (-> void))
(defun (test-traits)
  (def s (numbers))
  (expect "Collection length" (length s) 3)
  (expect-bool "Collection empty?" (empty? s) #f)
  (expect "Collection ->seq" (seq-length (->seq s)) 3)
  (expect "Foldable fold" (fold + 0 s) 6)
  (expect "Functor map" (set-length (map #(* &1 10) s)) 3)

  ;; Iterable, through an ordinary loop.
  (expect "loop over a set" (loop (:for x s) (:acc total (summing x))) 6)

  ;; And as an accumulator, through the builder.
  (def evens (loop (:for x (range 0 10)) (:when (= 0 (% x 2))) (:acc s (setting x))))
  (expect "setting collector" (set-length evens) 5)
  (expect-bool "setting collector holds 8" (set-contains? evens 8) #t)

  (expect "list->set" (set-length (list->set (list 1 1 2))) 2)
  (expect "set->list" (list-length (set->list s)) 3)
  (expect "vec->set" (set-length (vec->set [1 2 2 3])) 3)
  (expect "set->vec" (vec-length (set->vec s)) 3)
  (expect "seq->set" (set-length (seq->set (list->seq (list 5 5)))) 1)

  ;; The string of a one-element set is pinned; a larger one is in trie order,
  ;; which is stable but not worth writing down.
  (expect-str "->str" (->str (set-add (set-empty) 7)) "#{7}"))

;; --- The builder -----------------------------------------------------------

(: test-builder (-> void))
(defun (test-builder)
  (def b (setbuilder-empty))
  (setbuilder-add! b 1)
  (setbuilder-add! b 2)
  (setbuilder-add! b 1)
  ;; The builder counts *appends*: duplicates are compacted when the set is
  ;; built, which is the whole reason it is faster than adding one at a time.
  (expect "builder length counts appends" (setbuilder-length b) 3)
  (expect "builder->set compacts" (set-length (setbuilder->set b)) 2)

  (def c (setbuilder-empty))
  (setbuilder-add-all! c (list->seq (list 1 2 3)))
  (expect "builder add-all" (set-length (setbuilder->set c)) 3)

  (def d (set->setbuilder (numbers)))
  (setbuilder-add! d 4)
  (expect "set->setbuilder" (set-length (setbuilder->set d)) 4))

;; --- The transient ---------------------------------------------------------

(: test-transient (-> void))
(defun (test-transient)
  (def t (transientset-empty))
  (expect-bool "transient starts empty" (transientset-empty? t) #t)
  (transientset-add! t 1)
  (transientset-add! t 2)
  (transientset-add! t 1)
  ;; The persistent interface, in place: `add!` of a member already there is the
  ;; same no-op `set-add` is.
  (expect "transient length" (transientset-length t) 2)
  (expect-bool "transient contains?" (transientset-contains? t 2) #t)
  (transientset-remove! t 1)
  (expect "transient remove!" (transientset-length t) 1)

  (transientset-add-all! t (list->seq (list 7 8 9)))
  (expect "transient add-all!" (transientset-length t) 4)
  (transientset-remove-all! t (list->seq (list 7 8)))
  (expect "transient remove-all!" (transientset-length t) 2)

  ;; The snapshot is taken in O(1), and the transient goes on being usable —
  ;; what it hands over it disowns, so the next edit copies instead.
  (def snapshot (transientset->set t))
  (transientset-add! t 100)
  (expect "the snapshot did not move" (set-length snapshot) 2)
  (expect "the transient did" (transientset-length t) 3)

  (def from-set (set->transientset (numbers)))
  (transientset-add! from-set 4)
  (expect "set->transientset" (transientset-length from-set) 4)
  (expect "and the set it came from is untouched" (set-length (numbers)) 3))

;; A set of something other than an int, to pin that the type arguments are
;; solved per call site rather than once.
(: test-strings (-> void))
(defun (test-strings)
  (def s (set-add (set-add (set-empty) "a") "b"))
  (expect "a set of strings" (set-length s) 2)
  (expect-bool "and it can be asked about" (set-contains? s "b") #t))

(defun (main args)
  (test-set)
  (test-traits)
  (test-builder)
  (test-transient)
  (test-strings)
  0)
