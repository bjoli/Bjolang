;; A literal at a newtype that is a number is one of the type it wraps, so a
;; real literal is refused at a newtype of int.

;; EXPECT-ERROR: '2.5' has a fraction, and the type 'int' has none.

(import (std prelude))

(type (: Banana (Newtype int)))
(impl (Num Banana) #:via int)
(impl (Ordered Banana) #:via int)

(def b (+ (Banana 1) 2.5))

(defun (main args) 0)
