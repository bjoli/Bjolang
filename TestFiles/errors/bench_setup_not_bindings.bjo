;; EXPECT-ERROR: #:setup takes bindings
;; #:setup was once an expression, and the body a function of its value. It
;; takes bindings now, which the body names; the old form says what to write.
(import (std prelude))
(import (std bench))

(def/bench "sum"
  #:setup (list 1 2 3)
  (fun (xs) (list-length xs)))

(run-benches)
