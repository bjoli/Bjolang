;; A module-level value cannot be a span: it is a static field.
;; EXPECT-ERROR: 's' is a module-level definition of type (System.Span long)
(import (std prelude))
(import/extern
  (whole (: System.MemoryExtensions.AsSpan (-> (Array %a) (System.Span %a))))
  (sleep (: System.Threading.Tasks.Task.Delay (-> int void) #:async #:uncancellable)))
(: (-> (System.Span long) int))
(defun (len s) (.-Length s))

(def ys (vec->array [1L]))
(def s (whole ys))
(defun (main) 0)
