;; An imported case named `Eq` does not stand for the trait `Eq`, which `Ord`
;; requires: a trait's name follows only a trait's spelling.
(import (std prelude))
(import (std simpletest))
(import "inc/case_named_eq.bjo")

(: (-> %a %a bool) (where (Ord %a)))
(defun (same? a b) (= (compare a b) 0))

(defun (main)
  (expect-true "Ord gives Eq" (same? 3 3))
  (expect "the case is a case" (written (Eq 1)) "(Eq 1)")
  0)
