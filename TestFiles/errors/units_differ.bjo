;; Two number types whose units differ do not unify.

;; EXPECT-ERROR: has the wrong type
;; EXPECT-ERROR: (double m)
;; EXPECT-ERROR: (double s)
;; EXPECT-ERROR: Their units differ: m and s.

(import (std prelude))

(def/dimension length #:base m)
(def/dimension time #:base s)

(: same (-> (double m) (double m)))
(defun (same x) x)

(: sec (-> (double s) (double s)))
(defun (sec x) x)

(: bad (-> (double s) (double m)))
(defun (bad x) (same (sec x)))

(defun (main) 0)
