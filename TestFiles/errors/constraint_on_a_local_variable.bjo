;; EXPECT-ERROR: 'outer' needs (Num %a), which its signature does not declare
;;
;; `+` in `inner` puts `Num` on `inner`'s parameter. A local function cannot
;; take a `where` clause, so `inner` is not generalized in that variable, and
;; the call `(inner x)` makes it `outer`'s `%a`. The constraint is then
;; `outer`'s, and its signature has to declare it.
;;
;; Generalized, `inner` carried `Num` on a variable of its own. Hung on
;; `outer`'s scheme it became a C# `where` clause naming a type parameter the
;; method does not declare — CS0699, in generated code.
(import (std prelude))

(: (-> %a %a))
(defun (outer x)
  (defun (inner y) (+ y y))
  (inner x))

(defun (main)
  (println (outer 21))
  0)
