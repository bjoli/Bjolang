;; A DateTime has no zone, so it has no offset to write: only a moment's format
;; has one.

;; EXPECT-ERROR: `offset` is not a tag of the union datetime/DateTimePart

(import (std datetime))

(defun (main)
  (match (datetime 2026 10 25 #:hours 2)
    ((Some dt) (println (datetime->text dt '((hours 2) offset))))
    (None (println "none")))
  0)
