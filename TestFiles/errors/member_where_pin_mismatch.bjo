;; The pin, refused at the call.
;;
;; `add-all!`'s where clause pins `#:elem` of the source to the sink's own
;; element: the element the iterable yields *is* the element the sink takes.
;; A string list into an int sink violates the equation, and the error lands
;; on the call that raised it — not inside a monomorphise copy, not in the
;; prelude — naming the pin and both types.

;; EXPECT-ERROR: the associated type #:elem of 'Iterable'
;; EXPECT-ERROR: does not hold at this call

(import (std prelude))

(defun (main)
  (def (: vb (VecBuilder int)) (vecbuilder-empty))
  (add-all! vb (list "a" "b"))
  0)
