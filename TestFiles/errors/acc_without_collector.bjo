;; An `:acc` whose only element is a name.
;;
;; The collector is what an accumulator cannot do without: it is where the
;; initial value, the step and the finish come from. The *name* is optional —
;; `(:acc (listing x))` invents one — so a lone symbol is the one shape that
;; says nothing, and the message names both spellings rather than guessing
;; which one was meant.

;; EXPECT-ERROR: Expected: (:acc [name] (collector ...) [#:when cond])

(import (std prelude))

(: total (-> (Vec int) int))
(defun (total xs)
  (loop (:for x xs)
        (:acc summed)))

(defun (main args)
  (println (total [1 2 3]))
  0)
