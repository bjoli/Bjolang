;; A (fun ...) cannot capture a span.
;; EXPECT-ERROR: 's' is a (System.Span long) bound outside this (fun ...), and a span cannot be captured
(import (std prelude))
(import/extern
  (whole (: System.MemoryExtensions.AsSpan (-> (Array %a) (System.Span %a))))
  (sleep (: System.Threading.Tasks.Task.Delay (-> int void) #:async #:uncancellable)))
(: (-> (System.Span long) int))
(defun (len s) (.-Length s))

(defun (main) (def xs (vec->array [1L])) (def s (whole xs)) (def f (fun () (.-Length s))) (println (f)) 0)
