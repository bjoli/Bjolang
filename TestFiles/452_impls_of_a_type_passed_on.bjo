;; A type reached through a module that passes it on comes with its
;; implementations, as the module that declares it is linked. They were read
;; from direct imports only, so a value displayed here took the blanket and
;; was written as the C# record it compiles to.
(import (std prelude))
(import (std simpletest))
(import "inc/passes_type_on.bjo")
(import "inc/passes_value_on.bjo")

(defun (main)
  (expect "a re-exported type's own implementation" (displayed (packed)) "a crate of 3")
  (expect "its derived Written" (written (make-crate 4)) "(Crate (items 4))")
  (expect "a type named in a signature" (displayed (boxed)) "a crate of 5")
  (expect "in an interpolation" #"${(boxed)}" "a crate of 5")
  0)
