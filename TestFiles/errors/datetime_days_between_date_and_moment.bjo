;; A calendar difference takes two values of one type, so a date and a moment
;; do not mix: the moment's date is taken with ->date, where it shows.

;; EXPECT-ERROR: these types do not match
;; EXPECT-ERROR: datetime/Date
;; EXPECT-ERROR: datetime/Moment
;; EXPECT-NO-ERROR: could not specialise

(import (std datetime))

(defun (main)
  (match (date 2026 10 25)
    ((Some d) (println (days-between d (now/moment))))
    (None (println "none")))
  0)
