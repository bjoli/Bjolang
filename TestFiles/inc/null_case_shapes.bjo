;; Unions for 334_null_case.bjo, from a module of their own: each has a case
;; that is `null` at run time, and an importer has to agree on that. `Label`
;; makes `Shape` too large to be a struct, which would have no `null` case.

(type/derive (Eq Ord) (: Shape (Union (: Dot int) (: Box int int) (: Label string double) Nothing)))
(type (: (Box %a) (Union Shut (: Open %a (Box %a)))))

(: area (-> Shape int))
(defun (area s)
  (match s
    ((Dot _) 0)
    ((Box w h) (* w h))
    ((Label _ _) 0)
    (Nothing -1)))

(export Shape Box area)
