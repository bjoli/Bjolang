;; Packningen är alltid utskriven. Ett värde som möter en lådtyp är ett vanligt
;; typfel, och det som fattas är en rad kod snarare än en regel — så felet säger
;; vilken.
;;
;; EXPECT-ERROR: these types do not match
;; EXPECT-ERROR: write (dyn ->str <expr>) to pack the value

(import (std prelude))

(: render-str (-> (dyn ->str) Unit))
(defun (render-str d)
  (println d))

(defun (main args)
  (render-str "hi")
  0)
