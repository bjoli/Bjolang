;; `#:elsewhere` takes the name of a parameter.

;; EXPECT-ERROR: #:elsewhere names a parameter of 'run', the one that is run on another thread

(import (std prelude))

(: (-> int (-> int) int) #:elsewhere)
(defun (run n work) (+ n (work)))

(defun (main) (println (int->string (run 1 (fun () 2)))) 0)
