;; Ena halvan av två moduler som heter lika.
;;
;; `../b/thing.bjo` heter också `thing` och deklarerar också en `Thing`.
;; Ingenting här vet om det, och ingenting här ska behöva veta det.

(export Thing make-a peel-a)
(import (std prelude))

(type (: Thing (Union (MkThingA int))))

(: make-a (-> int Thing))
(defun (make-a n)
  (MkThingA n))

(: peel-a (-> Thing int))
(defun (peel-a t)
  (match t
    ((MkThingA n) n)))
