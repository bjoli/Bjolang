
(import (std prelude))
(import (std simpletest))

(: id (-> %a %a))
(defun (id x) x)



      
;; Higher-order function returning a captured closure with generics
(: make-mapper (-> (-> %a %b) (-> (List %a) (List %b))))
(defun (make-mapper f)
  (fun (lst) (list-map f lst)))

(defun (main args)
  (def my-list (Cons "hej" (Cons "då" Nil)))
  (defun (my-mapper lst)
    (let ((mapper (make-mapper id)))
     (mapper lst)))
  (def h (my-mapper my-list))
  ;; Stängningen som `make-mapper` gav tillbaka ska mappa varje element,
  ;; i ordning, och `id` ska lämna dem orörda.
  (expect "the head of the mapped list" (list-head h) "hej")
  (expect "every element, in order"
          (list-foldl (fun (acc s) (string-append acc s)) "" h)
          "hejdå")
  (expect "the mapper preserves the length" (length h) 2)
  0)
