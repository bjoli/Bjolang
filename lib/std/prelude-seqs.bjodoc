;; ---------------------------------------------------------------------------
;; Seq: lazy sequences
;; ---------------------------------------------------------------------------

(:doc seq-empty
  (summary "The empty sequence.")
  (returns "A Seq with no elements.")
  (see seq-empty? seq-unfold))

(:doc seq-empty?
  (summary "Whether a sequence has no elements.")
  (arg s "The sequence.")
  (returns "#t when it yields nothing.")
  (see first empty?)
  (reference """
    Starts a walk of @code{s} and pulls at most one element, so over a
    source with effects it runs them as far as that element.
    """))

(:doc seq-head
  (summary "Deprecated: use first. The first element of a sequence.")
  (arg s "The sequence. Not empty.")
  (returns "The first element it yields.")
  (raises System.InvalidOperationException "When s is empty.")
  (see first)
  (reference """
    @code{first} takes any iterable, and answers @code{(Some x)}, or
    @code{None} for an empty one. A use of @code{seq-head} warns, and it goes
    in a later release. There is no @code{seq-tail}, since a @code{Seq} has
    no rest to step to; @code{(drop 1 s)} is the sequence without its first
    element.
    """))

(:doc seq-map
  (summary "Deprecated: use map. A sequence of a function applied to each element, lazily.")
  (arg f "The function.")
  (arg s "The sequence.")
  (returns "A Seq of the transformed elements, evaluated as pulled.")
  (see map)
  (reference """
    @code{map} takes any iterable and does the same to a sequence. A use of
    @code{seq-map} warns, and it goes in a later release.
    """))

(:doc seq-filter
  (summary "Deprecated: use filter. A sequence of the elements that satisfy a predicate, lazily.")
  (arg f "The predicate.")
  (arg s "The sequence.")
  (returns "A Seq of the elements where (f x) is true.")
  (see filter)
  (reference """
    @code{filter} takes any iterable and does the same to a sequence. A use
    of @code{seq-filter} warns, and it goes in a later release.
    """))

(:doc seq-take
  (summary "Deprecated: use take. A sequence of the first n elements, lazily.")
  (arg s "The sequence.")
  (arg n "How many. Zero or less gives the empty sequence.")
  (returns "A Seq of s's first n elements, or all of them if it has fewer.")
  (see take)
  (reference """
    @code{(take n s)} takes any iterable and does the same to a sequence.
    Its arguments are in the other order. A use of @code{seq-take} warns,
    and it goes in a later release.
    """))

(:doc seq-drop
  (summary "Deprecated: use drop. A sequence without its first n elements, lazily.")
  (arg s "The sequence.")
  (arg n "How many to skip. Zero or less skips none.")
  (returns "A Seq of what follows; empty when s has no more than n.")
  (see drop)
  (reference """
    @code{(drop n s)} takes any iterable and does the same to a sequence.
    Its arguments are in the other order. A use of @code{seq-drop} warns,
    and it goes in a later release.
    """))

(:doc seq-unfold
  (summary "A sequence generated from a state, lazily.")
  (arg f "Maps a state to (Some (Tuple x next-state)), the next element and the state after it, or to None to end.")
  (arg state "The first state.")
  (returns "A Seq of the elements f produces, until it returns None.")
  (see seq-range seq-empty)
  (example """
    (take 5 (seq-unfold (fun (n) (Some (Tuple n (* 2 n)))) 1))
    ; 1 2 4 8 16
    """))

(:doc seq-range
  (summary "The ints from start up to but not including stop, as a sequence.")
  (arg start "The first, included.")
  (arg stop "The bound, not included. At or below start, the sequence is empty.")
  (returns "A lazy Seq of ints.")
  (see range seq-unfold))

(:doc seq-append
  (summary "One sequence followed by another, lazily.")
  (arg s1 "The first.")
  (arg s2 "The second, walked once s1 is exhausted.")
  (returns "A Seq of s1's elements, then s2's.")
  (see flat-map))

(:doc seq-length
  (summary "Deprecated: use count. How many elements a sequence yields.")
  (arg s "The sequence.")
  (returns "The count.")
  (see count)
  (reference """
    @code{count} takes any iterable, and fuses with a chain under it. A use
    of @code{seq-length} warns, and it goes in a later release.
    """))

(:doc seq->list
  (summary "Deprecated: use ->list. A sequence's elements as a list.")
  (arg s "The sequence, walked to the end.")
  (returns "A list of its elements, in order.")
  (see ->list)
  (reference """
    @code{->list} takes any iterable, and fuses with a chain under it. A use
    of @code{seq->list} warns, and it goes in a later release.
    """))

(:doc seq->vec
  (summary "Deprecated: use ->vec. A sequence's elements as a vec.")
  (arg s "The sequence, walked to the end.")
  (returns "A vec of its elements, in order.")
  (see ->vec)
  (reference """
    @code{->vec} takes any iterable, and fuses with a chain under it. A use
    of @code{seq->vec} warns, and it goes in a later release.
    """))

;; ---------------------------------------------------------------------------
;; Seq enumerators
;; ---------------------------------------------------------------------------

(:doc seq-enumerator
  (summary "Starts one walk of a sequence, with .NET's enumerator protocol.")
  (arg s "The sequence.")
  (returns "A fresh enumerator of s, before its first element.")
  (see seq-enumerator-next! seq-enumerator-current seq-enumerator-end!)
  (example """
    (def e (seq-enumerator s))
    (let go ()
      (when (seq-enumerator-next! e)
        (println (seq-enumerator-current e))
        (go)))
    """)
  (reference """
    What @code{Iterable}'s implementation for @code{Seq} walks with. It holds
    the sequence's .NET enumerator, so each element is made once, and it has
    .NET's protocol: @code{seq-enumerator-next!} is @code{MoveNext} and
    @code{seq-enumerator-current} is @code{Current}.

    It is not a cursor. A cursor, such as @code{vec-cursor}, is a position
    that does not change: @code{vec-cursor-done?} asks and moves nothing, and
    @code{vec-cursor-next} answers a new cursor. Stepping an enumerator moves
    it, for everyone who holds it. A @code{for-each}, a @code{loop} or a
    @code{:for} does the stepping, so most programs never hold one.
    """))

(:doc seq-enumerator-next!
  (summary "Steps an enumerator to the next element, and answers whether there is one.")
  (arg e "The enumerator.")
  (returns "#t when e is on an element; #f when the sequence is exhausted.")
  (see seq-enumerator seq-enumerator-current)
  (reference """
    .NET's @code{MoveNext}: call it once before each
    @code{seq-enumerator-current}, the first time too. When it returns
    @code{#f}, the enumerator is disposed, which closes a file or stream that
    the sequence opened for this walk. Calling it again goes on returning
    @code{#f}.
    """))

(:doc seq-enumerator-current
  (summary "The element an enumerator is on.")
  (arg e "The enumerator, after seq-enumerator-next! returned #t.")
  (returns "The element.")
  (see seq-enumerator-next!))

(:doc seq-enumerator-end!
  (summary "Ends a walk before the sequence is exhausted.")
  (arg e "The enumerator.")
  (see seq-enumerator seq-enumerator-next!)
  (reference """
    Disposes the underlying enumerator, which closes a file or stream that the
    sequence opened for this walk. A loop calls it, through
    @code{iterable-end}, when it stops before the end. After the first call,
    and after @code{seq-enumerator-next!} returned @code{#f}, it does nothing.
    """))
