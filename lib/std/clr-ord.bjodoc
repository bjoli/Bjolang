;; Docs for std/clr-ord.bjo, read through (:doc #:file "clr-ord.bjodoc"). The
;; texts are samizdat markup: code in prose is @code{...}.

(:doc #:module
  (summary "Provides Ord instances for common .NET types: DateTime, TimeSpan, DateOnly, TimeOnly, Guid, and Version.")
  (see Guid Version)
  (example """
    (import (std prelude))
    (import (std clr-ord))

    ;; An alias with a constructor. The Ord instance applies because it
    ;; refers to the underlying .NET type.
    (import/class
      (Date (: System.DateTime (-> int int int Date))))

    (list-sort (list (Date. 2021 1 1) (Date. 2019 6 5)))   ; 2019 first
    (less? (Date. 2019 1 1) (Date. 2020 1 1))              ; #t
    """)
  (reference """
    Import this module to sort and compare these .NET types using
    @code{compare}, @code{less?}, @code{list-sort}, and ordered collections.
    Each @code{Ord} implementation delegates to the type's @code{CompareTo}
    method. Equality is handled by default @code{Eq}, which delegates to
    @code{Equals}.

    Supported types include @code{System.DateTime},
    @code{System.DateTimeOffset}, @code{System.TimeSpan},
    @code{System.DateOnly}, @code{System.TimeOnly}, @code{System.Guid}, and
    @code{System.Version}.

    @strong{Exported aliases.} Only @code{Guid} and @code{Version} are exported
    as named aliases to avoid collisions with @code{(std datetime)}. To use the
    other .NET time types, reference their full names (such as
    @code{System.DateTime}) or declare a local alias via @code{import/class}.
    The @code{Ord} implementations apply to the underlying .NET type regardless
    of alias. The exported aliases do not provide constructors; define a local
    alias with a constructor if you need to instantiate values directly.

    Ordering follows .NET semantics: @code{DateTime} compares ticks and ignores
    @code{Kind}, while @code{DateTimeOffset} compares timestamps in UTC.
    """))

(:doc Guid
  (summary "Type alias for System.Guid, implementing Ord via CompareTo.")
  (see Version))

(:doc Version
  (summary "Type alias for System.Version, ordered by major, minor, build, and revision components.")
  (see Guid)
  (example """
    (import/class
      (Ver (: System.Version (-> int int int Ver))))

    (less? (Ver. 1 9 0) (Ver. 1 10 0))   ; #t: compared numerically, not lexically
    """))
