;; A unit variable of a signature is rigid in the body: %u is not m.

;; EXPECT-ERROR: Their units differ: m and %u.

(import (std prelude))

(def/dimension length #:base m)
(def/dimension time #:base s)

(: same (-> (double m) (double m)))
(defun (same x) x)

(: bad (-> (double %u) (double %u)))
(defun (bad x) (same x))

(defun (main) 0)
