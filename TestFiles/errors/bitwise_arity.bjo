;; `(bitwise-and)` has no identity to be.
;;
;; `(+)` is 0 and `(*)` is 1, both `int`. The identity of `bitwise-and` is all
;; ones, whose value depends on the width of a type the empty form does not
;; mention — so there is nothing honest to return, and the form is refused.

;; EXPECT-ERROR: 'bitwise-and' takes at least one argument

(import (std prelude))

(defun (main args)
  (println (int->string (bitwise-and)))
  0)
