;; A generic method's span result is matched by a declared array, and is
;; refused without #:copy.
;; EXPECT-ERROR: answers a (System.Span %a), and a span is not a Bjolang value
;; EXPECT-ERROR: Write #:copy
(import (std prelude))

(import/extern
  (drop-span (: System.MemoryExtensions.AsSpan (-> (Array %a) int (Array %a)))))

(defun (main)
  (println (written (array->vec (drop-span (vec->array [1L 2L]) 1))))
  0)
