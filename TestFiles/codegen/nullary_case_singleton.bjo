;; A nullary union case is one shared instance per closed type, not an
;; allocation per use. `Red`, `Green` and `Mix` are such cases: `Color` has two
;; cases that carry nothing, so neither is `null` (see null_case.bjo).
;;
;; EXPECT-CS: public static readonly \S*Red Instance = new\(\);
;; EXPECT-CS: \S*Red\(\) => \S*Red\.Instance;
;; EXPECT-CS: \S*Red\.Instance
;; EXPECT-NO-CS: new \S*Red\(\)

(import (std prelude))

(export Color pick)

(type (: Color (Union Red Green (: Mix int))))

(: pick (-> int Color))
(defun (pick n)
  (match n
    (0 Red)
    (1 Green)
    (_ (Mix n))))
