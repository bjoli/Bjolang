;; The integer operations of (std atomic) are the methods of AtomicInteger, so
;; on an atomic of a type without an implementation they do not compile.
;; EXPECT-ERROR: no implementation of trait 'AtomicInteger' for 'String', required by 'atomic-add!'
(import (std prelude))
(import (std atomic))

(defun (main args)
  (def s (make-atomic "hello"))
  (println (atomic-add! s "x"))
  0)
