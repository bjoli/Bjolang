
(import (std prelude))

(: match-list (-> (List string) string))
(defun (match-list l)
  (match l
    ((Cons hd tl) hd)
    (Nil "empty")))

(defun (main args)
  (def alst (Cons "hej" Nil))
  (displayln (match-list alst))

  ;; Using named let
  (let loop ((x 10))
    (if (= x 0)
        (displayln "done!")
        (let ()
          (displayln "looping...")
          (loop (- x 1)))))

  0)
