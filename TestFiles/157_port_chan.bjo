;; Streaming a port with port->stream: a driver whose reads suspend in a
;; bjoroutine, which a Seq's cannot.
;;
;; - Each item is read when the loop asks for it, so a loop left early leaves
;;   the rest in the port.
;; - What the reader raises is raised in the loop, not taken for the end.

(import (std prelude))
(import (std ports))
(import (std stream))
(import (std simpletest))

(import/class
  (Refusal (: System.InvalidOperationException (-> string Refusal))))

(: (-> InputPort (List string)))
(defbjo (collect p) {listing line (:for line (port->stream read-line p))})

;; The lines up to the blank one, then the rest of the port.
(: (-> InputPort (Tuple (List string) string)))
(defbjo (headers-then-body p)
  (def headers
    (loop (:for line (port->stream read-line p))
          (:until (string-empty? line))
          (:acc hs (listing line))
      => hs))
  (Tuple headers (read-all p)))

(: (-> InputPort string))
(defbjo (failing-reader q)
  (def line (read-line q))
  (if (= line "b") (raise (cast Exception (Refusal. "cannot read b"))) line))

(: (-> InputPort string))
(defbjo (reader-raises p)
  (match (try (collect-with failing-reader p) #:catch (System.InvalidOperationException))
    ((Ok _) "returned")
    ((Err _) "raised")))

(: (-> (-bjo-> InputPort string) InputPort (List string)))
(defbjo (collect-with reader p) {listing x (:for x (port->stream reader p))})

(: (-> (Promise %a) %a))
(defun (await-value pr)
  (match (sync/blocking (promise-join pr))
    ((Ok x) x)
    ((Err e) (raise e))))

(defun (main)
  (expect "every line arrives, in order"
          (await-value (bjo (collect (open-input-string "a\nb\nc"))))
          (list "a" "b" "c"))
  (expect "an empty port ends at once"
          (await-value (bjo (collect (open-input-string ""))))
          (: (list) (List string)))
  (expect
   "a loop left early leaves the rest in the port"
   (await-value (bjo (headers-then-body (open-input-string "Host: x\nAccept: y\n\nbody line\nmore"))))
   (Tuple (list "Host: x" "Accept: y") "body line\nmore"))
  (expect "a different reader"
          (await-value (bjo (collect-with read-all (open-input-string "all\nof\nit"))))
          (list "all\nof\nit"))
  (expect "what the reader raises is raised in the loop"
          (await-value (bjo (reader-raises (open-input-string "a\nb\nc"))))
          "raised")
  (expect "outside a bjoroutine the reads park the thread"
          {listing line (:for line (port->stream read-line (open-input-string "x\ny")))}
          (list "x" "y"))
  0)
