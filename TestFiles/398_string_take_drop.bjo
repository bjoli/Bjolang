;; Taking and dropping characters from either end of a string, each with a
;; /slice form; moving a cursor by a count; and splitting at the first
;; separator. Counts are of characters, not bytes, and a count past the end
;; takes or drops the whole string.

(import (std prelude))

(: check (-> string string string bool))
(defun (check what got want)
  (if (= got want)
      #t
      (let ()
        (println (str what ": got " got ", wanted " want))
        #f)))

(: refused? (-> (-> string) bool))
(defun (refused? f)
  (match (try (f) #:catch (System.Exception))
    ((Ok _) #f)
    ((Err _) #t)))

(: split (-> (Option (Tuple string string)) string))
(defun (split o)
  (match o
    ((Some (Tuple a b)) (str "[" a "|" b "]"))
    (None "none")))

(defun (main args)
  (def s "héllo")
  (if (and (check "take" (string-take "hello" 2) "he")
           (check "take, not bytes" (string-take s 2) "hé")
           (check "take past the end" (string-take "hi" 10) "hi")
           (check "take none" (string-take "hi" 0) "")
           (check "drop" (string-drop "L68" 1) "68")
           (check "drop, not bytes" (string-drop s 2) "llo")
           (check "drop past the end" (string-drop "hi" 5) "")
           (check "take-right" (string-take-right "file.txt" 3) "txt")
           (check "take-right, not bytes" (string-take-right s 4) "éllo")
           (check "drop-right" (string-drop-right "file.txt" 4) "file")
           (check "drop-right past the start" (string-drop-right "ab" 9) "")
           (check "both ends" (string-drop (string-drop-right "(1,3)" 1) 1) "1,3")
           (check "take/slice" (string-take/slice s 2) "hé")
           (check "drop/slice" (string-drop/slice s 2) "llo")
           (check "take-right/slice" (string-take-right/slice s 3) "llo")
           (check "drop-right/slice" (string-drop-right/slice s 3) "hé")
           (check "a slice copied" (string-copy (string-drop/slice s 1)) "éllo")
           (check "forward" (substring s (string-cursor-forward s (string-cursor-start s) 2) (string-cursor-end s)) "llo")
           (check "back" (substring s (string-cursor-back s (string-cursor-end s) 4) (string-cursor-end s)) "éllo")
           (check "forward past the end"
                  (if (refused? (fun () (substring s (string-cursor-forward s (string-cursor-start s) 9) (string-cursor-end s))))
                      "refused" "not refused")
                  "refused")
           (check "split-once" (split (string-split-once "key: value" ": ")) "[key|value]")
           (check "split-once, the first" (split (string-split-once "10-20-30" "-")) "[10|20-30]")
           (check "split-once, none" (split (string-split-once "none" "-")) "none")
           (check "split-once, not bytes" (split (string-split-once "é=ü" "=")) "[é|ü]")
           (check "split-once, empty sep" (split (string-split-once "ab" "")) "[|ab]")
           (check "split-once/slice" (split (string-split-once/slice "a,b,c" ",")) "[a|b,c]"))
      0
      1))
