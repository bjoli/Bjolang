;; A spliced value whose type fits two alternatives of an :or.
;;
;; A written string is a Name, and only a splice can be a Raw. But a spliced
;; string fits both alternatives. The grammar does not select one by the
;; order of declaration, so the compiler refuses the grammar.
;; EXPECT-ERROR: can both take a spliced string, so a value spliced in with , can not say which it is.
(import (std prelude))

(def/grammar Item
  (:or (: Name string)
       (: Raw ,string)))

(defun (main args)
  (def text "x")
  (def (: items (List Item)) '(,text))
  0)
