;; Comparison patterns: (:at-least lo), (:at-most hi), (:between lo hi),
;; (:greater-than lo) and (:less-than hi).
;;
;; :between is :at-least and :at-most together, so both of its ends are
;; inclusive, as the version constraints of a manifest are. A bound is a
;; number or a char literal. A comparison is a pattern like any other, so it
;; stands inside a constructor, a record field, a list, an or and an and, and
;; a published body takes it to the module that inlines the body.
;;
;; The ranges of an integer or a char are added up, so ranges that cover the
;; type need no _. Those of a double are not, because a double can be NaN, so
;; a match on one ends in _.

(import (std prelude))
(import (std simpletest))
(import "inc/comparison_lib.bjo")

(type (: Car (Record (: brand string) (: year int))))

(: classify (-> int string))
(defun (classify n)
  (match n
    ((:less-than 0) "negative")
    ((:between 0 9) "digit")
    ((or (:greater-than 255) (:at-least 200)) "big")
    (_ "other")))

(: letter (-> Char string))
(defun (letter c)
  (match c
    ((:between #\a #\z) "lower")
    ((:between #\A #\Z) "upper")
    (_ "other")))

(: car-age (-> Car string))
(defun (car-age c)
  (match c
    ((Car (year (:at-least 2000)) brand) #"new ${brand}")
    (_ "old")))

(: small (-> (Option long) string))
(defun (small o)
  (match o
    ((Some (and n (:at-most 10))) #"small ${n}")
    ((Some _) "large")
    (None "none")))

;; Every byte, with no _.
(: half (-> byte string))
(defun (half b)
  (match b
    ((:at-most 127) "low")
    ((:at-least 128) "high")))

;; Every char, with no _, and in argument position.
(: kind (-> Char string))
(defun (kind c)
  (string-append "is "
                 (match c
                   ((:at-most #\x7F) "ascii")
                   ((:at-least #\x80) "other"))))

;; A double, compared with a guard.
(: unit-interval (-> double string))
(defun (unit-interval x)
  (match x
    ((:less-than 0.0) "below")
    ((:between 0.0 1.0) "inside")
    (_ "above")))

(: head-sign (-> (Vec double) string))
(defun (head-sign v)
  (match v
    ([(:less-than 0.0) _ ...] "starts negative")
    ([(:greater-than 0.5) _ ...] "starts big")
    (_ "other")))

(defun (main args)
  (expect "below" (classify -3) "negative")
  (expect "the low end of between is included" (classify 0) "digit")
  (expect "the high end of between is included" (classify 9) "digit")
  (expect "an or of comparisons" (classify 300) "big")
  (expect "at-least includes its bound" (classify 200) "big")
  (expect "none of them" (classify 50) "other")

  (expect "a char range" (letter #\q) "lower")
  (expect "another char range" (letter #\Q) "upper")
  (expect "outside the char ranges" (letter #\3) "other")

  (expect "in a record field" (car-age (Car (brand "volvo") (year 2000))) "new volvo")
  (expect "in a record field, no match" (car-age (Car (brand "saab") (year 1999))) "old")

  (expect "under Some, with a binder" (small (Some 10L)) "small 10")
  (expect "under Some, no match" (small (Some 11L)) "large")

  (expect "in a vec pattern" (head-sign [-1.0 2.0]) "starts negative")
  (expect "greater-than is strict" (head-sign [0.5]) "other")
  (expect "greater-than" (head-sign [0.7]) "starts big")

  (expect "every byte, low" (half 127uy) "low")
  (expect "every byte, high" (half 128uy) "high")
  (expect "every char" (kind #\a) "is ascii")
  (expect "every char, past ascii" (kind #\é) "is other")
  (expect "a double below" (unit-interval -0.5) "below")
  (expect "a double at the top end of between" (unit-interval 1.0) "inside")
  (expect "a double above" (unit-interval 1.5) "above")
  (expect "NaN matches no comparison" (unit-interval (/ 0.0 0.0)) "above")

  (expect "a published body" (grade (fun (s) s) 59) "fail")
  (expect "a published body, at-least" (grade (fun (s) s) 60) "pass")
  (expect "a published body, less-than" (grade (fun (s) s) -1) "invalid")
  0)
