;; EXPECT-ERROR: this string continues a line with a backslash, which a published doc cannot
;; What a continued line stands for depends on the column its string starts
;; at, and a published doc is bjodat, which has no columns to go by.
(import (std prelude))

(:doc twice
  (summary "Doubles \
            a number.")
  (arg n "The number.")
  (returns "Twice n."))
(: (-> int int))
(defun (twice n) (* 2 n))

(defun (main args) 0)
