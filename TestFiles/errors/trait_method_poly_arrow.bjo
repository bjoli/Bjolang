;; A -?-> parameter on a trait method.
;;
;; The method's *own* arrow may now be -bjo->, and this is the line where that
;; stops. The difference is between having a colour and having a choice of one.
;; `-bjo->` is a single claim that every implementation keeps, and an emitted
;; interface can say it, because a method slot has a return type and that return
;; type can be a fiber. `-?->` asks instead for two copies of every
;; implementation and two slots to dispatch between — and the pass that makes
;; copies only ever sees a top-level definition, so an impl would quietly get
;; one and the arrow would be decoration.

;; EXPECT-ERROR: declares 'apply-it' with a -?-> parameter, and a trait method's parameter cannot take either colour
;; EXPECT-ERROR: It is the *parameter* that has no second copy to choose between

(import (std prelude))

(def/trait (Mapper %a)
  (: apply-it (-> %a (-?-> int int) int)))

(def/impl (Mapper int)
  (defun (apply-it x f) (f x)))

(defun (main args) 0)
