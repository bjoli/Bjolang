;; A clause with a pattern and nothing to do with it. Read as an arm it would
;; answer nothing, and read as a pattern-only clause it would answer the form
;; itself — neither is written down anywhere, so it is rejected.
;;
;; EXPECT-ERROR: The macro 'syntax-match' failed
;; EXPECT-ERROR: A syntax-match clause is (pattern body ...), and this one has no body.

(import (std syntax-match))

(: empty-clause (-> Syntax int))
(defun (empty-clause s)
  (syntax-match s
    ((_ a))
    (_ 0)))

(defun (main args)
  (println (int->string (empty-clause #'(f a))))
  0)
