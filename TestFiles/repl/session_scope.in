(def w (open-output-string))
(write-string w "still open on the next line")
(get-output-string w)
(scope-owned-count (current-scope))
(def h (own! (fun () unit)))
(scope-owned-count (current-scope))
(release! h)
(scope-owned-count (current-scope))
(def p (match (open-input-file "TestFiles/repl/session_scope.in") ((Ok r) r) ((Err e) (panic! "could not open"))))
(read-line p)
(scope-owned-count (current-scope))
(close-input-port p)
(scope-owned-count (current-scope))
