; A solved metavariable is its solution.
?a = s
?a ?a = m^2
; Unit variables are rigid.
%u = %u
%u = %v
%u kg = %u kg
?z = %u kg
?z = m
?p^(1/2) = %u
show ?p
; Metavariables that cancel.
?w / ?w = 1
