;; An arm produces the value of the whole form, so it has to agree with the rest
;; of the body — and the rest of this one produces nothing.
;;
;; This is the mistake the form invites: an arm reads like an exit, so returning
;; a value from one looks like returning from the function. It is the form's
;; other arm instead, and an arm of a void body may not produce a string.

;; EXPECT-ERROR: produces the value of the whole form

(import (std prelude))

(: f (-> (Option int) void))
(defun (f o)
  (def+ ((Some n) o)
        (None "a string, where the rest of the body gives nothing"))
  (println (int->string n)))
