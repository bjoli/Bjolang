;; in that would divide a whole-number carrier.

;; EXPECT-ERROR: (number-in x EUR) multiplies x by 1/100, and x is a (long cent), which holds whole numbers only

(import (std prelude))

(def/dimension money #:base cent #:carrier long)
(def/unit EUR <100 cent>)

(: euros (-> <cent> long))
(defun (euros x) (number-in x EUR))

(defun (main) 0)
