;; The file operations past reading and writing text: what a path is, how big
;; and how old, moving over a file, copying, bytes and lines whole, and
;; walking a tree.
;;
;; Everything is built over the `FS` effect, so each check runs on a fake and,
;; where the disk can answer the same question, on the disk in a probe
;; directory this file makes and deletes.

(import (std prelude))
(import (std effect))
(import (std simpletest))
(import (std datetime))

(import/class
  (FileSystemInfo (: System.IO.FileSystemInfo)))

(import/extern
  (clr-symlink (: System.IO.File.CreateSymbolicLink (-> string string FileSystemInfo)
                  #:exceptions (System.IO.IOException System.UnauthorizedAccessException))))

;; What a path is, as one string a check can compare: "file 3", "dir 0" or
;; "none".
(: described (-> string string))
(defun (described path)
  (match (file-info path)
    ((Some info) (str (match (record-ref info kind) (FsFile "file") (FsDirectory "dir"))
                      " "
                      (->str (record-ref info size))))
    (None "none")))

;; The modified time, or -1 for a path that names nothing.
(: modified (-> string long))
(defun (modified path)
  (match (file-info path)
    ((Some info) (record-ref info modified-ms))
    (None -1L)))

(: link? (-> string bool))
(defun (link? path)
  (match (file-info path)
    ((Some info) (record-ref info link?))
    (None #f)))

;; 2000-01-01T00:00:00Z, the fake clock's start, in Unix milliseconds.
(: epoch long)
(def epoch 946684800000L)

(: probe string)
(def probe "249_probe_dir")

(: in-probe (-> string string))
(defun (in-probe name) (path-combine probe name))

(: threw? (-> (Result System.Exception %a) bool))
(defun (threw? r)
  (match r ((Ok _) #f) ((Err _) #t)))

(: under (-> string string string))
(defun (under dir name) (path-combine dir name))

;; Every byte value, 0 to 255, most of which is not UTF-8 on its own.
(: all-bytes (Array byte))
(def all-bytes
  (let ((out (make-array 256)))
    (let loop ((i 0))
      (when (< i 256)
        (array-set! out i (cast byte i))
        (loop (+ i 1))))
    out))

(: same-bytes? (-> (Array byte) (Array byte) bool))
(defun (same-bytes? a b)
  (and (= (array-length a) (array-length b))
       (let loop ((i 0))
         (or (= i (array-length a))
             (and (= (array-ref a i) (array-ref b i)) (loop (+ i 1)))))))

(: vec-of (-> (List string) (Vec string)))
(defun (vec-of xs) (list->vec xs))

;; ---------------------------------------------------------------------------
;; file-info
;; ---------------------------------------------------------------------------

(: info-on-a-fake (-> void))
(defun (info-on-a-fake)
  (def fs (fake-fs (list (Tuple "a.txt" "abc") (Tuple "å.txt" "å") (Tuple "d/x.txt" "x"))))
  (with-fake-fs-of fs
    (expect "a seeded file" (described "a.txt") "file 3")
    (expect "its size is in bytes, not characters" (described "å.txt") "file 2")
    (expect "a directory implied by a seed" (described "d") "dir 0")
    (expect "a missing path" (described "nowhere.txt") "none")
    (expect "a seed has the clock's start" (modified "a.txt") epoch)
    (expect-true "and is not a link" (not (link? "a.txt")))

    ;; Each write moves the clock one second on, so later is newer.
    (file-write-text "b.txt" "bb")
    (file-write-text "c.txt" "c")
    (expect "a write is a second after the start" (modified "b.txt") (+ epoch 1000L))
    (expect "the next a second after that" (modified "c.txt") (+ epoch 2000L))
    (expect "a written file's size" (described "b.txt") "file 2")
    (directory-create "e")
    (expect "a directory made is stamped too" (modified "e") (+ epoch 3000L))

    ;; A time set by hand is what `file-info` answers, and a move keeps it.
    (fake-fs-set-modified! fs "a.txt" 5L)
    (expect "a time set by hand" (modified "a.txt") 5L)
    (file-move "a.txt" "moved.txt")
    (expect "a move keeps the time" (modified "moved.txt") 5L)
    (expect "and the old path names nothing" (described "a.txt") "none")

    ;; A file deleted and written again is new.
    (file-delete "c.txt")
    (file-write-text "c.txt" "again")
    (expect "a file written again after a delete" (modified "c.txt") (+ epoch 4000L))

    ;; The functions that only ask what a path is ask the same operation.
    (expect-true "file-exists?" (file-exists? "b.txt"))
    (expect-true "directory-exists?" (directory-exists? "d"))
    (expect-true "not a file" (not (file-exists? "d")))))

(: info-on-the-disk (-> void))
(defun (info-on-the-disk)
  (directory-create probe)
  (file-write-text (in-probe "abc.txt") "abc")
  (file-write-text (in-probe "å.txt") "å")
  (expect "a real file" (described (in-probe "abc.txt")) "file 3")
  (expect "its size is in bytes" (described (in-probe "å.txt")) "file 2")
  (expect "a real directory" (described probe) "dir 0")
  (expect "a missing path" (described (in-probe "nowhere.txt")) "none")
  (expect "an empty path names nothing, and throws nothing" (described "") "none")
  (def now-ms (instant->unix-milliseconds (now)))
  (def age (- now-ms (modified (in-probe "abc.txt"))))
  (expect-true "the time is the write's, give or take a minute"
               (and (> age -60000L) (< age 60000L)))
  (expect-true "a plain file is not a link" (not (link? (in-probe "abc.txt"))))
  ;; Some systems refuse an unprivileged symbolic link. There is nothing to
  ;; check then.
  (match (clr-symlink (in-probe "link.txt") "abc.txt")
    ((Ok _)
     (expect-true "a symbolic link says so" (link? (in-probe "link.txt")))
     (expect "and is what it points at" (described (in-probe "link.txt")) "file 3"))
    ((Err _) (println "ok: symbolic links are refused here, so not checked"))))

;; ---------------------------------------------------------------------------
;; file-move
;; ---------------------------------------------------------------------------

;; The same checks on the fake and on the disk: `where` says which.
(: check-moves (-> string void))
(defun (check-moves where)
  (def a (in-probe "a.txt"))
  (def b (in-probe "b.txt"))
  (def c (in-probe "c.txt"))
  (def d (in-probe "d"))
  (directory-create d)
  (file-write-text a "A")
  (file-write-text b "B")
  (expect-true #"${where}: MoveNew onto a file fails"
               (threw? (try (file-move a b) #:catch (System.Exception))))
  (expect #"${where}: and changes nothing" (str (file-read-text a) (file-read-text b)) "AB")
  (file-move a b #:mode MoveReplace)
  (expect #"${where}: MoveReplace replaces a file" (file-read-text b) "A")
  (expect-true #"${where}: and the source is gone" (not (file-exists? a)))
  (expect-true #"${where}: MoveReplace onto a directory fails"
               (threw? (try (file-move b d #:mode MoveReplace) #:catch (System.Exception))))
  (expect-true #"${where}: and the file is still there" (file-exists? b))
  (expect-true #"${where}: a directory never replaces a file"
               (threw? (try (file-move d b #:mode MoveReplace) #:catch (System.Exception))))
  (expect-true #"${where}: and both are still there" (and (directory-exists? d) (file-exists? b)))
  (expect-true #"${where}: a missing source fails, even replacing"
               (threw? (try (file-move a b #:mode MoveReplace) #:catch (System.Exception))))
  (expect #"${where}: and the target is intact" (file-read-text b) "A")
  (file-move b c #:mode MoveReplace)
  (expect #"${where}: MoveReplace onto a free path moves" (file-read-text c) "A"))

;; ---------------------------------------------------------------------------
;; file-copy, bytes and lines
;; ---------------------------------------------------------------------------
;;
;; Each takes the directory to work in, so that a second run does not find
;; the first one's files.

(: check-copies (-> string string void))
(defun (check-copies where dir)
  (directory-create dir)
  (def src (under dir "src.txt"))
  (def dst (under dir "dst.txt"))
  (file-write-text src "source")
  (file-write-text dst "old")
  (expect-true #"${where}: a copy refuses an existing target by default"
               (threw? (try (file-copy src dst) #:catch (System.Exception))))
  (expect #"${where}: and leaves it as it was" (file-read-text dst) "old")
  (file-copy src dst #:mode Truncate)
  (expect #"${where}: Truncate replaces it" (file-read-text dst) "source")
  (file-copy src dst #:mode Append)
  (expect #"${where}: Append adds to it" (file-read-text dst) "sourcesource")
  (file-copy src (under dir "fresh.txt"))
  (expect #"${where}: the default copies to a free path" (file-read-text (under dir "fresh.txt")) "source")
  (expect-true #"${where}: a missing source fails"
               (threw? (try (file-copy (under dir "missing.txt") dst #:mode Truncate) #:catch (System.Exception))))
  (expect #"${where}: and leaves the target as it was" (file-read-text dst) "sourcesource")
  (expect-true #"${where}: a copy onto itself fails"
               (threw? (try (file-copy src src #:mode Truncate) #:catch (System.Exception))))
  (expect #"${where}: and the file is intact" (file-read-text src) "source")
  (directory-create (under dir "sub"))
  (expect-true #"${where}: a directory as the source fails"
               (threw? (try (file-copy (under dir "sub") (under dir "sub-copy")) #:catch (System.Exception))))
  (file-write-bytes (under dir "all.bin") all-bytes)
  (file-copy (under dir "all.bin") (under dir "all-copy.bin"))
  (expect-true #"${where}: bytes that are not text survive a copy"
               (same-bytes? (file-read-bytes (under dir "all-copy.bin")) all-bytes)))

(: check-bytes (-> string string void))
(defun (check-bytes where dir)
  (directory-create dir)
  (def f (under dir "bytes.bin"))
  (file-write-bytes f all-bytes)
  (expect-true #"${where}: every byte value round trips" (same-bytes? (file-read-bytes f) all-bytes))
  (expect #"${where}: and the size is 256" (described f) "file 256")
  (def three (make-array 3))
  (array-set! three 0 (cast byte 7))
  (array-set! three 1 (cast byte 8))
  (array-set! three 2 (cast byte 9))
  (file-append-bytes f three)
  (def back (file-read-bytes f))
  (expect #"${where}: append adds to the end" (array-length back) 259)
  (expect-true #"${where}: in order"
               (and (= (array-ref back 256) (cast byte 7)) (= (array-ref back 258) (cast byte 9))))
  (file-write-bytes f three)
  (expect #"${where}: a write replaces" (array-length (file-read-bytes f)) 3))

(: check-lines (-> string string void))
(defun (check-lines where dir)
  (directory-create dir)
  (def f (under dir "lines.txt"))
  (def lines (vec-of (list "one" "" "three")))
  (file-write-lines f lines)
  (expect #"${where}: lines round trip" (vec->list (file-read-lines f)) (vec->list lines))
  (expect #"${where}: each ends in a newline, the last too" (file-read-text f) "one\n\nthree\n")
  (file-write-text f "x\ny")
  (expect #"${where}: a last line without a newline" (vec->list (file-read-lines f)) (list "x" "y"))
  (file-write-text f "x\r\ny\r\n")
  (expect #"${where}: CRLF ends a line too" (vec->list (file-read-lines f)) (list "x" "y"))
  (file-write-text f "")
  (expect #"${where}: an empty file has no lines" (vec-length (file-read-lines f)) 0)
  (file-write-lines f (vec-of '()))
  (expect #"${where}: no lines make an empty file" (file-read-text f) ""))

;; Once through the ordinary copies of the functions. `main` is a bjoroutine,
;; so what it calls directly runs their suspending copies; `#:sync` keeps this
;; one, and everything it calls, on the ordinary ones.
(: ordinary-copies #:sync (-> void))
(defun (ordinary-copies)
  (info-on-a-fake)
  (info-on-the-disk)
  (with-fake-fs () (check-moves "fake"))
  (check-moves "disk")
  (with-fake-fs ()
    (check-copies "fake" "copies")
    (check-bytes "fake" "bytes")
    (check-lines "fake" "lines"))
  (check-copies "disk" (in-probe "copies"))
  (check-bytes "disk" (in-probe "bytes"))
  (check-lines "disk" (in-probe "lines")))

(defbjo (main)
  (when (directory-exists? probe) (directory-delete-tree probe))
  ;; Off the fiber, since the ordinary copies park the thread they run on. A
  ;; failure comes back as an `Err`, and is raised here.
  (match (sync (blocking (fun () (ordinary-copies))))
    ((Ok _) (ignore 0))
    ((Err e) (raise e)))
  ;; And once through the suspending copies.
  (with-fake-fs ()
    (check-copies "fake, suspending" "copies")
    (check-bytes "fake, suspending" "bytes")
    (check-lines "fake, suspending" "lines"))
  (check-copies "disk, suspending" (in-probe "copies-bjo"))
  (check-bytes "disk, suspending" (in-probe "bytes-bjo"))
  (check-lines "disk, suspending" (in-probe "lines-bjo"))
  (directory-delete-tree probe)
  0)
