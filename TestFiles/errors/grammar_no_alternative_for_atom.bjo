;; A literal atom where no alternative of the grammar takes an atom.
;;
;; Money has only keyword lists, so a string has no place in it. The message
;; tells the alternatives and what the literal holds.
;; EXPECT-ERROR: expected (kr ...) or (ore ...); found the string "hello"
(import (std prelude))

(def/grammar Money
  (:or (: Kr (kr int))
       (: Ore (ore int))))

(: (-> (List Money) int))
(defun (total ms) 0)

(defun (main args)
  (println (int->string (total '("hello"))))
  0)
