;; Andra halvan. Samma filnamn som `../a/thing.bjo`, samma typnamn, annan typ.

(export Thing make-b peel-b)
(import (std prelude))

(type (: Thing (Union (: MkThingB string))))

(: (-> string Thing))
(defun (make-b s)
  (MkThingB s))

(: (-> Thing string))
(defun (peel-b t)
  (match t
    ((MkThingB s) s)))
