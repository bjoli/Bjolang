;; std/mutable/vec.bjo — the growable array, written in place.
;;
;; A `MutableVec` *is* a .NET `List<T>`: a contiguous array that doubles when it
;; fills. Indexing and appending are O(1), inserting and removing at an index
;; are O(n) in what follows the index.
;;
;; **This is the mutable one.** `(mutablevec-add! v x)` writes `v`; it answers
;; nothing, and everyone holding `v` sees the change. `Vec` is the persistent
;; structure of the same shape, and a program that wants to keep old versions
;; should use that.
;;
;; **What the existing builders are not.** `VecBuilder` and `ListBuilder` are
;; append-only: an element goes in and nothing comes out until the collection is
;; finished. This is the one that can be written at an index, sorted, and had
;; elements removed from the middle — a scratch buffer rather than a funnel.
;;
;; **Not a key.** The `Eq` implementation at the bottom is structural, and
;; `eq-hash` refuses: there is no honest number for a value whose elements move.
(import (std prelude))
(import (only (std interop) as-delegate))

(:doc #:file "vec.bjodoc")

(export
  MutableVec
  mutablevec mutablevec-with-capacity
  mutablevec-length mutablevec-empty?
  mutablevec-ref mutablevec-try-ref mutablevec-set!
  mutablevec-add! mutablevec-add-all! mutablevec-insert!
  mutablevec-remove-at! mutablevec-remove! mutablevec-remove-where!
  mutablevec-pop! mutablevec-clear!
  mutablevec-contains? mutablevec-index-of
  mutablevec-reverse! mutablevec-sort! mutablevec-sort-unstable! mutablevec-sort-by!
  mutablevec-copy
  mutablevec-grow! mutablevec-span
  list->mutablevec mutablevec->list vec->mutablevec mutablevec->vec
  mutablevec->iarray
  seq->mutablevec mutablevec->seq mutablevec->array
  mutablevec->str)

;; The type is .NET's, not an alias for a record of our own: a `MutableVec`
;; handed to any other `import/extern` that takes a `List<T>` is accepted as it
;; stands, with nothing to unwrap.
(import/class
  ((MutableVec %a) (: System.Collections.Generic.List))
  ((Predicate %a) (: System.Predicate)))

;; ---------------------------------------------------------------------------
;; The vector
;; ---------------------------------------------------------------------------

;; `List<T>`'s own members. `get_Item` and `set_Item` are its indexer.
(import/extern
  (mutablevec-length        (: System.Collections.Generic.List.Count     (-> (MutableVec %a) int) #:get))
  ;; Throws when the index is out of range, which is what `Refable` asks of an
  ;; indexed collection. `mutablevec-try-ref` is the checked one.
  (mutablevec-ref           (: System.Collections.Generic.List.get_Item  (-> (MutableVec %a) int %a)))
  (mutablevec-set!          (: System.Collections.Generic.List.set_Item  (-> (MutableVec %a) int %a void)))
  (mutablevec-add!          (: System.Collections.Generic.List.Add       (-> (MutableVec %a) %a void)))
  (mutablevec-add-all!      (: System.Collections.Generic.List.AddRange  (-> (MutableVec %a) (Seq %a) void)))
  (mutablevec-insert!       (: System.Collections.Generic.List.Insert    (-> (MutableVec %a) int %a void)))
  (mutablevec-remove-at!    (: System.Collections.Generic.List.RemoveAt  (-> (MutableVec %a) int void)))
  ;; Removes the first element equal to `x`, and answers whether there was one.
  (mutablevec-remove!       (: System.Collections.Generic.List.Remove    (-> (MutableVec %a) %a bool)))
  (mutablevec-clear!        (: System.Collections.Generic.List.Clear     (-> (MutableVec %a) void)))
  (mutablevec-contains?     (: System.Collections.Generic.List.Contains  (-> (MutableVec %a) %a bool)))
  ;; -1 when there is none, which is what .NET answers and what an `Option`
  ;; would cost an allocation to say.
  (mutablevec-index-of      (: System.Collections.Generic.List.IndexOf   (-> (MutableVec %a) %a int)))
  (mutablevec-reverse!      (: System.Collections.Generic.List.Reverse   (-> (MutableVec %a) void)))
  (mutablevec->array        (: System.Collections.Generic.List.ToArray   (-> (MutableVec %a) (Array %a))))
  (clr-remove-all           (: System.Collections.Generic.List.RemoveAll (-> (MutableVec %a) (Predicate %a) int)))
  ;; The way to build an `IArray` one element at a time: add to a vector, then
  ;; copy it once. `iarray-add` copies the whole array each time.
  (mutablevec->iarray       (: Bjolang.Runtime.IArrayModule.FromList (-> (MutableVec %a) (IArray %a))))
  ;; The elements where the vector keeps them. Valid until the vector grows.
  (clr-as-span              (: System.Runtime.InteropServices.CollectionsMarshal.AsSpan (-> (MutableVec %a) (Span %a))))
  (clr-set-count            (: System.Runtime.InteropServices.CollectionsMarshal.SetCount (-> (MutableVec %a) int void))))

(: (-> (MutableVec %a)))
(defun (mutablevec) (MutableVec.))

;; Room for `capacity` elements before the first regrow. The length is still 0.
(: (-> int (MutableVec %a)))
(defun (mutablevec-with-capacity capacity) (MutableVec. capacity))

(: (-> (Seq %a) (MutableVec %a)))
(defun (seq->mutablevec xs) (MutableVec. xs))

;; The vector itself, seen as a sequence: nothing is copied.
(: (-> (MutableVec %a) (Seq %a)))
(defun (mutablevec->seq v) #:inline (cast (Seq %a) v))

(: (-> (MutableVec %a) (MutableVec %a)))
(defun (mutablevec-copy v) (MutableVec. (mutablevec->seq v)))

(: (-> (MutableVec %a) bool))
(defun (mutablevec-empty? v) #:inline (= (mutablevec-length v) 0))

(: (-> (MutableVec %a) int (Option %a)))
(defun (mutablevec-try-ref v i) #:inline
  (if (and (>= i 0) (< i (mutablevec-length v))) (Some (mutablevec-ref v i)) None))

;; The last element, removed. `None` leaves the vector as it was, so a
;; stack-shaped loop can pop until it stops.
(: (-> (MutableVec %a) (Option %a)))
(defun (mutablevec-pop! v)
  (def last (- (mutablevec-length v) 1))
  (if (< last 0)
      None
      (let ((x (mutablevec-ref v last)))
        (mutablevec-remove-at! v last)
        (Some x))))

;; Removes every element that `pred` accepts, and returns how many it removed.
(: (-> (MutableVec %a) (-> %a bool) int))
(defun (mutablevec-remove-where! v pred)
  (clr-remove-all v (: (as-delegate pred) (Predicate %a))))

(import/class
  (ArgumentOutOfRangeException (: System.ArgumentOutOfRangeException
                                  (-> string string ArgumentOutOfRangeException))))

;; The elements of `sorted`, which has the vector's length, into the vector.
(: (-> (MutableVec %a) (Array %a) void))
(defun (write-back! xs sorted)
  (def items (clr-as-span xs))
  (loop (:for i (range 0 (array-length sorted)))
        (:do (span-set! items i (array-ref sorted i)))))

;; Sorted by the element's own `Ord`. `mutablevec-sort-by!` takes the comparison
;; directly, for an order that is not the type's. Both are stable, as
;; `list-sort` is: equal elements keep their order. A copy is sorted with
;; `array-sort!` and written back once the sort is done, so when a comparison
;; raises, the vector is as it was.
(: (-> (MutableVec %a) void) (where (Ord %a)))
(defun (mutablevec-sort! xs)
  (def sorted (mutablevec->array xs))
  (array-sort! sorted)
  (write-back! xs sorted))

;; As `mutablevec-sort!`, with `array-sort-unstable!`: equal elements can
;; change places. When a comparison raises, the vector is as it was.
(: (-> (MutableVec %a) void) (where (Ord %a)))
(defun (mutablevec-sort-unstable! xs)
  (def sorted (mutablevec->array xs))
  (array-sort-unstable! sorted)
  (write-back! xs sorted))

;; As `mutablevec-sort!`, in the order of `cmp`, with `array-sort-by!`.
;; Stable. When `cmp` raises, the vector is as it was.
(: (-> (MutableVec %a) (-> %a %a int) void))
(defun (mutablevec-sort-by! v cmp)
  (def sorted (mutablevec->array v))
  (array-sort-by! cmp sorted)
  (write-back! v sorted))

;; ---------------------------------------------------------------------------
;; Blocks
;; ---------------------------------------------------------------------------
;;
;; A loop that fills a vector a block at a time grows the vector, and then
;; writes the new elements through a span.

;; Adds `n` elements at the end. Their values are unspecified: the storage
;; can keep values from before. Write each one before you read it.
;; Raises ArgumentOutOfRangeException when `n` is less than 0.
(: (-> (MutableVec %a) int void))
(defun (mutablevec-grow! xs n)
  (when (< n 0)
    (raise (cast Exception
                 (ArgumentOutOfRangeException.
                  "n" (str "mutablevec-grow!: the count is " (int->string n) ", and it must be 0 or more.")))))
  (clr-set-count xs (+ (mutablevec-length xs) n)))

;; The `n` elements from index `start`, as a span over the storage of the
;; vector. A write through the span writes the vector. The span is valid
;; until the vector changes its length.
;; Raises ArgumentOutOfRangeException when the range is not in the vector.
(: (-> (MutableVec %a) int int (Span %a)))
(defun (mutablevec-span xs start n)
  (span-slice (clr-as-span xs) #:from start #:to (+ start n)))

;; ---------------------------------------------------------------------------
;; Conversions
;; ---------------------------------------------------------------------------

(: (-> (List %a) (MutableVec %a)))
(defun (list->mutablevec xs) (seq->mutablevec (list->seq xs)))

(: (-> (MutableVec %a) (List %a)))
(defun (mutablevec->list xs) (->list (mutablevec->seq xs)))

(: (-> (Vec %a) (MutableVec %a)))
(defun (vec->mutablevec v) (seq->mutablevec (vec->seq v)))

(: (-> (MutableVec %a) (Vec %a)))
(defun (mutablevec->vec xs) (->vec (mutablevec->seq xs)))

;; ---------------------------------------------------------------------------
;; The traits
;; ---------------------------------------------------------------------------

(impl (Refable (MutableVec %a))
  (type %index int)
  (type %out %a)
  (defun (ref xs index)
    (mutablevec-ref xs index))
  (defun (try-ref xs index)
    (mutablevec-try-ref xs index)))

;; Written in place, so `(set! v i x)` writes `v`. An index out of range throws.
(impl (Settable! (MutableVec %a))
  (type %index int)
  (type %in %a)
  (defun (ref-set! v i x)
    (mutablevec-set! v i x)))

;; An `int` cursor, as `Array` has: an index and an array read is what this
;; collection makes cheap, so there is nothing a cursor object would save.
;;
;; A walk reads the length at every step rather than once, so a vector written
;; *during* its own walk is walked as it now stands. Adding an element inside a
;; `for-each` over the same vector therefore does not end the loop early — nor
;; does it end at all, which is the usual hazard of writing a collection you
;; are reading. Shrinking it past the cursor ends the walk.
(impl (Iterable (MutableVec %a))
  (type %elem %a)
  (type %cursor int)
  (defun (iterable-start xs) 0)
  (defun (iterable-done? xs index) (>= index (mutablevec-length xs)))
  (defun (iterable-current xs index) (mutablevec-ref xs index))
  (defun (iterable-next xs index) (+ index 1)))

;; The elements are one .NET array, so a loop over them can be a vector loop.
;; Such a loop does not add to the vector, so the span stays valid.
(impl (Contiguous (MutableVec %a))
  (type %value %a)
  (defun (contiguous? xs) #t)
  (defun (contiguous-values xs) (span->ro-span (clr-as-span xs)))
  (defun (contiguous-valid xs) (array->ro-span (make-array 0))))

(impl (Collection (MutableVec %a))
  (type %content %a)
  (defun (length xs) (mutablevec-length xs))
  (defun (empty? xs) (mutablevec-empty? xs)))

(impl (Addable! (MutableVec %a))
  (type %elem %a)
  (defun (add! xs elem)
    (mutablevec-add! xs elem)))

;; Two vectors are equal when they hold the same elements in the same order.
;;
;; Without this they would fall to the blanket, which is .NET's equality, which
;; for a `List<T>` is reference identity — two vectors built the same way from
;; the same elements would have compared unequal.
;;
;; `eq-hash` refuses, exactly as `Deque`'s does: there is no honest number for a
;; value whose elements move, and a `Map` keyed on one would ask .NET rather
;; than asking this.
(impl (Eq (MutableVec %a))
  (where (Eq %a))
  (defun (= a b)
    (def len (mutablevec-length a))
    (if (= len (mutablevec-length b))
        (let lp ((i 0))
          (cond
            ((= i len) #t)
            ((= (mutablevec-ref a i) (mutablevec-ref b i)) (lp (+ i 1)))
            (else #f)))
        #f))
  (defun (eq-hash xs) (unhashable "MutableVec")))

;; `#mvec(a b c)`, in order.
(impl (Written (MutableVec %a))
  (where (Written %a))
  (defun (write-into xs b) (elements-print-into "#mvec(" xs ")" b (fun (x b) (write-into x b)))))

(impl (Displayed (MutableVec %a))
  (where (Displayed %a))
  (defun (display-into xs b) (elements-print-into "#mvec(" xs ")" b (fun (x b) (display-into x b)))))

(: (-> (MutableVec %a) string) (where (Displayed %a)))
(defun (mutablevec->str xs) (displayed xs))

(:deprecated mutablevec->str "use `displayed`")
