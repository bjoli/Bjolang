;; One half of a name clash between two libraries.
;;
;; `banana_b.bjo` declares a `Banana` too. Nothing here knows that, and nothing
;; here should have to: a type's identity is this module plus its name.

(export peel-a make-a)

(type (: Banana (Union (MkBananaA int))))

(: make-a (-> int Banana))
(defun (make-a n)
  (MkBananaA n))

(: peel-a (-> Banana int))
(defun (peel-a b)
  (match b
    ((MkBananaA n) n)))
