;; A function over spans can be called by name, not used as a value.
;; EXPECT-ERROR: this function takes or answers a (System.Span long), and here it is used as a value
(import (std prelude))
(import/extern
  (whole (: System.MemoryExtensions.AsSpan (-> (Array %a) (System.Span %a))))
  (sleep (: System.Threading.Tasks.Task.Delay (-> int void) #:async #:uncancellable)))
(: (-> (System.Span long) int))
(defun (len s) (.-Length s))

(defun (main) (def xs (vec->array [1L])) (def f len) (println (f (whole xs))) 0)
