;; Monomorphisation: a `-?->` procedure is written once and *both* copies are
;; generated.
;;
;; `defbjouble` (154) is the case where two bodies must be written by hand,
;; because a leaf's two colours call different .NET methods. This is the case
;; above a leaf: one body, and the compiler makes the second. The declaration is
;; the only thing the author writes — `-?->` on the parameter that may be given
;; either colour.
;;
;; This file replaces `errors/poly_arrow_needs_copies.bjo`, which existed to pin
;; the refusal that used to stand here: the declaration was accepted and
;; published, and instantiating it at the suspending colour failed with "copies
;; are not generated yet". They are generated now, so what was an error fixture
;; is a behavioural one.
;;
;; The copy is chosen by **what the argument is**, not by where the call is
;; written. That is the assertion to keep: the two copies take `Func<A,B>` and
;; `Func<A,Fiber<B>>`, which are unrelated C# types, so exactly one of them fits
;; and the enclosing member's colour has no vote. `sync-inside-bjoroutine` below
;; is the test that pins it.

(import (std prelude))
(import (std ports))
(import (std simpletest))
(import "155_lib.bjo")

;; --- Written once, in this module -------------------------------------------

(: apply-twice (-> (-?-> int int) int int))
(defun (apply-twice f x) (f (f x)))

;; --- Ordinary callers -------------------------------------------------------

(: doubled-twice (-> int int))
(defun (doubled-twice n)
  (apply-twice (fun (x) (* x 2)) n))

;; --- Suspending callers -----------------------------------------------------
;;
;; The lambda is a `(bjoroutine ...)`, so the effect variable is instantiated
;; async and the call goes to the generated copy — `await apply_twice__bjo(...)`
;; in the emitted C#, with an `async` lambda handed to it.
(: bumped-twice (-bjo-> int int))
(defbjo (bumped-twice n)
  (apply-twice (bjoroutine (x) (+ x 1)) n))

;; A suspending caller that passes an *ordinary* lambda. This must still reach
;; the ordinary copy: being inside a bjoroutine says nothing about what the
;; callback is, and calling the suspending copy here would hand a `Func<int,int>`
;; where a `Func<int,Fiber<int>>` is wanted.
(: sync-inside-bjoroutine (-bjo-> int int))
(defbjo (sync-inside-bjoroutine n)
  (apply-twice (fun (x) (* x 2)) n))

;; The suspending lambda actually suspends: it awaits a leaf rather than just
;; being painted the colour. Without this the test would pass on a copy that was
;; async in name only.
(: read-lengths (-bjo-> TextInputPort int))
(defbjo (read-lengths p)
  (port-fold (bjoroutine (port acc) (+ acc (string-length (read-line port))))
             0
             p))

;; The same fold, ordinarily. One source, one name, two emitted bodies.
(: read-lengths-sync (-> TextInputPort int))
(defun (read-lengths-sync p)
  (port-fold (fun (port acc) (+ acc (string-length (read-line port))))
             0
             p))

;; --- A defbjo may declare -?-> as well ---------------------------------------
;;
;; The two claims are independent: `defbjo` says this body suspends, `-?->` says
;; the callback may be either colour. So both copies are async, and the only
;; difference between them is the delegate the parameter is spelled with —
;; `Func<int,int>` against `Func<int,Fiber<int>>`.
;;
;; This was accepted and silently meant nothing until an error message started
;; recommending it: only `defun` was expanded, so no twin was made, the arrow
;; was decoration, and after effect defaulting arrived the single copy awaited
;; its own ordinary parameter and failed in Roslyn. Advice that produces a
;; second error is worse than no advice, so the recommendation and the support
;; for it landed together.
(: twice-and-wait (-> (-?-> int int) int int))
(defbjo (twice-and-wait f x) (f (f x)))

;; --- Across a module boundary -----------------------------------------------

(: sum-doubled (-> (List int) int))
(defun (sum-doubled xs)
  (sum-with (fun (x) (* x 2)) xs))

(: sum-bumped (-bjo-> (List int) int))
(defbjo (sum-bumped xs)
  (sum-with (bjoroutine (x) (+ x 1)) xs))

;; --- The library's own drainers ---------------------------------------------
;;
;; `port->list` takes a `-?->` reader, so a bjoroutine can drain a port without
;; parking on every line. Before the reader was declared this was not merely
;; slow, it was *inexpressible*: a suspending lambda handed to a parameter typed
;; `(-> ...)` is a type error, so there was no way to write it at all.
;;
;; The reader may be spelled out as a lambda...
(: drain-count (-bjo-> TextInputPort int))
(defbjo (drain-count p)
  (list-length (port->list (bjoroutine (q) (read-line q)) p)))

;; ...or passed as the bare name, which compiles to exactly the same thing.
;;
;; This was the last place a call site's colour was decided by something other
;; than what the reader wrote. A reference to a name with two copies carries an
;; effect variable rather than the ordinary copy's arrow, so the mention settles
;; nothing by itself, and what settles it is the colour of the member the
;; mention is written in. Spelling out `(bjoroutine (q) (read-line q))` was the
;; workaround for that — and naming a colour is the one thing this design exists
;; to avoid having to do.
(: drain-count-named (-bjo-> TextInputPort int))
(defbjo (drain-count-named p)
  (list-length (port->list read-line p)))

;; The same three words in a `defun`, where they must reach the *ordinary*
;; reader — passing the suspending one would hand a `Func<A,Fiber<B>>` to a
;; parameter emitted for `Func<A,B>`. Nothing here says which; the enclosing
;; member does.
(: drain-count-sync (-> TextInputPort int))
(defun (drain-count-sync p)
  (list-length (port->list read-line p)))

;; --- Running a bjoroutine to a value ----------------------------------------

(: run-bjo (-> (Promise int) int))
(defun (run-bjo p)
  (match (sync/blocking (promise-join p))
    ((Ok n) n)
    ((Err e) -1)))

(defun (main)
  ;; --- The ordinary copy ----------------------------------------------------
  (expect "an ordinary caller" (doubled-twice 3) 12)

  ;; --- The generated copy ---------------------------------------------------
  (expect "a suspending caller" (run-bjo (bjo (bumped-twice 10))) 12)

  ;; --- Selection follows the argument, not the caller -----------------------
  ;;
  ;; Inside a bjoroutine, passing an ordinary lambda. If selection were by the
  ;; enclosing member's colour this would pick the suspending copy and hand it
  ;; the wrong delegate type.
  (expect "an ordinary lambda inside a bjoroutine"
          (run-bjo (bjo (sync-inside-bjoroutine 3)))
          12)

  ;; --- Both copies in one program -------------------------------------------
  (expect "the two copies agree"
          (+ (doubled-twice 5) (run-bjo (bjo (bumped-twice 5))))
          27)

  ;; --- The prelude's own -?-> -----------------------------------------------
  ;;
  ;; `port-fold` is the reason `-?->` exists: a fold over a port whose reader
  ;; may suspend. The suspending copy awaits `ReadLineOrThrowAsync` through
  ;; `read-line`, which is a `defbjouble`, so both mechanisms are in one call.
  (expect "port-fold, ordinarily"
          (read-lengths-sync (open-input-string "ab\ncde\nf"))
          6)

  (expect "port-fold, suspending"
          (run-bjo (bjo (read-lengths (open-input-string "ab\ncde\nf"))))
          6)

  ;; --- Draining a port at the suspending colour -----------------------------
  (expect "port->list with a suspending reader"
          (run-bjo (bjo (drain-count (open-input-string "a\nb\nc"))))
          3)

  (expect "port->list with the reader named"
          (run-bjo (bjo (drain-count-named (open-input-string "a\nb\nc"))))
          3)

  (expect "the same source, ordinarily"
          (drain-count-sync (open-input-string "a\nb\nc"))
          3)

  ;; --- A suspending definition with a polymorphic parameter -----------------
  ;;
  ;; Both copies are async; only the callback's colour differs. If the wrong one
  ;; were selected this would not compile, the delegate types being unrelated.
  (expect "a defbjo taking an ordinary callback"
          (run-bjo (bjo (twice-and-wait (fun (x) (* x 2)) 3)))
          12)

  (expect "a defbjo taking a suspending callback"
          (run-bjo (bjo (twice-and-wait (bjoroutine (x) (+ x 1)) 3)))
          5)

  ;; --- Across a module boundary ---------------------------------------------
  ;;
  ;; `sum-with` is imported, so its twin was generated in the *other* module and
  ;; found here through the published `-?->` in its signature.
  (expect "an imported -?->, ordinarily" (sum-doubled (list 1 2 3)) 12)
  (expect "an imported -?->, suspending"
          (run-bjo (bjo (sum-bumped (list 1 2 3))))
          9)

  0)
