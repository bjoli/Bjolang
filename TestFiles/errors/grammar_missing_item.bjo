;; An item of :each without :? is necessary.
;; EXPECT-ERROR: (port ...) is missing
(import (std prelude))
(def/grammar Conn
  (Conn (conn (: host string) (: rest Opts)))
  (Opts (:each (: port (port int)) (: limit (:? (limit int))))))
(defun (main args)
  (def (: c Conn) '(conn "h" (limit 3)))
  0)
