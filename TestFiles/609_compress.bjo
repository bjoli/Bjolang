;; std/compress: each format round-trips through a file, gzip reads what
;; gzip(1) wrote and several members as one, a closed compressed port leaves
;; the port under it open, a scope's end writes the trailer, bad data, a bad
;; checksum and data that ends early raise, input in chunks of one byte
;; decodes, and a fiber can write compressed data into a pipe that another
;; reads.
(import (std prelude))
(import (std ports))
(import (std compress))
(import (std simpletest))
(import (only (std os) make-temp-directory))

(: string)
(def dir (make-temp-directory))

(: (-> string string))
(defun (at name)
  (path-combine dir name))

;; The size of the file `name`.
(: (-> string long))
(defun (size-of name)
  (match (file-info (at name))
    ((Some info) (record-ref info size))
    (None -1L)))

;; Writes `text` to the file `name` through the port `wrap` makes over it.
(: (-> string (-> OutputPort OutputPort) string void))
(defun (write-through name wrap text)
  (with-scope
    (def file (raise-err (open-output-file (at name))))
    (def c (wrap file))
    (write-string c text)
    (close-output-port c)
    (close-output-port file)))

;; The text of the file `name`, read through the port `wrap` makes over it.
(: (-> string (-> InputPort InputPort) string))
(defun (read-through name wrap)
  (with-scope
    (def file (raise-err (open-input-file (at name))))
    (read-all (wrap file))))

;; Whether reading `name` through `wrap` raises InvalidDataException.
(: (-> string (-> InputPort InputPort) bool))
(defun (invalid-data? name wrap)
  (match (try (read-through name wrap) #:catch (System.IO.InvalidDataException))
    ((Ok _) #f)
    ((Err _) #t)))

;; Whether reading `name` through `wrap` raises EndOfStreamException.
(: (-> string (-> InputPort InputPort) bool))
(defun (ends-early? name wrap)
  (match (try (read-through name wrap) #:catch (System.IO.EndOfStreamException))
    ((Ok _) #f)
    ((Err _) #t)))

;; The bytes of the file `name`, with `f` applied to them.
(: (-> string (-> (Vec byte) (Vec byte)) string void))
(defun (rewrite from f to)
  (raise-err
   (file-write-bytes (at to) (vec->array (f (array->vec (raise-err (file-read-bytes (at from)))))))))

;; A port over `p` that returns its bytes one at a time.
(: (-> InputPort InputPort))
(defun (one-at-a-time p)
  (make-input-port (bjoroutine () (read-bytes p 1))))

;; Whether reading `name` through `wrap` raises InvalidOperationException,
;; as .NET's Brotli decoder does on bad data.
(: (-> string (-> InputPort InputPort) bool))
(defun (invalid-operation? name wrap)
  (match (try (read-through name wrap) #:catch (System.InvalidOperationException))
    ((Ok _) #f)
    ((Err _) #t)))

(: string)
(def text
  (string-join (list->vec {listing (str "line " (int->string i) " of the text, and some more of it")
                                   (:for i (range 0 5000))})
               "\n"))

(: (-bjo-> int (Tuple InputPort OutputPort) int))
(defbjo (pipe-round-trip lines pipe)
  (def (Tuple in out) pipe)
  (def writer
    (bjo
      (with-scope
        (def gz (gzip-output-port out))
        (loop (:for i (range 0 lines))
              (:do (write-string gz (str "line " (int->string i) "\n"))))
        (close-output-port gz)
        (close-output-port out)
        0)))
  (def n
    (with-scope
      (def plain (gzip-input-port in))
      (let go ((n 0))
        (match (read-line/opt plain)
          ((Some _) (go (+ n 1)))
          (None n)))))
  (ignore (sync (promise-join writer)))
  n)

(defbjo (main args)
  ;; --- Round trips ------------------------------------------------------------
  (write-through "t.gz" #(gzip-output-port &) text)
  (expect "gzip round-trips" (read-through "t.gz" #(gzip-input-port &)) text)
  (expect "and compresses" (< (size-of "t.gz") (cast long (/ (string-length text) 4))) #t)
  (write-through "t.zz" #(zlib-output-port &) text)
  (expect "zlib round-trips" (read-through "t.zz" #(zlib-input-port &)) text)
  (write-through "t.deflate" #(deflate-output-port &) text)
  (expect "deflate round-trips" (read-through "t.deflate" #(deflate-input-port &)) text)
  (write-through "t.br" #(brotli-output-port &) text)
  (expect "Brotli round-trips" (read-through "t.br" #(brotli-input-port &)) text)

  (loop (:for (Tuple name level) [(Tuple "fastest" CompressFastest)
                                  (Tuple "smallest" CompressSmallest)
                                  (Tuple "none" CompressNone)])
        (:do (write-through #"l-${name}.gz" #(gzip-output-port & #:level level) text)
             (expect #"gzip at level ${name} round-trips"
                     (read-through #"l-${name}.gz" #(gzip-input-port &))
                     text)))
  (expect "CompressNone is larger than CompressSmallest"
          (> (size-of "l-none.gz") (size-of "l-smallest.gz"))
          #t)

  (write-through "empty.gz" #(gzip-output-port &) "")
  (expect "nothing round-trips" (read-through "empty.gz" #(gzip-input-port &)) "")

  ;; --- Other gzip writers ---------------------------------------------------
  ;; `printf 'hi there\n' | gzip -n`
  (raise-err (file-write-bytes (at "sys.gz")
                               #[31 139 8 0 0 0 0 0 0 3 203 200 84 40 201 72 45 74 229 2 0 182 11 136
                                 155 9 0 0 0]))
  (expect "what gzip(1) wrote is read" (read-through "sys.gz" #(gzip-input-port &)) "hi there\n")
  (raise-err (file-write-bytes
              (at "two.gz")
              (vec->array (vec-append (array->vec (raise-err (file-read-bytes (at "sys.gz"))))
                                      (array->vec (raise-err (file-read-bytes (at "sys.gz"))))))))
  (expect "two members are read as one"
          (read-through "two.gz" #(gzip-input-port &))
          "hi there\nhi there\n")

  ;; --- The port under it ----------------------------------------------------
  (with-scope
    (def file (raise-err (open-output-file (at "after.gz"))))
    (def gz (gzip-output-port file))
    (write-string gz "compressed")
    (close-output-port gz)
    (write-string file "and plain after it")
    (close-output-port file))
  (expect "closing the compressed port leaves the port under it open"
          (string-ends-with? (raise-err (file-read-text (at "after.gz"))) "and plain after it")
          #t)

  ;; A port that is not closed is closed at its scope's end, before the file
  ;; it was opened over, so its trailer is written.
  (with-scope
    (def file (raise-err (open-output-file (at "unclosed.gz"))))
    (write-string (gzip-output-port file) "not closed by hand"))
  (expect "a scope's end writes the trailer"
          (read-through "unclosed.gz" #(gzip-input-port &))
          "not closed by hand")

  ;; --- Bad data -------------------------------------------------------------
  (raise-err (file-write-text (at "bad.gz") "this is not gzip at all"))
  (expect "data that is not gzip raises InvalidDataException"
          (invalid-data? "bad.gz" #(gzip-input-port &))
          #t)
  (raise-err (file-write-text (at "bad.br") "this is not Brotli at all"))
  (expect "data that is not Brotli raises InvalidOperationException"
          (invalid-operation? "bad.br" #(brotli-input-port &))
          #t)
  ;; Data that ends early raises, wherever it ends.
  (loop (:for (Tuple name wrap) [(Tuple "t.gz" #(gzip-input-port &))
                                 (Tuple "t.zz" #(zlib-input-port &))
                                 (Tuple "t.deflate" #(deflate-input-port &))])
        (:do (def n (cast int (size-of name)))
             (loop (:for cut [1 3 (/ n 2) (- n 4) (- n 1)])
                   (:do (rewrite name #(vec-slice & 0 cut) "cut")
                        (expect (str name " cut to " (int->string cut)
                                     " bytes raises EndOfStreamException")
                                (ends-early? "cut" wrap)
                                #t)))))
  ;; A checksum or a length that does not match raises.
  (def gz-size (cast int (size-of "t.gz")))
  (rewrite "t.gz"
           #(vec-set & (- gz-size 8) (cast byte (+ 1 (cast int (vec-ref & (- gz-size 8))))))
           "crc.gz")
  (expect "a gzip CRC-32 that does not match raises" (invalid-data? "crc.gz" #(gzip-input-port &)) #t)
  (rewrite "t.gz" #(vec-set & (- gz-size 1) (cast byte 7)) "len.gz")
  (expect "a gzip length that does not match raises" (invalid-data? "len.gz" #(gzip-input-port &)) #t)
  (def zz-size (cast int (size-of "t.zz")))
  (rewrite "t.zz"
           #(vec-set & (- zz-size 1) (cast byte (+ 1 (cast int (vec-ref & (- zz-size 1))))))
           "adler.zz")
  (expect "a zlib Adler-32 that does not match raises"
          (invalid-data? "adler.zz" #(zlib-input-port &))
          #t)
  (rewrite "sys.gz" #(vec-append & (array->vec (string->bytes "junk"))) "junk-after.gz")
  (expect "bytes after the last member that are not a member raise"
          (invalid-data? "junk-after.gz" #(gzip-input-port &))
          #t)

  ;; --- Input in small pieces ------------------------------------------------
  (expect "gzip input one byte at a time decodes"
          (with-scope
            (def file (raise-err (open-input-file (at "t.gz"))))
            (read-all (gzip-input-port (one-at-a-time file))))
          text)
  (expect "a stored gzip one byte at a time decodes"
          (with-scope
            (def file (raise-err (open-input-file (at "l-none.gz"))))
            (read-all (gzip-input-port (one-at-a-time file))))
          text)

  ;; --- Fibers ---------------------------------------------------------------
  (expect "a fiber compresses into a pipe while another reads it"
          (pipe-round-trip 20000 (byte-pipe))
          20000)
  0)
