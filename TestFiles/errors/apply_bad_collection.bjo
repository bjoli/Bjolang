;; The last argument is not a collection `apply` can spread.
;;
;; `Array`, `Vec` and `List` are the three that can become a rest array without
;; a run-time length check: each knows its own length and can be walked once.
;; A `Seq` deliberately cannot — it is lazy, so producing the array would run it,
;; and an infinite one would not come back.

;; EXPECT-ERROR: 'apply' can spread an Array, a Vec or a List

(import (std prelude))

(: join (-> #:rest string string))
(defun (join #:rest parts) "")

(defun (main args)
  (println (apply join "not-a-collection"))
  0)
