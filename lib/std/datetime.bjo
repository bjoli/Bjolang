;; std/datetime.bjo — dates, times, instants, zones and durations.
;;
;; Every value lies between 0001-01-01T00:00 and 9999-12-31T23:59:59.9999999,
;; at a precision of 100 ns. A result outside that range raises an
;; OverflowException from a function that returns the value itself, and is None
;; from a constructor, a parser or an `/opt` function. Nothing is clamped
;; silently, except month arithmetic landing past the end of a month
;; (2026-01-31 + 1 month = 2026-02-28) and time-of-day arithmetic, which wraps
;; at midnight.
;;
;; Text is formatted and parsed here, digit by digit, rather than by .NET, so
;; no culture is involved.
;;
;; Its reference is its docs, in datetime.bjodoc.
;;
;; Open:
;; - ->weekday answers an int, so (= (->weekday d) 0) compiles and is never
;;   true. A Weekday union, Monday to Sunday, would make it a type error, at
;;   the cost of arithmetic on weekdays.
;; - date->text writes (week) beside (year) without a word, so
;;   '((year 4) "-W" (week 2)) writes 2027-01-01 as 2027-W53, a week 2027
;;   does not have, where text->date refuses that format. Beside (month) and
;;   (day) the week is right, so the writer cannot refuse it by itself.
;; - A format is checked each time it reads, as a list cannot carry the
;;   check, which is about a third of a reader's time; a reader costs about
;;   ten times an iso8601-> one. Reading has no optional parts either, such
;;   as seconds that may be missing; the ISO 8601 readers have those.
;; - utc-datetime->instant takes any DateTime, so a local time goes in and is
;;   read as UTC without a word.

(import (std prelude))

(import/class
  (ClrDate (: System.DateOnly (-> int int int ClrDate)))
  (ClrTime (: System.TimeOnly (-> long ClrTime)))
  (ClrDateTime (: System.DateTime (-> long DateTimeKind ClrDateTime)))
  (DateTimeKind (: System.DateTimeKind))
  (ClrTimeSpan (: System.TimeSpan (-> long ClrTimeSpan)))
  (TimeZoneInfo (: System.TimeZoneInfo))
  (OverflowException (: System.OverflowException (-> string OverflowException)))
  (ArgumentException (: System.ArgumentException (-> string ArgumentException)))
  (ClrLock (: System.Threading.Lock (-> ClrLock)))
  ;; A .NET StringBuilder of its own, because the prelude's cannot be given a
  ;; capacity, and it takes a UTF-16 unit, which a digit is.
  (TextBuilder (: System.Text.StringBuilder (-> int TextBuilder))))

;; A body an importer may copy (a trait method here, or a constrained
;; function) names .NET members through these aliases rather than through
;; helpers of this module: an alias travels under a name nobody can write,
;; while a helper would be exported under its own.
(import/extern
  (clr-date-from-day-number (: System.DateOnly.FromDayNumber (-> int ClrDate)))
  (clr-date-from-datetime (: System.DateOnly.FromDateTime (-> ClrDateTime ClrDate)))
  (clr-time-from-datetime (: System.TimeOnly.FromDateTime (-> ClrDateTime ClrTime)))
  (clr-time-add (: System.TimeOnly.Add (-> ClrTime ClrTimeSpan ClrTime)))
  (clr-time-hour (: System.TimeOnly.Hour (-> ClrTime int) #:get))
  (clr-time-minute (: System.TimeOnly.Minute (-> ClrTime int) #:get))
  (clr-time-second (: System.TimeOnly.Second (-> ClrTime int) #:get))
  (clr-time-millisecond (: System.TimeOnly.Millisecond (-> ClrTime int) #:get))
  (clr-time-microsecond (: System.TimeOnly.Microsecond (-> ClrTime int) #:get))
  (clr-time-nanosecond (: System.TimeOnly.Nanosecond (-> ClrTime int) #:get))
  (clr-timespan-from-ticks (: System.TimeSpan.FromTicks (-> long ClrTimeSpan)))
  (clr-timespan-negate (: System.TimeSpan.Negate (-> ClrTimeSpan ClrTimeSpan)))
  (clr-date-day-number (: System.DateOnly.DayNumber (-> ClrDate int) #:get))
  (clr-date-year (: System.DateOnly.Year (-> ClrDate int) #:get))
  (clr-date-month (: System.DateOnly.Month (-> ClrDate int) #:get))
  (clr-date-day (: System.DateOnly.Day (-> ClrDate int) #:get))
  (clr-date-day-of-year (: System.DateOnly.DayOfYear (-> ClrDate int) #:get))
  (clr-date-add-months (: System.DateOnly.AddMonths (-> ClrDate int ClrDate)))
  (clr-date-add-years (: System.DateOnly.AddYears (-> ClrDate int ClrDate)))
  (clr-days-in-month (: System.DateTime.DaysInMonth (-> int int int)))
  (clr-time-ticks (: System.TimeOnly.Ticks (-> ClrTime long) #:get))
  (clr-datetime-ticks (: System.DateTime.Ticks (-> ClrDateTime long) #:get))
  (clr-timespan-ticks (: System.TimeSpan.Ticks (-> ClrTimeSpan long) #:get))
  (clr-tz-try-find
    (: System.TimeZoneInfo.TryFindSystemTimeZoneById
       (-> string (out TimeZoneInfo) (Option TimeZoneInfo))))
  (clr-tz-utc (: System.TimeZoneInfo.Utc #:get))
  (clr-tz-id (: System.TimeZoneInfo.Id (-> TimeZoneInfo string) #:get))
  (clr-tz-has-iana-id (: System.TimeZoneInfo.HasIanaId (-> TimeZoneInfo bool) #:get))
  (clr-tz-utc-offset (: System.TimeZoneInfo.GetUtcOffset (-> TimeZoneInfo ClrDateTime ClrTimeSpan)))
  (clr-lock-enter (: System.Threading.Lock.Enter (-> ClrLock void)))
  (clr-lock-exit (: System.Threading.Lock.Exit (-> ClrLock void)))
  (clr-add-unit (: System.Text.StringBuilder.Append (-> TextBuilder System.Char TextBuilder)))
  (clr-add-text (: System.Text.StringBuilder.Append (-> TextBuilder string TextBuilder)))
  (clr-builder-text (: System.Text.StringBuilder.ToString (-> TextBuilder string))))

;; Every export is documented there; the module doc is too.
(:doc #:file "datetime.bjodoc")

(export
  ;; Types
  Date Time DateTime Instant TimeZone Moment Duration
  DatePeriod Period Gap Overlap Resolver
  ;; Traits
  HasDate ->date HasTime ->time HasInstant ->instant
  DateArith +date-period DateDiff ->date-in-zone-of
  TimeArith +duration
  ;; Construction
  date time datetime date+time->datetime ->datetime
  duration date-period period
  ;; Zones and moments
  timezone utc timezone-id timezone-offset-at
  resolver datetime->moment datetime->moment/opt instant->moment
  +date-period/resolver -date-period/resolver
  ->utc-offset ->timezone adjust-timezone
  ;; Instants
  instant->utc-datetime utc-datetime->instant
  instant->unix-seconds unix-seconds->instant
  instant->unix-milliseconds unix-milliseconds->instant ->unix
  ;; The clock
  system-clock-in clock-in fixed-clock manual-clock clock-advance!
  clock-timezone now now/moment today
  ;; Accessors
  ->year ->month ->day ->weekday ->yday
  ->week ->week-year weeks-in-year week-date
  ->hours ->minutes ->seconds ->milliseconds ->nanoseconds
  ;; Arithmetic
  +years +months +weeks +days -years -months -weeks -days -date-period
  +hours +minutes +seconds +milliseconds
  -hours -minutes -seconds -milliseconds -duration
  +period -period
  duration->hours duration->minutes duration->seconds duration->milliseconds
  duration-negate
  ;; Differences
  years-between months-between weeks-between days-between
  duration-between hours-between minutes-between seconds-between milliseconds-between
  ;; Text
  iso8601->date iso8601->time iso8601->datetime iso8601->instant iso8601->moment
  iso8601->duration iso8601->date-period iso8601->period
  instant->http-date http-date->instant
  ;; Text of your own
  DateNumber RomanNumber DatePart TimePart DateTimePart MomentPart InstantPart DateNames
  date->text time->text datetime->text moment->text instant->text
  text->date text->time text->datetime text->instant text->moment text->moment/resolver
  english-names swedish-names current-date-names)


;; ===========================================================================
;; Types
;; ===========================================================================

;; The value types are opaque so that every value comes from a function that
;; checked it: a Moment's offset is always one its zone has at that time.
(type (: Date #:opaque (Struct (: v ClrDate))))
(type (: Time #:opaque (Struct (: v ClrTime))))
;; Kind is always Unspecified.
(type (: DateTime #:opaque (Struct (: v ClrDateTime))))
;; UTC ticks, not a UTC DateTime, because DateTime equality ignores Kind.
(type (: Instant #:opaque (Struct (: ticks long))))
(type (: TimeZone #:opaque (Struct (: tz TimeZoneInfo))))
(type (: Duration #:opaque (Struct (: v ClrTimeSpan))))
(type (: Moment #:opaque (Struct (: local DateTime) (: offset Duration) (: zone TimeZone))))

;; Any mix of amounts is a valid period, so these are transparent. Structs,
;; so that the one +days builds is not an allocation.
(type (: DatePeriod (Struct (: years int) (: months int) (: weeks int) (: days int))))
(type (: Period (Struct (: calendar DatePeriod) (: exact Duration))))

;; What datetime->moment does with a local time that a zone skips (a gap) or
;; has twice (an overlap).
(type (: Gap (Union GapPush GapNextValid)))
(type (: Overlap (Union OverlapEarlier OverlapLater)))
(type (: Resolver (Record (: gap Gap) (: overlap Overlap))))


;; ===========================================================================
;; Ranges
;; ===========================================================================

(: ticks-per-day long)
(def ticks-per-day 864000000000L)
(: ticks-per-hour long)
(def ticks-per-hour 36000000000L)
(: ticks-per-minute long)
(def ticks-per-minute 600000000L)
(: ticks-per-second long)
(def ticks-per-second 10000000L)
(: ticks-per-millisecond long)
(def ticks-per-millisecond 10000L)

;; 9999-12-31T23:59:59.9999999 in ticks, and 9999-12-31 as a day number.
(: max-ticks long)
(def max-ticks 3155378975999999999L)
(: max-day-number long)
(def max-day-number 3652058L)

;; 1970-01-01T00:00Z in ticks.
(: unix-epoch-ticks long)
(def unix-epoch-ticks 621355968000000000L)

;; Every Duration stays within ±long-max ticks, about ±29 227 years. Leaving
;; out long's minimum gives every duration a negation, so each one prints and
;; reads back.
(: long-max long)
(def long-max 9223372036854775807L)

(: long-of (-> int long))
(defun (long-of n) (cast System.Int64 n))

(: int-of (-> long int))
(defun (int-of n) (cast System.Int32 n))

(: range-error (-> string %a))
(defun (range-error what)
  (raise (cast Exception (OverflowException. (str "(std datetime): " what)))))

(: calendar-error (-> string %a))
(defun (calendar-error what)
  (range-error (str what " is outside 0001-01-01T00:00 to 9999-12-31T23:59:59.9999999")))

(: duration-error (-> %a))
(defun (duration-error)
  (range-error "a duration is outside ±29 227 years (±9 223 372 036 854 775 807 ticks)"))

(: in-calendar? (-> long bool))
(defun (in-calendar? t) (and (>= t 0L) (<= t max-ticks)))

;; n × unit for a positive unit, or None past the range of a Duration.
(: checked-mul (-> long long (Option long)))
(defun (checked-mul n unit)
  (def limit (/ long-max unit))
  (if (or (> n limit) (< n (- limit))) None (Some (* n unit))))

;; a + b, or None past the range of a Duration.
(: checked-add (-> long long (Option long)))
(defun (checked-add a b)
  (if (if (> b 0L) (> a (- long-max b)) (< a (- (- long-max) b)))
      None
      (Some (+ a b))))

(: units->ticks (-> long long long))
(defun (units->ticks n unit)
  (match (checked-mul n unit)
    ((Some t) t)
    (None (duration-error))))

(: plus-ticks (-> long long long))
(defun (plus-ticks a b)
  (match (checked-add a b)
    ((Some t) t)
    (None (duration-error))))

;; A tick count moved by a duration, for DateTime and Instant. The sum can
;; wrap only above long's maximum, and then it lands below zero, so the one
;; range check catches it.
(: shift-ticks (-> long long string long))
(defun (shift-ticks t d what)
  (def moved (+ t d))
  (if (in-calendar? moved) moved (calendar-error what)))


;; ===========================================================================
;; Construction
;; ===========================================================================

(: ticks->datetime (-> long DateTime))
(defun (ticks->datetime t) (DateTime (v (ClrDateTime. t DateTimeKind.Unspecified))))

(: datetime-ticks (-> DateTime long))
(defun (datetime-ticks dt) (clr-datetime-ticks (struct-ref dt v)))

(: ticks->duration (-> long Duration))
(defun (ticks->duration t) (Duration (v (ClrTimeSpan. t))))

(: duration-ticks (-> Duration long))
(defun (duration-ticks d) (clr-timespan-ticks (struct-ref d v)))

(: day-number (-> Date long))
(defun (day-number d) (long-of (clr-date-day-number (struct-ref d v))))

(: day-number->date (-> long Date))
(defun (day-number->date n) (Date (v (clr-date-from-day-number (int-of n)))))

(: valid-date? (-> int int int bool))
(defun (valid-date? y m d)
  (and (>= y 1) (<= y 9999) (>= m 1) (<= m 12) (>= d 1) (<= d (clr-days-in-month y m))))

(: valid-time? (-> int int int int bool))
(defun (valid-time? h m s ns)
  (and (>= h 0) (< h 24) (>= m 0) (< m 60) (>= s 0) (< s 60)
       (>= ns 0) (< ns 1000000000)))

;; Nanoseconds are cut to the 100 ns a tick holds.
(: time-of-day-ticks (-> int int int int long))
(defun (time-of-day-ticks h m s ns)
  (+ (+ (* (long-of h) ticks-per-hour) (* (long-of m) ticks-per-minute))
     (+ (* (long-of s) ticks-per-second) (long-of (/ ns 100)))))

(: date (-> int int int (Option Date)))
(defun (date y m d)
  (if (valid-date? y m d) (Some (Date (v (ClrDate. y m d)))) None))

(: time (-> int int (#:seconds int) (#:nanoseconds int) (Option Time)))
(defun (time h m #:seconds 0 #:nanoseconds 0)
  (if (valid-time? h m seconds nanoseconds)
      (Some (Time (v (ClrTime. (time-of-day-ticks h m seconds nanoseconds)))))
      None))

(: datetime (-> int int int (#:hours int) (#:minutes int) (#:seconds int)
                (#:nanoseconds int) (Option DateTime)))
(defun (datetime y mo d #:hours 0 #:minutes 0 #:seconds 0 #:nanoseconds 0)
  (if (and (valid-date? y mo d) (valid-time? hours minutes seconds nanoseconds))
      (Some (ticks->datetime
              (+ (* (long-of (clr-date-day-number (ClrDate. y mo d))) ticks-per-day)
                 (time-of-day-ticks hours minutes seconds nanoseconds))))
      None))

(: date+time->datetime (-> Date Time DateTime))
(defun (date+time->datetime d t)
  (ticks->datetime (+ (* (day-number d) ticks-per-day) (clr-time-ticks (struct-ref t v)))))

(: duration (-> (#:days long) (#:hours long) (#:minutes long) (#:seconds long)
                (#:milliseconds long) (#:nanoseconds long) Duration))
(defun (duration #:days 0L #:hours 0L #:minutes 0L #:seconds 0L #:milliseconds 0L
                 #:nanoseconds 0L)
  (ticks->duration
    (plus-ticks (plus-ticks (plus-ticks (units->ticks days ticks-per-day)
                                        (units->ticks hours ticks-per-hour))
                            (plus-ticks (units->ticks minutes ticks-per-minute)
                                        (units->ticks seconds ticks-per-second)))
                (plus-ticks (units->ticks milliseconds ticks-per-millisecond)
                            (/ nanoseconds 100L)))))

(: date-period (-> (#:years int) (#:months int) (#:weeks int) (#:days int) DatePeriod))
(defun (date-period #:years 0 #:months 0 #:weeks 0 #:days 0)
  (DatePeriod (years years) (months months) (weeks weeks) (days days)))

(: period (-> (#:years int) (#:months int) (#:weeks int) (#:days int)
              (#:hours long) (#:minutes long) (#:seconds long)
              (#:milliseconds long) (#:nanoseconds long) Period))
(defun (period #:years 0 #:months 0 #:weeks 0 #:days 0
               #:hours 0L #:minutes 0L #:seconds 0L #:milliseconds 0L #:nanoseconds 0L)
  (Period (calendar (DatePeriod (years years) (months months) (weeks weeks) (days days)))
          (exact (duration #:hours hours #:minutes minutes #:seconds seconds
                           #:milliseconds milliseconds #:nanoseconds nanoseconds))))


;; ===========================================================================
;; Traits
;; ===========================================================================

(def/trait (HasDate %a)
  (: ->date (-> %a Date)))

(def/trait (HasTime %a)
  (: ->time (-> %a Time)))

(def/trait (HasInstant %a)
  (: ->instant (-> %a Instant)))

(def/trait (DateArith %a)
  (: +date-period (-> %a DatePeriod %a)))

;; The date of b where a is, which calendar differences compare with a's own:
;; a moment b is first moved into a's zone, so two moments of one instant are
;; the same day wherever they are.
(def/trait (DateDiff %a)
  (: ->date-in-zone-of (-> %a %a Date)))

(def/trait (TimeArith %a)
  (: +duration (-> %a Duration %a)))


;; ===========================================================================
;; Date
;; ===========================================================================

;; Each step is checked before .NET takes it, because DateOnly would throw its
;; own error, and because weeks × 7 overflows an int.
(: plus-years (-> ClrDate int ClrDate))
(defun (plus-years c n)
  (def y (+ (long-of (clr-date-year c)) (long-of n)))
  (cond ((= n 0) c)
        ((and (>= y 1L) (<= y 9999L)) (clr-date-add-years c n))
        (else (calendar-error "a date plus years"))))

;; Months are counted from year 0, so year 1 January is month 12.
(: plus-months (-> ClrDate int ClrDate))
(defun (plus-months c n)
  (def m (+ (+ (* (long-of (clr-date-year c)) 12L) (long-of (- (clr-date-month c) 1)))
            (long-of n)))
  (cond ((= n 0) c)
        ((and (>= m 12L) (<= m 119999L)) (clr-date-add-months c n))
        (else (calendar-error "a date plus months"))))

(: plus-days (-> ClrDate long ClrDate))
(defun (plus-days c n)
  (def dn (+ (long-of (clr-date-day-number c)) n))
  (cond ((= n 0L) c)
        ((and (>= dn 0L) (<= dn max-day-number)) (clr-date-from-day-number (int-of dn)))
        (else (calendar-error "a date plus days"))))

;; Largest unit first: years, then months, then weeks and days together.
(: clr-date-plus-period (-> ClrDate DatePeriod ClrDate))
(defun (clr-date-plus-period c p)
  (plus-days (plus-months (plus-years c (record-ref p years)) (record-ref p months))
             (+ (* (long-of (record-ref p weeks)) 7L) (long-of (record-ref p days)))))

;; This and the other `type+unit` functions are the trait methods at one type.
;; They are exported because the impls' bodies, which importers copy, call
;; them.
(: date+date-period (-> Date DatePeriod Date))
(defun (date+date-period d p) (Date (v (clr-date-plus-period (struct-ref d v) p))))

(impl (HasDate Date)
  (defun (->date d) d))

(impl (DateArith Date)
  (defun (+date-period d p) (date+date-period d p)))

(impl (DateDiff Date)
  (defun (->date-in-zone-of b a) b))

(impl (Ord Date)
  (defun (compare a b)
    (compare (clr-date-day-number (struct-ref a v)) (clr-date-day-number (struct-ref b v)))))

(impl (->str Date)
  (defun (->str d) (date->string (struct-ref d v))))


;; ===========================================================================
;; Time
;; ===========================================================================

(impl (HasTime Time)
  (defun (->time t) t))

;; Wraps at midnight, as TimeOnly.Add does.
(impl (TimeArith Time)
  (defun (+duration t d) (Time (v (clr-time-add (struct-ref t v) (struct-ref d v))))))

(impl (Ord Time)
  (defun (compare a b)
    (compare (clr-time-ticks (struct-ref a v)) (clr-time-ticks (struct-ref b v)))))

(impl (->str Time)
  (defun (->str t) (time-of-day->string (clr-time-ticks (struct-ref t v)))))


;; ===========================================================================
;; DateTime
;; ===========================================================================

(impl (HasDate DateTime)
  (defun (->date dt) (Date (v (clr-date-from-datetime (struct-ref dt v))))))

(impl (HasTime DateTime)
  (defun (->time dt) (Time (v (clr-time-from-datetime (struct-ref dt v))))))

(: datetime+date-period (-> DateTime DatePeriod DateTime))
(defun (datetime+date-period dt p)
  (def t (datetime-ticks dt))
  (def day (clr-date-plus-period (clr-date-from-day-number (int-of (/ t ticks-per-day))) p))
  (ticks->datetime (+ (* (long-of (clr-date-day-number day)) ticks-per-day)
                      (% t ticks-per-day))))

(: datetime+duration (-> DateTime Duration DateTime))
(defun (datetime+duration dt d)
  (ticks->datetime (shift-ticks (datetime-ticks dt) (duration-ticks d)
                                "a datetime plus a duration")))

(impl (DateArith DateTime)
  (defun (+date-period dt p) (datetime+date-period dt p)))

(impl (DateDiff DateTime)
  (defun (->date-in-zone-of b a) (->date b)))

(impl (TimeArith DateTime)
  (defun (+duration dt d) (datetime+duration dt d)))

(impl (Ord DateTime)
  (defun (compare a b) (compare (datetime-ticks a) (datetime-ticks b))))

(impl (->str DateTime)
  (defun (->str dt) (ticks->iso-datetime (datetime-ticks dt))))


;; ===========================================================================
;; Instant
;; ===========================================================================

(: instant-ticks (-> Instant long))
(defun (instant-ticks i) (struct-ref i ticks))

(: ticks->instant (-> long string Instant))
(defun (ticks->instant t what)
  (if (in-calendar? t) (Instant (ticks t)) (calendar-error what)))

(: instant+duration (-> Instant Duration Instant))
(defun (instant+duration i d)
  (Instant (ticks (shift-ticks (instant-ticks i) (duration-ticks d)
                               "an instant plus a duration"))))

(impl (HasInstant Instant)
  (defun (->instant i) i))

(impl (TimeArith Instant)
  (defun (+duration i d) (instant+duration i d)))

(impl (Ord Instant)
  (defun (compare a b) (compare (instant-ticks a) (instant-ticks b))))

(impl (->str Instant)
  (defun (->str i) (ticks->iso-instant (instant-ticks i))))

(: instant->utc-datetime (-> Instant DateTime))
(defun (instant->utc-datetime i) (ticks->datetime (instant-ticks i)))

(: utc-datetime->instant (-> DateTime Instant))
(defun (utc-datetime->instant dt) (Instant (ticks (datetime-ticks dt))))

;; Rounds toward the past, so the second before 1970 is -1 rather than 0.
(: floor-div (-> long long long))
(defun (floor-div a b)
  (def q (/ a b))
  (if (< (% a b) 0L) (- q 1L) q))

(: instant->unix-seconds (-> Instant long))
(defun (instant->unix-seconds i)
  (floor-div (- (instant-ticks i) unix-epoch-ticks) ticks-per-second))

(: instant->unix-milliseconds (-> Instant long))
(defun (instant->unix-milliseconds i)
  (floor-div (- (instant-ticks i) unix-epoch-ticks) ticks-per-millisecond))

;; The bounds are 0001-01-01T00:00Z and the last whole unit of 9999, so the
;; multiplication cannot overflow.
(: unix-seconds->instant (-> long (Option Instant)))
(defun (unix-seconds->instant s)
  (if (and (>= s -62135596800L) (<= s 253402300799L))
      (Some (Instant (ticks (+ (* s ticks-per-second) unix-epoch-ticks))))
      None))

(: unix-milliseconds->instant (-> long (Option Instant)))
(defun (unix-milliseconds->instant ms)
  (if (and (>= ms -62135596800000L) (<= ms 253402300799999L))
      (Some (Instant (ticks (+ (* ms ticks-per-millisecond) unix-epoch-ticks))))
      None))

;; Unix seconds of an instant or a moment, rounded as instant->unix-seconds
;; rounds, which it calls because an importer copies this body.
(: ->unix (-> %a long) (where (HasInstant %a)))
(defun (->unix x) (instant->unix-seconds (->instant x)))


;; ===========================================================================
;; Duration
;; ===========================================================================

;; Checked here rather than by TimeSpan.Add, which lets a sum reach -2^63
;; ticks: the one TimeSpan with no negation, which could not be printed or
;; read back.
(: duration+duration (-> Duration Duration Duration))
(defun (duration+duration a b) (ticks->duration (plus-ticks (duration-ticks a) (duration-ticks b))))

;; (+hours (duration #:minutes 30) 1) is PT1H30M.
(impl (TimeArith Duration)
  (defun (+duration a b) (duration+duration a b)))

(impl (Ord Duration)
  (defun (compare a b) (compare (duration-ticks a) (duration-ticks b))))

(impl (->str Duration)
  (defun (->str d) (duration->iso (duration-ticks d))))

;; Whole units, toward zero.
(: duration->hours (-> Duration long))
(defun (duration->hours d) (/ (duration-ticks d) ticks-per-hour))

(: duration->minutes (-> Duration long))
(defun (duration->minutes d) (/ (duration-ticks d) ticks-per-minute))

(: duration->seconds (-> Duration long))
(defun (duration->seconds d) (/ (duration-ticks d) ticks-per-second))

(: duration->milliseconds (-> Duration long))
(defun (duration->milliseconds d) (/ (duration-ticks d) ticks-per-millisecond))

;; Never raises, as no duration reaches -2^63 ticks.
(: duration-negate (-> Duration Duration))
(defun (duration-negate d) (Duration (v (clr-timespan-negate (struct-ref d v)))))


;; ===========================================================================
;; Periods
;; ===========================================================================

(: date-period-negate (-> DatePeriod DatePeriod))
(defun (date-period-negate p)
  (DatePeriod (years (- (record-ref p years))) (months (- (record-ref p months)))
              (weeks (- (record-ref p weeks))) (days (- (record-ref p days)))))

(impl (->str DatePeriod)
  (defun (->str p) (date-period->string p)))

(impl (->str Period)
  (defun (->str p) (period->string p)))


;; ===========================================================================
;; Accessors and arithmetic
;; ===========================================================================

(: ->datetime (-> %a DateTime) (where (HasDate %a) (HasTime %a)))
(defun (->datetime x) (date+time->datetime (->date x) (->time x)))

(: ->year (-> %a int) (where (HasDate %a)))
(defun (->year x) (clr-date-year (struct-ref (->date x) v)))

(: ->month (-> %a int) (where (HasDate %a)))
(defun (->month x) (clr-date-month (struct-ref (->date x) v)))

(: ->day (-> %a int) (where (HasDate %a)))
(defun (->day x) (clr-date-day (struct-ref (->date x) v)))

;; ISO 8601: 1 is Monday, 7 is Sunday. Day number 0, 0001-01-01, was a Monday.
(: ->weekday (-> %a int) (where (HasDate %a)))
(defun (->weekday x) (+ (% (clr-date-day-number (struct-ref (->date x) v)) 7) 1))

(: ->yday (-> %a int) (where (HasDate %a)))
(defun (->yday x) (clr-date-day-of-year (struct-ref (->date x) v)))

;; ISO 8601 weeks run Monday to Sunday, and a week belongs to the year its
;; Thursday is in, so week 1 holds the year's first Thursday. n - n mod 7 is
;; the Monday, as day number 0 was one. Every date in range has its Thursday
;; in range, since 0001-01-01 was a Monday and 9999-12-31 a Friday.
(: ->week (-> %a int) (where (HasDate %a)))
(defun (->week x)
  (def n (clr-date-day-number (struct-ref (->date x) v)))
  (+ (/ (- (clr-date-day-of-year (clr-date-from-day-number (+ (- n (% n 7)) 3))) 1) 7) 1))

;; The year ->week counts in. It is not always ->year: 2027-01-01 is in week
;; 53 of 2026.
(: ->week-year (-> %a int) (where (HasDate %a)))
(defun (->week-year x)
  (def n (clr-date-day-number (struct-ref (->date x) v)))
  (clr-date-year (clr-date-from-day-number (+ (- n (% n 7)) 3))))

;; 52 or 53. December 28 is always in its year's last week.
(: weeks-in-year (-> int int))
(defun (weeks-in-year y)
  (if (and (>= y 1) (<= y 9999))
      (->week (Date (v (ClrDate. y 12 28))))
      (range-error (str "year " (->str y) " is outside 1 to 9999"))))

;; Day d (1 is Monday) of week w of week-year y. Week 1 starts on the Monday
;; on or before January 4.
(: week-date (-> int int int (Option Date)))
(defun (week-date y w d)
  (if (and (>= y 1) (<= y 9999) (>= w 1) (<= w (weeks-in-year y)) (>= d 1) (<= d 7))
      (let* ((jan4 (long-of (clr-date-day-number (ClrDate. y 1 4))))
             (n (+ (- jan4 (% jan4 7L)) (long-of (+ (* (- w 1) 7) (- d 1))))))
        ;; The last week of 9999 ends in 10000.
        (if (<= n max-day-number) (Some (day-number->date n)) None))
      None))

(: ->hours (-> %a int) (where (HasTime %a)))
(defun (->hours x) (clr-time-hour (struct-ref (->time x) v)))

(: ->minutes (-> %a int) (where (HasTime %a)))
(defun (->minutes x) (clr-time-minute (struct-ref (->time x) v)))

(: ->seconds (-> %a int) (where (HasTime %a)))
(defun (->seconds x) (clr-time-second (struct-ref (->time x) v)))

(: ->milliseconds (-> %a int) (where (HasTime %a)))
(defun (->milliseconds x) (clr-time-millisecond (struct-ref (->time x) v)))

;; The whole fraction of the second, so always a multiple of 100.
(: ->nanoseconds (-> %a int) (where (HasTime %a)))
(defun (->nanoseconds x)
  (def t (struct-ref (->time x) v))
  (+ (* (clr-time-millisecond t) 1000000)
     (+ (* (clr-time-microsecond t) 1000) (clr-time-nanosecond t))))

(: +years (-> %a int %a) (where (DateArith %a)))
(defun (+years x n) (+date-period x (DatePeriod (years n) (months 0) (weeks 0) (days 0))))

(: +months (-> %a int %a) (where (DateArith %a)))
(defun (+months x n) (+date-period x (DatePeriod (years 0) (months n) (weeks 0) (days 0))))

(: +weeks (-> %a int %a) (where (DateArith %a)))
(defun (+weeks x n) (+date-period x (DatePeriod (years 0) (months 0) (weeks n) (days 0))))

(: +days (-> %a int %a) (where (DateArith %a)))
(defun (+days x n) (+date-period x (DatePeriod (years 0) (months 0) (weeks 0) (days n))))

(: -years (-> %a int %a) (where (DateArith %a)))
(defun (-years x n) (+years x (- n)))

(: -months (-> %a int %a) (where (DateArith %a)))
(defun (-months x n) (+months x (- n)))

(: -weeks (-> %a int %a) (where (DateArith %a)))
(defun (-weeks x n) (+weeks x (- n)))

(: -days (-> %a int %a) (where (DateArith %a)))
(defun (-days x n) (+days x (- n)))

(: -date-period (-> %a DatePeriod %a) (where (DateArith %a)))
(defun (-date-period x p)
  (+date-period x (DatePeriod (years (- (record-ref p years))) (months (- (record-ref p months)))
                              (weeks (- (record-ref p weeks))) (days (- (record-ref p days))))))

(: +hours (-> %a long %a) (where (TimeArith %a)))
(defun (+hours x n) (+duration x (duration #:hours n)))

(: +minutes (-> %a long %a) (where (TimeArith %a)))
(defun (+minutes x n) (+duration x (duration #:minutes n)))

(: +seconds (-> %a long %a) (where (TimeArith %a)))
(defun (+seconds x n) (+duration x (duration #:seconds n)))

(: +milliseconds (-> %a long %a) (where (TimeArith %a)))
(defun (+milliseconds x n) (+duration x (duration #:milliseconds n)))

;; Negated after the range check, so long's minimum is refused rather than
;; wrapped back to itself.
(: -hours (-> %a long %a) (where (TimeArith %a)))
(defun (-hours x n) (+duration x (duration-negate (duration #:hours n))))

(: -minutes (-> %a long %a) (where (TimeArith %a)))
(defun (-minutes x n) (+duration x (duration-negate (duration #:minutes n))))

(: -seconds (-> %a long %a) (where (TimeArith %a)))
(defun (-seconds x n) (+duration x (duration-negate (duration #:seconds n))))

(: -milliseconds (-> %a long %a) (where (TimeArith %a)))
(defun (-milliseconds x n) (+duration x (duration-negate (duration #:milliseconds n))))

(: -duration (-> %a Duration %a) (where (TimeArith %a)))
(defun (-duration x d) (+duration x (duration-negate d)))

(: +period (-> %a Period %a) (where (DateArith %a) (TimeArith %a)))
(defun (+period x p)
  (+duration (+date-period x (record-ref p calendar)) (record-ref p exact)))

(: -period (-> %a Period %a) (where (DateArith %a) (TimeArith %a)))
(defun (-period x p)
  (-duration (-date-period x (record-ref p calendar)) (record-ref p exact)))


;; ===========================================================================
;; Differences
;; ===========================================================================

;; Calendar differences read the dates only: 23:00 to 01:00 the next day is
;; one day. Both arguments have one type, and b's date is read where a is.
(: days-between (-> %a %a int) (where (HasDate %a) (DateDiff %a)))
(defun (days-between a b)
  (- (clr-date-day-number (struct-ref (->date-in-zone-of b a) v))
     (clr-date-day-number (struct-ref (->date a) v))))

(: weeks-between (-> %a %a int) (where (HasDate %a) (DateDiff %a)))
(defun (weeks-between a b) (/ (days-between a b) 7))

;; A month counts once the day of the month is reached, as in java.time, so
;; swapping the arguments only flips the sign: 2026-01-31 to 2026-02-28 is 0.
(: months-between (-> %a %a int) (where (HasDate %a) (DateDiff %a)))
(defun (months-between a b)
  (def x (struct-ref (->date a) v))
  (def y (struct-ref (->date-in-zone-of b a) v))
  (def months (- (+ (* (clr-date-year y) 12) (clr-date-month y))
                 (+ (* (clr-date-year x) 12) (clr-date-month x))))
  (def days (- (clr-date-day y) (clr-date-day x)))
  (cond ((and (> months 0) (< days 0)) (- months 1))
        ((and (< months 0) (> days 0)) (+ months 1))
        (else months)))

(: years-between (-> %a %a int) (where (HasDate %a) (DateDiff %a)))
(defun (years-between a b) (/ (months-between a b) 12))

;; The time that passed from a to b, between their instants, so a moment and
;; an instant mix, and a DateTime, which has no instant, does not compile. Two
;; instants are less than 10 000 years apart, so the difference fits.
(: duration-between (-> %a %b Duration) (where (HasInstant %a) (HasInstant %b)))
(defun (duration-between a b)
  (Duration (v (clr-timespan-from-ticks (- (struct-ref (->instant b) ticks)
                                           (struct-ref (->instant a) ticks))))))

(: hours-between (-> %a %b long) (where (HasInstant %a) (HasInstant %b)))
(defun (hours-between a b) (duration->hours (duration-between a b)))

(: minutes-between (-> %a %b long) (where (HasInstant %a) (HasInstant %b)))
(defun (minutes-between a b) (duration->minutes (duration-between a b)))

(: seconds-between (-> %a %b long) (where (HasInstant %a) (HasInstant %b)))
(defun (seconds-between a b) (duration->seconds (duration-between a b)))

(: milliseconds-between (-> %a %b long) (where (HasInstant %a) (HasInstant %b)))
(defun (milliseconds-between a b) (duration->milliseconds (duration-between a b)))


;; ===========================================================================
;; Zones
;; ===========================================================================

(: utc TimeZone)
(def utc (TimeZone (tz clr-tz-utc)))

;; IANA ids only: .NET would also take a Windows id such as "W. Europe
;; Standard Time", which HasIanaId refuses.
(: timezone (-> string (Option TimeZone)))
(defun (timezone id)
  (match (clr-tz-try-find id)
    ((Some z) (if (clr-tz-has-iana-id z) (Some (TimeZone (tz z))) None))
    (None None)))

(: timezone-id (-> TimeZone string))
(defun (timezone-id z) (clr-tz-id (struct-ref z tz)))

(impl (Eq TimeZone)
  (defun (= a b) (= (timezone-id a) (timezone-id b)))
  (defun (eq-hash z) (eq-hash (timezone-id z))))

(impl (->str TimeZone)
  (defun (->str z) (timezone-id z)))

;; The offset in z at the UTC tick count u, in ticks. u is clamped into the
;; calendar, because local-fit looks a day past a local time on the first or
;; last day; no zone changes offset within a day of either end, so the answer
;; is the same.
(: offset-at (-> TimeZoneInfo long long))
(defun (offset-at z u)
  (def clamped (if (< u 0L) 0L (if (> u max-ticks) max-ticks u)))
  (clr-timespan-ticks (clr-tz-utc-offset z (ClrDateTime. clamped DateTimeKind.Utc))))

(: timezone-offset-at (-> TimeZone Instant Duration))
(defun (timezone-offset-at z i) (ticks->duration (offset-at (struct-ref z tz) (instant-ticks i))))

;; Where a local time lands in a zone: at one offset, or two in an overlap
;; (the larger first, since its instant is the earlier), or in a gap between
;; the offset before and the offset after.
(type (: Fit (Union (: Fits long long) (: Skipped long long))))

(: member-long? (-> long (List long) bool))
(defun (member-long? x xs)
  (and (not (list-empty? xs))
       (or (= x (list-head xs)) (member-long? x (list-tail xs)))))

;; An offset o fits the local tick count l when the zone has offset o at the
;; instant l - o. The candidates are the offsets a day either side of l, which
;; is every offset in reach while a zone changes offset at most once in 48 h:
;; the tz database's closest two changes are 95 h apart. When a lookup answers
;; with a third offset it becomes a candidate too, which catches most layouts
;; with two changes in 48 h, but not all.
(: local-fit (-> TimeZoneInfo long Fit))
(defun (local-fit z l)
  (def before (offset-at z (- l ticks-per-day)))
  (def after (offset-at z (+ l ticks-per-day)))
  (def at-before (offset-at z (- l before)))
  (if (and (= before after) (= at-before before))
      (Fits before before)
      (let* ((at-after (offset-at z (- l after)))
             (candidates (list-foldl (fun (o seen) (if (member-long? o seen) seen (Cons o seen)))
                                     '() (list before after at-before at-after)))
             (fits (list-filter (fun (o) (= (offset-at z (- l o)) o)) candidates)))
        (if (list-empty? fits)
            (Skipped before at-before)
            (Fits (list-foldl max (list-head fits) fits) (list-foldl min (list-head fits) fits))))))

;; The first instant at offset `after`, by bisection between an instant still
;; before the change and one after it.
(: change-ticks (-> TimeZoneInfo long long long long))
(defun (change-ticks z lo hi after)
  (if (<= (- hi lo) 1L)
      hi
      (let ((mid (+ lo (/ (- hi lo) 2L))))
        (if (= (offset-at z mid) after)
            (change-ticks z lo mid after)
            (change-ticks z mid hi after)))))


;; ===========================================================================
;; Moments
;; ===========================================================================

(: moment-local-ticks (-> Moment long))
(defun (moment-local-ticks m) (datetime-ticks (struct-ref m local)))

(: moment-offset-ticks (-> Moment long))
(defun (moment-offset-ticks m) (duration-ticks (struct-ref m offset)))

(: moment-instant-ticks (-> Moment long))
(defun (moment-instant-ticks m) (- (moment-local-ticks m) (moment-offset-ticks m)))

;; A moment from a local time and an offset that fits it. Near either end of
;; the calendar the instant can fall outside it: 0001-01-01T00:00 in Tokyo is
;; the day before.
(: fitted-moment (-> long long TimeZone Moment))
(defun (fitted-moment l o z)
  (if (in-calendar? (- l o))
      (Moment (local (ticks->datetime l)) (offset (ticks->duration o)) (zone z))
      (calendar-error "the instant of a local time")))

(: instant->moment (-> Instant TimeZone Moment))
(defun (instant->moment i z)
  (def u (instant-ticks i))
  (def o (offset-at (struct-ref z tz) u))
  (if (in-calendar? (+ u o))
      (Moment (local (ticks->datetime (+ u o))) (offset (ticks->duration o)) (zone z))
      (calendar-error "the local time of an instant")))

(: resolver (-> Gap Overlap Resolver))
(defun (resolver g o) (Resolver (gap g) (overlap o)))

;; GapPush moves the local time forward by the length of the gap: the instant
;; it names at the offset before the gap, read at the offset after it.
(: resolve-local (-> long TimeZone Resolver Moment))
(defun (resolve-local l z r)
  (match (local-fit (struct-ref z tz) l)
    ((Fits earlier later)
     (fitted-moment l (match (record-ref r overlap)
                        (OverlapEarlier earlier)
                        (OverlapLater later))
                    z))
    ((Skipped before after)
     (match (record-ref r gap)
       (GapPush (instant->moment (ticks->instant (- l before) "the instant of a local time") z))
       (GapNextValid
        (instant->moment (Instant (ticks (change-ticks (struct-ref z tz) (- l after) (- l before) after)))
                         z))))))

(: datetime->moment (-> DateTime TimeZone Resolver Moment))
(defun (datetime->moment dt z r) (resolve-local (datetime-ticks dt) z r))

(: datetime->moment/opt (-> DateTime TimeZone (Option Moment)))
(defun (datetime->moment/opt dt z)
  (def l (datetime-ticks dt))
  (match (local-fit (struct-ref z tz) l)
    ((Fits earlier later)
     (if (and (= earlier later) (in-calendar? (- l earlier)))
         (Some (Moment (local dt) (offset (ticks->duration earlier)) (zone z)))
         None))
    (_ None)))

(: +date-period/resolver (-> Moment DatePeriod Resolver Moment))
(defun (+date-period/resolver m p r)
  (datetime->moment (datetime+date-period (struct-ref m local) p) (struct-ref m zone) r))

(: -date-period/resolver (-> Moment DatePeriod Resolver Moment))
(defun (-date-period/resolver m p r) (+date-period/resolver m (date-period-negate p) r))

;; Date arithmetic on a moment keeps its offset through an overlap if that
;; offset still fits, takes the earlier one if not, and pushes forward through
;; a gap.
(: moment+date-period (-> Moment DatePeriod Moment))
(defun (moment+date-period m p)
  (def l (datetime-ticks (datetime+date-period (struct-ref m local) p)))
  (def z (struct-ref m zone))
  (def kept (moment-offset-ticks m))
  (match (local-fit (struct-ref z tz) l)
    ((Fits earlier later)
     (fitted-moment l (if (or (= kept earlier) (= kept later)) kept earlier) z))
    ((Skipped before after)
     (instant->moment (ticks->instant (- l before) "the instant of a local time") z))))

(: ->utc-offset (-> Moment Duration))
(defun (->utc-offset m) (struct-ref m offset))

(: ->timezone (-> Moment TimeZone))
(defun (->timezone m) (struct-ref m zone))

(: adjust-timezone (-> Moment TimeZone Moment))
(defun (adjust-timezone m z)
  (instant->moment (Instant (ticks (moment-instant-ticks m))) z))

;; Exact: through the instant, and back into the same zone.
(: moment+duration (-> Moment Duration Moment))
(defun (moment+duration m d)
  (instant->moment
    (Instant (ticks (shift-ticks (moment-instant-ticks m) (duration-ticks d)
                                 "a moment plus a duration")))
    (struct-ref m zone)))

(impl (HasDate Moment)
  (defun (->date m) (->date (struct-ref m local))))

(impl (HasTime Moment)
  (defun (->time m) (->time (struct-ref m local))))

(impl (HasInstant Moment)
  (defun (->instant m)
    (Instant (ticks (- (clr-datetime-ticks (struct-ref (struct-ref m local) v))
                       (clr-timespan-ticks (struct-ref (struct-ref m offset) v)))))))

(impl (DateArith Moment)
  (defun (+date-period m p) (moment+date-period m p)))

;; Near either end of the calendar, the move can raise as instant->moment does.
(impl (DateDiff Moment)
  (defun (->date-in-zone-of b a)
    (if (= (->timezone b) (->timezone a))
        (->date b)
        (->date (adjust-timezone b (->timezone a))))))

(impl (TimeArith Moment)
  (defun (+duration m d) (moment+duration m d)))

;; Every field, so 12:00+02:00[Europe/Stockholm] and 10:00+00:00[UTC] are two
;; values although they are one instant.
(impl (Eq Moment)
  (defun (= a b)
    (and (= (moment-local-ticks a) (moment-local-ticks b))
         (= (moment-offset-ticks a) (moment-offset-ticks b))
         (= (struct-ref a zone) (struct-ref b zone))))
  (defun (eq-hash m)
    (hash-combine (eq-hash (moment-local-ticks m))
                  (hash-combine (eq-hash (moment-offset-ticks m)) (eq-hash (struct-ref m zone))))))

;; By instant, then local time, then zone id, so that compare is 0 exactly
;; when = holds.
(impl (Ord Moment)
  (defun (compare a b)
    (def by-instant (compare (moment-instant-ticks a) (moment-instant-ticks b)))
    (def by-local (compare (moment-local-ticks a) (moment-local-ticks b)))
    (cond ((not (= by-instant 0)) by-instant)
          ((not (= by-local 0)) by-local)
          (else (compare (timezone-id (struct-ref a zone)) (timezone-id (struct-ref b zone)))))))

(impl (->str Moment)
  (defun (->str m) (moment->string m)))

(impl (->str Gap)
  (defun (->str g) (match g (GapPush "GapPush") (GapNextValid "GapNextValid"))))

(impl (->str Overlap)
  (defun (->str o) (match o (OverlapEarlier "OverlapEarlier") (OverlapLater "OverlapLater"))))

(impl (->str Resolver)
  (defun (->str r)
    (str "(resolver " (->str (record-ref r gap)) " " (->str (record-ref r overlap)) ")")))


;; ===========================================================================
;; The clock
;; ===========================================================================

;; The functions that read the time take #:clock, defaulting to the value of
;; the prelude's current-clock at the call, so a program that binds the
;; parameter changes no call site. They are the only functions here that are
;; not pure.

(: zone-reader (-> TimeZone (-> TimeZoneInfo)))
(defun (zone-reader z)
  (def info (struct-ref z tz))
  (fun () info))

;; c, with today in z.
(: clock-in (-> Clock TimeZone Clock))
(defun (clock-in c z) (record-set c (read-zone (zone-reader z))))

;; The system's time in zone z, so that a program on a machine set to UTC can
;; bind current-clock once and have (today) be z's date everywhere.
(: system-clock-in (-> TimeZone Clock))
(defun (system-clock-in z) (clock-in system-clock z))

;; Always the same instant. Its monotonic reading stands still too.
(: fixed-clock (-> Instant TimeZone Clock))
(defun (fixed-clock i z)
  (def t (instant-ticks i))
  (make-clock #:monotonic-ms (fun () 0L)
              #:utc-ticks (fun () t)
              #:zone (zone-reader z)))

(: locked (-> ClrLock (-> %a) %a))
(defun (locked lock body)
  (clr-lock-enter lock)
  (try (body) #:finally (clr-lock-exit lock)))

;; Stands still until clock-advance! moves it. Read and written under its lock,
;; so fibers on other threads may share one: an advance is whole, and visible
;; to the next read.
;;
;; The monotonic reading starts at 0 and moves only on a positive advance, so a
;; step back of the wall clock never makes an elapsed time negative.
(: manual-clock (-> Instant TimeZone Clock))
(defun (manual-clock i z)
  (def wall (make-box i))
  (def mono (make-box 0L))
  (def lock (ClrLock.))
  (make-clock
    #:monotonic-ms (fun () (/ (locked lock (fun () (box-ref mono))) ticks-per-millisecond))
    #:utc-ticks (fun () (instant-ticks (locked lock (fun () (box-ref wall)))))
    #:zone (zone-reader z)
    #:advance (Some (fun (t)
                      (clr-lock-enter lock)
                      (try (let ()
                             (box-set! wall (instant+duration (box-ref wall) (ticks->duration t)))
                             (when (> t 0L) (box-set! mono (+ (box-ref mono) t))))
                        #:finally (clr-lock-exit lock))))))

;; A negative duration steps the clock back, as a corrected wall clock does.
(: clock-advance! (-> Clock Duration void))
(defun (clock-advance! c d)
  (match (record-ref c advance-ticks)
    ((Some advance) (advance (duration-ticks d)))
    (None (raise (cast Exception
                       (ArgumentException.
                         "(std datetime): clock-advance! moves a clock made with #:advance, as a manual clock is, and this one has none."))))))

(: clock-timezone (-> (#:clock Clock) TimeZone))
(defun (clock-timezone #:clock (parameter-ref current-clock))
  (TimeZone (tz ((record-ref clock read-zone)))))

(: now (-> (#:clock Clock) Instant))
(defun (now #:clock (parameter-ref current-clock))
  (ticks->instant ((record-ref clock read-utc-ticks)) "a clock's reading"))

(: now/moment (-> (#:clock Clock) (#:tz TimeZone) Moment))
(defun (now/moment #:clock (parameter-ref current-clock) #:tz (clock-timezone #:clock clock))
  (instant->moment (now #:clock clock) tz))

(: today (-> (#:clock Clock) (#:tz TimeZone) Date))
(defun (today #:clock (parameter-ref current-clock) #:tz (clock-timezone #:clock clock))
  (->date (now/moment #:clock clock #:tz tz)))


;; ===========================================================================
;; Writing ISO 8601
;; ===========================================================================
;;
;; A writer appends to one StringBuilder sized for its text, a digit at a time,
;; so writing a value allocates the builder and the string, not a string per
;; field.

(: new-text (-> int TextBuilder))
(defun (new-text capacity) (TextBuilder. capacity))

(: text-of (-> TextBuilder string))
(defun (text-of sb) (clr-builder-text sb))

(: add-text! (-> TextBuilder string void))
(defun (add-text! sb s) (ignore (clr-add-text sb s)))

(: add-digit! (-> TextBuilder long void))
(defun (add-digit! sb d) (ignore (clr-add-unit sb (cast System.Char (+ 48 (int-of d))))))

;; The number of decimal digits in n >= 0, 0 having one.
(: digit-count (-> long int))
(defun (digit-count n) (if (< n 10L) 1 (+ 1 (digit-count (/ n 10L)))))

;; The largest power of ten not above n >= 0, or 1.
(: top-power (-> long long))
(defun (top-power n) (if (< n 10L) 1L (* 10L (top-power (/ n 10L)))))

;; n >= 0 in decimal, with zeros in front up to width digits.
(: add-padded! (-> TextBuilder long int void))
(defun (add-padded! sb n width)
  (let zeros ((k (digit-count n)))
    (when (< k width)
      (add-digit! sb 0L)
      (zeros (+ k 1))))
  (let digits ((p (top-power n)))
    (when (> p 0L)
      (add-digit! sb (% (/ n p) 10L))
      (digits (/ p 10L)))))

(: add-date! (-> TextBuilder ClrDate void))
(defun (add-date! sb c)
  (add-padded! sb (long-of (clr-date-year c)) 4)
  (add-text! sb "-")
  (add-padded! sb (long-of (clr-date-month c)) 2)
  (add-text! sb "-")
  (add-padded! sb (long-of (clr-date-day c)) 2))

;; ".5" for half a second: up to seven digits, without trailing zeros, and
;; nothing for a whole second.
(: add-fraction! (-> TextBuilder long void))
(defun (add-fraction! sb f)
  (unless (= f 0L)
    (let loop ((f f) (width 7))
      (if (= (% f 10L) 0L)
          (loop (/ f 10L) (- width 1))
          (begin
            (add-text! sb ".")
            (add-padded! sb f width))))))

;; hh:mm:ss of a tick count within a day.
(: add-clock! (-> TextBuilder long void))
(defun (add-clock! sb t)
  (add-padded! sb (/ t ticks-per-hour) 2)
  (add-text! sb ":")
  (add-padded! sb (% (/ t ticks-per-minute) 60L) 2)
  (add-text! sb ":")
  (add-padded! sb (% (/ t ticks-per-second) 60L) 2))

(: add-time-of-day! (-> TextBuilder long void))
(defun (add-time-of-day! sb t)
  (add-clock! sb t)
  (add-fraction! sb (% t ticks-per-second)))

(: add-datetime! (-> TextBuilder long void))
(defun (add-datetime! sb t)
  (add-date! sb (clr-date-from-day-number (int-of (/ t ticks-per-day))))
  (add-text! sb "T")
  (add-time-of-day! sb (% t ticks-per-day)))

;; ±hh:mm, and :ss when there are seconds.
(: add-offset! (-> TextBuilder long void))
(defun (add-offset! sb o)
  (def a (abs o))
  (def s (% (/ a ticks-per-second) 60L))
  (add-text! sb (if (< o 0L) "-" "+"))
  (add-padded! sb (/ a ticks-per-hour) 2)
  (add-text! sb ":")
  (add-padded! sb (% (/ a ticks-per-minute) 60L) 2)
  (unless (= s 0L)
    (add-text! sb ":")
    (add-padded! sb s 2)))

(: date->string (-> ClrDate string))
(defun (date->string c)
  (def sb (new-text 10))
  (add-date! sb c)
  (text-of sb))

(: time-of-day->string (-> long string))
(defun (time-of-day->string t)
  (def sb (new-text 16))
  (add-time-of-day! sb t)
  (text-of sb))

(: ticks->iso-datetime (-> long string))
(defun (ticks->iso-datetime t)
  (def sb (new-text 27))
  (add-datetime! sb t)
  (text-of sb))

(: ticks->iso-instant (-> long string))
(defun (ticks->iso-instant t)
  (def sb (new-text 28))
  (add-datetime! sb t)
  (add-text! sb "Z")
  (text-of sb))

;; 38 characters hold the longest local time and offset, and the brackets.
(: moment->string (-> Moment string))
(defun (moment->string m)
  (def id (timezone-id (struct-ref m zone)))
  (def sb (new-text (+ 38 (string-length id))))
  (add-datetime! sb (moment-local-ticks m))
  (add-offset! sb (moment-offset-ticks m))
  (add-text! sb "[")
  (add-text! sb id)
  (add-text! sb "]")
  (text-of sb))

;; n and its unit, with a minus when n is negative, and nothing for 0.
(: add-amount! (-> TextBuilder long string void))
(defun (add-amount! sb n unit)
  (unless (= n 0L)
    (when (< n 0L) (add-text! sb "-"))
    (add-padded! sb (abs n) 1)
    (add-text! sb unit)))

;; The time components of a non-negative tick count, each prefixed by sign.
(: add-time-parts! (-> TextBuilder long string void))
(defun (add-time-parts! sb a sign)
  (def h (/ a ticks-per-hour))
  (def m (% (/ a ticks-per-minute) 60L))
  (def s (% (/ a ticks-per-second) 60L))
  (def f (% a ticks-per-second))
  (unless (= h 0L)
    (add-text! sb sign)
    (add-padded! sb h 1)
    (add-text! sb "H"))
  (unless (= m 0L)
    (add-text! sb sign)
    (add-padded! sb m 1)
    (add-text! sb "M"))
  (unless (and (= s 0L) (= f 0L))
    (add-text! sb sign)
    (add-padded! sb s 1)
    (add-fraction! sb f)
    (add-text! sb "S")))

;; PT26H30M, with one leading sign: -PT1H30M.
(: duration->iso (-> long string))
(defun (duration->iso t)
  (if (= t 0L)
      "PT0S"
      (let ((sb (new-text 32)))
        (when (< t 0L) (add-text! sb "-"))
        (add-text! sb "PT")
        (add-time-parts! sb (abs t) "")
        (text-of sb))))

;; Each component carries its own sign, since a period may mix them: P1M-3D.
(: add-date-parts! (-> TextBuilder DatePeriod void))
(defun (add-date-parts! sb p)
  (add-amount! sb (long-of (record-ref p years)) "Y")
  (add-amount! sb (long-of (record-ref p months)) "M")
  (add-amount! sb (long-of (record-ref p weeks)) "W")
  (add-amount! sb (long-of (record-ref p days)) "D"))

(: date-period-zero? (-> DatePeriod bool))
(defun (date-period-zero? p)
  (and (= (record-ref p years) 0) (= (record-ref p months) 0)
       (= (record-ref p weeks) 0) (= (record-ref p days) 0)))

(: date-period->string (-> DatePeriod string))
(defun (date-period->string p)
  (if (date-period-zero? p)
      "P0D"
      (let ((sb (new-text 48)))
        (add-text! sb "P")
        (add-date-parts! sb p)
        (text-of sb))))

;; P1DT3H. A negative exact part signs each of its components: P1DT-3H.
(: period->string (-> Period string))
(defun (period->string p)
  (def dates (record-ref p calendar))
  (def t (duration-ticks (record-ref p exact)))
  (if (and (date-period-zero? dates) (= t 0L))
      "P0D"
      (let ((sb (new-text 80)))
        (add-text! sb "P")
        (add-date-parts! sb dates)
        (unless (= t 0L)
          (add-text! sb "T")
          (add-time-parts! sb (abs t) (if (< t 0L) "-" "")))
        (text-of sb))))


;; ===========================================================================
;; Reading ISO 8601
;; ===========================================================================
;;
;; Each reader takes the string and a cursor into it, and answers what it read
;; with the cursor after it, or None. Option and Tuple are structs, so reading
;; allocates nothing but a moment's zone id. Only the extended format is read
;; (2026-10-25T02:30:00, not 20261025T023000), with an upper-case T and Z.

(: ascii-digit (-> char int))
(defun (ascii-digit c)
  (def n (char->int c))
  (if (and (>= n 48) (<= n 57)) (- n 48) -1))

(: next-digit (-> string StringCursor int))
(defun (next-digit s c)
  (if (string-cursor-end? s c) -1 (ascii-digit (string-cursor-ref s c))))

(: starts-with-char? (-> string StringCursor char bool))
(defun (starts-with-char? s c ch)
  (and (not (string-cursor-end? s c)) (char=? (string-cursor-ref s c) ch)))

(: skip-char (-> string StringCursor char (Option StringCursor)))
(defun (skip-char s c ch)
  (if (starts-with-char? s c ch) (Some (string-cursor-next s c)) None))

;; Exactly n digits.
(: read-fixed (-> string StringCursor int (Option (Tuple int StringCursor))))
(defun (read-fixed s c n)
  (let loop ((c c) (left n) (acc 0))
    (def d (next-digit s c))
    (cond ((= left 0) (Some (Tuple acc c)))
          ((< d 0) None)
          (else (loop (string-cursor-next s c) (- left 1) (+ (* acc 10) d))))))

;; One or more digits, or None past long's range.
(: read-number (-> string StringCursor (Option (Tuple long StringCursor))))
(defun (read-number s c)
  (let loop ((c c) (count 0) (acc 0L))
    (def d (long-of (next-digit s c)))
    (cond ((< d 0L) (if (= count 0) None (Some (Tuple acc c))))
          ((> acc (/ (- long-max d) 10L)) None)
          (else (loop (string-cursor-next s c) (+ count 1) (+ (* acc 10L) d))))))

;; The digits after a decimal point or comma, as ticks. Digits past the
;; seventh are read and dropped, as a tick holds no less than 100 ns.
(: read-fraction (-> string StringCursor (Option (Tuple long StringCursor))))
(defun (read-fraction s c)
  (let loop ((c c) (count 0) (acc 0L))
    (def d (long-of (next-digit s c)))
    (cond ((>= d 0L)
           (loop (string-cursor-next s c) (+ count 1) (if (< count 7) (+ (* acc 10L) d) acc)))
          ((= count 0) None)
          (else (Some (Tuple (scale-fraction acc count) c))))))

(: scale-fraction (-> long int long))
(defun (scale-fraction f digits)
  (if (>= digits 7) f (scale-fraction (* f 10L) (+ digits 1))))

;; An optional fraction: nothing, or a separator and at least one digit.
(: read-optional-fraction (-> string StringCursor (Option (Tuple long StringCursor))))
(defun (read-optional-fraction s c)
  (if (or (starts-with-char? s c #\.) (starts-with-char? s c #\,))
      (read-fraction s (string-cursor-next s c))
      (Some (Tuple 0L c))))

;; YYYY-MM-DD, as a day number.
(: read-date (-> string StringCursor (Option (Tuple long StringCursor))))
(defun (read-date s c)
  (def* ((Some (Tuple y c1)) (read-fixed s c 4) :propagate)
        ((Some c2) (skip-char s c1 #\-) :propagate)
        ((Some (Tuple m c3)) (read-fixed s c2 2) :propagate)
        ((Some c4) (skip-char s c3 #\-) :propagate)
        ((Some (Tuple d c5)) (read-fixed s c4 2) :propagate))
  (if (valid-date? y m d)
      (Some (Tuple (long-of (clr-date-day-number (ClrDate. y m d))) c5))
      None))

;; hh:mm, hh:mm:ss or hh:mm:ss.fff, as ticks since midnight. No leap second.
(: read-time (-> string StringCursor (Option (Tuple long StringCursor))))
(defun (read-time s c)
  (def* ((Some (Tuple h c1)) (read-fixed s c 2) :propagate)
        ((Some c2) (skip-char s c1 #\:) :propagate)
        ((Some (Tuple m c3)) (read-fixed s c2 2) :propagate))
  (cond ((not (and (< h 24) (< m 60))) None)
        ((not (starts-with-char? s c3 #\:)) (Some (Tuple (time-of-day-ticks h m 0 0) c3)))
        (:def (Some (Tuple sec c4)) (read-fixed s (string-cursor-next s c3) 2) :propagate)
        (:def (Some (Tuple f c5)) (read-optional-fraction s c4) :propagate)
        ((>= sec 60) None)
        (else (Some (Tuple (+ (time-of-day-ticks h m sec 0) f) c5)))))

;; A date, T, and a time, as local ticks.
(: read-datetime (-> string StringCursor (Option (Tuple long StringCursor))))
(defun (read-datetime s c)
  (def* ((Some (Tuple day c1)) (read-date s c) :propagate)
        ((Some c2) (skip-char s c1 #\T) :propagate)
        ((Some (Tuple t c3)) (read-time s c2) :propagate))
  (Some (Tuple (+ (* day ticks-per-day) t) c3)))

;; Z, or ±hh:mm with an optional :ss, as ticks.
(: read-offset (-> string StringCursor (Option (Tuple long StringCursor))))
(defun (read-offset s c)
  (cond ((starts-with-char? s c #\Z) (Some (Tuple 0L (string-cursor-next s c))))
        ((starts-with-char? s c #\+) (read-hhmm s (string-cursor-next s c) 1L))
        ((starts-with-char? s c #\-) (read-hhmm s (string-cursor-next s c) -1L))
        (else None)))

(: read-hhmm (-> string StringCursor long (Option (Tuple long StringCursor))))
(defun (read-hhmm s c sign)
  (def* ((Some (Tuple h c1)) (read-fixed s c 2) :propagate)
        ((Some c2) (skip-char s c1 #\:) :propagate)
        ((Some (Tuple m c3)) (read-fixed s c2 2) :propagate))
  (cond ((not (and (< h 24) (< m 60))) None)
        ((not (starts-with-char? s c3 #\:))
         (Some (Tuple (* sign (time-of-day-ticks h m 0 0)) c3)))
        (:def (Some (Tuple sec c4)) (read-fixed s (string-cursor-next s c3) 2) :propagate)
        ((>= sec 60) None)
        (else (Some (Tuple (* sign (time-of-day-ticks h m sec 0)) c4)))))

;; The text up to the character ch, and the cursor after ch.
(: read-until (-> string StringCursor char (Option (Tuple string StringCursor))))
(defun (read-until s c ch)
  (let loop ((e c))
    (cond ((string-cursor-end? s e) None)
          ((char=? (string-cursor-ref s e) ch)
           (Some (Tuple (substring s c e) (string-cursor-next s e))))
          (else (loop (string-cursor-next s e))))))

;; A reader's value when it read to the end of s.
(: whole (-> string (Option (Tuple %a StringCursor)) (Option %a)))
(defun (whole s r)
  (match r
    ((Some (Tuple v rest)) (if (string-cursor-end? s rest) (Some v) None))
    (None None)))

(: iso8601->date (-> string (Option Date)))
(defun (iso8601->date s)
  (def (Some day) (whole s (read-date s (string-cursor-start s))) :propagate)
  (Some (day-number->date day)))

(: iso8601->time (-> string (Option Time)))
(defun (iso8601->time s)
  (def (Some t) (whole s (read-time s (string-cursor-start s))) :propagate)
  (Some (Time (v (ClrTime. t)))))

(: iso8601->datetime (-> string (Option DateTime)))
(defun (iso8601->datetime s)
  (def (Some t) (whole s (read-datetime s (string-cursor-start s))) :propagate)
  (Some (ticks->datetime t)))

;; Any offset, converted to UTC.
(: iso8601->instant (-> string (Option Instant)))
(defun (iso8601->instant s)
  (def* ((Some (Tuple l c)) (read-datetime s (string-cursor-start s)) :propagate)
        ((Some o) (whole s (read-offset s c)) :propagate))
  (if (in-calendar? (- l o)) (Some (Instant (ticks (- l o)))) None))

;; The offset has to be one the zone has at that local time, so an overlap
;; reads either way and a gap reads neither.
(: iso8601->moment (-> string (Option Moment)))
(defun (iso8601->moment s)
  (def* ((Some (Tuple l c1)) (read-datetime s (string-cursor-start s)) :propagate)
        ((Some (Tuple o c2)) (read-offset s c1) :propagate)
        ((Some c3) (skip-char s c2 #\[) :propagate)
        ((Some id) (whole s (read-until s c3 #\])) :propagate)
        ((Some z) (timezone id) :propagate))
  (if (and (in-calendar? (- l o)) (= (offset-at (struct-ref z tz) (- l o)) o))
      (Some (Moment (local (ticks->datetime l)) (offset (ticks->duration o)) (zone z)))
      None))

;; An optional sign: -1 for a minus, 1 otherwise.
(: read-sign (-> string StringCursor (Tuple long StringCursor)))
(defun (read-sign s c)
  (cond ((starts-with-char? s c #\-) (Tuple -1L (string-cursor-next s c)))
        ((starts-with-char? s c #\+) (Tuple 1L (string-cursor-next s c)))
        (else (Tuple 1L c))))

;; A unit's place in P1Y2M3W4D, or -1.
(: date-unit (-> string StringCursor int))
(defun (date-unit s c)
  (cond ((starts-with-char? s c #\Y) 0)
        ((starts-with-char? s c #\M) 1)
        ((starts-with-char? s c #\W) 2)
        ((starts-with-char? s c #\D) 3)
        (else -1)))

;; A unit's place in T1H2M3S, or -1.
(: time-unit (-> string StringCursor int))
(defun (time-unit s c)
  (cond ((starts-with-char? s c #\H) 0)
        ((starts-with-char? s c #\M) 1)
        ((starts-with-char? s c #\S) 2)
        (else -1)))

;; The date components of a period, each optional and in the order Y M W D,
;; each with its own sign, which multiplies with the period's. Stops at T or
;; at the end. next is the place of the first unit still allowed.
(: read-date-parts (-> string StringCursor long (Option (Tuple (Tuple DatePeriod int) StringCursor))))
(defun (read-date-parts s c sign)
  (let loop ((c c) (next 0) (p (date-period)) (count 0))
    (if (or (string-cursor-end? s c) (starts-with-char? s c #\T))
        (Some (Tuple (Tuple p count) c))
        (let ((signed (read-sign s c)))
          (def (Tuple own c1) signed)
          (def (Some (Tuple n c2)) (read-number s c1) :propagate)
          (def value (* (* sign own) n))
          (def unit (date-unit s c2))
          (if (or (< unit next) (> value 2147483647L) (< value -2147483648L))
              None
              (loop (string-cursor-next s c2) (+ unit 1)
                    (set-date-part p unit (int-of value)) (+ count 1)))))))

(: set-date-part (-> DatePeriod int int DatePeriod))
(defun (set-date-part p unit n)
  (cond ((= unit 0) (record-set p (years n)))
        ((= unit 1) (record-set p (months n)))
        ((= unit 2) (record-set p (weeks n)))
        (else (record-set p (days n)))))

;; The time components after T, in the order H M S, as ticks. Only seconds
;; take a fraction.
(: read-time-parts (-> string StringCursor long (Option (Tuple (Tuple long int) StringCursor))))
(defun (read-time-parts s c sign)
  (let loop ((c c) (next 0) (total 0L) (count 0))
    (if (string-cursor-end? s c)
        (Some (Tuple (Tuple total count) c))
        (let ((signed (read-sign s c)))
          (def (Tuple own c1) signed)
          (def* ((Some (Tuple n c2)) (read-number s c1) :propagate)
                ((Some (Tuple f c3)) (read-optional-fraction s c2) :propagate))
          (def unit (time-unit s c3))
          (def per (cond ((= unit 0) ticks-per-hour)
                         ((= unit 1) ticks-per-minute)
                         (else ticks-per-second)))
          (cond ((< unit next) None)
                ((and (> f 0L) (not (= unit 2))) None)
                (:def (Some whole-ticks) (checked-mul n per) :propagate)
                (:def (Some magnitude) (checked-add whole-ticks f) :propagate)
                (:def (Some sum) (checked-add total (* (* sign own) magnitude)) :propagate)
                (else (loop (string-cursor-next s c3) (+ unit 1) sum (+ count 1))))))))

;; [sign] P [date parts] [T time parts]: the date period, the ticks, and
;; whether each part was there. A struct, so reading one allocates nothing.
(type (: PeriodText (Struct (: dates DatePeriod) (: date-count int)
                            (: ticks long) (: time-count int) (: has-t bool))))

(: read-period-text (-> string (Option PeriodText)))
(defun (read-period-text s)
  (def (Tuple sign c0) (read-sign s (string-cursor-start s)))
  (def* ((Some c1) (skip-char s c0 #\P) :propagate)
        ((Some (Tuple (Tuple dates date-count) c2)) (read-date-parts s c1 sign) :propagate))
  (if (string-cursor-end? s c2)
      (Some (PeriodText (dates dates) (date-count date-count) (ticks 0L) (time-count 0)
                        (has-t #f)))
      (let ((after-t (string-cursor-next s c2)))
        (def (Some (Tuple (Tuple t time-count) c3)) (read-time-parts s after-t sign) :propagate)
        (Some (PeriodText (dates dates) (date-count date-count) (ticks t)
                          (time-count time-count) (has-t #t))))))

;; PT26H30M. Days are a calendar amount, so P1D is not a duration.
(: iso8601->duration (-> string (Option Duration)))
(defun (iso8601->duration s)
  (def (Some p) (read-period-text s) :propagate)
  (if (and (= (record-ref p date-count) 0) (> (record-ref p time-count) 0))
      (Some (ticks->duration (record-ref p ticks)))
      None))

(: iso8601->date-period (-> string (Option DatePeriod)))
(defun (iso8601->date-period s)
  (def (Some p) (read-period-text s) :propagate)
  (if (and (> (record-ref p date-count) 0) (not (record-ref p has-t)))
      (Some (record-ref p dates))
      None))

;; P1DT3H. A T needs a time part after it.
(: iso8601->period (-> string (Option Period)))
(defun (iso8601->period s)
  (def (Some p) (read-period-text s) :propagate)
  (if (and (> (+ (record-ref p date-count) (record-ref p time-count)) 0)
           (or (not (record-ref p has-t)) (> (record-ref p time-count) 0)))
      (Some (Period (calendar (record-ref p dates)) (exact (ticks->duration (record-ref p ticks)))))
      None))


;; ===========================================================================
;; HTTP dates
;; ===========================================================================
;;
;; IMF-fixdate (RFC 9110): Sun, 25 Oct 2026 01:30:00 GMT. The two obsolete
;; forms, RFC 850 and asctime, are not read.

;; Numbered as ->weekday numbers them.
(: day-name (-> int string))
(defun (day-name n)
  (match n (1 "Mon") (2 "Tue") (3 "Wed") (4 "Thu") (5 "Fri") (6 "Sat") (_ "Sun")))

(: month-name (-> int string))
(defun (month-name n)
  (match n
    (1 "Jan") (2 "Feb") (3 "Mar") (4 "Apr") (5 "May") (6 "Jun")
    (7 "Jul") (8 "Aug") (9 "Sep") (10 "Oct") (11 "Nov") (_ "Dec")))

;; The fraction of a second is dropped, as the format has none.
(: instant->http-date (-> Instant string))
(defun (instant->http-date i)
  (def t (instant-ticks i))
  (def d (day-number->date (/ t ticks-per-day)))
  (def c (struct-ref d v))
  (def sb (new-text 29))
  (add-text! sb (day-name (->weekday d)))
  (add-text! sb ", ")
  (add-padded! sb (long-of (clr-date-day c)) 2)
  (add-text! sb " ")
  (add-text! sb (month-name (clr-date-month c)))
  (add-text! sb " ")
  (add-padded! sb (long-of (clr-date-year c)) 4)
  (add-text! sb " ")
  (add-clock! sb (% t ticks-per-day))
  (add-text! sb " GMT")
  (text-of sb))

;; The cursor n characters on, or None when s ends first.
(: skip-chars (-> string StringCursor int (Option StringCursor)))
(defun (skip-chars s c n)
  (cond ((= n 0) (Some c))
        ((string-cursor-end? s c) None)
        (else (skip-chars s (string-cursor-next s c) (- n 1)))))

;; The cursor after the text want, when s has it at c.
(: skip-string (-> string StringCursor string (Option StringCursor)))
(defun (skip-string s c want)
  (let loop ((c c) (w (string-cursor-start want)))
    (cond ((string-cursor-end? want w) (Some c))
          ((starts-with-char? s c (string-cursor-ref want w))
           (loop (string-cursor-next s c) (string-cursor-next want w)))
          (else None))))

;; A month's name, as its number.
(: read-month (-> string StringCursor (Option (Tuple int StringCursor))))
(defun (read-month s c)
  (let loop ((m 1))
    (if (> m 12)
        None
        (match (skip-string s c (month-name m))
          ((Some after) (Some (Tuple m after)))
          (None (loop (+ m 1)))))))

;; The day name must be the date's own, so it is checked once the date is read.
(: http-date->instant (-> string (Option Instant)))
(defun (http-date->instant s)
  (def c0 (string-cursor-start s))
  (def* ((Some c1) (skip-chars s c0 3) :propagate)
        ((Some c2) (skip-string s c1 ", ") :propagate)
        ((Some (Tuple d c3)) (read-fixed s c2 2) :propagate)
        ((Some c4) (skip-char s c3 #\space) :propagate)
        ((Some (Tuple m c5)) (read-month s c4) :propagate)
        ((Some c6) (skip-char s c5 #\space) :propagate)
        ((Some (Tuple y c7)) (read-fixed s c6 4) :propagate)
        ((Some c8) (skip-char s c7 #\space) :propagate)
        ((Some (Tuple h c9)) (read-fixed s c8 2) :propagate)
        ((Some c10) (skip-char s c9 #\:) :propagate)
        ((Some (Tuple mi c11)) (read-fixed s c10 2) :propagate)
        ((Some c12) (skip-char s c11 #\:) :propagate)
        ((Some (Tuple sec c13)) (read-fixed s c12 2) :propagate)
        ((Some c14) (skip-string s c13 " GMT") :propagate))
  (if (and (string-cursor-end? s c14) (valid-date? y m d) (valid-time? h mi sec 0))
      (let ((day (long-of (clr-date-day-number (ClrDate. y m d)))))
        (if (some? (skip-string s c0 (day-name (->weekday (day-number->date day)))))
            (Some (Instant (ticks (+ (* day ticks-per-day) (time-of-day-ticks h mi sec 0)))))
            None))
      None))


;; ===========================================================================
;; Text of your own
;; ===========================================================================
;;
;; A format is a quoted list, which elaborates into the parts below: a tag
;; names a field, and a string or a character is written as it is.
;;
;;   (date->text d '((year 4) "-" (month 2) "-" (day 2)))      ;; 2026-03-05
;;
;; A number after a field's name is a width, filled with zeros. There is one
;; union per kind of value, so a format that asks a date for its hours is a
;; type error where it is written.

;; The numbers of a date.
(type (: DateNumber (Union (: NumYear (List int) #:tag year #:rest)
                           (: NumMonth (List int) #:tag month #:rest)
                           (: NumDay (List int) #:tag day #:rest)
                           (: NumWeekday (List int) #:tag weekday #:rest)
                           (: NumYday (List int) #:tag yday #:rest)
                           (: NumWeek (List int) #:tag week #:rest)
                           (: NumWeekYear (List int) #:tag week-year #:rest))))

;; What (roman ...) writes. No width, as a numeral has no zeros to fill with.
(type (: RomanNumber (Union (: RomanYear #:tag year) (: RomanMonth #:tag month) (: RomanDay #:tag day))))

;; A date's numbers, through DateNumber's tags, and its names, from a
;; DateNames.
(type (: DatePart (Union (: DateNum DateNumber)
                         (: DateRoman RomanNumber #:tag roman)
                         (: MonthName #:tag month-name)
                         (: MonthAbbr #:tag month-abbr)
                         (: WeekdayName #:tag weekday-name)
                         (: WeekdayAbbr #:tag weekday-abbr)
                         (: DateText string)
                         (: DateChar char))))

;; (fraction n) is n digits of the second's fraction, cut rather than rounded,
;; with zeros past the seventh. A bare fraction is ISO 8601's, point included:
;; .5, and nothing for a whole second.
(type (: TimePart (Union (: TimeHours (List int) #:tag hours #:rest)
                         (: TimeHours12 (List int) #:tag hours12 #:rest)
                         (: TimeMinutes (List int) #:tag minutes #:rest)
                         (: TimeSeconds (List int) #:tag seconds #:rest)
                         (: TimeFraction (List int) #:tag fraction #:rest)
                         (: TimeAmPm #:tag am-pm)
                         (: TimeText string)
                         (: TimeChar char))))

;; The tags of both, found through the two unions.
(type (: DateTimePart (Union (: DateTimeDate DatePart)
                             (: DateTimeTime TimePart)
                             (: DateTimeText string)
                             (: DateTimeChar char))))

;; A date and a time, the offset as ISO 8601 writes it (+02:00), the zone's
;; id, and the Unix time in seconds or milliseconds, rounded toward the past.
(type (: MomentPart (Union (: MomentDateTime DateTimePart)
                           (: MomentOffset #:tag offset)
                           (: MomentZone #:tag zone)
                           (: MomentUnix #:tag unix)
                           (: MomentUnixMs #:tag unix-ms)
                           (: MomentText string)
                           (: MomentChar char))))

;; A date and a time in UTC, whose offset is written Z, and the Unix time.
(type (: InstantPart (Union (: InstantDateTime DateTimePart)
                            (: InstantOffset #:tag offset)
                            (: InstantUnix #:tag unix)
                            (: InstantUnixMs #:tag unix-ms)
                            (: InstantText string)
                            (: InstantChar char))))

;; Twelve months from January and seven weekdays from Monday, and what am-pm
;; writes. A table of other lengths raises when a name is taken from it.
(type (: DateNames (Struct (: months (Vec string)) (: months-short (Vec string))
                           (: weekdays (Vec string)) (: weekdays-short (Vec string))
                           (: am string) (: pm string))))

(: english-names DateNames)
(def english-names
  (DateNames (months ["January" "February" "March" "April" "May" "June" "July"
                      "August" "September" "October" "November" "December"])
             (months-short ["Jan" "Feb" "Mar" "Apr" "May" "Jun" "Jul" "Aug" "Sep" "Oct"
                            "Nov" "Dec"])
             (weekdays ["Monday" "Tuesday" "Wednesday" "Thursday" "Friday" "Saturday"
                        "Sunday"])
             (weekdays-short ["Mon" "Tue" "Wed" "Thu" "Fri" "Sat" "Sun"])
             (am "AM")
             (pm "PM")))

(: swedish-names DateNames)
(def swedish-names
  (DateNames (months ["januari" "februari" "mars" "april" "maj" "juni" "juli"
                      "augusti" "september" "oktober" "november" "december"])
             (months-short ["jan" "feb" "mar" "apr" "maj" "jun" "jul" "aug" "sep" "okt"
                            "nov" "dec"])
             (weekdays ["måndag" "tisdag" "onsdag" "torsdag" "fredag" "lördag" "söndag"])
             (weekdays-short ["mån" "tis" "ons" "tor" "fre" "lör" "sön"])
             (am "fm")
             (pm "em")))

;; After english-names, which is its first value.
(: current-date-names (Param DateNames))
(def current-date-names (make-parameter english-names))

(: argument-error (-> string %a))
(defun (argument-error what)
  (raise (cast Exception (ArgumentException. (str "(std datetime): " what)))))

;; The width a part was written with, 0 for none.
(: part-width (-> (List int) string int))
(defun (part-width ws tag)
  (cond ((list-empty? ws) 0)
        ((list-empty? (list-tail ws)) (list-head ws))
        (else (argument-error (str "(" tag " ...) takes one width, and was given "
                                   (->str (list-length ws)) ".")))))

;; A table of names, which must have count of them.
(: full-table (-> (Vec string) int string (Vec string)))
(defun (full-table names count what)
  (if (= (vec-length names) count)
      names
      (argument-error (str "a DateNames has " (->str count) " " what ", and this one has "
                           (->str (vec-length names)) "."))))

;; The i:th name, counting from 1, of a table that must have count of them.
(: name-at (-> (Vec string) int int string string))
(defun (name-at names count i what) (vec-ref (full-table names count what) (- i 1)))

;; MMXXVI. Numerals stop at MMMCMXCIX, and a larger year goes on adding Ms,
;; 4000 being MMMM, since nothing else is standard.
(: roman-steps (List (Tuple int string)))
(def roman-steps
  (list (Tuple 1000 "M") (Tuple 900 "CM") (Tuple 500 "D") (Tuple 400 "CD")
        (Tuple 100 "C") (Tuple 90 "XC") (Tuple 50 "L") (Tuple 40 "XL")
        (Tuple 10 "X") (Tuple 9 "IX") (Tuple 5 "V") (Tuple 4 "IV") (Tuple 1 "I")))

(: add-roman! (-> TextBuilder int void))
(defun (add-roman! sb n)
  (let loop ((n n) (steps roman-steps))
    (unless (list-empty? steps)
      (match (list-head steps)
        ((Tuple value numeral)
         (if (>= n value)
             (begin
               (add-text! sb numeral)
               (loop (- n value) steps))
             (loop n (list-tail steps))))))))

;; The first n digits of a second's fraction f, in ticks: cut, not rounded,
;; and zeros past the seventh.
(: add-fraction-digits! (-> TextBuilder long int void))
(defun (add-fraction-digits! sb f n)
  (let loop ((i 0) (scale 1000000L))
    (when (< i n)
      (add-digit! sb (if (> scale 0L) (% (/ f scale) 10L) 0L))
      (loop (+ i 1) (/ scale 10L)))))

(: add-date-number! (-> TextBuilder Date DateNumber void))
(defun (add-date-number! sb d n)
  (match n
    ((NumYear w) (add-padded! sb (long-of (->year d)) (part-width w "year")))
    ((NumMonth w) (add-padded! sb (long-of (->month d)) (part-width w "month")))
    ((NumDay w) (add-padded! sb (long-of (->day d)) (part-width w "day")))
    ((NumWeekday w) (add-padded! sb (long-of (->weekday d)) (part-width w "weekday")))
    ((NumYday w) (add-padded! sb (long-of (->yday d)) (part-width w "yday")))
    ((NumWeek w) (add-padded! sb (long-of (->week d)) (part-width w "week")))
    ((NumWeekYear w) (add-padded! sb (long-of (->week-year d)) (part-width w "week-year")))))

(: add-date-part! (-> TextBuilder Date DateNames DatePart void))
(defun (add-date-part! sb d names p)
  (match p
    ((DateNum n) (add-date-number! sb d n))
    ((DateRoman RomanYear) (add-roman! sb (->year d)))
    ((DateRoman RomanMonth) (add-roman! sb (->month d)))
    ((DateRoman RomanDay) (add-roman! sb (->day d)))
    (MonthName (add-text! sb (name-at (record-ref names months) 12 (->month d) "months")))
    (MonthAbbr (add-text! sb (name-at (record-ref names months-short) 12 (->month d) "months")))
    (WeekdayName (add-text! sb (name-at (record-ref names weekdays) 7 (->weekday d) "weekdays")))
    (WeekdayAbbr
     (add-text! sb (name-at (record-ref names weekdays-short) 7 (->weekday d) "weekdays")))
    ((DateText s) (add-text! sb s))
    ((DateChar c) (add-text! sb (char->string c)))))

;; t is the ticks since midnight.
(: add-time-part! (-> TextBuilder long DateNames TimePart void))
(defun (add-time-part! sb t names p)
  (def h (/ t ticks-per-hour))
  (match p
    ((TimeHours w) (add-padded! sb h (part-width w "hours")))
    ((TimeHours12 w) (add-padded! sb (if (= (% h 12L) 0L) 12L (% h 12L)) (part-width w "hours12")))
    ((TimeMinutes w) (add-padded! sb (% (/ t ticks-per-minute) 60L) (part-width w "minutes")))
    ((TimeSeconds w) (add-padded! sb (% (/ t ticks-per-second) 60L) (part-width w "seconds")))
    ((TimeFraction w)
     (if (list-empty? w)
         (add-fraction! sb (% t ticks-per-second))
         (add-fraction-digits! sb (% t ticks-per-second) (part-width w "fraction"))))
    (TimeAmPm (add-text! sb (if (< h 12L) (record-ref names am) (record-ref names pm))))
    ((TimeText s) (add-text! sb s))
    ((TimeChar c) (add-text! sb (char->string c)))))

;; t is local ticks.
(: add-datetime-part! (-> TextBuilder long DateNames DateTimePart void))
(defun (add-datetime-part! sb t names p)
  (match p
    ((DateTimeDate dp) (add-date-part! sb (day-number->date (/ t ticks-per-day)) names dp))
    ((DateTimeTime tp) (add-time-part! sb (% t ticks-per-day) names tp))
    ((DateTimeText s) (add-text! sb s))
    ((DateTimeChar c) (add-text! sb (char->string c)))))

;; n in decimal, with a minus when it is negative.
(: add-signed! (-> TextBuilder long void))
(defun (add-signed! sb n)
  (when (< n 0L) (add-text! sb "-"))
  (add-padded! sb (abs n) 1))

(: add-moment-part! (-> TextBuilder Moment DateNames MomentPart void))
(defun (add-moment-part! sb m names p)
  (match p
    ((MomentDateTime dtp) (add-datetime-part! sb (moment-local-ticks m) names dtp))
    (MomentOffset (add-offset! sb (moment-offset-ticks m)))
    (MomentZone (add-text! sb (timezone-id (struct-ref m zone))))
    (MomentUnix
     (add-signed! sb (instant->unix-seconds (Instant (ticks (moment-instant-ticks m))))))
    (MomentUnixMs
     (add-signed! sb (instant->unix-milliseconds (Instant (ticks (moment-instant-ticks m))))))
    ((MomentText s) (add-text! sb s))
    ((MomentChar c) (add-text! sb (char->string c)))))

(: add-instant-part! (-> TextBuilder Instant DateNames InstantPart void))
(defun (add-instant-part! sb i names p)
  (match p
    ((InstantDateTime dtp) (add-datetime-part! sb (instant-ticks i) names dtp))
    (InstantOffset (add-text! sb "Z"))
    (InstantUnix (add-signed! sb (instant->unix-seconds i)))
    (InstantUnixMs (add-signed! sb (instant->unix-milliseconds i)))
    ((InstantText s) (add-text! sb s))
    ((InstantChar c) (add-text! sb (char->string c)))))

;; One function per type rather than one over the traits, so a moment's date
;; is written with (date->text (->date m) ...), which says whose date it is.
(: date->text (-> Date (List DatePart) (#:names DateNames) string))
(defun (date->text d parts #:names (parameter-ref current-date-names))
  (def sb (new-text 32))
  (let loop ((ps parts))
    (unless (list-empty? ps)
      (add-date-part! sb d names (list-head ps))
      (loop (list-tail ps))))
  (text-of sb))

(: time->text (-> Time (List TimePart) (#:names DateNames) string))
(defun (time->text t parts #:names (parameter-ref current-date-names))
  (def sb (new-text 32))
  (let loop ((ps parts))
    (unless (list-empty? ps)
      (add-time-part! sb (clr-time-ticks (struct-ref t v)) names (list-head ps))
      (loop (list-tail ps))))
  (text-of sb))

(: datetime->text (-> DateTime (List DateTimePart) (#:names DateNames) string))
(defun (datetime->text dt parts #:names (parameter-ref current-date-names))
  (def sb (new-text 48))
  (let loop ((ps parts))
    (unless (list-empty? ps)
      (add-datetime-part! sb (datetime-ticks dt) names (list-head ps))
      (loop (list-tail ps))))
  (text-of sb))

(: moment->text (-> Moment (List MomentPart) (#:names DateNames) string))
(defun (moment->text m parts #:names (parameter-ref current-date-names))
  (def sb (new-text 64))
  (let loop ((ps parts))
    (unless (list-empty? ps)
      (add-moment-part! sb m names (list-head ps))
      (loop (list-tail ps))))
  (text-of sb))

;; The date and time are UTC's, so the format that writes a moment's local
;; time writes the instant as ->str does.
(: instant->text (-> Instant (List InstantPart) (#:names DateNames) string))
(defun (instant->text i parts #:names (parameter-ref current-date-names))
  (def sb (new-text 48))
  (let loop ((ps parts))
    (unless (list-empty? ps)
      (add-instant-part! sb i names (list-head ps))
      (loop (list-tail ps))))
  (text-of sb))


;; ===========================================================================
;; Reading text of your own
;; ===========================================================================
;;
;; A reader sees each part of a format as a Field, whichever union it came
;; from, so one reader serves every format. It checks the format first, so a
;; format that cannot be read raises whatever the text, and then walks the
;; text: the parts in order, and the whole text used. The fields read so far
;; are kept in a Seen, a struct, and put together at the end, so reading
;; allocates nothing but a zone id.

;; What a part reads. A match on it tests its arms in order, so text,
;; characters and the common fields come first where that matters.
(type (: FieldKind (Union FText FChar
                          FYear FMonth FDay FWeekday FYday FWeek FWeekYear
                          FRomanYear FRomanMonth FRomanDay
                          FMonthName FMonthAbbr FWeekdayName FWeekdayAbbr
                          FHours FHours12 FMinutes FSeconds FFraction FAmPm
                          FOffset FZone FUnix FUnixMs)))

;; A part as a reader sees it: its width, 0 for none; the most digits it
;; reads, 0 when it is not a number; and its text or character when it is
;; one. A bare fraction, which can be nothing at all, has the width -1, so
;; that it is told apart from (fraction 0). The functions that make a Field
;; know its kind, so they say its most digits, and no reader asks again.
(type (: Field (Struct (: kind FieldKind) (: width int) (: most int) (: text string) (: ch char))))

(: field (-> FieldKind int Field))
(defun (field k w) (Field (kind k) (width w) (most 0) (text "") (ch #\nul)))

(: number-field (-> FieldKind int int Field))
(defun (number-field k most w) (Field (kind k) (width w) (most most) (text "") (ch #\nul)))

(: text-field (-> string Field))
(defun (text-field s) (Field (kind FText) (width 0) (most 0) (text s) (ch #\nul)))

(: char-field (-> char Field))
(defun (char-field c) (Field (kind FChar) (width 0) (most 0) (text "") (ch c)))

(: date-number-field (-> DateNumber Field))
(defun (date-number-field n)
  (match n
    ((NumYear w) (number-field FYear 4 (part-width w "year")))
    ((NumMonth w) (number-field FMonth 2 (part-width w "month")))
    ((NumDay w) (number-field FDay 2 (part-width w "day")))
    ((NumWeekday w) (number-field FWeekday 1 (part-width w "weekday")))
    ((NumYday w) (number-field FYday 3 (part-width w "yday")))
    ((NumWeek w) (number-field FWeek 2 (part-width w "week")))
    ((NumWeekYear w) (number-field FWeekYear 4 (part-width w "week-year")))))

(: date-part-field (-> DatePart Field))
(defun (date-part-field p)
  (match p
    ((DateText s) (text-field s))
    ((DateChar c) (char-field c))
    ((DateNum n) (date-number-field n))
    ((DateRoman RomanYear) (field FRomanYear 0))
    ((DateRoman RomanMonth) (field FRomanMonth 0))
    ((DateRoman RomanDay) (field FRomanDay 0))
    (MonthName (field FMonthName 0))
    (MonthAbbr (field FMonthAbbr 0))
    (WeekdayName (field FWeekdayName 0))
    (WeekdayAbbr (field FWeekdayAbbr 0))))

(: time-part-field (-> TimePart Field))
(defun (time-part-field p)
  (match p
    ((TimeText s) (text-field s))
    ((TimeChar c) (char-field c))
    ((TimeHours w) (number-field FHours 2 (part-width w "hours")))
    ((TimeHours12 w) (number-field FHours12 2 (part-width w "hours12")))
    ((TimeMinutes w) (number-field FMinutes 2 (part-width w "minutes")))
    ((TimeSeconds w) (number-field FSeconds 2 (part-width w "seconds")))
    ((TimeFraction w)
     (field FFraction (if (list-empty? w) -1 (max (part-width w "fraction") 0))))
    (TimeAmPm (field FAmPm 0))))

(: datetime-part-field (-> DateTimePart Field))
(defun (datetime-part-field p)
  (match p
    ((DateTimeText s) (text-field s))
    ((DateTimeChar c) (char-field c))
    ((DateTimeDate dp) (date-part-field dp))
    ((DateTimeTime tp) (time-part-field tp))))

(: moment-part-field (-> MomentPart Field))
(defun (moment-part-field p)
  (match p
    ((MomentText s) (text-field s))
    ((MomentChar c) (char-field c))
    ((MomentDateTime dtp) (datetime-part-field dtp))
    (MomentOffset (field FOffset 0))
    (MomentZone (field FZone 0))
    (MomentUnix (field FUnix 0))
    (MomentUnixMs (field FUnixMs 0))))

(: instant-part-field (-> InstantPart Field))
(defun (instant-part-field p)
  (match p
    ((InstantText s) (text-field s))
    ((InstantChar c) (char-field c))
    ((InstantDateTime dtp) (datetime-part-field dtp))
    (InstantOffset (field FOffset 0))
    (InstantUnix (field FUnix 0))
    (InstantUnixMs (field FUnixMs 0))))

;; Each format union's parts as Fields, text first, as separators are the
;; most common part. A trait rather than a function argument, so that each
;; reader is compiled for its own union.
(def/trait (FormatPart %p)
  (: part-field (-> %p Field)))

(impl (FormatPart DatePart)
  (defun (part-field p) (date-part-field p)))

(impl (FormatPart TimePart)
  (defun (part-field p) (time-part-field p)))

(impl (FormatPart DateTimePart)
  (defun (part-field p) (datetime-part-field p)))

(impl (FormatPart MomentPart)
  (defun (part-field p) (moment-part-field p)))

(impl (FormatPart InstantPart)
  (defun (part-field p) (instant-part-field p)))

(: with-width (-> string int string))
(defun (with-width name w) (if (> w 0) (str "(" name " " (->str w) ")") name))

;; A part as a format writes it, for a message.
(: field-name (-> Field string))
(defun (field-name f)
  (def w (struct-ref f width))
  (match (struct-ref f kind)
    (FText (str "the text \"" (struct-ref f text) "\""))
    (FChar (str "the character " (char->string (struct-ref f ch))))
    (FYear (with-width "year" w))
    (FMonth (with-width "month" w))
    (FDay (with-width "day" w))
    (FWeekday (with-width "weekday" w))
    (FYday (with-width "yday" w))
    (FWeek (with-width "week" w))
    (FWeekYear (with-width "week-year" w))
    (FRomanYear "(roman year)")
    (FRomanMonth "(roman month)")
    (FRomanDay "(roman day)")
    (FMonthName "month-name")
    (FMonthAbbr "month-abbr")
    (FWeekdayName "weekday-name")
    (FWeekdayAbbr "weekday-abbr")
    (FHours (with-width "hours" w))
    (FHours12 (with-width "hours12" w))
    (FMinutes (with-width "minutes" w))
    (FSeconds (with-width "seconds" w))
    (FFraction (if (< w 0) "fraction" (str "(fraction " (->str w) ")")))
    (FAmPm "am-pm")
    (FOffset "offset")
    (FZone "zone")
    (FUnix "unix")
    (FUnixMs "unix-ms")))

;; The kinds of field a format has, one bit per kind that the checks below
;; tell apart.
(: b-year int)
(def b-year 1)
;; month, day and yday, by number, numeral or name: the fields within a year.
(: b-in-year int)
(def b-in-year 2)
(: b-week-year int)
(def b-week-year 4)
(: b-week int)
(def b-week 8)
(: b-weekday int)
(def b-weekday 16)
(: b-hours int)
(def b-hours 32)
(: b-hours12 int)
(def b-hours12 64)
(: b-am-pm int)
(def b-am-pm 128)
;; minutes, seconds and the fraction: the fields within an hour.
(: b-in-hour int)
(def b-in-hour 256)
(: b-offset int)
(def b-offset 512)
(: b-zone int)
(def b-zone 1024)
(: b-unix int)
(def b-unix 2048)
(: b-unix-ms int)
(def b-unix-ms 4096)

(: field-bits (-> FieldKind int))
(defun (field-bits k)
  (match k
    (FText 0)
    (FChar 0)
    (FYear b-year)
    (FRomanYear b-year)
    (FMonth b-in-year)
    (FDay b-in-year)
    (FYday b-in-year)
    (FRomanMonth b-in-year)
    (FRomanDay b-in-year)
    (FMonthName b-in-year)
    (FMonthAbbr b-in-year)
    (FWeekYear b-week-year)
    (FWeek b-week)
    (FWeekday b-weekday)
    (FWeekdayName b-weekday)
    (FWeekdayAbbr b-weekday)
    (FHours b-hours)
    (FHours12 b-hours12)
    (FAmPm b-am-pm)
    (FMinutes b-in-hour)
    (FSeconds b-in-hour)
    (FFraction b-in-hour)
    (FOffset b-offset)
    (FZone b-zone)
    (FUnix b-unix)
    (FUnixMs b-unix-ms)))

(: has? (-> int int bool))
(defun (has? bits b) (> (bitwise-and bits b) 0))

;; The characters a part can go on taking once it has begun, as bits: a
;; part of one fixed length takes none.
(: t-digits int)
(def t-digits 1)
(: t-roman int)
(def t-roman 2)
;; A decimal point or comma, which a bare fraction may begin with.
(: t-point int)
(def t-point 4)
;; The characters of an IANA id.
(: t-zone int)
(def t-zone 8)
;; The colon before an offset's seconds.
(: t-colon int)
(def t-colon 16)

(: roman-value (-> char int))
(defun (roman-value c)
  (cond ((char=? c #\I) 1)
        ((char=? c #\V) 5)
        ((char=? c #\X) 10)
        ((char=? c #\L) 50)
        ((char=? c #\C) 100)
        ((char=? c #\D) 500)
        ((char=? c #\M) 1000)
        (else 0)))

;; ASCII letters and digits, and / _ - +, as in Etc/GMT+5 and
;; America/Port-au-Prince.
(: zone-char? (-> char bool))
(defun (zone-char? c)
  (def n (char->int c))
  (or (and (>= n 65) (<= n 90)) (and (>= n 97) (<= n 122)) (and (>= n 48) (<= n 57))
      (= n 47) (= n 95) (= n 45) (= n 43)))

(: takes? (-> int char bool))
(defun (takes? taken c)
  (or (and (has? taken t-digits) (>= (ascii-digit c) 0))
      (and (has? taken t-roman) (> (roman-value c) 0))
      (and (has? taken t-point) (or (char=? c #\.) (char=? c #\,)))
      (and (has? taken t-zone) (zone-char? c))
      (and (has? taken t-colon) (char=? c #\:))))

;; A number reads from its width, or 1, up to its most digits or its width,
;; so it has one length only when its width is at least its most. A bare
;; fraction is nothing, or a point and as many digits as there are, and an
;; offset may have seconds after a colon.
(: field-takes (-> Field int))
(defun (field-takes f)
  (def k (struct-ref f kind))
  (def w (struct-ref f width))
  (def most (struct-ref f most))
  (if (> most 0)
      (if (< (max w 1) most) t-digits 0)
      (match k
        (FText 0)
        (FChar 0)
        (FRomanYear t-roman)
        (FRomanMonth t-roman)
        (FRomanDay t-roman)
        (FFraction (if (< w 0) (bitwise-ior t-digits t-point) 0))
        (FOffset t-colon)
        (FZone t-zone)
        (FUnix t-digits)
        (FUnixMs t-digits)
        (_ 0))))

(: can-be-empty? (-> Field bool))
(defun (can-be-empty? f)
  (match (struct-ref f kind)
    (FText (string-empty? (struct-ref f text)))
    (FFraction (<= (struct-ref f width) 0))
    (_ #f)))

(: first-char (-> string char))
(defun (first-char s) (string-cursor-ref s (string-cursor-start s)))

(: name-starts? (-> string int bool))
(defun (name-starts? name taken)
  (and (not (string-empty? name)) (takes? taken (first-char name))))

(: any-name-starts? (-> (Vec string) int bool))
(defun (any-name-starts? table taken)
  (let loop ((i 0))
    (and (< i (vec-length table))
         (or (name-starts? (vec-ref table i) taken) (loop (+ i 1))))))

;; The table a name reads from, which must be whole.
(: name-table (-> DateNames FieldKind (Vec string)))
(defun (name-table names k)
  (match k
    (FMonthName (full-table (record-ref names months) 12 "months"))
    (FMonthAbbr (full-table (record-ref names months-short) 12 "months"))
    (FWeekdayName (full-table (record-ref names weekdays) 7 "weekdays"))
    (_ (full-table (record-ref names weekdays-short) 7 "weekdays"))))

(: name-kind? (-> FieldKind bool))
(defun (name-kind? k)
  (match k
    (FText #f)
    (FChar #f)
    (FMonthName #t)
    (FMonthAbbr #t)
    (FWeekdayName #t)
    (FWeekdayAbbr #t)
    (_ #f)))

;; Whether a part can begin with a character in taken. Digits, Roman
;; letters and the letters an id begins with are each one class, so one of
;; them stands for all: M is a Roman letter and begins MST.
(: starts-within? (-> Field DateNames int bool))
(defun (starts-within? f names taken)
  (def k (struct-ref f kind))
  (def w (struct-ref f width))
  (cond ((> (struct-ref f most) 0) (takes? taken #\0))
        ((name-kind? k) (any-name-starts? (name-table names k) taken))
        (else
         (match k
           (FText (name-starts? (struct-ref f text) taken))
           (FChar (takes? taken (struct-ref f ch)))
           (FRomanYear (takes? taken #\M))
           (FRomanMonth (takes? taken #\M))
           (FRomanDay (takes? taken #\M))
           (FFraction (cond ((< w 0) (or (takes? taken #\.) (takes? taken #\,)))
                            ((> w 0) (takes? taken #\0))
                            (else #f)))
           (FAmPm (or (name-starts? (record-ref names am) taken)
                      (name-starts? (record-ref names pm) taken)))
           (FOffset (or (takes? taken #\Z) (takes? taken #\+) (takes? taken #\-)))
           (FZone (takes? taken #\M))
           (FUnix (or (takes? taken #\-) (takes? taken #\0)))
           (FUnixMs (or (takes? taken #\-) (takes? taken #\0)))
           (_ #f)))))

(: two-readings-error (-> Field Field %a))
(defun (two-readings-error before after)
  (def most (struct-ref before most))
  (argument-error
    (str (field-name before) " can be of more than one length, and " (field-name after)
         " after it can begin with a character " (field-name before)
         " could also take, so a text could be read two ways. "
         (if (> most 0)
             (str "A width of " (->str most) ", or text between the two, reads one way.")
             "Text between the two reads one way."))))

;; The kinds of field a format has, as bits, once it is known that no text
;; can be read with it two ways: no part that can be of more than one length
;; is followed by a part that can begin with a character it could also take.
;; A part that can be empty passes what could be taken on to the next.
(: format-bits (-> (List %p) DateNames int) (where (FormatPart %p)))
(defun (format-bits parts names)
  (let loop ((ps parts) (bits 0) (taken 0) (before (text-field "")))
    (if (list-empty? ps)
        bits
        (let ((f (part-field (list-head ps))))
          (def k (struct-ref f kind))
          (when (name-kind? k) (ignore (name-table names k)))
          (when (and (> taken 0) (starts-within? f names taken))
            (two-readings-error before f))
          (def own (field-takes f))
          (loop (list-tail ps)
                (bitwise-ior bits (field-bits k))
                (if (can-be-empty? f) (bitwise-ior taken own) own)
                (if (> own 0) f before))))))

;; An offset or a Unix time not read, which no reading can be.
(: no-ticks long)
(def no-ticks -9223372036854775808L)

;; The fields read so far, each -1 until it is read, or no-ticks for those
;; in ticks. pm is 0 for the morning's word and 1 for the afternoon's, the
;; fraction is in ticks, read to fraction-digits digits, and unix is the
;; instant's UTC ticks, from either kind of Unix time. The zone is the span of
;; text its id was read from, empty until then, and is looked up once at the
;; end. So a Seen holds no reference, and .NET need not clear every copy of
;; it a function might make each time the function is called.
(type (: Seen (Struct (: year int) (: month int) (: day int) (: weekday int) (: yday int)
                      (: week int) (: week-year int)
                      (: hours int) (: hours12 int) (: pm int) (: minutes int) (: seconds int)
                      (: fraction long) (: fraction-digits int)
                      (: offset long) (: unix long)
                      (: zone-start StringCursor) (: zone-end StringCursor))))

(: unseen Seen)
(def unseen
  (Seen (year -1) (month -1) (day -1) (weekday -1) (yday -1) (week -1) (week-year -1)
        (hours -1) (hours12 -1) (pm -1) (minutes -1) (seconds -1)
        (fraction -1L) (fraction-digits 0)
        (offset no-ticks) (unix no-ticks)
        (zone-start (string-cursor-start "")) (zone-end (string-cursor-start ""))))

;; From least to most ASCII digits, as many as there are. The value stops
;; growing at eighteen digits, which no field reaches.
(: read-digits (-> string StringCursor int int (Option (Tuple long StringCursor))))
(defun (read-digits s c least most)
  (let loop ((c c) (count 0) (acc 0L))
    (def d (next-digit s c))
    (if (or (= count most) (< d 0))
        (if (>= count least) (Some (Tuple acc c)) None)
        (loop (string-cursor-next s c) (+ count 1)
              (if (>= acc 100000000000000000L) acc (+ (* acc 10L) (long-of d)))))))

;; Exactly n digits of a second's fraction, as ticks. Digits past the
;; seventh are read and dropped, as a tick holds no less than 100 ns.
(: read-fraction-digits (-> string StringCursor int (Option (Tuple long StringCursor))))
(defun (read-fraction-digits s c n)
  (let loop ((c c) (i 0) (acc 0L))
    (def d (next-digit s c))
    (cond ((= i n) (Some (Tuple (scale-fraction acc (min n 7)) c)))
          ((< d 0) None)
          (else (loop (string-cursor-next s c) (+ i 1)
                      (if (< i 7) (+ (* acc 10L) (long-of d)) acc))))))

;; The cursor after n's numeral as add-roman! writes it, when s has it at c.
(: skip-roman (-> string StringCursor int (Option StringCursor)))
(defun (skip-roman s c n)
  (let loop ((c c) (n n) (steps roman-steps))
    (if (list-empty? steps)
        (Some c)
        (match (list-head steps)
          ((Tuple value numeral)
           (cond ((< n value) (loop c n (list-tail steps)))
                 (:def (Some after) (skip-string s c numeral) :propagate)
                 (else (loop after (- n value) steps))))))))

;; A run of Roman letters, read only as add-roman! writes its value: MCM,
;; not MDCCCC, and IV, not IIII. The value stops growing past 100 000, and
;; is None there, as no field reaches it.
(: read-roman (-> string StringCursor (Option (Tuple long StringCursor))))
(defun (read-roman s c)
  (let loop ((e c) (total 0) (prev 0))
    (def v (if (string-cursor-end? s e) 0 (roman-value (string-cursor-ref s e))))
    (cond ((> v 0)
           (loop (string-cursor-next s e)
                 (cond ((> total 100000) total)
                       ((> v prev) (+ total (- v (* 2 prev))))
                       (else (+ total v)))
                 v))
          ((or (< total 1) (> total 100000)) None)
          (:def (Some after) (skip-roman s c total) :propagate)
          ((string-cursor=? after e) (Some (Tuple (long-of total) e)))
          (else None))))

;; The number, from 1, of the longest name in the table that s has at c.
(: read-name (-> string StringCursor (Vec string) (Option (Tuple long StringCursor))))
(defun (read-name s c table)
  (let loop ((i 0) (best 0) (best-end c))
    (if (= i (vec-length table))
        (if (= best 0) None (Some (Tuple (long-of best) best-end)))
        (match (skip-string s c (vec-ref table i))
          ((Some e) (if (or (= best 0) (string-cursor>? e best-end))
                        (loop (+ i 1) (+ i 1) e)
                        (loop (+ i 1) best best-end)))
          (None (loop (+ i 1) best best-end))))))

;; 0 for the morning's word and 1 for the afternoon's, the longer when both
;; match.
(: read-am-pm (-> string StringCursor DateNames (Option (Tuple long StringCursor))))
(defun (read-am-pm s c names)
  (match (Tuple (skip-string s c (record-ref names am)) (skip-string s c (record-ref names pm)))
    ((Tuple (Some a) (Some p)) (if (string-cursor>? p a) (Some (Tuple 1L p)) (Some (Tuple 0L a))))
    ((Tuple (Some a) None) (Some (Tuple 0L a)))
    ((Tuple None (Some p)) (Some (Tuple 1L p)))
    (_ None)))

;; A Unix time, an optional minus and up to 12 digits of seconds or 15 of
;; milliseconds, as UTC ticks: None outside the years 1 to 9999, as
;; unix-seconds->instant answers.
(: read-unix (-> string StringCursor bool (Option (Tuple long StringCursor))))
(defun (read-unix s c ms)
  (def minus (starts-with-char? s c #\-))
  (def (Some (Tuple n c1))
    (read-digits s (if minus (string-cursor-next s c) c) 1 (if ms 15 12)) :propagate)
  (def signed (if minus (- n) n))
  (def (Some i)
    (if ms (unix-milliseconds->instant signed) (unix-seconds->instant signed)) :propagate)
  (Some (Tuple (instant-ticks i) c1)))

;; The end of the longest run, at least one long, of the characters an IANA
;; id is made of.
(: skip-zone (-> string StringCursor (Option StringCursor)))
(defun (skip-zone s c)
  (let loop ((e c))
    (cond ((and (not (string-cursor-end? s e)) (zone-char? (string-cursor-ref s e)))
           (loop (string-cursor-next s e)))
          ((string-cursor=? e c) None)
          (else (Some e)))))

;; Whether s has the same text from a to a-end as from b to b-end.
(: same-span? (-> string StringCursor StringCursor StringCursor StringCursor bool))
(defun (same-span? s a a-end b b-end)
  (cond ((string-cursor=? a a-end) (string-cursor=? b b-end))
        ((string-cursor=? b b-end) #f)
        ((char=? (string-cursor-ref s a) (string-cursor-ref s b))
         (same-span? s (string-cursor-next s a) a-end (string-cursor-next s b) b-end))
        (else #f)))

(: zero-after (-> (Option StringCursor) (Option (Tuple long StringCursor))))
(defun (zero-after r)
  (match r
    ((Some c) (Some (Tuple 0L c)))
    (None None)))

;; What one part reads at c, as a number, and the cursor after it. Text and
;; characters read as 0, and a zone is read by skip-zone.
(: read-value (-> string StringCursor DateNames Field (Option (Tuple long StringCursor))))
(defun (read-value s c names f)
  (def k (struct-ref f kind))
  (def w (struct-ref f width))
  (def most (struct-ref f most))
  (cond ((> most 0) (read-digits s c (max w 1) (max w most)))
        ((name-kind? k) (read-name s c (name-table names k)))
        (else
         (match k
           (FText (zero-after (skip-string s c (struct-ref f text))))
           (FChar (zero-after (skip-char s c (struct-ref f ch))))
           (FFraction (if (< w 0) (read-optional-fraction s c) (read-fraction-digits s c w)))
           (FAmPm (read-am-pm s c names))
           (FOffset (read-offset s c))
           (FUnix (read-unix s c #f))
           (FUnixMs (read-unix s c #t))
           (FZone None)
           (_ (read-roman s c))))))

;; Whether a field read as old, or not read when -1, agrees with v.
(: agrees? (-> int int bool))
(defun (agrees? old v) (or (< old 0) (= old v)))

(: ticks-agree? (-> long long bool))
(defun (ticks-agree? old t) (or (= old no-ticks) (= old t)))

;; The ticks in the last of 7 - digits places, which a fraction read to
;; digits digits does not say.
(: fraction-unit (-> int long))
(defun (fraction-unit digits) (if (>= digits 7) 1L (* 10L (fraction-unit (+ digits 1)))))

;; A fraction read twice has to agree to the fewer digits of the two, and
;; the one with more is kept: .5 and .5000 agree, and .5 and .4 do not.
(: put-fraction (-> Seen long int (Option Seen)))
(defun (put-fraction seen f digits)
  (def old (struct-ref seen fraction))
  (def old-digits (struct-ref seen fraction-digits))
  (def unit (fraction-unit (min digits old-digits)))
  (cond ((or (< old 0L) (> digits old-digits))
         (if (or (< old 0L) (= (/ old unit) (/ f unit)))
             (Some (record-set seen (fraction f) (fraction-digits digits)))
             None))
        ((= (/ old unit) (/ f unit)) (Some seen))
        (else None)))

;; seen with the field f read as v, or None when it was read before as
;; something else. A value too large for any field stays too large. The
;; check comes first, so a Seen, which is large, is copied only to change it.
(: put-value (-> Seen Field long (Option Seen)))
(defun (put-value seen f v)
  (def n (if (or (> v 1000000000L) (< v 0L)) 1000000000 (int-of v)))
  (def w (struct-ref f width))
  (match (struct-ref f kind)
    (FYear (if (agrees? (struct-ref seen year) n) (Some (record-set seen (year n))) None))
    (FMonth (if (agrees? (struct-ref seen month) n) (Some (record-set seen (month n))) None))
    (FDay (if (agrees? (struct-ref seen day) n) (Some (record-set seen (day n))) None))
    (FHours (if (agrees? (struct-ref seen hours) n) (Some (record-set seen (hours n))) None))
    (FMinutes (if (agrees? (struct-ref seen minutes) n) (Some (record-set seen (minutes n))) None))
    (FSeconds (if (agrees? (struct-ref seen seconds) n) (Some (record-set seen (seconds n))) None))
    ;; A bare fraction says every digit there is: .5 is .5000000.
    (FFraction (put-fraction seen v (if (< w 0) 7 (min w 7))))
    (FOffset (if (ticks-agree? (struct-ref seen offset) v) (Some (record-set seen (offset v))) None))
    (FUnix (if (ticks-agree? (struct-ref seen unix) v) (Some (record-set seen (unix v))) None))
    (FUnixMs (if (ticks-agree? (struct-ref seen unix) v) (Some (record-set seen (unix v))) None))
    (FRomanYear (if (agrees? (struct-ref seen year) n) (Some (record-set seen (year n))) None))
    (FRomanMonth (if (agrees? (struct-ref seen month) n) (Some (record-set seen (month n))) None))
    (FRomanDay (if (agrees? (struct-ref seen day) n) (Some (record-set seen (day n))) None))
    (FMonthName (if (agrees? (struct-ref seen month) n) (Some (record-set seen (month n))) None))
    (FMonthAbbr (if (agrees? (struct-ref seen month) n) (Some (record-set seen (month n))) None))
    (FWeekday (if (agrees? (struct-ref seen weekday) n) (Some (record-set seen (weekday n))) None))
    (FWeekdayName
     (if (agrees? (struct-ref seen weekday) n) (Some (record-set seen (weekday n))) None))
    (FWeekdayAbbr
     (if (agrees? (struct-ref seen weekday) n) (Some (record-set seen (weekday n))) None))
    (FYday (if (agrees? (struct-ref seen yday) n) (Some (record-set seen (yday n))) None))
    (FWeek (if (agrees? (struct-ref seen week) n) (Some (record-set seen (week n))) None))
    (FWeekYear
     (if (agrees? (struct-ref seen week-year) n) (Some (record-set seen (week-year n))) None))
    (FHours12 (if (agrees? (struct-ref seen hours12) n) (Some (record-set seen (hours12 n))) None))
    (FAmPm (if (agrees? (struct-ref seen pm) n) (Some (record-set seen (pm n))) None))
    ;; Text is read by read-format, and a zone by put-zone.
    (_ (Some seen))))

;; seen with the zone read from c to e, when no other was read before.
(: put-zone (-> string Seen StringCursor StringCursor (Option Seen)))
(defun (put-zone s seen c e)
  (def start (struct-ref seen zone-start))
  (def end (struct-ref seen zone-end))
  (cond ((string-cursor=? start end) (Some (record-set seen (zone-start c) (zone-end e))))
        ((same-span? s start end c e) (Some seen))
        (else None)))

;; The fields of a text in a format's parts, when the text has every part
;; and nothing after. Text is only skipped, and a field's value is read
;; before it is put, so a Seen is copied no more than it has to be.
(: read-format (-> string (List %p) DateNames (Option Seen)) (where (FormatPart %p)))
(defun (read-format s parts names)
  (let loop ((ps parts) (c (string-cursor-start s)) (seen unseen))
    (if (list-empty? ps)
        (if (string-cursor-end? s c) (Some seen) None)
        (let ((f (part-field (list-head ps))))
          (match (struct-ref f kind)
            (FText
             (match (skip-string s c (struct-ref f text))
               ((Some c1) (loop (list-tail ps) c1 seen))
               (None None)))
            (FChar
             (match (skip-char s c (struct-ref f ch))
               ((Some c1) (loop (list-tail ps) c1 seen))
               (None None)))
            (FZone
             (def* ((Some c1) (skip-zone s c) :propagate)
                   ((Some seen1) (put-zone s seen c c1) :propagate))
             (loop (list-tail ps) c1 seen1))
            (_
             (def* ((Some (Tuple v c1)) (read-value s c names f) :propagate)
                   ((Some seen1) (put-value seen f v) :propagate))
             (loop (list-tail ps) c1 seen1)))))))

;; A date needs its largest unit. Month, day and yday count within year,
;; and week within week-year; either may be read beside a date the other
;; kind of year makes, and is checked against it.
(: check-date-bits (-> int void))
(defun (check-date-bits bits)
  (def year? (has? bits b-year))
  (def week-year? (has? bits b-week-year))
  (def in-year? (has? bits b-in-year))
  (def week? (has? bits b-week))
  (unless (or year? week-year?)
    (argument-error "a format read as a date needs year, (roman year) or week-year."))
  (when (and in-year? (not year?) (not week?))
    (argument-error
      "month, day and yday count within year, and this format has week-year instead: write year, or read a week date with week-year and week."))
  (when (and week? (not week-year?) (not in-year?))
    (argument-error
      "week counts within week-year, and this format has year instead: write week-year, or read a calendar date with year, month and day.")))

;; A time needs its hours: hours, or hours12 with am-pm, since 1:05 on a
;; twelve-hour clock could be either. A datetime's format may leave the time
;; out, which is midnight, and then optional is true.
(: check-time-bits (-> int bool void))
(defun (check-time-bits bits optional)
  (def hours? (or (has? bits b-hours) (has? bits b-hours12)))
  (when (and (has? bits b-hours12) (not (has? bits b-am-pm)))
    (argument-error "hours12 needs am-pm beside it, as 1:05 could be either."))
  (unless (or hours? optional)
    (argument-error "a format read as a time needs hours, or hours12 with am-pm."))
  (when (and (not hours?) (has? bits (bitwise-ior b-in-hour b-am-pm)))
    (argument-error
      "minutes, seconds, fraction and am-pm count within hours, and this format has no hours or hours12.")))

;; An instant is its Unix time alone, or a date and a time. A Unix time
;; beside another field of the instant could say another instant, so a
;; format with one has no other field but a moment's zone.
(: check-instant-bits (-> int void))
(defun (check-instant-bits bits)
  (def unix (bitwise-ior b-unix b-unix-ms))
  (def others (- bits (bitwise-and bits (bitwise-ior unix b-zone))))
  (when (and (has? bits b-unix) (has? bits b-unix-ms))
    (argument-error "unix and unix-ms each say the whole instant, so a format reads one of them."))
  (when (and (has? bits unix) (> others 0))
    (argument-error
      "unix and unix-ms say the whole instant, and a field beside them could say another, so a format that reads one has no other field but text and a moment's zone."))
  (unless (has? bits unix)
    (check-date-bits bits)
    (check-time-bits bits #t)))

;; A moment needs its zone, which is never guessed.
(: check-moment-bits (-> int void))
(defun (check-moment-bits bits)
  (unless (has? bits b-zone)
    (argument-error
      "a format read as a moment needs zone. A text with an offset and no zone is read with text->instant, and put in a zone with instant->moment."))
  (check-instant-bits bits))

(: first-value (-> int int))
(defun (first-value n) (if (< n 0) 1 n))

(: calendar-day (-> int int int (Option long)))
(defun (calendar-day y m d)
  (if (valid-date? y m d) (Some (long-of (clr-date-day-number (ClrDate. y m d)))) None))

(: ordinal-day (-> int int (Option long)))
(defun (ordinal-day y yd)
  (if (and (>= y 1) (<= y 9999) (>= yd 1) (<= yd (clr-date-day-of-year (ClrDate. y 12 31))))
      (Some (+ (long-of (clr-date-day-number (ClrDate. y 1 1))) (long-of (- yd 1))))
      None))

;; The day the date fields make: year, month and day; year and yday; or
;; week-year, week and weekday. A field left out is its first value.
(: seen-day-number (-> Seen (Option long)))
(defun (seen-day-number seen)
  (def y (struct-ref seen year))
  (def m (struct-ref seen month))
  (def d (struct-ref seen day))
  (def yd (struct-ref seen yday))
  (def wy (struct-ref seen week-year))
  (cond ((and (>= y 0) (or (>= m 0) (>= d 0))) (calendar-day y (first-value m) (first-value d)))
        ((and (>= y 0) (>= yd 0)) (ordinal-day y yd))
        ((>= wy 0)
         (match (week-date wy (first-value (struct-ref seen week))
                           (first-value (struct-ref seen weekday)))
           ((Some date) (Some (day-number date)))
           (None None)))
        ((>= y 0) (calendar-day y 1 1))
        (else None)))

;; Whether every date field read is the date's own. A field not read is -1,
;; and its accessor is not called.
(: date-agrees? (-> Seen Date bool))
(defun (date-agrees? seen d)
  (and (or (< (struct-ref seen year) 0) (= (struct-ref seen year) (->year d)))
       (or (< (struct-ref seen month) 0) (= (struct-ref seen month) (->month d)))
       (or (< (struct-ref seen day) 0) (= (struct-ref seen day) (->day d)))
       (or (< (struct-ref seen weekday) 0) (= (struct-ref seen weekday) (->weekday d)))
       (or (< (struct-ref seen yday) 0) (= (struct-ref seen yday) (->yday d)))
       (or (< (struct-ref seen week) 0) (= (struct-ref seen week) (->week d)))
       (or (< (struct-ref seen week-year) 0) (= (struct-ref seen week-year) (->week-year d)))))

(: seen->date (-> Seen (Option Date)))
(defun (seen->date seen)
  (def (Some n) (seen-day-number seen) :propagate)
  (def d (day-number->date n))
  (if (date-agrees? seen d) (Some d) None))

;; The time of day the fields make, in ticks since midnight: hours, or
;; hours12 and am-pm, where 12 AM is 00 and 12 PM is 12; minutes, seconds
;; and the fraction left out are 0. am-pm beside hours has to agree with it.
(: seen-time-ticks (-> Seen (Option long)))
(defun (seen-time-ticks seen)
  (def h24 (struct-ref seen hours))
  (def h12 (struct-ref seen hours12))
  (def pm (struct-ref seen pm))
  (def h (cond ((< h12 0) (max h24 0))
               ((or (< h12 1) (> h12 12)) -1)
               (else (+ (% h12 12) (* (max pm 0) 12)))))
  (def m (max (struct-ref seen minutes) 0))
  (def sec (max (struct-ref seen seconds) 0))
  (cond ((not (and (agrees? h24 h) (valid-time? h m sec 0))) None)
        ((and (>= pm 0) (not (= pm (/ h 12)))) None)
        (else (Some (+ (time-of-day-ticks h m sec 0) (max (struct-ref seen fraction) 0L))))))

;; Local ticks: a date and a time, midnight when the format has none.
(: seen-local-ticks (-> Seen (Option long)))
(defun (seen-local-ticks seen)
  (def* ((Some d) (seen->date seen) :propagate)
        ((Some t) (seen-time-ticks seen) :propagate))
  (Some (+ (* (day-number d) ticks-per-day) t)))

;; The instant's UTC ticks: its Unix time, or the local time at the offset
;; read, or in UTC when the format has none, as instant->text writes it.
(: seen-instant-ticks (-> Seen (Option long)))
(defun (seen-instant-ticks seen)
  (def u (struct-ref seen unix))
  (def o (struct-ref seen offset))
  (cond ((not (= u no-ticks)) (Some u))
        (:def (Some l) (seen-local-ticks seen) :propagate)
        ((= o no-ticks) (Some l))
        ((in-calendar? (- l o)) (Some (- l o)))
        (else None)))

;; resolve-local, None rather than raising where a local time and its
;; instant cannot both be in the calendar.
(: resolve-local/opt (-> long TimeZone Resolver (Option Moment)))
(defun (resolve-local/opt l z r)
  (match (try (resolve-local l z r) #:catch (System.OverflowException))
    ((Ok m) (Some m))
    ((Err e) None)))

;; A moment in the zone read from s: the Unix time's instant there; or the
;; local time at the offset read, when the zone has that offset then; or the
;; local time alone, which in a gap or an overlap is None unless a resolver
;; says. An id the machine does not know is None.
(: seen->moment (-> string Seen (Option Resolver) (Option Moment)))
(defun (seen->moment s seen r)
  (def (Some z)
    (timezone (substring s (struct-ref seen zone-start) (struct-ref seen zone-end)))
    :propagate)
  (def zi (struct-ref z tz))
  (def u (struct-ref seen unix))
  (def o (struct-ref seen offset))
  (cond ((not (= u no-ticks))
         (let ((uo (offset-at zi u)))
           (if (in-calendar? (+ u uo))
               (Some (Moment (local (ticks->datetime (+ u uo))) (offset (ticks->duration uo))
                             (zone z)))
               None)))
        (:def (Some l) (seen-local-ticks seen) :propagate)
        ((not (= o no-ticks))
         (if (and (in-calendar? (- l o)) (= (offset-at zi (- l o)) o))
             (Some (Moment (local (ticks->datetime l)) (offset (ticks->duration o)) (zone z)))
             None))
        (else
         (match r
           ((Some resolve) (resolve-local/opt l z resolve))
           (None (datetime->moment/opt (ticks->datetime l) z))))))

;; The reader of date->text's formats.
(: text->date (-> string (List DatePart) (#:names DateNames) (Option Date)))
(defun (text->date s parts #:names (parameter-ref current-date-names))
  (check-date-bits (format-bits parts names))
  (def (Some seen) (read-format s parts names) :propagate)
  (seen->date seen))

(: text->time (-> string (List TimePart) (#:names DateNames) (Option Time)))
(defun (text->time s parts #:names (parameter-ref current-date-names))
  (check-time-bits (format-bits parts names) #f)
  (def* ((Some seen) (read-format s parts names) :propagate)
        ((Some t) (seen-time-ticks seen) :propagate))
  (Some (Time (v (ClrTime. t)))))

(: text->datetime (-> string (List DateTimePart) (#:names DateNames) (Option DateTime)))
(defun (text->datetime s parts #:names (parameter-ref current-date-names))
  (def bits (format-bits parts names))
  (check-date-bits bits)
  (check-time-bits bits #t)
  (def* ((Some seen) (read-format s parts names) :propagate)
        ((Some l) (seen-local-ticks seen) :propagate))
  (Some (ticks->datetime l)))

;; The fields are UTC's unless the format has an offset, as instant->text
;; writes them.
(: text->instant (-> string (List InstantPart) (#:names DateNames) (Option Instant)))
(defun (text->instant s parts #:names (parameter-ref current-date-names))
  (check-instant-bits (format-bits parts names))
  (def* ((Some seen) (read-format s parts names) :propagate)
        ((Some u) (seen-instant-ticks seen) :propagate))
  (Some (Instant (ticks u))))

;; With an offset, the offset has to be one the zone has at that local time,
;; as iso8601->moment demands. Without one, a local time in a gap or an
;; overlap is None.
(: text->moment (-> string (List MomentPart) (#:names DateNames) (Option Moment)))
(defun (text->moment s parts #:names (parameter-ref current-date-names))
  (check-moment-bits (format-bits parts names))
  (def (Some seen) (read-format s parts names) :propagate)
  (seen->moment s seen None))

;; A local time without an offset found as the resolver says, as
;; datetime->moment finds it.
(: text->moment/resolver (-> string (List MomentPart) Resolver (#:names DateNames) (Option Moment)))
(defun (text->moment/resolver s parts r #:names (parameter-ref current-date-names))
  (check-moment-bits (format-bits parts names))
  (def (Some seen) (read-format s parts names) :propagate)
  (seen->moment s seen (Some r)))
