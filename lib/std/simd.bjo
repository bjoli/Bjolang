  (v256-sub-saturating (: System.Runtime.Intrinsics.Vector256.SubtractSaturate (-> (Simd256 %a) (Simd256 %a) (Simd256 %a))))
  (v256-shuffle (: Bjolang.Runtime.BjoSimd.Shuffle256 (-> (Simd256 %a) (Simd256 %a) (Simd256 %a))))
  (v256-lookup (: Bjolang.Runtime.BjoSimd.Lookup256 (-> (Simd128 byte) (Simd256 %a) (Simd256 %a))))
  (v256-as (: System.Runtime.Intrinsics.Vector256.As (-> (Simd256 %a) (Simd256 %b))))
  (v256-floor (: Bjolang.Runtime.BjoSimd.Floor256 (-> (Simd256 %a) (Simd256 %a))))
  (v256-ceiling (: Bjolang.Runtime.BjoSimd.Ceiling256 (-> (Simd256 %a) (Simd256 %a))))
