;; A summary is one line: it is what a list or a hover shows.

;; EXPECT-ERROR: has a summary of more than one line

(import (std prelude))

(:doc twice (summary """
    Doubles.
    Really.
    """) (arg x "The number.") (returns "Twice x."))
(: twice (-> int int))
(defun (twice x) (* 2 x))

(defun (main args) 0)
