;; A bjoroutine cannot take a span.
;; EXPECT-ERROR: 'f' is a bjoroutine, and its parameter 's' is a (System.Span long)
(import (std prelude))
(import/extern
  (whole (: System.MemoryExtensions.AsSpan (-> (Array %a) (System.Span %a))))
  (sleep (: System.Threading.Tasks.Task.Delay (-> int void) #:async #:uncancellable)))
(: (-> (System.Span long) int))
(defun (len s) (.-Length s))

(: (-bjo-> (System.Span long) int))
(defbjo (f s) (sleep 1) (len s))
(defbjo (main) (println (f (whole (vec->array [1L])))) 0)
