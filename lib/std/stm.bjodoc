;; Docs for std/stm.bjo, read through (:doc #:file "stm.bjodoc"). The texts
;; are samizdat markup: code in prose is @code{...}.

(:doc #:module
  (summary "Software transactional memory (STM): atomic multi-location transactions with CML event integration.")
  (see atomically atomically-evt tx-retry tx-or-else)
  (example """
    (import (std stm))

    (def from (make-loc 100))
    (def to (make-loc 0))

    ;; Transfer 30 between accounts atomically:
    (atomically
     (fun (tx)
       (tx-set! tx from (- (tx-ref tx from) 30))
       (tx-set! tx to (+ (tx-ref tx to) 30))))

    ;; Wait for account balance with a 1-second timeout:
    (sync (choose (atomically-evt
                   (fun (tx)
                     (if (> (tx-ref tx to) 0)
                         (tx-ref tx to)
                         (tx-retry tx))))
                  (wrap (timeout 1000) (fun (_) 0))))
    """)
  (reference """
    @code{(Loc T)} represents a transactional memory location holding a value
    of type T. A transaction is a function taking a @code{Tx} log argument.
    It reads and writes locations through @code{Tx} using @code{tx-ref},
    @code{tx-set!}, @code{tx-update!}, and @code{tx-swap!}.

    @strong{Atomicity and isolation.} Speculative writes are buffered in the
    transaction log until commit time. The commit applies all writes
    atomically, provided no locations in the read set were modified by
    concurrent transactions. If a conflict occurs, the transaction rolls back
    and retries automatically.

    @strong{Execution.} Run transactions using @code{atomically} (which blocks
    or suspends until commit), or @code{atomically-evt} (which integrates with
    CML event synchronization). Use @code{try-atomically} in non-fiber .NET
    callbacks where waiting is not permitted.

    @strong{Conditional synchronization.} Calling @code{tx-retry} aborts the
    current transaction run and suspends until at least one location in the
    read set changes. Combined with @code{atomically-evt}, retrying transactions
    compose cleanly in @code{choose} alongside timeouts and channels.

    @strong{Alternatives.} @code{(tx-or-else tx a b)} attempts transaction
    @code{a}. If @code{a} retries, its writes are rolled back and @code{b}
    executes.

    @strong{Transaction rules.}

    @itemlist{
      @item{Transactions must be free of side effects outside @code{Tx}: no
        printing, no I/O, and no mutation of external state.}
      @item{Transactions cannot perform CML synchronization (@code{sync}).}
      @item{The @code{Tx} log token is single-use; accessing a @code{Tx} after
        transaction completion throws an error.}
      @item{Store immutable values in locations. Mutations to objects inside
        locations bypass transaction tracking.}
    }

    @strong{Consistency.} The log is validated periodically during execution
    and before commit to prevent dirty reads. Transactions never commit from
    inconsistent views.

    @strong{Credits.} Based on kcas by Vesa Karvonen and contributors
    (@link["https://github.com/ocaml-multicore/kcas"]), using multi-word
    compare-and-swap algorithms with read-only validation.
    """))

(:doc Loc
  (summary "Transactional memory location holding a value of type %a.")
  (tparam %a "The type of the contained value.")
  (see make-loc tx-ref loc-ref))

(:doc Tx
  (summary "Transaction log token passed to transaction functions.")
  (see tx-ref tx-set! atomically))

(:doc make-loc
  (summary "Creates a new transactional location initialized with a value.")
  (arg value "Initial value stored in the location.")
  (returns "A new transactional location cell."))

(:doc loc-ref
  (summary "Reads the current value of a location outside a transaction.")
  (arg loc "The location to read.")
  (returns "The value from the most recent commit.")
  (reference """
    Reading multiple locations via consecutive @code{loc-ref} calls does not
    provide a consistent snapshot. To read multiple locations atomically,
    use a transaction.
    """))

(:doc tx-ref
  (summary "Reads the value of a location within a transaction.")
  (arg tx "The transaction log context.")
  (arg loc "The location to read.")
  (returns "The transaction's pending write for loc, or its committed value."))

(:doc tx-set!
  (summary "Writes a value to a location within a transaction.")
  (arg tx "The transaction log context.")
  (arg loc "The location to modify.")
  (arg value "The new value to write.")
  (reference """
    Writes are speculative and buffered in the transaction log; concurrent
    threads observe the new value only after successful commit.
    """))

(:doc tx-update!
  (summary "Applies a transformation function to a location within a transaction.")
  (arg tx "The transaction log context.")
  (arg loc "The location to update.")
  (arg f "Transformation function taking old value and returning new value.")
  (returns "The updated value written to the location."))

(:doc tx-swap!
  (summary "Replaces the value of a location within a transaction, returning the previous value.")
  (arg tx "The transaction log context.")
  (arg loc "The location to update.")
  (arg value "The new value to store.")
  (returns "The value held in the location immediately before the swap."))

(:doc tx-retry
  (summary "Aborts the transaction and waits until any location read by the transaction changes.")
  (arg tx "The transaction log context.")
  (returns "Never returns directly.")
  (example """
    ;; Dequeue an item or wait until available:
    (: take! (-> (Loc (Option string)) string))
    (defun (take! slot)
      (atomically
       (fun (tx)
         (match (tx-ref tx slot)
           ((Some item) (tx-set! tx slot None) item)
           (None (tx-retry tx))))))
    """)
  (reference """
    Discards speculative writes. Retrying transactions suspend until a
    concurrent transaction commits a new value to at least one location in the
    read set.
    """))

(:doc tx-or-else
  (summary "Tries transaction first; if it retries, rolls back writes and tries second.")
  (arg tx "The transaction log context.")
  (arg first "The primary transaction to attempt.")
  (arg second "The fallback transaction to run if first retries.")
  (returns "The return value of the successful branch.")
  (example """
    ;; Dequeue from high-priority queue, falling back to low-priority queue:
    (tx-or-else tx (fun (tx) (pop! tx high)) (fun (tx) (pop! tx low)))
    """)
  (reference """
    If second retries as well, the entire @code{tx-or-else} form retries,
    waiting on locations read by either branch.
    """))

(:doc atomically-evt
  (summary "Creates a CML event that executes and commits a transaction.")
  (arg f "The transaction function taking a Tx argument.")
  (returns "A CML event available when f commits without retrying.")
  (example """
    ;; Wait for a transactional flag, a channel message, or a timeout:
    (sync (choose (atomically-evt
                   (fun (tx) (if (tx-ref tx flag) "flag" (tx-retry tx))))
                  (wrap (chan-recv messages) (fun (_) "message"))
                  (wrap (timeout 1000) (fun (_) "timeout"))))
    """)
  (reference """
    Function f runs when the event synchronizes. If f calls @code{tx-retry},
    the event remains unavailable until locations read by f are modified. If
    another branch in @code{choose} synchronizes first, f rolls back all writes.
    """))

(:doc atomically
  (summary "Executes and commits a transaction, waiting while it retries.")
  (arg f "The transaction function taking a Tx argument.")
  (returns "The value returned by f in the committed run.")
  (reference """
    In a fiber, this expands to @code{(sync (atomically-evt f))}. Outside a
    fiber, it executes synchronously and blocks the calling thread while
    waiting.
    """))

(:doc try-atomically
  (summary "Attempts to commit a transaction immediately without waiting, returning Option.")
  (arg f "The transaction function taking a Tx argument.")
  (returns "(Some value) if f commits, or None if f calls tx-retry.")
  (reference """
    Conflicting transactions retry immediately; returns None only if f
    explicitly invokes @code{tx-retry}. Safe for non-fiber .NET callbacks
    because it never blocks.
    """))
