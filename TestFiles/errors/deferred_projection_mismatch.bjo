;; EXPECT-ERROR: these types do not match.
;; EXPECT-ERROR: at deferred_projection_mismatch.bjo:8
;; `u` is open when `ref` is checked, so the index type waits. The call then
;; says `u` is a vec, whose index is an int, and "x" is not one.
(import (std prelude))

(defun (main args)
  (defun (pick u) (ref u "x"))
  (println (pick [1 2 3]))
  0)
