;; The guard is the same for each alternative of a clause, so a repeated alternative is dead also under a guard.

;; EXPECT-ERROR: this alternative can never run

(import (std prelude))

(: (-> int string))
(defun (f n)
  (match n
    ((or 3 3) #:when (> n 0) "three")
    (_ "other")))

(defun (main args)
  (println (f 3))
  0)
