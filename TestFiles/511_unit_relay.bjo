;; A module that sees no units holds, passes and prints a quantity it was
;; given, and records and defaults carriers work in unit types.
(import (std prelude))
(import (std simpletest))
(import "inc/unit_relay.bjo")

(defun (main)
  (def x (relay (a-length)))
  (expect "a length crosses" (relay x) (a-length))
  (expect "and prints as its carrier" (written x) "2.5")
  0)
