(import (std prelude))

(def/trait (Functor (%f %a))
  (: fmap (-> (%f %a) (-> %a %b) (%f %b))))

(def/impl (Functor (List %a))
  (defun (fmap xs g) (list-map g xs)))

(def/impl (Functor (Option %a))
  (defun (fmap o g)
    (match o ((Some v) (Some (g v))) (None None))))

(: show-list (-> (List int) string))
(defun (show-list xs)
  (list-foldl (fun (acc x) (string-append acc (string-append " " (int->string x)))) "" xs))

(defun (main)
  ;; A *local* helper with no signature. Its parameter type is a metavariable
  ;; when its body is checked, and the trait obligation is deferred — so the
  ;; question is whether the use site below gets to pin it first.
  (defun (bump fa) (fmap fa (fun (n) (+ n 1))))

  (println (show-list (bump (Cons 1 (Cons 2 Nil)))))
  0)
