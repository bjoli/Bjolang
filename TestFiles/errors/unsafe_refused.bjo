;; Unsafe reads and writes memory with no checks, so it cannot be named, not
;; even in a type annotation.

;; EXPECT-ERROR: 'System.Runtime.CompilerServices.Unsafe' cannot be used from Bjolang

(import (std prelude))
(import/extern (size-of (: System.Runtime.CompilerServices.Unsafe.SizeOf (-> int))))
(defun (main) 0)
