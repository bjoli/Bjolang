(import (only (std ports) port->seq))
(import (std fmt))

;; Lines are read  by "read-line", not by looking for a newline character.
;; because read-line handles all kinds of line endings. 
(defun (main args)
  ;; port->seq reads the port lazily. For maximum speed and memory usage
  ;; you could use port->vec ord port->list
  (def line-seq (port->seq read-line (deref current-input-port)))
  (loop (:for line line-seq)
        ;; (summing expr) ssums expr. In this case it just
        ;; sums 1 for every line.
        (:acc lines (summing 1))
        ;; Any :for after a non-:for clause opens a new subloop
        ;; so this loops over ever char in the line.
        (:for ch line)
        (:acc chars (summing 1) :when (not (char-whitespace? ch)))
        => (show [(tabular [["Lines:" nl "Chars:" nl]
                            [lines  nl chars  nl]])]))
  0)
