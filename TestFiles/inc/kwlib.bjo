;; A keyword parameter used across a module boundary.
;;
;; A keyword name is part of the calling convention: `Codegen` emits it as a C#
;; named argument at every call site, which is why the renamer is forbidden from
;; ever touching one.
(export scale)

(: scale (-> int (#:by int) (#:offset int) int))
(defun (scale n #:by 2 #:offset 0)
  (+ (* n by) offset))
