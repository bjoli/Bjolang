;; A record pattern takes fields by name, not by position: a literal cannot say
;; which field it is for.

;; EXPECT-ERROR: 'Car' is a record type
;; EXPECT-ERROR: written (field-name pattern) or as a bare field name

(import (std prelude))

(type (: Car (Record (: brand string) (: year int))))

(: f (-> Car string))
(defun (f c)
  (match c
    ((Car "volvo" year) "volvo")
    (_ "")))

(defun (main args)
  (println (f (Car (brand "a") (year 1))))
  0)
