;; Docs for std/stm/counter.bjo, read through (:doc #:file "counter.bjodoc").
;; The texts are samizdat markup: code in prose is @code{...}.

(:doc #:module
  (summary "Striped transactional counter that minimizes write conflicts across processor cores.")
  (see TCounter tcounter-add! tcounter-ref)
  (example """
    (import (std stm))
    (import (std stm counter))

    (def requests (make-tcounter 0L))

    ;; Per-request addition: stripes writes by CPU to avoid transaction conflicts
    (atomically (fun (tx) (tcounter-add! tx requests 1L)))

    ;; Periodic read: sums across all stripes
    (atomically (fun (tx) (tcounter-ref tx requests)))
    """)
  (reference """
    @code{(TCounter T)} stores a numeric counter of type T (implementing
    @code{Num}, such as int, long, or double). Its value is partitioned across
    multiple per-CPU striped locations. Add operations write only to the stripe
    corresponding to the executing CPU, allowing concurrent transactions on
    different cores to commit without conflicts.

    @strong{Read vs write trade-offs.} @code{tcounter-ref} inspects all stripes
    to compute the total sum, conflicting with concurrent writes. Use this
    counter when additions are frequent and reads are infrequent (e.g. request
    and error metrics). If a value is read as often as it is written, a standard
    @code{Loc} is preferred.

    @strong{Overflow.} Fixed-width integers wrap on overflow using two's
    complement arithmetic across stripes.

    @strong{Credits.} Based on the Accumulator design in kcas_data
    (@link["https://github.com/ocaml-multicore/kcas"]).
    """))

(:doc TCounter
  (summary "Striped transactional counter holding a numeric value of type %a.")
  (tparam %a "The numeric type (must implement Num).")
  (see make-tcounter))

(:doc make-tcounter
  (summary "Creates a new striped counter initialized with a value.")
  (arg initial "Initial value (e.g. 0L for a long counter).")
  (returns "A new striped transactional counter.")
  (reference """
    Allocates one stripe per CPU core, rounded up to the nearest power of two.
    """))

(:doc tcounter-add!
  (summary "Adds n to the counter within a transaction.")
  (arg tx "The transaction log context.")
  (arg c "The counter.")
  (arg n "The value to add.")
  (reference """
    Updates only the stripe assigned to the current CPU core and reads no other
    stripes. Does not return the updated total; call @code{tcounter-ref} to read
    the full sum.
    """))

(:doc tcounter-sub!
  (summary "Subtracts n from the counter within a transaction.")
  (arg tx "The transaction log context.")
  (arg c "The counter.")
  (arg n "The value to subtract."))

(:doc tcounter-ref
  (summary "Computes the total sum across all stripes within a transaction.")
  (arg tx "The transaction log context.")
  (arg c "The counter.")
  (returns "The aggregate sum of all stripes.")
  (reference """
    Reads all stripes, causing conflicts with any concurrent transactions
    performing additions.
    """))

(:doc tcounter-set!
  (summary "Overwrites all counter stripes with a new value within a transaction.")
  (arg tx "The transaction log context.")
  (arg c "The counter.")
  (arg value "The new value to assign.")
  (reference """
    Writes to all stripes, conflicting with concurrent transactions that add to
    the counter.
    """))
