;; Deriving something that has no derivation.
;;
;; `Eq` and `Ord` are derived from the shape of a declaration. Any other trait
;; is a mistake the macro can catch while it is still looking at syntax, since
;; nothing in a declaration says what the method would do.

;; EXPECT-ERROR: the traits that can be derived are Eq and Ord

(import (std prelude))

(type/derive (Show)
  (: Point (Record (: x int) (: y int))))

(defun (main args) 0)
