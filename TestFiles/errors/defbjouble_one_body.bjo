;; A `defbjouble` with only one body.
;;
;; The form exists because a leaf has two implementations. With one, there is
;; nothing to choose between and nothing that could not be said with `defun` —
;; and a half-written pair is worse than either, because the name would claim a
;; suspending copy that is not there.

;; EXPECT-ERROR: it has no (#:bjo ...) body
;; EXPECT-ERROR: If there is only one implementation, this is a defun

(import (std prelude))

(import/extern
  (clr-eof (: Bjolang.Runtime.BjoPort.PortEof (-> TextInputPort bool))))

(: finished? (-> TextInputPort bool))
(defbjouble (finished? p)
  (#:sync (clr-eof p)))

(defun (main args) 0)
