;; `:finish` takes a test, and optionally a value.

;; EXPECT-ERROR: Invalid (:finish ...)
;; EXPECT-ERROR: Expected: (:finish test) or (:finish test value)

(import (std prelude))

(: f (-> (List int) int))
(defun (f xs)
  (loop (:for x xs)
        (:acc s (summing x))
        (:finish)
        => s))

(defun (main) (println (int->string (f '(1 2 3)))) 0)
