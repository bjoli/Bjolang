;; `only` and `except` filter defs, macros and types. A trait is not filtered:
;; it has no key, so leaving its name out would not keep another trait of that
;; name apart from it (see Docs/MODULES.org).
;;
;; EXPECT-ERROR: Invalid (only ...)
;; EXPECT-ERROR: 'Labelled' is a trait
;; EXPECT-ERROR: A trait always arrives with its module

(import (only "../inc/kitchen.bjo" Labelled))

(defun (main)
  0)
