;; Examples/receipt.bjo — a shop receipt, laid out with `(std fmt)`.
;;
;; Everything a receipt needs is a width problem: the paper is forty columns
;; and not one more, the money has to line up on the right however long the
;; description is, and the description has to give way when it does not fit.
(import (std prelude))
(import (std fmt))

;; The paper, and the column the money is right-aligned in. Everything else is
;; derived from these two: change the first and the whole receipt follows.
(def paper 40)
(def money-column 9)


;; First we define the line.
;; what is the grocery
;; qty is how much
;; and unit is unit price
(type
  (: Line (Record (: what string)
                  (: qty double)
                  (: unit double))))

;; Simple accessors
(: what-of (-> Line string))
(defun (what-of l) (record-ref l what))

(: qty-of (-> Line double))
(defun (qty-of l) (record-ref l qty))

(: unit-of (-> Line double))
(defun (unit-of l) (record-ref l unit))

(: amount-of (-> Line double))
(defun (amount-of l) (* (qty-of l) (unit-of l)))


;; --- The pieces ------------------------------------------------------------

;; A rule across the paper: padding with nothing in it. `padded/left` fills
;; with the pad character, and `with-pad` says which one.
(: rule (-> char Block))
(defun (rule c)
  (each [(with-pad c [(padded/left paper [""])]) nl]))

(: heading (-> (Vec Block) Block))
(defun (heading bs)
  (each [(padded/both paper bs) nl]))

;; Money, in the column it belongs in. Two decimals and grouped thousands are
;; what this shop's prices are, whatever the machine's locale thinks.
(: money (-> double Block))
(defun (money x)
  (padded/left money-column [(numeric x #:precision 2 #:comma 3 #:decimal-sep #\,)]))

;; A line with something against each margin. The right-hand side is rendered
;; and measured first — `captured` — and the left takes exactly what is left
;; over, cut with an ellipsis if it wants more. `fitted/right` is pad *or*
;; trim.
(: spread (-> (Vec Block) (Vec Block) Block))
(defun (spread left right)
  (captured (fun (s)
              (each [(fitted/right (- paper (width-of s)) left) (BStr s) nl]))
            right))

;; A labelled amount. The money is padded to a fixed column, so every amount
;; ends where the one above it did however many digits it has.
(: labelled (-> (Vec Block) double Block))
(defun (labelled label x)
  (spread label [(money x)]))

;; If more than one is bought, print a qty X price line under.
(: detail (-> Line Block))
(defun (detail l)
  (if (= (qty-of l) 1.0)
      nothing
      (each ["  "
             (numeric (qty-of l) #:precision 2)
             " x "
             (numeric (unit-of l) #:precision 2)
             nl])))

(: item (-> Line Block))
(defun (item l)
  (each [(labelled [(what-of l)] (amount-of l)) (detail l)]))

;; The total, with dot leaders running right up to the digits.
(: total-line (-> double Block))
(defun (total-line x)
  (captured (fun (s)
              (each ["TOTAL"
                     ;; pads so that s can be printed right justified.
                     (with-pad #\. [(space-to (- paper (width-of s)))])
                     (BStr s)
                     nl]))
            [(numeric x #:precision 2 #:comma 3)]))

;; The tax summary. Three columns, each as wide as its own content: that is
;; `tabular`. 
(: vat-summary (-> double double Block))
(defun (vat-summary net vat)
  (tabular [["Rate" nl "12 %"]
            ["Net" nl (numeric net #:precision 2)]
            ["VAT" nl (numeric vat #:precision 2)]]
           #:sep "   "))

;; The shop against the left margin, the transaction against the right.
(: masthead Block)
(def masthead
  (each [(spread ["Fruktgatan 12"] ["2026-08-21 14:32"])
         (spread ["211 41 Malmo"] ["Receipt 1042"])]))

;; justifies the footer so that it fits the paper
(: footer Block)
(def footer
  (with-fmt current-width paper
            [(justified ["Thank you for shopping with us. Please keep the receipt: it is your proof of purchase, and anything unopened may be returned within thirty days."])
             nl]))


;; --- The receipt -----------------------------------------------------------

(: basket (List Line))
(def basket
  (list (Line (what "Bananas, organic")                           (qty 1.24) (unit 24.90))
        (Line (what "Coffee beans, dark roast, whole")            (qty 2.0)  (unit 89.00))
        (Line (what "Rye bread")                                  (qty 1.0)  (unit 32.50))
        (Line (what "Oat milk")                                   (qty 3.0)  (unit 18.95))
        (Line (what "Cloudberry jam from Lapland, the small jar") (qty 1.0)  (unit 64.00))))

(: receipt (-> (List Line) (Vec Block)))
(defun (receipt ls)
  (let* ((total (list-foldl (fun (acc l) (+ acc (amount-of l))) 0.0 ls))
         (net (/ total 1.12))
         (vat (- total net)))
    ;; One `with` over the whole receipt: a name too long for its column is cut
    ;; and says so, wherever on the paper it appears.
    [(with-fmt current-ellipsis "..."
               [(heading ["BJOLI'S GROCERY"])
                nl
                masthead
                (rule #\=)
                (joined item ls [])
                (rule #\-)
                (labelled ["Net"] net)
                (labelled ["VAT 12%"] vat)
                (rule #\=)
                (total-line total)
                nl
                (vat-summary net vat)
                nl
                footer])]))

(defun (main args)
  (parameterize ((current-decimal-sep #\,))
    (render (parameter-ref current-output-port) (receipt basket)))
  0)
