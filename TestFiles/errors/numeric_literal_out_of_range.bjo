;; EXPECT-ERROR: '99999' does not fit in a 'ushort'
;;
;; The literal takes its type from the parameter it is passed to, which is what
;; makes writing one at a `ushort` possible at all — and makes it possible to
;; write one that will not fit. A literal's value is known while the program is
;; still Bjolang, so the question is answered here rather than by C#, which
;; would answer `CS0221` about generated code.
(import (std prelude))

(: halve (-> ushort ushort))
(defun (halve x) (/ x 2))

(defun (main)
  (displayln (->str (halve 99999)))
  0)
