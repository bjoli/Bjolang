;; EXPECT-ERROR: 'total-with' is called here, before 'bonus' is defined, and it reads 'bonus'

;; Calling a local function runs its body there and then, so what it reads has
;; to be defined above the def that calls it.

(import (std prelude))

(defun (main args)
  (def base 40)
  (def total (total-with base))
  (defun (total-with x) (+ x bonus))
  (def bonus 2)
  (println (->str total))
  0)
