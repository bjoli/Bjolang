;; A pattern that cannot fail leaves the failure part unreachable.
;;
;; Almost always a typo where a constructor was not in scope and so parsed as a
;; plain variable. Refused rather than warned, unlike the match clause it
;; resembles: a failure part exists to say what happens when the scrutinee is
;; not what was wanted, and a pattern that always matches makes it dead code.

;; EXPECT-ERROR: always matches, so the failure part of this def can never run

(import (std prelude))

(: f (-> (Option int) string))
(defun (f o)
  (def whatever o :leave-with "this can never run")
  "always here")
