;; Map loops that are compiled to vector operations (see
;; codegen/vector_map.bjo). The vector part does whole vectors, and the scalar
;; loop does the remaining elements. Each size from 0 to 19 is tried, so that
;; each number of remaining elements occurs for 4 and for 8 lanes.

(import (std prelude))
(import (std simpletest))

(: (-> (Array double) (Array double) (Array long) void))
(defun (revenue! out ps qs)
  (loop (:for i (range 0 (array-length out)))
        (:do (array-set! out i (* (array-ref ps i) (cast double (array-ref qs i)))))))

(: (-> (Array double) double (Array double) void))
(defun (affine! out k xs)
  (loop (:for i (range 0 (array-length out)))
        (:do (array-set! out i (+ (* k (array-ref xs i)) 1.0)))))

;; `out` is also read: each element is read before it is written.
(: (-> (Array double) void))
(defun (double-in-place! xs)
  (loop (:for i (range 0 (array-length xs)))
        (:do (array-set! xs i (/ (array-ref xs i) 0.5)))))

;; A range that does not start at 0.
(: (-> (Array long) (Array long) int void))
(defun (square-from! out xs lo)
  (loop (:for i (range lo (array-length out)))
        (:do (array-set! out i (* (array-ref xs i) (array-ref xs i))))))

(: (-> (Array int) (Array int) (Array int) void))
(defun (difference! out a b)
  (loop (:for i (range 0 (array-length out)))
        (:do (array-set! out i (- (array-ref a i) (array-ref b i))))))

(: (-> (Array float) (Array int) float void))
(defun (halves! out a k)
  (loop (:for i (range 0 (array-length out)))
        (:do (array-set! out i (* (cast float (array-ref a i)) k)))))

;; Inputs longer than the range: only the elements in the range are written.
(: (-> (Array double) (Array double) int void))
(defun (copy-prefix! out xs n)
  (loop (:for i (range 0 n))
        (:do (array-set! out i (array-ref xs i)))))

(: (-> int (-> int double) (Array double)))
(defun (doubles n f)
  (def a (make-array n #:fill 0.0))
  (loop (:for i (range 0 n)) (:do (array-set! a i (f i))))
  a)

(: (-> int (-> int long) (Array long)))
(defun (longs n f)
  (def a (make-array n #:fill 0L))
  (loop (:for i (range 0 n)) (:do (array-set! a i (f i))))
  a)

(: (-> int (-> int int) (Array int)))
(defun (ints n f)
  (def a (make-array n #:fill 0))
  (loop (:for i (range 0 n)) (:do (array-set! a i (f i))))
  a)

;; The number of indices below `n` where `ok` is false.
(: (-> int (-> int bool) int))
(defun (wrong n ok)
  (loop (:for i (range 0 n)) (:when (not (ok i))) (:acc (counting i))))

(defun (main)
  (loop
    (:for n (range 0 20))
    (:do
     (def ps (doubles n (fun (i) (+ (cast double i) 0.5))))
     (def qs (longs n (fun (i) (cast long (* 3 i)))))
     (def out (make-array n #:fill -1.0))
     (revenue! out ps qs)
     (expect (str "revenue, " (displayed n))
             (wrong n (fun (i) (= (array-ref out i) (* (+ (cast double i) 0.5) (cast double (* 3 i))))))
             0)

     (affine! out 2.0 ps)
     (expect (str "affine, " (displayed n))
             (wrong n (fun (i) (= (array-ref out i) (+ (* 2.0 (+ (cast double i) 0.5)) 1.0))))
             0)

     (double-in-place! ps)
     (expect (str "in place, " (displayed n))
             (wrong n (fun (i) (= (array-ref ps i) (* 2.0 (+ (cast double i) 0.5)))))
             0)

     (def squares (make-array n #:fill -1L))
     (square-from! squares qs 3)
     (expect (str "from 3, " (displayed n))
             (wrong n (fun (i) (= (array-ref squares i) (if (< i 3) -1L (cast long (* 9 i i))))))
             0)

     (def a (ints n (fun (i) (* i i))))
     (def b (ints n (fun (i) i)))
     (def d (make-array n #:fill 0))
     (difference! d a b)
     (expect (str "ints, " (displayed n))
             (wrong n (fun (i) (= (array-ref d i) (- (* i i) i))))
             0)

     (def fs (make-array n #:fill (cast float 0)))
     (halves! fs a (cast float 0.5))
     (expect (str "floats, " (displayed n))
             (wrong n (fun (i) (= (array-ref fs i) (* (cast float (* i i)) (cast float 0.5)))))
             0)

     (def prefix (make-array (+ n 5) #:fill -1.0))
     (copy-prefix! prefix (doubles (+ n 7) (fun (i) (cast double i))) n)
     (expect (str "prefix, " (displayed n))
             (wrong (+ n 5) (fun (i) (= (array-ref prefix i) (if (< i n) (cast double i) -1.0))))
             0)))
  0)
