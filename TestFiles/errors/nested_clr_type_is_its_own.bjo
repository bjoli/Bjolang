;; `Dictionary<K, V>.KeyCollection` is its own type, not the dictionary, so it
;; has no `ContainsKey`. It used to be typed as the dictionary.
;; EXPECT-ERROR: '(System.Collections.Generic.Dictionary.KeyCollection string int)' has no public instance method named 'ContainsKey'

(import (std prelude))
(import (std mutable map))

(defun (main args)
  (def d (mutablemap))
  (mutablemap-set! d "a" 1)
  (println (->str (.ContainsKey (.-Keys d) "a")))
  0)
