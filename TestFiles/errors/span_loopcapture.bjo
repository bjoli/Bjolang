;; A loop that stays a local function cannot capture a span.
;; EXPECT-ERROR: bound outside the loop 'walk' (it is not only tail-recursive
;; EXPECT-ERROR: a span cannot be captured
(import (std prelude))
(import/extern
  (whole (: System.MemoryExtensions.AsSpan (-> (Array %a) (System.Span %a))))
  (sleep (: System.Threading.Tasks.Task.Delay (-> int void) #:async #:uncancellable)))
(: (-> (System.Span long) int))
(defun (len s) (.-Length s))

(: (-> (System.Span long) int))
(defun (count s)
  (let walk ((i 0))
    (if (< i (.-Length s)) (+ 1 (walk (+ i 1))) 0)))
(defun (main) (println (count (whole (vec->array [1L])))) 0)
