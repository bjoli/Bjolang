;; Docs for std/mutable/heap.bjo, read through (:doc #:file "heap.bjodoc"). The
;; texts are samizdat markup: code in prose is @code{...}.

(:doc #:module
  (summary "Priority queue backed directly by .NET PriorityQueue<T,P>, ordered with smallest priority first.")
  (see MutableHeap mutableheap mutableheap-by mutableheap-add! mutableheap-pop!)
  (example """
    (import (std mutable heap))

    (def tasks (mutableheap))
    (mutableheap-add! tasks "write" 2)
    (mutableheap-add! tasks "plan" 1)
    (mutableheap-add! tasks "test" 3)
    (mutableheap-peek tasks)   ; (Some (Tuple "plan" 1))
    (mutableheap-pop! tasks)   ; (Some (Tuple "plan" 1))
    (mutableheap-pop! tasks)   ; (Some (Tuple "write" 2))

    ;; Max-heap (largest priority first): invert the comparison
    (def big-first (mutableheap-by (fun (a b) (compare b a))))
    """)
  (reference """
    @code{(MutableHeap a p)} aliases .NET @code{PriorityQueue<T,P>} directly.
    It is implemented as an array-backed 4-ary min-heap. Enqueue (@code{add!})
    and dequeue (@code{pop!}) operations run in O(log n) time. Peeking the top
    element runs in O(1) time. Foreign interop via @code{import/extern} accepting
    @code{PriorityQueue<T,P>} accepts @code{MutableHeap} directly.

    @strong{Elements and priorities.} @code{(mutableheap-add! h task 3)} adds
    @code{task} with priority 3. The heap orders priorities, not elements; the
    element type does not require an @code{Ord} instance. Peeking and popping
    return the element and its priority together as a @code{(Tuple a p)}.

    @strong{Min-heap semantics.} Elements with the lowest priority value are
    dequeued first. To construct a max-heap (highest priority first), pass a
    reversed comparison to @code{mutableheap-by}. Elements with identical
    priorities are dequeued in non-deterministic order.

    @strong{Priority comparers.} Constructors @code{mutableheap},
    @code{seq->mutableheap}, and @code{list->mutableheap} use .NET's default
    comparer, @code{Comparer<P>.Default}. For Bjolang types with an @code{Ord}
    instance, this resolves to that instance. If no comparer exists for the type,
    the first comparison raises an exception. Use @code{mutableheap-by} to supply
    a custom comparison function.

    @strong{Empty heap behavior.} Peeking or popping an empty heap returns
    @code{None} without raising exceptions.

    @strong{Unordered traversals.} Priority queues do not support ordered
    in-place iteration because sorting requires destructive dequeue operations.
    @code{mutableheap->unordered-seq} and @code{mutableheap->unordered-list}
    expose internal storage without sorting.

    @strong{Equality.} Heaps do not implement structural @code{Eq}; equality
    checks compare reference identity.

    @strong{Thread safety.} Heaps are not thread-safe. Concurrent modifications
    require external synchronization.

    @strong{Traits.} Implements @code{Collection} over @code{(Tuple a p)}, and
    @code{->str}.
    """))

;; ---------------------------------------------------------------------------
;; The heap
;; ---------------------------------------------------------------------------

(:doc MutableHeap
  (summary "Priority queue of %a with priorities %p (aliases .NET PriorityQueue<T,P>).")
  (tparam %a "The element type (does not require Ord).")
  (tparam %p "The priority type (lowest priority dequeued first).")
  (see mutableheap mutableheap-by))

(:doc mutableheap
  (summary "Creates an empty min-heap using default priority ordering.")
  (returns "A new empty heap using Comparer<P>.Default.")
  (see mutableheap-by))

(:doc mutableheap-by
  (summary "Creates an empty min-heap using a custom priority comparison function.")
  (arg cmp "Comparison function returning negative if a < b, 0 if equal, and positive if a > b.")
  (returns "A new empty heap.")
  (see mutableheap mutableheap-copy)
  (example """
    (mutableheap-by (fun (a b) (compare a b)))   ; min-heap using Ord
    (mutableheap-by (fun (a b) (compare b a)))   ; max-heap
    """))

(:doc mutableheap-length
  (summary "Returns the number of elements in the heap.")
  (arg h "The heap.")
  (returns "The element count.")
  (see mutableheap-empty?))

(:doc mutableheap-empty?
  (summary "Tests if the heap contains no elements.")
  (arg h "The heap.")
  (returns "#t if empty, otherwise #f.")
  (see mutableheap-length))

(:doc mutableheap-clear!
  (summary "Removes all elements from the heap, retaining priority order.")
  (arg h "The heap to clear."))

(:doc mutableheap-add!
  (summary "Enqueues an element with the given priority.")
  (arg h "The heap to modify.")
  (arg x "The element to add.")
  (arg priority "The element's priority.")
  (see mutableheap-add-all! mutableheap-add-pop! mutableheap-pop!)
  (reference """
    Runs in O(log n) time.
    """))

(:doc mutableheap-add-all!
  (summary "Enqueues all element-priority pairs from a sequence.")
  (arg h "The heap to modify.")
  (arg xs "Sequence of (Tuple element priority) pairs to add.")
  (see mutableheap-add!))

(:doc mutableheap-add-pop!
  (summary "Enqueues an element and removes the minimum element in a single pass.")
  (arg h "The heap to modify. Length remains unchanged.")
  (arg x "The element to add.")
  (arg priority "The priority for x.")
  (returns "The removed minimum element. If the heap was empty or priority was already minimum, returns x directly.")
  (see mutableheap-add! mutableheap-pop!)
  (example """
    ;; Keep the top 10 scores in a fixed-size heap:
    (if (< (mutableheap-length top) 10)
        (mutableheap-add! top name score)
        (ignore (mutableheap-add-pop! top name score)))
    """)
  (reference """
    Performs the enqueue and dequeue in a single rebalancing pass, avoiding
    the overhead of consecutive add and pop calls.
    """))

(:doc mutableheap-peek
  (summary "Returns the element with minimum priority without removing it, or None if empty.")
  (arg h "The heap to inspect.")
  (returns "(Some (Tuple element priority)) for the minimum entry, or None if empty.")
  (see mutableheap-pop!))

(:doc mutableheap-pop!
  (summary "Removes and returns the element with minimum priority, or None if empty.")
  (arg h "The heap to modify.")
  (returns "(Some (Tuple element priority)) for the minimum entry, or None if empty.")
  (see mutableheap-peek mutableheap-add!)
  (example """
    ;; Dequeue tasks in priority order:
    (let loop ()
      (match (mutableheap-pop! tasks)
        (None unit)
        ((Some (Tuple task _)) (run task) (loop))))
    """)
  (reference """
    Runs in O(log n) time.
    """))

(:doc mutableheap-copy
  (summary "Creates a shallow copy of the heap preserving elements and comparer.")
  (arg h "The heap to copy.")
  (returns "A new heap with identical elements and ordering.")
  (reference """
    Retains the priority comparer of the source heap.
    """))

;; ---------------------------------------------------------------------------
;; Conversions
;; ---------------------------------------------------------------------------

(:doc list->mutableheap
  (summary "Constructs a new heap from a list of element-priority pairs.")
  (arg xs "List of (Tuple element priority) pairs.")
  (returns "A new heap using default priority ordering.")
  (see mutableheap->unordered-list seq->mutableheap))

(:doc mutableheap->unordered-list
  (summary "Converts the heap to an unordered list of element-priority pairs.")
  (arg h "The source heap.")
  (returns "A new list of (Tuple element priority) pairs in arbitrary order.")
  (see list->mutableheap mutableheap-pop!))

(:doc seq->mutableheap
  (summary "Constructs a new heap from a sequence of element-priority pairs.")
  (arg xs "Sequence of (Tuple element priority) pairs.")
  (returns "A new heap using default priority ordering.")
  (see mutableheap->unordered-seq mutableheap-add-all!)
  (reference """
    To construct a heap with a custom comparer, initialize with
    @code{mutableheap-by} and populate using @code{mutableheap-add-all!}.
    """))

(:doc mutableheap->unordered-seq
  (summary "Views the heap as a sequence of element-priority pairs in arbitrary order.")
  (arg h "The source heap.")
  (returns "A Seq of (Tuple element priority) pairs without sorting.")
  (see seq->mutableheap mutableheap->unordered-list)
  (reference """
    Iterates directly over internal heap storage. Mutating the heap during
    traversal can raise @code{System.InvalidOperationException}. To consume
    elements in priority order, call @code{mutableheap-pop!} repeatedly.
    """))

;; ---------------------------------------------------------------------------
;; Printing
;; ---------------------------------------------------------------------------

(:doc mutableheap->str
  (summary "Formats the heap as text in the form #mheap(x priority ...).")
  (arg h "The heap to format.")
  (returns "Formatted string representation displaying elements and priorities in storage order.")
  (example """
    (mutableheap->str (list->mutableheap (list (Tuple 7 1))))   ; "#mheap(7 1)"
    """)
  (reference """
    Implements @code{->str} for heaps. Note that elements appear in internal
    storage order rather than priority order.
    """))
