;; EXPECT-ERROR: 'string' does not satisfy 'Num'
;;
;; `(+ "a" "b")` used to compile: `+` was typed `(-> %a %a %a)` and C# happens
;; to concatenate strings with it. It is now rejected, which is the point of
;; typing the operator with what it actually needs — `string-append` is the one
;; that means this.
(import (std prelude))

(defun (main)
  (displayln (+ "a" "b"))
  0)
