;; Day 5: Print Queue. Part 1 sums the middle page of each update that obeys
;; the rules. Part 2 puts the others in order and sums their middle pages.
(import (std mutable set) (std mutable vec) (std scan) "common.bjo")

(defun (main args)
  (def lines (input-lines args))
  ;; The rules stay "X|Y" strings, and a pair is looked up as one.
  (def rules (mutableset))
  (loop (:for l lines)
        (:finish (= l ""))
        (:do (ignore (mutableset-add! rules l))))
  (defun (before? a b) (mutableset-contains? rules (str (int->string a) "|" (int->string b))))
  (defun (compare-pages a b) (cond ((before? a b) -1) ((before? b a) 1) (else 0)))
  (def updates {vecing (scan l '(int ... #:sep ","))
                       (:for l lines)
                       (:when (string-contains? l ","))})
  (defun (in-order? u) (all? #(not (before? (ref u &) (ref u (- & 1)))) (range 1 (length u))))
  (println {summing (ref u (/ (length u) 2)) (:for u updates) (:when (in-order? u))})
  (println {summing (mutablevec-ref m (/ (mutablevec-length m) 2))
            (:for u updates)
            (:when (not (in-order? u)))
            (:let m (vec->mutablevec u))
            (:do (mutablevec-sort-by! m compare-pages))})
  0)
