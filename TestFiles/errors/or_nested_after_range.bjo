;; An alternative of an `or` inside a constructor that the range before it
;; covers.

;; EXPECT-ERROR: this alternative can never run

(import (std prelude))

(: (-> (Option int) int))
(defun (f o)
  (match o
    ((Some (or (:at-least 0) 3)) 1)
    (_ 0)))

(defun (main args)
  (println (int->string (f (Some 3))))
  0)
