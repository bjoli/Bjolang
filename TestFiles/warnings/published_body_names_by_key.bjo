;; A published body names its types and constructors by key, so it is inlined
;; where the importer's own names differ: here a `Ripe` and a `MkRipe` of this
;; module's own, and the library's types imported only under a prefix.
;; 384_prefix_replaces_bare.bjo runs the same calls.
;;
;; EXPECT-NO-WARNING: could not inline

(import (std prelude))
(import (prefix-types "../inc/ripe_inline.bjo" "R/"))

(type (: Ripe (Union (: MkRipe string))))

(defun (main)
  (println (->str (ripe-value (ripe 5))))
  0)
