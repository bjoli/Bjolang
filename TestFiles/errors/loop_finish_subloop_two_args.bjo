;; `:finish-subloop` takes exactly one test.

;; EXPECT-ERROR: Invalid (:finish-subloop ...)
;; EXPECT-ERROR: Expected: (:finish-subloop test)

(import (std prelude))

(: f (-> (List (List int)) (List int)))
(defun (f rows)
  (loop (:for row rows)
        (:subloop (:for y row)
                  (:acc s (summing y))
                  (:finish-subloop (> s 10) 0))
        (:acc out (listing s))))

(defun (main) (println (int->string (list-length (f '((1)))))) 0)
