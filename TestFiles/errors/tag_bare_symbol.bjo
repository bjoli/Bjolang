;; A case that carries arguments is named by a form that carries them. A bare
;; symbol outside a quote is an ordinary identifier, so the report is the one
;; an unbound name gets — the position says nothing about tags.
;; EXPECT-ERROR: Unbound variable: asc
(import (std prelude))

(type (: Q (Union (CAsc #:tag asc) (CPlain (List Symbol)))))

(: render (-> Q string))
(defun (render q) "r")

(defun (main args)
  ;; `'asc` is the spelling; `asc` here is a name that has no binding.
  (println (render asc))
  0)
