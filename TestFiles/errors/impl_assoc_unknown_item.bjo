;; (assoc Trait item T) names one of the trait's associated types.

;; EXPECT-ERROR: trait 'Iterable' has no associated type %item; it declares %elem %cursor

(import (std prelude))

(type (: (Wrapped %s) (Struct (: inner %s))))

(def/trait (Holds %c)
  (type %elem)
  (: first-of (-> %c %elem)))

(impl (Holds (Wrapped %s)) (where (Iterable %s))
  (type %elem (assoc Iterable item %s))
  (defun (first-of w) (iterable-current (record-ref w inner) (iterable-start (record-ref w inner)))))

(defun (main) 0)
