;; std/interop.bjo — what .NET wants and Bjolang cannot write.
;;
;; A Bjolang function is a Func. A .NET API that wants an Action, an
;; EventHandler or a delegate type of its own gets one from `as-delegate`.
;; A parameter that wants null gets it from `clr-default`. The work is in the
;; runtime (`BjoInterop.cs`).
(import (std prelude))

(:doc #:file "interop.bjodoc")

(export Delegate ClrType
  as-delegate as-delegate/type
  add-event-handler! remove-event-handler!
  clr-default)

(import/class
  (Delegate (: System.Delegate))
  (ClrType  (: System.Type)))

(import/extern
  (clr-default           (: Bjolang.Runtime.BjoInterop.Default (-> %a)))
  (as-delegate           (: Bjolang.Runtime.BjoInterop.As      (-> %f %d)))
  (as-delegate/type      (: Bjolang.Runtime.BjoInterop.Convert (-> ClrType %f Delegate)))
  (add-event-handler!    (: Bjolang.Runtime.BjoInterop.AddEventHandler
                            (-> %t string %f Delegate)))
  (remove-event-handler! (: Bjolang.Runtime.BjoInterop.RemoveEventHandler
                            (-> %t string Delegate void))))
