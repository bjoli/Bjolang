;; Not enough positional arguments to fill `apply`'s target's fixed parameters.
;;
;; `labelled` takes a tag before its rest parameter. Letting the collection
;; supply that tag as well as the rest elements is the same run-time arity check
;; `apply_no_rest.bjo` refuses, so the fixed parameters have to be written out.

;; EXPECT-ERROR: fixed parameter(s) and 'apply' was given
;; EXPECT-ERROR: has to be supplied positionally, before the collection

(import (std prelude))

(: labelled (-> string #:rest string string))
(defun (labelled tag #:rest parts) tag)

(defun (main args)
  (def parts (list "a" "b"))
  (println (apply labelled parts))
  0)
