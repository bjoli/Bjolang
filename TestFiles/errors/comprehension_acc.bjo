;; A second accumulator inside a comprehension.
;;
;; A comprehension is an expression that produces one value, and the collector
;; before the expression is what produces it. Its accumulator name is invented,
;; so there is nothing for a second `(:acc ...)` to be combined with and no way
;; to name it in a result — the form has no `=>` to put it in.
;;
;; Refused rather than quietly ignored, and the message names the way out: a
;; `loop`, which is what a comprehension is sugar for and where accumulators can
;; be named, combined and returned.

;; EXPECT-ERROR: has one result, and its collector names it
;; EXPECT-ERROR: Write a (loop ...) for more than one

(import (std prelude))

(defun (main args)
  (println (list-length {listing a (:for a (range 0 10)) (:acc other (summing a))}))
  0)
