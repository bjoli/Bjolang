;; std/unicode/casefold.bjo — full Unicode case folding (CaseFolding.txt).
;;
;; - The fold is the default, culture-independent one: the mappings of status
;;   C and F. The Turkic mappings (status T) are not used.
;; - The table is generated by gen_casefold.py into casefold-table.bin, and
;;   compiled into the assembly with include-bytes.
;;
;; Cost:
;; - ASCII is folded without the table. Other characters take a binary
;;   search over the 1,606 mappings.
;; - A string that has nothing to fold is returned as it is, with no copy.

(export
  casefold-unicode-version
  string-foldcase)

;; The core, so that (std prelude) can import this module.
(import (std prelude core))

(:doc #:file "casefold.bjodoc")

(include "casefold-table.protobjo")

;; ---------------------------------------------------------------------------
;; The table
;; ---------------------------------------------------------------------------

(: string)
(def casefold-unicode-version unicode-version)

;; The mappings, compiled into the assembly (see `include-bytes`): the
;; `fold-count` code points that fold, in order; the start of each one's fold
;; in the third part (`fold-count` + 1 of them, the last the end); and the
;; code points they fold to.
(: (RoSpan int))
(def fold-table (include-bytes "casefold-table.bin" #:of int))

;; Where the starts and the targets begin in `fold-table`.
(def fold-starts fold-count)
(def fold-targets (+ (* 2 fold-count) 1))

;; The index of the mapping of `cp`, or -1 if `cp` does not fold.
(: (-> int int))
(defun (fold-index cp)
  (let go ((lo 0) (hi fold-count))
    (if (>= lo hi)
        -1
        (let* ((mid (shift-right (+ lo hi) 1))
               (k (ro-span-ref fold-table mid)))
          (cond
            ((< cp k) (go lo mid))
            ((> cp k) (go (+ mid 1) hi))
            (else mid))))))

(: (-> int bool) #:inline)
(defun (ascii-upper? cp) (and (>= cp 65) (<= cp 90)))

;; True if `ch` folds to something other than itself.
(: (-> char bool) #:inline)
(defun (folds? ch)
  (def cp (char->int ch))
  (if (< cp 128) (ascii-upper? cp) (>= (fold-index cp) 0)))

;; Adds the fold of `ch` to `sb`.
(: (-> StringBuilder char void))
(defun (add-folded! sb ch)
  (def cp (char->int ch))
  (if (< cp 128)
      (stringbuilder-add-byte! sb (if (ascii-upper? cp) (+ cp 32) cp))
      (let ((i (fold-index cp)))
        (if (< i 0)
            (stringbuilder-add! sb ch)
            (loop (:for k (range (ro-span-ref fold-table (+ fold-starts i))
                                 (ro-span-ref fold-table (+ fold-starts i 1))))
                  (:do (stringbuilder-add! sb (int->char (ro-span-ref fold-table (+ fold-targets k))))))))))

;; ---------------------------------------------------------------------------
;; Strings
;; ---------------------------------------------------------------------------

;; The fold of `s` from the cursor `from` on, after the part before it, which
;; has nothing to fold.
(: (-> string StringCursor string))
(defun (fold-from s from)
  (def sb (stringbuilder-empty))
  (stringbuilder-add-substring! sb s (string-cursor-start s) from)
  (let go ((c from))
    (if (string-cursor-end? s c)
        (stringbuilder->string sb)
        (begin
          (def (Tuple ch next) (string-cursor-ref+next s c))
          (add-folded! sb ch)
          (go next)))))

(: (-> string string))
(defun (string-foldcase s)
  (let scan ((c (string-cursor-start s)))
    (if (string-cursor-end? s c)
        s
        (begin
          (def (Tuple ch next) (string-cursor-ref+next s c))
          (if (folds? ch)
              (fold-from s c)
              (scan next))))))
