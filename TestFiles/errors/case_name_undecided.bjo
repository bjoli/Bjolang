;; EXPECT-ERROR: Red is a case of case_name_undecided/Light and case_name_undecided/Suit, and nothing here says which one this is
;; EXPECT-ERROR: as in (: Red Light)
;;
;; `println` takes any value, so nothing says which union's `Red` this is.

(import (std prelude))

(type (: Light (Union Red Amber Green)))
(type (: Suit (Union Red Black)))

(defun (main)
  (println Red)
  0)
