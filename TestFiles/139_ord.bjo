;; `Ord` — the one ordering, and open.
;;
;; One method, `compare`, and everything else written in terms of it. The
;; primitives implement it by delegating to their own `System.IComparable`, so a
;; comparison at a known type compiles to `a.CompareTo(b)` and costs what it did
;; when `Ord` *was* that interface.
;;
;; What being an ordinary trait buys is the bottom half of this file: a type
;; this program declares can be ordered, and then `list-sort` — which knows
;; nothing about it — sorts it. As a `#:clr-constraint` that was impossible,
;; because nothing emits a .NET interface on a generated type.
;;
;; Nothing here imports `(std eq)`, where the trait is declared. It arrives
;; through the prelude's re-export of `compare`, which is what carries the
;; trait — so `(where (Ord %a))` below is written against a trait this module
;; only ever got at third hand.
(import (std prelude))
(import (std simpletest))

;; A constrained generic of this module's own, over a trait it did not declare
;; and did not directly import.
(: middle-of (-> %a %a %a %a) (where (Ord %a)))
(defun (middle-of a b c)
  (least (greatest a b) (greatest (least a b) c)))

;; Directly recursive *and* constrained, which is the combination that used to
;; emit a call missing its dictionary. The recursion forwards what this function
;; was handed: the call is at its own type variable, so its own evidence is the
;; right evidence.
;;
;; In tail position too, so it becomes a loop — and the dictionary is not one of
;; the loop's slots, being the same on every iteration.
(: smallest (-> (List %a) %a %a) (where (Ord %a)))
(defun (smallest xs seed)
  (if (list-empty? xs)
      seed
      (smallest (list-tail xs) (least seed (list-head xs)))))

;; --- A type of this program's own -------------------------------------------

(type/derive (Eq) (: Version (Record (: major int) (: minor int))))

;; Lexicographic by hand: major first, minor only where majors agree. Negative,
;; zero or positive is the contract — not -1, 0 and 1 — so the outer test asks
;; whether the first comparison settled it rather than what it answered.
(impl (Ord Version)
  (defun (compare a b)
    (def m (compare (record-ref a major) (record-ref b major)))
    (if (= m 0)
        (compare (record-ref a minor) (record-ref b minor))
        m)))

(: v (-> int int Version))
(defun (v major minor) (Version (major major) (minor minor)))

(: show-version (-> Version string))
(defun (show-version x)
  (string-append (int->string (record-ref x major))
                 (string-append "." (int->string (record-ref x minor)))))

(: join-versions (-> (List Version) string))
(defun (join-versions xs)
  (list-foldl (fun (acc x) (string-append acc (string-append " " (show-version x)))) "" xs))

;; Ordering is not equality, and a type may be `Ord` without the comparison
;; being arithmetic. This one runs at `string`.
(: longest-first (-> (List string) (List string)))
(defun (longest-first xs) (list-reverse (list-sort xs)))

;; `string-join` takes a `Vec`; this is the list-shaped one, written here
;; because what is being tested is the sort rather than the printing.
(: join (-> (List string) string))
(defun (join xs)
  (if (list-empty? xs)
      ""
      (list-foldl (fun (acc s) (string-append acc (string-append "," s)))
                  (list-head xs)
                  (list-tail xs))))

(defun (main)
  ;; `compare` promises negative, zero and positive rather than -1, 0 and 1,
  ;; so these ask about the sign.
  (expect "compare less" (< (compare 3 7) 0) #t)
  (expect "compare equal" (compare 5 5) 0)
  (expect "compare greater" (> (compare 7 3) 0) #t)

  ;; The predicates, at types with no C# `<` between them.
  (expect "less? on strings" (less? "apple" "quince") #t)
  (expect "greater? on strings" (greater? "quince" "apple") #t)
  (expect "at-most? on equals" (at-most? "pear" "pear") #t)
  (expect "at-least? on equals" (at-least? "pear" "pear") #t)
  (expect "less? on doubles" (less? 1.5 2.5) #t)
  (expect "less? on bools" (less? #f #t) #t)
  (expect "less? on chars" (less? #\a #\b) #t)

  ;; `least`/`greatest` rather than `min`/`max`: those are `Num`'s, and they do
  ;; not reach a string.
  (expect "least of strings" (least "pear" "apple") "apple")
  (expect "greatest of strings" (greatest "pear" "apple") "pear")
  (expect "least of ints" (least 3 7) 3)
  (expect "greatest of doubles" (double->string (greatest 1.5 2.5)) "2.5")

  ;; Sorting, which needed a constraint that could reach a string.
  (expect "sort strings"
          (join (list-sort (list "pear" "apple" "quince" "fig")))
          "apple,fig,pear,quince")
  (expect "sort ints"
          (join (list-map int->string (list-sort (list 5 3 9 1 7))))
          "1,3,5,7,9")
  (expect "sort is stable on equals"
          (join (list-sort (list "b" "a" "b" "a")))
          "a,a,b,b")
  (expect "sort of one" (join (list-sort (list "only"))) "only")
  ;; Annotated, and it has to be: `(list-empty)` says nothing about its element
  ;; type, and a constraint must be discharged at a type. Unannotated this is a
  ;; Bjolang error rather than an `object` reaching C#.
  (def (: no-strings (List string)) (list-empty))
  (expect "sort of none" (list-empty? (list-sort no-strings)) #t)

  ;; An empty list has no smallest element, so it says so.
  (expect "min of a list" (match (list-min (list 5 3 9)) ((Some m) m) (None -1)) 3)
  (expect "max of a list" (match (list-max (list 5 3 9)) ((Some m) m) (None -1)) 9)
  (expect "min of strings"
          (match (list-min (list "pear" "apple")) ((Some m) m) (None "?"))
          "apple")
  (expect "min of an empty list" (none? (list-min no-strings)) #t)

  ;; Three-way, through a constraint this module wrote itself.
  (expect "middle of ints" (middle-of 7 3 5) 5)
  (expect "middle of strings" (middle-of "pear" "apple" "fig") "fig")

  (expect "reverse sort"
          (join (longest-first (list "b" "c" "a")))
          "c,b,a")

  ;; A type this program declared, ordered by one method — and then reused by
  ;; every function above, none of which knows it exists.
  (def vs (list (v 2 1) (v 1 9) (v 2 0)))
  (expect "sorting a type of our own" (join-versions (list-sort vs)) " 1.9 2.0 2.1")
  (expect "least of our own" (show-version (least (v 3 0) (v 1 0))) "1.0")
  (expect "min of our own"
          (match (list-min vs) ((Some m) (show-version m)) (None "?"))
          "1.9")
  (expect "the predicates too" (less? (v 1 0) (v 1 1)) #t)
  (expect "recursive and constrained" (smallest (list 5 3 9) 7) 3)
  (expect "recursive at a string" (smallest (list "pear" "apple") "zebra") "apple")
  (expect "recursive at our own type"
          (show-version (smallest vs (v 9 9)))
          "1.9")
  (expect "and a constrained generic of ours"
          (show-version (middle-of (v 3 0) (v 1 0) (v 2 0)))
          "2.0")
  0)
