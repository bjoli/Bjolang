;; Docs for std/mutable/set.bjo, read through (:doc #:file "set.bjodoc"). The
;; texts are samizdat markup: code in prose is @code{...}.

(:doc #:module
  (summary "In-place hash set backed directly by .NET HashSet<T>.")
  (see MutableSet mutableset mutableset-add! mutableset-contains? mutableset-union!)
  (example """
    (import (std mutable set))

    (def seen (mutableset))
    (mutableset-add! seen "a")
    (mutableset-add! seen "a")       ; already a member: nothing changes
    (mutableset-contains? seen "a")  ; #t

    (def other (list->mutableset (list "b" "c")))
    (mutableset-union! seen other)   ; seen now contains "a", "b", and "c"
    (mutableset-length seen)         ; 3
    """)
  (reference """
    @code{(MutableSet a)} directly aliases .NET @code{HashSet<T>}. Adding,
    removing, and membership tests run in expected O(1) time. Foreign methods
    accepting @code{HashSet<T>} accept @code{MutableSet} directly.

    @strong{Mutability.} Operations such as @code{mutableset-add!} modify the
    set in place. All references observe modifications immediately. Unlike
    @code{TransientHashSet} (which is frozen back into an immutable
    @code{HashSet}), a @code{MutableSet} remains mutable indefinitely.

    @strong{In-place set algebra.} Set algebraic operations
    (@code{mutableset-union!}, @code{mutableset-intersect!},
    @code{mutableset-difference!}, @code{mutableset-symmetric-difference!})
    mutate the first argument in place without modifying the second argument.
    To produce a new independent set, use persistent @code{hashset-union} or
    clone the set first with @code{mutableset-copy}. Relational predicates
    (@code{mutableset-subset?}, @code{mutableset-superset?},
    @code{mutableset-overlaps?}) do not modify their arguments.

    @strong{Element comparison.} Elements are compared using .NET's default
    equality comparer (@code{EqualityComparer<T>.Default}). For types defined in
    Bjolang, this resolves to the type's @code{Eq} instance. Modifying elements
    after insertion leads to undefined lookup behavior.

    @strong{Iteration order.} Sets are unordered; iteration order reflects
    internal bucket layout.

    @strong{Iteration safety.} Iterating over a set (@code{mutableset->seq},
    @code{for-each}, or an enumerator) reads the live table directly. Mutating
    the set during traversal raises @code{System.InvalidOperationException}.
    To mutate during iteration, take a snapshot via @code{mutableset->list} or
    use @code{mutableset-remove-where!}.

    @strong{Equality and hashing.} Two sets are @code{=} if they contain
    identical elements according to .NET equality. @code{eq-hash} raises an
    exception to prevent using mutable sets as hash table keys.

    @strong{Thread safety.} Mutable sets are not thread-safe. Concurrent
    mutations require external locking.

    @strong{Traits.} Implements @code{Refable} (where @code{(ref s x)} tests
    membership), @code{Iterable}, @code{Collection}, @code{Addable!}, @code{Eq},
    @code{Written} and @code{Displayed}. Note that @code{add!} from @code{Addable!} returns unit
    and does not report whether the element was new.
    """))

;; ---------------------------------------------------------------------------
;; The set
;; ---------------------------------------------------------------------------

(:doc MutableSet
  (summary "In-place hash set of %a (aliases .NET HashSet<T>).")
  (tparam %a "The element type (compared with .NET equality).")
  (see mutableset hashset->mutableset HashSet))

(:doc MutableSetEnumerator
  (summary "One walk of a MutableSet, with .NET's enumerator protocol.")
  (tparam %a "The element type.")
  (see mutableset-enumerator mutableset-enumerator-next! mutableset-enumerator-current)
  (reference """
    .NET's hash set enumerator, a struct, in a heap cell, so that it can be
    held and stepped: one allocation for the walk, none per element.
    """))

(:doc mutableset
  (summary "Creates an empty mutable set.")
  (returns "A new empty set.")
  (see list->mutableset))

(:doc mutableset-length
  (summary "Returns the number of elements in the set.")
  (arg s "The set.")
  (returns "The count of elements.")
  (see mutableset-empty?))

(:doc mutableset-empty?
  (summary "Tests if the set contains no elements.")
  (arg s "The set.")
  (returns "#t if empty, otherwise #f.")
  (see mutableset-length))

(:doc mutableset-add!
  (summary "Makes an element a member of the set.")
  (arg s "The set to modify.")
  (arg x "The element to add.")
  (see mutableset-add-new! mutableset-try-add-new! mutableset-add-all! mutableset-remove!)
  (reference """
    Adding an element that is already a member is not a failure:
    afterwards it is a member, which is all this says. It is the
    @code{add!} of the @code{Addable!} trait. To learn whether x was new,
    use @code{mutableset-try-add-new!}.
    """))

(:doc mutableset-add-new!
  (summary "Adds an element that must be new.")
  (arg s "The set to modify.")
  (arg x "The element to add.")
  (raises System.ArgumentException "When an element equal to x is already in s. s is left as it was.")
  (see mutableset-try-add-new! mutableset-add!))

(:doc mutableset-try-add-new!
  (summary "Adds an element that must be new, or answers the equal element already there.")
  (arg s "The set to modify.")
  (arg x "The element to add.")
  (returns "(Ok unit) when x was added; (Err y) when s already holds y, equal to x, and s is left as it was.")
  (see mutableset-add-new! mutableset-add!)
  (example """
    (match (mutableset-try-add-new! seen url)
      ((Ok _) (spawn (fetch url)))      ; first time: fetch it
      ((Err _) unit))                   ; seen before
    """)
  (reference """
    @code{mutableset-add-new!} with the failure as a value. The @code{Err}
    carries the element the set holds, which may be a different object
    from x: interning a value is a @code{try-add-new!} that keeps what the
    @code{Err} answers.
    """))

(:doc mutableset-add-all!
  (summary "Adds all elements from a sequence into the set.")
  (arg s "The set to modify.")
  (arg xs "Sequence of elements to add.")
  (see mutableset-add! mutableset-union!))

(:doc mutableset-remove!
  (summary "Removes an element from the set, returning #t if found.")
  (arg s "The set to modify.")
  (arg x "The element to remove.")
  (returns "#t if x was present and removed, #f otherwise.")
  (see mutableset-add! mutableset-remove-all! mutableset-remove-where!))

(:doc mutableset-remove-all!
  (summary "Removes all elements in a sequence from the set.")
  (arg s "The set to modify.")
  (arg xs "Sequence of elements to remove.")
  (see mutableset-remove! mutableset-difference!))

(:doc mutableset-remove-where!
  (summary "Removes all elements satisfying a predicate.")
  (arg s "The set to modify.")
  (arg pred "Predicate function returning #t to remove an element.")
  (returns "The number of elements removed.")
  (see mutableset-remove!)
  (example """
    (mutableset-remove-where! s (fun (x) (< x 0)))   ; remove negative numbers
    """))

(:doc mutableset-clear!
  (summary "Removes all elements from the set.")
  (arg s "The set to clear."))

(:doc mutableset-contains?
  (summary "Tests if an element is in the set.")
  (arg s "The set.")
  (arg x "The element to locate.")
  (returns "#t if x is present, otherwise #f.")
  (see ref))

;; ---------------------------------------------------------------------------
;; Set algebra
;; ---------------------------------------------------------------------------

(:doc mutableset-union!
  (summary "Adds all elements from b into a, mutating a in place.")
  (arg a "The target set to mutate.")
  (arg b "The source set (unmodified).")
  (see mutableset-add-all! mutableset-intersect!))

(:doc mutableset-intersect!
  (summary "Retains only elements in a that are also in b, mutating a in place.")
  (arg a "The target set to mutate.")
  (arg b "The reference set (unmodified).")
  (see mutableset-union! mutableset-difference!))

(:doc mutableset-difference!
  (summary "Removes all elements in b from a, mutating a in place.")
  (arg a "The target set to mutate.")
  (arg b "The elements to remove (unmodified).")
  (see mutableset-remove-all! mutableset-symmetric-difference!))

(:doc mutableset-symmetric-difference!
  (summary "Mutates a to contain elements present in either a or b, but not both.")
  (arg a "The target set to mutate.")
  (arg b "The other set (unmodified).")
  (see mutableset-difference! mutableset-union!))

;; ---------------------------------------------------------------------------
;; Comparisons
;; ---------------------------------------------------------------------------

(:doc mutableset-subset?
  (summary "Tests if a is a subset of b.")
  (arg a "The candidate subset.")
  (arg b "The target set.")
  (returns "#t if all elements in a are present in b, otherwise #f.")
  (see mutableset-superset?))

(:doc mutableset-superset?
  (summary "Tests if a is a superset of b.")
  (arg a "The candidate superset.")
  (arg b "The target set.")
  (returns "#t if all elements in b are present in a, otherwise #f.")
  (see mutableset-subset?))

(:doc mutableset-overlaps?
  (summary "Tests if a and b share at least one common element.")
  (arg a "First set.")
  (arg b "Second set.")
  (returns "#t if a and b intersect, otherwise #f.")
  (see mutableset-intersect!))

(:doc mutableset-copy
  (summary "Creates a shallow copy of the set.")
  (arg s "The set to copy.")
  (returns "A new mutable set with identical elements. Elements are not cloned.")
  (see mutableset->hashset))

;; ---------------------------------------------------------------------------
;; Traversals
;; ---------------------------------------------------------------------------

(:doc mutableset-enumerator
  (summary "Starts one walk of the set, with .NET's enumerator protocol.")
  (arg s "The set to walk.")
  (returns "A new enumerator, before the first element.")
  (see mutableset-enumerator-next! mutableset-enumerator-current mutableset-for-each)
  (example """
    (def e (mutableset-enumerator s))
    (let go ()
      (when (mutableset-enumerator-next! e)
        (println (mutableset-enumerator-current e))
        (go)))
    """)
  (reference """
    @code{mutableset-enumerator-next!} is .NET's @code{MoveNext}, and
    @code{mutableset-enumerator-current} is @code{Current}. It is not a
    cursor: stepping it moves it for everyone who holds it, where a cursor
    such as @code{vec-cursor} is a position that does not change. A
    @code{for-each}, a @code{loop} or a @code{:for} does the stepping, so
    most programs never hold one.
    """))

(:doc mutableset-enumerator-next!
  (summary "Steps the enumerator to the next element, and answers whether there is one.")
  (arg e "The enumerator.")
  (returns "#t when e is on an element; #f when the walk is over.")
  (see mutableset-enumerator-current)
  (reference """
    .NET's @code{MoveNext}: call it once before each
    @code{mutableset-enumerator-current}, the first time too.
    """))

(:doc mutableset-enumerator-current
  (summary "The element the enumerator is on.")
  (arg e "The enumerator, after mutableset-enumerator-next! returned #t.")
  (returns "The element.")
  (see mutableset-enumerator-next!))

(:doc mutableset-for-each
  (summary "Applies a function to each element in the set.")
  (arg f "Function to call on each element.")
  (arg s "The set to iterate over.")
  (see mutableset-enumerator for-each)
  (reference """
    Applies f to each element in arbitrary order. Mutating the set inside f
    raises @code{System.InvalidOperationException}.
    """))

;; ---------------------------------------------------------------------------
;; Conversions
;; ---------------------------------------------------------------------------

(:doc list->mutableset
  (summary "Constructs a new mutable set from a list.")
  (arg xs "Source list. Duplicate elements are added once.")
  (returns "A new mutable set.")
  (see mutableset->list))

(:doc mutableset->list
  (summary "Converts set elements to a list.")
  (arg s "The source set.")
  (returns "A new list containing all elements in traversal order.")
  (see list->mutableset))

(:doc vec->mutableset
  (summary "Constructs a new mutable set from a vector.")
  (arg v "Source vector. Duplicate elements are added once.")
  (returns "A new mutable set.")
  (see mutableset->vec))

(:doc mutableset->vec
  (summary "Converts set elements to a vector.")
  (arg s "The source set.")
  (returns "A new vector containing all elements in traversal order.")
  (see vec->mutableset))

(:doc seq->mutableset
  (summary "Constructs a new mutable set from a sequence.")
  (arg xs "Source sequence. Duplicate elements are added once.")
  (returns "A new mutable set.")
  (see mutableset->seq))

(:doc mutableset->seq
  (summary "Views set elements as a sequence.")
  (arg s "The source set.")
  (returns "A Seq iterating over the set.")
  (see seq->mutableset mutableset->list)
  (reference """
    Views the live set. Modifying the set during sequence traversal raises
    @code{System.InvalidOperationException}. To take an immutable snapshot,
    use @code{mutableset->list} or @code{mutableset->vec}.
    """))

(:doc hashset->mutableset
  (summary "Constructs a new mutable set from an immutable persistent HashSet.")
  (arg s "The source persistent set.")
  (returns "A new mutable set containing all elements.")
  (see mutableset->hashset))

(:doc mutableset->hashset
  (summary "Converts a mutable set into an immutable persistent HashSet.")
  (arg s "The source mutable set.")
  (returns "A new persistent HashSet. Subsequent modifications to s do not affect it.")
  (see hashset->mutableset))

;; ---------------------------------------------------------------------------
;; Printing
;; ---------------------------------------------------------------------------

(:doc mutableset->str
  (summary "Deprecated: use @code{displayed}. Formats the set as text in the form #mset(a b c).")
  (arg s "The set to format.")
  (returns "Formatted string representation using displayed for each element.")
  (example """
    (displayed (list->mutableset (list 1)))   ; "#mset(1)"
    """)
  (reference """
    The same text as @code{displayed} gives for a mutable set.
    """))
