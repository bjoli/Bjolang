;; A module whose name is a C# keyword. Imported by 225_keyword_module_name.bjo.
;;
;; The module name is part of every type this module declares, and of every
;; impl class generated beside one, so a name that has to be escaped in C#
;; used to produce a class name with an `@` in the middle of it.

(import (std prelude))
(export Held held held-value)

(type (: Held (Record (: value int))))

(: held (-> int Held))
(defun (held n) (Held (value n)))

(: held-value (-> Held int))
(defun (held-value h) (record-ref h value))

(impl (->str Held)
  (defun (->str h) (str "held " (int->string (held-value h)))))
