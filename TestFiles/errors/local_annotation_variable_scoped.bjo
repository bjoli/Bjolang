;; A local function's annotation variable `%b` is one type in its whole body,
;; so a function nested in it that returns `y` returns that `%b`, not a fresh
;; type each call.
;; EXPECT-ERROR: found    %b

(import (std prelude))

(defun (main args)
  (defun (f (: y %b))
    (defun (g z) y)
    (string-length (g 0)))
  (println (->str (f 5)))
  0)
