;; Docs for std/read.bjo, read through (:doc #:file "read.bjodoc"). The
;; texts are samizdat markup: code in prose is @code{...}.

(:doc #:module
  (summary "The reader of Bjolang source: the forms of a text as Syntax, with their ranges, as the compiler reads them.")
  (see read-source read-source-file read-tokens ReadError syntax-range syntax-dump)
  (example """
    (import (std read))

    (match (read-source-file "tasks.bjo")
      ((Ok forms) (println (int->string (list-length forms))))
      ((Err e) (println (read-error-message e))))
    """)
  (reference """
    A form is a @code{Syntax}, the type a macro receives (see
    @code{SList}). Each form has the range it was read from: see
    @code{syntax-range}, @code{syntax-line} and @code{syntax-file}.

    @strong{What the reader does.} The forms are what the compiler reads
    before it parses them, with the same reader syntax expanded:

    @read-table{
    | @code{'(a b)}          | @code{(quoted-list a b)}                  |
    | @code{[a b]}           | @code{(vec-literal a b)}                  |
    | @code{#[a b]}          | @code{(array-literal a b)}                |
    | @code{{f x clause}}    | @code{(comprehension f x clause)}         |
    | @code{#(f & 1)}        | @code{(fun (&1__1) (f &1__1 1))}          |
    | @code{#name(a)}        | @code{(#name a)}                          |
    | @code{(a . b)}         | @code{(Tuple a b)}                        |
    | @code{#'x}             | @code{(syntax-quote x)}                   |
    | @code{#"a${x}"}        | @code{(str "a" (displayed x))}            |
    | @code{<9.81 m/s^2>}    | @code{(quantity "9.81" "m/s^2")}          |
    }

    The @code{str} and @code{displayed} of an interpolated string have the
    origin @code{Resolved}. @code{#t} and @code{#f} are the symbols of
    those names. A comment is not read.

    @strong{Ranges.} A line counts from 1 and a column from 0, in code
    points, as the compiler counts them. A character above U+FFFF is one
    column, and so is a @code{\r}. A range also has the byte offsets of its
    start and its end in the UTF-8 text, so that a tool can cut the text of
    a form out of the bytes.
    """))

(:doc ReadError
  (summary "Why a text could not be read.")
  (case SyntaxError "The text is not Bjolang: the message, as the compiler writes it, and the line and the column, from 1.")
  (case FileError "@code{read-source-file} could not read the file: the @code{FsError}.")
  (see read-error-message read-source))

(:doc read-error-message
  (summary "The message of a read error.")
  (arg e "The error.")
  (returns "The compiler's message for a @code{SyntaxError}, and @code{fs-error-message} of a @code{FileError}."))

(:doc read-source
  (summary "The forms of a text, as the compiler reads them.")
  (arg text "The source.")
  (key file "The file the ranges name, and the file messages name. Without it, a message names @code{<unknown>}.")
  (returns "The forms, or the first @code{SyntaxError}.")
  (see read-source-file syntax-dump)
  (example """
    (read-source "(+ 1 2) [x]")
    ;; => (Ok the forms (+ 1 2) and (vec-literal x))
    """)
  (reference """
    The whole text is read into tokens before any form is made, as the
    compiler does. An error in the tokens, such as a string with no end,
    therefore comes before an error in the forms, such as a bracket with
    no partner, wherever the two are.
    """))

(:doc read-source-file
  (summary "The forms of a file, as the compiler reads them.")
  (arg path "The file.")
  (returns "The forms, a @code{SyntaxError}, or a @code{FileError}.")
  (see read-source)
  (reference """
    A UTF-8 byte order mark at the start of the file is not read. The
    offsets count it, so they are offsets in the file. Bytes that are not
    UTF-8 are read as U+FFFD, as the compiler reads them, and the offsets
    are then offsets in the UTF-8 of that text.
    """))

(:doc SourceRange
  (summary "Where a piece of syntax is in its text.")
  (field start-line "The line of the start, from 1.")
  (field start-column "The column of the start, in code points from 0.")
  (field start-offset "The byte offset of the start in the UTF-8 text, or -1.")
  (field end-line "The line of the end.")
  (field end-column "The column just past the end.")
  (field end-offset "The byte offset just past the end, or -1.")
  (see syntax-range))

(:doc syntax-range
  (summary "The range of a piece of syntax.")
  (arg s "The syntax.")
  (returns "Its lines, columns and byte offsets. The offsets are -1 when the reader did not record them: this reader records them, and the compiler's reader does not.")
  (see SourceRange read-source)
  (example """
    (match (read-source "x (+ 1 2)")
      ((Ok (Cons _ (Cons form Nil)))
       (record-ref (syntax-range form) start-offset))
      (_ -1))
    ;; => 2
    """))

(:doc TokenKind
  (summary "What a token of @code{read-tokens} is.")
  (case TokOpen "An opening bracket: @code{(}, @code{[} or @code{{}.")
  (case TokClose "A closing bracket.")
  (case TokString "A string: plain, raw, or @code{#\"...\"} with its holes.")
  (case TokAtom "Any other token the compiler reads: a symbol, a number, a keyword, a character, a boolean, a prefix such as @code{'}, @code{,@} or @code{#'}, a @code{#} before a bracket, or a quantity such as @code{<9.81 m>}.")
  (case TokComment "A @code{;} and the rest of its line, without the line break.")
  (case TokSpace "White space on one line.")
  (case TokNewline "A line break, @code{\\n} or @code{\\r\\n}.")
  (see SourceToken read-tokens))

(:doc SourceToken
  (summary "A token of a text, as it is written.")
  (field kind "What it is.")
  (field text "Its text, as written.")
  (field range "Where it is, with its byte offsets.")
  (see TokenKind read-tokens))

(:doc read-tokens
  (summary "The tokens of a text as they are written, comments and spaces included.")
  (arg text "The source.")
  (key file "The file messages name. Without it, a message names @code{<unknown>}.")
  (returns "The tokens in order, or the first @code{SyntaxError} the compiler's lexer finds.")
  (see fold-tokens read-source TokenKind SourceToken)
  (example """
    (match (read-tokens "(f 'x) ; done")
      ((Ok tokens) (list-map (fun (t) (record-ref t text)) tokens))
      ((Err e) (list (read-error-message e))))
    ;; => ("(" "f" " " "'x" ")" " " "; done")
    """)
  (reference """
    For a tool that keeps the text as it is written, such as a formatter.

    - The texts of the tokens, in order, are the whole text.
    - A token's text shares the memory of @code{text}.
    - The tokens are the compiler's. A text the compiler cannot lex is a
      @code{SyntaxError}. A bracket with no partner is not an error here:
      that is a form error, and @code{read-source} finds it.
    - A @code{#\"...\"} is one @code{TokString}, and a quantity is one
      @code{TokAtom}, although the compiler expands both.
    - A prefix is a token of its own: @code{,x} is @code{,} and @code{x}, and
      @code{#'x} is @code{#'} and @code{x}. A quoted symbol such as
      @code{'x} is one token, as the compiler reads it.
    """))

(:doc fold-tokens
  (summary "Folds a function over the tokens of a text as they are written.")
  (arg text "The source.")
  (arg f "Takes a token and what the tokens before it made, and returns what it makes with them.")
  (arg init "What no token makes.")
  (key file "The file messages name.")
  (returns "What the last token makes, or the first @code{SyntaxError} the compiler's lexer finds. The text is lexed whole before @code{f} sees a token, so an error comes before any call of @code{f}.")
  (see read-tokens)
  (reference """
    The tokens are those of @code{read-tokens}, in the same order. Use it
    when what is made of the tokens is not a list of them: a list of every
    token of a large file costs more than lexing it.
    """))

(:doc syntax-dump
  (summary "Forms in the text that the compiler writes for @code{--dump-read}.")
  (arg forms "The forms.")
  (returns "A line per form and per item of a form, with its kind, its text, its range and its byte offsets.")
  (reference """
    For comparing this reader with the compiler's: tools/read_conformance.py
    compares the two over the source tree. A fresh name that @code{#(...)}
    makes is written by the order it first appears in, so two readers with
    different counters write the same text.
    """))
