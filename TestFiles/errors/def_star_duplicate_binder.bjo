;; Every clause of a `def*` binds into one scope — the sequel's — so a name
;; bound by two of them is refused rather than silently taken from the later
;; clause.

;; EXPECT-ERROR: is bound by clause 1 of this def* as well

(import (std prelude))

(: f (-> (Option int) (Option int) (Option int)))
(defun (f a b)
  (def* ((Some n) a)
        ((Some n) b))
  (Some n))
