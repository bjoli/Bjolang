;; An unrecognised marker on a type definition.
;;
;; The compiler names the marker and does not ignore it. A marker that does
;; nothing is a declaration that the author did not really write.

;; EXPECT-ERROR: Unknown marker #:banana
;; EXPECT-ERROR: The only one is #:opaque

(type (: Crate #:banana (Union MkCrate)))

(defun (main args) 0)
