;; text/encodings.bjo
;;
;; Every character encoding .NET knows, as a value to hand to
;; `bytes->string`, `string->bytes` and `reencode-input-port`, and finding
;; one by name or code page.
;;
;; The names are .NET's, lower-cased: `utf-8`, `windows-1252`, `dos-862`,
;; `shift_jis`. Two kinds differ. .NET's `utf-16` and `utf-32` are
;; little-endian and are `utf-16le` and `utf-32le` here, next to `utf-16be`
;; and `utf-32be`. Where .NET gives one name to two code pages, the less
;; common one is `cp` and its number: `euc-jp` is 51932 and `cp20932` the
;; other, `iso-2022-jp` is 50220 and `cp50222` the other.
;;
;; Each value is a property of `Bjolang.Runtime.Encodings` that makes its
;; encoding the first time it is read, so importing the module makes none of
;; them and a program pays only for the ones it uses.

(export
  encoding-named encoding-of-code-page encoding-name
  asmo-708 big5 cp1025 cp20932 cp50222 cp866 cp875 csiso2022jp dos-720
  dos-862 euc-cn euc-jp euc-kr gb18030 gb2312 hz-gb-2312 ibm-thai ibm00858
  ibm00924 ibm01047 ibm01140 ibm01141 ibm01142 ibm01143 ibm01144 ibm01145
  ibm01146 ibm01147 ibm01148 ibm01149 ibm037 ibm1026 ibm273 ibm277 ibm278
  ibm280 ibm284 ibm285 ibm290 ibm297 ibm420 ibm423 ibm424 ibm437 ibm500
  ibm737 ibm775 ibm850 ibm852 ibm855 ibm857 ibm860 ibm861 ibm863 ibm864
  ibm865 ibm869 ibm870 ibm871 ibm880 ibm905 iso-2022-jp iso-2022-kr
  iso-8859-1 iso-8859-13 iso-8859-15 iso-8859-2 iso-8859-3 iso-8859-4
  iso-8859-5 iso-8859-6 iso-8859-7 iso-8859-8 iso-8859-8-i iso-8859-9 johab
  koi8-r koi8-u ks_c_5601-1987 macintosh shift_jis us-ascii utf-16be
  utf-16le utf-32be utf-32le utf-8 windows-1250 windows-1251 windows-1252
  windows-1253 windows-1254 windows-1255 windows-1256 windows-1257
  windows-1258 windows-874 x-chinese-cns x-chinese-eten x-cp20001 x-cp20003
  x-cp20004 x-cp20005 x-cp20261 x-cp20269 x-cp20936 x-cp20949 x-cp50227
  x-ebcdic-koreanextended x-europa x-ia5 x-ia5-german x-ia5-norwegian
  x-ia5-swedish x-iscii-as x-iscii-be x-iscii-de x-iscii-gu x-iscii-ka
  x-iscii-ma x-iscii-or x-iscii-pa x-iscii-ta x-iscii-te x-mac-arabic
  x-mac-ce x-mac-chinesesimp x-mac-chinesetrad x-mac-croatian x-mac-cyrillic
  x-mac-greek x-mac-hebrew x-mac-icelandic x-mac-japanese x-mac-korean
  x-mac-romanian x-mac-thai x-mac-turkish x-mac-ukrainian)

(import (std prelude))

(:doc #:file "encodings.bjodoc")

(import/extern
  (clr-named        (: Bjolang.Runtime.Encodings.Named (-> string (Option Encoding))))
  (clr-of-code-page (: Bjolang.Runtime.Encodings.OfCodePage (-> int (Option Encoding))))
  (clr-name-of      (: Bjolang.Runtime.Encodings.NameOf (-> Encoding string))))

(: encoding-named (-> string (Option Encoding)))
(defun (encoding-named name) (clr-named name))

(: encoding-of-code-page (-> int (Option Encoding)))
(defun (encoding-of-code-page code-page) (clr-of-code-page code-page))

(: encoding-name (-> Encoding string))
(defun (encoding-name encoding) (clr-name-of encoding))

