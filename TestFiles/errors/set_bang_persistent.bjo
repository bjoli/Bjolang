;; `set!` with a key writes in place, through `Settable!`, and a persistent Vec
;; has no place to write: the message says it is persistent, and that
;; `Settable`, which answers a copy, is what it has.

;; EXPECT-ERROR: no implementation of trait 'Settable!' for '(Vec int)'
;; EXPECT-ERROR: is persistent, so it is not written in place: it implements 'Settable'

(import (std prelude))

(defun (main args)
  (def v [1 2 3])
  (set! v 0 9)
  0)
