;; A doc on its own documents nothing the entry defines.
(:doc twice (summary "Doubles.") (arg x "A number.") (returns "2x."))
;; In the same entry as its definition, it is checked against it.
(: twice (-> int int)) (defun (twice x) (* 2 x)) (:doc twice (summary "Doubles.") (arg x "A number.") (returns "2x."))
(: half (-> int int)) (defun (half x) (/ x 2)) (:doc half (summary "Halves.") (arg y "The number.") (returns "x/2."))
(twice 4)
