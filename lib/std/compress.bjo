;; std/compress.bjo — gzip, zlib, deflate and Brotli, as ports over ports.
;;
;; - Each format has an input port that decompresses what it reads from a
;;   port, and an output port that compresses what is written to it into a
;;   port. The compressor is .NET's, over the port's stream view.
;; - The new port is owned by the ambient scope, as a file port is. Closing
;;   it, or the scope's end, ends the compressed data: an output port writes
;;   its last block and trailer into the port under it. The port under it is
;;   left open.
;; - Reads and writes suspend a fiber where the port under them would.

(export
  CompressLevel
  gzip-input-port gzip-output-port zlib-input-port zlib-output-port
  deflate-input-port deflate-output-port brotli-input-port brotli-output-port)

(:doc #:file "compress.bjodoc")

(import (std prelude))
(import (only (std ports) ClrStream stream->input-port stream->output-port))

;; How hard an output port compresses.
(type (: CompressLevel (Union CompressFastest CompressOptimal CompressSmallest CompressNone)))

(import/class
  (CompressionMode (: System.IO.Compression.CompressionMode))
  (CompressionLevel (: System.IO.Compression.CompressionLevel))
  ;; Each format's stream, once for each constructor: to decompress, and to
  ;; compress at a level. The bool is leaveOpen.
  (GZipIn (: System.IO.Compression.GZipStream (-> ClrStream CompressionMode bool GZipIn)))
  (GZipOut (: System.IO.Compression.GZipStream (-> ClrStream CompressionLevel bool GZipOut)))
  (ZLibIn (: System.IO.Compression.ZLibStream (-> ClrStream CompressionMode bool ZLibIn)))
  (ZLibOut (: System.IO.Compression.ZLibStream (-> ClrStream CompressionLevel bool ZLibOut)))
  (DeflateIn (: System.IO.Compression.DeflateStream (-> ClrStream CompressionMode bool DeflateIn)))
  (DeflateOut (: System.IO.Compression.DeflateStream (-> ClrStream CompressionLevel bool DeflateOut)))
  (BrotliIn (: System.IO.Compression.BrotliStream (-> ClrStream CompressionMode bool BrotliIn)))
  (BrotliOut (: System.IO.Compression.BrotliStream (-> ClrStream CompressionLevel bool BrotliOut))))

(import/extern
  (input-view (: Bjolang.Runtime.BjoInputPort.AsStream (-> InputPort ClrStream)))
  (output-view (: Bjolang.Runtime.BjoOutputPort.AsStream (-> OutputPort ClrStream))))

(: (-> CompressLevel CompressionLevel))
(defun (clr-level level)
  (match level
    (CompressFastest CompressionLevel.Fastest)
    (CompressOptimal CompressionLevel.Optimal)
    (CompressSmallest CompressionLevel.SmallestSize)
    (CompressNone CompressionLevel.NoCompression)))

(: (-> InputPort InputPort))
(defun (gzip-input-port p)
  (stream->input-port (cast ClrStream (GZipIn. (input-view p) CompressionMode.Decompress #t))))

(: (-> OutputPort (#:level CompressLevel) OutputPort))
(defun (gzip-output-port p #:level CompressOptimal)
  (stream->output-port (cast ClrStream (GZipOut. (output-view p) (clr-level level) #t))))

(: (-> InputPort InputPort))
(defun (zlib-input-port p)
  (stream->input-port (cast ClrStream (ZLibIn. (input-view p) CompressionMode.Decompress #t))))

(: (-> OutputPort (#:level CompressLevel) OutputPort))
(defun (zlib-output-port p #:level CompressOptimal)
  (stream->output-port (cast ClrStream (ZLibOut. (output-view p) (clr-level level) #t))))

(: (-> InputPort InputPort))
(defun (deflate-input-port p)
  (stream->input-port (cast ClrStream (DeflateIn. (input-view p) CompressionMode.Decompress #t))))

(: (-> OutputPort (#:level CompressLevel) OutputPort))
(defun (deflate-output-port p #:level CompressOptimal)
  (stream->output-port (cast ClrStream (DeflateOut. (output-view p) (clr-level level) #t))))

(: (-> InputPort InputPort))
(defun (brotli-input-port p)
  (stream->input-port (cast ClrStream (BrotliIn. (input-view p) CompressionMode.Decompress #t))))

(: (-> OutputPort (#:level CompressLevel) OutputPort))
(defun (brotli-output-port p #:level CompressOptimal)
  (stream->output-port (cast ClrStream (BrotliOut. (output-view p) (clr-level level) #t))))
