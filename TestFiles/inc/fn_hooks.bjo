;; Functions and defs holding functions, for an importer to pass by name.
;; `274_function_values.bjo` and `codegen/function_values.bjo`.

(export handler set-handler! doubled tripled)

(import (std prelude))

(: handler (-> int int))
(def/mutable handler (fun (x) (+ x 1)))

(: set-handler! (-> (-> int int) void))
(defun (set-handler! f) (set! handler f))

(: doubled (-> int int))
(def doubled (fun (x) (* x 2)))

(: tripled (-> int int))
(defun (tripled x) (* x 3))
