;; '(...) is quasiquote: symbols inside are literal Symbol data values,
;; not variable references. Write ,expr to splice a computed value in.
;;
;; The list is still HM-typed: all elements must share a type.
;; '(a b c)     → (List Symbol)   — three symbols
;; '(,x ,y)     → (List int)      — when x,y : int
;; '(tag ,name) → (List Symbol)   — when name : Symbol

(defun (main args)
  ;; Pure symbol list — no bindings needed in scope.
  (def syms '(hello world bjolang))
  (println (length syms))            ;; 3

  ;; ,x splices a computed int — whole list is (List int).
  (def n 42)
  (println (fold + 0 '(,n ,n)))     ;; 84

  ;; ,name splices a Symbol value — whole list is (List Symbol).
  (def language 'bjolang)
  (def tagged '(language ,language))
  (println (length tagged))          ;; 2

  ;; Nested '(...) is a (List Symbol) element of the outer list.
  ;; Outer must then be (List (List Symbol)).
  (def pair '('(a b) '(c d)))
  (println (length pair))            ;; 2

  0)
