;; Foreign .NET interop: static methods imported with `import/extern`.
;;
;; Each clause names a fully qualified static method and binds it as an ordinary
;; Bjolang function. The signature is optional — it is checked against the
;; overload reflection selects, rather than used instead of it — but writing one
;; is what lets the name be used as a *value*, since a .NET method group is not
;; one.
(import (std prelude))
(import (std simpletest))

;; `console-write-line` rather than `write-line`: the prelude binds the latter
;; as the port operation, and an ordinary binding wins over an extern alias —
;; the extern registry is one flat namespace, so the rule has to run that way.
(import/extern
  (console-write-line (: System.Console.WriteLine (-> string void)))
  (concat2 (: System.String.Concat (-> string string string)))
  (is-empty? (: System.String.IsNullOrEmpty (-> string bool)))
  (abs-int (: System.Math.Abs (-> int int)))
  (max-int (: System.Math.Max (-> int int int))))

(defun (main)
  (console-write-line "Hello from static extern!")

  (expect "Concat" (concat2 "foreign " "functions") "foreign functions")
  (expect "Math.Abs" (abs-int -7) 7)

  (if (is-empty? "") (println "ok: IsNullOrEmpty") (println "FAILURE: IsNullOrEmpty"))

  ;; The overload is chosen from the argument types: `Math.Max` has eight of
  ;; them, and two ints select the `int` one rather than the `long` or `double`.
  (expect "Math.Max" (max-int 3 9) 9)

  ;; A first-class use. There is no .NET value to refer to, so this is the
  ;; eta-expansion the declared signature makes possible.
  (def magnitude abs-int)
  (expect "extern as a value" (magnitude -12) 12)

  0)
