;; A name an earlier entry defined, and the names an import brings in.
(def apple-count 3)
:complete (apple
(import (std random))
:complete (random-in
;; A prefixed import is offered under the name an entry writes.
(import (prefix (std random) "r/"))
:complete (r/random-b
;; REPL commands, at the start of an entry.
:complete :sh
;; Special forms are in no scope, and are offered all the same.
:complete (let/m
;; Names the entry being typed binds, before they are in any scope.
:complete (let ((xylophone 1)) (+ xyl
;; Module paths inside an import.
:complete (import (std rand
:complete (import (only (st
;; Nothing inside a string, a comment, or after #:.
:complete (println "rand
:complete (foo ; rand
:complete (foo #:rand
;; The cursor inside a word asks for what continues the part before it.
:complete (string-length
;; A foreign import a module published, under the module that bound it.
:complete (sqr
;; A trait the prelude re-exports, and its methods, under the module that
;; declared them.
:complete (Nu
:complete (even
:show even?
