;; Conditional implementations: `(impl (T (C %a)) (where (T %a)) ...)`.
;;
;; An impl that holds only where its type argument does. The clause is not a
;; note to the reader: it is a dictionary the impl class carries, so
;; the `(Displayed (List int))` class is built out of the `int` implementation
;; and the element's own format is what runs.
;;
;; The property being pinned down is the same one `070_blanket_impl.bjo` pins
;; down one level up. A blanket is only ever selected at a ground type, so
;; inside `(impl (Displayed (List %a)))` the element type `%a` is a variable and
;; the blanket cannot be — must not be — chosen for it: that would format every
;; element with `Object.ToString` no matter what impl it has. The where clause
;; is what defers the choice to the concrete element type instead.

(import (std prelude))
(import (std simpletest))

;; A local type with a format of its own. If a list ever formatted its elements
;; through the blanket, this is what would give it away: the blanket answers
;; `Object.ToString`, which for a union case is its C# class name.
(type (: Tag (Enum Red Green)))

(impl (Displayed Tag)
  (defun (displayed t)
    (match t
      (Red "red")
      (Green "green")))
  (defun (display-into t b) (stringbuilder-add-string! b (displayed t))))

;; A trait of this file's own, implemented conditionally over `Option`. Two
;; things it establishes that `Displayed` cannot: a conditional impl for a trait
;; that has *no* blanket, so the where clause is the only thing that can
;; discharge the obligation, and one written outside the prelude.
(def/trait (Size %a)
  (: size (-> %a int)))

(impl (Size int)
  (defun (size n) n))

(impl (Size string)
  (defun (size s) (string-length s)))

(impl (Size (Option %a))
  (where (Size %a))
  (defun (size o)
    (match o
      (None 0)
      ((Some v) (size v)))))

;; Written with the recursion rather than a loop on purpose: `(size (list-tail
;; xs))` is this very implementation at this very type, so the dictionary it
;; needs is the one the method is already running as. Rebuilding it there would
;; allocate one per element.
(impl (Size (List %a))
  (where (Size %a))
  (defun (size xs)
    (if (list-empty? xs)
        0
        (+ (size (list-head xs)) (size (list-tail xs))))))

;; The empty cases, named so that their element type is written somewhere.
(: (List int))
(def no-ints Nil)

(: (Option int))
(def no-number None)

;; A generic function with no where clause of its own. It acquires one:
;; `(Displayed %a)` at a `(List %b)` resolves to the conditional impl, which
;; leaves a `(Displayed %b)` for whoever instantiates this.
(: (-> %a string))
(defun (show x)
  (displayed x))

;; Two levels of the same thing, so the dictionary has to be *built* rather than
;; forwarded: the argument is a list of lists.
(: (-> (List (List %a)) string))
(defun (show-nested xs)
  (displayed xs))

;; The constraint written by hand rather than inferred, and forwarded to a
;; second constrained function.
(: (-> (List %a) int) (where (Size %a)))
(defun (total xs)
  (size xs))

(defun (main args)
  ;; Directly, at ground element types.
  (expect "ints" (displayed (list 1 2 3)) "(1 2 3)")
  (expect "strings" (displayed (list "a" "b")) "(a b)")
  (expect "empty" (displayed no-ints) "()")

  ;; The element's own impl, not the blanket's.
  (expect "element impl runs" (displayed (list Red Green)) "(red green)")

  ;; Nested: the outer dictionary holds the inner one.
  (expect "nested" (displayed (list (list 1) (list 2 3))) "((1) (2 3))")

  ;; Through a dictionary parameter rather than at the call itself.
  (expect "through a generic function" (show (list 1 2)) "(1 2)")
  (expect "generic, element impl" (show (list Red)) "(red)")
  (expect "generic over nesting" (show-nested (list (list 1 2))) "((1 2))")
  (expect "generic over nesting, element impl" (show-nested (list (list Red))) "((red))")

  ;; `println` is the generic display function, so this is the same path a
  ;; program actually uses.
  (println (list 1 2 3))

  ;; A trait with no blanket at all: every one of these is discharged by a where
  ;; clause and nothing else.
  (expect "conditional over Option" (size (Some 7)) 7)
  (expect "conditional over None" (size no-number) 0)
  (expect "conditional over List" (size (list 1 2 3)) 6)
  (expect "conditional, twice over" (size (list (Some 1) None (Some 2))) 3)
  (expect "strings measure their length" (size (list "ab" "c")) 3)
  (expect "forwarded by hand" (total (list 4 5)) 9)
  0)
