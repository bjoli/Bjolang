;; Shared helpers for the Advent of Code 2025 solutions.
(export input-lines parse-long digit)

;; The lines of the input file named by the first argument, with empty lines
;; at the end removed.
(: input-lines (-> (Vec string) (Vec string)))
(defun (input-lines args)
  (def lines (file-read-lines (ref args 0)))
  (let trim ((n (length lines)))
    (if (and (> n 0) (= "" (string-trim (ref lines (- n 1)))))
        (trim (- n 1))
        (vec-slice lines 0 n))))

;; The value of a decimal digit character.
(: digit (-> char int))
(defun (digit c) (- (char->int c) (char->int #\0)))

;; A decimal long, with an optional sign.
(: parse-long (-> string long))
(defun (parse-long s) (string->long s))
