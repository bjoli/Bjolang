;; A collector that does not implement `CollectorInto` cannot start from
;; something: a sum has nothing to be added to the back of.

;; EXPECT-ERROR: no implementation of trait 'CollectorInto' for '(prelude/Summing ?a)'
(import (std prelude))

(defun (main)
  (println {summing x #:into 5 (:for x (range 0 3))})
  0)
