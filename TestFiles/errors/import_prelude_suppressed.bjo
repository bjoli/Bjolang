;; Rule 7: a modifier written around the prelude's own path suppresses the
;; implicit import and is honoured, so a name it removes is really gone. Were
;; the implicit edge added alongside this one it would reinstate exactly the
;; name the modifier was written to remove.
;;
;; EXPECT-ERROR: Unbound variable: print

(import (except (std prelude) print))

(defun (main)
  (print "gone")
  0)
