;; What a colourless procedure compiles to.
;;
;; `drain` mentions no colour. It is a `defun`, it takes a port, and it calls
;; `port-eof?` and `read-char` — which are `defbjouble`s in the prelude, so
;; `drain` can reach a suspending leaf. It therefore gets two emitted bodies,
;; and which one a call means is decided by the colour of the member the call is
;; emitted into.
;;
;; This has to be a codegen test rather than a behavioural one. Both copies
;; compute the same answer, so running them cannot tell you which ran: the
;; difference is whether the thread was held or handed back, and that is visible
;; in the emitted C# and almost nowhere else. `154_defbjouble.bjo` checks that
;; the answers agree; this checks that they were reached differently.
;;
;; Each `EXPECT-CS` line is an extended regex matched against one line.

(export drain count-here count-suspending names-here names-suspending seq-here both-suspending vec-total)

(import (std prelude))
(import (std ports))

;; --- One source, two bodies --------------------------------------------------
;;
;; Nothing below says `defbjo`, `-bjo->` or `-?->`. The second body exists
;; because the call graph reaches a leaf that has one.

;; EXPECT-CS: public static int drain\(Bjolang.Runtime.BjoInputPort p\)
;; EXPECT-CS: public static async Bjoml.Fiber<int> drain__bjo\(Bjolang.Runtime.BjoInputPort p\)
(: drain (-> InputPort int))
(defun (drain p)
  (let loop ((n 0))
    (if (port-eof? p)
        n
        (let ()
          (ignore (read-char p))
          (loop (+ n 1))))))

;; --- The ordinary caller gets the ordinary copy ------------------------------
;;
;; A plain call, and inside it a plain `PortEof`. No state machine, no fiber.
;; EXPECT-CS: return colour_copies_Module\.drain\(p\);
(: count-here (-> InputPort int))
(defun (count-here p) (drain p))

;; --- The bjoroutine gets the generated one -----------------------------------
;;
;; The same two words in the source, `(drain p)`, and an await in the output.
;; This is the assertion the whole design is for: the call site said nothing
;; about colour and the compiler chose.
;; EXPECT-CS: return \(await colour_copies_Module\.drain__bjo\(p\)\);
(: count-suspending (-bjo-> InputPort int))
(defbjo (count-suspending p) (drain p))

;; --- And the copy suspends, rather than merely being async -------------------
;;
;; Inside `drain__bjo` the leaf is the prelude's suspending half. Without this
;; the test would pass on a copy that was async in name and still parked on
;; `PortEof` — which is exactly what a `(seq ...)` body would produce, and is
;; the degradation the blocking lint still reports.
;; EXPECT-CS: await portsubeof_QMARK__bjo\(p\)
;; EXPECT-CS: await readsubchar__bjo\(p\)

;; --- And which copy a *name* means -------------------------------------------
;;
;; `port->list` declares its reader `-?->`, so it has two copies; `read-char` is
;; a `defbjouble`, so it has two bodies. The two definitions below are the same
;; three words and neither says which pair it wants. A reference to a two-copy
;; name carries an effect variable rather than the ordinary copy's arrow, so the
;; mention decides nothing, and the colour of the enclosing member decides both:
;; the callee *and* the delegate handed to it.
;;
;; The delegate types are why this is the assertion worth making. `Func<A,B>`
;; and `Func<A,Fiber<B>>` are unrelated in C#, so picking one copy and not the
;; other would not compile — but picking *neither* compiles fine and parks on
;; every line, which is how this went unnoticed until it was looked for.

;; EXPECT-CS: portsubgtlist\(\(\(Func<Bjolang.Runtime.BjoInputPort, Bjolang.Runtime.BjoChar>\)\(\(fa0\) => readsubchar\(fa0\)\)\), p\)
(: names-here (-> InputPort int))
(defun (names-here p) (list-length (port->list read-char p)))

;; EXPECT-CS: await portsubgtlist__bjo\(\(\(Func<Bjolang.Runtime.BjoInputPort, Bjoml.Fiber<Bjolang.Runtime.BjoChar>>\)\(\(fa0\) => readsubchar__bjo\(fa0\)\)\), p\)
(: names-suspending (-bjo-> InputPort int))
(defbjo (names-suspending p) (list-length (port->list read-char p)))

;; --- A written arrow still outranks the default ------------------------------
;;
;; `port->seq`'s reader is declared `(-> ...)`, deliberately: a sequence is a C#
;; iterator and an iterator may not await, so promising a suspending copy there
;; would promise a body the compiler must then refuse to build. That arrow pins
;; the effect variable during unification, long before defaulting is asked, so
;; even the *suspending* copy of the body below is handed the ordinary
;; `read-char`. `port->seq` is `#:sync`, so that copy calls its one body.
;;
;; Defaulting only ever decides what nothing else has decided. This is the line
;; that pins it.
;; EXPECT-CS: return seqsublength\(portsubgtseq\(\(\(Func<Bjolang.Runtime.BjoInputPort, Bjolang.Runtime.BjoChar>\)\(\(fa0\) => readsubchar\(fa0\)\)\), p\)\);
(: seq-here (-> InputPort int))
(defun (seq-here p) (seq-length (port->seq read-char p)))

;; --- A copy that awaits nothing is not emitted -------------------------------
;;
;; `seq-here` mentions `read-char`, so it was copied; the copy then had nothing
;; to await. It is dropped, and a bjoroutine calls the ordinary body — no state
;; machine for a yield point that is not there, and nothing published that
;; would copy this module's importers in turn.
;; EXPECT-NO-CS: seqsubhere__bjo
;; EXPECT-CS: \(await colour_copies_Module\.drain__bjo\(p\)\) \+ colour_copies_Module\.seqsubhere\(p\)
(: both-suspending (-bjo-> InputPort int))
(defbjo (both-suspending p) (+ (drain p) (seq-here p)))

;; And across a module boundary. The prelude's `vec->list` reaches
;; `vec-for-each`, a `defbjouble`, but hands it an ordinary lambda; its copy is
;; dropped there, so it is not published as a double and a `defun` calling it
;; is not copied here.
;; EXPECT-NO-CS: vecsubtotal__bjo
(: vec-total (-> (Vec int) int))
(defun (vec-total v) (list-length (vec->list v)))
