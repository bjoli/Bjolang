;; std/eq.bjo — equality and hashing.
(export = eq-hash
        Ord compare less? greater? at-most? at-least?
        least greatest list-sort list-min list-max)

;; ---------------------------------------------------------------------------
;; Eq — the one equality
;; ---------------------------------------------------------------------------
;; Trait for equality and hashing.
(def/trait (Eq %a)
  (: = (-> %a %a bool))
  (: eq-hash (-> %a int)))


;; ---------------------------------------------------------------------------
;; Ord — the one ordering
;; ---------------------------------------------------------------------------
;; Trait for ordering.
(def/trait (Ord %a)
  (: compare (-> %a %a int)))

;; Ord predicates.
(: less? (-> %a %a bool) (where (Ord %a)))
(defun (less? a b) (< (compare a b) 0))

(: greater? (-> %a %a bool) (where (Ord %a)))
(defun (greater? a b) (> (compare a b) 0))

(: at-most? (-> %a %a bool) (where (Ord %a)))
(defun (at-most? a b) (<= (compare a b) 0))

(: at-least? (-> %a %a bool) (where (Ord %a)))
(defun (at-least? a b) (>= (compare a b) 0))

;; least and greatest (ties to left).
(: least (-> %a %a %a) (where (Ord %a)))
(defun (least a b) (if (at-most? a b) a b))

(: greatest (-> %a %a %a) (where (Ord %a)))
(defun (greatest a b) (if (at-least? a b) a b))

;; --- Sorting ---------------------------------------------------------------
;; Merge sort. Stable. Uses builtins only.
;;
;; Bottom-up over two arrays rather than recursive over the list, so a long
;; list neither overflows the stack nor allocates a cons cell per element per
;; level: runs of width 1, 2, 4, ... merge from one array into the other, and
;; the list is rebuilt once at the end.
(: list-sort (-> (List %a) (List %a)) (where (Ord %a)))
(defun (list-sort xs)
  (def n (list-length xs))

  (defun (smaller (: a int) b) (if (< a b) a b))

  ;; src[lo, mid) and src[mid, hi) into dst[lo, hi), answering hi: where the
  ;; next pair of runs starts. Ties take the left run, which is what keeps the
  ;; sort stable.
  (defun (merge-runs (: src (Array %a)) dst lo mid hi)
    (let go ((l lo) (r mid) (k lo))
      (if (< k hi)
          (if (if (< l mid)
                  (if (< r hi) (at-most? (array-ref src l) (array-ref src r)) #t)
                  #f)
              (let ()
                (array-set! dst k (array-ref src l))
                (go (+ l 1) r (+ k 1)))
              (let ()
                (array-set! dst k (array-ref src r))
                (go l (+ r 1) (+ k 1))))
          k)))

  (defun (merge-pass src dst width)
    (let go ((lo 0))
      (if (< lo n)
          (go (merge-runs src dst lo (smaller (+ lo width) n) (smaller (+ lo (* 2 width)) n)))
          dst)))

  (defun (fill arr)
    (let go ((i 0) (rest xs))
      (if (< i n)
          (let ()
            (array-set! arr i (list-head rest))
            (go (+ i 1) (list-tail rest)))
          arr)))

  (defun (sorted)
    (def done
      (let go ((src (fill (make-array n))) (dst (make-array n)) (width 1))
        (if (< width n)
            (go (merge-pass src dst width) src (* width 2))
            src)))
    (let go ((i (- n 1)) (acc Nil))
      (if (< i 0)
          acc
          (go (- i 1) (Cons (array-ref done i) acc)))))

  (if (< n 2) xs (sorted)))

;; Private left fold for list min/max.
(: fold-left (-> (-> %a %b %b) %b (List %a) %b))
(defun (fold-left f init xs)
  (let go ((rest xs) (acc init))
    (if (list-empty? rest)
        acc
        (go (list-tail rest) (f (list-head rest) acc)))))

(: list-min (-> (List %a) (Option %a)) (where (Ord %a)))
(defun (list-min xs)
  (if (list-empty? xs)
      None
      (Some (fold-left least (list-head xs) (list-tail xs)))))

(: list-max (-> (List %a) (Option %a)) (where (Ord %a)))
(defun (list-max xs)
  (if (list-empty? xs)
      None
      (Some (fold-left greatest (list-head xs) (list-tail xs)))))


;; --- The blanket -----------------------------------------------------------
;; Default to .NET equality.
(impl (Eq %a)
  (defun (= a b) (clr-equals a b))
  (defun (eq-hash a) (clr-hash a)))


;; --- The primitives --------------------------------------------------------
;; Eq for primitives.

(impl (Eq int)
  (defun (= a b) (clr-eq a b))
  (defun (eq-hash a) (clr-hash a)))

(impl (Eq long)
  (defun (= a b) (clr-eq a b))
  (defun (eq-hash a) (clr-hash a)))

(impl (Eq short)
  (defun (= a b) (clr-eq a b))
  (defun (eq-hash a) (clr-hash a)))

(impl (Eq byte)
  (defun (= a b) (clr-eq a b))
  (defun (eq-hash a) (clr-hash a)))

(impl (Eq uint)
  (defun (= a b) (clr-eq a b))
  (defun (eq-hash a) (clr-hash a)))

(impl (Eq ulong)
  (defun (= a b) (clr-eq a b))
  (defun (eq-hash a) (clr-hash a)))

(impl (Eq ushort)
  (defun (= a b) (clr-eq a b))
  (defun (eq-hash a) (clr-hash a)))

;; Eq for double uses Equals (NaN == NaN).
(impl (Eq double)
  (defun (= a b) (clr-equals a b))
  (defun (eq-hash a) (clr-hash a)))

(impl (Eq bool)
  (defun (= a b) (clr-eq a b))
  (defun (eq-hash a) (clr-hash a)))

;; Eq for string.
(impl (Eq string)
  (defun (= a b) (clr-eq a b))
  (defun (eq-hash a) (clr-hash a)))

(impl (Eq char)
  (defun (= a b) (clr-eq a b))
  (defun (eq-hash a) (clr-hash a)))

;; Eq for Keyword and Symbol.
(impl (Eq Keyword)
  (defun (= a b) (clr-eq a b))
  (defun (eq-hash a) (clr-hash a)))

(impl (Eq Symbol)
  (defun (= a b) (clr-eq a b))
  (defun (eq-hash a) (clr-hash a)))

(impl (Eq StringCursor)
  (defun (= a b) (clr-eq a b))
  (defun (eq-hash a) (clr-hash a)))

;; Eq for void.
(impl (Eq void)
  (defun (= a b) #t)
  (defun (eq-hash a) 0))


;; --- Ord for the primitives ------------------------------------------------
;; Delegates to IComparable.

(impl (Ord int)    (defun (compare a b) (.CompareTo a b)))
(impl (Ord long)   (defun (compare a b) (.CompareTo a b)))
(impl (Ord short)  (defun (compare a b) (.CompareTo a b)))
(impl (Ord byte)   (defun (compare a b) (.CompareTo a b)))
(impl (Ord uint)   (defun (compare a b) (.CompareTo a b)))
(impl (Ord ulong)  (defun (compare a b) (.CompareTo a b)))
(impl (Ord ushort) (defun (compare a b) (.CompareTo a b)))

;; Ord for double uses CompareTo.
(impl (Ord double) (defun (compare a b) (.CompareTo a b)))

(impl (Ord bool)   (defun (compare a b) (.CompareTo a b)))

;; Ord for string compares code points, never the ambient culture: the same
;; answer everywhere, and the order an OrderedMap of strings keeps.
(impl (Ord string) (defun (compare a b) (.CompareTo a b)))

(impl (Ord char)   (defun (compare a b) (.CompareTo a b)))


;; --- The containers --------------------------------------------------------
;; Container equality using element Eq. Uses builtins only.

;; A loop rather than recursion through `and`, so a long list does not
;; overflow the stack. Two lists that share a tail stop comparing there.
(impl (Eq (List %a))
  (where (Eq %a))
  (defun (= xs ys)
    (let go ((a xs) (b ys))
      (if (eq? a b)
          #t
          (if (list-empty? a)
              (list-empty? b)
              (if (list-empty? b)
                  #f
                  (if (= (list-head a) (list-head b))
                      (go (list-tail a) (list-tail b))
                      #f))))))
  (defun (eq-hash xs)
    (fold-left (fun (x h) (hash-combine h (eq-hash x))) 17 xs)))

;; Two cursors walk the leaves in step: no tree lookup per element, and no
;; recursion per element through `and`.
(impl (Eq (Vec %a))
  (where (Eq %a))
  (defun (= xs ys)
    (if (eq? xs ys)
        #t
        (if (= (vec-length xs) (vec-length ys))
            (let go ((cx (vec-cursor xs)) (cy (vec-cursor ys)))
              (if (vec-cursor-done? cx)
                  #t
                  (if (vec-cursor-done? cy)
                      #f
                      (if (= (vec-cursor-current cx) (vec-cursor-current cy))
                          (go (vec-cursor-next cx) (vec-cursor-next cy))
                          #f))))
            #f)))
  ;; Manual indexing.
  (defun (eq-hash xs)
    (defun (hash-from i h)
      (if (= i (vec-length xs))
          h
          (hash-from (+ i 1) (hash-combine h (eq-hash (vec-ref xs i))))))
    (hash-from 0 17)))

(impl (Eq (Option %a))
  (where (Eq %a))
  (defun (= a b)
    (match a
      ((Some x)
       (match b
         ((Some y) (= x y))
         (None #f)))
      (None (none? b))))
  (defun (eq-hash o)
    (match o
      ((Some x) (hash-combine 1 (eq-hash x)))
      (None 0))))

;; Eq for Tuples.
(impl (Eq (Tuple %a %b))
  (where (Eq %a) (Eq %b))
  (defun (= x y)
    (def (a1 b1) x)
    (def (a2 b2) y)
    (and (= a1 a2) (= b1 b2)))
  (defun (eq-hash x)
    (def (a b) x)
    (hash-combine (eq-hash a) (eq-hash b))))

(impl (Eq (Tuple %a %b %c))
  (where (Eq %a) (Eq %b) (Eq %c))
  (defun (= x y)
    (def (a1 b1 c1) x)
    (def (a2 b2 c2) y)
    (and (= a1 a2) (and (= b1 b2) (= c1 c2))))
  (defun (eq-hash x)
    (def (a b c) x)
    (hash-combine (hash-combine (eq-hash a) (eq-hash b)) (eq-hash c))))

(impl (Eq (Tuple %a %b %c %d))
  (where (Eq %a) (Eq %b) (Eq %c) (Eq %d))
  (defun (= x y)
    (def (a1 b1 c1 d1) x)
    (def (a2 b2 c2 d2) y)
    (and (and (= a1 a2) (= b1 b2)) (and (= c1 c2) (= d1 d2))))
  (defun (eq-hash x)
    (def (a b c d) x)
    (hash-combine (hash-combine (eq-hash a) (eq-hash b))
                  (hash-combine (eq-hash c) (eq-hash d)))))

(impl (Eq (Result %e %a))
  (where (Eq %e) (Eq %a))
  (defun (= a b)
    (match a
      ((Ok x)
       (match b
         ((Ok y) (= x y))
         ((Err _) #f)))
      ((Err x)
       (match b
         ((Ok _) #f)
         ((Err y) (= x y))))))
  (defun (eq-hash r)
    (match r
      ((Ok x) (hash-combine 1 (eq-hash x)))
      ((Err e) (hash-combine 2 (eq-hash e))))))
