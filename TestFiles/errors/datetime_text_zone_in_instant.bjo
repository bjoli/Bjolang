;; An instant has no zone, only UTC, so its format has an offset, written Z,
;; and no zone to name.

;; EXPECT-ERROR: InstantPart: expected DateTimeField, `offset`, `unix`, `unix-ms`, a string or a char; found the symbol `zone`

(import (std datetime))

(defun (main)
  (match (unix-seconds->instant 0L)
    ((Some i) (println (instant->text i '((hours 2) " " zone))))
    (None (println "none")))
  0)
