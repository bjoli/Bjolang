;; A signature that claims to suspend, over a definition that cannot.
;;
;; A plain `->` says nothing about the colour: it is what you write for either
;; definer, and `defbjo` supplies the answer. `-bjo->` does say something. It is
;; the spelling module metadata uses, because a module importing a bjoroutine
;; has no definition to read the colour off — and since a program can write one
;; too, it has to be held to rather than quietly overwritten.

;; EXPECT-ERROR: is written -bjo->
;; EXPECT-ERROR: but it is defined with defun

(: fetch (-bjo-> int int))
(defun (fetch x) (* x 2))

(defun (main args) 0)
