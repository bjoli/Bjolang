;; Day 12: Christmas Tree Farm. Count the regions that all their presents fit
;; in, turned or flipped, without overlap. Most regions are settled by area;
;; the rest are searched square by square.
(import (std eq) "common.bjo")

;; A shape is the (x, y) of its cells. `normalise` moves it to the origin and
;; sorts the cells, so that the first cell is the one a search places at the
;; first empty square.
(: normalise (-> (List (Tuple int int)) (List (Tuple int int))))
(defun (normalise cells)
  (def* (x0 (list-foldl #(min (fst &1) &2) 1000 cells))
        (y0 (list-foldl #(min (snd &1) &2) 1000 cells)))
  (list-sort (list-map (fun ((Tuple x y)) (Tuple (- x x0) (- y y0))) cells)))

;; The eight turns and flips of a shape, without repeats.
(: orientations (-> (List (Tuple int int)) (List (List (Tuple int int)))))
(defun (orientations cells)
  (def all
    (let go ((i 0) (cs cells) (acc Nil))
      (if (= i 4)
          acc
          (go (+ i 1)
              (list-map (fun ((Tuple x y)) (Tuple (- 0 y) x)) cs)
              (Cons (normalise cs) (Cons (normalise (list-map (fun ((Tuple x y)) (Tuple (- 0 x) y)) cs)) acc))))))
  (loop (:for o all)
        (:acc kept (folding Nil (if (any? #(= & o) kept) kept (Cons o kept))))
        => kept))

;; Fills the region square by square. The first empty square is covered by
;; the first cell of some present, or left empty, which spends one square of
;; slack. Each try marks the grid, searches on, and undoes the mark.
(: search (-> (Vec (List (List (Tuple int int)))) int int (Array int) int bool))
(defun (search orients w h counts slack)
  (def grid (make-array (* w h)))
  (defun (free? x y)
    (and (>= x 0) (< x w) (>= y 0) (< y h) (not (ref grid (+ x (* y w))))))
  (defun (mark! o x0 y0 v)
    (list-for-each (fun ((Tuple dx dy)) (array-set! grid (+ x0 dx (* (+ y0 dy) w)) v)) o))
  (defun (take! i n) (array-set! counts i (- (ref counts i) n)))
  (defun (go (: at int) (: slack int))
    (def* (x (% at w)) (y (/ at w)))
    ;; Puts orientation o of shape i with its first cell on (x, y).
    (defun (place? i o)
      (def ax (- x (fst (list-head o))))
      (and (all? (fun ((Tuple dx dy)) (free? (+ ax dx) (+ y dy))) o)
           (let ()
             (mark! o ax y #t) (take! i 1)
             (def ok (go (+ at 1) slack))
             (mark! o ax y #f) (take! i -1)
             ok)))
    (defun (skip?)
      (and (> slack 0)
           (let ()
             (array-set! grid at #t)
             (def ok (go (+ at 1) (- slack 1)))
             (array-set! grid at #f)
             ok)))
    (cond ((all? #(= & 0) counts) #t)
          ((>= at (* w h)) #f)
          ((ref grid at) (go (+ at 1) slack))
          (else
           (or (loop (:for i (range 0 (length orients)))
                     (:when (> (ref counts i) 0))
                     (:subloop)
                     (:for o (ref orients i))
                     (:finish (place? i o) #t)
                     => #f)
               (skip?)))))
  (go 0 slack))

(defun (main args)
  (def lines (input-lines args))
  ;; Each shape is a header "N:" followed by three rows.
  (def shapes
    {vecing {listing (Tuple x y)
                     (:for y (range 0 3))
                     (:subloop)
                     (:for x (range 0 3))
                     (:when (char=? #\# (ref (string->vec (ref lines (+ i 1 y))) x)))}
            (:for i (range 0 (length lines)))
            (:when (and (string-ends-with? (ref lines i) ":") (not (string-contains? (ref lines i) "x"))))})
  (def orients (vec-map orientations shapes))
  (defun (fits? w h counts)
    (def needed {summing (* (ref counts i) (length (ref shapes i))) (:for i (range 0 (length counts)))})
    (cond ((> needed (* w h)) #f)
          ((<= {summing c (:for c counts)} (* (/ w 3) (/ h 3))) #t)
          (else (search orients w h counts (- (* w h) needed)))))
  (println
   {counting line
    (:for line lines)
    (:when (string-contains? line "x"))
    (:let halves (string-split line ": "))
    (:let dims (vec-map string->int (string-split (ref halves 0) "x")))
    (:let counts (vec-map string->int (string-split (ref halves 1) " ")))
    (:when (fits? (ref dims 0) (ref dims 1) (vec->array counts)))})
  0)
