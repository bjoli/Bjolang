;; A dependency may keep a trait to itself.
;;
;; The work is in building `inc/private_trait.bjo` at all: it declares a trait
;; and a type, exports neither, and implements the one for the other. What is
;; pinned here is that this compiles and that the module's actual export still
;; works — an impl that reaches nobody must not be published, and must not drag
;; a private type into the metadata behind it.
(import (std prelude))
(import "inc/private_trait.bjo")

(defun (main args)
  (println (tally (list 1 2 3 4)))
  (if (= (tally (list 1 2 3 4)) 10)
      (println "ok")
      (println "FAILURE: tally"))
  0)
