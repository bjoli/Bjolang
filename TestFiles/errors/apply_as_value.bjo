;; `apply` used outside application position.
;;
;; It is a form, not a function. Everything it does is decided by reading the
;; callee: how many arguments it takes, which parameters they fill, and whether
;; the call suspends. A bare `apply` has no callee to read, and there is no one
;; type it could be bound at either — so there is nothing to hand to `def`.

;; EXPECT-ERROR: 'apply' is a form, not a value

(import (std prelude))

(: join (-> #:rest string string))
(defun (join #:rest parts) "")

(defun (main args)
  (def g apply)
  0)
