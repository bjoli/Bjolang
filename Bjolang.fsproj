<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <NuGetAudit>false</NuGetAudit>
        <!-- On in Debug too, where F# turns it off by default.
             The tokenizer's `loop` recurses once per token, and without tail
             calls a Debug build of the compiler overflows the stack on any file
             that imports the prelude — which is every file. So the Debug
             configuration could not compile anything at all, and `run_tests.sh`
             passing was down to it using Release. -->
        <Tailcalls>true</Tailcalls>
    </PropertyGroup>

    <ItemGroup>
        <Compile Include="Paths.fs"/>
        <!-- Depends on nothing, and every pass may want to be measured, so it
             comes before all of them. -->
        <Compile Include="Timing.fs"/>
        <Compile Include="Gensym.fs"/>
        <Compile Include="Naming.fs"/>
        <Compile Include="Lexer.fs"/>
        <!-- Before Parser, because every pass from there on reports through it. -->
        <Compile Include="Diagnostics.fs"/>
        <Compile Include="Parser.fs"/>
        <Compile Include="LetRecify.fs"/>
        <Compile Include="TypedAST.fs" />
        <Compile Include="DotNetInterop.fs" />
        <Compile Include="TypeVisitor.fs" />
        <Compile Include="AlphaRename.fs" />
        <!-- After AlphaRename, for its untyped `freeNames` and `renameFree`:
             beta-reduction has to freshen a captured parameter, and a binder
             traversal written a second time is a binding form missed a second
             time. It still *runs* before LetRecify — compilation order and pass
             order are independent, and only the latter is what
             `runFullFrontendPipeline` decides. -->
        <Compile Include="Normalize.fs" />
        <!-- After AlphaRename, whose `freeNames` decides which of a macro
             expansion's introduced names still need resolving. -->
        <Compile Include="Macro.fs" />
        <Compile Include="Unification.fs" />
        <Compile Include="Inference.fs" />
        <!-- Before TraitInline, so the must-use check reports on the body as
             written rather than on whatever the inliner happened to splice. -->
        <Compile Include="MustUse.fs" />
        <Compile Include="TraitInline.fs" />
        <Compile Include="Lowering.fs" />
        <Compile Include="LoopLowering.fs" />
        <!-- After LoopLowering, which is what decides whether a loop became a
             `while` in the enclosing method or a C# local function — and so
             whether a yield point inside it is legal. -->
        <Compile Include="ColourCheck.fs" />
        <Compile Include="Prelude.fs" />
        <!-- Before Pipeline, which reads it, and before Exports, which writes
             it. Pure data and its own serializer, so it depends on nothing. -->
        <Compile Include="ModuleMetadata.fs" />
        <Compile Include="Pipeline.fs"/>
        <Compile Include="Codegen.fs"/>
        <!-- After Codegen, whose serializers it publishes types and inline
             bodies with. -->
        <Compile Include="Exports.fs"/>
        <Compile Include="Program.fs" />
    </ItemGroup>

    <ItemGroup>
        <!-- The compiler links the runtime, for one type only: `Syntax`, which
             a macro transformer takes and returns. The expander builds those
             values and reads them back across a reflection call, so it needs
             the type statically rather than through more reflection.

             This copies a second `BjolangRuntime.dll` next to the compiler,
             which is deliberate: the alternative is depending on
             `Paths.runtimeAssemblies` having been probed and loaded before the
             first method mentioning `Syntax` is JITted. Two *files* are
             harmless, because the default load context resolves by assembly
             identity — whichever loads first is the one everything gets,
             including a macro module loaded later with `Assembly.LoadFile`. Two
             *identities* would not be, which is why nothing here renames it.

             `Paths.runtimeDir` is unaffected: it probes for
             `<ancestor>/BjolangRuntime/bin/Release/net10.0`, and the copy
             beside the compiler does not match that shape. Generated programs
             therefore still link the canonical build. -->
        <ProjectReference Include="BjolangRuntime/BjolangRuntime.csproj" />
    </ItemGroup>

</Project>
