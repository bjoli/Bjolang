;; A pattern of the wrong type is reported at the pattern, not at the match.

;; EXPECT-ERROR: these types do not match.
;; EXPECT-ERROR: located_pattern_literal.bjo:12:6

(import (std prelude))

(: (-> int string))
(defun (name n)
  (match n
    (1 "one")
    ("two" "two")
    (_ "many")))

(defun (main)
  (println (name 1))
  0)
