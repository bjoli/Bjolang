;; std/unicode/chars.bjo — the Unicode properties and case mappings of one
;; character, R6RS section 11.11.
;;
;; - (std prelude) re-exports all of it, so a program has these names without
;;   an import.
;; - The tables are generated by tools/unicode/chars.bjo from the Unicode
;;   Character Database into chars-*.bin, and compiled into the assembly
;;   with include-bytes. They do not depend on .NET or ICU, and are of the same
;;   version as the tables of (std unicode normalize), casefold and grapheme.
;; - Every function is one lookup in a two-stage table: the kind of the code
;;   point, then a property or a delta of the kind.

(export
  chars-unicode-version
  ;; Case
  char-upcase char-downcase char-titlecase char-foldcase
  ;; Classification
  char-alphabetic? char-numeric? char-whitespace?
  char-upper-case? char-lower-case? char-title-case?
  digit-value char-general-category
  ;; Comparison without case
  char-ci=? char-ci<? char-ci>? char-ci<=? char-ci>=?)

;; The core, so that (std prelude) can import this module.
(import (std prelude core))

(:doc #:file "chars.bjodoc")

(include "chars-table.protobjo")

;; ---------------------------------------------------------------------------
;; The tables
;; ---------------------------------------------------------------------------

(: string)
(def chars-unicode-version unicode-version)

;; The tables are compiled into the assembly (see `include-bytes`). Each is a
;; property, so initializing the module decodes and copies nothing.

;; The block of each 256 code points.
(: (RoSpan byte))
(def stage1 (include-bytes "chars-stage1.bin"))

;; The kind of each code point, by block.
(: (RoSpan byte))
(def stage2 (include-bytes "chars-stage2.bin"))

;; The kinds: five rows of `kind-count` ints. Row 0 is the properties; rows
;; 1 to 4 are the deltas of the uppercase, lowercase and titlecase mappings
;; and of the case fold.
(: (RoSpan int))
(def kinds (include-bytes "chars-kinds.bin" #:of int))

(def upper-row 1)
(def lower-row 2)
(def title-row 3)
(def fold-row 4)

;; The kind of a code point.
(: (-> int int) #:inline)
(defun (kind-of cp)
  (cast int
        (ro-span-ref stage2
                     (+ (shift-left (cast int (ro-span-ref stage1 (shift-right cp 8))) 8)
                        (bitwise-and cp 255)))))

;; The properties of a character: bits 0-4 the general category, bit 5
;; Alphabetic, bit 6 White_Space, bit 7 Uppercase, bit 8 Lowercase, bits 9-12
;; the decimal digit value or 15.
(: (-> char int) #:inline)
(defun (props-of c)
  (ro-span-ref kinds (kind-of (char->int c))))

(: (-> char int bool) #:inline)
(defun (has? c bit)
  (not (= 0 (bitwise-and (props-of c) (shift-left 1 bit)))))

;; A character moved by the delta of its kind in row `row` of `kinds`.
(: (-> int char char) #:inline)
(defun (mapped row c)
  (def cp (char->int c))
  (def d (ro-span-ref kinds (+ (* row kind-count) (kind-of cp))))
  (if (= d 0)
      c
      (int->char (+ cp d))))

;; ---------------------------------------------------------------------------
;; Case
;; ---------------------------------------------------------------------------

(: (-> char char))
(defun (char-upcase c)
  (mapped upper-row c))

(: (-> char char))
(defun (char-downcase c)
  (mapped lower-row c))

(: (-> char char))
(defun (char-titlecase c)
  (mapped title-row c))

(: (-> char char))
(defun (char-foldcase c)
  (mapped fold-row c))

;; ---------------------------------------------------------------------------
;; Classification
;; ---------------------------------------------------------------------------

(: (-> char bool))
(defun (char-alphabetic? c)
  (has? c 5))

(: (-> char bool))
(defun (char-whitespace? c)
  (has? c 6))

(: (-> char bool))
(defun (char-upper-case? c)
  (has? c 7))

(: (-> char bool))
(defun (char-lower-case? c)
  (has? c 8))

;; The index of the category, as `category-symbol` takes it.
(: (-> char int) #:inline)
(defun (category-of c)
  (bitwise-and (props-of c) 31))

;; Lt, Nd and No, by their index in `category-symbol`.
(def lt 2)
(def nd 8)
(def no 10)

(: (-> char bool))
(defun (char-title-case? c)
  (= (category-of c) lt))

(: (-> char bool))
(defun (char-numeric? c)
  (def g (category-of c))
  (and (>= g nd) (<= g no)))

(: (-> char (Option int)))
(defun (digit-value c)
  (def d (shift-right (props-of c) 9))
  (if (= d 15)
      None
      (Some d)))

(: (-> char Symbol))
(defun (char-general-category c)
  (category-symbol (category-of c)))

;; ---------------------------------------------------------------------------
;; Comparison without case
;; ---------------------------------------------------------------------------

(: (-> char char bool))
(defun (char-ci=? a b)
  (= (char-foldcase a) (char-foldcase b)))

(: (-> char char bool))
(defun (char-ci<? a b)
  (< (char-foldcase a) (char-foldcase b)))

(: (-> char char bool))
(defun (char-ci>? a b)
  (> (char-foldcase a) (char-foldcase b)))

(: (-> char char bool))
(defun (char-ci<=? a b)
  (<= (char-foldcase a) (char-foldcase b)))

(: (-> char char bool))
(defun (char-ci>=? a b)
  (>= (char-foldcase a) (char-foldcase b)))
