(import (std prelude))
(import (std simpletest))

;; `x__1` is the shape of the names the compiler makes up, and a program may
;; write it. The compiler never makes up a name the program writes, so a binder
;; it makes cannot capture the program's variable.

(defun (main args)
  (def x__1 100)
  (def y__2 200)
  (def x 7)
  ;; `let` renames its binders apart, with names of that shape.
  (let ((x 1) (y x))
    (expect "a written x__1 is the program's" x__1 100)
    (expect "a written y__2 is the program's" y__2 200)
    (expect "the let's own binders" (+ x y) 8))
  0)
