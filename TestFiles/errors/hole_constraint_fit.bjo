;; EXPECT-ERROR: '_' stands for a value of type (-?-> %a string).
;; EXPECT-ERROR: Bindings in scope that fit: displayed
;; EXPECT-NO-ERROR: char->string
;;
;; In a generic function, the signature's variable is what it is: a function
;; of a char is no fit for one of `%a`. One that asks for `Displayed` is,
;; since the signature gives it.

(import (std prelude))

(: show-all (-> (Vec %a) string) (where (Displayed %a)))
(defun (show-all xs) (string-join (vec-map _ xs) ", "))

(defun (main) 0)
