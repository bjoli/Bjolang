;; SUM -- Compute sum of integers from 0 to n.
;; Arguments: count n expected

(import "common.bjo")

(: run (-> int int))
(defun (run n)
  (let loop ((i n) (sum 0))
    (if (< i 0)
        sum
        (loop (- i 1) (+ i sum)))))

(defun (main args)
  (def n (arg-int args 1))
  (def expected (arg-int args 2))
  (run-benchmark "sum" (arg-int args 0) (fun () (run n)) #(= & expected)))
