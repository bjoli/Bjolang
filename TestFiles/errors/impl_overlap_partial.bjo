;; Neither target is an instance of the other, and still one type is an
;; instance of both: (Pair int int).

;; EXPECT-ERROR: This one, for (impl_overlap_partial/Pair int %b), overlaps it: (impl_overlap_partial/Pair int int) is an instance of both

(import (std prelude))

(type (: (Pair %a %b) (Struct (: l %a) (: r %b))))

(def/trait (Describe %a)
  (: describe (-> %a string)))

(impl (Describe (Pair %a %a))
  (defun (describe p) "one type twice"))

(impl (Describe (Pair int %b))
  (defun (describe p) "an int first"))

(defun (main args) 0)
