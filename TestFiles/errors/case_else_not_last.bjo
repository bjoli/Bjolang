;; A clause after `(else ...)`.
;;
;; `else` answers whatever the clauses before it did not, so a clause after it
;; is unreachable. C# would report the same thing about the `default:` section
;; this becomes, against generated code.

;; EXPECT-ERROR: Invalid case
;; EXPECT-ERROR: nothing may follow it

(import (std prelude))

(: size (-> int string))
(defun (size n)
  (case n
    ((1) "small")
    (else "large")
    ((2) "medium")))

(defun (main args)
  (println (size 1))
  0)
