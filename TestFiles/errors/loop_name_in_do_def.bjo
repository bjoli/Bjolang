;; The loop name in the value of a def in a named loop's last :do is not a
;; jump: only the :do's tail position may jump.
;; EXPECT-ERROR: 'lp' at loop_name_in_do_def.bjo:10 is a loop name
(import (std prelude))

(: (-> (List int) int))
(defun (f xs)
  (loop lp (:for x xs)
           (:acc total (summing x))
           (:do (def r (lp))
                (lp))
           => total))

(defun (main args)
  (println (f (list 1 2 3)))
  0)
