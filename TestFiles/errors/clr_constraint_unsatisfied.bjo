;; EXPECT-ERROR: does not satisfy 'Num'
;; EXPECT-ERROR: does not implement
;;
;; A CLR constraint is a closed world: `string` is not a `System.Numerics.INumber`
;; and there is no `impl` that could make it one. The message has to say so
;; rather than read like a missing implementation, which would invite writing
;; the one thing that cannot be written. The prelude's `Num` is such a trait;
;; a module's own trait of that name would be another trait.
(import (std prelude))

(: (-> %a %a %a) (where (Num %a)))
(defun (total a b) (+ a b))

(defun (main)
  (displayln (total "a" "b"))
  0)
