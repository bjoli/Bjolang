;; Re-exporting a type this module declares.
;;
;; `re-export` publishes somebody else's declaration under a spelling of ours,
;; and this one is ours: publishing it here would be the same declaration
;; written twice under one key, and the second copy could disagree with the
;; first. `export` is the form, and it is what the message names.

;; EXPECT-ERROR: is a type this module declares

(import (std prelude))

(type (: Mine (Union (MkMine int))))

(re-export Mine)

(defun (main args) 0)
