;; Paper program: the queries from the Umits README, against (std units).

(import (std units))

;; 6000m + 50ft in mi -> 3.737697
(in (+ <6000 m> <50 ft>) mi)              ; double, 3.737697

;; 65mi in 12mi/h -> 19500 s
(/ <65 mi> <12 mi/h>)                     ; (double s), 19500

;; 9ly in yr -> 9c
(in (/ <9 ly> <1 yr>) c)                  ; double, 9.0

;; Drag on a car at 120 km/h.
(: drag (-> (double kg/m^3) (double m/s) double (double m^2) (double N)))
(defun (drag rho v cd area)
  (* 0.5 rho v v cd area))

(drag <1.225 kg/m^3> <120 km/h> 0.28 <2.2 m^2>)   ; (double kg m/s^2), 419.2222
;; <120 km/h> is 33.333 m/s at compile time. N is kg m/s^2: one type.

;; Dilution: 2 kg/yr into a stream of 3 m^3/s.
(in (/ <2 kg/yr> <3 m^3/s>) ng/l)         ; double, 21.12539

;; Cobalt-60 at 4 m: time to an LD50/30 dose.
(def dose <5 Sv>)                         ; (double m^2/s^2)
(def activity <41.9 PBq>)                 ; (double 1/s)
(def gamma <0.351 mSv m^2/(GBq h)>)       ; (double m^4/s^2)
(def r <4 m>)                             ; (double m)
(/ (* dose r r) (* gamma activity))       ; (double s), 19.58264

;; Errors.
(+ <1 m> <1 s>)
;; error: They differ in the 2nd parameter: (?a m) against (?a s).

(in <1 kg> m)
;; error: (in x m) takes a length (m), and x is a mass (kg).

<1 meeter>
;; error: in <1 meeter>: unknown unit 'meeter'. Did you mean 'meter'?

;; Count: 1 annotation (drag), 6 in.
