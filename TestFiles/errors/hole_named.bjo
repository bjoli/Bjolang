;; EXPECT-ERROR: '_total' stands for a value of type int.
;; EXPECT-ERROR: Bindings in scope that fit: _seen, x
;; EXPECT-NO-ERROR: '_seen' stands for
;; EXPECT-NO-ERROR: Unbound variable
;;
;; A `_name` that nothing binds is a hole, named. One that something binds is
;; an ordinary name, and fits the hole like any other.

(import (std prelude))

(: count-up (-> int int))
(defun (count-up x)
  (let ((_seen (+ x 1)))
    (+ _seen _total)))

(defun (main) 0)
