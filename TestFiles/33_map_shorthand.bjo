(import (std prelude))

(defun (main)
  ;; 1. Empty map shorthand
  (def m0 #map())
  (println (if (map-empty? m0) "m0 empty: yes" "m0 empty: no"))
  (println (map-length m0))

  ;; 2. Evaluated map with (key value) pairs
  (def m1 #map(("a" 10) ("b" (+ 10 10))))
  (println (map-length m1))
  (println (map-ref m1 "a"))
  (println (map-ref m1 "b"))

  ;; 3. Evaluated map with variables
  (def key "dynKey")
  (def val 99)
  (def m2 #map((key val) ("fixed" 123)))
  (println (map-length m2))
  (println (map-ref m2 "dynKey"))
  (println (map-ref m2 "fixed"))

  ;; 4. Different pair styles: brackets [k v] and dotted (k . v)
  (def m3 #map([ "x" 100 ] [ "y" 200 ]))
  (println (map-length m3))
  (println (map-ref m3 "x"))
  (println (map-ref m3 "y"))

  (def m4 #map(( "alpha" . 1 ) ( "beta" . 2 )))
  (println (map-length m4))
  (println (map-ref m4 "alpha"))
  (println (map-ref m4 "beta"))

  ;; 5. Outer brackets #map[...]
  (def m5 #map[("one" 1) ("two" 2)])
  (println (map-length m5))
  (println (map-ref m5 "one"))
  (println (map-ref m5 "two"))

  (println "Map shorthand tests passed!")
  0)
