;; EXPECT-ERROR: this type has a type variable, such as %a, in it
;; A for-all binding draws from the type's Arbitrary, which a type variable
;; has none of. The macro says so, instead of the compiler's missing
;; dictionary.
(import (std prelude))
(import (std test))
(import (std test gen))
(import (std test prop))

(deftest "a type variable"
  (for-all ((: xs (List %a)))
    (check (= xs xs))))

(run-tests)
