;; EXPECT-ERROR: 'b' is used before its definition

;; The definitions in a body run in the order they are written, so a def reads
;; only the ones above it. They used to be reordered, which ran b first.

(import (std prelude))

(defun (main args)
  (def a (+ b 1))
  (def b 41)
  (println (->str a))
  0)
