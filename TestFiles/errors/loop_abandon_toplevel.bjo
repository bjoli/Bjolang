;; `:abandon` goes to the next iteration of the level above, and the outermost
;; level has none.

;; EXPECT-ERROR: `:abandon` has no level above here; use `:finish`.

(import (std prelude))

(: f (-> (List int) int))
(defun (f xs)
  (loop (:for x xs)
        (:abandon (> x 2))
        (:acc s (summing x))
        => s))

(defun (main) (println (int->string (f '(1 2 3)))) 0)
