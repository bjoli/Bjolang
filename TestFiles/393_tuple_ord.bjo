;; Tuples of two, three and four ordered items are ordered: by the first item,
;; then by the next where the first are equal.

(import (std prelude))

(: (-> string string string bool))
(defun (check what got want)
  (if (= got want)
      #t
      (let ()
        (println (str what ": got " got ", wanted " want))
        #f)))

(defun (main args)
  (if (and (check "pairs" (->str (list-sort (list (Tuple 2L 1L) (Tuple 1L 9L) (Tuple 2L 0L))))
                  "((1, 9) (2, 0) (2, 1))")
           (check "mixed items" (->str (list-sort (list (Tuple "b" 1) (Tuple "a" 2) (Tuple "a" 1))))
                  "((a, 1) (a, 2) (b, 1))")
           (check "triples" (->str (list-sort (list (Tuple 1 2 3) (Tuple 1 2 1) (Tuple 0 9 9))))
                  "((0, 9, 9) (1, 2, 1) (1, 2, 3))")
           (check "quadruples" (int->string (compare (Tuple 1 2 3 4) (Tuple 1 2 3 5))) "-1")
           (check "equal" (int->string (compare (Tuple 1 "x") (Tuple 1 "x"))) "0")
           (check "nested" (->str (list-max (list (Tuple (Tuple 1 2) 0) (Tuple (Tuple 1 3) 0))))
                  "(Some ((1, 3), 0))"))
      0
      1))
