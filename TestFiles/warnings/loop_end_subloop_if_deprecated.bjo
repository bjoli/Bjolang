;; `:end-subloop-if` is the old spelling of `:abandon`. It still works, and says so.

;; EXPECT-WARNING: `:end-subloop-if` at loop_end_subloop_if_deprecated.bjo:13 is deprecated, use `:abandon`.

(import (std prelude))
(import (std simpletest))

(: f (-> (List int) (List int) int))
(defun (f xs ys)
  (loop (:for x xs)
        (:subloop)
        (:for y ys)
        (:end-subloop-if (> y 1))
        (:acc s (summing y))
        => s))

(defun (main)
  (expect "end-subloop-if" (f '(1 2 3) '(1 2 3)) 3)
  0)
