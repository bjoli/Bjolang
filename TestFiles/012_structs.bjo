(import (std prelude))
(import (std simpletest))

;; A `Struct` compiles to a value type and a `Record` to a reference type; both
;; are constructed by naming the type.
(type
  (: Point (Struct (: x int) (: y int))))

(type
  (: Size (Record (: w int) (: h int))))

;; Module-level struct: struct-set must qualify the module and parenthesize `with`.
(: origin Point)
(def origin (Point (x 0) (y 0)))

(: shift-x (-> Point int Point))
(defun (shift-x p d)
  (struct-set p (x (+ (struct-ref p x) d))))

(defun (main args)
  (def p (Point (x 1) (y 2)))
  (def s (Size (w 30) (h 40)))

  ;; Fields may be written in any order: the constructor names them.
  (def s2 (Size (h 40) (w 30)))
  (expect "fields out of order, w" (record-ref s2 w) 30)
  (expect "fields out of order, h" (record-ref s2 h) 40)

  ;; field access
  (expect "struct field access" (struct-ref p x) 1)
  (expect "record field access" (record-ref s w) 30)

  ;; functional update returning a new value, then immediately projected
  (expect "record-set replaces h" (record-ref (record-set s (h 99)) h) 99)
  (expect "record-set carries w over" (record-ref (record-set s (h 99)) w) 30)

  ;; update through a function
  (expect "update through a function" (struct-ref (shift-x p 5) x) 6)
  (expect "update through a function leaves y" (struct-ref (shift-x p 5) y) 2)

  ;; update of a module-level binding
  (expect "update of a module-level binding" (struct-ref (struct-set origin (x 42)) x) 42)
  (expect "the module-level binding itself is untouched" (struct-ref origin x) 0)

  ;; multi-field update
  (expect "multi-field update, x" (struct-ref (struct-set p (x 7) (y 8)) x) 7)
  (expect "multi-field update, y" (struct-ref (struct-set p (x 7) (y 8)) y) 8)
  0)
