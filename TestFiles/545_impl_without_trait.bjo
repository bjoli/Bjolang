;; A module that imports a type but not the trait of one of its
;; implementations. The implementation is left out here, and the type's
;; other functions work, including one that uses the implementation.

(import (std prelude))
(import "inc/pending_type.bjo")

(defun (main args)
  (def got (crates-weight (crate 2) (crate 3)))
  (cond
    ((not (= (crate-load (crate 4)) 4)) (println "FAILURE: crate-load") 1)
    ((not (= got 50)) (println (str "FAILURE: crates-weight is " (displayed got) ", want 50")) 1)
    (else 0)))
