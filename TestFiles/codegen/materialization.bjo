;; An `Eq` implementation, emitted into the type it is for.
;;
;; This is what makes `Map`, `HashSet` and every .NET consumer agree with `=`
;; without any of them being told about the trait, and no behavioural test can
;; distinguish it from C#'s synthesized equality until an implementation
;; disagrees with the fields.

;; EXPECT-CS: public virtual bool Equals\(materialization__Point\? other\) => other is not null && Eq_materialization__Point\.Instance\.eq\(this, other\);
;; EXPECT-CS: public override int GetHashCode\(\) => Eq_materialization__Point\.Instance\.eqsubhash\(this\);
(type/derive (Eq)
  (: Point (Record (: x int) (: y int))))

;; A record struct takes neither `virtual` nor a null check: there is no
;; derived type to override it and no null to be handed.
;; EXPECT-CS: public bool Equals\(materialization__Coord other\) => Eq_materialization__Coord\.Instance\.eq\(this, other\);
(type/derive (Eq)
  (: Coord (Struct (: lat int) (: lon int))))

;; Into every case class, not onto the abstract base: a derived record
;; synthesizes its own `Equals`, which overrides the base's, so an override
;; written only on the base would be silently dead.
;; EXPECT-CS: public bool Equals\(materialization__Circle\? other\) => other is not null && Eq_materialization__Shape\.Instance\.eq\(this, other\);
;; EXPECT-CS: public bool Equals\(materialization__Square\? other\) => other is not null && Eq_materialization__Shape\.Instance\.eq\(this, other\);
(type/derive (Eq)
  (: Shape (Union (: Circle int) (: Square int))))

;; A *conditional* implementation — every one a parameterized type derives —
;; materializes too. Its `(where (Eq %a))` asks for an `Eq<T_a>` that nothing
;; hands `Box<T_a>.Equals`, so the type builds the implementation itself, once
;; per closed type, into a static field: from a stand-in that answers through
;; `T_a`'s own `Equals` and `GetHashCode`, which is what `T_a`'s `Eq` is.
;; EXPECT-CS: public record materialization__Box<T_a>\(T_a item\) \{
;; EXPECT-CS: private static readonly Eq_materialization__Box<T_a> __Eq_impl = Eq_materialization__Box<T_a>\.Make\(new __ClrEq<T_a>\(\)\);
;; EXPECT-CS: private sealed class __ClrEq<X> : Eq<X> \{ public bool eq\(X a, X b\) => System\.Collections\.Generic\.EqualityComparer<X>\.Default\.Equals\(a, b\); public int eqsubhash\(X a\) => a is null \? 0 : System\.Collections\.Generic\.EqualityComparer<X>\.Default\.GetHashCode\(a\); bool BjolangRuntime\.IEvidence\.AgreesWithClr => true; \}
;; EXPECT-CS: public virtual bool Equals\(materialization__Box<T_a>\? other\) => other is not null && __Eq_impl\.eq\(this, other\);
;; EXPECT-CS: public override int GetHashCode\(\) => __Eq_impl\.eqsubhash\(this\);
(type/derive (Eq)
  (: (Box %a) (Record (: item %a))))

;; A record struct: the same field, and members of the struct's own shape.
;; EXPECT-CS: public record struct materialization__Cell<T_a>\(T_a v\) \{
;; EXPECT-CS: private static readonly Eq_materialization__Cell<T_a> __Eq_impl = Eq_materialization__Cell<T_a>\.Make\(new __ClrEq<T_a>\(\)\);
;; EXPECT-CS: public bool Equals\(materialization__Cell<T_a> other\) => __Eq_impl\.eq\(this, other\);
(type/derive (Eq)
  (: (Cell %a) (Struct (: v %a))))

;; A union: the field goes on the abstract base, and every case class reads it
;; as a private member of the type it is nested in. `Nope` is `null` at run
;; time, so it has no class and no `Equals`.
;; EXPECT-CS: public abstract record materialization__Maybe<T_a> \{
;; EXPECT-CS: private static readonly Eq_materialization__Maybe<T_a> __Eq_impl = Eq_materialization__Maybe<T_a>\.Make\(new __ClrEq<T_a>\(\)\);
;; EXPECT-NO-CS: Equals\(materialization__Nope
;; EXPECT-CS: public bool Equals\(materialization__Yep\? other\) => other is not null && __Eq_impl\.eq\(this, other\);
(type/derive (Eq)
  (: (Maybe %a) (Union Nope (: Yep %a))))

;; The stand-ins are passed in the `(where ...)`'s order, each at the type
;; parameter its variable stands in the target: `%y` is the second, `T_b`,
;; whatever the implementation called it.
;; EXPECT-CS: private static readonly Eq_materialization__Two<T_a, T_b> __Eq_impl = Eq_materialization__Two<T_a, T_b>\.Make\(new __ClrEq<T_b>\(\)\);
(type
  (: (Two %a %b) (Record (: left %a) (: right %b))))

(impl (Eq (Two %x %y))
  (where (Eq %y))
  (defun (= p q) (= (record-ref p right) (record-ref q right)))
  (defun (eq-hash p) (eq-hash (record-ref p right))))

;; A `(where ...)` of another trait has no .NET member to stand in for it, so
;; that implementation keeps C#'s synthesized members.
;; EXPECT-CS: public record materialization__Shown<T_a>\(T_a item\);
(type
  (: (Shown %a) (Record (: item %a))))

(impl (Eq (Shown %a))
  (where (->str %a))
  (defun (= p q) (= (->str (record-ref p item)) (->str (record-ref q item))))
  (defun (eq-hash p) (eq-hash (->str (record-ref p item)))))

;; `Ord` materializes as `IComparable<T>`: the interface in the base clause —
;; which is the part `Comparer<T>.Default` actually looks for — and a
;; `CompareTo` that answers through the implementation. Null sorts first, which
;; is the comparer's own convention.
;; EXPECT-CS: public record materialization__Ver\(int major, int minor\) : System.IComparable<materialization__Ver> {
;; EXPECT-CS: public int CompareTo\(materialization__Ver\? other\) => other is null \? 1 : Ord_materialization__Ver\.Instance\.compare\(this, other\);
(type/derive (Ord)
  (: Ver (Record (: major int) (: minor int))))

;; A record struct: no null to guard against.
;; EXPECT-CS: public record struct materialization__Lat\(int deg\) : System.IComparable<materialization__Lat> {
;; EXPECT-CS: public int CompareTo\(materialization__Lat other\) => Ord_materialization__Lat\.Instance\.compare\(this, other\);
(type/derive (Ord)
  (: Lat (Struct (: deg int))))

;; A union's `CompareTo` goes onto the abstract *base*, the opposite of where
;; `Equals` goes: `Comparer<Level>.Default` asks `Level` for
;; `IComparable<Level>`, and — unlike `Equals` — nothing synthesized in a case
;; class displaces `CompareTo`, so one member on the base serves every case.
;; EXPECT-CS: public abstract record materialization__Level : System.IComparable<materialization__Level> {
;; EXPECT-CS: public int CompareTo\(materialization__Level\? other\) => other is null \? 1 : Ord_materialization__Level\.Instance\.compare\(this, other\);
;; EXPECT-NO-CS: CompareTo\(materialization__Low
(type/derive (Ord)
  (: Level (Union Low (: Mid int) High)))

;; A conditional `Ord` materializes as a conditional `Eq` does, with a stand-in
;; that compares through `T_a`'s own `IComparable<T_a>` — and a string
;; ordinally, as `(Ord string)` does, where `Comparer<string>.Default` would
;; follow the machine's culture.
;; EXPECT-CS: public record materialization__Rank<T_a>\(int n, T_a tag\) : System.IComparable<materialization__Rank<T_a>> \{
;; EXPECT-CS: private static readonly Ord_materialization__Rank<T_a> __Ord_impl = Ord_materialization__Rank<T_a>\.Make\(new __ClrOrd<T_a>\(\)\);
;; EXPECT-CS: private sealed class __ClrOrd<X> : Ord<X> \{ public int compare\(X a, X b\) => typeof\(X\) == typeof\(string\) \? string\.CompareOrdinal\(\(string\?\)\(object\?\)a, \(string\?\)\(object\?\)b\) : System\.Collections\.Generic\.Comparer<X>\.Default\.Compare\(a, b\); bool BjolangRuntime\.IEvidence\.AgreesWithClr => typeof\(X\) != typeof\(string\); \}
;; EXPECT-CS: public int CompareTo\(materialization__Rank<T_a>\? other\) => other is null \? 1 : __Ord_impl\.compare\(this, other\);
(type/derive (Ord)
  (: (Rank %a) (Record (: n int) (: tag %a))))

;; A record struct: no null to guard against.
;; EXPECT-CS: public int CompareTo\(materialization__Deg<T_a> other\) => __Ord_impl\.compare\(this, other\);
(type/derive (Ord)
  (: (Deg %a) (Struct (: deg %a))))

;; A generic union: the field goes on the base beside `CompareTo`, and no case
;; class gets either. `Bottom` is `null` at run time, and the implementation
;; orders it, so `null` is passed through and not sorted first.
;; EXPECT-CS: public abstract record materialization__Tier<T_a> : System.IComparable<materialization__Tier<T_a>> \{
;; EXPECT-CS: private static readonly Ord_materialization__Tier<T_a> __Ord_impl = Ord_materialization__Tier<T_a>\.Make\(new __ClrOrd<T_a>\(\)\);
;; EXPECT-CS: public int CompareTo\(materialization__Tier<T_a>\? other\) => __Ord_impl\.compare\(this, other!\);
;; EXPECT-NO-CS: CompareTo\(materialization__Bottom
;; EXPECT-NO-CS: CompareTo\(materialization__Top
(type/derive (Ord)
  (: (Tier %a) (Union Bottom (: Top %a))))

;; An *unconditional* implementation for a parameterized type materializes: its
;; class abstracts over exactly the type's parameters, so it is instantiated at
;; them. Equality by tag alone needs nothing of `%a`, hence no `(where ...)`.
;; EXPECT-CS: public virtual bool Equals\(materialization__Tagged<T_a>\? other\) => other is not null && Eq_materialization__Tagged<T_a>\.Instance\.eq\(this, other\);
;; EXPECT-CS: public override int GetHashCode\(\) => Eq_materialization__Tagged<T_a>\.Instance\.eqsubhash\(this\);
(type
  (: (Tagged %a) (Record (: tag int) (: value %a))))

(impl (Eq (Tagged %a))
  (defun (= a b) (= (record-ref a tag) (record-ref b tag)))
  (defun (eq-hash a) (eq-hash (record-ref a tag))))
