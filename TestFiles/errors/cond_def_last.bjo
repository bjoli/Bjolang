;; A `cond` whose last clause binds.
;;
;; `:def` and `:do` answer nothing, so a cond that ends in one has no final
;; answer — the same gap as a cond with no `else`, and the same message.
;;
;; EXPECT-ERROR: cond needs a final (else ...) clause

(import (std prelude))

(: broken (-> int int))
(defun (broken n)
  (cond
    ((> n 0) 1)
    (:def x (+ n 1))))

(defun (main) (println (int->string (broken 0))) 0)
