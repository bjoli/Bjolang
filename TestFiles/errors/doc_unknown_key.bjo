;; A keyword the function does not take.

;; EXPECT-ERROR: documents (key seed ...), and scaled takes no #:seed. Its keyword parameters are #:by

(import (std prelude))

(:doc scaled (summary "Scales.") (arg x "The number.") (key seed "Nothing.") (returns "x, scaled."))
(: scaled (-> int (#:by int) int))
(defun (scaled x #:by 2) (* x by))

(defun (main args) 0)
