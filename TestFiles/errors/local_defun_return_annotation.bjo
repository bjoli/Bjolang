;; A body-local `defun`'s return-type annotation is checked against its body.
;;
;; The other half of `local_defun_arg_annotation.bjo`: this too was parsed and
;; discarded, so a body that returned something else was accepted without a
;; word.

;; EXPECT-ERROR: Type error: these types do not match.

(import (std prelude))

(defun (main)
  (defun (label n) : int
    (int->string n))

  (println (label 1))
  0)
