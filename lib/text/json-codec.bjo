;; text/json-codec.bjo — records to JSON and back.
;;
;; Two traits and a macro that writes the instances for a record.
;;
;; Nullable types are Options, keys that may be absent just specify a default
;; value

(export
  ;; The traits
  ->json json->
  ;; What generated field code calls. Exported because a macro template's names
  ;; resolve against this module's exports.
  json-object json-field json-field/default
  ;; The generator
  def/json-type)

(import (std prelude))
(import (std syntax-match))
;; For the instances of their types. An instance is written in the module of
;; its trait or of its type, and the modules of these types do not import
;; this one.
(import (std datetime))
(import (std uuid))
(import (text json))

;; Every export is documented there; the module doc is too.
(:doc #:file "json-codec.bjodoc")

;; ---------------------------------------------------------------------------
;; The traits
;; ---------------------------------------------------------------------------

(def/trait (->json %a)
  (: ->json (-> %a Json)))

(def/trait (json-> %a)
  (: json-> (-> Json (Result string %a))))

;; ---------------------------------------------------------------------------
;; Scalars
;; ---------------------------------------------------------------------------

(impl (->json Json)
  (defun (->json j)
    j))
(impl (->json long)
  (defun (->json n)
    (JsonInt n)))
(impl (->json int)
  (defun (->json n)
    (JsonInt (cast System.Int64 n))))
(impl (->json double)
  (defun (->json n)
    (JsonFloat n)))
(impl (->json float)
  (defun (->json n)
    (JsonFloat (cast System.Double n))))
(impl (->json bool)
  (defun (->json b)
    (JsonBool b)))
(impl (->json string)
  (defun (->json s)
    (JsonStr s)))

(impl (json-> Json)
  (defun (json-> j)
    (Ok j)))

(impl (json-> long)
  (defun (json-> j)
    (match j
      ((JsonInt n) (Ok n))
      (_ (Err "expected an integer")))))

(impl (json-> int)
  (defun (json-> j)
    (match j
      ;; A JsonInt is a long; one outside an int's range is refused rather
      ;; than wrapped by the cast.
      ((JsonInt n)
       (if (and (>= n -2147483648L) (<= n 2147483647L))
           (Ok (cast System.Int32 n))
           (Err "expected an integer that fits in an int")))
      (_ (Err "expected an integer")))))

(impl (json-> double)
  (defun (json-> j)
    (match j
      ((JsonFloat d) (Ok d))
      ;; an int is a valid double.
      ((JsonInt n) (Ok (cast System.Double n)))
      (_ (Err "expected a number")))))

;; A number that a float cannot hold exactly is rounded to the nearest one,
;; as a cast does.
(impl (json-> float)
  (defun (json-> j)
    (match j
      ((JsonFloat d) (Ok (cast System.Single d)))
      ((JsonInt n) (Ok (cast System.Single n)))
      (_ (Err "expected a number")))))

(impl (json-> bool)
  (defun (json-> j)
    (match j
      ((JsonBool b) (Ok b))
      (_ (Err "expected a boolean")))))

(impl (json-> string)
  (defun (json-> j)
    (match j
      ((JsonStr s) (Ok s))
      (_ (Err "expected a string")))))

;; ---------------------------------------------------------------------------
;; Nullability
;; ---------------------------------------------------------------------------

(impl (->json (Option %a))
  (where (->json %a))
  (defun (->json o)
    (match o
      ((Some x) (->json x))
      (None JsonNull))))

(impl (json-> (Option %a))
  (where (json-> %a))
  (defun (json-> j)
    (match j
      (JsonNull (Ok None))
      (_
       (match (json-> j)
         ((Err e) (Err e))
         ((Ok v) (Ok (Some v))))))))

;; ---------------------------------------------------------------------------
;; Arrays
;; ---------------------------------------------------------------------------

;; The elements of a JSON array, each one decoded.
;; - An error of an element has its index before it: `[3]: expected a string`.
(: (-> Json (Result string (Array %a))) (where (json-> %a)))
(defun (json-elements j)
  (match j
    ((JsonArr items)
     (def n (iarray-length items))
     (def (: out (Array %a)) (make-array n))
     (let go ((i 0))
       (if (= i n)
           (Ok out)
           (match (json-> (iarray-ref items i))
             ((Err e) (Err (str "[" (int->string i) "]: " e)))
             ((Ok v)
              (array-set! out i v)
              (go (+ i 1)))))))
    (_ (Err "expected an array"))))

;; Element `i` of a JSON array, decoded, with its index before an error.
(: (-> (IArray Json) int (Result string %a)) (where (json-> %a)))
(defun (json-element items i)
  (match (json-> (iarray-ref items i))
    ((Err e) (Err (str "[" (int->string i) "]: " e)))
    ((Ok v) (Ok v))))

(impl (->json (Vec %a))
  (where (->json %a))
  (defun (->json v)
    (JsonArr (vec->iarray (vec-map (fun (x) (->json x)) v)))))

(impl (json-> (Vec %a))
  (where (json-> %a))
  (defun (json-> j)
    (def (Ok items) (json-elements j) :propagate)
    (Ok (->vec items))))

(impl (->json (List %a))
  (where (->json %a))
  (defun (->json xs)
    (JsonArr (list->iarray (list-map (fun (x) (->json x)) xs)))))

(impl (json-> (List %a))
  (where (json-> %a))
  (defun (json-> j)
    (def (Ok items) (json-elements j) :propagate)
    (Ok (->list items))))

(impl (->json (Array %a))
  (where (->json %a))
  (defun (->json a)
    (JsonArr (array->iarray {arraying (->json x) (:for x a)}))))

(impl (json-> (Array %a))
  (where (json-> %a))
  (defun (json-> j)
    (json-elements j)))

(impl (->json (IArray %a))
  (where (->json %a))
  (defun (->json a)
    (JsonArr (iarray-map (fun (x) (->json x)) a))))

(impl (json-> (IArray %a))
  (where (json-> %a))
  (defun (json-> j)
    (def (Ok items) (json-elements j) :propagate)
    (Ok (array->iarray items))))

;; A tuple is an array of as many elements, each of its own type.
(impl (->json (Tuple %a %b))
  (where (->json %a) (->json %b))
  (defun (->json t)
    (def (Tuple a b) t)
    (JsonArr (list->iarray (list (->json a) (->json b))))))

(impl (json-> (Tuple %a %b))
  (where (json-> %a) (json-> %b))
  (defun (json-> j)
    (match j
      ((JsonArr items)
       (cond
         ((not (= (iarray-length items) 2))
          (Err (str "expected an array of 2 elements, and this has "
                    (int->string (iarray-length items)))))
         (:def (Ok a) (json-element items 0) :propagate)
         (:def (Ok b) (json-element items 1) :propagate)
         (else (Ok (Tuple a b)))))
      (_ (Err "expected an array of 2 elements")))))

(impl (->json (Tuple %a %b %c))
  (where (->json %a) (->json %b) (->json %c))
  (defun (->json t)
    (def (Tuple a b c) t)
    (JsonArr (list->iarray (list (->json a) (->json b) (->json c))))))

(impl (json-> (Tuple %a %b %c))
  (where (json-> %a) (json-> %b) (json-> %c))
  (defun (json-> j)
    (match j
      ((JsonArr items)
       (cond
         ((not (= (iarray-length items) 3))
          (Err (str "expected an array of 3 elements, and this has "
                    (int->string (iarray-length items)))))
         (:def (Ok a) (json-element items 0) :propagate)
         (:def (Ok b) (json-element items 1) :propagate)
         (:def (Ok c) (json-element items 2) :propagate)
         (else (Ok (Tuple a b c)))))
      (_ (Err "expected an array of 3 elements")))))

;; A JSON object with values all of one type.
(impl (->json (Map string %a))
  (where (->json %a))
  (defun (->json m)
    (JsonObj (map-map-values (fun (v) (->json v)) m))))

(impl (json-> (Map string %a))
  (where (json-> %a))
  (defun (json-> j)
    (match j
      ((JsonObj m)
       (map-fold (fun (k v acc)
                   (match acc
                     ((Err e) (Err e))
                     ((Ok b)
                      (match (json-> v)
                        ((Err e) (Err (str "\"" k "\": " e)))
                        ((Ok d) (Ok (map-set b k d)))))))
                 (Ok (map-empty))
                 m))
      ;; In order, so that a key written twice keeps its last value here too.
      ((JsonFields fields)
       (fold (fun (p acc)
               (def (Tuple k v) p)
               (match acc
                 ((Err e) (Err e))
                 ((Ok b)
                  (match (json-> v)
                    ((Err e) (Err (str "\"" k "\": " e)))
                    ((Ok d) (Ok (map-set b k d)))))))
             (Ok (map-empty))
             fields))
      (_ (Err "expected an object")))))

;; ---------------------------------------------------------------------------
;; Dates, times and UUIDs
;; ---------------------------------------------------------------------------
;; Each is the ISO 8601 string that `written` gives and `iso8601->...` reads,
;; and a Uuid its string in lower case.

;; The string of a JSON value, read by `read`. `what` names the type in the
;; error.
(: (-> Json (-> string (Option %a)) string (Result string %a)))
(defun (from-text j read what)
  (match j
    ((JsonStr s)
     (match (read s)
       ((Some v) (Ok v))
       (None (Err (str "expected " what ", and \"" s "\" is not one")))))
    (_ (Err (str "expected " what ", as a string")))))

(impl (->json Date)
  (defun (->json d)
    (JsonStr (written d))))
(impl (json-> Date)
  (defun (json-> j)
    (from-text j iso8601->date "an ISO 8601 date")))

(impl (->json Time)
  (defun (->json t)
    (JsonStr (written t))))
(impl (json-> Time)
  (defun (json-> j)
    (from-text j iso8601->time "an ISO 8601 time")))

(impl (->json DateTime)
  (defun (->json dt)
    (JsonStr (written dt))))
(impl (json-> DateTime)
  (defun (json-> j)
    (from-text j iso8601->datetime "an ISO 8601 date and time")))

(impl (->json Instant)
  (defun (->json i)
    (JsonStr (written i))))
(impl (json-> Instant)
  (defun (json-> j)
    (from-text j iso8601->instant "an ISO 8601 instant")))

(impl (->json Moment)
  (defun (->json m)
    (JsonStr (written m))))
(impl (json-> Moment)
  (defun (json-> j)
    (from-text j iso8601->moment "an ISO 8601 date and time with an offset")))

(impl (->json Duration)
  (defun (->json d)
    (JsonStr (written d))))
(impl (json-> Duration)
  (defun (json-> j)
    (from-text j iso8601->duration "an ISO 8601 duration")))

(impl (->json Uuid)
  (defun (->json u)
    (JsonStr (uuid->string u))))
(impl (json-> Uuid)
  (defun (json-> j)
    (from-text j string->uuid "a UUID")))

;; ---------------------------------------------------------------------------
;; What generated field code calls
;; ---------------------------------------------------------------------------

;; The object itself, a JsonObj or a JsonFields: json-field looks in either.
(: (-> string Json (Result string Json)))
(defun (json-object owner j)
  (match j
    ((JsonObj _) (Ok j))
    ((JsonFields _) (Ok j))
    (_ (Err (str owner ": expected an object")))))

;; The owner and key are prefixed onto whatever the value's own decoder said,
;; so a wrong type reads "Point.x: expected an integer" rather than naming
;; neither. Paths down the tree are not provided
(: (-> string Json string (Result string %a)) (where (json-> %a)))
(defun (json-field owner m key)
  (match (json-object-ref m key)
    (None (Err (str owner ": the object has no \"" key "\" field")))
    ((Some j) (result-map-err (fun (e) (str owner "." key ": " e)) (json-> j)))))

;; Absent and null ar the same in the sense that a nullable has the default value None
(: (-> string Json string %a (Result string %a)) (where (json-> %a)))
(defun (json-field/default owner m key fallback)
  (match (json-object-ref m key)
    (None (Ok fallback))
    ((Some JsonNull) (Ok fallback))
    ((Some j) (result-map-err (fun (e) (str owner "." key ": " e)) (json-> j)))))

;; ---------------------------------------------------------------------------
;; The generator
;; ---------------------------------------------------------------------------
;; This is a runtime macro. Field types are never inspected: what a field encodes as is
;; settled later by instance resolution, and only the markers are read here.

(: (-> string Syntax))
(defun (jt-sym name)
  (SSym (string->symbol name)))

(: (-> Syntax Syntax))
(defun (jt-str s)
  (SStr (syntax->string s)))

;; `(Box %a)` names the type `Box`; a bare `Point` names itself.
(: (-> Syntax Syntax))
(defun (jt-head-name head)
  (match head
    ((SList parts) (list-head parts))
    (_ head)))

(: (-> Syntax (List Syntax)))
(defun (jt-head-vars head)
  (match head
    ((SList parts) (list-tail parts))
    (_ Nil)))

(: (-> (-> Symbol Syntax) Syntax (List Syntax)))
(defun (jt-where-enc inject head)
  (def vars (jt-head-vars head))
  (if (list-empty? vars)
      Nil
      (list #'(,(inject 'where) ,@(list-map (fun (v) #'(,(inject (string->symbol "->json")) ,v))
                                            vars)))))

(: (-> (-> Symbol Syntax) Syntax (List Syntax)))
(defun (jt-where-dec inject head)
  (def vars (jt-head-vars head))
  (if (list-empty? vars)
      Nil
      (list #'(,(inject 'where) ,@(list-map (fun (v) #'(,(inject (string->symbol "json->")) ,v))
                                            vars)))))

;; --- fields ----------------------------------------------------------------

(: (-> Syntax string bool))
(defun (jt-marker=? m name)
  (= (syntax->string m) name))

;; The JSON key: `#:json "name"` means it uses the "name" as the key for the field
;; instead of the defined name
(: (-> Syntax (List Syntax) Syntax))
(defun (jt-key name markers)
  (let go ((ms markers))
    (cond
      ((list-empty? ms) (jt-str name))
      ((jt-marker=? (list-head ms) "#:json") (list-head (list-tail ms)))
      (else (go (list-tail ms))))))

;; The fallback expression, or None if the field is required. `#:optional` is
;; `#:default None`.
(: (-> (List Syntax) (Option Syntax)))
(defun (jt-fallback markers)
  (let go ((ms markers))
    (cond
      ((list-empty? ms) None)
      (else
       (def m (list-head ms))
       (cond
         ((jt-marker=? m "#:optional") (Some (jt-sym "None")))
         ((jt-marker=? m "#:default") (Some (list-head (list-tail ms))))
         (else (go (list-tail ms))))))))

;; strip json markers (default, json, optional)
(: (-> (List Syntax) (List Syntax)))
(defun (jt-keep markers)
  (let go ((ms markers))
    (cond
      ((list-empty? ms) Nil)
      (else
       (def m (list-head ms))
       (cond
         ((jt-marker=? m "#:default") (go (list-tail (list-tail ms))))
         ((jt-marker=? m "#:json") (go (list-tail (list-tail ms))))
         ((jt-marker=? m "#:optional") (go (list-tail ms)))
         (else (Cons m (go (list-tail ms)))))))))

(: string)
(def jt-shape
  "a field is written (: name type), then any of #:mutable, #:optional, #:default <expr>, #:json \"key\".")

;; `syntax-error` has the type Syntax, so this is how we work around it.
(: (-> Syntax string (List Syntax)))
(defun (jt-fail-list form message)
  (ignore (syntax-error form message))
  Nil)

(: (-> Syntax Syntax))
(defun (jt-field-name f)
  (syntax-match f
    ((_ name _ marker ...) name)
    (bad (syntax-error bad jt-shape))))

(: (-> Syntax (List Syntax)))
(defun (jt-field-markers f)
  (syntax-match f
    ((_ _ _ marker ...) marker)
    (bad (jt-fail-list bad jt-shape))))

(: (-> Syntax Syntax))
(defun (jt-strip f)
  (syntax-match f
    ((colon name ty marker ...) #'(,colon ,name ,ty ,@(jt-keep marker)))
    (bad (syntax-error bad jt-shape))))

;; --- encode ----------------------------------------------------------------

;; An optional field is dropped when it is None; everything else is written.
(: (-> Syntax Syntax Syntax))
(defun (jt-put buf f)
  (def name (jt-field-name f))
  (def markers (jt-field-markers f))
  (def write #'(transientmap-set! ,buf ,(jt-key name markers) (->json (record-ref v ,name))))
  (if (jt-optional? markers)
      #'(when (some? (record-ref v ,name))
          ,write)
      write))

(: (-> (List Syntax) bool))
(defun (jt-optional? markers)
  (let go ((ms markers))
    (cond
      ((list-empty? ms) #f)
      ((jt-marker=? (list-head ms) "#:optional") #t)
      (else (go (list-tail ms))))))

(: (-> (List Syntax) Syntax))
(defun (jt-encode fields)
  (def buf (jt-sym "__jt-buf"))
  #'(let ((,buf (transientmap-empty)))
      ,@(list-map (fun (f) (jt-put buf f)) fields)
      (JsonObj (transientmap->map ,buf))))

;; --- decode ----------------------------------------------------------------

;; One `match` per field wrapping the next, with the constructor innermost.
;; Verbose. Macrology.
(: (-> Syntax Syntax (List Syntax) int Syntax Syntax))
(defun (jt-chain owner m fields i ctor)
  (cond
    ((list-empty? fields) ctor)
    (else
     (def f (list-head fields))
     (def v (jt-sym (str "__jt-v" (int->string i))))
     (def e (jt-sym (str "__jt-e" (int->string i))))
     (def name (jt-field-name f))
     (def markers (jt-field-markers f))
     (def get
       (match (jt-fallback markers)
         (None #'(json-field ,owner ,m ,(jt-key name markers)))
         ((Some d) #'(json-field/default ,owner ,m ,(jt-key name markers) ,d))))
     #'(match ,get
         ((Err ,e) (Err ,e))
         ((Ok ,v) ,(jt-chain owner m (list-tail fields) (+ i 1) ctor))))))

(: (-> Syntax (List Syntax) Syntax))
(defun (jt-ctor head fields)
  #'(Ok (,(jt-head-name head)
         ,@(let go ((fs fields)
                    (i 0))
             (if (list-empty? fs)
                 Nil
                 (Cons #'(,(jt-field-name (list-head fs)) ,(jt-sym (str "__jt-v" (int->string i))))
                       (go (list-tail fs) (+ i 1))))))))

(: (-> Syntax (List Syntax) Syntax))
(defun (jt-decode head fields)
  (def owner (jt-str (jt-head-name head)))
  (def m (jt-sym "__jt-m"))
  (def e (jt-sym "__jt-e"))
  #'(match (json-object ,owner j)
      ((Err ,e) (Err ,e))
      ((Ok ,m) ,(jt-chain owner m fields 0 (jt-ctor head fields)))))

;; --- the form ---------------------------------------------------------------

(: (-> (-> Symbol Syntax) Syntax Syntax (List Syntax) Syntax))
(defun (jt-expand inject colon head fields)
  (def name (syntax->string (jt-head-name head)))
  (def enc (inject (string->symbol (str name "->json"))))
  (def dec (inject (string->symbol (str "json->" name))))
  #'(begin
      (type (,colon ,head (Record ,@(list-map jt-strip fields))))

      (impl (->json ,head)
        ,@(jt-where-enc inject head)
        (defun (->json v)
          ,(jt-encode fields)))

      (impl (json-> ,head)
        ,@(jt-where-dec inject head)
        (defun (json-> j)
          ,(jt-decode head fields)))

      ;; The named pair. `json->` alone would be ambiguous at a call site;
      ;; this signature is what fixes the instance, once per type.
      (: ,enc (-> ,head Json) ,@(jt-where-enc inject head))
      (defun (,enc v)
        (->json v))
      (: ,dec (-> Json (Result string ,head)) ,@(jt-where-dec inject head))
      (defun (,dec j)
        (json-> j))))

(def/macro (def/json-type form inject compare)
  (syntax-match form
    ((_ typedef)
     (syntax-match typedef
       ((colon head ('Record field ...)) (jt-expand inject colon head field))
       (bad
        (syntax-error
         bad
         "def/json-type takes a record: (def/json-type (: Name (Record (: field type) ...)))"))))
    (bad (syntax-error bad "def/json-type takes exactly one record declaration."))))
