;; (std datetime): date-period-series and duration-series. Element k is the
;; start moved by k steps, from the start each time, so month-end clamping
;; does not drift; a series ends at the edge of the calendar.
(import (std prelude))
(import (std simpletest))
(import (std datetime))

(: (-> (Option %a) %a))
(defun (the o)
  (match o
    ((Some x) x)
    (None (panic! "a constant date or zone came back None"))))

(: (-> (-> %a) bool))
(defun (refused? thunk)
  (err? (try (thunk) #:catch (System.ArgumentException))))

;; The first n elements, as written.
(: (-> int (Seq %a) string) (where (Written %a)))
(defun (first-of n s) (string-join (->vec (map displayed (take n s))) " "))

(: (-> (Seq %a) int))
(defun (count-of s) (list-length (->list s)))

(: (-> void))
(defun (dates)
  (expect "monthly from January 31 does not drift"
          (first-of 4 (date-period-series (the (date 2026 1 31)) (date-period #:months 1)))
          "2026-01-31 2026-02-28 2026-03-31 2026-04-30")
  (expect "in a leap year"
          (first-of 2 (date-period-series (the (date 2024 1 31)) (date-period #:months 1)))
          "2024-01-31 2024-02-29")
  (expect "yearly from February 29"
          (first-of 5 (date-period-series (the (date 2024 2 29)) (date-period #:years 1)))
          "2024-02-29 2025-02-28 2026-02-28 2027-02-28 2028-02-29")
  (expect "weekly, backwards"
          (first-of 3 (date-period-series (the (date 2026 1 14)) (date-period #:weeks -1)))
          "2026-01-14 2026-01-07 2025-12-31")
  (expect "a period of two parts"
          (first-of 3 (date-period-series (the (date 2026 1 1)) (date-period #:months 1 #:days 1)))
          "2026-01-01 2026-02-02 2026-03-03")
  (expect "ends at 9999-12-31"
          (count-of (date-period-series (the (date 9999 12 1)) (date-period #:days 1))) 31)
  (expect "and backwards at 0001-01-01"
          (count-of (date-period-series (the (date 1 1 3)) (date-period #:days -1))) 3)
  (expect "a step past the end at once leaves the start alone"
          (count-of (date-period-series (the (date 9999 1 1)) (date-period #:years 1))) 1)
  (expect-true "a zero step raises"
               (refused? (fun () (date-period-series (the (date 2026 1 1)) (date-period))))))

(: (-> void))
(defun (durations)
  (expect "a datetime by 90 minutes"
          (first-of 3 (duration-series (the (datetime 2026 1 1 #:hours 23)) (duration #:minutes 90)))
          "2026-01-01T23:00:00 2026-01-02T00:30:00 2026-01-02T02:00:00")
  (expect "a time of day wraps"
          (first-of 4 (duration-series (the (time 22 0)) (duration #:hours 1)))
          "22:00:00 23:00:00 00:00:00 01:00:00")
  (expect "a duration"
          (first-of 3 (duration-series (duration #:hours 1) (duration #:minutes -30)))
          "PT1H PT30M PT0S")
  (expect "an instant ends at the calendar's end"
          (count-of (duration-series (the (iso8601->instant "9999-12-31T21:00:00Z")) (duration #:hours 1)))
          3)
  (expect-true "a zero step raises"
               (refused? (fun () (duration-series (the (time 1 0)) (duration))))))

(: (-> TimeZone void))
(defun (moments z)
  (def noon (datetime->moment (the (datetime 2026 10 24 #:hours 12)) z compatible-resolver))
  (expect "daily keeps the local time across a change"
          (first-of 3 (date-period-series noon (date-period #:days 1)))
          "2026-10-24T12:00:00+02:00[Europe/Stockholm] 2026-10-25T12:00:00+01:00[Europe/Stockholm] 2026-10-26T12:00:00+01:00[Europe/Stockholm]")
  (def before-gap (datetime->moment (the (datetime 2026 3 28 #:hours 2 #:minutes 30)) z compatible-resolver))
  (expect "a day in the gap is pushed, and the next is back at 02:30"
          (first-of 3 (date-period-series before-gap (date-period #:days 1)))
          "2026-03-28T02:30:00+01:00[Europe/Stockholm] 2026-03-29T03:30:00+02:00[Europe/Stockholm] 2026-03-30T02:30:00+02:00[Europe/Stockholm]")
  (def before-overlap (datetime->moment (the (datetime 2026 10 25 #:hours 1 #:minutes 30)) z compatible-resolver))
  (expect "hourly passes 02:30 twice"
          (first-of 4 (duration-series before-overlap (duration #:hours 1)))
          "2026-10-25T01:30:00+02:00[Europe/Stockholm] 2026-10-25T02:30:00+02:00[Europe/Stockholm] 2026-10-25T02:30:00+01:00[Europe/Stockholm] 2026-10-25T03:30:00+01:00[Europe/Stockholm]"))

(defun (main)
  (dates)
  (durations)
  (match (timezone "Europe/Stockholm")
    ((Some z) (moments z))
    (None (fail "the IANA time zone database was not found. Install tzdata.")))
  0)
