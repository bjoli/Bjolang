;; A vector holds one of the primitive numbers `Lane` lists. .NET refuses a
;; vector of anything else when it is made, at run time; the checker refuses
;; it when it is compiled.

;; EXPECT-ERROR: no implementation of trait 'Lane' for 'char'

(import (std prelude))
(import (std simd))

(defun (main)
  (println (simd-lanes (simd128-splat #\a)))
  0)
