;; `#:elsewhere` cannot name a keyword parameter.

;; EXPECT-ERROR: #:elsewhere names 'work', and 'run' has the positional parameters 'n'.
;; EXPECT-ERROR: a keyword or rest parameter cannot be named

(import (std prelude))

(: (-> int (#:work (-> int)) int) #:elsewhere work)
(defun (run n #:work (fun () 0)) (+ n (work)))

(defun (main)
  (println (int->string (run 1)))
  0)
