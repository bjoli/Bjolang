;; A case of an `#:opaque` union, matched from outside the module that declared
;; it.
;;
;; The case is registered here like any other, since `vault` publishes it for
;; its own bodies to be checked where they land. `checkPattern` refuses it
;; because the pattern is this module's code, and only `vault`'s may take a
;; `Handle` apart.

;; EXPECT-ERROR: the constructor 'vault/Live'
;; EXPECT-ERROR: vault/Handle, which cannot be taken apart here
;; EXPECT-ERROR: exported #:opaque

(import "../inc/vault.bjo")

(defun (main args)
  (println (int->string
    (match (open-handle 1 2)
      ((Live v tag) tag)
      (Closed 0))))
  0)
