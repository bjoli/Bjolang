;; A date has no time of day, so there is nothing for `+hours` to move.

;; EXPECT-ERROR: no implementation of trait 'TimeArith' for 'datetime/Date', needed to call '+hours'
;; EXPECT-NO-ERROR: could not specialise

(import (std datetime))

(defun (main)
  (match (date 2026 10 25)
    ((Some d) (println (+hours d 2)))
    (None (println "none")))
  0)
