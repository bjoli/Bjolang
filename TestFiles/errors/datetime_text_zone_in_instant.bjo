;; An instant has no zone, only UTC, so its format has an offset, written Z,
;; and no zone to name.

;; EXPECT-ERROR: `zone` is not a tag of the union datetime/InstantPart

(import (std datetime))

(defun (main)
  (match (unix-seconds->instant 0L)
    ((Some i) (println (instant->text i '((hours 2) " " zone))))
    (None (println "none")))
  0)
