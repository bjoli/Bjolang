(import (std prelude))
(import (std simpletest))

;; Sanningstabellerna för and/or/not.
;;
;; Filen räknade redan rätt svar och skrev "Wrong" när något inte stämde — men
;; körningen underkänns bara på "FAILURE:", så den gick igenom hur fel svaren
;; än blev.
(defun (main args)
    (expect "or, both operands false" (or (= 0 3) (= 4 0)) #f)
    (expect "and, second operand false" (and (= 3 3) (= 4 0)) #f)
    (expect "or, second operand true" (or (= 0 3) (= 4 4)) #t)
    (expect "and, both operands true" (and (= 4 4) (= 0 0)) #t)
    (expect "not true" (not #t) #f)
    (expect "not false" (not #f) #t)
    0
)
