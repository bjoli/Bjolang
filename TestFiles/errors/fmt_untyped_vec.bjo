;; A vec bound by def without a type is a vec of strings, which is not a
;; block: a block holds a vec of blocks.
;; EXPECT-ERROR: Block: expected a string, an int, a char, a (Vec fmt/Block)
;; EXPECT-ERROR: found a (Vec string).
(import (std prelude))
(import (std fmt))
(defun (main) (def bs ["a" "b"]) (show bs) 0)
