;; Docs for the prelude's strings, cursors and string walks, read through
;; (:doc #:file "prelude-strings.bjodoc"). The texts are samizdat markup: code
;; in prose is @code{...}.
;;
;; A string is UTF-8 and always valid. string-length counts its bytes and
;; string-count its characters; positions in it are cursors, never indices.

;; ---------------------------------------------------------------------------
;; Building and measuring
;; ---------------------------------------------------------------------------

(:doc string-count
  (summary "The number of characters in a string.")
  (arg s "The string.")
  (returns "How many characters (Unicode scalar values) s holds.")
  (see string-length length)
  (reference """
    O(n): the characters are counted, not stored. @code{string-length} is
    the O(1) byte length. @code{length} on a string returns this count as well.
    """))

(:doc string-empty?
  (summary "Whether a string has no characters.")
  (arg s "The string.")
  (returns "#t for the empty string.")
  (see string-length))

;; ---------------------------------------------------------------------------
;; .NET's string
;; ---------------------------------------------------------------------------

(:doc string->clr-string
  (summary "The same text as a .NET System.String.")
  (arg s "The string.")
  (returns "A UTF-16 System.String with the same characters.")
  (see clr-string->string)
  (reference """
    A .NET member that takes a @code{System.String} directly is converted at
    the call, so this is needed only for a .NET string inside another type,
    such as an element of a @code{(Seq System.String)} or the argument of a
    @code{Func}.
    """))

;; ---------------------------------------------------------------------------
;; Searching and rewriting
;; ---------------------------------------------------------------------------

(:doc string-search
  (summary "Where the first occurrence of a text in a string starts.")
  (arg s "The string to search.")
  (arg needle "The text to look for.")
  (returns "(Some cursor) on the start of the first occurrence, or None. An empty needle is found at the start.")
  (see string-search-backward string-find substring string-contains?)
  (example """
    (match (string-search line "=")
      ((Some c) (substring line (string-cursor-start line) c))   ; the key
      (None line))
    """)
  (reference """
    Ordinal. The returned cursor can be passed directly to
    @code{substring}; there is no byte index to get wrong. In a slice, the
    cursor is a position in the string the slice was taken from.
    """))

(:doc string-search-backward
  (summary "Where the last occurrence of a text in a string starts.")
  (arg s "The string to search.")
  (arg needle "The text to look for.")
  (returns "(Some cursor) on the start of the last occurrence, or None. An empty needle is found at the end.")
  (see string-search substring))

(:doc string-search-any
  (summary "Where the first character of a set is, at or after a cursor.")
  (arg s "The string to search.")
  (arg chars "The set, as a string of its characters. Their order does not matter.")
  (arg start "Where to start, a cursor of s.")
  (returns "(Some cursor) on the first character at or after start that is in chars, or None. An empty set is never found.")
  (see string-search string-find stringbuilder-add-substring!)
  (example """
    ;; `&` and `<` as HTML has them. The text between them is copied whole.
    (def b (stringbuilder-empty))
    (let go ((from (string-cursor-start s)))
      (match (string-search-any s "&<" from)
        (None (stringbuilder-add-substring! b s from (string-cursor-end s)))
        ((Some at)
         (stringbuilder-add-substring! b s from at)
         (stringbuilder-add-string! b (if (char=? (string-cursor-ref s at) #\&) "&amp;" "&lt;"))
         (go (string-cursor-next s at)))))
    """)
  (reference """
    When every character of the set is ASCII, the search is a vectorized
    search of the bytes, which is many times faster than a
    @code{string-find} that tests each character. An ASCII byte is never part
    of a longer character in UTF-8, so the cursor found is on a character. A
    set with a character outside ASCII is searched one character at a time.

    The set a string makes is kept for as long as the string is, so a set
    written once, as a literal or a @code{def}, is made once. A set that is a
    slice of a longer string is made at each call.

    In a slice, the cursor is a position in the string the slice was taken
    from, as for @code{string-search}.
    """))

