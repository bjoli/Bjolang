;; Docs for std/effect.bjo, read through (:doc #:file "effect.bjodoc"). The
;; texts are samizdat markup: code in prose is @code{...}.

(:doc #:module
  (summary "Tail-resumptive effect handlers: declare operations, invoke them, and install dynamic handlers.")
  (see defeffect with-handler handler-of)
  (example """
    (import (std prelude))
    (import (std effect))

    (defeffect Console
      (say (-> string void))
      #:default ((say (fun (s) (println s)))))

    (defun (greet who) (say (str "hello " who)))

    (greet "world")                          ; default handler: prints to stdout
    (with-handler ((say (fun (s) (ignore s))))
      (greet "nobody"))                      ; custom handler: suppresses output
    """)
  (reference """
    An effect operation is a dynamic parameter holding a handler function.
    Invoking an operation reads the parameter and calls the current handler.
    @code{with-handler} acts as @code{parameterize} over these operation
    parameters. Callers perform operations without knowledge of concrete
    handler implementations, allowing callers to substitute behaviors (for
    example, redirecting logs in tests).

    @strong{Execution semantics.} Handlers execute directly on the stack of the
    invoking code without capturing continuations. A handler can either return
    a value (resuming execution) or raise an exception (aborting execution).
    Non-local control flow like generators, backtracking, or multi-shot
    resumption is not supported on this backend.

    @strong{Generated identifiers.} For each operation @code{op},
    @code{defeffect} generates two identifiers: @code{op/op} (the dynamic
    parameter) and @code{op} (the dispatch function). Modules that expose
    effect operations export both.

    @strong{Function color.} Operations declared with @code{(-> ...)} take
    synchronous @code{fun} handlers and can be performed anywhere (including
    inside @code{defun}). Operations declared with @code{(-bjo-> ...)} take
    asynchronous @code{bjoroutine} handlers and can only be invoked from within
    bjoroutines. Prefer synchronous @code{(-> ...)} when possible; operations
    needing asynchronous resources can return objects that suspend independently
    (such as ports).

    @strong{Dependencies.} This module does not import the prelude, allowing
    the prelude to declare effects of its own. Operation parameters use runtime
    primitives available in any module.
    """))

(:doc unhandled-effect
  (summary "Raises Unhandled when an unconfigured operation is invoked.")
  (arg operation "The name of the operation.")
  (returns "Never returns. Always raises Bjolang.Runtime.Unhandled.")
  (raises Unhandled "Always. The message identifies the operation.")
  (see defeffect)
  (reference """
    Fallback handler for operations declared without a @code{#:default}
    clause.
    """))

(:doc defeffect
  (summary "Declares effect operations with signatures and optional default handlers.")
  (form (defeffect name operation ...))
  (form (defeffect name operation ... #:default (default ...) #:cold (cold ...) #:adopt (adopt ...)))
  (arg name "The effect name (used for documentation; no runtime binding is created).")
  (rest operation """
    @code{(op arrow)}: operation name and signature (@code{(-> ...)} or
    @code{(-bjo-> ...)}).
    """)
  (rest default """
    @code{(op handler)}: fallback handler when no dynamic handler is installed.
    Operations without defaults raise @code{Bjolang.Runtime.Unhandled}.
    """)
  (rest cold """
    Operations configured to use cold dynamic parameters instead of fast
    parameter slots.
    """)
  (rest adopt """
    @code{(op fn)}: an interceptor function that processes values returned by
    the handler before they reach the caller.
    """)
  (see with-handler handler-of unhandled-effect)
  (example """
    (defeffect Log
      (log   (-> string void))
      (audit (-bjo-> string void))
      #:default ((log (fun (s) (println s))))
      #:cold (audit))
    """)
  (reference """
    The @code{#:default}, @code{#:cold}, and @code{#:adopt} clauses are
    optional and order-independent. Each operation defines a parameter
    (@code{op/op}) and a dispatch function (@code{op}). Handlers are installed
    per-operation using @code{with-handler}.

    @strong{Default handlers.} Provide defaults when a sensible standard
    implementation exists. Omit defaults when unhandled operations should fail
    explicitly. The handler color must match the operation signature.

    @strong{Cold parameters.} The dynamic environment provides 31 fast
    parameter slots. @code{#:cold} places an operation's parameter in cold
    storage to reserve fast slots for high-frequency operations.

    @strong{Resource adoption.} Use @code{#:adopt} when an operation creates
    resources (such as ports) that require registration in the caller's scope.
    If the operation returns raw data and the caller creates the resource,
    @code{#:adopt} is not needed.
    """))

(:doc with-handler
  (summary "Runs a body with dynamic handlers installed for specified effect operations.")
  (form (with-handler ((op handler) ...) body ...))
  (arg op "The operation name declared by defeffect. At least one binding required.")
  (arg handler "The handler function, matching the color of the operation.")
  (rest body "Expressions to execute. Returns the result of the final expression.")
  (see defeffect handler-of)
  (example """
    (def buf (make-box ""))
    (with-handler ((log (fun (s) (box-set! buf (str (box-ref buf) s)))))
      (run-job))
    """)
  (reference """
    Acts as @code{parameterize} over the operation parameters. Bindings are
    established simultaneously and restored upon exit (normal or exceptional).
    Handlers run directly on the stack of the code invoking the operation;
    exceptions raised by handlers unwind from the invocation point, not the
    definition site.

    @strong{Fiber lifetimes.} @code{with-handler} does not await background
    fibers spawned inside its body. Spawned fibers inherit currently installed
    handlers at spawn time, but may outlive the @code{with-handler} block itself.
    To collect results from background fibers, place accumulators outside the
    fiber management scope.

    @strong{Forwarding to existing handlers.} A handler runs with itself active.
    Invoking its own operation directly causes infinite recursion. Use
    @code{handler-of} to obtain the previously installed handler before defining
    the replacement.

    @strong{Identifier resolution.} @code{with-handler} constructs the parameter
    identifier directly from the operation name (@code{log} becomes
    @code{op/log}). If an operation is imported with a prefix or alias, use
    @code{parameterize} directly on the qualified parameter symbol.
    """))

(:doc handler-of
  (summary "Retrieves the currently installed handler function for an operation.")
  (form (handler-of op))
  (arg op "The operation name declared by defeffect.")
  (see with-handler)
  (reference """
    Expands to @code{(parameter-ref op/op)}. Use within @code{with-handler}
    bindings to delegate or wrap previously installed handlers.
    """))
