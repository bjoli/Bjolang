;; The module the facades of `603_c_everything_from` re-export.
(import (std prelude))
(import (std syntax-match))

(type (: Shape (Union (: Circle double)
                      (: Square double))))

(def/trait (Named %a)
  (: name-of (-> %a string)))

(impl (Named Shape)
  (defun (name-of s)
    (match s
      ((Circle _) "circle")
      ((Square _) "square"))))

(: area (-> Shape double))
(defun (area s)
  (match s
    ((Circle r) (* 3.0 r r))
    ((Square w) (* w w))))

(: greet (-> string string))
(defun (greet n) (str "hello " n))

(def/macro (twice form inject compare)
  (syntax-match form
    ((_ e)
     #'(begin
         ,e
         ,e))))

(export Shape Named area greet twice)
