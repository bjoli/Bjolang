;; The file operations past reading and writing text: what a path is, how big
;; and how old, moving over a file, copying, bytes and lines whole, and
;; walking a tree.
;;
;; Everything is built over the `FS` effect, so each check runs on a fake and,
;; where the disk can answer the same question, on the disk in a probe
;; directory this file makes and deletes.

(import (std prelude))
(import (std effect))
(import (std simpletest))
(import (std datetime))

(import/class
  (FileSystemInfo (: System.IO.FileSystemInfo)))

(import/extern
  (clr-symlink (: System.IO.File.CreateSymbolicLink (-> string string FileSystemInfo)
                  #:exceptions (System.IO.IOException System.UnauthorizedAccessException)))
  (clr-dir-symlink (: System.IO.Directory.CreateSymbolicLink (-> string string FileSystemInfo)
                      #:exceptions (System.IO.IOException System.UnauthorizedAccessException))))

;; What a path is, as one string a check can compare: "file 3", "dir 0" or
;; "none".
(: (-> string string))
(defun (described path)
  (match (file-info path)
    ((Some info)
     (str (match (record-ref info kind)
            (FsFile "file")
            (FsDirectory "dir")
            (FsLink "link")
            (FsOther "other"))
          " "
          (displayed (record-ref info size))))
    (None "none")))

;; The modified time, or -1 for a path that names nothing.
(: (-> string long))
(defun (modified path)
  (match (file-info path)
    ((Some info) (record-ref info modified-ms))
    (None -1L)))

(: (-> string bool))
(defun (link? path)
  (match (file-info path)
    ((Some info) (record-ref info link?))
    (None #f)))

;; 2000-01-01T00:00:00Z, the fake clock's start, in Unix milliseconds.
(: long)
(def epoch 946684800000L)

(: string)
(def probe "249_probe_dir")

(: (-> string string))
(defun (in-probe name) (path-combine probe name))

(: (-> (Result %e %a) bool))
(defun (threw? r)
  (match r
    ((Ok _) #f)
    ((Err _) #t)))

(: (-> string string string))
(defun (under dir name) (path-combine dir name))

;; Every byte value, 0 to 255, most of which is not UTF-8 on its own.
(: (Array byte))
(def all-bytes
  (let ((out (make-array 256)))
    (let loop ((i 0))
      (when (< i 256)
        (array-set! out i (cast byte i))
        (loop (+ i 1))))
    out))

(: (-> (Array byte) (Array byte) bool))
(defun (same-bytes? a b)
  (and (= (array-length a) (array-length b))
       (let loop ((i 0))
         (or (= i (array-length a)) (and (= (array-ref a i) (array-ref b i)) (loop (+ i 1)))))))

(: (-> (List string) (Vec string)))
(defun (vec-of xs) (list->vec xs))

;; ---------------------------------------------------------------------------
;; file-info
;; ---------------------------------------------------------------------------

(: (-> void))
(defun (info-on-a-fake)
  (def fs (fake-fs (list (Tuple "a.txt" "abc") (Tuple "å.txt" "å") (Tuple "d/x.txt" "x"))))
  (with-fake-fs-of fs
    (expect "a seeded file" (described "a.txt") "file 3")
    (expect "its size is in bytes, not characters" (described "å.txt") "file 2")
    (expect "a directory implied by a seed" (described "d") "dir 0")
    (expect "a missing path" (described "nowhere.txt") "none")
    (expect "a seed has the clock's start" (modified "a.txt") epoch)
    (expect-true "and is not a link" (not (link? "a.txt")))

    ;; Each write moves the clock one second on, so later is newer.
    (raise-err (file-write-text "b.txt" "bb"))
    (raise-err (file-write-text "c.txt" "c"))
    (expect "a write is a second after the start" (modified "b.txt") (+ epoch 1000L))
    (expect "the next a second after that" (modified "c.txt") (+ epoch 2000L))
    (expect "a written file's size" (described "b.txt") "file 2")
    (raise-err (directory-create "e"))
    (expect "a directory made is stamped too" (modified "e") (+ epoch 3000L))

    ;; A time set by hand is what `file-info` answers, and a move keeps it.
    (fake-fs-set-modified! fs "a.txt" 5L)
    (expect "a time set by hand" (modified "a.txt") 5L)
    (raise-err (file-move "a.txt" "moved.txt"))
    (expect "a move keeps the time" (modified "moved.txt") 5L)
    (expect "and the old path names nothing" (described "a.txt") "none")

    ;; A file deleted and written again is new.
    (raise-err (file-delete "c.txt"))
    (raise-err (file-write-text "c.txt" "again"))
    (expect "a file written again after a delete" (modified "c.txt") (+ epoch 4000L))

    ;; The functions that only ask what a path is ask the same operation.
    (expect-true "file-exists?" (file-exists? "b.txt"))
    (expect-true "directory-exists?" (directory-exists? "d"))
    (expect-true "not a file" (not (file-exists? "d")))))

(: (-> void))
(defun (info-on-the-disk)
  (raise-err (directory-create probe))
  (raise-err (file-write-text (in-probe "abc.txt") "abc"))
  (raise-err (file-write-text (in-probe "å.txt") "å"))
  (expect "a real file" (described (in-probe "abc.txt")) "file 3")
  (expect "its size is in bytes" (described (in-probe "å.txt")) "file 2")
  (expect "a real directory" (described probe) "dir 0")
  (expect "a missing path" (described (in-probe "nowhere.txt")) "none")
  (expect "an empty path names nothing, and throws nothing" (described "") "none")
  (def now-ms (instant->unix-milliseconds (now)))
  (def age (- now-ms (modified (in-probe "abc.txt"))))
  (expect-true "the time is the write's, give or take a minute" (and (> age -60000L) (< age 60000L)))
  (expect-true "a plain file is not a link" (not (link? (in-probe "abc.txt"))))
  ;; Some systems refuse an unprivileged symbolic link. There is nothing to
  ;; check then.
  (match (clr-symlink (in-probe "link.txt") "abc.txt")
    ((Ok _)
     (expect-true "a symbolic link says so" (link? (in-probe "link.txt")))
     (expect "and is what it points at" (described (in-probe "link.txt")) "file 3"))
    ((Err _) (println "ok: symbolic links are refused here, so not checked"))))

;; ---------------------------------------------------------------------------
;; file-move
;; ---------------------------------------------------------------------------

;; The same checks on the fake and on the disk: `where` says which.
(: (-> string void))
(defun (check-moves where)
  (def a (in-probe "a.txt"))
  (def b (in-probe "b.txt"))
  (def c (in-probe "c.txt"))
  (def d (in-probe "d"))
  (raise-err (directory-create d))
  (raise-err (file-write-text a "A"))
  (raise-err (file-write-text b "B"))
  (expect-true #"${where}: MoveNew onto a file fails" (threw? (file-move a b)))
  (expect #"${where}: and changes nothing"
          (str (raise-err (file-read-text a)) (raise-err (file-read-text b)))
          "AB")
  (raise-err (file-move a b #:mode MoveReplace))
  (expect #"${where}: MoveReplace replaces a file" (raise-err (file-read-text b)) "A")
  (expect-true #"${where}: and the source is gone" (not (file-exists? a)))
  (expect-true #"${where}: MoveReplace onto a directory fails"
               (threw? (file-move b d #:mode MoveReplace)))
  (expect-true #"${where}: and the file is still there" (file-exists? b))
  (expect-true #"${where}: a directory never replaces a file"
               (threw? (file-move d b #:mode MoveReplace)))
  (expect-true #"${where}: and both are still there" (and (directory-exists? d) (file-exists? b)))
  (expect-true #"${where}: a missing source fails, even replacing"
               (threw? (file-move a b #:mode MoveReplace)))
  (expect #"${where}: and the target is intact" (raise-err (file-read-text b)) "A")
  (raise-err (file-move b c #:mode MoveReplace))
  (expect #"${where}: MoveReplace onto a free path moves" (raise-err (file-read-text c)) "A"))

;; ---------------------------------------------------------------------------
;; file-copy, bytes and lines
;; ---------------------------------------------------------------------------
;;
;; Each takes the directory to work in, so that a second run does not find
;; the first one's files.

(: (-> string string void))
(defun (check-copies where dir)
  (raise-err (directory-create dir))
  (def src (under dir "src.txt"))
  (def dst (under dir "dst.txt"))
  (raise-err (file-write-text src "source"))
  (raise-err (file-write-text dst "old"))
  (expect-true #"${where}: a copy refuses an existing target by default" (threw? (file-copy src dst)))
  (expect #"${where}: and leaves it as it was" (raise-err (file-read-text dst)) "old")
  (raise-err (file-copy src dst #:mode Truncate))
  (expect #"${where}: Truncate replaces it" (raise-err (file-read-text dst)) "source")
  (raise-err (file-copy src dst #:mode Append))
  (expect #"${where}: Append adds to it" (raise-err (file-read-text dst)) "sourcesource")
  (raise-err (file-copy src (under dir "fresh.txt")))
  (expect #"${where}: the default copies to a free path"
          (raise-err (file-read-text (under dir "fresh.txt")))
          "source")
  (expect-true #"${where}: a missing source fails"
               (threw? (file-copy (under dir "missing.txt") dst #:mode Truncate)))
  (expect #"${where}: and leaves the target as it was"
          (raise-err (file-read-text dst))
          "sourcesource")
  (expect-true #"${where}: a copy onto itself fails" (threw? (file-copy src src #:mode Truncate)))
  (expect #"${where}: and the file is intact" (raise-err (file-read-text src)) "source")
  (raise-err (directory-create (under dir "sub")))
  (expect-true #"${where}: a directory as the source fails"
               (threw? (file-copy (under dir "sub") (under dir "sub-copy"))))
  (raise-err (file-write-bytes (under dir "all.bin") all-bytes))
  (raise-err (file-copy (under dir "all.bin") (under dir "all-copy.bin")))
  (expect-true #"${where}: bytes that are not text survive a copy"
               (same-bytes? (raise-err (file-read-bytes (under dir "all-copy.bin"))) all-bytes)))

;; The source under another name, which the path's text cannot tell. Opening
;; the target to truncate it used to empty the source, and appending a file to
;; itself grew it until the disk was full. On the disk only: a link is real.
(: (-> string string void))
(defun (check-copy-links where dir)
  (raise-err (directory-create dir))
  (def src (under dir "src.txt"))
  (raise-err (file-write-text src "source"))
  (match (clr-symlink (under dir "to-src.txt") (path-absolute src))
    ((Ok _)
     (raise-err (file-copy src (under dir "to-src.txt") #:mode Truncate))
     (expect #"${where}: Truncate onto a link to the source leaves the source whole"
             (raise-err (file-read-text src))
             "source")
     (expect #"${where}: and replaces the link with the copy"
             (match (file-info (under dir "to-src.txt"))
               ((Some info) (record-ref info link?))
               (None #t))
             #f)
     (expect #"${where}: which holds the source"
             (raise-err (file-read-text (under dir "to-src.txt")))
             "source"))
    ((Err _) unit))
  (match (clr-symlink (under dir "again.txt") (path-absolute src))
    ((Ok _)
     (raise-err (file-copy src (under dir "again.txt") #:mode Append))
     (expect #"${where}: Append onto a link to the source adds the source once, and ends"
             (raise-err (file-read-text src))
             "sourcesource"))
    ((Err _) unit)))

(: (-> string string void))
(defun (check-bytes where dir)
  (raise-err (directory-create dir))
  (def f (under dir "bytes.bin"))
  (raise-err (file-write-bytes f all-bytes))
  (expect-true #"${where}: every byte value round trips"
               (same-bytes? (raise-err (file-read-bytes f)) all-bytes))
  (expect #"${where}: and the size is 256" (described f) "file 256")
  (def three (make-array 3))
  (array-set! three 0 (cast byte 7))
  (array-set! three 1 (cast byte 8))
  (array-set! three 2 (cast byte 9))
  (raise-err (file-append-bytes f three))
  (def back (raise-err (file-read-bytes f)))
  (expect #"${where}: append adds to the end" (array-length back) 259)
  (expect-true #"${where}: in order"
               (and (= (array-ref back 256) (cast byte 7)) (= (array-ref back 258) (cast byte 9))))
  (raise-err (file-write-bytes f three))
  (expect #"${where}: a write replaces" (array-length (raise-err (file-read-bytes f))) 3))

(: (-> string string void))
(defun (check-lines where dir)
  (raise-err (directory-create dir))
  (def f (under dir "lines.txt"))
  (def lines (vec-of (list "one" "" "three")))
  (raise-err (file-write-lines f lines))
  (expect #"${where}: lines round trip" (vec->list (raise-err (file-read-lines f))) (vec->list lines))
  (expect #"${where}: each ends in a newline, the last too"
          (raise-err (file-read-text f))
          "one\n\nthree\n")
  (raise-err (file-write-text f "x\ny"))
  (expect #"${where}: a last line without a newline"
          (vec->list (raise-err (file-read-lines f)))
          (list "x" "y"))
  (raise-err (file-write-text f "x\r\ny\r\n"))
  (expect #"${where}: CRLF ends a line too"
          (vec->list (raise-err (file-read-lines f)))
          (list "x" "y"))
  (raise-err (file-write-text f ""))
  (expect #"${where}: an empty file has no lines" (vec-length (raise-err (file-read-lines f))) 0)
  (raise-err (file-write-lines f (vec-of '())))
  (expect #"${where}: no lines make an empty file" (raise-err (file-read-text f)) ""))

;; ---------------------------------------------------------------------------
;; directory-walk
;; ---------------------------------------------------------------------------

;; A small tree with a `.git` in it, made the same way on the fake and the
;; disk. Five directories: `dir`, `.git`, `a`, `a/m` and `empty`.
(: (-> string void))
(defun (make-tree dir)
  (raise-err (directory-create (path-combine dir ".git")))
  (raise-err (directory-create (path-combine dir "a" "m")))
  (raise-err (directory-create (path-combine dir "empty")))
  (raise-err (file-write-text (path-combine dir ".git" "HEAD") "ref"))
  (raise-err (file-write-text (path-combine dir "a" "m" "k.txt") "k"))
  (raise-err (file-write-text (path-combine dir "a" "z.txt") "z"))
  (raise-err (file-write-text (path-combine dir "b.txt") "b"))
  (raise-err (file-write-text (path-combine dir "c.bjo") "c")))

(: (-> string string void))
(defun (check-walk where dir)
  (make-tree dir)
  ;; "." sorts before "a", so `.git` comes first.
  (expect #"${where}: every file, depth first, each directory in order"
          (->list (directory-walk dir))
          (list-map path
                    (list (path-combine dir ".git" "HEAD")
                          (path-combine dir "a" "m" "k.txt")
                          (path-combine dir "a" "z.txt")
                          (path-combine dir "b.txt")
                          (path-combine dir "c.bjo"))))
  (expect #"${where}: into? leaves a directory out"
          (->list (directory-walk dir #:into? (fun (d) (not (path-has-name? d ".git")))))
          (list-map path
                    (list (path-combine dir "a" "m" "k.txt")
                          (path-combine dir "a" "z.txt")
                          (path-combine dir "b.txt")
                          (path-combine dir "c.bjo"))))
  (expect #"${where}: filter asks what a glob would"
          (->list (filter #(path-has-extension? & "bjo") (directory-walk dir)))
          (list (path (path-combine dir "c.bjo"))))
  (expect #"${where}: an empty directory has no files"
          (list-length (->list (directory-walk (path-combine dir "empty"))))
          0))

;; On the fake, where every listing can be counted.
(: (-> void))
(defun (walk-is-lazy)
  (def fs (fake-fs (list)))
  (with-fake-fs-of fs
    (make-tree "lazy")
    (def listed (make-box 0))
    (with-handler ((fs-list (fun (p)
                              (ignore (box-set! listed (+ (box-ref listed) 1)))
                              ((fake-fs-list fs) p))))
      (def walk (directory-walk "lazy"))
      (expect "making a walk lists nothing" (box-ref listed) 0)
      ;; The first `.txt` is under `a/m`: the root, `.git`, `a` and `a/m` are
      ;; listed on the way, and `empty` is not.
      (expect "a walk stopped early"
              (find #(path-has-extension? & "txt") walk)
              (Some (path (path-combine "lazy" "a" "m" "k.txt"))))
      (expect "lists only what it passed" (box-ref listed) 4)
      (ignore (->list walk))
      (expect "and a whole walk lists every directory once more" (box-ref listed) 9)))
  ;; Nothing is listed until the walk, so a walk made where there is no such
  ;; directory is answered by the handler installed where it is walked.
  (def elsewhere (directory-walk "249_nowhere"))
  (with-fake-fs (("249_nowhere/x.txt" "x"))
    (expect "the handler at the walk answers"
            (->list elsewhere)
            (list (path (path-combine "249_nowhere" "x.txt"))))))

;; On the disk only: a link to a directory is never entered, by a walk or by
;; a delete. Entering one to delete would delete what it points at. Some
;; systems refuse an unprivileged symbolic link; there is nothing to check
;; then.
(: (-> void))
(defun (links-on-the-disk)
  (def dir (in-probe "linked"))
  (def outside (in-probe "outside"))
  (make-tree dir)
  (raise-err (directory-create outside))
  (raise-err (file-write-text (path-combine outside "keep.txt") "keep"))
  (match (clr-dir-symlink (path-combine dir "a" "up") "..")
    ((Ok _)
     (ignore (clr-dir-symlink (path-combine dir "a" "out") (path-combine ".." ".." "outside")))
     (ignore (clr-dir-symlink (in-probe "to-outside") "outside"))
     (expect-true "a link to a directory says so" (link? (path-combine dir "a" "up")))
     (expect "a link back up the tree is not entered" (list-length (->list (directory-walk dir))) 5)
     (raise-err (directory-delete-tree dir))
     (expect-true "a tree with links in it is deleted" (not (directory-exists? dir)))
     (expect-true "and what a link pointed at outside it is not"
                  (file-exists? (path-combine outside "keep.txt")))
     (raise-err (directory-delete-tree (in-probe "to-outside")))
     (expect-true "deleting a link as a tree removes the link"
                  (none? (file-info (in-probe "to-outside"))))
     (expect-true "and nothing it points at" (file-exists? (path-combine outside "keep.txt"))))
    ((Err _) (println "ok: symbolic links are refused here, so not checked"))))

;; ---------------------------------------------------------------------------
;; Errors are results
;; ---------------------------------------------------------------------------

;; The case of the `FsError` an `Err` holds, as a string a check can compare.
(: (-> (Result FsError %a) string))
(defun (failure-kind r)
  (match r
    ((Ok _) "ok")
    ((Err (NotFound _ _)) "not found")
    ((Err (AlreadyExists _ _)) "exists")
    ((Err (PermissionDenied _ _)) "denied")
    ((Err (NotEmpty _ _)) "not empty")
    ((Err (IsDirectory _ _)) "is directory")
    ((Err (NotDirectory _ _)) "not directory")
    ((Err (InvalidPath _ _)) "invalid")
    ((Err (Io _ _)) "io")))

;; What kind of exception an `Err` holds.
(: (-> (Result Exception %a) string))
(defun (exception-kind r)
  (match r
    ((Ok _) "ok")
    ((Err (:is System.IO.FileNotFoundException)) "not found")
    ((Err (:is System.IO.DirectoryNotFoundException)) "no directory")
    ((Err (:is System.IO.IOException)) "io")
    ((Err _) "other")))

;; The path of the error an `Err` holds.
(: (-> (Result FsError %a) string))
(defun (failure-path r)
  (match r
    ((Ok _) "")
    ((Err e) (path->string/lossy (fs-error-path e)))))

(: (-> string string void))
(defun (check-results where dir)
  (raise-err (directory-create dir))
  (def missing (under dir "missing.txt"))
  (expect #"${where}: reading a missing file is an Err"
          (failure-kind (file-read-text missing))
          "not found")
  (expect #"${where}: so are its lines and bytes"
          (str (failure-kind (file-read-lines missing)) ", " (failure-kind (file-read-bytes missing)))
          "not found, not found")
  (expect #"${where}: the error holds the path" (failure-path (file-read-text missing)) missing)
  (expect #"${where}: listing a missing directory is an Err"
          (failure-kind (directory-files (under dir "nowhere")))
          "not found")
  (expect #"${where}: a write returns (Ok unit)" (ok? (file-write-text (under dir "a.txt") "A")) #t)
  (expect #"${where}: deleting a missing file is not an error" (ok? (file-delete missing)) #t)
  (expect #"${where}: deleting a non-empty directory is NotEmpty"
          (failure-kind (directory-delete dir))
          "not empty")
  (expect #"${where}: CreateNew onto a file is AlreadyExists"
          (failure-kind (open-output-file (under dir "a.txt") #:mode CreateNew))
          "exists")
  (expect #"${where}: moving a missing file is NotFound, about the source"
          (str (failure-kind (file-move missing (under dir "b.txt")))
               " " (failure-path (file-move missing (under dir "b.txt"))))
          (str "not found " missing))
  (raise-err (file-write-text (under dir "m.txt") "m"))
  (expect #"${where}: MoveNew onto a file is AlreadyExists, about the target"
          (str (failure-kind (file-move (under dir "m.txt") (under dir "a.txt")))
               " " (failure-path (file-move (under dir "m.txt") (under dir "a.txt"))))
          (str "exists " (under dir "a.txt")))
  (expect #"${where}: reading a directory is IsDirectory"
          (failure-kind (file-read-text dir))
          "is directory")
  (expect #"${where}: raise-err raises the exception with its own type"
          (exception-kind (try (raise-err (file-read-text missing)) #:catch (System.Exception)))
          "not found")
  (expect-true #"${where}: fs-error-message says the kind and the path"
               (match (file-read-text missing)
                 ((Err e)
                  (and (string-starts-with? (fs-error-message e) "not found: ")
                       (some? (string-search (fs-error-message e) "missing.txt"))))
                 ((Ok _) #f)))
  (expect #"${where}: result-and-then reads after a write"
          (result-and-then (fun (_) (file-read-text (under dir "a.txt")))
                           (file-append-text (under dir "a.txt") "B"))
          (Ok "AB"))
  (raise-err (directory-delete-tree dir))
  (expect #"${where}: and the tree is gone" (directory-exists? dir) #f))

;; Once through the ordinary copies of the functions. `main` is a bjoroutine,
;; so what it calls directly runs their suspending copies; `#:sync` keeps this
;; one, and everything it calls, on the ordinary ones.
(: ordinary-copies (-> void) #:sync)
(defun (ordinary-copies)
  (info-on-a-fake)
  (info-on-the-disk)
  (with-fake-fs () (check-moves "fake"))
  (check-moves "disk")
  (with-fake-fs ()
    (check-copies "fake" "copies")
    (check-bytes "fake" "bytes")
    (check-lines "fake" "lines"))
  (check-copies "disk" (in-probe "copies"))
  (check-copy-links "disk" (in-probe "copy-links"))
  (check-bytes "disk" (in-probe "bytes"))
  (check-lines "disk" (in-probe "lines"))
  (with-fake-fs () (check-walk "fake" "walk"))
  (check-walk "disk" (in-probe "walk"))
  (walk-is-lazy)
  (links-on-the-disk)
  (with-fake-fs () (check-results "fake" "results"))
  (check-results "disk" (in-probe "results"))
  (expect "an empty path is an Err, not an exception" (failure-kind (file-read-text "")) "invalid")
  (disk-only-errors (in-probe "errors")))

;; Cases that only the real file system makes.
(: (-> string void))
(defun (disk-only-errors dir)
  (raise-err (directory-create dir))
  (def file (under dir "f.txt"))
  (raise-err (file-write-text file "f"))
  (expect "a path through a file is NotDirectory"
          (failure-kind (file-read-text (under file "x.txt")))
          "not directory")
  (expect "listing a file is NotDirectory" (failure-kind (directory-files file)) "not directory")
  (expect "a missing directory on the way is NotFound"
          (failure-kind (file-read-text (under (under dir "none") "x.txt")))
          "not found")
  (expect "deleting a directory as a file is IsDirectory"
          (failure-kind (file-delete dir))
          "is directory")
  (raise-err (directory-create (under dir "d")))
  (expect "moving a directory onto a directory is AlreadyExists"
          (failure-kind (file-move (under dir "d") dir))
          "exists")
  (expect "moving a file onto a directory is AlreadyExists"
          (failure-kind (file-move file (under dir "d")))
          "exists")
  (raise-err (directory-delete-tree dir)))

(defbjo (main)
  (when (directory-exists? probe)
    (raise-err (directory-delete-tree probe)))
  ;; Off the fiber, since the ordinary copies park the thread they run on. A
  ;; failure comes back as an `Err`, and is raised here.
  (match (sync (blocking (fun () (ordinary-copies))))
    ((Ok _) (ignore 0))
    ((Err e) (raise e)))
  ;; And once through the suspending copies.
  (with-fake-fs ()
    (check-copies "fake, suspending" "copies")
    (check-bytes "fake, suspending" "bytes")
    (check-lines "fake, suspending" "lines"))
  (check-copies "disk, suspending" (in-probe "copies-bjo"))
  (check-copy-links "disk, suspending" (in-probe "copy-links-bjo"))
  (check-bytes "disk, suspending" (in-probe "bytes-bjo"))
  (check-lines "disk, suspending" (in-probe "lines-bjo"))
  (with-fake-fs () (check-results "fake, suspending" "results"))
  (check-results "disk, suspending" (in-probe "results-bjo"))
  (raise-err (directory-delete-tree probe))
  0)
