;; A monadic recursive function over `Result`, which must compile to a loop.
;;
;; This is the load-bearing case for argument binding. `bind`'s continuation is
;; a lambda used once, so it is *substituted* rather than let-bound; the
;; resulting direct application beta-reduces; and the recursive call ends up
;; back in tail position where `LoopLowering` can see it. Let-binding it instead
;; would leave `(k x)` against a variable, beta would never fire, and this would
;; grow the stack one frame per step.
(import (std prelude))

;; Two type arguments, only the last of which the trait abstracts over. `%e` is
;; fixed by the impl and becomes a *class* type parameter; `%a` and `bind`'s own
;; `%b` become method type parameters.
(type
  (: (Result %e %a) (Union
    (Ok %a)
    (Err %e))))

(def/impl (Monad (Result %e %a))
  (defun (pure x) (Ok x))
  (defun (bind m k)
    (match m
      ((Ok v) (k v))
      ((Err e) (Err e)))))

(: step2 (-> int (Result string int)))
(defun (step2 n)
  (if (> n 1000000) (Err "overflow") (Ok n)))

;; The tail call *is* the block's last form. Wrapping it in a `:return` would
;; make it `(pure (sum-to ...))`, which is a different program.
(: walk (-> int int (Result string int)))
(defun (walk n acc)
  (if (< n 0)
      (Err "negative")
      (do (:bind x (step2 n))
          (if (= x 0)
              (pure acc)
              (walk (- x 1) (+ acc 1))))))

(: render (-> (Result string int) string))
(defun (render r)
  (match r
    ((Ok v) (string-append "ok " (int->string v)))
    ((Err e) (string-append "err " e))))

(defun (main)
  (println (render (walk 10 0)))
  (println (render (walk -1 0)))
  (println (render (step2 2000000)))
  ;; Deep enough that a recursion which was not turned into a loop would
  ;; overflow the stack rather than answer.
  (println (render (walk 200000 0)))
  0)
