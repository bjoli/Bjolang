;; std/array.bjo — whole-array operations on numbers.
;;
;; Each operation is one loop in the runtime (`BjoArray.cs`). The loop uses
;; the CPU's vector instructions when the element is a primitive number, so
;; one instruction does 4 doubles or 8 ints with AVX2. Other numbers, such as
;; `BigInteger`, go through an ordinary loop.
;;
;; Every function that needs arithmetic asks for `Num`, whose CLR constraint is
;; `INumber`. That is what the runtime's kernels ask for, so the C# call is
;; legal in a generic function too.
(import (std prelude))

(:doc #:file "array.bjodoc")

(export
  array-sum array-dot array-min array-max
  array-add! array-scale!
  array-count array-index-of
  array-fill!)

(import/extern
  (clr-sum      (: Bjolang.Runtime.BjoArray.Sum          (-> (Array %a) %a)))
  (clr-dot      (: Bjolang.Runtime.BjoArray.Dot          (-> (Array %a) (Array %a) %a)))
  (clr-min      (: Bjolang.Runtime.BjoArray.Min          (-> (Array %a) %a)))
  (clr-max      (: Bjolang.Runtime.BjoArray.Max          (-> (Array %a) %a)))
  (clr-add!     (: Bjolang.Runtime.BjoArray.AddInPlace   (-> (Array %a) (Array %a) void)))
  (clr-scale!   (: Bjolang.Runtime.BjoArray.ScaleInPlace (-> (Array %a) %a void)))
  (clr-count    (: Bjolang.Runtime.BjoArray.Count        (-> (Array %a) %a int)))
  (clr-index-of (: Bjolang.Runtime.BjoArray.IndexOf      (-> (Array %a) %a int)))
  (clr-fill!    (: Bjolang.Runtime.BjoArray.Fill         (-> (Array %a) %a void))))

;; ---------------------------------------------------------------------------
;; Reductions
;; ---------------------------------------------------------------------------

(: (-> (Array %a) %a) (where (Num %a)))
(defun (array-sum a) (clr-sum a))

(: (-> (Array %a) (Array %a) %a) (where (Num %a)))
(defun (array-dot a b) (clr-dot a b))

(: (-> (Array %a) %a) (where (Num %a)))
(defun (array-min a) (clr-min a))

(: (-> (Array %a) %a) (where (Num %a)))
(defun (array-max a) (clr-max a))

;; ---------------------------------------------------------------------------
;; In place
;; ---------------------------------------------------------------------------

(: (-> (Array %a) (Array %a) void) (where (Num %a)))
(defun (array-add! dst src) (clr-add! dst src))

(: (-> (Array %a) %a void) (where (Num %a)))
(defun (array-scale! a k) (clr-scale! a k))

;; Any element type: `Array.Fill` needs no arithmetic.
(: (-> (Array %a) %a void))
(defun (array-fill! a x) (clr-fill! a x))

;; ---------------------------------------------------------------------------
;; Search
;; ---------------------------------------------------------------------------

;; Equality is the number's `==`, as `=` is. `Eq` is not asked for: the kernel
;; cannot call a Bjolang implementation.
(: (-> (Array %a) %a int) (where (Num %a)))
(defun (array-count a x) (clr-count a x))

;; -1 when no element matches, as `mutablevec-index-of` answers.
(: (-> (Array %a) %a int) (where (Num %a)))
(defun (array-index-of a x) (clr-index-of a x))
