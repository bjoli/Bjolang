;; Docs for std/orderedmap.bjo, read through (:doc #:file "orderedmap.bjodoc").
;; The texts are samizdat markup: code in prose is @code{...}.

(:doc #:module
  (summary "Persistent sorted map implemented as a B-tree in key order, with builder and transient.")
  (see OrderedMap orderedmap-empty orderedmap-ref orderedmap-set orderedmap-min orderedmap-range OrderedMapBuilder TransientOrderedMap)
  (example """
    (import (std orderedmap))

    (def m (list->orderedmap (list (Tuple "pear" 3) (Tuple "apple" 1) (Tuple "fig" 2))))
    (orderedmap-ref m "fig")                ; 2
    (->list (orderedmap-keys m))             ; ("apple" "fig" "pear")
    (orderedmap-min m)                      ; (Some (Tuple "apple" 1))
    (orderedmap-successor m "banana")       ; (Some (Tuple "fig" 2))
    (orderedmap-ref (orderedmap-set m "fig" 20) "fig")   ; 20
    (orderedmap-ref m "fig")                ; 2, m is unchanged
    """)
  (reference """
    An @code{(OrderedMap k v)} is an immutable, persistent sorted map.
    Updates return a new map sharing untouched nodes with the original.
    Implemented as a B-tree (@code{OrderedMap.OrderedMap} in the runtime).
    Lookup, insertion, and deletion operations run in O(log n) time.

    @strong{Key ordering.} Constructors (@code{orderedmap-empty},
    @code{seq->orderedmap}, @code{list->orderedmap}, @code{vec->orderedmap},
    @code{map->orderedmap}, @code{orderedmapbuilder-empty},
    @code{transientorderedmap-empty}, and the @code{ordered-mapping} collector)
    require an @code{Ord} instance for key type @code{%k}. Entries are ordered
    according to @code{compare}. Keys considered equal by @code{compare}
    overwrite existing entries. Derived maps retain the source map's ordering
    comparer.

    @strong{Order guarantees.} All traversals, conversions, and callbacks
    visit entries in ascending key order. Provides efficient range and boundary
    operations: @code{orderedmap-min}, @code{orderedmap-max},
    @code{orderedmap-successor}, @code{orderedmap-predecessor}, and range slices
    (@code{orderedmap-range}, @code{orderedmap-from}, @code{orderedmap-until}).
    If key ordering is not required, use @code{Map}, which requires only
    @code{Eq}.

    @strong{Entry representations.} Callbacks for @code{orderedmap-fold},
    @code{orderedmap-filter}, and @code{orderedmap-for-each} receive keys and
    values as separate arguments. Functions returning single entries represent
    them as @code{(Tuple k v)} pairs (e.g. in @code{orderedmap->list},
    @code{orderedmap->seq}, @code{orderedmap-min}, and @code{Iterable} loops).

    @strong{Batch mutations and construction.} An @code{OrderedMapBuilder}
    collects entries, sorts them, and constructs the tree in a single pass. A
    @code{TransientOrderedMap} mutates tree nodes in place and converts to a
    persistent map in O(1) time. Both outperform repeated calls to
    @code{orderedmap-set} for bulk updates.

    @strong{Traits.} Implements @code{Iterable}, @code{Collection},
    @code{Refable}, @code{Settable}, @code{Addable}, @code{Eq},
    @code{Written} and @code{Displayed}. Two maps are @code{=} if they contain identical keys with
    equal values. Calling @code{add} on a map takes a @code{(Tuple k v)} and
    overwrites any existing association for key @code{k}.

    @strong{Patterns.} The prelude's @code{(Has key p)} pattern matches an
    ordered map containing @code{key}, matching pattern @code{p} against its
    value, because the map is @code{Refable}.
    """))

;; ---------------------------------------------------------------------------
;; The types
;; ---------------------------------------------------------------------------

(:doc OrderedMap
  (summary "Persistent map sorted by key.")
  (tparam %k "The key type. Requires an Ord instance.")
  (tparam %v "The value type.")
  (see orderedmap-empty orderedmap-ref orderedmap-set orderedmap-remove OrderedMapBuilder TransientOrderedMap OrderedMapping)
  (example """
    (def m (orderedmap-set (orderedmap-set (orderedmap-empty) 2 "two") 1 "one"))
    (->list (orderedmap-keys m))   ; (1 2)
    (ref m 2)                         ; "two"
    """))

(:doc OrderedMapBuilder
  (summary "Mutable buffer for constructing an ordered map in a single pass.")
  (tparam %k "The key type.")
  (tparam %v "The value type.")
  (see orderedmapbuilder-empty orderedmapbuilder-add! orderedmapbuilder->orderedmap TransientOrderedMap)
  (example """
    (def b (orderedmapbuilder-empty))
    (orderedmapbuilder-add! b "b" 1)
    (orderedmapbuilder-add! b "a" 2)
    (orderedmapbuilder-add! b "b" 3)
    (orderedmapbuilder-length b)          ; 3
    (orderedmapbuilder->orderedmap b)     ; #map((a 2) (b 3))
    """)
  (reference """
    Appends entries to a flat buffer. Calling @code{orderedmapbuilder->orderedmap}
    sorts entries and constructs the B-tree in a single pass. If entries arrive in
    sorted order, sorting is skipped. Duplicate keys retain the last value
    added. Builders do not support lookups or removals; use
    @code{TransientOrderedMap} for mutable map operations. Implements
    @code{Addable!} with a pair.
    """))

(:doc TransientOrderedMap
  (summary "Mutable transient ordered map for batch in-place updates.")
  (tparam %k "The key type.")
  (tparam %v "The value type.")
  (see orderedmap->transientorderedmap transientorderedmap->orderedmap transientorderedmap-set! OrderedMapBuilder)
  (example """
    (def t (orderedmap->transientorderedmap m))
    (transientorderedmap-set! t "c" 3)
    (transientorderedmap-remove! t "a")
    (transientorderedmap->orderedmap t)
    """)
  (reference """
    Provides in-place mutators mirroring persistent @code{orderedmap-}
    functions. Mutates owned tree nodes in place without copying. Calling
    @code{transientorderedmap->orderedmap} yields a persistent map in O(1) time.
    The transient remains usable afterward; subsequent writes perform
    copy-on-write on shared nodes. Implements @code{Addable!} with a pair, and
    @code{Refable}.
    """))

(:doc OrderedMapCursor
  (summary "Cursor for iterating over an ordered map.")
  (tparam %k "The key type of the map.")
  (tparam %v "The value type of the map.")
  (see OrderedMap)
  (reference """
    Used by the @code{Iterable} implementation of @code{OrderedMap} to iterate
    in ascending key order. Immutable cursor value: advancing produces a new
    cursor without mutating the previous one.
    """))

(:doc OrderedMapping
  (summary "Collector for gathering entries into an ordered map via loop.")
  (tparam %k "The key type. Requires an Ord instance.")
  (tparam %v "The value type.")
  (case ordered-mapping "The collector constructor, accepting (Tuple k v) pairs.")
  (see list->orderedmap OrderedMapBuilder)
  (example """
    (loop (:for (k v) pairs)
          (:acc m (ordered-mapping (Tuple k (* v 2)))))
    """)
  (reference """
    Collects entries through an @code{OrderedMapBuilder}. Duplicate keys retain
    the last value collected.
    """))

;; ---------------------------------------------------------------------------
;; Maps
;; ---------------------------------------------------------------------------

(:doc orderedmap-empty
  (summary "Creates an empty ordered map.")
  (returns "An empty map ordered by the key type's Ord instance.")
  (see orderedmap-clear seq->orderedmap list->orderedmap))

(:doc orderedmap-ref
  (summary "Returns the value associated with a key, raising KeyNotFoundException if missing.")
  (arg m "The map.")
  (arg k "The key to look up.")
  (returns "The value associated with k.")
  (raises System.Collections.Generic.KeyNotFoundException "When k is not in the map.")
  (see orderedmap-ref-or orderedmap-try-ref ref))

(:doc orderedmap-ref-or
  (summary "Returns the value for a key, or a default fallback if absent.")
  (arg m "The map.")
  (arg k "The key to look up.")
  (arg default "Fallback value returned if k is absent.")
  (returns "The value associated with k, or default.")
  (see orderedmap-ref orderedmap-try-ref))

(:doc orderedmap-try-ref
  (summary "Returns (Some value) for a key, or None if absent.")
  (arg m "The map.")
  (arg k "The key to look up.")
  (returns "(Some v) if k is present, otherwise None.")
  (see orderedmap-ref orderedmap-ref-or try-ref Has))

(:doc orderedmap-set
  (summary "Returns a new map associating a key with a value.")
  (arg m "The source map (unmodified).")
  (arg k "The key.")
  (arg v "The value.")
  (returns "A new map with k mapped to v.")
  (see orderedmap-set-all orderedmap-remove ref-set))

(:doc orderedmap-set-all
  (summary "Returns a new map with all entries of a sequence added.")
  (arg m "The source map (unmodified).")
  (arg kvs "Sequence of (Tuple key value) pairs. Duplicate keys keep the last value.")
  (returns "A new map containing all pairs.")
  (see orderedmap-set orderedmap-merge transientorderedmap-set-all!)
  (reference """
    Executes through a transient, copying tree nodes once rather than once
    per entry.
    """))

(:doc orderedmap-remove
  (summary "Returns a new map with a key removed.")
  (arg m "The source map (unmodified).")
  (arg k "The key to remove.")
  (returns "A new map without k. If k was absent, returns m directly.")
  (see orderedmap-remove-all orderedmap-filter))

(:doc orderedmap-remove-all
  (summary "Returns a new map with all specified keys removed.")
  (arg m "The source map (unmodified).")
  (arg ks "Sequence of keys to remove.")
  (returns "A new map without those keys.")
  (see orderedmap-remove transientorderedmap-remove-all!)
  (reference """
    Executes through a transient, copying tree nodes once rather than once
    per key.
    """))

(:doc orderedmap-contains?
  (summary "Tests if a key exists in the map.")
  (arg m "The map.")
  (arg k "The key to locate.")
  (returns "#t if k is present, otherwise #f.")
  (see orderedmap-has-key? orderedmap-try-ref))

(:doc orderedmap-has-key?
  (summary "Tests if a key exists in the map.")
  (arg m "The map.")
  (arg key "The key to locate.")
  (returns "#t if key is present, otherwise #f.")
  (see orderedmap-contains?)
  (reference "Alias for @code{orderedmap-contains?}."))

(:doc orderedmap-length
  (summary "Returns the number of entries in the map.")
  (arg m "The map.")
  (returns "The count of key-value pairs.")
  (see orderedmap-empty? length))

(:doc orderedmap-empty?
  (summary "Tests if the map contains no entries.")
  (arg m "The map.")
  (returns "#t if empty, otherwise #f.")
  (see orderedmap-length empty?))

(:doc orderedmap-clear
  (summary "Returns an empty map retaining the key comparer of the source map.")
  (arg m "The map whose order is preserved.")
  (returns "An empty persistent map.")
  (see orderedmap-empty orderedmap-remove-all))

(:doc orderedmap-keys
  (summary "Returns a sequence of all keys in ascending order.")
  (arg m "The map.")
  (returns "A sequence of keys in ascending order.")
  (see orderedmap-values orderedmap->seq))

(:doc orderedmap-values
  (summary "Returns a sequence of all values in ascending key order.")
  (arg m "The map.")
  (returns "A sequence of values ordered by their corresponding keys.")
  (see orderedmap-keys orderedmap->seq))

(:doc orderedmap-merge
  (summary "Merges two maps, with the second map's values winning on collision.")
  (arg m "Base map.")
  (arg other "Map overlaid onto base map.")
  (returns "A new map containing entries from both maps.")
  (see orderedmap-merge-with orderedmap-set-all)
  (reference """
    Entries from @code{other} are inserted into @code{m} using a transient.
    If either map is empty, the other map is returned directly.
    """))

(:doc orderedmap-merge-with
  (summary "Merges two maps using a resolving function for colliding keys.")
  (arg f "Resolution function called as (f key left right), returning resolved value.")
  (arg m "Left map.")
  (arg other "Right map.")
  (returns "A new map containing entries from both maps.")
  (see orderedmap-merge)
  (example """
    (orderedmap-merge-with (fun (k a b) (+ a b))
                           (list->orderedmap (list (Tuple "x" 1) (Tuple "y" 2)))
                           (list->orderedmap (list (Tuple "y" 10))))   ; x 1, y 12
    """)
  (reference "Retains the key ordering of @code{m}."))

;; ---------------------------------------------------------------------------
;; Order
;; ---------------------------------------------------------------------------

(:doc orderedmap-min
  (summary "Returns the entry with the minimum key, or None if empty.")
  (arg m "The map.")
  (returns "(Some (Tuple key value)) for the minimum entry, or None if empty.")
  (see orderedmap-max orderedmap-successor))

(:doc orderedmap-max
  (summary "Returns the entry with the maximum key, or None if empty.")
  (arg m "The map.")
  (returns "(Some (Tuple key value)) for the maximum entry, or None if empty.")
  (see orderedmap-min orderedmap-predecessor))

(:doc orderedmap-successor
  (summary "Returns the entry with the smallest key strictly greater than k, or None.")
  (arg m "The map.")
  (arg k "Search key (need not exist in map).")
  (returns "(Some (Tuple key value)) for the next greater key, or None.")
  (see orderedmap-predecessor orderedmap-from)
  (example """
    (def m (list->orderedmap (list (Tuple 10 "a") (Tuple 20 "b"))))
    (orderedmap-successor m 10)   ; (Some (Tuple 20 "b"))
    (orderedmap-successor m 15)   ; (Some (Tuple 20 "b"))
    (orderedmap-successor m 20)   ; None
    """))

(:doc orderedmap-predecessor
  (summary "Returns the entry with the largest key strictly less than k, or None.")
  (arg m "The map.")
  (arg k "Search key (need not exist in map).")
  (returns "(Some (Tuple key value)) for the next smaller key, or None.")
  (see orderedmap-successor orderedmap-until))

(:doc orderedmap-range
  (summary "Returns a sequence of entries with keys in [lo, hi] in ascending order.")
  (arg m "The map.")
  (arg lo "Lower bound key (inclusive). Need not exist in map.")
  (arg hi "Upper bound key (inclusive). Need not exist in map.")
  (returns "A lazy sequence of (Tuple key value) pairs in ascending key order.")
  (see orderedmap-from orderedmap-until)
  (example """
    (orderedmap-range log start-time end-time)   ; entries in a time window
    """)
  (reference """
    Lazy: descends the B-tree to @code{lo} once and advances sequentially,
    so slicing a subset runs in time proportional to the range slice size.
    """))

(:doc orderedmap-from
  (summary "Returns a sequence of entries with keys >= lo in ascending order.")
  (arg m "The map.")
  (arg lo "Lower bound key (inclusive). Need not exist in map.")
  (returns "A lazy sequence of (Tuple key value) pairs for keys >= lo.")
  (see orderedmap-range orderedmap-until orderedmap-successor)
  (reference "Lazy, matching @code{orderedmap-range}."))

(:doc orderedmap-until
  (summary "Returns a sequence of entries with keys <= hi in ascending order.")
  (arg m "The map.")
  (arg hi "Upper bound key (inclusive). Need not exist in map.")
  (returns "A lazy sequence of (Tuple key value) pairs for keys <= hi.")
  (see orderedmap-range orderedmap-from orderedmap-predecessor)
  (reference "Lazy, matching @code{orderedmap-range}."))

;; ---------------------------------------------------------------------------
;; Traversals and transformations
;; ---------------------------------------------------------------------------

(:doc orderedmap-map
  (summary "Transforms every entry value using a function of key and value.")
  (arg f "Transformation function called as (f key value), returning new value.")
  (arg m "The map.")
  (returns "A new ordered map with identical keys and transformed values.")
  (see orderedmap-map-values orderedmap-filter)
  (reference """
    Keys are preserved in place; f cannot modify key values or relative order.
    """))

(:doc orderedmap-map-values
  (summary "Transforms every entry value using a function of value alone.")
  (arg f "Transformation function called as (f value), returning new value.")
  (arg m "The map.")
  (returns "A new ordered map with identical keys and transformed values.")
  (see orderedmap-map))

(:doc orderedmap-filter
  (summary "Returns a new map containing only entries satisfying a predicate.")
  (arg keep? "Predicate function called as (keep? key value); #t keeps entry.")
  (arg m "The map.")
  (returns "A new map of retained entries in ascending key order.")
  (see orderedmap-remove-all transientorderedmap-filter! orderedmap-find))

(:doc orderedmap-fold
  (summary "Folds over all entries in ascending key order.")
  (arg f "Accumulator function called as (f key value acc), returning next acc.")
  (arg init "Initial accumulator value.")
  (arg m "The map to fold.")
  (returns "The final accumulator value, or init if empty.")
  (see orderedmap-for-each fold)
  (example """
    (orderedmap-fold (fun (k v acc) (+ acc v)) 0 m)   ; sum of all values
    """))

(:doc orderedmap-for-each
  (summary "Applies a function to each entry in ascending key order.")
  (arg f "Callback function called as (f key value).")
  (arg m "The map.")
  (see orderedmap-iter orderedmap-fold))

(:doc orderedmap-iter
  (summary "Iterates over entries in ascending key order until f returns #f.")
  (arg f "Callback function called as (f key value); #f stops iteration.")
  (arg m "The map.")
  (returns "#t if all entries were visited; #f if stopped early by f.")
  (see orderedmap-for-each orderedmap-any? orderedmap-find))

(:doc orderedmap-any?
  (summary "Tests if any entry satisfies a predicate.")
  (arg pred "Predicate function called as (pred key value).")
  (arg m "The map.")
  (returns "#t on the first entry satisfying pred; #f if none match.")
  (see orderedmap-find orderedmap-iter))

(:doc orderedmap-find
  (summary "Returns the first entry satisfying a predicate in ascending key order.")
  (arg pred "Predicate function called as (pred key value).")
  (arg m "The map.")
  (returns "(Some (Tuple key value)) for the first match, or None.")
  (see orderedmap-any? orderedmap-filter))

;; ---------------------------------------------------------------------------
;; Conversions
;; ---------------------------------------------------------------------------

(:doc list->orderedmap
  (summary "Constructs an ordered map from a list of key-value pairs.")
  (arg xs "List of (Tuple key value) pairs. Duplicate keys keep the last value.")
  (returns "A new ordered map sorted by key.")
  (see orderedmap->list vec->orderedmap seq->orderedmap OrderedMapping)
  (reference "Constructed through a builder in a single pass."))

(:doc orderedmap->list
  (summary "Converts map entries to a list of (Tuple key value) pairs in ascending key order.")
  (arg m "The map.")
  (returns "A list of (Tuple key value) pairs in ascending key order.")
  (see list->orderedmap orderedmap->vec orderedmap->seq))

(:doc vec->orderedmap
  (summary "Constructs an ordered map from a vector of key-value pairs.")
  (arg v "Vector of (Tuple key value) pairs. Duplicate keys keep the last value.")
  (returns "A new ordered map sorted by key.")
  (see orderedmap->vec list->orderedmap seq->orderedmap)
  (reference "Constructed through a builder in a single pass."))

(:doc orderedmap->vec
  (summary "Converts map entries to a vector of (Tuple key value) pairs in ascending key order.")
  (arg m "The map.")
  (returns "A vector of (Tuple key value) pairs in ascending key order.")
  (see vec->orderedmap orderedmap->list orderedmap->seq))

(:doc seq->orderedmap
  (summary "Constructs an ordered map from a sequence of key-value pairs.")
  (arg xs "Sequence of (Tuple key value) pairs. Duplicate keys keep the last value.")
  (returns "A new ordered map sorted by key.")
  (see orderedmap->seq list->orderedmap vec->orderedmap)
  (reference "Constructed through a builder in a single pass."))

(:doc orderedmap->seq
  (summary "Views map entries as a sequence in ascending key order.")
  (arg m "The map.")
  (returns "A sequence of (Tuple key value) pairs in ascending key order.")
  (see seq->orderedmap orderedmap-range orderedmap-keys orderedmap-values))

(:doc map->orderedmap
  (summary "Constructs an ordered map from an unordered hash map.")
  (arg m "The source hash map.")
  (returns "A new ordered map with identical entries sorted by key.")
  (see orderedmap->map Map)
  (reference "Constructed through a builder in a single pass."))

(:doc orderedmap->map
  (summary "Converts an ordered map into an unordered persistent hash map.")
  (arg m "The source ordered map.")
  (returns "A new persistent hash map containing all entries.")
  (see map->orderedmap Map)
  (reference "Constructed through a map builder in a single pass."))

(:doc orderedmap->str
  (summary "Deprecated: use @code{displayed}. Formats an ordered map as text in the form #map((k v) ...).")
  (arg m "The map to format.")
  (returns "Formatted string with entries in ascending key order.")
  (see orderedmap->list)
  (example """
    (displayed (list->orderedmap (list (Tuple 2 "b") (Tuple 1 "a"))))   ; #map((1 a) (2 b))
    """)
  (reference """
    The same text as @code{displayed} gives for an ordered map. Formatted identically to
    prelude @code{Map} output. Note that the @code{#map(...)} reader literal
    constructs a hash map rather than an ordered map.
    """))

;; ---------------------------------------------------------------------------
;; Builders
;; ---------------------------------------------------------------------------

(:doc orderedmapbuilder-empty
  (summary "Creates an empty ordered map builder.")
  (returns "A new builder using the key type's Ord instance.")
  (see orderedmap->orderedmapbuilder orderedmapbuilder-add! OrderedMapBuilder))

(:doc orderedmap->orderedmapbuilder
  (summary "Creates an ordered map builder initialized with entries from a map.")
  (arg m "The source map (unmodified).")
  (returns "A new builder containing m's entries.")
  (see orderedmapbuilder-empty orderedmap->transientorderedmap)
  (reference """
    Traverses the map to populate the buffer in O(n) time. To mutate an
    existing map in place, use @code{orderedmap->transientorderedmap} in O(1).
    """))

(:doc orderedmapbuilder-add!
  (summary "Appends an entry to an ordered map builder buffer.")
  (arg b "The builder.")
  (arg k "The key.")
  (arg v "The value. Duplicate keys keep the last value added.")
  (see orderedmapbuilder-add-all! orderedmapbuilder->orderedmap add!))

(:doc orderedmapbuilder-add-all!
  (summary "Appends all entries from a sequence to an ordered map builder buffer.")
  (arg b "The builder.")
  (arg kvs "Sequence of (Tuple key value) pairs.")
  (see orderedmapbuilder-add!))

(:doc orderedmapbuilder-length
  (summary "Returns the number of entries appended to the builder buffer.")
  (arg b "The builder.")
  (returns "The count of entries appended, including duplicates.")
  (see orderedmapbuilder->orderedmap)
  (reference """
    Duplicate keys are resolved when the map is built, so this represents an
    upper bound on final map size.
    """))

(:doc orderedmapbuilder->orderedmap
  (summary "Constructs a persistent ordered map from the builder buffer.")
  (arg b "The builder.")
  (returns "A new persistent ordered map sorted by key.")
  (see orderedmapbuilder-empty OrderedMapBuilder))

;; ---------------------------------------------------------------------------
;; Transients
;; ---------------------------------------------------------------------------

(:doc transientorderedmap-empty
  (summary "Creates an empty transient ordered map.")
  (returns "A new transient ordered map using the key type's Ord instance.")
  (see orderedmap->transientorderedmap TransientOrderedMap))

(:doc orderedmap->transientorderedmap
  (summary "Creates a transient ordered map from an existing persistent map.")
  (arg m "The source map (unmodified).")
  (returns "A mutable transient map that updates in place in O(1) time.")
  (see transientorderedmap->orderedmap transientorderedmap-empty)
  (reference """
    Shares nodes with m without copying. The transient performs copy-on-write
    on individual nodes as they are mutated.
    """))

(:doc transientorderedmap->orderedmap
  (summary "Converts a transient ordered map into a persistent map in O(1) time.")
  (arg t "The transient ordered map (remains usable).")
  (returns "A new immutable persistent ordered map.")
  (see orderedmap->transientorderedmap)
  (reference """
    Relinquishes ownership of current nodes to the persistent map. Subsequent
    writes to t perform copy-on-write without affecting the returned map.
    """))

(:doc transientorderedmap-set!
  (summary "Sets a key to a value in a transient ordered map in place.")
  (arg t "The transient map to modify.")
  (arg k "The key.")
  (arg v "The value, replacing any previous value.")
  (see transientorderedmap-set-all! orderedmap-set add!))

(:doc transientorderedmap-set-all!
  (summary "Sets all entries of a sequence in a transient ordered map in place.")
  (arg t "The transient map to modify.")
  (arg kvs "Sequence of (Tuple key value) pairs. Later pairs overwrite earlier.")
  (see transientorderedmap-set! orderedmap-set-all))

(:doc transientorderedmap-remove!
  (summary "Removes a key from a transient ordered map in place.")
  (arg t "The transient map to modify.")
  (arg k "The key to remove.")
  (see transientorderedmap-remove-all! orderedmap-remove))

(:doc transientorderedmap-remove-all!
  (summary "Removes all specified keys from a transient ordered map in place.")
  (arg t "The transient map to modify.")
  (arg ks "Sequence of keys to remove.")
  (see transientorderedmap-remove! orderedmap-remove-all))

(:doc transientorderedmap-filter!
  (summary "Removes entries rejected by a predicate from a transient ordered map in place.")
  (arg keep? "Predicate function called as (keep? key value); #f removes entry.")
  (arg t "The transient map to modify.")
  (see orderedmap-filter transientorderedmap-remove-all!)
  (reference """
    Identifies all keys to remove before performing deletions, ensuring keep?
    observes the complete transient map state.
    """))

(:doc transientorderedmap-contains?
  (summary "Tests if a key exists in the transient ordered map.")
  (arg t "The transient map.")
  (arg k "The key to locate.")
  (returns "#t if k is present, otherwise #f.")
  (see transientorderedmap-try-ref orderedmap-contains?))

(:doc transientorderedmap-ref
  (summary "Returns the value for a key in a transient ordered map, raising if missing.")
  (arg t "The transient map.")
  (arg k "The key to look up.")
  (returns "The value associated with k.")
  (raises System.Collections.Generic.KeyNotFoundException "When k is not in the transient map.")
  (see transientorderedmap-ref-or transientorderedmap-try-ref orderedmap-ref))

(:doc transientorderedmap-ref-or
  (summary "Returns the value for a key in a transient ordered map, or a default fallback.")
  (arg t "The transient map.")
  (arg k "The key to look up.")
  (arg default "Fallback value returned if k is absent.")
  (returns "The value associated with k, or default.")
  (see transientorderedmap-ref transientorderedmap-try-ref))

(:doc transientorderedmap-try-ref
  (summary "Returns (Some value) for a key in a transient ordered map, or None.")
  (arg t "The transient map.")
  (arg k "The key to look up.")
  (returns "(Some v) if k is present, otherwise None.")
  (see transientorderedmap-ref transientorderedmap-ref-or))

(:doc transientorderedmap-length
  (summary "Returns the number of entries in the transient ordered map.")
  (arg t "The transient map.")
  (returns "Current count of keys.")
  (see transientorderedmap-empty? orderedmap-length))

(:doc transientorderedmap-empty?
  (summary "Tests if the transient ordered map contains no entries.")
  (arg t "The transient map.")
