;; bjo/format.bjo — `bjo fmt`: Bjolang source laid out as bjomode.el lays it
;; out.
;;
;; It re-indents and tidies, keeps every line break the source has but those
;; before a closing bracket, and adds the few that make code read the same
;; everywhere:
;;
;;   - every line is indented as `indent-region` in `bjo-mode` indents it;
;;   - a line of closing brackets goes up to the end of the line before it,
;;     Lisp style, unless that line ends in a comment;
;;   - a `def`'s failure part starts a line, as does each form of a `cond`,
;;     `begin`, `seq` or `try` over several lines, and each binding of a `let`
;;     whose bindings are over several lines (see "Reshaping");
;;   - trailing whitespace goes, as do spaces just inside a bracket; a tab
;;     becomes spaces, or `\t` in a string;
;;   - three or more blank lines in a row become two, and the file ends in one
;;     newline.
;;
;; The indentation follows Emacs's own algorithm rather than an idea of it,
;; because the two have to agree: `calculate-lisp-indent` for the column a
;; line's form lines up under, `lisp-indent-specform` and `lisp-indent-defform`
;; for a form with a body, the rules `bjo-indent-function` adds, and even the
;; column `lisp-indent-region` keeps for the following lines at the same depth.
;; The comments below say which of them each part is.
;;
;; A string's lines are text, not code, and are never touched. What comes out
;; is checked against what went in: the same tokens in the same order, or the
;; file is left alone.

(export format-source format-with wide)

(import (std prelude))

;; ---------------------------------------------------------------------------
;; Tokens

(type (: Tok (Union
              (: TOpen string)
              (: TClose string)
              ;; A symbol, a number, a keyword, a character, or a prefix such
              ;; as ' or #' — anything up to a space, a bracket, a quote or a
              ;; semicolon.
              (: TAtom string)
              ;; A string of any kind, as written, over several lines too.
              (: TStr string)
              (: TComment string)
              (: TSpace string)
              TNewline)))

(: text-between (-> (Vec char) int int string))
(defun (text-between cs from to)
  (def sb (stringbuilder-empty))
  (let go ((i from))
    (when (< i to)
      (stringbuilder-add! sb (vec-ref cs i))
      (go (+ i 1))))
  (stringbuilder->string sb))

(: char-at (-> (Vec char) int char))
(defun (char-at cs i)
  (if (< i (vec-length cs)) (vec-ref cs i) #\nul))

(: opening? (-> char bool))
(defun (opening? c) (or (= c #\() (= c #\[) (= c #\{)))

(: closing? (-> char bool))
(defun (closing? c) (or (= c #\)) (= c #\]) (= c #\})))

(: line-break? (-> (Vec char) int bool))
(defun (line-break? cs i)
  (or (= (char-at cs i) #\newline)
      (and (= (char-at cs i) #\return) (= (char-at cs (+ i 1)) #\newline))))

(: blank-char? (-> (Vec char) int bool))
(defun (blank-char? cs i)
  (and (< i (vec-length cs)) (char-whitespace? (vec-ref cs i)) (not (line-break? cs i))))

;; What the compiler's lexer counts as part of a name: a character literal's
;; name, `#\space`, is a run of them.
(: symbol-char? (-> char bool))
(defun (symbol-char? c)
  (not (or (char-whitespace? c) (opening? c) (closing? c)
           (= c #\,) (= c #\:) (= c #\") (= c #\;) (= c #\'))))

(: atom-end (-> (Vec char) int int))
(defun (atom-end cs i)
  (def c (char-at cs i))
  (if (or (>= i (vec-length cs))
          (char-whitespace? c) (opening? c) (closing? c) (= c #\") (= c #\;))
      i
      (atom-end cs (+ i 1))))

(: blank-end (-> (Vec char) int int))
(defun (blank-end cs i)
  (if (blank-char? cs i) (blank-end cs (+ i 1)) i))

(: line-end (-> (Vec char) int int))
(defun (line-end cs i)
  (if (or (>= i (vec-length cs)) (line-break? cs i)) i (line-end cs (+ i 1))))

(: after-break (-> (Vec char) int int))
(defun (after-break cs i)
  (if (= (char-at cs i) #\return) (+ i 2) (+ i 1)))

(: quotes-at (-> (Vec char) int int))
(defun (quotes-at cs i)
  (let go ((p i))
    (if (= (char-at cs p) #\") (go (+ p 1)) (- p i))))

(: line-of (-> (Vec char) int int))
(defun (line-of cs i)
  (let go ((k 0) (line 1))
    (cond
      ((>= k i) line)
      ((= (vec-ref cs k) #\newline) (go (+ k 1) (+ line 1)))
      (else (go (+ k 1) line)))))

(: unterminated (-> (Vec char) int string (Result string int)))
(defun (unterminated cs i what)
  (Err #"line ${(int->string (line-of cs i))}: ${what} that does not end"))

;; Past the end of the string at `i`, which is one of the three kinds the
;; lexer reads: plain, raw on one line, or raw over several lines, which ends
;; on the first line whose text begins with as many quotes as opened it.
(: string-end (-> (Vec char) int (Result string int)))
(defun (string-end cs i)
  (def n (vec-length cs))
  (def k (quotes-at cs i))
  (def opened (+ i k))
  (def w (blank-end cs opened))
  (cond
    ((and (>= k 3) (>= w n)) (unterminated cs i "a raw string"))
    ((and (>= k 3) (line-break? cs w))
     (let lines ((p (after-break cs w)))
       (def start (blank-end cs p))
       (def e (line-end cs p))
       (cond
         ((>= p n) (unterminated cs i "a raw string"))
         ((= (quotes-at cs start) k) (Ok (+ start k)))
         ((>= e n) (unterminated cs i "a raw string"))
         (else (lines (after-break cs e))))))
    ((>= k 3)
     (let one ((p opened))
       (def run (quotes-at cs p))
       (cond
         ((or (>= p n) (line-break? cs p)) (unterminated cs i "a raw string"))
         ((>= run k) (Ok (+ p k)))
         ((> run 0) (one (+ p run)))
         (else (one (+ p 1))))))
    (else
     (let plain ((p (+ i 1)))
       (cond
         ((>= p n) (unterminated cs i "a string"))
         ((= (vec-ref cs p) #\\) (plain (+ p 2)))
         ((= (vec-ref cs p) #\") (Ok (+ p 1)))
         (else (plain (+ p 1))))))))

;; Past the end of the `#"..."` at `i`. A `${...}` hole is code, delimited by
;; brace depth, with strings and `#\{` inside it skipped whole, as the lexer
;; does.
(: interpolated-end (-> (Vec char) int (Result string int)))
(defun (interpolated-end cs i)
  (def n (vec-length cs))
  (let outside ((p (+ i 2)))
    (cond
      ((>= p n) (unterminated cs i "an interpolated string"))
      ((= (vec-ref cs p) #\") (Ok (+ p 1)))
      ((= (vec-ref cs p) #\\) (outside (+ p 2)))
      ((and (= (vec-ref cs p) #\$) (= (char-at cs (+ p 1)) #\{))
       (let hole ((q (+ p 2)) (depth 1))
         (def c (char-at cs q))
         (cond
           ((>= q n) (unterminated cs i "an interpolated string"))
           ((= c #\")
            (match (string-end cs q)
              ((Ok e) (hole e depth))
              ((Err why) (Err why))))
           ((and (= c #\#) (= (char-at cs (+ q 1)) #\\)) (hole (+ q 3) depth))
           ((= c #\{) (hole (+ q 1) (+ depth 1)))
           ((and (= c #\}) (= depth 1)) (outside (+ q 1)))
           ((= c #\}) (hole (+ q 1) (- depth 1)))
           (else (hole (+ q 1) depth)))))
      (else (outside (+ p 1))))))

;; Past the end of the character literal at `i`: a name, `#\space`, or any one
;; character, `#\(` and `#\;` included.
(: char-literal-end (-> (Vec char) int int))
(defun (char-literal-end cs i)
  (def start (+ i 2))
  (def name-end
    (let go ((p start))
      (if (and (< p (vec-length cs)) (symbol-char? (vec-ref cs p))) (go (+ p 1)) p)))
  (cond
    ((> (- name-end start) 1) name-end)
    ((< start (vec-length cs)) (+ start 1))
    (else start)))

;; The token at `i`, and where the next one starts.
(: token-at (-> (Vec char) int (Result string (Tuple Tok int))))
(defun (token-at cs i)
  (def c (vec-ref cs i))
  (defun (to e) (Tuple (TAtom (text-between cs i e)) e))
  (cond
    ((line-break? cs i) (Ok (Tuple TNewline (after-break cs i))))
    ((blank-char? cs i)
     (def e (blank-end cs i))
     (Ok (Tuple (TSpace (text-between cs i e)) e)))
    ((= c #\;)
     (def e (line-end cs i))
     (Ok (Tuple (TComment (string-trim-right (text-between cs i e))) e)))
    ((opening? c) (Ok (Tuple (TOpen (char->string c)) (+ i 1))))
    ((closing? c) (Ok (Tuple (TClose (char->string c)) (+ i 1))))
    ((= c #\")
     (def (Ok e) (string-end cs i)
       :leave ((Err why) (Err why)))
     (Ok (Tuple (TStr (without-continued-indent (text-between cs i e) (column-at cs i))) e)))
    ((and (= c #\#) (= (char-at cs (+ i 1)) #\"))
     (def (Ok e) (interpolated-end cs i)
       :leave ((Err why) (Err why)))
     (Ok (Tuple (TStr (without-continued-indent (text-between cs i e) (column-at cs i))) e)))
    ((and (= c #\#) (= (char-at cs (+ i 1)) #\\)) (Ok (to (char-literal-end cs i))))
    (else (Ok (to (atom-end cs i))))))

(: tokenize (-> (Vec char) (Result string (List Tok))))
(defun (tokenize cs)
  (let go ((i 0) (out Nil))
    (if (>= i (vec-length cs))
        (Ok (list-reverse out))
        (match (token-at cs i)
          ((Err why) (Err why))
          ((Ok (Tuple tok next)) (go next (Cons tok out)))))))

;; The tokens that make the program: everything but the spacing, and a string
;; with its tabs written `\t`, as the layout writes them. A comment's words are
;; compared, its tabs being spaces once laid out.
(: significant (-> (List Tok) (List string)))
(defun (significant toks)
  (loop (:for t toks)
        (:acc out (listing (match t
                             ((TStr s) (escape-tabs s))
                             ((TComment s) (string-replace (string-replace s "\t" "") " " ""))
                             (_ (tok-text t))))
              #:when (meaningful? t))
    => out))

(: meaningful? (-> Tok bool))
(defun (meaningful? t)
  (match t
    ((TSpace _) #f)
    (TNewline #f)
    (_ #t)))

(: tok-text (-> Tok string))
(defun (tok-text t)
  (match t
    ((TOpen s) s)
    ((TClose s) s)
    ((TAtom s) s)
    ((TStr s) s)
    ((TComment s) s)
    ((TSpace s) s)
    (TNewline "\n")))

;; ---------------------------------------------------------------------------
;; Reshaping: the line breaks the layout adds
;;
;; Each rule says where a line has to break, and what it adds is a line break,
;; so that the tokens are what they were:
;;
;;   - a `def`'s failure part, `:leave`, `:leave-with`, `:default` or
;;     `:propagate`, starts a line of its own, so that the way out stands out;
;;   - in a `cond`, a `begin`, a `seq` or a `try` over several lines, each form
;;     after the head starts a line, but a keyword argument's value, which
;;     stays on the keyword's line: `#:finally (restore)`;
;;   - in a `let`'s bindings over several lines, each binding starts a line.
;;
;; A tab in a string, which is otherwise left as it is, is written `\t`.

;; The line breaks in a token.
(: breaks-in (-> Tok int))
(defun (breaks-in t)
  (match t
    (TNewline 1)
    ((TStr s) (snd (advance s 0)))
    (_ 0)))

;; For each token, the index of the token that closes it if it opens a list,
;; and how many line breaks come before it.
(: closers-and-lines (-> (Vec Tok) (Tuple (Vec int) (Vec int))))
(defun (closers-and-lines v)
  (def n (vec-length v))
  (def closes (vecbuilder-empty))
  (def lines (vecbuilder-empty))
  (let fill ((k 0) (line 0))
    (when (< k n)
      (vecbuilder-add! closes -1)
      (vecbuilder-add! lines line)
      (fill (+ k 1) (+ line (breaks-in (vec-ref v k))))))
  (let go ((k 0) (open Nil))
    (when (< k n)
      (match (vec-ref v k)
        ((TOpen _) (go (+ k 1) (Cons k open)))
        ((TClose _)
         (match open
           ((Cons o outer)
            (vecbuilder-set! closes o k)
            (go (+ k 1) outer))
           (Nil (go (+ k 1) open))))
        (_ (go (+ k 1) open)))))
  (Tuple (vecbuilder->vec closes) (vecbuilder->vec lines)))

;; A list being reshaped: its bracket, its head, what its second form is if it
;; is an atom, its last form so far, how many forms it has so far, whether it
;; spans lines, and whether it is the bindings of a `let`, the forms of which
;; go a line each.
(type (: Shape (Record (: bracket string)
                       (: head string)
                       (: second string)
                       (: last string)
                       (: count int)
                       (: spans bool)
                       (: bindings bool))))

;; Whether a form written `raw` is a keyword argument, `#:catch`, which the
;; form after it belongs with: the two stay on one line.
(: keyword-arg? (-> string bool))
(defun (keyword-arg? raw)
  (and (string-starts-with? raw "#:") (> (string-length raw) 2)))

(: body-only? (-> string bool))
(defun (body-only? head)
  (match head
    ((or "cond" "begin" "seq" "try") #t)
    (_ #f)))

;; Whether `s` is a `def` clause, of a `def`, a `:def` or a `def*`, in which a
;; failure part may be.
(: clause? (-> Shape (Option Shape) bool))
(defun (clause? s outer)
  (or (= (record-ref s head) "def")
      (= (record-ref s head) ":def")
      (and (= (record-ref s bracket) "(")
           (not (= (record-ref s head) "def*"))
           (match outer
             ((Some o) (= (record-ref o head) "def*"))
             (None #f)))))

;; Whether a list opening as the next form of `parent` is that form's bindings.
(: opens-bindings? (-> Shape string bool))
(defun (opens-bindings? parent bracket)
  (def head (record-ref parent head))
  (def named?
    (and (= head "let")
         (match (string->list (record-ref parent second))
           ((Cons c _) (char-alphabetic? c))
           (Nil #f))))
  (and (= bracket "(")
       (binding-form? head)
       (= (record-ref parent count) (if named? 2 1))))

;; `s` with one more form, written `raw`.
(: with-form (-> Shape string Shape))
(defun (with-form s raw)
  (def n (record-ref s count))
  (Shape (bracket (record-ref s bracket))
         (head (if (= n 0) raw (record-ref s head)))
         (second (if (= n 1) raw (record-ref s second)))
         (last raw)
         (count (+ n 1))
         (spans (record-ref s spans))
         (bindings (record-ref s bindings))))

;; Whether the form at position `n` of `s`, written `raw`, has to start a line.
;; One after a keyword argument stays with it.
(: breaks-before? (-> Shape (Option Shape) int string bool))
(defun (breaks-before? s outer n raw)
  (or (and (failure-keyword? raw) (clause? s outer))
      (and (>= n 1)
           (record-ref s spans)
           (or (body-only? (record-ref s head)) (record-ref s bindings))
           (not (keyword-arg? (record-ref s last))))))

;; The tokens with the line breaks the rules ask for, and their strings' tabs
;; written `\t`.
(: reshape (-> (List Tok) (List Tok)))
(defun (reshape toks)
  (def v (list->vec toks))
  (def n (vec-length v))
  (def (Tuple closes lines) (closers-and-lines v))
  (defun (spans? k)
    (def c (vec-ref closes k))
    (and (>= c 0) (> (vec-ref lines c) (vec-ref lines k))))
  ;; `shapes` are the lists open, the innermost first; `fresh?` whether
  ;; nothing but space is on the line yet; `prefixed?` whether a prefix
  ;; began the form this token belongs to.
  (let go ((k 0) (shapes Nil) (fresh? #t) (prefixed? #f) (out Nil))
    (if (>= k n)
        (list-reverse out)
        (let ((t (vec-ref v k)))
          (def rest (if (< (+ k 1) n) (list (vec-ref v (+ k 1))) Nil))
          (def starts? (and (starts-form? t) (not prefixed?)))
          (def raw
            (match t
              ((TStr _) "\"")
              (_ (tok-text t))))
          (def break?
            (and starts?
                 (not fresh?)
                 (match shapes
                   ((Cons s outer)
                    (breaks-before? s (match outer ((Cons o _) (Some o)) (Nil None)) (record-ref s count) raw))
                   (Nil #f))))
          (def counted
            (match shapes
              ((Cons s outer) #:when starts? (Cons (with-form s raw) outer))
              (_ shapes)))
          (def shapes-after
            (match t
              ((TOpen b)
               (Cons (Shape (bracket b) (head "") (second "") (last "") (count 0) (spans (spans? k))
                            (bindings (match shapes
                                        ((Cons s _) (opens-bindings? s b))
                                        (Nil #f))))
                     counted))
              ((TClose _)
               (match counted
                 ((Cons _ outer) outer)
                 (Nil Nil)))
              (_ counted)))
          (def written
            (match t
              ((TStr s) (TStr (escape-tabs s)))
              (_ t)))
          (def out-after (Cons written (if break? (Cons TNewline out) out)))
          (go (+ k 1)
              shapes-after
              (match t
                (TNewline #t)
                ((TSpace _) fresh?)
                (_ #f))
              (prefix-of-next? t rest)
              out-after)))))

;; The tokens reshaped until no rule asks for more. A line break one rule adds
;; can make a list span lines, which another rule asks a line break of: a
;; failure part inside a `begin` on one line. The rules only add line breaks,
;; so this ends.
(: reshaped (-> (List Tok) (List Tok)))
(defun (reshaped toks)
  (def again (reshape toks))
  (if (= (list-length again) (list-length toks)) again (reshaped again)))

;; A string's tabs written `\t`, as its value is unchanged by: outside the
;; holes of an interpolated string, and never in a raw one, which has no
;; escapes. A tab after a backslash is an escape the lexer does not know,
;; which keeps both, so it becomes `\\\t`.
(: escape-tabs (-> string string))
(defun (escape-tabs s)
  (cond
    ((string-starts-with? s "\"\"\"") s)
    ((not (string-contains? s "\t")) s)
    (else
     (def cs (string->vec s))
     (def n (vec-length cs))
     (def sb (stringbuilder-empty))
     (defun (copy from to) (stringbuilder-add-string! sb (text-between cs from to)))
     (let go ((p 0))
       (when (< p n)
         (def c (vec-ref cs p))
         (cond
           ((and (= c #\\) (= (char-at cs (+ p 1)) #\tab))
            (stringbuilder-add-string! sb "\\\\\\t")
            (go (+ p 2)))
           ((= c #\\)
            (copy p (+ p 2))
            (go (+ p 2)))
           ((= c #\tab)
            (stringbuilder-add-string! sb "\\t")
            (go (+ p 1)))
           ((and (= c #\$) (= (char-at cs (+ p 1)) #\{) (string-starts-with? s "#\""))
            (def past (hole-end cs (+ p 2)))
            (copy p past)
            (go past))
           (else
            (stringbuilder-add! sb c)
            (go (+ p 1))))))
     (stringbuilder->string sb))))

;; ---------------------------------------------------------------------------
;; Line continuations
;;
;; A backslash that ends a line in a string stands for nothing, and neither
;; does the next line's indentation up to the column the string's text starts
;; at; indentation beyond that is text. What a continued line says therefore
;; depends on where the string starts, which the layout moves. So a string is
;; read without the indentation a continuation drops, and written with as much
;; as where it is written drops: the text it stands for stays the same.
;;
;; A raw string has no escapes. In the holes of an interpolated string nothing
;; is changed: a string in a hole that continues lines is left as it is.

;; The column of `i` as the compiler's lexer counts it: characters since the
;; line began, a tab one.
(: column-at (-> (Vec char) int int))
(defun (column-at cs i)
  (let go ((k i))
    (if (or (= k 0) (= (vec-ref cs (- k 1)) #\newline)) (- i k) (go (- k 1)))))

;; The column the text of the string `s` written at `col` starts at.
(: text-column (-> string int int))
(defun (text-column s col)
  (if (string-starts-with? s "#\"") (+ col 2) (+ col 1)))

;; Whether the backslash at `p` is a line continuation, and if so where the
;; line break after it starts.
(: continuation-at (-> (Vec char) int (Option int)))
(defun (continuation-at cs p)
  (let go ((k (+ p 1)))
    (cond
      ((line-break? cs k) (Some k))
      ((or (= (char-at cs k) #\space) (= (char-at cs k) #\tab)) (go (+ k 1)))
      (else None))))

;; The string `s`, written with its text from `text-col` on, each continuation
;; as `\` and the line break alone, and from each continued line the
;; indentation it drops: what it stands for wherever it is written. Indentation
;; it keeps is kept.
(: without-continued-indent (-> string int string))
(defun (without-continued-indent s col)
  (def text-col (text-column s col))
  (rewrite-continuations s (fun (sb cs at)
                             (let skip ((j at))
                               (if (and (< (- j at) text-col)
                                        (or (= (char-at cs j) #\space) (= (char-at cs j) #\tab)))
                                   (skip (+ j 1))
                                   j)))))

;; The string `s`, as `without-continued-indent` reads it, written at `col`:
;; each continued line indented to where its text starts.
(: with-continued-indent (-> string int string))
(defun (with-continued-indent s col)
  (def text-col (text-column s col))
  (rewrite-continuations s (fun (sb cs at)
                             (unless (or (>= at (vec-length cs)) (line-break? cs at))
                               (stringbuilder-add-string! sb (spaces text-col)))
                             at)))

;; `s` with each continuation written as `\` and its line break, and after it
;; what `after` writes, given where the continued line starts; it answers where
;; to go on from. A raw string is as it is.
(: rewrite-continuations (-> string (-> StringBuilder (Vec char) int int) string))
(defun (rewrite-continuations s after)
  (cond
    ((string-starts-with? s "\"\"\"") s)
    ((not (string-contains? s "\\")) s)
    (else
     (def cs (string->vec s))
     (def n (vec-length cs))
     (def sb (stringbuilder-empty))
     (def interpolated? (string-starts-with? s "#\""))
     (let go ((p 0))
       (when (< p n)
         (def c (vec-ref cs p))
         (cond
           ((= c #\\)
            (match (continuation-at cs p)
              ((Some k)
               (def past (if (= (char-at cs k) #\return) (+ k 2) (+ k 1)))
               (stringbuilder-add! sb #\\)
               (stringbuilder-add-string! sb (text-between cs k past))
               (go (after sb cs past)))
              (None
               (stringbuilder-add-string! sb (text-between cs p (+ p 2)))
               (go (+ p 2)))))
           ((and interpolated? (= c #\$) (= (char-at cs (+ p 1)) #\{))
            (def past (hole-end cs (+ p 2)))
            (stringbuilder-add-string! sb (text-between cs p past))
            (go past))
           (else
            (stringbuilder-add! sb c)
            (go (+ p 1))))))
     (stringbuilder->string sb))))

;; A token as it is written at `col`: a string with its continued lines
;; indented to where its text then starts.
(: tok-written (-> Tok int string))
(defun (tok-written t col)
  (match t
    ((TStr s) (with-continued-indent s col))
    (_ (tok-text t))))

;; Past the `}` closing the hole whose code starts at `q`, as
;; `interpolated-end` reads one.
(: hole-end (-> (Vec char) int int))
(defun (hole-end cs q)
  (let hole ((q q) (depth 1))
    (def c (char-at cs q))
    (cond
      ((>= q (vec-length cs)) q)
      ((= c #\")
       (match (string-end cs q)
         ((Ok e) (hole e depth))
         ((Err _) (vec-length cs))))
      ((and (= c #\#) (= (char-at cs (+ q 1)) #\\)) (hole (+ q 3) depth))
      ((= c #\{) (hole (+ q 1) (+ depth 1)))
      ((and (= c #\}) (= depth 1)) (+ q 1))
      ((= c #\}) (hole (+ q 1) (- depth 1)))
      (else (hole (+ q 1) depth)))))

;; ---------------------------------------------------------------------------
;; Lines

;; A line's tokens, its own indentation taken off, and that indentation as it
;; was, which a `;;;` comment keeps.
(type (: Line (Record (: toks (List Tok)) (: indent string))))

(: lines-of (-> (List Tok) (List Line)))
(defun (lines-of toks)
  (let go ((toks toks) (here Nil) (out Nil))
    (match toks
      (Nil (list-reverse (Cons (tidy (list-reverse here)) out)))
      ((Cons TNewline rest) (go rest Nil (Cons (tidy (list-reverse here)) out)))
      ((Cons t rest) (go rest (Cons t here) out)))))

(: space? (-> Tok bool))
(defun (space? t)
  (match t
    ((TSpace _) #t)
    (_ #f)))

(: comment? (-> Tok bool))
(defun (comment? t)
  (match t
    ((TComment _) #t)
    (_ #f)))

(: close? (-> Tok bool))
(defun (close? t)
  (match t
    ((TClose _) #t)
    (_ #f)))

;; A line without the spaces at its ends and just inside its brackets.
(: tidy (-> (List Tok) Line))
(defun (tidy toks)
  (def indent
    (match toks
      ((Cons (TSpace s) _) s)
      (_ "")))
  (def trimmed (list-reverse (drop-spaces (list-reverse (drop-spaces toks)))))
  (Line (toks (inside-brackets trimmed)) (indent indent)))

(: drop-spaces (-> (List Tok) (List Tok)))
(defun (drop-spaces toks)
  (match toks
    ((Cons t rest) #:when (space? t) (drop-spaces rest))
    (_ toks)))

(: inside-brackets (-> (List Tok) (List Tok)))
(defun (inside-brackets toks)
  (match toks
    ((Cons (TOpen o) (Cons s rest)) #:when (and (space? s) (not (starts-comment? rest)))
     (inside-brackets (Cons (TOpen o) rest)))
    ((Cons s (Cons (TClose c) rest)) #:when (space? s)
     (inside-brackets (Cons (TClose c) rest)))
    ((Cons t rest) (Cons t (inside-brackets rest)))
    (Nil Nil)))

(: starts-comment? (-> (List Tok) bool))
(defun (starts-comment? toks)
  (match toks
    ((Cons t _) (comment? t))
    (Nil #f)))

(: blank? (-> Line bool))
(defun (blank? l) (empty? (record-ref l toks)))

(: drop-closers (-> (List Tok) (List Tok)))
(defun (drop-closers toks)
  (match toks
    ((Cons t rest) #:when (close? t) (drop-closers rest))
    (_ toks)))

;; Closing brackets alone on a line, perhaps with a comment after them.
(: closers-only? (-> Line bool))
(defun (closers-only? l)
  (def toks (record-ref l toks))
  (and (match toks
         ((Cons t _) (close? t))
         (Nil #f))
       (match (drop-closers toks)
         (Nil #t)
         ((Cons t Nil) (comment? t))
         ((Cons s (Cons t Nil)) (and (space? s) (comment? t)))
         (_ #f))))

(: ends-in-comment? (-> Line bool))
(defun (ends-in-comment? l)
  (match (list-reverse (record-ref l toks))
    ((Cons t _) (comment? t))
    (Nil #f)))

(: drop-blank-lines (-> (List Line) (List Line)))
(defun (drop-blank-lines lines)
  (match lines
    ((Cons l rest) #:when (blank? l) (drop-blank-lines rest))
    (_ lines)))

;; Lines of closing brackets go up to the end of the code before them, the
;; blank lines between going with them, unless that code ends in a comment.
(: join-closers (-> (List Line) (List Line)))
(defun (join-closers lines)
  ;; `done` is the lines so far, the last first.
  (let go ((lines lines) (done Nil))
    (match lines
      (Nil (list-reverse done))
      ((Cons l rest)
       (match (drop-blank-lines done)
         ((Cons before earlier) #:when (and (closers-only? l) (not (ends-in-comment? before)))
          (def joined (list-append (record-ref before toks) (record-ref l toks)))
          (go rest (Cons (record-set before (toks joined)) earlier)))
         (_ (go rest (Cons l done))))))))

;; No blank lines at the ends, and at most two in a row anywhere else.
(: squeeze-blank-lines (-> (List Line) (List Line)))
(defun (squeeze-blank-lines lines)
  (def trimmed (list-reverse (drop-blank-lines (list-reverse (drop-blank-lines lines)))))
  (let go ((lines trimmed) (run 0) (out Nil))
    (match lines
      (Nil (list-reverse out))
      ((Cons l rest) #:when (blank? l)
       (if (>= run 2) (go rest run out) (go rest (+ run 1) (Cons l out))))
      ((Cons l rest) (go rest 0 (Cons l out))))))

;; ---------------------------------------------------------------------------
;; Indentation

;; A form inside a list, as the indentation reads it: where it starts, a prefix
;; such as ' or #' included; the physical line it starts on; the column of the
;; first form that starts on that line; its text if it is an atom, or its
;; opening bracket; and for a list the column of that bracket.
(type (: Elem (Record (: col int)
                      (: line int)
                      (: line-first int)
                      (: raw string)
                      (: is-list bool)
                      (: bracket int))))

;; An open list: its bracket, the bracket's column and line, the forms in it so
;; far, the last first, and the first two of them.
(type (: Frame (Record (: bracket string)
                       (: col int)
                       (: line int)
                       (: elems (List Elem))
                       (: count int)
                       (: first (Option Elem))
                       (: second (Option Elem)))))

;; A column, and whether `lisp-indent-region` keeps it for the following lines
;; at the same depth, which it does for a plain number and not for the
;; (COLUMN START) a rule answers when the next line may differ.
(type (: Indent (Record (: col int) (: keep bool))))

(: indent (-> int bool Indent))
(defun (indent col keep) (Indent (col col) (keep keep)))

(: with-elem (-> Frame Elem Frame))
(defun (with-elem f e)
  (def n (record-ref f count))
  (Frame (bracket (record-ref f bracket))
         (col (record-ref f col))
         (line (record-ref f line))
         (elems (Cons e (record-ref f elems)))
         (count (+ n 1))
         (first (if (= n 0) (Some e) (record-ref f first)))
         (second (if (= n 1) (Some e) (record-ref f second)))))

(: raw-of (-> (Option Elem) string))
(defun (raw-of e)
  (match e
    ((Some x) (record-ref x raw))
    (None "")))

(: last-of (-> Frame Elem Elem))
(defun (last-of f head)
  (match (record-ref f elems)
    ((Cons e _) e)
    (Nil head)))

;; How a form with a body indents, from `bjo-indent-forms` in bjomode.el: how
;; many forms come before the body, or a rule of its own.
(type (: Rule (Union (: Body int) DefForm NamedLet DefStar)))

(: rule-of (-> string (Option Rule)))
(defun (rule-of head)
  (match head
    ((or "seq" "letrec" "export" "re-export" "import" "import/extern" "import/class"
         "type" "type-rec" "bjo" "begin" "spawn" "spawn/daemon" "spawn/detached"
         "with-shield" "cond" "time-it" "try")
     (Some (Body 0)))
    ;; A definition: everything after its head is the body, whatever else is on
    ;; the head's line.
    ((or "defun" "defbjo" "defbjouble" "impl" "impl/extern" ":doc") (Some DefForm))
    ((or "def/mutable" "def/trait" "def/macro" "def/pattern" "type/derive" "when"
         "unless" "match" "case" "with-open" "parameterize" "parameterize*" "fun"
         "let*" "syntax-match" "when-let" "if-let" "with-cancel" "with-deadline"
         "with-response" "with-run" "with-return")
     (Some (Body 1)))
    ("let/mono" (Some (Body 2)))
    ("if" (Some (Body 3)))
    ("def" (Some DefForm))
    ("let" (Some NamedLet))
    ("def*" (Some DefStar))
    (_ None)))

;; The characters Emacs reads as a prefix of the form after them.
(: prefix-char? (-> char bool))
(defun (prefix-char? c)
  (or (= c #\') (= c #\#) (= c #\,) (= c #\@) (= c #\`)))

(: list-drop-while (-> (-> %a bool) (List %a) (List %a)))
(defun (list-drop-while drop? xs)
  (match xs
    ((Cons x rest) #:when (drop? x) (list-drop-while drop? rest))
    (_ xs)))

(: without-prefix (-> string string))
(defun (without-prefix s)
  (list->string (list-drop-while prefix-char? (string->list s))))

(: prefix-length (-> string int))
(defun (prefix-length s)
  (- (string-length s) (string-length (without-prefix s))))

(: prefix-only? (-> string bool))
(defun (prefix-only? s)
  (and (not (string-empty? s)) (string-empty? (without-prefix s))))

;; Whether a form written `raw` begins with a word or a symbol character once
;; its prefix is past: a symbol or a number, not a list, a string or a
;; character literal.
(: symbolic? (-> string bool))
(defun (symbolic? raw)
  (match (string->list (without-prefix raw))
    ((Cons c _) (not (or (opening? c) (= c #\") (= c #\\) (= c #\;))))
    (Nil #f)))

;; `calculate-lisp-indent`'s own column, before any rule: under the first form
;; when it is a list, under the second when the forms so far are all on the
;; first one's line, and otherwise under the first form on the line of the
;; last of them.
(: normal-indent (-> Frame Elem int))
(defun (normal-indent f head)
  (def last (last-of f head))
  (cond
    ((record-ref head is-list) (record-ref head bracket))
    ((= (record-ref last line) (record-ref head line))
     (match (record-ref f second)
       ((Some s) (record-ref s col))
       (None (record-ref head col))))
    (else (record-ref last line-first))))

;; `lisp-indent-specform`: the first two of a form's `n` distinguished forms
;; four in, a third under them, and the body two in.
(: specform (-> int Frame int Indent))
(defun (specform n f normal)
  (def args (- (record-ref f count) 1))
  (def left (- n args))
  (def body (+ (record-ref f col) 2))
  (cond
    ((> left 0) (indent (if (<= args 1) (+ (record-ref f col) 4) normal) #f))
    ((or (and (= n 0) (= args 0)) (and (= left 0) (<= body normal))) (indent body #t))
    (else (indent normal #t))))

;; `lisp-indent-defform`: a body two in, when the form before it is on the
;; line of the bracket.
(: defform (-> Frame Elem (Option Indent)))
(defun (defform f head)
  (if (= (record-ref (last-of f head) line) (record-ref f line))
      (Some (indent (+ (record-ref f col) 2) #t))
      None))

;; Whether a `let` is a named one: a name after `let` on its line.
(: named-let? (-> Frame Elem bool))
(defun (named-let? f head)
  (match (record-ref f second)
    ((Some s) #:when (= (record-ref s line) (record-ref head line))
     (match (string->list (record-ref s raw))
       ((Cons c _) (char-alphabetic? c))
       (Nil #f)))
    (_ #f)))

;; `bjo-indent-function`: what the form's head says, if it says anything.
(: by-head (-> Frame Elem int (Option Indent)))
(defun (by-head f head normal)
  (def raw (record-ref head raw))
  (def name (without-prefix raw))
  (def head-col (+ (record-ref head col) (prefix-length raw)))
  (cond
    ((string-starts-with? raw "#:") (Some (specform 0 f normal)))
    ;; A list or a string as the head: the rest under the form after it on its
    ;; line, or under the head when nothing follows it there. A guard is part
    ;; of the pattern, so after `#:when` and its guard the form is the one
    ;; after those.
    ((not (symbolic? raw))
     (def forms (list-reverse (record-ref f elems)))
     (def after
       (match forms
         ((Cons _ (Cons w (Cons _ (Cons x _)))) #:when (= (record-ref w raw) "#:when") (Some x))
         ((Cons _ (Cons w _)) #:when (= (record-ref w raw) "#:when") None)
         ((Cons _ (Cons x _)) (Some x))
         (_ None)))
     (Some (match after
             ((Some s) #:when (= (record-ref s line) (record-ref head line)) (indent (record-ref s col) #t))
             (_ (indent (record-ref head col) #t)))))
    ((= name ":match") (Some (indent head-col #t)))
    (else
     (match (rule-of name)
       ((Some DefForm) (defform f head))
       ((Some (Body n)) (Some (specform n f normal)))
       ((Some NamedLet) (Some (specform (if (named-let? f head) 2 1) f normal)))
       ((Some DefStar) None)
       ;; A head that begins with `def` defines something and one that begins
       ;; with `with-` runs a body in something; both have a body.
       (None
        (if (and (> (string-length name) 3)
                 (or (string-starts-with? name "def") (string-starts-with? name "with-")))
            (defform f head)
            None))))))

;; A line that starts with a keyword goes under a keyword that starts the line
;; of the form before it, when that is not the list's first form.
(: keyword-aligned (-> Frame Elem int string int))
(defun (keyword-aligned f head normal here)
  (def last (last-of f head))
  (def on-its-line
    (list-filter #(= (record-ref & line) (record-ref last line)) (record-ref f elems)))
  (match (list-reverse on-its-line)
    ((Cons s _) #:when (and (string-starts-with? here ":")
                            (not (and (= (record-ref s col) (record-ref head col))
                                      (= (record-ref s line) (record-ref head line))))
                            (string-starts-with? (record-ref s raw) ":"))
     (record-ref s col))
    (_ normal)))

;; Where `def`'s failure part may be: the forms after a `def`'s head, or all
;; of a parenthesised clause of a `def*`. `None` for any other list.
(: clause-forms (-> Frame (Option Frame) (Option (List Elem))))
(defun (clause-forms f outer)
  (def forms (list-reverse (record-ref f elems)))
  (def head (raw-of (record-ref f first)))
  (def in-def-star?
    (match outer
      ((Some o) (= (raw-of (record-ref o first)) "def*"))
      (None #f)))
  (cond
    ((or (= head "def") (= head ":def"))
     (Some (match forms
             ((Cons _ rest) rest)
             (Nil Nil))))
    ((and in-def-star? (= (record-ref f bracket) "(") (not (= head "def*"))) (Some forms))
    (else None)))

(: failure-keyword? (-> string bool))
(defun (failure-keyword? s)
  (match (without-prefix s)
    ((or ":leave-with" ":leave" ":propagate" ":default") #t)
    (_ #f)))

;; `bjo--failure-indent`: a failure keyword two in from the clause's bracket,
;; and the arms after `:leave` under the first of them.
(: failure-indent (-> Frame (Option Frame) string bool (Option Indent)))
(defun (failure-indent f outer here here-form?)
  (match (clause-forms f outer)
    ((Some forms) #:when (>= (+ (list-length forms) (if here-form? 1 0)) 2)
     (cond
       ((and here-form? (failure-keyword? here)) (Some (indent (+ (record-ref f col) 2) #f)))
       (else
        (match (list-drop-while #(not (= (without-prefix (record-ref & raw)) ":leave")) forms)
          ((Cons _ (Cons arm _)) (Some (indent (record-ref arm col) #f)))
          ((Cons leave Nil) (Some (indent (record-ref leave col) #f)))
          (Nil None)))))
    (_ None)))

;; A form whose result a `=>` introduces, which goes two in, as a body does.
(: loop-form? (-> Frame bool))
(defun (loop-form? f)
  (match (raw-of (record-ref f first))
    ((or "loop" ":loop" "subloop" ":subloop" "seql") #t)
    (_ #f)))

(: binding-form? (-> string bool))
(defun (binding-form? head)
  (match head
    ((or "let" "let*" "letrec" "with-open" "parameterize" "parameterize*") #t)
    (_ #f)))

;; `bjo--binding-list-p`: whether `f` is the bindings of a `let` or a form like
;; it, `outer`: the list after the head, or after the name of a named `let`.
(: binding-list? (-> Frame (Option Frame) bool))
(defun (binding-list? f outer)
  (match outer
    ((Some o)
     (def head (raw-of (record-ref o first)))
     (def named?
       (and (= head "let")
            (match (string->list (raw-of (record-ref o second)))
              ((Cons c _) (char-alphabetic? c))
              (Nil #f))))
     ;; `f` is open inside `o`, so it is the last of `o`'s forms so far.
     (and (= (record-ref f bracket) "(")
          (binding-form? head)
          (= (record-ref o count) (if named? 3 2))))
    (None #f)))

;; Whether `bjo--calculate-indent` stops the column being kept: in a `def`
;; clause and in a `loop` or a `seql`, where the next line may indent
;; differently.
(: no-reuse? (-> Frame (Option Frame) bool))
(defun (no-reuse? f outer)
  (or (loop-form? f)
      (match (clause-forms f outer)
        ((Some forms) (not (empty? forms)))
        (None #f))))

;; The column for a line inside `f`, whose first token is `here` and starts a
;; form if `here-form?`.
(: indent-in (-> Frame (Option Frame) string bool Indent))
(defun (indent-in f outer here here-form?)
  (def calculated
    (match (record-ref f first)
      (None (indent (+ (record-ref f col) 1) #t))
      ;; A vec or an array is data, and a `let`'s bindings are a list of them:
      ;; every element goes under the first, whatever it is. The rules below
      ;; are for code.
      ((Some head) #:when (or (= (record-ref f bracket) "[") (binding-list? f outer))
       (indent (record-ref head col) #t))
      ((Some head)
       (def normal (normal-indent f head))
       (match (by-head f head normal)
         ((Some i) i)
         (None (indent (keyword-aligned f head normal here) #t))))))
  (match (failure-indent f outer here here-form?)
    ((Some i) i)
    (None
     (cond
       ((and (loop-form? f) (= here "=>")) (indent (+ (record-ref f col) 2) #f))
       ((and (record-ref calculated keep) (no-reuse? f outer)) (indent (record-ref calculated col) #f))
       (else calculated)))))

;; ---------------------------------------------------------------------------
;; Writing it out

;; What is known while the lines are written: the lists open, the innermost
;; first; the column kept at each depth, the innermost first, one more than
;; there are lists open, and how many lists were open when they were kept;
;; the physical line being written; and what is to be said about the lines so
;; far, each with its line, the last first.
(type (: State (Record (: frames (List Frame))
                       (: kept (List (Option int)))
                       (: kept-depth int)
                       (: line int)
                       (: notes (List (Tuple int string))))))

;; The width past which a line the layout made wider is pointed out: an
;; indenter only moves text right, and a line it moves too far wants breaking
;; by hand. Racket's style has the same limit.
(: wide int)
(def wide 102)

;; What is to be said about a line whose tokens are `toks` as it is written:
;; that it has a tab in a raw string, which no escape can write. How wide it
;; is is said once it is broken; see `width-notes`.
(: notes-on (-> (List Tok) (List string)))
(defun (notes-on toks)
  (if (any? (fun (t)
              (match t
                ((TStr s) (and (string-starts-with? s "\"\"\"") (string-contains? s "\t")))
                (_ #f)))
            toks)
      (list "a tab in a raw string, which has no escape for it; write the text another way")
      Nil))

;; The lines of `result` wider than `wide`, each with its width as a note, but
;; one that is part of a line of `source` as wide already: a string, a comment
;; or a table nothing here breaks, which a person has to, and has been told of.
(: width-notes (-> string string (List (Tuple int string))))
(defun (width-notes source result)
  (def wide-before
    (loop (:for l (string-split source "\n"))
          (:acc out (listing (string-trim l)) #:when (> (columns l) wide))
      => out))
  (def lines (string-split result "\n"))
  (loop (:for i (range 0 (vec-length lines)))
        (:acc out (listing (Tuple (+ i 1)
                                  #"${(int->string (columns (vec-ref lines i)))} columns, more than ${(int->string wide)}; break the line"))
              #:when (let ((l (vec-ref lines i)))
                       (and (> (columns l) wide)
                            (not (any? #(string-contains? & (string-trim l)) wide-before)))))
    => out))

(: spaces (-> int string))
(defun (spaces n)
  (def sb (stringbuilder-empty))
  (let go ((i 0))
    (when (< i n)
      (stringbuilder-add! sb #\space)
      (go (+ i 1))))
  (stringbuilder->string sb))

;; The column after `s` written at `col`, and how many line breaks it has.
(: advance (-> string int (Tuple int int)))
(defun (advance s col)
  (string-fold (fun (c at)
                 (match at
                   ((Tuple column breaks)
                    (if (= c #\newline) (Tuple 0 (+ breaks 1)) (Tuple (+ column 1) breaks)))))
               (Tuple col 0)
               s))

(: expand-tabs (-> string int string))
(defun (expand-tabs s col)
  (def sb (stringbuilder-empty))
  (ignore
   (string-fold (fun (c at)
                  (cond
                    ((= c #\tab)
                     (def to (* 8 (+ 1 (/ at 8))))
                     (stringbuilder-add-string! sb (spaces (- to at)))
                     to)
                    (else
                     (stringbuilder-add! sb c)
                     (+ at 1))))
                col
                s))
  (stringbuilder->string sb))

;; The kept columns adjusted from `from` lists open to `depth`, as
;; `lisp-indent-calc-next` adjusts its stack: one dropped per list closed
;; since, a fresh one per list opened.
(: kept-at (-> (List (Option int)) int int (List (Option int))))
(defun (kept-at kept from depth)
  (cond
    ((> from depth)
     (kept-at (match kept
                ((Cons _ rest) rest)
                (Nil Nil))
              (- from 1)
              depth))
    ((< from depth) (kept-at (Cons None kept) (+ from 1) depth))
    (else kept)))

;; The text of a line's first token, and whether it starts a form.
(: first-of-line (-> (List Tok) (Tuple string bool)))
(defun (first-of-line toks)
  (match toks
    ((Cons (TAtom s) _) (Tuple s #t))
    ((Cons (TOpen s) _) (Tuple s #t))
    ((Cons (TStr s) _) (Tuple s #t))
    ((Cons (TComment s) _) (Tuple s #f))
    ((Cons (TClose s) _) (Tuple s #f))
    (_ (Tuple "" #f))))

;; One line, indented, and the state after it.
(: write-line (-> StringBuilder State Line State))
(defun (write-line out st l)
  (def toks (record-ref l toks))
  (def frames (record-ref st frames))
  (def depth (list-length frames))
  (def kept (kept-at (record-ref st kept) (record-ref st kept-depth) depth))
  (def (Tuple here here-form?) (first-of-line toks))
  (def (Tuple col keep)
    (match kept
      ((Cons (Some c) _) (Tuple c #f))
      (_
       (match frames
         (Nil (Tuple 0 #t))
         ((Cons f rest)
          (def outer
            (match rest
              ((Cons o _) (Some o))
              (Nil None)))
          (def i (indent-in f outer here here-form?))
          (Tuple (record-ref i col) (record-ref i keep)))))))
  (def kept-now
    (match kept
      ((Cons None rest) #:when keep (Cons (Some col) rest))
      (_ kept)))
  ;; A `;;;` comment stays where it was, as `lisp-indent-line` leaves it.
  (def lead (if (string-starts-with? here ";;;") (record-ref l indent) (spaces col)))
  (def buffer (stringbuilder-empty))
  (unless (empty? toks) (stringbuilder-add-string! buffer lead))
  (def (Tuple frames-after line-after)
    (write-toks buffer toks frames (string-length lead) (record-ref st line)))
  (stringbuilder-add-string! out (stringbuilder->string buffer))
  (stringbuilder-add! out #\newline)
  (State (frames frames-after)
         (kept kept-now)
         (kept-depth depth)
         (line (+ line-after 1))
         (notes (list-foldl (fun (note acc) (Cons (Tuple (record-ref st line) note) acc))
                            (record-ref st notes)
                            (notes-on toks)))))

;; Whether the token is a prefix, ' or #' or #, written right before the form
;; it belongs to.
(: prefix-of-next? (-> Tok (List Tok) bool))
(defun (prefix-of-next? t rest)
  (match t
    ((TAtom s) #:when (prefix-only? s)
     (match rest
       ((Cons (TOpen _) _) #t)
       ((Cons (TStr _) _) #t)
       ((Cons (TAtom _) _) #t)
       (_ #f)))
    (_ #f)))

(: starts-form? (-> Tok bool))
(defun (starts-form? t)
  (match t
    ((TAtom _) #t)
    ((TOpen _) #t)
    ((TStr _) #t)
    (_ #f)))

;; The forms the token adds to the lists open, and the list it opens or closes.
(: after-tok (-> Tok (List Frame) Elem (List Frame)))
(defun (after-tok t frames e)
  (def added
    (match frames
      ((Cons f outer) (if (starts-form? t) (Cons (with-elem f e) outer) frames))
      (Nil Nil)))
  (match t
    ((TOpen s)
     (Cons (Frame (bracket s) (col (record-ref e bracket)) (line (record-ref e line))
                  (elems Nil) (count 0) (first None) (second None))
           added))
    ((TClose _)
     (match frames
       ((Cons _ outer) outer)
       (Nil Nil)))
    (_ added)))

;; The tokens of one line, written from `col` on physical line `line`, and the
;; lists open after them and the physical line they end on.
(: write-toks (-> StringBuilder (List Tok) (List Frame) int int (Tuple (List Frame) int)))
(defun (write-toks out toks frames col line)
  ;; `first` is the column of the first form on the physical line, once there
  ;; is one; `prefix` that of a prefix waiting for the form it belongs to.
  (let go ((toks toks) (frames frames) (col col) (line line) (first None) (prefix None))
    (match toks
      (Nil (Tuple frames line))
      ((Cons t rest)
       (def written
         (match t
           ((TSpace s) (expand-tabs s col))
           ((TComment s) (expand-tabs s col))
           (_ (tok-written t col))))
       (stringbuilder-add-string! out written)
       (def (Tuple next-col breaks) (advance written col))
       (def waits? (prefix-of-next? t rest))
       (def form-col
         (match prefix
           ((Some p) p)
           (None col)))
       (def line-first
         (match first
           ((Some c) c)
           (None form-col)))
       (def e (Elem (col form-col)
                    (line line)
                    (line-first line-first)
                    (raw (match t
                           ((TStr _) "\"")
                           (_ (tok-text t))))
                    (is-list (match t
                               ((TOpen _) #t)
                               (_ #f)))
                    (bracket col)))
       (def frames-after (if waits? frames (after-tok t frames e)))
       (def first-after
         (cond
           ((> breaks 0) None)
           ((and (or waits? (starts-form? t)) (none? first)) (Some form-col))
           (else first)))
       (def prefix-after
         (cond
           (waits? (Some form-col))
           (else None)))
       (go rest frames-after next-col (+ line breaks) first-after prefix-after)))))

;; ---------------------------------------------------------------------------
;; Brackets

(: partner (-> string string))
(defun (partner open)
  (match open
    ("(" ")")
    ("[" "]")
    (_ "}")))

;; Whether every bracket closes the one opened last: indentation means nothing
;; where they do not, and Emacs, asked to indent such a file, never finishes.
(: balanced (-> (List Tok) (Result string Unit)))
(defun (balanced toks)
  ;; `open` holds each bracket still open and its line, the innermost first.
  (let go ((toks toks) (open Nil) (line 1))
    (match toks
      (Nil
       (match open
         (Nil (Ok unit))
         ((Cons (Tuple b at) _)
          (Err #"line ${(int->string at)}: a ${b} that is never closed"))))
      ((Cons t rest)
       (match t
         (TNewline (go rest open (+ line 1)))
         ((TStr s) (go rest open (+ line (snd (advance s 0)))))
         ((TOpen b) (go rest (Cons (Tuple b line) open) line))
         ((TClose c)
          (match open
            (Nil (Err #"line ${(int->string line)}: a ${c} that closes nothing"))
            ((Cons (Tuple b at) outer)
             (if (= (partner b) c)
                 (go rest outer line)
                 (Err #"line ${(int->string line)}: a ${c} where the ${b} of line ${(int->string at)} wants a ${(partner b)}")))))
         (_ (go rest open line)))))))

;; ---------------------------------------------------------------------------
;; Breaking long lines
;;
;; A line wider than `wide` is broken in a list on it that runs past the limit,
;; the outermost that has somewhere to break, by putting its forms on lines of
;; their own the way the indentation then lays them out: a call's arguments
;; after the first under it, a body's forms two in, an `if`'s arms four in, a
;; clause's forms after its pattern. A call whose arguments are all small, and
;; a vec, are filled instead: broken only before the form that runs past the
;; limit. A list runs past the limit when it does with the closing brackets
;; right after it, so a line too wide only for the brackets that end it is
;; broken in its last list. A line that continues a list opened on a line
;; before is filled in that list. What none of that can take, a call's first
;; argument moving down gives a line more, in the call where that moves the
;; most left. Then the text is laid out again and looked at again, until
;; nothing more can be broken.
;;
;; A keyword argument's value stays on the keyword's line, and a clause's
;; `#:when` and guard on the line of its pattern.
;;
;; A macro is left as it is: what its forms are is its own business. Those of
;; the prelude are named here; a head that begins with `with-` is one too. So
;; is everything in an `import/extern` or an `import/class`, which are tables
;; written to be read in columns.

(: macro-head? (-> string bool))
(defun (macro-head? head)
  (or (string-starts-with? head "with-")
      (match head
        ((or "cond" "get" "if-let" "in-scope" "let*" "own-disposable" "parameterize*" "scope-form"
             "set" "some->" "try->" "try-get" "type/derive" "update" "when-let")
         #t)
        (_ #f))))

(: table-head? (-> string bool))
(defun (table-head? head)
  (match head
    ((or "import/extern" "import/class") #t)
    (_ #f)))

;; How the forms of a list may start lines of their own.
(type (: Breaking (Union
                   ;; Each from this position on.
                   (: OneALine int)
                   ;; Only the one that runs past the limit, from this position on.
                   (: Filled int)
                   ;; A call: filled if its arguments are all small, else one a line.
                   (: Call int))))

;; How the forms of a list headed `head`, written `bracket`, may start lines of
;; their own, or `None` for a list to leave as it is.
(: breaking-of (-> string string (Option Breaking)))
(defun (breaking-of bracket head)
  (def name (without-prefix head))
  (cond
    ;; A vec and an export list are data, filled.
    ((= bracket "[") (Some (Filled 1)))
    ((or (= name "export") (= name "re-export")) (Some (Filled 1)))
    ((= bracket "{") None)
    ((or (macro-head? name) (table-head? name)) None)
    ((not (symbolic? head)) (Some (OneALine 1)))
    ((= name "if") (Some (OneALine 2)))
    (else
     (match (rule-of name)
       ((Some (Body n)) (Some (OneALine (+ n 1))))
       ((Some DefStar) (Some (OneALine 1)))
       ((Some _) (Some (OneALine 2)))
       (None
        (if (and (> (string-length name) 3) (string-starts-with? name "def"))
            (Some (OneALine 2))
            (Some (Call 2))))))))

;; A form of a list on the line looked at: its token, its position in the
;; list, the columns it starts and ends at, the closing brackets right after
;; it included; whether it is small: an atom, a string, or a list on one line
;; with no list in it; and whether it is glued to the form before it, which a
;; line break never comes between: the value of a keyword argument, and a
;; clause's `#:when`, which is part of its pattern.
(type (: Form (Record (: tok int) (: at int) (: from int) (: to int) (: small bool) (: glued bool))))

;; What the breaking reads of the laid-out tokens: each list's closing token,
;; each token's line and column, and whether it is inside a table.
(type (: Placed (Record (: toks (Vec Tok))
                        (: closes (Vec int))
                        (: lines (Vec int))
                        (: cols (Vec int))
                        (: tabled (Vec bool)))))

(: placed (-> (List Tok) Placed))
(defun (placed toks)
  (def v (list->vec toks))
  (def (Tuple closes _) (closers-and-lines v))
  (def lines (vecbuilder-empty))
  (def cols (vecbuilder-empty))
  (def tabled (vecbuilder-empty))
  ;; `open` holds for each list open whether it is, or is in, a table.
  (let go ((k 0) (line 0) (col 0) (open Nil))
    (when (< k (vec-length v))
      (def t (vec-ref v k))
      (def inside (match open ((Cons b _) b) (Nil #f)))
      (vecbuilder-add! lines line)
      (vecbuilder-add! cols col)
      (vecbuilder-add! tabled inside)
      (def (Tuple after breaks) (advance (tok-written t col) col))
      (def open-after
        (match t
          ((TOpen _)
           (def head (match (vec-ref v (+ k 1)) ((TAtom s) s) (_ "")))
           (Cons (or inside (table-head? head)) open))
          ((TClose _) (match open ((Cons _ outer) outer) (Nil Nil)))
          (_ open)))
      (go (+ k 1) (+ line breaks) after open-after)))
  (Placed (toks v) (closes closes) (lines (vecbuilder->vec lines))
          (cols (vecbuilder->vec cols)) (tabled (vecbuilder->vec tabled))))

(: tok-at (-> Placed int Tok))
(defun (tok-at p k) (vec-ref (record-ref p toks) k))

(: opens? (-> Tok bool))
(defun (opens? t)
  (match t
    ((TOpen _) #t)
    (_ #f)))

;; The column after the form starting at `j`, and after the closing brackets
;; right after it, which go where it goes.
(: form-end (-> Placed int int))
(defun (form-end p j)
  (closers-end p (if (opens? (tok-at p j)) (vec-ref (record-ref p closes) j) j)))

;; The column after token `k` and the closing brackets right after it.
(: closers-end (-> Placed int int))
(defun (closers-end p k)
  (def n (vec-length (record-ref p toks)))
  (let go ((k k))
    (if (and (< (+ k 1) n) (close? (tok-at p (+ k 1))))
        (go (+ k 1))
        (fst (advance (tok-written (tok-at p k) (vec-ref (record-ref p cols) k)) (vec-ref (record-ref p cols) k))))))

(: small-form? (-> Placed int bool))
(defun (small-form? p j)
  (def close (vec-ref (record-ref p closes) j))
  (cond
    ((not (opens? (tok-at p j))) #t)
    ((not (= (vec-ref (record-ref p lines) close) (vec-ref (record-ref p lines) j))) #f)
    (else (not (any? #(opens? (tok-at p &)) (range (+ j 1) close))))))

;; The forms of the list opening at `k`, each with its position, from the
;; first; those that start on line `ln`, unless `ln` is -1.
(: forms-of (-> Placed int int (List Form)))
(defun (forms-of p k ln)
  (def close (vec-ref (record-ref p closes) k))
  (def n (vec-length (record-ref p toks)))
  (def head-list? (and (< (+ k 1) n) (opens? (tok-at p (+ k 1)))))
  ;; `prev` is the text of the form before, if it is an atom.
  (let go ((j (+ k 1)) (at 0) (prev "") (out Nil))
    (cond
      ((or (< close 0) (>= j close)) (list-reverse out))
      ((not (starts-form? (tok-at p j))) (go (+ j 1) at prev out))
      (else
       ;; A prefix is the start of the form after it.
       (def body (if (and (< (+ j 1) n) (prefix-of-next? (tok-at p j) (list (tok-at p (+ j 1))))) (+ j 1) j))
       (def next (if (opens? (tok-at p body)) (+ (vec-ref (record-ref p closes) body) 1) (+ body 1)))
       (def here? (or (= ln -1) (= (vec-ref (record-ref p lines) j) ln)))
       (def text (if (opens? (tok-at p body)) "" (tok-text (tok-at p j))))
       (def form (Form (tok j) (at at) (from (vec-ref (record-ref p cols) j)) (to (form-end p body))
                       (small (small-form? p body))
                       (glued (or (keyword-arg? prev) (and (= at 1) head-list? (= text "#:when"))))))
       (go next (+ at 1) text (if here? (Cons form out) out))))))

(: head-text (-> Placed (List Form) string))
(defun (head-text p forms)
  (match forms
    ((Cons f _) #:when (= (record-ref f at) 0) (tok-text (tok-at p (record-ref f tok))))
    (_ "")))

;; The first of `forms` that runs past the limit, to break before, or, if it is
;; glued to the one before it, the first of them it is glued to.
(: first-past (-> (List Form) (List int)))
(defun (first-past forms)
  (def v (list->vec forms))
  (def n (vec-length v))
  (defun (past? i) (> (record-ref (vec-ref v i) to) wide))
  (defun (glued? i) (record-ref (vec-ref v i) glued))
  (defun (back i)
    (cond
      ((not (glued? i)) (list (record-ref (vec-ref v i) tok)))
      ((> i 0) (back (- i 1)))
      (else Nil)))
  (let find ((i 0))
    (cond
      ((>= i n) Nil)
      ((past? i) (back i))
      (else (find (+ i 1))))))

(: unglued (-> (List Form) (List int)))
(defun (unglued forms)
  (list-map #(record-ref & tok) (list-filter #(not (record-ref & glued)) forms)))

;; Where to break line `ln` in the list opening at `k` on it.
(: breaks-in-list (-> Placed int int (List int)))
(defun (breaks-in-list p k ln)
  (def all (forms-of p k -1))
  (def here (forms-of p k ln))
  (def bracket (tok-text (tok-at p k)))
  (defun (from-on n)
    (list-filter #(and (>= (record-ref & at) n) (> (record-ref & from) (+ (vec-ref (record-ref p cols) k) 1)))
                 here))
  (match (breaking-of bracket (head-text p all))
    (None Nil)
    ((Some (OneALine n)) (unglued (from-on n)))
    ((Some (Filled n)) (first-past (from-on n)))
    ((Some (Call n))
     (if (all? #(record-ref & small) (list-filter #(>= (record-ref & at) 1) all))
         (first-past (from-on n))
         (unglued (from-on n))))))

;; Whether the list opening at `k` runs past the limit on line `ln`, the
;; closing brackets right after it included: a line too wide only for the
;; brackets that end it is broken in the last list on it.
(: runs-past? (-> Placed int int bool))
(defun (runs-past? p k ln)
  (def c (vec-ref (record-ref p closes) k))
  (or (not (= (vec-ref (record-ref p lines) c) ln))
      (> (closers-end p c) wide)))

;; The list a line starts inside of: the innermost open at its first token.
(: enclosing (-> Placed int (Option int)))
(defun (enclosing p first)
  (let go ((k 0) (open Nil))
    (cond
      ((>= k first)
       (match open
         ((Cons o _) (Some o))
         (Nil None)))
      ((opens? (tok-at p k)) (go (+ k 1) (Cons k open)))
      ((close? (tok-at p k))
       (go (+ k 1)
           (match open
             ((Cons _ outer) outer)
             (Nil Nil))))
      (else (go (+ k 1) open)))))

;; A line that continues a list opened before it is filled in that list.
(: breaks-continuing (-> Placed int int (List int)))
(defun (breaks-continuing p first ln)
  (match (enclosing p first)
    ((Some k) #:when (not (vec-ref (record-ref p tabled) k))
     (match (breaking-of (tok-text (tok-at p k)) (head-text p (forms-of p k -1)))
       (None Nil)
       ((Some _)
        (first-past (list-filter #(> (record-ref & tok) first) (forms-of p k ln))))))
    (_ Nil)))

;; The first argument of a call of `lists` that has it on the line of its head,
;; moved down, when nothing else can be broken: the list the line continues,
;; which moves the whole line left, or one on the line, which moves what runs
;; past the limit left. Either moves it left by as much as the argument is to
;; the right of the call's bracket, so the call where that is the most is
;; taken, the first of those that gain as much.
(: first-argument-down (-> Placed (List int) (List int)))
(defun (first-argument-down p lists)
  (defun (call? k forms)
    (match (breaking-of (tok-text (tok-at p k)) (head-text p forms))
      ((Some (Call _)) #t)
      (_ #f)))
  ;; The argument of the call opening at `k` to move down, and how far left
  ;; that moves what comes after it.
  (defun (candidate k)
    (def forms (forms-of p k (vec-ref (record-ref p lines) k)))
    (match forms
      ((Cons h (Cons arg _)) #:when (and (= (record-ref h at) 0)
                                         (= (record-ref arg at) 1)
                                         (not (vec-ref (record-ref p tabled) k))
                                         (call? k forms))
       (Some (Tuple (record-ref arg tok) (- (record-ref arg from) (+ (vec-ref (record-ref p cols) k) 1)))))
      (_ None)))
  (def best
    (list-foldl (fun (k acc)
                  (match (Tuple (candidate k) acc)
                    ((Tuple (Some (Tuple tok gain)) (Some (Tuple _ most))) #:when (> gain most)
                     (Some (Tuple tok gain)))
                    ((Tuple (Some c) None) (Some c))
                    (_ acc)))
                None
                lists))
  (match best
    ((Some (Tuple tok gain)) #:when (> gain 0) (list tok))
    (_ Nil)))

;; The tokens to put a line break before, to break line `ln`.
(: breaks-for (-> Placed int (List int)))
(defun (breaks-for p ln)
  (def n (vec-length (record-ref p toks)))
  (def on-line
    (loop (:for k (range 0 n))
          (:acc out (listing k) #:when (= (vec-ref (record-ref p lines) k) ln))
      => out))
  (def crossing
    (list-filter #(and (opens? (tok-at p &)) (not (vec-ref (record-ref p tabled) &)) (runs-past? p & ln))
                 on-line))
  (def first (match (list-filter #(starts-form? (tok-at p &)) on-line) ((Cons f _) f) (Nil -1)))
  (def around
    (match (if (< first 0) None (enclosing p first))
      ((Some k) (list k))
      (None Nil)))
  ;; The least column a form on the line can be moved to: in the list the
  ;; line continues, or past where the line starts.
  (def least
    (match around
      ((Cons k _)
       (def a (vec-ref (record-ref p cols) k))
       (def b (vec-ref (record-ref p cols) first))
       (+ (if (< a b) a b) 1))
      (Nil 1)))
  ;; A string or comment too wide to fit even moved there keeps the line wide
  ;; whatever is broken, so the line is left as it is.
  (def hopeless?
    (any? #(and (not (opens? (tok-at p &))) (> (+ least (columns (tok-text (tok-at p &)))) wide))
          on-line))
  (if hopeless?
      Nil
      (match (list-filter #(not (empty? &)) (list-map #(breaks-in-list p & ln) crossing))
        ((Cons found _) found)
        (Nil
         (match (if (< first 0) Nil (breaks-continuing p first ln))
           (Nil (first-argument-down p (list-append around crossing)))
           (found found))))))

;; The laid-out text with its long lines broken, as far as they can be.
(: broken (-> (Tuple string (List (Tuple int string))) (Tuple string (List (Tuple int string)))))
(defun (broken laid)
  (let again ((laid laid) (rounds 0))
    (def (Tuple text _) laid)
    (match (tokenize (string->vec text))
      ((Err _) laid)
      ((Ok toks)
       (def p (placed toks))
       (def widths (vec-map columns (string-split text "\n")))
       (def long
         (loop (:for ln (range 0 (vec-length widths)))
               (:acc out (listing ln) #:when (> (vec-ref widths ln) wide))
           => out))
       (def wanted (list-foldl (fun (ln acc) (list-append acc (breaks-for p ln))) Nil long))
       (if (or (empty? wanted) (>= rounds 40))
           laid
           (again (layout (with-breaks-before toks wanted)) (+ rounds 1)))))))

(: with-breaks-before (-> (List Tok) (List int) (List Tok)))
(defun (with-breaks-before toks at)
  (let go ((toks toks) (k 0) (out Nil))
    (match toks
      (Nil (list-reverse out))
      ((Cons t rest)
       (go rest (+ k 1) (Cons t (if (any? #(= & k) at) (Cons TNewline out) out)))))))

;; How many columns `s` takes, in characters: `string-length` counts the bytes
;; of its UTF-8.
(: columns (-> string int))
(defun (columns s) (fst (advance s 0)))

;; ---------------------------------------------------------------------------
;; The whole of it

;; `source` laid out, with what is to be said about its lines, each with its
;; line number in what is laid out (see `notes-on`); or why it cannot be: it
;; does not read, or, which would be a bug here, laying it out would change
;; its tokens.
(: format-source (-> string (Result string (Tuple string (List (Tuple int string))))))
(defun (format-source source) (format-with source #t))

;; `format-source`, its long lines broken if `break?`.
(: format-with (-> string bool (Result string (Tuple string (List (Tuple int string))))))
(defun (format-with source break?)
  (def cs (string->vec source))
  (def (Ok toks) (tokenize cs)
    :leave ((Err why) (Err why)))
  (def (Ok _) (balanced toks)
    :leave ((Err why) (Err why)))
  (def (Tuple result notes) (if break? (broken (layout toks)) (layout toks)))
  (def (Ok again) (tokenize (string->vec result))
    :leave ((Err why) (Err #"formatting made it unreadable: ${why}")))
  (if (= (significant again) (significant toks))
      (Ok (Tuple result (list-sort (list-append notes (width-notes source result)))))
      (Err "formatting would change its tokens, which is a bug in bjo fmt")))

;; The tokens laid out, and what is to be said about their lines.
(: layout (-> (List Tok) (Tuple string (List (Tuple int string)))))
(defun (layout toks)
  (def lines (squeeze-blank-lines (join-closers (lines-of (reshaped toks)))))
  (def out (stringbuilder-empty))
  (def done
    (list-foldl (fun (l st) (write-line out st l))
                (State (frames Nil) (kept (list None)) (kept-depth 0) (line 1) (notes Nil))
                lines))
  (Tuple (stringbuilder->string out) (list-reverse (record-ref done notes))))
