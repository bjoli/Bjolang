
(import (std prelude))
(import (std simpletest))
;; Entry point — defs and expressions can be interleaved
(defun (main)
  (defun (is-even? n)
      (or (= n 0) (is-odd? (- n 1))))
  (defun (is-odd? n)
    (and (not (= n 0)) (is-even? (- n 1))))

  (expect "mutually recursive descent, 411 rungs" (is-odd? 411) #t)
  (expect "and the other way in" (is-even? 410) #t)
  (expect "zero is even" (is-even? 0) #t)
  (expect "zero is not odd" (is-odd? 0) #f)
  0)
