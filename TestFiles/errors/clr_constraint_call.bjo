;; A generic .NET method called at a type that breaks its constraint is a
;; Bjolang error at the call, not a C# one. GetValues<TEnum> needs
;; TEnum : struct, Enum.
;; EXPECT-ERROR: 'System.Enum.GetValues' needs its type parameter TEnum to be System.Enum, and here TEnum is int.
(import (std prelude))
(import/extern (enum-values (: System.Enum.GetValues (-> (Array %a)))))

(: (-> (Array int)))
(defun (values) (enum-values))

(defun (main) (println (array-length (values))) 0)
