;; binary-trees, in parallel: allocates and walks many perfect binary trees,
;; while one long-lived tree stays in memory.
;; Argument: the maximum depth.
;;
;; The stretch tree and the long-lived tree are made first, as in the
;; single-threaded program. Then the iterations of each depth are cut into one
;; block for each CPU, and every block of every depth starts at once, each in
;; a fiber.

(import "par.bjo")
(type-rec (: Tree (Union Empty (: Node Tree Tree))))

(: (-> int Tree))
(defun (bottom-up depth)
  (if (> depth 0)
      (Node (bottom-up (- depth 1)) (bottom-up (- depth 1)))
      (Node Empty Empty)))

(: (-> Tree int))
(defun (check t)
  (match t
    ((Node l r) (+ 1 (+ (check l) (check r))))
    (Empty 0)))

;; The checks of count trees of the depth, summed.
(: (-> int int int))
(defun (sum-checks depth count)
  (loop (:for i (range 0 count))
        (:acc s (summing (check (bottom-up depth))))
        => s))

(: (-> int int int int))
(defun (iterations min-depth max-depth depth)
  (shift-left 1 (+ (- max-depth depth) min-depth)))

;; One fiber for each block of the iterations of the depth.
(: (-> int int (List (Promise int))))
(defun (start-depth depth iters)
  {listing (bjo (sum-checks depth (- (/ (* (+ w 1) iters) workers) (/ (* w iters) workers))))
           (:for w (range 0 workers))})

(: (-bjo-> (List (Promise int)) int int))
(defbjo (join-sum ps acc)
  (match ps
    (Nil acc)
    ((Cons p rest) (join-sum rest (+ acc (join p))))))

(defbjo (main args)
  (def n (string->int (vec-ref args 0)))
  (def min-depth 4)
  (def max-depth (max (+ min-depth 2) n))
  (def stretch-depth (+ max-depth 1))
  (displayln #"stretch tree of depth ${stretch-depth}\t check: ${(check (bottom-up stretch-depth))}")
  (def long-lived (bottom-up max-depth))
  (def depths
    (let go ((depth max-depth) (acc Nil))
      (if (< depth min-depth) acc (go (- depth 2) (Cons depth acc)))))
  (def started
    (list-map (fun (d) (Tuple d (start-depth d (iterations min-depth max-depth d)))) depths))
  (let report ((ds started))
    (match ds
      (Nil unit)
      ((Cons (Tuple depth ps) rest)
       (displayln #"${(iterations min-depth max-depth depth)}\t trees of depth ${depth}\t check: ${(join-sum ps 0)}")
       (report rest))))
  (displayln #"long lived tree of depth ${max-depth}\t check: ${(check long-lived)}")
  0)
