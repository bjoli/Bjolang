;; Paper program: mean and standard deviation, generic in the unit.

(import (std maths) (std units))

;; summing is Num, so at unit 1 only: a named let sums at any unit.
(: mean (-> (Vec (double %u)) (double %u)))
(defun (mean xs)
  (let go ((i 0) (s 0.0))                  ; 0.0 is a number of every unit
    (if (< i (length xs))
        (go (+ i 1) (+ s (ref xs i)))
        (/ s (cast double (length xs))))))

(: stddev (-> (Vec (double %u)) (double %u)))
(defun (stddev xs)
  (def m (mean xs))
  (let go ((i 0) (ss 0.0))
    (if (< i (length xs))
        (go (+ i 1) (+ ss (sqr (- (ref xs i) m))))   ; sqr: %u to %u^2
        (sqrt (/ ss (cast double (- (length xs) 1)))))))   ; sqrt: %u^2 to %u

(mean [<1.80 m> <1.65 m> <1.72 m>])       ; (double m), 1.7233
(stddev [<180 cm> <165 cm> <172 cm>])     ; (double m), 0.0751
(stddev [1.0 2.0 3.0])                    ; double, 1.0
(stddev [<1 m> <1 ft>])                   ; (double m): both are lengths

;; A function generic over Num does not take a unit:
(: sqr* (-> %a %a) (where (Num %a)))
(defun (sqr* x) (* x x))
(sqr* <3 m>)
;; error: '(double m)' does not satisfy 'Num', needed to call 'sqr*'. A number
;;   with a unit is not a Num: (* x x) on m is m^2, and a function generic
;;   over Num says it is m.

;; Count: 2 annotations, 0 in.
