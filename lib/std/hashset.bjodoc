;; Docs for std/hashset.bjo, read through (:doc #:file "hashset.bjodoc"). The
;; texts are samizdat markup: code in prose is @code{...}.

(:doc #:module
  (summary "Persistent unordered hash set backed by a CHAMP prefix tree, with builder and transient.")
  (see HashSet hashset-empty hashset-add hashset-contains? hashset-union HashSetBuilder TransientHashSet)
  (example """
    (import (std hashset))

    (def s (list->hashset (list 1 2 3)))
    (hashset-contains? s 2)                    ; #t
    (hashset-length (hashset-add s 2))         ; 3, already present
    (hashset-length (hashset-add s 4))         ; 4
    (hashset-length s)                         ; 3, s is unchanged
    (hashset-union s (list->hashset (list 3 4)))   ; #{1 2 3 4}, unordered
    """)
  (reference """
    @code{(HashSet a)} is an immutable, persistent hash set. Updates return a
    new set sharing untouched subtrees with the original. Implemented as a CHAMP
    trie (Compressed Hash-Array Mapped Prefix-tree, runtime class
    @code{Set.Set}), serving as the set counterpart to the prelude's persistent
    @code{Map}.

    @strong{Element equality.} Constructors (@code{hashset-empty},
    @code{seq->hashset}, @code{list->hashset}, @code{vec->hashset},
    @code{hashsetbuilder-empty}, @code{transienthashset-empty}, and the
    @code{hash-setting} collector) require an @code{Eq} instance for the element
    type, using it for equality and hashing. Derived sets retain the key comparer
    of the source set.

    @strong{Unordered.} Hash sets are unordered; iteration order is not
    guaranteed. For sorted set operations, use @code{(std orderedset)}.

    @strong{Batch mutations and construction.} A @code{HashSetBuilder} collects
    elements into a flat buffer and constructs the trie in a single pass. A
    @code{TransientHashSet} modifies trie nodes in place and converts to a
    persistent set in O(1) time. Both outperform repeated calls to
    @code{hashset-add} for bulk updates.

    @strong{Traits.} Implements @code{Iterable}, @code{Collection},
    @code{Refable} (where @code{(ref s x)} tests membership), @code{Addable},
    @code{Eq}, and @code{->str}. Two sets are @code{=} if they contain identical
    elements. Builders and transients implement @code{Addable!}, and transients
    implement @code{Refable}.
    """))

;; ---------------------------------------------------------------------------
;; The types
;; ---------------------------------------------------------------------------

(:doc HashSet
  (summary "Persistent, unordered hash set.")
  (tparam %a "The element type. Requires an Eq instance.")
  (see hashset-empty hashset-add hashset-contains? HashSetBuilder TransientHashSet HashSetting)
  (example """
    (def s (hashset-add (hashset-empty) "a"))
    (hashset-contains? s "a")   ; #t
    (ref s "b")                 ; #f
    """))

(:doc HashSetBuilder
  (summary "Mutable buffer for constructing a persistent hash set in a single pass.")
  (tparam %a "The element type.")
  (see hashsetbuilder-empty hashsetbuilder-add! hashsetbuilder->hashset TransientHashSet)
  (example """
    (def b (hashsetbuilder-empty))
    (hashsetbuilder-add! b 1)
    (hashsetbuilder-add! b 1)
    (hashsetbuilder-length b)     ; 2
    (hashsetbuilder->hashset b)   ; #{1}
    """)
  (reference """
    Appends elements to a flat array buffer. Calling
    @code{hashsetbuilder->hashset} constructs the CHAMP trie in a single pass,
    avoiding intermediate trie allocations. Builders do not support lookups or
    removals; use @code{TransientHashSet} for mutable set operations.
    Implements @code{Addable!}.
    """))

(:doc TransientHashSet
  (summary "Mutable transient hash set for batch in-place updates.")
  (tparam %a "The element type.")
  (see hashset->transienthashset transienthashset->hashset transienthashset-add! HashSetBuilder)
  (example """
    (def t (hashset->transienthashset s))
    (transienthashset-add! t 4)
    (transienthashset-remove! t 1)
    (transienthashset->hashset t)
    """)
  (reference """
    Provides in-place mutators mirroring persistent @code{hashset-} functions.
    Mutates owned trie nodes in place without copying. Calling
    @code{transienthashset->hashset} yields a persistent set in O(1) time. The
    transient remains usable afterward; subsequent writes perform copy-on-write
    on shared nodes. Implements @code{Addable!} and @code{Refable}.
    """))

(:doc HashSetCursor
  (summary "Cursor for iterating over a persistent hash set.")
  (tparam %a "The element type.")
  (see HashSet)
  (reference """
    Used by the @code{Iterable} implementation of @code{HashSet} for @code{loop}
    and @code{for-each} iteration. Immutable cursor value: advancing produces a
    new cursor without mutating the previous one.
    """))

(:doc HashSetting
  (summary "Collector for accumulating elements into a hash set via loop.")
  (tparam %a "The element type. Requires an Eq instance.")
  (case hash-setting "The collector constructor.")
  (see list->hashset HashSetBuilder)
  (example """
    (loop (:for x (range 0 10))
          (:when (= 0 (% x 2)))
          (:acc s (hash-setting x)))   ; #{0 2 4 6 8}, unordered
    """)
  (reference "Collects elements into a @code{HashSetBuilder}."))

;; ---------------------------------------------------------------------------
;; Sets
;; ---------------------------------------------------------------------------

(:doc hashset-empty
  (summary "Creates an empty persistent hash set.")
  (returns "An empty hash set using the element type's Eq instance.")
  (see hashset-clear seq->hashset list->hashset))

(:doc hashset-add
  (summary "Returns a new set with an element added.")
  (arg s "The source set (unmodified).")
  (arg x "The element to add.")
  (returns "A new set containing x. If x is already present, returns an equivalent set.")
  (see hashset-add-all hashset-remove add))

(:doc hashset-add-all
  (summary "Returns a new set with all elements of a sequence added.")
  (arg s "The source set (unmodified).")
  (arg xs "Sequence of elements to add.")
  (returns "A new set containing all elements from s and xs.")
  (see hashset-add hashset-union transienthashset-add-all!)
  (reference """
    Executes through a transient, copying the trie once rather than once per
    element.
    """))

(:doc hashset-remove
  (summary "Returns a new set with an element removed.")
  (arg s "The source set (unmodified).")
  (arg x "The element to remove.")
  (returns "A new set without x. If x was absent, returns s directly.")
  (see hashset-remove-all hashset-filter))

(:doc hashset-remove-all
  (summary "Returns a new set with all elements of a sequence removed.")
  (arg s "The source set (unmodified).")
  (arg xs "Sequence of elements to remove.")
  (returns "A new set excluding elements in xs.")
  (see hashset-remove transienthashset-remove-all!)
  (reference """
    Executes through a transient, copying the trie once rather than once per
    element.
    """))

(:doc hashset-contains?
  (summary "Tests if an element is in the set.")
  (arg s "The set to inspect.")
  (arg x "The element to locate.")
  (returns "#t if x is present, otherwise #f.")
  (see ref hashset-find))

(:doc hashset-length
  (summary "Returns the number of elements in the set.")
  (arg s "The set.")
  (returns "The count of elements.")
  (see hashset-empty? length))

(:doc hashset-empty?
  (summary "Tests if the set contains no elements.")
  (arg s "The set.")
  (returns "#t if empty, otherwise #f.")
  (see hashset-length empty?))

(:doc hashset-clear
  (summary "Returns an empty set retaining the key comparer of the source set.")
  (arg s "The set whose comparer is preserved.")
  (returns "An empty persistent set.")
  (see hashset-empty hashset-remove-all))

(:doc hashset-union
  (summary "Returns the union of two sets.")
  (arg s "The first set.")
  (arg other "The second set.")
  (returns "A new set containing elements from both sets.")
  (see hashset-add-all)
  (reference """
    The resulting set retains the equality comparer of @code{s}. If elements
    are equal, the element from @code{s} is retained. When both sets share
    identical comparers and ancestral subtrees, untouched branches are shared
    directly without per-element traversal.
    """))

(:doc hashset-map
  (summary "Transforms all elements using a function, returning a new set.")
  (arg f "Transformation function applied to each element.")
  (arg s "The source set.")
  (returns "A new set of transformed elements using the result type's Eq instance.")
  (see hashset-filter hashset-fold)
  (reference """
    Duplicate transformed values are consolidated, so the resulting set may
    have fewer elements than @code{s}.
    """))

(:doc hashset-filter
  (summary "Returns a new set containing only elements satisfying a predicate.")
  (arg keep? "Predicate function returning #t to keep an element.")
  (arg s "The source set.")
  (returns "A new set of retained elements, using s's comparer.")
  (see hashset-remove-all hashset-find))

(:doc hashset-fold
  (summary "Folds over the elements of a set.")
  (arg f "Accumulator function called as (f element acc), returning next acc.")
  (arg init "Initial accumulator value.")
  (arg s "The set to fold.")
  (returns "The final accumulator value, or init if empty.")
  (see hashset-for-each fold)
  (example """
    (hashset-fold + 0 (list->hashset (list 1 2 3)))   ; 6
    """)
  (reference "Elements are visited in internal trie order."))

(:doc hashset-for-each
  (summary "Applies a function to each element of a set.")
  (arg f "Callback function invoked with each element.")
  (arg s "The set to iterate over.")
  (see hashset-iter hashset-fold))

(:doc hashset-iter
  (summary "Iterates over elements until a function returns #f.")
  (arg f "Callback function returning #f to stop iteration.")
  (arg s "The set to iterate over.")
  (returns "#t if all elements were visited; #f if stopped early by f.")
  (see hashset-for-each hashset-any? hashset-find))

(:doc hashset-any?
  (summary "Tests if any element satisfies a predicate.")
  (arg pred "Predicate function.")
  (arg s "The set to inspect.")
  (returns "#t on the first element satisfying pred; #f if none match.")
  (see hashset-find hashset-iter))

(:doc hashset-find
  (summary "Returns the first element matching a predicate, or None.")
  (arg pred "Predicate function.")
  (arg s "The set to search.")
  (returns "(Some element) for the first match, or None.")
  (see hashset-any? hashset-filter)
  (reference """
    Finds the first match in internal trie traversal order. Because hash sets
    are unordered, matches are non-deterministic when multiple elements satisfy
    pred.
    """))

;; ---------------------------------------------------------------------------
;; Conversions
;; ---------------------------------------------------------------------------

(:doc list->hashset
  (summary "Constructs a persistent hash set from a list.")
  (arg xs "Source list. Duplicate elements are added once.")
  (returns "A new persistent hash set.")
  (see hashset->list vec->hashset seq->hashset HashSetting))

(:doc hashset->list
  (summary "Converts a set to a list in arbitrary order.")
  (arg s "The source set.")
  (returns "A list of elements in internal trie order.")
  (see list->hashset hashset->vec hashset->seq))

(:doc vec->hashset
  (summary "Constructs a persistent hash set from a vector.")
  (arg v "Source vector. Duplicate elements are added once.")
  (returns "A new persistent hash set.")
  (see hashset->vec list->hashset seq->hashset))

(:doc hashset->vec
  (summary "Converts a set to a vector in arbitrary order.")
  (arg s "The source set.")
  (returns "A vector of elements in internal trie order.")
  (see vec->hashset hashset->list hashset->seq))

(:doc seq->hashset
  (summary "Constructs a persistent hash set from a sequence.")
  (arg xs "Source sequence. Duplicate elements are added once.")
  (returns "A new persistent hash set.")
  (see hashset->seq list->hashset vec->hashset)
  (reference "Constructed through a builder in a single pass."))

(:doc hashset->seq
  (summary "Views the elements of a set as a sequence.")
  (arg s "The source set.")
  (returns "A sequence of elements in internal trie order.")
  (see seq->hashset hashset->list))

(:doc hashset->str
  (summary "Formats a hash set as text in the form #{...}.")
  (arg s "The set to format.")
  (returns "String with elements formatted by ->str inside #{...}, separated by spaces.")
  (see hashset->list)
  (example """
    (hashset->str (list->hashset (list 1)))   ; #{1}
    """)
  (reference """
    Implements @code{->str} for hash sets. Elements appear in internal trie
    order. No reader macro reads this text back into a set.
    """))

;; ---------------------------------------------------------------------------
;; Builders
;; ---------------------------------------------------------------------------

(:doc hashsetbuilder-empty
  (summary "Creates an empty hash set builder.")
  (returns "A new builder using the element type's Eq instance.")
  (see hashset->hashsetbuilder hashsetbuilder-add! HashSetBuilder))

(:doc hashset->hashsetbuilder
  (summary "Creates a hash set builder initialized with elements from a set.")
  (arg s "The source set (unmodified).")
  (returns "A new builder containing s's elements, using s's comparer.")
  (see hashsetbuilder-empty hashset->transienthashset)
  (reference """
    Traverses the set to populate the buffer in O(n) time. To mutate an
    existing set in place, use @code{hashset->transienthashset} in O(1).
    """))

(:doc hashsetbuilder-add!
  (summary "Appends an element to a hash set builder buffer.")
  (arg b "The builder.")
  (arg x "The element to append.")
  (see hashsetbuilder-add-all! hashsetbuilder->hashset add!))

(:doc hashsetbuilder-add-all!
  (summary "Appends all elements of a sequence to a hash set builder buffer.")
  (arg b "The builder.")
  (arg xs "Sequence of elements to append.")
  (see hashsetbuilder-add!))

(:doc hashsetbuilder-length
  (summary "Returns the number of elements appended to the builder buffer.")
  (arg b "The builder.")
  (returns "The count of elements appended, including duplicates.")
  (see hashsetbuilder->hashset)
  (reference """
    Duplicate entries are deduplicated when the set is constructed, so this
    value represents an upper bound on final set size.
    """))

(:doc hashsetbuilder->hashset
  (summary "Constructs a persistent hash set from the builder buffer.")
  (arg b "The builder.")
  (returns "A new persistent hash set containing the appended elements.")
  (see hashsetbuilder-empty HashSetBuilder))

;; ---------------------------------------------------------------------------
;; Transients
;; ---------------------------------------------------------------------------

(:doc transienthashset-empty
  (summary "Creates an empty transient hash set.")
  (returns "A new transient hash set using the element type's Eq instance.")
  (see hashset->transienthashset TransientHashSet))

(:doc hashset->transienthashset
  (summary "Creates a transient hash set from an existing persistent set.")
  (arg s "The source set (unmodified).")
  (returns "A mutable transient set that updates in place in O(1) time.")
  (see transienthashset->hashset transienthashset-empty)
  (reference """
    Shares nodes with s without copying. The transient performs copy-on-write
    on individual nodes as they are mutated.
    """))

(:doc transienthashset->hashset
  (summary "Converts a transient hash set into a persistent set in O(1) time.")
  (arg t "The transient hash set (remains usable).")
  (returns "A new immutable persistent hash set.")
  (see hashset->transienthashset)
  (reference """
    Relinquishes ownership of current nodes to the persistent set. Subsequent
    writes to t perform copy-on-write without affecting the returned set.
    """))

(:doc transienthashset-add!
  (summary "Adds an element to a transient hash set in place.")
  (arg t "The transient set to modify.")
  (arg x "The element to add.")
  (see transienthashset-add-all! hashset-add add!))

(:doc transienthashset-add-all!
  (summary "Adds all elements of a sequence to a transient hash set in place.")
  (arg t "The transient set to modify.")
  (arg xs "Sequence of elements to add.")
  (see transienthashset-add! hashset-add-all))

(:doc transienthashset-remove!
  (summary "Removes an element from a transient hash set in place.")
  (arg t "The transient set to modify.")
  (arg x "The element to remove.")
  (see transienthashset-remove-all! hashset-remove))

(:doc transienthashset-remove-all!
  (summary "Removes all elements of a sequence from a transient hash set in place.")
  (arg t "The transient set to modify.")
  (arg xs "Sequence of elements to remove.")
  (see transienthashset-remove! hashset-remove-all))

(:doc transienthashset-contains?
  (summary "Tests if an element is in the transient hash set.")
  (arg t "The transient set.")
  (arg x "The element to locate.")
  (returns "#t if present, otherwise #f.")
  (see hashset-contains? ref))

(:doc transienthashset-length
  (summary "Returns the number of elements in the transient hash set.")
  (arg t "The transient set.")
  (returns "Current count of elements.")
  (see transienthashset-empty? hashset-length))

(:doc transienthashset-empty?
  (summary "Tests if the transient hash set contains no elements.")
  (arg t "The transient set.")
  (returns "#t if empty, otherwise #f.")
  (see transienthashset-length hashset-empty?))
