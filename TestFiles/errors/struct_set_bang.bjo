;; There is no `struct-set!`.
;;
;; The pure forms come in pairs — `record-ref`/`struct-ref`,
;; `record-set`/`struct-set` — so the missing fourth is a spelling someone will
;; reach for. A Struct cannot have a mutable field, so there is nothing for it
;; to write, and it is caught here with the reason rather than left to fail as
;; an unbound name.

;; EXPECT-ERROR: Invalid struct-set!
;; EXPECT-ERROR: a Struct may not have a mutable field
;; EXPECT-ERROR: struct-set for a copy

(import (std prelude))

(type
  (: Point (Struct (: x int) (: y int))))

(defun (main args)
  (def p (Point (x 1) (y 2)))
  (struct-set! p (x 10))
  0)
