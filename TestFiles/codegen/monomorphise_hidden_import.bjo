;; A published body that names a binding this module did not import under that
;; name. `seq->hashset` calls `hashsetbuilder-empty`, and `(only ...)` leaves
;; the latter out. The copy of `seq->hashset` is still checked here, against
;; the binding kept under its qualified reference, and its call to
;; `hashsetbuilder-empty` is copied in turn: no dictionary parameter is left
;; in the generated code.
;;
;; EXPECT-CS: seqsubgthashset__at_string
;; EXPECT-CS: hashsetbuildersubempty__at_string
;; EXPECT-NO-CS: _dict_

(import (only (std hashset) seq->hashset hashset-contains?))

(export has-a?)

(: (-> (Seq string) bool))
(defun (has-a? xs) (hashset-contains? (seq->hashset xs) "a"))
