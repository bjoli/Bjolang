;; The arms are checked against the scrutinee's type *minus the clause pattern*,
;; so an arm matching what the clause already matches can never run.

;; EXPECT-ERROR: this arm can never run

(import (std prelude))

(: f (-> (Result string int) string))
(defun (f r)
  (def (Ok n) r :fail (((Ok m) "the clause already took this") ((Err e) e)))
  (int->string n))
