;; EXPECT-ERROR: does not satisfy 'Integral'
;;
;; The bitwise operators are `IBinaryInteger`, which a `double` is not. C# would
;; have said so too; saying it here names the Bjolang type and the Bjolang
;; operator.
(import (std prelude))

(defun (main)
  (displayln (double->string (bitwise-and 3.5 1.5)))
  0)
