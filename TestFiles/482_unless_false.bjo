;; `(unless #f body)` runs its body.

(import (std prelude))
(import (std simpletest))

(defun (main)
  (def/mutable ran #f)
  (unless #f (set! ran #t))
  (expect "unless #f runs" ran #t)
  (def/mutable skipped #t)
  (unless #t (set! skipped #f))
  (expect "unless #t does not" skipped #t)
  (def/mutable also #t)
  (when #f (set! also #f))
  (expect "when #f does not" also #t)
  (println "done"))
