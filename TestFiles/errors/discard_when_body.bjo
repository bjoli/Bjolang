;; A `when` body whose value goes nowhere.
;;
;; Statement position without anything having been sequenced: a one-armed
;; conditional has no branch to return to, so its body's value is dropped by
;; construction. That makes it the shape most likely to hide a forgotten
;; `else` — the value looks like it is going somewhere.

;; EXPECT-ERROR: has type string and is discarded
;; EXPECT-ERROR: has no branch to return to

(import (std prelude))

(defun (main args)
  (when #t
    (string-append "a" "b"))
  0)
