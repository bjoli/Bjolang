;; The same name bound twice in one `let`.
;;
;; Meaningful under `let*`, where the second binding shadows the first for the
;; rest of the group. Meaningless here: a `let` binds simultaneously, so neither
;; binding is in scope for the other's value and there is nothing for the second
;; to shadow. Two bindings of one name in one scope is then just a question with
;; no answer, and picking a winner would be inventing one.

;; EXPECT-ERROR: is bound twice in the same let
;; EXPECT-ERROR: Write (let* ...)

(import (std prelude))

(defun (main args)
  (let ((x 1) (x 2))
    (println (int->string x)))
  0)
