(import (std prelude))
(import (std simpletest))
(defun (main args)
  ;; Casts
  (def byte-val (cast byte 255))
  (def double-val (cast double 3))
  (def long-val (cast long -100))

  ;; Conversions -> string
  (expect "byte->string at the top of the range" (byte->string byte-val) "255")
  (expect "double->string of a whole number" (double->string double-val) "3")
  (expect "long->string of a negative" (long->string long-val) "-100")

  ;; Conversions string -> 
  (def parsed-int (string->int "42"))
  (def parsed-double (string->double "3.14159"))

  (expect "string->int" parsed-int 42)
  (expect "string->double round-trips" (double->string parsed-double) "3.14159")

  0)
