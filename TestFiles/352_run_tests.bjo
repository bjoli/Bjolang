;; `(run-tests)` as a file's `main`: every test passes, so the run prints
;; nothing but its last line and exits 0.

(import (std prelude))
(import (std test))

(deftest "addition" (check (= (+ 1 2) 3)))
(deftest "a list" (check (= (list-length (list 1 2)) 2)))
(deftest "a match" (check-match (Some 1) (Some _)))

(run-tests)
