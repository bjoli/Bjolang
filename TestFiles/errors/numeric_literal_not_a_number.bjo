;; EXPECT-ERROR: these types do not match
;; EXPECT-ERROR: '5' is a number
;; EXPECT-ERROR: string
;;
;; A bare literal is an open type, so nothing in unification refuses it a
;; `string` — the metavariable simply binds. The refusal has to be its own
;; check, or the mismatch would surface as C# that will not compile, which is
;; the one thing numeric literal polymorphism must not have cost.
(import (std prelude))

(: greeting string)
(def greeting 5)

(defun (main)
  (displayln greeting)
  0)
