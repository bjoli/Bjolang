;; A loop's collector is not built once its steps are inlined, and a `folding`
;; seed is read straight off the constructor.
;;
;; EXPECT-NO-CS: loopcol__
;; EXPECT-NO-CS: prelude__folding\(
;; EXPECT-NO-CS: prelude__summing\(

(import (std prelude))

(export total last)

(: total (-> (List int) int))
(defun (total xs)
  (loop (:for x xs) (:acc s (summing x))))

(: last (-> int (List int) int))
(defun (last seed xs)
  (loop (:for x xs) (:acc l (folding seed x))))
