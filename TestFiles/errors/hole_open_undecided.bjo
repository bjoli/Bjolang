;; EXPECT-ERROR: '_' stands for a value of type ?a, where (Monad ?a) has to hold.
;; EXPECT-NO-ERROR: cannot determine which 'Monad' instance
;;
;; The hole is what would say which monad this is. That nothing else does is
;; the hole's doing, so only the hole is reported.

(import (std prelude) (std monad))

(defun (main)
  (println (bind _ (fun (x) (pure (+ x 1)))))
  0)
