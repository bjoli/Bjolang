;; A quoted literal given to a generic parameter.
;;
;; The element type of `list-length` is a variable. Thus no grammar is
;; expected here, and no grammar reads the literal. The literal also has no
;; type by itself: a symbol and a list are two types. The error says that the
;; expected type is missing. It does not say that `Symbol` does not unify
;; with `(List Symbol)`.
;;
;; The fix is an annotation: (def (: procs (List ProcList)) (list '(pipe (ls)))).
;; Another argument of the same call that gives the type also works:
;; `(list-map run/lines (list '(pipe (ls))))` compiles.

;; EXPECT-ERROR: nothing here says what this list literal holds
;; EXPECT-ERROR: A literal with a nested list among its elements is read by a grammar

(import (std prelude))

(def/grammar ProcList
  (ProcList (: items ProcItem ...))
  (ProcItem (:or (: ProcSym symbol)
                 (: ProcStr string)
                 (: ProcSub (ProcItem ...)))))

(: (-> ProcList string))
(defun (run/lines items) "ran")

(defun (main args)
  (println (int->string (list-length (list '(pipe (ls))))))
  0)
