;; The paper programs of Docs/units-examples, against (std units).
(import (std prelude))
(import (std maths))
(import (std units))
(import (std simpletest))

(: near? (-> double double bool))
(defun (near? a b) (< (abs (- a b)) (* 1e-6 (abs b))))

;; Umits' README: drag on a car.
(: drag (-> (double kg/m^3) (double m/s) double (double m^2) (double N)))
(defun (drag rho v cd area) (* 0.5 rho v v cd area))

;; Statistics at any unit.
(: mean (-> (Vec (double %u)) (double %u)))
(defun (mean xs)
  (let go ((i 0) (s 0.0))
    (if (< i (length xs))
        (go (+ i 1) (+ s (ref xs i)))
        (/ s (cast double (length xs))))))

(: stddev (-> (Vec (double %u)) (double %u)))
(defun (stddev xs)
  (def m (mean xs))
  (let go ((i 0) (ss 0.0))
    (if (< i (length xs))
        (go (+ i 1) (+ ss (sqr (- (ref xs i) m))))
        (sqrt (/ ss (cast double (- (length xs) 1)))))))

;; Weather readings: thresholds in the units they are thought of in.
(type (: Reading (Record (: wind (double m/s)) (: pressure (double Pa)))))

(: windy? (-> Reading bool))
(defun (windy? r) (> (.wind r) <50 km/h>))

(: low-pressure? (-> Reading bool))
(defun (low-pressure? r) (< (.pressure r) <1 atm>))

;; Kepler: T = 2 pi sqrt(a^3 / GM).
(def gm-sun <1.32712440018e20 m^3/s^2>)

(: period (-> (double m) (double s)))
(defun (period a) (* 2 pi (sqrt (/ (* a a a) gm-sun))))

(defun (main)
  (expect "6000 m + 50 ft in mi" (near? (in (+ <6000 m> <50 ft>) mi) 3.737697) #t)
  (expect "65 mi in 12 mi/h" (near? (in (/ <65 mi> <12 mi/h>) s) 19500.0) #t)
  (expect "9 ly per yr in c" (near? (in (/ <9 ly> <1 yr>) c) 9.0) #t)
  (expect "drag" (near? (in (drag <1.225 kg/m^3> <120 km/h> 0.28 <2.2 m^2>) N) 419.2222) #t)
  (expect "dilution" (near? (in (/ <2 kg/yr> <3 m^3/s>) ng/l) 21.12539) #t)
  (expect "cobalt-60"
          (near? (in (/ (* <5 Sv> <4 m> <4 m>) (* <0.351 mSv m^2/(GBq h)> <41.9 PBq>)) s) 19.58264)
          #t)
  (expect "mean of heights" (near? (in (mean [<1.80 m> <1.65 m> <1.72 m>]) m) 1.723333) #t)
  (expect "stddev of heights" (near? (in (stddev [<180 cm> <165 cm> <172 cm>]) cm) 7.505553) #t)
  (expect "stddev, plain" (stddev [1.0 2.0 3.0]) 1.0)
  (expect "windy" (windy? (Reading (wind <61.5 km/h>) (pressure <1009.8 hPa>))) #t)
  (expect "not windy" (windy? (Reading (wind <12 km/h>) (pressure <1013.2 hPa>))) #f)
  (expect "low pressure" (low-pressure? (Reading (wind <12 km/h>) (pressure <1009.8 hPa>))) #t)
  (expect "the period of Mars, roughly" (< (abs (- (in (period <1.523679 au>) yr) 1.8808)) 0.0005) #t)
  (expect "a byte is long bits" (written <1 KiB>) "8192L")
  (expect "min over lengths" (in (min <3 m> <1 ft>) ft) 1.0)
  (expect "abs" (in (abs <-3 km>) km) 3.0)
  (expect "sqr of a length" (in (sqr <3 km>) km^2) 9.0)
  (expect "positive?" (positive? <2 m>) #t)
  0)
