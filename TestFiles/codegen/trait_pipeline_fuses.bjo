;; An Iterable pipeline built from imported defaults is one loop: no iterator
;; per stage, and no cursor over one.
;;
;; EXPECT-NO-CS: IEnumerable
;; EXPECT-NO-CS: SeqCursor

(import (std prelude))

(export total)

(: total (-> (Vec int) int))
(defun (total v)
  (fold (fun (x acc) (+ acc x)) 0
        (map (fun (x) (* x 2)) (filter (fun (x) (even? x)) v))))
