;; NQUEENS -- Compute number of solutions to 8-queens problem.
;; Arguments: count n expected

(import "common.bjo")

(: iota1 (-> int (List int)))
(defun (iota1 n)
  (let loop ((i n) (l Nil))
    (if (= i 0) l (loop (- i 1) (Cons i l)))))

(: ok? (-> int int (List int) bool))
(defun (ok? row dist placed)
  (if (list-empty? placed)
      #t
      (and (not (= (list-head placed) (+ row dist)))
           (not (= (list-head placed) (- row dist)))
           (ok? row (+ dist 1) (list-tail placed)))))

(: my-try (-> (List int) (List int) (List int) int))
(defun (my-try x y z)
  (if (list-empty? x)
      (if (list-empty? y) 1 0)
      (+ (if (ok? (list-head x) 1 z)
             (my-try (list-append (list-tail x) y) Nil (Cons (list-head x) z))
             0)
         (my-try (list-tail x) (Cons (list-head x) y) z))))

(: nqueens (-> int int))
(defun (nqueens n)
  (my-try (iota1 n) Nil Nil))

(defun (main args)
  (def n (arg-int args 1))
  (def expected (arg-int args 2))
  (run-benchmark "nqueens" (arg-int args 0) (fun () (nqueens n)) #(= & expected)))
