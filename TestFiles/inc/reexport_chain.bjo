;; A facade in front of a facade. It re-exports what it never declared and
;; never imported directly, which is the case worth having: the declaration it
;; passes on is the one it read out of `reexport_facade`'s metadata, still
;; carrying `reexport_origin`'s key.
(export chain-line)

(import (std prelude))
(import "reexport_facade.bjo")

(: chain-line (-> %a (Shape %a)))
(defun (chain-line x) (Line x x))

(re-export Shape shape-size)
