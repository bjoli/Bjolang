;; A trait that *is* a .NET interface.
;;
;; `(#:clr-constraint (System.Numerics.INumber %a))` says that `Num` is not a
;; trait with implementations but a name for a constraint the runtime already
;; enforces. A `(where (Num %a))` becomes a C# `where` clause, so the arithmetic
;; primitives — which are emitted as C# operators and would otherwise not
;; compile at a type variable — are licensed there.
;;
;; Nothing is passed at runtime: there is no dictionary, and .NET specializes
;; the method per instantiation. See `Docs/Numerics.org`.
(import (std prelude))
(import (std simpletest))
(import "138_lib.bjo")

;; Declared here as well as in the library, under a different name, because the
;; two are separate registrations: this one is local, `Numeric` arrives as
;; metadata.
;;
;; The name is not `Num`: `std/maths` declares one and the prelude re-exports
;; it, and a trait registry is keyed by name. A local trait of the same name
;; would be reached through the imported one's implementations.
(def/trait (Arith %a)
  (#:clr-constraint (System.Numerics.INumber %a))
  ;; Static members, called on the implementor *type*: `int.Abs(x)` concretely
  ;; and `T_a.Abs(x)` under the constraint, which is one emission rule.
  (: bare  (-> %a %a)        #:clr-member Abs)
  (: which (-> %a int)       #:clr-member Sign)
  (: pin   (-> %a %a %a %a)  #:clr-member Clamp)
  (: even  (-> %a bool)      #:clr-member IsEvenInteger)
  ;; `IsZero` is an *explicit* interface implementation on the primitives, so
  ;; `int.IsZero(x)` does not compile. Every member goes through the trait's
  ;; generated helper for exactly this reason — reached through a constrained
  ;; type parameter, an explicit implementation is no different from any other.
  (: zeroish (-> %a bool)    #:clr-member IsZero))

;; An instance member. `IComparable` has no operators, so this is what lets a
;; generic function order values — including `string`, which is in no
;; `System.Numerics` interface at all and could not be ordered before.
;;
;; Not called `Order`: the library below exports one, and a trait registry is
;; keyed by name, so two of a name silently become one.
(def/trait (Cmp %a)
  (#:clr-constraint (System.IComparable %a))
  (: rel (-> %a %a int) #:clr-member CompareTo))

(: larger (-> %a %a %a) (where (Cmp %a)))
(defun (larger a b) (if (> (rel a b) 0) a b))

(: size-of (-> %a %a) (where (Arith %a)))
(defun (size-of x) (bare x))

;; `Num` beside `Arith`, and it has to be written: the operators ask for
;; `System.Numerics.INumber` and `Arith` is a trait of this file's own, so one
;; does not imply the other. A CLR constraint is never inferred.
(: twice (-> %a %a) (where (Arith %a) (Num %a)))
(defun (twice x) (+ x x))

(: cube (-> %a %a) (where (Arith %a) (Num %a)))
(defun (cube x) (* x (* x x)))

(: diff (-> %a %a %a) (where (Arith %a) (Num %a)))
(defun (diff a b) (- a b))

;; A constraint acquired by *calling* something that has one is declared too.
;; Nothing is passed at runtime either way, but the scheme still has to carry it
;; or the emitted C# would use `+` at an unconstrained type parameter.
(: quadruple (-> %a %a) (where (Arith %a) (Num %a)))
(defun (quadruple x) (twice (twice x)))

;; Two constrained variables, to pin that one clause is emitted per variable
;; rather than one per function. `%b` is constrained and unused, which is
;; allowed: a signature may promise more than its body needs.
(: combine (-> %a %b %a) (where (Arith %a) (Arith %b) (Num %a)))
(defun (combine a b) (twice a))

;; A non-generic caller: the constraint is discharged here, at `int`, and must
;; leave no argument behind.
(: concrete (-> int))
(defun (concrete) (cube 3))

(defun (main)
  ;; The same function body, at three different .NET numeric types.
  (expect "twice at int" (twice 21) 42)
  (expect "twice at long" (long->string (twice 21L)) "42")
  (expect "twice at double" (double->string (twice 1.25)) "2.5")

  (expect "cube at int" (cube 3) 27)
  (expect "cube at double" (double->string (cube 2.0)) "8")

  ;; Subtraction, which `INumber` licenses and an unsigned type would not.
  (expect "diff at int" (diff 10 4) 6)
  (expect "diff at long" (long->string (diff 10L 4L)) "6")

  ;; `byte` is an `INumber` too and would go through the same generic, but a
  ;; `21uy` literal reaches C# spelled the way Bjolang writes it and does not
  ;; compile. That is the numeric-literal problem in the Readme, not this one:
  ;; `(byte->string 21uy)` fails on its own, with no constraint anywhere.

  ;; The constraint travelled up to a function that never wrote it.
  (expect "propagated constraint" (quadruple 5) 20)
  (expect "propagated at double" (double->string (quadruple 0.5)) "2")

  (expect "two constrained variables" (combine 3 1.5) 6)

  (expect "discharged at a concrete type" (concrete) 27)

  ;; Static members, at a concrete type and under a constraint.
  (expect "static member at int" (bare -5) 5)
  (expect "static member at double" (double->string (bare -2.5)) "2.5")
  (expect "static member, generic" (size-of -7) 7)
  (expect "static member, generic at long" (long->string (size-of -7L)) "7")
  (expect "a member returning int" (which -42) -1)
  (expect "a four-argument member" (pin 99 3 9) 9)
  (expect "a member returning bool" (even 4) #t)
  ;; `IsEvenInteger` is right at double, which the hand-written `even?` in
  ;; `std/maths` is not — it answers #f for every double.
  (expect "even at double" (even 2.0) #t)

  ;; An explicitly implemented member, which no direct spelling could reach.
  (expect "explicit member at int" (zeroish 0) #t)
  (expect "explicit member at double" (zeroish 0.5) #f)
  (expect "explicit member at long" (zeroish 0L) #t)

  ;; An instance member: a call on the receiver rather than on the type.
  ;; `string` reaches this and no `System.Numerics` constraint.
  (expect "instance member at int" (rel 3 7) -1)
  (expect "ordering ints" (larger 3 7) 7)
  (expect "ordering strings" (larger "apple" "quince") "quince")
  (expect "ordering strings the other way" (larger "quince" "apple") "quince")

  ;; The same, through a trait and a constrained function that live in another
  ;; assembly.
  (expect "across a dll" (scaled 6 7) 42)
  (expect "across a dll at double" (double->string (scaled 1.5 2.0)) "3")
  ;; And a *method* whose `#:clr-member` binding crossed with it.
  (expect "imported static member" (magnitude -8) 8)
  (expect "imported instance member" (rank "a" "b") -1)
  0)
