;; A where clause naming a type variable the implemented type does not mention.
;;
;; Every constraint becomes a dictionary the impl class holds, and the class's
;; type parameters are the ones its target names. A constraint over anything
;; else is one the class has no parameter to state and no caller could ever
;; supply.
;;
;; EXPECT-ERROR: which the implemented type does not mention

(import (std prelude))

(def/trait (Size %a)
  (: size (-> %a int)))

(def/impl (Size (List %a))
  (where (Size %b))
  (defun (size xs) 0))

(defun (main args)
  (println (size (list 1 2)))
  0)
