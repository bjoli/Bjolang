;; A generic grammar and grammars inside grammars: the keywords of a leaf
;; grammar are read through the alternative that holds it.
;;
;; `Cond` in inc/delegating.bjo is a frame with the parameter `%leaf`. Each
;; user gives the grammar of the leaves. An alternative whose item is another
;; grammar reads the literal by that grammar, and the result is that
;; grammar's case in the case of the outer one. This replaces delegation
;; through an untagged union case.

(import (std prelude))
(import (std simpletest))
(import "inc/delegating.bjo")

;; The leaves: a column test, with a bare keyword and a repeat among them.
(def/grammar Leaf1
  (:or (: LId (id int))
       (: LName (name string))
       (: LNull 'nothing)
       (: LIn (in int ...))))

(: (-> Leaf1 string))
(defun (leaf1 l)
  (match l
    ((LId n) (str "id=" (int->string n)))
    ((LName s) (str "name=" s))
    ((LNull) "nothing")
    ((LIn ns) (str "in" (int->string (list-length ns))))))

(: (-> (Cond Leaf1) string))
(defun (show c) (render-cond leaf1 c))

;; Two levels: Outer holds Middle, and Middle holds Leaf1.
(def/grammar Middle (:or (: MLeaf Leaf1) (: MSkip 'skip)))
(def/grammar Outer (:or (: OMid Middle) (: OStop 'stop)))

(: (-> Outer string))
(defun (outer o)
  (match o
    ((OMid (MLeaf l)) (str "mid(" (leaf1 l) ")"))
    ((OMid (MSkip)) "skip")
    ((OStop) "stop")))

(: (-> string Leaf1))
(defun (named s) '(name ,s))

(defun (main args)
  (expect "a leaf through the generic frame" (show '(id 3)) "id=3")
  (expect "the frame's own keywords beside it"
          (show '(and (id 1) (not (name "x")) nothing)) "and(id=1 not(name=x) nothing)")
  (expect "a repeat in a leaf" (show '(in 1 2 3)) "in3")
  (expect "a bare keyword of a leaf" (show 'nothing) "nothing")

  (expect "two levels down" (outer '(id 7)) "mid(id=7)")
  (expect "one level down" (outer 'skip) "skip")
  (expect "the outer grammar's own" (outer 'stop) "stop")

  ;; `,x` of the leaf's type goes into Leaf: its type selects the case.
  (expect "a spliced leaf value goes into Leaf"
          (show '(and ,(named "ada") (id 1))) "and(name=ada id=1)")
  (def (: c (Cond Leaf1)) '(not (id 4)))
  (expect "an annotated binding" (show c) "not(id=4)")
  0)
