;; `apply` into a function that has no `#:rest` parameter.
;;
;; The shape that most looks like it should work, and the one the whole form is
;; built to refuse. A collection's length is not part of its type, so nothing
;; here can check that `xs` holds exactly the two elements `area` wants. Filling
;; fixed parameters from a collection would therefore need an arity check at run
;; time — and `apply` is specified never to fail there.

;; EXPECT-ERROR: has no #:rest parameter
;; EXPECT-ERROR: would need an arity check at run time

(import (std prelude))

(: area (-> int int int))
(defun (area w h) (* w h))

(defun (main args)
  (def xs (list 3 4))
  (println (int->string (apply area xs)))
  0)
