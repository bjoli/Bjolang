;; Test for first-class Keywords and Symbols with runtime interning
(import (std prelude))
(import (std simpletest))

(: match-kw (-> Keyword int))
(defun (match-kw k)
  (match k
    (:apple 1)
    (:banana 2)
    (:cherry 3)
    (_ 0)))

(: match-sym (-> Symbol string))
(defun (match-sym s)
  (match s
    ('alpha "first")
    ('beta "second")
    ('gamma "third")
    (_ "unknown")))

(defun (main)
  ;; 1. Keyword reference equality and syntax equivalence (:kw vs #:kw)
  (expect-true "the two keyword syntaxes intern to one value" (eq? :foo #:foo))

  (expect-true "different keywords are different values" (not (eq? :foo :bar)))

  ;; 2. Symbol reference equality
  (expect-true "a symbol interns to one value" (eq? 'test 'test))

  (expect-true "different symbols are different values" (not (eq? 'alpha 'beta)))

  ;; 3. Conversions
  (expect "keyword->string drops the colon" (keyword->string :hello) "hello")
  (expect "symbol->string drops the quote" (symbol->string 'world) "world")
  (expect-true "string->keyword reaches the literal's value"
               (eq? (string->keyword "dynamic") :dynamic))
  (expect-true "string->symbol reaches the literal's value"
               (eq? (string->symbol "sym-dyn") 'sym-dyn))

  ;; 4. Predicates
  (expect-true "keyword? on a keyword" (keyword? :foo))
  (expect-true "keyword? on a string" (not (keyword? "foo")))
  (expect-true "symbol? on a symbol" (symbol? 'foo))
  (expect-true "symbol? on an int" (not (symbol? 42)))

  ;; 5. Pattern matching
  (expect "a keyword pattern reaches the first arm" (match-kw :apple) 1)
  (expect "a keyword pattern reaches the second arm" (match-kw :banana) 2)
  (expect "a keyword pattern reaches the third arm" (match-kw :cherry) 3)
  (expect "an unlisted keyword falls through" (match-kw :other) 0)

  (expect "a symbol pattern reaches the first arm" (match-sym 'alpha) "first")
  (expect "a symbol pattern reaches the second arm" (match-sym 'beta) "second")
  (expect "a symbol pattern reaches the third arm" (match-sym 'gamma) "third")
  (expect "an unlisted symbol falls through" (match-sym 'delta) "unknown")

  ;; 6. ->str trait
  (expect "->str on a keyword" (->str :trait-keyword) "trait-keyword")
  (expect "->str on a symbol" (->str 'trait-symbol) "trait-symbol")

  ;; 7. Map usage
  (let ((m (map-set (map-set (map-empty) :first 10) :second 20)))
    (expect "a keyword key finds its value" (map-ref m :first) 10)
    (expect "and a second keyword key its own" (map-ref m :second) 20))

  0)
