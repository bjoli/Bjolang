;; Docs for std/mutable/map.bjo, read through (:doc #:file "map.bjodoc"). The
;; texts are samizdat markup: code in prose is @code{...}.

(:doc #:module
  (summary "In-place hash table backed directly by .NET Dictionary<K,V>.")
  (see MutableMap mutablemap mutablemap-set! mutablemap-ref mutablemap-try-ref)
  (example """
    (import (std mutable map))

    ;; Count occurrences of words:
    (def counts (mutablemap))
    (for-each (fun (w) (mutablemap-set! counts w (+ 1 (mutablemap-ref-or counts w 0))))
              (list "a" "b" "a"))
    (mutablemap-ref counts "a")      ; 2
    (mutablemap-try-ref counts "c")  ; None
    """)
  (reference """
    @code{(MutableMap k v)} directly aliases .NET @code{Dictionary<K,V>}. Key
    lookups, insertions, and removals run in expected O(1) time. Foreign
    methods accepting @code{Dictionary<K,V>} accept @code{MutableMap} directly.

    @strong{Mutability.} Operations such as @code{mutablemap-set!} modify the
    table in place and return unit. Modifications are immediately visible to all
    holders of the map reference. Unlike @code{TransientMap} (which is frozen back
    into an immutable @code{Map}), a @code{MutableMap} remains mutable
    indefinitely. Suitable for long-lived caches, counters, and indices.

    @strong{Key comparison.} Keys are compared using .NET's default equality
    comparer (@code{EqualityComparer<K>.Default}). For types defined in Bjolang,
    this resolves to the type's @code{Eq} instance. Modifying keys while stored
    in the map leads to undefined lookup behavior.

    @strong{Null key support.} Standard .NET dictionaries reject null keys.
    Because empty union cases are represented as null in the runtime, Bjolang's
    mutable maps maintain an optional slot for null keys beside the dictionary.
    Dictionaries instantiated outside this module lack this slot, and passing null
    keys to them raises @code{System.ArgumentNullException}.

    @strong{Missing keys.} @code{mutablemap-ref} raises
    @code{System.Collections.Generic.KeyNotFoundException} if a key is absent.
    Use @code{mutablemap-try-ref} or @code{mutablemap-ref-or} to avoid
    exceptions.

    @strong{Iteration order.} Maps are unordered; iteration order reflects
    internal bucket layout. If a null key is present, it is visited first.

    @strong{Iteration safety.} Iterating over keys, values, or entries
    (@code{mutablemap->seq}, @code{mutablemap-keys}, or an enumerator) reads the
    live dictionary directly. Modifying the map during iteration raises
    @code{System.InvalidOperationException}. To mutate during iteration, take a
    snapshot first via @code{mutablemap->list}.

    @strong{Equality and hashing.} Two maps are @code{=} if they contain
    identical keys and equal corresponding values. Because maps are mutable,
    @code{eq-hash} raises an exception to prevent using mutable maps as keys.

    @strong{Thread safety.} Mutable maps are not thread-safe. Concurrent
    mutations require external locking. For concurrent transactional access
    across fibers, see @code{(std stm map)}.

    @strong{Traits.} Implements @code{Refable} with keys as indices,
    @code{Iterable} and @code{Collection} over @code{(Tuple k v)},
    @code{Addable!} of @code{(Tuple k v)} (replacing existing values), @code{Eq},
    @code{Written} and @code{Displayed}.
    """))

;; ---------------------------------------------------------------------------
;; The map
;; ---------------------------------------------------------------------------

(:doc MutableMap
  (summary "In-place hash table mapping %k to %v (aliases .NET Dictionary<K,V>).")
  (tparam %k "The key type (compared with .NET equality).")
  (tparam %v "The value type.")
  (see mutablemap map->mutablemap Map))

(:doc MutableMapEnumerator
  (summary "One walk of a MutableMap, with .NET's enumerator protocol.")
  (tparam %k "The key type.")
  (tparam %v "The value type.")
  (see mutablemap-enumerator mutablemap-enumerator-next! mutablemap-enumerator-current)
  (reference """
    .NET's dictionary enumerator, a struct, in a heap cell, so that it can
    be held and stepped: one allocation for the walk, none per entry.
    """))

(:doc mutablemap
  (summary "Creates an empty mutable map.")
  (returns "A new empty mutable map.")
  (see mutablemap-with-capacity list->mutablemap))

(:doc mutablemap-with-capacity
  (summary "Creates an empty mutable map with preallocated bucket capacity.")
  (arg capacity "Initial capacity before rehashing is required. Must be >= 0.")
  (returns "A new empty mutable map.")
  (raises System.ArgumentOutOfRangeException "When capacity is negative.")
  (see mutablemap)
  (reference """
    Preallocates internal hash buckets to avoid resizing overhead when the entry
    count is known in advance.
    """))

(:doc mutablemap-length
  (summary "Returns the number of entries in the map.")
  (arg m "The map.")
  (returns "The count of key-value pairs.")
  (see mutablemap-empty?))

(:doc mutablemap-empty?
  (summary "Tests if the map contains no entries.")
  (arg m "The map.")
  (returns "#t if empty, otherwise #f.")
  (see mutablemap-length))

(:doc mutablemap-ref
  (summary "Returns the value associated with a key, raising KeyNotFoundException if missing.")
  (arg m "The map.")
  (arg k "The key to look up.")
  (returns "The value associated with k.")
  (raises System.Collections.Generic.KeyNotFoundException "When k is not in the map.")
  (see mutablemap-try-ref mutablemap-ref-or ref))

(:doc mutablemap-try-ref
  (summary "Returns (Some value) for a key, or None if absent.")
  (arg m "The map.")
  (arg k "The key to look up.")
  (returns "(Some v) if k is present, otherwise None.")
  (see mutablemap-ref mutablemap-ref-or try-ref))

(:doc mutablemap-ref-or
  (summary "Returns the value for a key, or a default fallback if absent.")
  (arg m "The map.")
  (arg k "The key to look up.")
  (arg default "Fallback value returned if k is absent.")
  (returns "The value associated with k, or default.")
  (see mutablemap-ref mutablemap-try-ref))

(:doc mutablemap-set!
  (summary "Associates a key with a value, overwriting any existing value.")
  (arg m "The map to modify.")
  (arg k "The key.")
  (arg v "The value to associate with k.")
  (raises System.ArgumentNullException "When k is null and m is an external .NET Dictionary.")
  (see mutablemap-add-new! mutablemap-remove!))

(:doc mutablemap-add-new!
  (summary "Adds an entry whose key must be new.")
  (arg m "The map to modify.")
  (arg k "The key.")
  (arg v "The value to associate with k.")
  (raises System.ArgumentException "When k is already in m. m is left as it was.")
  (raises System.ArgumentNullException "When k is null and m is an external .NET Dictionary.")
  (see mutablemap-try-add-new! mutablemap-set!)
  (reference """
    @code{mutablemap-set!} without the replacement, for where a key that
    is already there is a mistake. @code{add!} of the @code{Addable!}
    trait never fails, and replaces, as @code{mutablemap-set!} does.
    """))

(:doc mutablemap-try-add-new!
  (summary "Adds an entry whose key must be new, or answers the value the key already has.")
  (arg m "The map to modify.")
  (arg k "The key.")
  (arg v "The value to associate with k.")
  (returns "(Ok unit) when the entry was added; (Err w) when m already maps k to w, and m is left as it was.")
  (raises System.ArgumentNullException "When k is null and m is an external .NET Dictionary.")
  (see mutablemap-add-new! mutablemap-set!)
  (example """
    (match (mutablemap-try-add-new! first-seen word line)
      ((Ok _) unit)
      ((Err earlier) (println #"${word} again, first on line ${earlier}")))
    """)
  (reference """
    @code{mutablemap-add-new!} with the failure as a value. One lookup in
    the table either way, and the @code{Err} carries what it found.
    """))

(:doc mutablemap-remove!
  (summary "Removes a key and its associated value from the map.")
  (arg m "The map to modify.")
  (arg k "The key to remove.")
  (returns "#t if the key was present and removed, #f otherwise.")
  (see mutablemap-set! mutablemap-clear!))

(:doc mutablemap-clear!
  (summary "Removes all entries from the map.")
  (arg m "The map to clear.")
  (see mutablemap-remove!))

(:doc mutablemap-contains?
  (summary "Tests if a key exists in the map.")
  (arg m "The map.")
  (arg k "The key to locate.")
  (returns "#t if k is present, otherwise #f.")
  (see mutablemap-try-ref))

(:doc mutablemap-keys
  (summary "Returns a sequence of all keys in the map.")
  (arg m "The source map.")
  (returns "A Seq iterating over m's keys.")
  (see mutablemap-values mutablemap->seq)
  (reference """
    Views the live map. Mutating the map during sequence traversal raises
    @code{System.InvalidOperationException}.
    """))

(:doc mutablemap-values
  (summary "Returns a sequence of all values in the map.")
  (arg m "The source map.")
  (returns "A Seq iterating over m's values in key order.")
  (see mutablemap-keys mutablemap->seq)
  (reference """
    Views the live map. Mutating the map during sequence traversal raises
    @code{System.InvalidOperationException}.
    """))

(:doc mutablemap-copy
  (summary "Creates a shallow copy of the map.")
  (arg m "The map to copy.")
  (returns "A new mutable map with identical entries. Keys and values are not cloned.")
  (see mutablemap->map))

(:doc mutablemap-enumerator
  (summary "Starts one walk of the map, with .NET's enumerator protocol.")
  (arg m "The map to walk.")
  (returns "A new enumerator, before the first entry.")
  (see mutablemap-enumerator-next! mutablemap-enumerator-current mutablemap-for-each)
  (example """
    (def e (mutablemap-enumerator m))
    (let go ()
      (when (mutablemap-enumerator-next! e)
        (def (k v) (mutablemap-enumerator-current e))
        (println (str k ": " v))
        (go)))
    """)
  (reference """
    @code{mutablemap-enumerator-next!} is .NET's @code{MoveNext}, and
    @code{mutablemap-enumerator-current} is @code{Current}. It is not a
    cursor: stepping it moves it for everyone who holds it, where a cursor
    such as @code{map-cursor} is a position that does not change. A
    @code{for-each}, a @code{loop} or a @code{:for} does the stepping, so
    most programs never hold one.
    """))

(:doc mutablemap-enumerator-next!
  (summary "Steps the enumerator to the next entry, and answers whether there is one.")
  (arg e "The enumerator.")
  (returns "#t when e is on an entry; #f when the walk is over.")
  (see mutablemap-enumerator-current)
  (reference """
    .NET's @code{MoveNext}: call it once before each
    @code{mutablemap-enumerator-current}, the first time too.
    """))

(:doc mutablemap-enumerator-current
  (summary "The entry the enumerator is on, as a (Tuple k v).")
  (arg e "The enumerator, after mutablemap-enumerator-next! returned #t.")
  (returns "The (Tuple key value) pair.")
  (see mutablemap-enumerator-next!))

(:doc mutablemap-for-each
  (summary "Invokes a callback with the key and value of each entry.")
  (arg f "Callback function taking (key, value) arguments.")
  (arg m "The map to iterate over.")
  (see mutablemap-enumerator for-each)
  (example """
    (mutablemap-for-each (fun (k v) (println (str k ": " v))) counts)
    """)
  (reference """
    Passes key and value as two separate arguments to f. Modifying m during
    callback execution raises @code{System.InvalidOperationException}.
    """))

;; ---------------------------------------------------------------------------
;; Conversions
;; ---------------------------------------------------------------------------

(:doc list->mutablemap
  (summary "Constructs a new mutable map from a list of key-value pairs.")
  (arg xs "List of (Tuple key value) pairs. Duplicate keys keep the last value.")
  (returns "A new mutable map.")
  (see mutablemap->list seq->mutablemap))

(:doc mutablemap->list
  (summary "Converts map entries to a list of (Tuple key value) pairs.")
  (arg m "The source map.")
  (returns "A new list containing all entries in traversal order.")
  (see list->mutablemap))

(:doc vec->mutablemap
  (summary "Constructs a new mutable map from a vector of key-value pairs.")
  (arg v "Vector of (Tuple key value) pairs. Duplicate keys keep the last value.")
  (returns "A new mutable map.")
  (see mutablemap->vec seq->mutablemap))

(:doc mutablemap->vec
  (summary "Converts map entries to a vector of (Tuple key value) pairs.")
  (arg m "The source map.")
  (returns "A new vector containing all entries in traversal order.")
  (see vec->mutablemap))

(:doc seq->mutablemap
  (summary "Constructs a new mutable map from a sequence of key-value pairs.")
  (arg xs "Sequence of (Tuple key value) pairs. Duplicate keys keep the last value.")
  (returns "A new mutable map.")
  (see mutablemap->seq)
  (reference """
    Later entries overwrite earlier entries with matching keys, matching
    @code{mutablemap-set!} semantics.
    """))

(:doc mutablemap->seq
  (summary "Views map entries as a sequence of (Tuple key value) pairs.")
  (arg m "The source map.")
  (returns "A Seq iterating over entries of m.")
  (see seq->mutablemap mutablemap->list)
  (reference """
    Views the live map. Modifying the map during sequence traversal raises
    @code{System.InvalidOperationException}. To take an immutable snapshot,
    use @code{mutablemap->list} or @code{mutablemap->vec}.
    """))

(:doc map->mutablemap
  (summary "Constructs a new mutable map from a persistent Map.")
  (arg m "The source persistent map.")
  (returns "A new mutable map containing all entries.")
  (see mutablemap->map))

(:doc mutablemap->map
  (summary "Converts a mutable map into an immutable persistent Map.")
  (arg m "The source mutable map.")
  (returns "A new persistent Map. Subsequent changes to m do not affect it.")
  (see map->mutablemap))

;; ---------------------------------------------------------------------------
;; Printing
;; ---------------------------------------------------------------------------

(:doc mutablemap->str
  (summary "Deprecated: use @code{displayed}. Formats the map as text in the form #mmap(k v ...).")
  (arg m "The map to format.")
  (returns "Formatted string representation using displayed for each key and value.")
  (example """
    (displayed (list->mutablemap (list (Tuple 1 10))))   ; "#mmap(1 10)"
    """)
  (reference """
    The same text as @code{displayed} gives for a mutable map. Formats
    entries without parentheses around pairs.
    """))
