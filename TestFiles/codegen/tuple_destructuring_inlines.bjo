;; Imported trait methods whose bodies destructure with `(def (a b) pair)` are
;; spliced, not called.
;;
;; EXPECT-CS: MapBuilderModule\.Add<int, int>
;; EXPECT-NO-CS: collectorsubstep
;; EXPECT-NO-CS: Eq_Tuple2

(import (std prelude))

(export squares same?)

(: squares (-> int (Map int int)))
(defun (squares n)
  (loop (:for i (range 0 n)) (:acc m (mapping (Tuple i (* i i))))))

(: same? (-> (Tuple int int) (Tuple int int) bool))
(defun (same? a b)
  (= a b))
