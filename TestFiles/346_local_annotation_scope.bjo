(import (std prelude))
(import (std simpletest))

;; A local function's annotation variables are in scope in its body. A
;; function nested in it may still be polymorphic in its own variables, and
;; uses the enclosing one where it mentions it.

(defun (main args)
  (defun (f (: y %b))
    (defun (g z) (Tuple z y))
    (Tuple (g 1) (g "s")))
  (expect "nested function over the enclosing local's variable"
          (->str (f 5))
          "((1, 5), (s, 5))")
  0)
