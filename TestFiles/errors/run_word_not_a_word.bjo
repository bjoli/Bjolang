;; A character among the words of a command.
;;
;; The grammar of `run/Form` reads a command as a list of `Word`s. A `Word` is
;; a symbol, a string, an int, a double, a vector of arguments, an unquoted
;; command, an unquoted filter or a nested form. A character is none of these.
;; Write `"x"` instead. The compiler refuses the literal where you write it.

;; EXPECT-ERROR: expected Word or the end of the list; found a character

(import (std prelude))
(import (std run))

(defbjo (main args)
  (match (run/string '(echo #\x))
    ((Ok s) (displayln s))
    ((Err e) (displayln "err")))
  0)
