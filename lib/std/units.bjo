(def standard-preferred
  (list (Tuple "m" AllPrefixes) (Tuple "g" AllPrefixes) (Tuple "s" SmallPrefixes)
        (Tuple "A" AllPrefixes) (Tuple "K" SmallPrefixes) (Tuple "mol" AllPrefixes)
        (Tuple "cd" AllPrefixes) (Tuple "b" AllPrefixes)
        (Tuple "N" AllPrefixes) (Tuple "Pa" AllPrefixes) (Tuple "J" AllPrefixes)
        (Tuple "W" AllPrefixes) (Tuple "C" AllPrefixes) (Tuple "V" AllPrefixes)
        (Tuple "ohm" AllPrefixes) (Tuple "S" AllPrefixes) (Tuple "F" AllPrefixes)
        (Tuple "H" AllPrefixes) (Tuple "Wb" AllPrefixes) (Tuple "T" AllPrefixes)
        (Tuple "lx" AllPrefixes) (Tuple "Hz" AllPrefixes) (Tuple "Gy" AllPrefixes)))

(: (-> UnitTable (List string) UnitTable))
(defun (add-definition t entry)
  (match entry
    ((Cons name (Cons definition aliases))
     (list-foldl (fun (alias t) (ok-or-raise (def-unit t alias (str "1 " name))))
                 (if (orderedmap-has-key? (record-ref t units) name)
                     t
                     (ok-or-raise (def-unit t name definition)))
                 aliases))
    (_ (argument-error "a definition needs a name and a definition"))))

(: standard-units UnitTable)
(def standard-units
  (let* ((t (list-foldl (fun (d t) (ok-or-raise (def-dimension t (first-of-2 d) (second-of-2 d))))
                        empty-unit-table si-dimensions))
         (t (list-foldl (fun (p t) (ok-or-raise (def-prefix t (first-of-2 p) (second-of-2 p))))
                        t si-prefixes))
         (t (list-foldl (fun (e t) (add-definition t e)) t standard-definitions)))
    (list-foldl (fun (p t) (ok-or-raise (def-preferred t (fst p) (snd p))))
                t standard-preferred)))

(: (-> (List string) string))
(defun (first-of-2 xs)
  (match xs
    ((Cons a _) a)
    (Nil "")))

(: (-> (List string) string))
(defun (second-of-2 xs)
  (match xs
    ((Cons _ (Cons b _)) b)
    (_ "")))

;; ---------------------------------------------------------------------------
;; Measurements
;; ---------------------------------------------------------------------------

;; A value in the coherent unit of its dimension.
(type (: Measurement (Struct (: value double) (: dims (OrderedMap string Rational)))))

(: (-> double (OrderedMap string Rational) Measurement))
(defun (measurement v d) (Measurement (value v) (dims d)))

(: (-> Measurement double))
(defun (measurement-value m) (struct-ref m value))

(: (-> Measurement (OrderedMap string Rational)))
(defun (measurement-dims m) (struct-ref m dims))

(def no-dims (orderedmap-empty))

(: (-> string Measurement Measurement (Result string Measurement)))
(defun (same-dims what a b)
  (if (= (measurement-dims a) (measurement-dims b))
      (Ok a)
      (Err (str "cannot " what " " (dims->string (measurement-dims a))
                " and " (dims->string (measurement-dims b))))))

(: (-> UnitTable Expr (Result string Measurement)))
(defun (eval-measure t e)
  (match e
    ((ENum q) (Ok (measurement (rational->double q) no-dims)))
    (EPi (Ok (measurement pi no-dims)))
    ((EUnit n)
     (match (lookup t n)
       ((Some r) (Ok (measurement (resolved-double r) (resolved-dims r))))
       (None (Err (unknown-unit t n)))))
    ((EMul a b)
     (def (Ok x) (eval-measure t a) :propagate)
     (def (Ok y) (eval-measure t b) :propagate)
     (Ok (measurement* x y)))
    ((EDiv a b)
     (def (Ok x) (eval-measure t a) :propagate)
     (def (Ok y) (eval-measure t b) :propagate)
     (Ok (measurement/ x y)))
    ((EPow a q)
     (def (Ok x) (eval-measure t a) :propagate)
     (Ok (measurement-expt x q)))
    ((ENeg a)
     (def (Ok x) (eval-measure t a) :propagate)
     (Ok (measurement-scale -1.0 x)))
    ((EAdd a b)
     (def (Ok x) (eval-measure t a) :propagate)
     (def (Ok y) (eval-measure t b) :propagate)
     (def (Ok _) (same-dims "add" x y) :propagate)
     (Ok (measurement (+ (measurement-value x) (measurement-value y)) (measurement-dims x))))
    ((ESub a b)
     (def (Ok x) (eval-measure t a) :propagate)
     (def (Ok y) (eval-measure t b) :propagate)
     (def (Ok _) (same-dims "subtract" x y) :propagate)
     (Ok (measurement (- (measurement-value x) (measurement-value y)) (measurement-dims x))))
    ((ECall f a)
     (def (Ok x) (eval-measure t a) :propagate)
     (Ok (measurement-expt x (if (= f "sqrt") (rational 1 2) (rational 1 3)))))))

;; "6000 m + 50 ft", "0.5 * 1.225 kg/m^3 * (120 km/h)^2", "sqrt(2 m^2)".
(: (-> string (#:table UnitTable) (Result string Measurement)))
(defun (string->measurement text #:table standard-units)
  (def (Ok e) (parse-expression text) :propagate)
  (eval-measure table e))

(: (-> string Measurement Measurement Measurement))
(defun (checked what a b)
  (match (same-dims what a b)
    ((Ok _) a)
    ((Err e) (argument-error e))))

;; Raises ArgumentException when the dimensions differ.
(: (-> Measurement Measurement Measurement))
(defun (measurement+ a b)
  (ignore (checked "add" a b))
  (measurement (+ (measurement-value a) (measurement-value b)) (measurement-dims a)))

;; Raises ArgumentException when the dimensions differ.
(: (-> Measurement Measurement Measurement))
(defun (measurement- a b)
  (ignore (checked "subtract" a b))
  (measurement (- (measurement-value a) (measurement-value b)) (measurement-dims a)))

(: (-> Measurement Measurement Measurement))
(defun (measurement* a b)
  (measurement (* (measurement-value a) (measurement-value b))
               (exps* (measurement-dims a) (measurement-dims b))))

(: (-> Measurement Measurement Measurement))
(defun (measurement/ a b)
  (measurement (/ (measurement-value a) (measurement-value b))
               (exps* (measurement-dims a) (exps-invert (measurement-dims b)))))

(: (-> double Measurement Measurement))
(defun (measurement-scale k m)
  (measurement (* k (measurement-value m)) (measurement-dims m)))

(: (-> Measurement Rational Measurement))
(defun (measurement-expt m q)
  (measurement (pow (measurement-value m) (rational->double q))
               (exps-scale (measurement-dims m) q)))

(: (-> Measurement Measurement))
(defun (measurement-sqrt m) (measurement-expt m (rational 1 2)))

(: (-> Measurement Measurement bool))
(defun (conformable? a b) (= (measurement-dims a) (measurement-dims b)))

;; m as a number of target: (measurement-in m "ft"), (measurement-in m "12 mi/h").
(: (-> Measurement string (#:table UnitTable) (Result string double)))
(defun (measurement-in m target #:table standard-units)
  (def (Ok u) (string->measurement target #:table table) :propagate)
  (if (conformable? m u)
      (Ok (/ (measurement-value m) (measurement-value u)))
      (Err (str "cannot convert " (dims->string (measurement-dims m))
                " to " target ", which is " (dims->string (measurement-dims u))))))

;; ---------------------------------------------------------------------------
;; Printing
;; ---------------------------------------------------------------------------

;; 7 significant digits, invariant culture.
(: (-> double string))
(defun (format-number x)
  (string-replace (.ToString x "G7" clr-invariant) "−" "-"))

(def print-prefixes
  (list "Q" "R" "Y" "Z" "E" "P" "T" "G" "M" "k" "m" "u" "n" "p" "f" "a" "z" "y" "r" "q"))

;; The prefix for x in a unit: the largest power of 1000 at most |x|, or the
;; smallest when |x| is below all.
(: (-> UnitTable double PrefixUse (Tuple string double)))
(defun (choose-prefix t x use)
  (def a (abs x))
  (def candidates
    (match use
      (NoPrefix Nil)
      (_ (list-filter (fun (p) (match use
                                 (SmallPrefixes (< (snd p) 1.0))
                                 (_ #t)))
                      (list-map (fun (p) (Tuple p (rational->double (orderedmap-ref (record-ref t prefixes) p))))
                                (list-filter (fun (p) (orderedmap-has-key? (record-ref t prefixes) p)) print-prefixes))))))
  (def all (Cons (Tuple "" 1.0) candidates))
  (def fitting (list-filter (fun (p) (<= (snd p) a)) all))
  (cond
    ((= a 0.0) (Tuple "" 1.0))
    ((list-empty? fitting)
     (list-foldl (fun (p best) (if (< (snd p) (snd best)) p best)) (Tuple "" 1.0) all))
    (else
     (list-foldl (fun (p best) (if (> (snd p) (snd best)) p best)) (Tuple "" 0.0) fitting))))

;; In the dimension's preferred unit with a prefix by magnitude, or else in
;; the coherent unit written with the base units: "3.6 MJ", "33.33333 m/s".
(: (-> Measurement (#:table UnitTable) string))
(defun (measurement->string m #:table standard-units)
  (def d (measurement-dims m))
  (def v (measurement-value m))
  (cond
    ((orderedmap-empty? d) (format-number v))
    (:match (Some (Tuple unit use)) (orderedmap-try-ref (record-ref table preferred) (exps->string d))
     (def u (match (lookup table unit)
              ((Some r) (resolved-double r))
              (None 1.0)))
     (def x (/ v u))
     (def (p pv) (choose-prefix table x use))
     (str (format-number (/ x pv)) " " p unit))
    (else
     (def names (orderedmap-fold (fun (dim q acc)
                                   (orderedmap-set acc (orderedmap-ref-or (record-ref table dimensions) dim dim) q))
                                 (orderedmap-empty) d))
     (str (format-number v) " " (exps->string names)))))

;; Mixed output: (measurement->string/mixed m (list "h" "min")) is "5 h 25 min".
;; Each unit but the last takes a whole number, the last the rest.
(: (-> Measurement (List string) (#:table UnitTable) (Result string string)))
(defun (measurement->string/mixed m units #:table standard-units)
  (def (Ok targets)
    (list-foldl (fun (u acc)
                  (match acc
                    ((Ok xs)
                     (match (string->measurement u #:table table)
                       ((Ok v) #:when (conformable? v m) (Ok (Cons (Tuple u (measurement-value v)) xs)))
                       ((Ok v) (Err (str "cannot convert " (dims->string (measurement-dims m)) " to " u)))
                       ((Err e) (Err e))))
                    (e e)))
                (Ok Nil) units)
    :propagate)
  (let go ((ts (list-reverse targets)) (remaining (measurement-value m)) (parts Nil))
    (match ts
      (Nil (Ok (string-join (list->vec (list-reverse parts)) " ")))
      ((Cons (Tuple u scale) Nil)
       (def x (/ remaining scale))
       (go Nil 0.0 (if (or (> (abs x) 1e-9) (list-empty? parts))
                       (Cons (str (format-number x) " " u) parts)
                       parts)))
      ((Cons (Tuple u scale) more)
       (def whole (truncate (round-to (/ remaining scale) 9)))
       (go more (- remaining (* whole scale))
           (if (= whole 0.0) parts (Cons (str (format-number whole) " " u) parts)))))))

(import/extern
  (clr-round-digits (: System.Math.Round (-> double int double))))

(: (-> double int double))
(defun (round-to x digits) (clr-round-digits x digits))

;; A query as Umits takes it: "12 h in s", "65 mi/(12 mi/h) in h,min",
;; "6 ft, 2 in in m", or an expression alone, printed by measurement->string.
;; A single target of another dimension divides: "65 mi in 12 mi/h" is
;; "19500 s".
(: (-> string (#:table UnitTable) (Result string string)))
(defun (convert-query query #:table standard-units)
  (def (lhs rhs)
    (match (string-search-backward query " in ")
      ((Some at) (Tuple (substring query (string-cursor-start query) at)
                        (Some (substring query (string-cursor-forward query at 4) (string-cursor-end query)))))
      (None (Tuple query None))))
  (def (Ok m) (string->measurement (string-replace lhs "," " + ") #:table table) :propagate)
  (match rhs
    (None (Ok (measurement->string m #:table table)))
    ((Some targets)
     (def units (list-map string-trim (vec->list (string-split targets ","))))
     (match units
       ((Cons u Nil)
        (def (Ok target) (string->measurement u #:table table) :propagate)
        (if (conformable? m target)
            (Ok (str (format-number (/ (measurement-value m) (measurement-value target))) " " u))
            (Ok (measurement->string (measurement/ m target) #:table table))))
       (_ (measurement->string/mixed m units #:table table))))))

(impl (Written Measurement)
  (defun (written m) (str "(string->measurement \"" (measurement->string m) "\")"))
  (defun (write-into m b) (stringbuilder-add-string! b (written m))))

(impl (Displayed Measurement)
  (defun (displayed m) (measurement->string m))
  (defun (display-into m b) (stringbuilder-add-string! b (measurement->string m))))

;; ---------------------------------------------------------------------------
;; Temperatures
;; ---------------------------------------------------------------------------
;; Absolute temperatures. Differences are measured in K or degR.

(type (: Celsius (Newtype double)))
(type (: Fahrenheit (Newtype double)))

(: (-> Celsius Measurement))
(defun (celsius->kelvin c)
  (def (Celsius x) c)
  (measurement (+ x 273.15) (measurement-dims (ok-or-raise (string->measurement "K")))))

;; Raises ArgumentException when k is not a temperature.
(: (-> Measurement Celsius))
(defun (kelvin->celsius k)
  (Celsius (- (ok-or-raise (measurement-in k "K")) 273.15)))

(: (-> Fahrenheit Measurement))
(defun (fahrenheit->kelvin f)
  (def (Fahrenheit x) f)
  (measurement (* (+ x 459.67) (/ 5.0 9.0)) (measurement-dims (ok-or-raise (string->measurement "K")))))

;; Raises ArgumentException when k is not a temperature.
(: (-> Measurement Fahrenheit))
(defun (kelvin->fahrenheit k)
  (Fahrenheit (- (* (ok-or-raise (measurement-in k "K")) (/ 9.0 5.0)) 459.67)))

(impl (Written Celsius)
  (defun (written c) (def (Celsius x) c) (str "(Celsius " (written x) ")"))
  (defun (write-into c b) (stringbuilder-add-string! b (written c))))

(impl (Displayed Celsius)
  (defun (displayed c) (def (Celsius x) c) (str (format-number x) " °C"))
  (defun (display-into c b) (stringbuilder-add-string! b (displayed c))))

(impl (Written Fahrenheit)
  (defun (written f) (def (Fahrenheit x) f) (str "(Fahrenheit " (written x) ")"))
  (defun (write-into f b) (stringbuilder-add-string! b (written f))))

(impl (Displayed Fahrenheit)
  (defun (displayed f) (def (Fahrenheit x) f) (str (format-number x) " °F"))
  (defun (display-into f b) (stringbuilder-add-string! b (displayed f))))

;; ---------------------------------------------------------------------------
;; Logarithmic
;; ---------------------------------------------------------------------------
;; Each raises ArgumentException when the measurement has the wrong dimension.

(: (-> double Measurement string double))
(defun (decibels k m reference)
  (* k (log10 (ok-or-raise (measurement-in m reference)))))

(: (-> double double string Measurement))
(defun (from-decibels k x reference)
  (measurement-scale (pow 10.0 (/ x k)) (ok-or-raise (string->measurement reference))))

(: (-> Measurement double))
(defun (dBW p) (decibels 10.0 p "1 W"))

(: (-> Measurement double))
(defun (dBm p) (decibels 10.0 p "1 mW"))

(: (-> Measurement double))
(defun (dBV v) (decibels 20.0 v "1 V"))

(: (-> Measurement double))
(defun (dBSPL p) (decibels 20.0 p "20 uPa"))

(: (-> double Measurement))
(defun (dBW->power x) (from-decibels 10.0 x "1 W"))

(: (-> double Measurement))
(defun (dBm->power x) (from-decibels 10.0 x "1 mW"))

(: (-> double Measurement))
(defun (dBV->voltage x) (from-decibels 20.0 x "1 V"))

(: (-> double Measurement))
(defun (dBSPL->pressure x) (from-decibels 20.0 x "20 uPa"))
