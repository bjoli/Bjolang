;; Integer lanes have no vector division: no instruction does it, and a zero
;; divisor would raise. `simd-div` is a `SimdFloat` method.

;; EXPECT-ERROR: no implementation of trait 'FloatLane' for 'long', needed by the implementation of 'SimdFloat'

(import (std prelude))
(import (std simd))

(defun (main)
  (println (simd-ref (simd-div (simd256-splat 10L) (simd256-splat 2L)) 0))
  0)
