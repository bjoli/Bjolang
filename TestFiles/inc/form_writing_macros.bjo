;; Macros whose templates write a special form, for
;; `339_local_named_like_form.bjo`: the form a template writes is the one the
;; template meant, whatever the caller binds locally.

(import (std prelude))
(import (std syntax-match))

(export both-of negate)

(def/macro (both-of form inject compare)
  (syntax-match form
    ((_ x) #'(list ,x ,x))))

(def/macro (negate form inject compare)
  (syntax-match form
    ((_ x) #'(not ,x))))
