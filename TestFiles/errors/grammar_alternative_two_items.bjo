;; An alternative has one item. Several values go in a list item, as
;; (from symbol string), so the compiler refuses two items after the label.
;; EXPECT-ERROR: CFrom has more than one item. Put them in a list
(import (std prelude))

(def/grammar Q
  (:or (: CFrom symbol string)
       (: CPlain (symbol ...))))

(defun (main args) 0)
