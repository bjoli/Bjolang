;; A module without (:doc #:module ...) is not documented, and nothing it
;; exports is warned about: documenting one function in a scratch file is not
;; a promise to document the rest.

;; EXPECT-NO-WARNING: has no (:doc

(import (std prelude))

(export double halve)

(:doc double
  (summary "Twice the number.")
  (arg x "A number.")
  (returns "2x."))
(: double (-> int int))
(defun (double x) (* 2 x))

(: halve (-> int int))
(defun (halve x) (/ x 2))

(defun (main args) 0)
