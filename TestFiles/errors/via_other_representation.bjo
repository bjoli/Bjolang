;; The via type's dictionary is used as the newtype's, so the two have to be one
;; type at run time.

;; EXPECT-ERROR: 'Eq' cannot be implemented for via_other_representation/Banana via string: the two are different at run time: via_other_representation/Banana is int, and string is string.

(import (std prelude))

(type (: Banana (Newtype int)))
(impl (Eq Banana) #:via string)

(defun (main args) 0)
