;; std/unicode/grapheme.bjo — extended grapheme clusters (UAX #29).
;;
;; - The rules are two state machines over characters, which know nothing of
;;   the container: a forward step, and a backward one that decides the
;;   boundary between two characters and asks for the characters before them
;;   when a rule needs them. A front end drives them with its own cursors.
;; - This module has the front end for strings. (std text) has the one for
;;   texts.
;; - The property table is generated by gen_grapheme.py into
;;   grapheme-table.protobjo.
;;
;; Cost:
;; - A step forward reads each character of the cluster once.
;; - A step back reads the cluster, and, for the three rules with context
;;   (GB9c, GB11, GB12/13), the run of characters the rule looks back over.
;;   A run of regional indicators is counted once: from a boundary followed by
;;   one, the parity is known, so a loop back over a text takes O(n) time.

(export
  grapheme-unicode-version
  ;; The forward state machine
  grapheme-plain-break?
  grapheme-start grapheme-step grapheme-break?
  ;; The backward state machine
  grapheme-back-start grapheme-back-needs-after? grapheme-back-start-before grapheme-back-pair
  grapheme-back-wants? grapheme-back-more grapheme-back-sot grapheme-back-break?
  ;; Strings
  string-cursor-next-grapheme string-cursor-prev-grapheme string-cursor-grapheme-boundary?
  string-grapheme-count string->graphemes)

;; The core, so that (std prelude) can import this module.
(import (std prelude core))

(:doc #:file "grapheme.bjodoc")

(import/class
  (ArgumentOutOfRangeException (: System.ArgumentOutOfRangeException))
  (Exception (: System.Exception)))

(include "grapheme-table.protobjo")

;; ---------------------------------------------------------------------------
;; The property table
;; ---------------------------------------------------------------------------

(: string)
(def grapheme-unicode-version unicode-version)

;; The value of a hex digit, as a byte of ASCII.
(: (-> byte int))
(defun (hex-value b)
  (def x (cast int b))
  (if (< x 97) (- x 48) (- x 87)))

;; The bytes of `text` that are not white space: the generated texts are
;; indented, and every character they hold is '0' or above.
(: (-> string (Array byte)))
(defun (table-bytes text)
  (def src (string->bytes text))
  (def n (loop (:for b src) (:when (>= (cast int b) 48)) (:acc (summing 1))))
  (def (: out (Array byte)) (make-array n))
  (let go ((i 0) (j 0))
    (cond
      ((>= i (array-length src)) out)
      ((< (cast int (array-ref src i)) 48) (go (+ i 1) j))
      (else (array-set! out j (array-ref src i)) (go (+ i 1) (+ j 1))))))

;; Bytes written as two hex digits each.
(: (-> string (Array byte)))
(defun (hex-bytes text)
  (def digits (table-bytes text))
  (def (: out (Array byte)) (make-array (/ (array-length digits) 2)))
  (loop (:for i (range 0 (array-length out)))
        (:do (array-set! out i (cast byte (+ (* 16 (hex-value (array-ref digits (* 2 i))))
                                            (hex-value (array-ref digits (+ (* 2 i) 1))))))))
  out)

;; The block of each 256 code points.
(: (Array byte))
(def stage1 (hex-bytes stage1-text))

;; The property bytes of the blocks, one a code point.
(: (Array byte))
(def stage2
  (begin
    (def kinds (hex-bytes kinds-text))
    (def codes (table-bytes stage2-text))
    (def (: out (Array byte)) (make-array (array-length codes)))
    (loop (:for i (range 0 (array-length codes)))
          (:do (array-set! out i (array-ref kinds (- (cast int (array-ref codes i)) 48)))))
    out))

;; The property byte of a character:
;; - bits 0-3, Grapheme_Cluster_Break (the gcb- constants);
;; - bit 4, Extended_Pictographic;
;; - bits 5-6, Indic_Conjunct_Break (the incb- constants).
(: (-> char int) #:inline)
(defun (props-of ch)
  (def cp (char->int ch))
  (cast int (array-ref stage2 (+ (shift-left (cast int (array-ref stage1 (shift-right cp 8))) 8)
                                 (bitwise-and cp 255)))))

(def gcb-cr 1)
(def gcb-lf 2)
(def gcb-control 3)
(def gcb-extend 4)
(def gcb-zwj 5)
(def gcb-ri 6)
(def gcb-prepend 7)
(def gcb-spacing-mark 8)
(def gcb-l 9)
(def gcb-v 10)
(def gcb-t 11)
(def gcb-lv 12)
(def gcb-lvt 13)

(def incb-linker 1)
(def incb-consonant 2)
(def incb-extend 3)

(: (-> int int) #:inline)
(defun (gcb p) (bitwise-and p 15))

(: (-> int bool) #:inline)
(defun (pictographic? p) (not (= (bitwise-and p 16) 0)))

(: (-> int int) #:inline)
(defun (incb p) (bitwise-and (shift-right p 5) 3))

;; Whether a code point is printable ASCII: GCB=Other, and none of the
;; other properties.
(: (-> int bool) #:inline)
(defun (printable-ascii? cp) (and (>= cp 32) (< cp 127)))

;; Whether the rules put a boundary between code points `a` and `b` with no
;; context: both are printable ASCII. A front end can test bytes with it.
(: (-> int int bool) #:inline)
(defun (grapheme-plain-break? a b) (and (printable-ascii? a) (printable-ascii? b)))

;; ---------------------------------------------------------------------------
;; The rules
;; ---------------------------------------------------------------------------

;; What the rules say of the boundary between two characters, by their
;; properties alone.
(def rule-join 0)
(def rule-break 1)
;; GB9c: a Linker, then InCB=Extend characters, then a Consonant.
(def rule-conjunct 2)
;; GB11: a pictograph, then Extend characters and a ZWJ, then a pictograph.
(def rule-emoji 3)
;; GB12/13: an odd number of regional indicators before the second.
(def rule-flag 4)

;; The rule for the boundary between characters of properties `pa` and `pb`:
;; join, break, or which rule with context decides it. UAX #29 3.1.1, in
;; order.
(: (-> int int int))
(defun (pair-rule pa pb)
  (def a (gcb pa))
  (def b (gcb pb))
  (cond
    ;; GB3, GB4, GB5
    ((and (= a gcb-cr) (= b gcb-lf)) rule-join)
    ((or (= a gcb-cr) (= a gcb-lf) (= a gcb-control)) rule-break)
    ((or (= b gcb-cr) (= b gcb-lf) (= b gcb-control)) rule-break)
    ;; GB6, GB7, GB8
    ((and (= a gcb-l) (or (= b gcb-l) (= b gcb-v) (= b gcb-lv) (= b gcb-lvt))) rule-join)
    ((and (or (= a gcb-lv) (= a gcb-v)) (or (= b gcb-v) (= b gcb-t))) rule-join)
    ((and (or (= a gcb-lvt) (= a gcb-t)) (= b gcb-t)) rule-join)
    ;; GB9, GB9a, GB9b
    ((or (= b gcb-extend) (= b gcb-zwj) (= b gcb-spacing-mark)) rule-join)
    ((= a gcb-prepend) rule-join)
    ;; GB9c, GB11, GB12/13
    ((and (= (incb pb) incb-consonant) (or (= (incb pa) incb-linker) (= (incb pa) incb-extend))) rule-conjunct)
    ((and (= a gcb-zwj) (pictographic? pb)) rule-emoji)
    ((and (= a gcb-ri) (= b gcb-ri)) rule-flag)
    ;; GB999
    (else rule-break)))

;; ---------------------------------------------------------------------------
;; Forward
;; ---------------------------------------------------------------------------

;; A forward state is an int:
;; - bits 0-6, the properties of the last character;
;; - bit 7, the text ends in a pictograph and Extend characters (GB11);
;; - bit 8, it ends in those and a ZWJ (GB11);
;; - bit 9, it ends in an odd number of regional indicators (GB12/13);
;; - bit 10, it ends in a Linker and InCB=Extend characters (GB9c);
;; - bit 11, there is a boundary before the last character.
(def fwd-pict 128)
(def fwd-pict-zwj 256)
(def fwd-odd-ri 512)
(def fwd-linker 1024)
(def fwd-break 2048)

(: (-> int int bool) #:inline)
(defun (has? st bit) (not (= (bitwise-and st bit) 0)))

;; The state after a character of properties `p`, from the state `st` before
;; it.
(: (-> int int bool int))
(defun (state-after p st brk)
  (def g (gcb p))
  (def i (incb p))
  (bitwise-ior
    p
    (if (or (pictographic? p) (and (= g gcb-extend) (has? st fwd-pict))) fwd-pict 0)
    (if (and (= g gcb-zwj) (has? st fwd-pict)) fwd-pict-zwj 0)
    (if (and (= g gcb-ri) (not (and (= (gcb st) gcb-ri) (has? st fwd-odd-ri)))) fwd-odd-ri 0)
    (if (or (= i incb-linker) (and (= i incb-extend) (has? st fwd-linker))) fwd-linker 0)
    (if brk fwd-break 0)))

;; The state after the first character of a text, or of a cluster.
(: (-> char int))
(defun (grapheme-start ch) (state-after (props-of ch) 0 #t))

;; The state after `ch`, from the state after the character before it.
;; - Before printable ASCII, the rules break unless the character before is
;;   Prepend (GB9b), and the state after it is that of Other.
(: (-> int char int) #:inline)
(defun (grapheme-step st ch)
  (if (printable-ascii? (char->int ch))
      (if (= (gcb st) gcb-prepend) 0 fwd-break)
      (grapheme-step-table st ch)))

(: (-> int char int))
(defun (grapheme-step-table st ch)
  (def p (props-of ch))
  (def r (pair-rule (bitwise-and st 127) p))
  (state-after p st
    (cond
      ((= r rule-join) #f)
      ((= r rule-break) #t)
      ((= r rule-conjunct) (not (has? st fwd-linker)))
      ((= r rule-emoji) (not (has? st fwd-pict-zwj)))
      (else (not (has? st fwd-odd-ri))))))

;; Whether there is a boundary before the last character of a state.
(: (-> int bool) #:inline)
(defun (grapheme-break? st) (has? st fwd-break))

;; ---------------------------------------------------------------------------
;; Backward
;; ---------------------------------------------------------------------------

;; A backward state is an int:
;; - bits 0-1, the answer: 0 join, 1 break, 2 not known yet;
;; - bits 2-4, while not known, the rule that is looking back;
;; - bit 5, the parity of the regional indicators that end at the first
;;   character given so far is known; bit 6, it is odd;
;; - bit 7, while counting regional indicators, an odd number so far.
(def back-join 0)
(def back-break 1)
(def back-wants 2)
(def back-known 32)
(def back-odd 64)
(def back-count-odd 128)

;; The answer `answer`, where the regional indicators that end at the first
;; character given number `odd`: #t odd, #f even, or unknown with `known` #f.
(: (-> int bool bool int))
(defun (back-answer answer known odd)
  (bitwise-ior answer (if known back-known 0) (if odd back-odd 0)))

;; The backward state of a cursor at the end of a text, or of one where
;; nothing is known of what follows.
(: (-> int))
(defun (grapheme-back-start) 0)

;; Whether the backward state of a cursor needs the character after it, given
;; `b`, the character before it: only when `b` is a regional indicator, as
;; the parity of those that end at `b` matters only then.
(: (-> char bool) #:inline)
(defun (grapheme-back-needs-after? b)
  (and (not (printable-ascii? (char->int b))) (= (gcb (props-of b)) gcb-ri)))

;; The backward state of a cursor on a cluster boundary, before `ch`.
;; - A boundary before a regional indicator has an even number of them
;;   before it, which saves counting them.
(: (-> char int))
(defun (grapheme-back-start-before ch)
  (if (and (not (printable-ascii? (char->int ch))) (= (gcb (props-of ch)) gcb-ri)) back-known 0))

;; The state for the boundary between `a` and `b`, where `b` is the first
;; character given before, or the one before the cursor.
;; - Known at once, unless a rule needs the characters before `a`: then
;;   grapheme-back-wants? is #t.
;; - Between two characters of printable ASCII, a break, and no regional
;;   indicators end at `a`.
(: (-> int char char int) #:inline)
(defun (grapheme-back-pair w a b)
  (if (grapheme-plain-break? (char->int a) (char->int b))
      (bitwise-ior back-break back-known)
      (grapheme-back-pair-table w a b)))

(: (-> int char char int))
(defun (grapheme-back-pair-table w a b)
  (def pa (props-of a))
  (def pb (props-of b))
  (def r (pair-rule pa pb))
  (def a-ri (= (gcb pa) gcb-ri))
  ;; The parity at `a`, from that at `b`, when it follows without counting.
  (def known (or (not a-ri) (and (= (gcb pb) gcb-ri) (has? w back-known))))
  (def odd (and a-ri (= (gcb pb) gcb-ri) (not (has? w back-odd))))
  (cond
    ((= r rule-join) (back-answer back-join known odd))
    ((= r rule-break) (back-answer back-break known odd))
    ((and (= r rule-conjunct) (= (incb pa) incb-linker)) (back-answer back-join known odd))
    ((and (= r rule-flag) known) (back-answer (if odd back-join back-break) known odd))
    ;; Count the indicators before `a`, starting with `a`.
    ((= r rule-flag) (bitwise-ior back-wants (shift-left r 2) back-count-odd))
    (else (bitwise-ior back-wants (shift-left r 2)))))

;; Whether the state needs the character before the last one given.
(: (-> int bool) #:inline)
(defun (grapheme-back-wants? w) (= (bitwise-and w 3) back-wants))

;; The state after `ch`, the character before the last one given.
(: (-> int char int))
(defun (grapheme-back-more w ch)
  (def p (props-of ch))
  (def r (bitwise-and (shift-right w 2) 7))
  (cond
    ((= r rule-conjunct)
     (cond
       ((= (incb p) incb-extend) w)
       ((= (incb p) incb-linker) (back-answer back-join #t #f))
       (else (back-answer back-break #t #f))))
    ((= r rule-emoji)
     (cond
       ((= (gcb p) gcb-extend) w)
       ((pictographic? p) (back-answer back-join #t #f))
       (else (back-answer back-break #t #f))))
    ((= (gcb p) gcb-ri) (bitwise-xor w back-count-odd))
    (else (grapheme-back-sot w))))

;; The state when there is no character before the last one given.
(: (-> int int))
(defun (grapheme-back-sot w)
  (def r (bitwise-and (shift-right w 2) 7))
  (if (= r rule-flag)
      (let ((odd (has? w back-count-odd)))
        (back-answer (if odd back-join back-break) #t odd))
      (back-answer back-break #t #f)))

;; Whether the state, once known, is a boundary.
(: (-> int bool) #:inline)
(defun (grapheme-back-break? w) (= (bitwise-and w 3) back-break))

;; ---------------------------------------------------------------------------
;; Strings
;; ---------------------------------------------------------------------------

(: (-> string %a) #:no-inline)
(defun (out-of-range why)
  (raise (cast Exception (ArgumentOutOfRangeException. "c" why))))

;; The cursor after the cluster that starts at `c`, a cluster boundary of `s`.
(: (-> string StringCursor StringCursor))
(defun (string-cursor-next-grapheme s c)
  (when (string-cursor-end? s c) (out-of-range "string-cursor-next-grapheme: the cursor is at the end."))
  (def (Tuple ch0 c1) (string-cursor-ref+next s c))
  (let go ((st (grapheme-start ch0)) (c c1))
    (if (string-cursor-end? s c)
        c
        (begin
          (def (Tuple ch nxt) (string-cursor-ref+next s c))
          (def st2 (grapheme-step st ch))
          (if (grapheme-break? st2) c (go st2 nxt))))))

;; The state `w` once known, reading back from `k`, the cursor of the last
;; character given.
(: (-> string StringCursor int StringCursor int))
(defun (string-back-resolve s start w k)
  (let more ((w w) (k k))
    (cond
      ((not (grapheme-back-wants? w)) w)
      ((string-cursor=? k start) (grapheme-back-sot w))
      (else
       (begin
         (def k2 (string-cursor-prev s k))
         (more (grapheme-back-more w (string-cursor-ref s k2)) k2))))))

;; The start of the cluster that ends at `c`, a cluster boundary of `s`.
(: (-> string StringCursor StringCursor))
(defun (string-cursor-prev-grapheme s c)
  (def start (string-cursor-start s))
  (when (string-cursor=? c start) (out-of-range "string-cursor-prev-grapheme: the cursor is at the start."))
  (def c1 (string-cursor-prev s c))
  (def b1 (string-cursor-ref s c1))
  (def w0 (if (and (grapheme-back-needs-after? b1) (not (string-cursor-end? s c)))
              (grapheme-back-start-before (string-cursor-ref s c))
              (grapheme-back-start)))
  ;; `bc` is the cursor of the earliest character of the cluster so far, `b`.
  (let go ((w w0) (bc c1) (b b1))
    (if (string-cursor=? bc start)
        bc
        (begin
          (def ac (string-cursor-prev s bc))
          (def a (string-cursor-ref s ac))
          (def w1 (grapheme-back-pair w a b))
          (def w2 (if (grapheme-back-wants? w1) (string-back-resolve s start w1 ac) w1))
          (if (grapheme-back-break? w2) bc (go w2 ac a))))))

;; Whether `c` is on a cluster boundary of `s`.
(: (-> string StringCursor bool))
(defun (string-cursor-grapheme-boundary? s c)
  (def start (string-cursor-start s))
  (if (or (string-cursor=? c start) (string-cursor-end? s c))
      #t
      (begin
        (def ac (string-cursor-prev s c))
        (grapheme-back-break?
          (string-back-resolve s start (grapheme-back-pair (grapheme-back-start) (string-cursor-ref s ac) (string-cursor-ref s c)) ac)))))

;; The clusters of `s`.
(: (-> string int))
(defun (string-grapheme-count s)
  (def c0 (string-cursor-start s))
  (if (string-cursor-end? s c0)
      0
      (begin
        (def (Tuple ch0 c1) (string-cursor-ref+next s c0))
        (let go ((st (grapheme-start ch0)) (c c1) (n 1))
          (if (string-cursor-end? s c)
              n
              (begin
                (def (Tuple ch nxt) (string-cursor-ref+next s c))
                (def st2 (grapheme-step st ch))
                (go st2 nxt (if (grapheme-break? st2) (+ n 1) n))))))))

;; The clusters of `s`, in order.
(: (-> string (Vec string)))
(defun (string->graphemes s)
  (let go ((c (string-cursor-start s)) (acc '()))
    (if (string-cursor-end? s c)
        (list->vec (list-reverse acc))
        (begin
          (def d (string-cursor-next-grapheme s c))
          (go d (cons (substring s c d) acc))))))
