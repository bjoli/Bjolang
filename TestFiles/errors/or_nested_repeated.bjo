;; An alternative of an `or` inside a tuple that an earlier one covers.

;; EXPECT-ERROR: this alternative can never run

(import (std prelude))

(: (-> (Tuple int int) int))
(defun (f t)
  (match t
    ((Tuple (or 1 1) _) 1)
    (_ 0)))

(defun (main args)
  (println (int->string (f (Tuple 1 2))))
  0)
