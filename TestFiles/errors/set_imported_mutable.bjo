;; A def/mutable is written only by the module that defines it. An importer
;; sees it, and its writes, but cannot assign it. The REPL is the exception:
;; its entries are modules of one session (repl/mutable_across_entries.in).

;; EXPECT-ERROR: only that module may write it

(import (std prelude))
(import "../inc/mutable_counter.bjo")

(defun (main args)
  (set! counter 3)
  (println (displayed counter))
  0)
