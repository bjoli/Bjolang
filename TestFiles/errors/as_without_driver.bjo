;; (:as ...) binds in a group of drivers. After a clause that is not a driver
;; there is no group to bind in, and a :let is what is meant.
;;
;; EXPECT-ERROR: (:as ...) at
;; EXPECT-ERROR: Here there is none before it: use (:let ...).

(defun (main args)
  (println (int->string {summing y (:for x (range 0 3)) (:let a 1) (:as y (+ x a))}))
  0)
