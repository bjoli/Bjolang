;; Phase one admits `(ret e)` as a statement or in tail position, and nowhere
;; else. As a proper subexpression it would have to interact with the hoisting
;; of statement-shaped operands, and would need a bottom type to have one at
;; all.

;; EXPECT-ERROR: may only appear as a statement or in tail position

(import (std prelude))

(: f (-> int int))
(defun (f n)
  (with-return ret
    (+ 1 (ret 2))))
