;; Two modules' names that C# spells alike, `a-b` and `asubb`, both reach this
;; one through a `using static`. A bare call was ambiguous to C# (CS0121), so
;; each is qualified with its module class.
(import (std prelude))
(import (std simpletest))
(import "inc/mangle_dash.bjo")
(import "inc/mangle_sub.bjo")

(defun (main)
  (expect "a-b is the one that adds" (a-b 1) 2)
  (expect "asubb is the one that multiplies" (asubb 1) 100)
  (expect "and a-b as a value" ((fun (f) (f 2)) a-b) 3)
  0)
