;; A bare name in a record pattern is a pun, so it has to be one of the fields.

;; EXPECT-ERROR: 'Car' has no field 'b'
;; EXPECT-ERROR: Its fields are: brand, year

(import (std prelude))

(type (: Car (Record (: brand string) (: year int))))

(: f (-> Car string))
(defun (f c)
  (match c
    ((Car b) b)))

(defun (main args)
  (println (f (Car (brand "a") (year 1))))
  0)
