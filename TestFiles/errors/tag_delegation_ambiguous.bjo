;; Two untagged cases carry unions that both have the tag `id`, so the literal
;; could be either one wrapped in its carrier. Refused, as two cases with one
;; tag are, rather than decided by declaration order.
;; EXPECT-ERROR: more than one of its cases carries a union that has it
(import (std prelude))

(type (: A (Union (AId int #:tag id))))
(type (: B (Union (BId int #:tag id))))
(type (: Both (Union (FromA A) (FromB B))))

(: f (-> Both int))
(defun (f b) 0)

(defun (main args)
  (f '(id 1)))
