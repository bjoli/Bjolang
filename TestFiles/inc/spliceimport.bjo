;; A macro that tries to introduce an import. See
;; `errors/spliced_import.bjo`, which is what happens to whoever calls it.
(import (std syntax-match))

(def/macro (def/importer form inject compare)
  (syntax-match form
    ((_ name)
     #'(begin
         (import (std maths))
         (: ,name (-> int))
         (defun (,name) 1)))
    (bad (syntax-error bad "def/importer takes one name."))))
