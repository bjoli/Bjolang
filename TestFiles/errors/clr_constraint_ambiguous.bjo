;; EXPECT-ERROR: nothing here says what type 'Ord' is needed at
;;
;; A constraint has to be discharged at a type, and `(list-empty)` never says
;; which one. Left alone the type variable reaches C# as `object`, which fails
;; there against the interface — a true report of a real problem, in the wrong
;; language.
(import (std prelude))

(defun (main)
  (displayln (int->string (list-length (list-sort (list-empty)))))
  0)
