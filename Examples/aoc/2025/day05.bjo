;; Day 5: Cafeteria. Part 1 counts the IDs on hand that some range covers;
;; part 2 counts every ID the ranges cover.
(import (std eq) (std scan) "common.bjo")

(defun (main args)
  (def lines (input-lines args))
  (def* (ranges {vecing (scan l '(long "-" long)) (:for l lines) (:finish (= l ""))})
        (ids {vecing (parse-long l) (:for l lines) (:when (not (or (= l "") (string-contains? l "-"))))}))
  (println {counting id :when (any? (fun ((lo . hi)) (and (<= lo id) (<= id hi))) ranges)
            (:for id ids)})
  ;; next is the first ID not yet counted.
  (println {summing (max 0L (- (+ hi 1L) (max lo next)))
            (:for (lo . hi) (vec-sort ranges))
            (:with next 0L (max next (+ hi 1L)))})
  0)
