;; EXPECT-ERROR: has to say which member of it to call
;;
;; There is no implementation to fall back on and no default body to inherit,
;; so a method of such a trait that names no member names nothing at all.
(import (std prelude))

(def/trait (Arith %a)
  (#:clr-constraint (System.Numerics.INumber %a))
  (: bare (-> %a %a)))

(defun (main) 0)
