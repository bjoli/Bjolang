;; A Roman numeral has no zeros to fill a width with, so (roman year) takes none.

;; EXPECT-ERROR: (roman ...): expected RomanNumber; found (year ...)

(import (std datetime))

(defun (main)
  (match (date 2026 10 25)
    ((Some d) (println (date->text d '((roman (year 4))))))
    (None (println "none")))
  0)
