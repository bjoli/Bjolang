;; A dot is a symbol character, so the tokenizer would accept this. It is
;; refused anyway: a dot is how a .NET member is spelled, and a name that looks
;; like one but is not would be read as such long before anybody suspected the
;; import.
;; EXPECT-ERROR: which is how a .NET member is spelled
(import (prefix (std prelude) "geom./"))

(defun (main) 0)
