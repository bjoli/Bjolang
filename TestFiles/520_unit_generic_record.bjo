;; A record generic over the whole number type holds a quantity of any unit:
;; (Vec2 (double m)), (Vec2 (double m/s)), (Vec2 int). The units of its fields
;; are checked against each other where it is built.
(import (std prelude))
(import (std simpletest))

(def/dimension length #:base m)
(def/dimension time #:base s)
(def/unit km <1000 m>)
(def/unit Hz <1 1/s>)

(type (: (Vec2 %a) (Record (: x %a) (: y %a))))

(: vadd (-> (Vec2 (num %c %u)) (Vec2 (num %c %u)) (Vec2 (num %c %u))) (where (Num %c)))
(defun (vadd a b) (Vec2 (x (+ (.x a) (.x b))) (y (+ (.y a) (.y b)))))

(: vscale (-> (Vec2 (double %u)) (double %v) (Vec2 (double %u %v))))
(defun (vscale a k) (Vec2 (x (* (.x a) k)) (y (* (.y a) k))))

(: pos (Vec2 (double m)))
(def pos (vadd (Vec2 (x <1 m>) (y <2 m>)) (Vec2 (x <1 km>) (y <3 m>))))

(defun (main)
  (expect "added in the base unit" (number-in (.x pos) m) 1001.0)
  (def v (vscale (Vec2 (x <2 m>) (y <4 m>)) <0.5 Hz>))
  (expect "scaled into a new unit" (number-in (.y v) m/s) 2.0)
  (expect "the same functions at unit 1" (written (vadd (Vec2 (x 1) (y 2)) (Vec2 (x 3) (y 4)))) "(Vec2 (x 4) (y 6))")
  0)
