;; The else body produces the value of the whole form, so it has to agree with
;; the rest of the body — and the rest of this one produces nothing.
;;
;; This is the mistake the old form invited and the new one has to explain: the
;; else body used to leave the enclosing block, so returning a value from it
;; made sense. Now it is the form's other arm, and an arm of a void body may
;; not produce a string.

;; EXPECT-ERROR: produces the value of the whole form

(import (std prelude))

(: f (-> (Option int) void))
(defun (f o)
  (def/else ((Some n) o)
    "a string, where the rest of the body gives nothing")
  (println (int->string n)))
