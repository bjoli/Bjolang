;; One instantiation of a unit-generic function takes one unit.

;; EXPECT-ERROR: Their units differ

(import (std prelude))

(: pick (-> (units double %u^1) (units double %u^1) (units double %u^1)))
(defun (pick a b) a)

(: bad (-> (units double m^1) (units double s^1) (units double m^1)))
(defun (bad a b) (pick a b))

(defun (main) 0)
