;; std/simpletest.bjo — basic test assertion module.

(export expect expect-true fail)

(import (std prelude))

;; Asserts equality and prints result.
(: expect (-> string %a %a void) (where (Eq %a) (->str %a)))
(defun (expect label actual wanted)
  (if (= actual wanted)
      (println #"ok: ${label}")
      (println #"FAILURE: ${label} gave ${actual} but wanted ${wanted}")))

;; Asserts boolean and prints result.
(: expect-true (-> string bool void))
(defun (expect-true label ok)
  (if ok
      (println #"ok: ${label}")
      (println #"FAILURE: ${label}")))

;; Marks a failing branch.
(: fail (-> string void))
(defun (fail label)
  (println #"FAILURE: ${label}"))
