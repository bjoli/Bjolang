;; A trait method that says both things about its colour.
;;
;; `-?->` on a parameter already says calling the method suspends exactly when
;; the callback does, and the twin derived from it is the half that suspends.
;; `-bjo->` on the method's own arrow says every implementation suspends
;; whatever it is handed. Together they leave the callback nothing to decide.

;; EXPECT-ERROR: declares 'apply-it' -bjo-> and gives it a -?-> parameter
;; EXPECT-ERROR: Write the method's own arrow ->

(import (std prelude))

(def/trait (Mapper %a)
  (: apply-it (-bjo-> %a (-?-> int int) int)))

(def/impl (Mapper int)
  (defbjo (apply-it x f) (f x)))

(defun (main args) 0)
