;; Raw strings, read twice: 263_raw_strings.bjo includes this file, so the
;; compiler reads it, and it is that program's standard input, so bjodat reads
;; it too. Each case is a label, a raw string, and what it should read as,
;; written as an escaped string.

(def raw-cases
  [["one line, with quotes in it" """say "hi" """ "say \"hi\" "]
   ["one line keeps its spaces" """  padded  """ "  padded  "]
   ["a backslash is a backslash" """C:\new\table""" "C:\\new\\table"]
   ["parentheses and a semicolon are text" """(not a list) ; not a comment""" "(not a list) ; not a comment"]
   ["four quotes hold three" """"has """ inside"""" "has \"\"\" inside"]
   ["the closing quotes set the margin"
    """
      first
        second
      """
    "first\n  second"]
   ["a blank line may be shorter than the margin"
    """
      a

      b
      """
    "a\n\nb"]
   ["a blank line longer than the margin keeps the rest"
    """
      a
        
      b
      """
    "a\n  \nb"]
   ["an empty last line is a final newline"
    """
      a

      """
    "a\n"]
   ["nothing between the quotes"
    """
    """
    ""]
   ["a margin of nothing"
"""
x
  y
"""
    "x\n  y"]
   ["quotes at the start of a line, fewer than close it"
    """
      ""quoted""
      """
    "\"\"quoted\"\""]
   ["spaces after the opening quotes"
    """   
      text
      """
    "text"]
   ["a tab margin"
	"""
			indented once
		"""
    "\tindented once"]
   ["trailing spaces are kept"
    """
      a   
      """
    "a   "]])
