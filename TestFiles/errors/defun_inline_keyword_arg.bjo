;; A keyword parameter has nowhere to write its type.
;;
;; The argument grammar gives a keyword parameter a *default expression*, not a
;; type, so a function taking one cannot describe itself at the definition. It
;; says so rather than producing a signature with a parameter missing from it.

;; EXPECT-ERROR: the keyword parameter '#:sep' has nowhere to write its type

(import (std prelude))

(defun (labelled (: n int) #:sep "-") : string
  (string-append sep (int->string n)))

(defun (main args)
  (println (labelled 1))
  0)
