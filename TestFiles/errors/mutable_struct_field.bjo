;; A `Struct` may not have a mutable field.
;;
;; A struct compiles to a C# `record struct`, which is a value type: it is
;; copied on assignment and on every parameter pass, and one held inside a
;; `List` or a `Map` cannot be addressed at all. A write would land on the copy
;; and be lost — silently, and with nothing in the type discipline able to
;; catch it — so the combination is refused at the declaration rather than
;; supported badly.

;; EXPECT-ERROR: a Struct may not have a mutable field
;; EXPECT-ERROR: Declare 'Point' as a Record instead

(import (std prelude))

(type
  (: Point (Struct (: x int) (: y int #:mutable))))

(defun (main args) 0)
