;; A case with the name of a record of the same module.
;;
;; A record is built by its name, as a case is, so in one module the two would
;; be one constructor. The record is declared first here; the other order is
;; `case_named_like_newtype.bjo`.

;; EXPECT-ERROR: has the name of the record Shape

(import (std prelude))

(type (: Shape (Record (: w int) (: h int))))
(type (: Figure (Union (: Shape int) Blank)))

(defun (main) 0)
