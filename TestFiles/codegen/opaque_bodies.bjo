;; The bodies an `#:opaque` type's module published are specialised here, as
;; any constrained generic's are. Each copy is emitted in this module, with the
;; type arguments in its name.

;; EXPECT-CS: doublesubcoin__at_
;; EXPECT-CS: sealedsubtag__at_
;; EXPECT-CS: coinsubweight__at_
;; EXPECT-CS: spansubticks__at_

;; The `HasSpan long` implementation is spliced, so its construction is emitted
;; here and not reached through the implementation's class.
;; EXPECT-CS: new BjoMod\.[A-Za-z0-9_]+\.sealed_box__Span\(System\.TimeSpan\.FromTicks
;; EXPECT-NO-CS: HasSpan_System_Int64\.Instance

(import (std prelude))
(import "../inc/sealed_box.bjo")
(import "../inc/origin_marks.bjo")

(: run (-> int))
(defun (run)
  (+ (double-coin 5)
     (sealed-tag 7)
     (coin-value (coin-weight "four"))))

(: ticks (-> long))
(defun (ticks) (span-ticks 42L))
