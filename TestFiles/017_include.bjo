;; `include` splices another file's top-level forms in at this position. The
;; included definitions land in *this* module, so unlike a source-level import
;; there is no second module for the code generator to drop.
(include "inc/greeting.bjo")

(defun (main args)
  ;; `describe` prints and hands its argument back, so the value here is
  ;; genuinely not wanted — and under §8.2 that has to be said out loud.
  ;; `ignore` comes from the `(std prelude)` import inside the *included* file,
  ;; which is a dependency of this module rather than of a second one.
  (ignore (describe 3))
  (println (square 5))
  0)
