;; What is left over has to be whole cases, since whole cases are what
;; `:propagate` rebuilds.
;;
;; A nested pattern leaves part of a case behind — `(Some 0)` here is left by
;; `(Some 1)`, and there is no constructor to build that with. The arms of
;; `:leave` can say what to do with it; a rebuild cannot.

;; EXPECT-ERROR: is not a set of cases

(import (std prelude))

(: f (-> (Option int) (Option int)))
(defun (f o)
  (def (Some 1) o :propagate)
  (Some 2))
