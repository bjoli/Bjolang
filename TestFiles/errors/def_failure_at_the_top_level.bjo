;; A failure part that leaves, on a top-level `def`: there is no body to leave.
;;
;; The same refusal covers a `def*` clause, which is read as the `def` it would
;; have been.

;; EXPECT-ERROR: the top level is not a body

(import (std prelude))

(: found (-> (Option int)))
(defun (found) (Some 1))

(def (Some n) (found) :leave-with 0)
