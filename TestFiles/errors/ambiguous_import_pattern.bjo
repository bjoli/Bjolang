;; EXPECT-ERROR: Pt is a case of same_a/Figure and same_b/Figure, and nothing here says which one this is
;; EXPECT-ERROR: Give the value matched a type
;;
;; A constructor in a pattern is a use too. `Pt` is a case of `same_a`'s
;; `Figure` and of `same_b`'s, both with one payload, and nothing says which
;; `Figure` `f` is. Where the value matched has a type, it decides:
;; `461_cases_of_one_name.bjo`.

(import (std prelude))
(import "../inc/same_a.bjo")
(import "../inc/same_b.bjo")

(defun (main)
  (defun (size f)
    (match f
      ((Pt n) 1)))
  0)
