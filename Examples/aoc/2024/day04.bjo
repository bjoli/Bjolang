;; Day 4: Ceres Search. Part 1 counts XMAS in all eight directions. Part 2
;; counts the crosses of two MAS on the diagonals of a 3x3 square.
(import "common.bjo")

(defun (main args)
  (def* (rows {vecing (string->vec l) (:for l (input-lines args))})
        (w (length (ref rows 0))) (h (length rows)))
  (defun (at x y) (if (and (< -1 x w) (< -1 y h)) (ref (ref rows y) x) #\.))
  (defun (xmas? x y dx dy)
    (loop (:for c "XMAS") (:with i 0 (+ i 1))
          (:acc ok (folding #t (and ok (char=? c (at (+ x (* i dx)) (+ y (* i dy)))))))
          (:finish (not ok))
          => ok))
  ;; Whether the diagonal through (x, y) reads MAS or SAM.
  (defun (mas? x y dx dy)
    (def* (a (at (- x dx) (- y dy))) (b (at (+ x dx) (+ y dy))))
    (or (and (char=? a #\M) (char=? b #\S)) (and (char=? a #\S) (char=? b #\M))))
  (println {counting x :when (xmas? x y dx dy)
            (:for y (range 0 h)) (:subloop) (:for x (range 0 w))
            (:subloop) (:for dy (range -1 2)) (:subloop) (:for dx (range -1 2))})
  (println {counting x :when (and (char=? (at x y) #\A) (mas? x y 1 1) (mas? x y 1 -1))
            (:for y (range 0 h)) (:subloop) (:for x (range 0 w))})
  0)
