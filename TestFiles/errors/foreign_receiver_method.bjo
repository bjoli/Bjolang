;; The receiver of an instance method is a value of the wrong type. The
;; arguments after it select the overload; the receiver is checked on its own.

;; EXPECT-ERROR: foreign_receiver_method.bjo:15:26
;; EXPECT-ERROR: the .NET type 'System.Exception' is wanted here

(import (std prelude))

(import/extern
  (ex-to-string (: System.Exception.ToString (-> Exception string))))

(type (: Thing (Union (: A string) B)))

(defun (main args)
  (println (ex-to-string (A "x")))
  0)
