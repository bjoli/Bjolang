;; std/prelude.bjo
;; Standard library entry point
;; Macros defined here CANNOT be used in this file.
(export
  ;; Types. A type crosses a module boundary only when it is named here, so
  ;; every type that appears in a signature below has to appear in this list
  ;; too — including the `import/class` aliases, which are types like any
  ;; other. A collector's type is here because its *constructor* is what an
  ;; `:acc` clause writes, and a constructor follows its type.
  Map MapBuilder TransientMap MapCursor
  Range
  Listing Vecing Mapping Stringing Summing Counting Folding
  TextInputPort TextOutputPort Exception

  ;; Foldable
  fold
  ;; Functor
  map
  ;; Iterable
  iterable-start iterable-done? iterable-current iterable-next
  ;; Cursor — a position, where Iterable is a walk
  cursor-start cursor-end cursor-end? cursor-ref cursor-next cursor-prev
  ;; Collector
  collector-init collector-step collector-finish
  ;; Collection
  length empty? ->seq
  ;; Discard — how a program says "computed, and deliberately not wanted"
  ignore
  ;; Range
  range range-by

  print println ->str list->str
  list-append

  ;; Maps. These were compiler builtins and so appeared in no export list; they
  ;; are ordinary bindings now, and every one of them has to be named here.
  map-empty map-ref map-ref-or map-try-ref
  map-set map-add map-set-all map-remove map-remove-all
  map-contains? map-has-key? map-length map-empty? map-clear
  map-keys map-values map-merge map-merge-with
  ;; Walking and rebuilding
  map-map map-map-values map-filter map-fold
  map-for-each map-iter map-any? map-find map-try-find
  ;; The cursor `Iterable` walks with
  map-cursor map-cursor-done? map-cursor-current
  ;; Conversions. `list->map` is what `#map(...)` reads as.
  list->map map->list vec->map map->vec seq->map map->seq
  map->str map-entry->str
  ;; Builders — the same shape as ListBuilder
  mapbuilder-empty map->mapbuilder mapbuilder-add! mapbuilder-add-all!
  mapbuilder-length mapbuilder->map
  ;; Transients — the map's interface, in place
  transientmap-empty map->transientmap transientmap->map
  transientmap-set! transientmap-set-all! transientmap-remove!
  transientmap-remove-all! transientmap-contains? transientmap-ref
  transientmap-ref-or transientmap-try-ref transientmap-length
  transientmap-empty? transientmap-filter!

  ;; Strings
  str string-append string-length
  string-contains? string-starts-with? string-ends-with? string-replace
  string-upcase string-downcase
  string-trim string-trim-start string-trim-end
  string-pad-left string-pad-right
  string-split string-join
  ;; Characters — R6RS §11.11. The classification and case procedures
  ;; (char-upcase, char-alphabetic?, digit-value, ...) are builtins and need no
  ;; export; these are the ones written in Bjolang.
  char->integer integer->char
  char=? char<? char>? char<=? char>=?
  char-ci=? char-ci<? char-ci>? char-ci<=? char-ci>=?
  ;; String cursors. The primitives are builtins; these are the derived ones.
  string-cursor=? string-cursor<? string-cursor>? string-cursor<=? string-cursor>=?
  string-fold string-fold-right string-for-each string-index
  string->list list->string string->vec string-reverse
  ;; Conversions
  int->string long->string double->string byte->string number->string
  string->int string->double
  ;; From `System.Math`; the rest of it is in `std/maths`.
  sqrt
  ;; Files
  file-read-text file-write-text file-append-text file-exists? file-delete
  ;; Paths
  path-absolute path-combine path-filename path-file-extension
  ;; Directories
  directory-exists? directory-create directory-delete directory-delete-tree
  directory-files directory-subdirectories
  ;; The environment
  get-environment-variable set-environment-variable!
  current-directory set-current-directory!
  ;; Ports — opening
  open-input-file open-input-string open-output-file open-output-string
  ;; Ports — closing
  close-input-port close-output-port flush-port
  ;; Ports — input
  port-eof? read-line read-line/opt read-char read-char/opt read-all port-fold
  ;; Ports — output
  write-string write-char writeln get-output-string)


(import/extern
  (clr-tostring (: System.Convert.ToString)))

;; First, and before the includes: `=` is a trait method now, and a call to one
;; is only recognized as such once the trait has been registered.
(import (std eq))
;; re-export ord and eq traits
(re-export = eq-hash
           compare less? greater? at-most? at-least?
           least greatest list-sort list-min list-max)

(include "Foldable.protobjo")


(: list-append (-> (List %a) (List %a) (List %a)))
(defun (list-append xs ys)
  (list-foldr Cons ys xs))

;; Type to String Trait
(def/trait (->str %a)
  (: ->str (-> %a string)))

(def/impl (->str %a)
  (defun (->str u)
    (clr-tostring (cast System.Object u))))

;; Implementations for standard scalars
(def/impl (->str string)
  (defun (->str s) s))

(def/impl (->str int)
  (defun (->str n) (int->string n)))

(def/impl (->str double)
  (defun (->str n) (double->string n)))

(def/impl (->str byte)
  (defun (->str n) (byte->string n)))

(def/impl (->str long)
  (defun (->str n) (long->string n)))

(def/impl (->str Keyword)
  (defun (->str k) (keyword->string k)))

(def/impl (->str Symbol)
  (defun (->str s) (symbol->string s)))


(def/impl (->str Char)
  (defun (->str c) (char->string c)))

;; Container formats require loops to work, so they go further down
;; after accumulation and iteration forms


;; ---------------------------------------------------------------------------
;; Discard
;; ---------------------------------------------------------------------------
;;
;; `(ignore x)` is how a program says "I computed this and I do not want it".
;; Under §8.2's must-use rule every value that is dropped has to say so, and
;; this is the saying: an ordinary function, greppable, usable in a pipeline,
;; with no lexer change and no sigil.
;;
;; It is a *trait* method rather than one function because some types need
;; behaviour at the discard site and not merely permission to vanish. The three
;; levels are:
;;
;;   no impl of its own — the blanket applies, and the value is dropped;
;;   an impl of its own — `ignore` runs it, as `Promise` does below;
;;   named in the compiler's no-discard set — `ignore` is an error, which is
;;   what `Result` is, since a discarded error has no defensible default.
;;   
(def/trait (Discard %a)
  (: ignore (-> %a void)))

(def/impl (Discard %a)
  (defun (ignore x) unit))

;; Level two. Dropping a promise loses any exception inside it silently: nothing
;; else is watching, so a fiber that died is simply never mentioned. `(ignore p)`
;; therefore means "detach deliberately", routing a failure to the scheduler's
;; unhandled hook — the only reading of "discard this promise" that is not a
;; quiet bug.
;; 
(def/impl (Discard (Promise %a))
  (defun (ignore p) (detach p)))

;; Generic display functions utilizing the ->str trait
(: print (-> %a void))
(defun (print x)
  (display (->str x)))

(: println (-> %a void))
(defun (println x)
  (displayln (->str x)))


;; ---------------------------------------------------------------------------
;; Map — the unordered map
;; ---------------------------------------------------------------------------
;;
;; A `(Map %k %v)` is a CHAMP trie keyed by hash: lookup, insertion and removal
;; are all effectively constant time, two maps share every subtree they have in
;; common, and a walk arrives in the trie's own order — which is to say, in no
;; order a program should rely on.
(import/class
  ((Map %k %v)          (: Map.Map))
  ((MapBuilder %k %v)   (: Map.MapBuilder))
  ((TransientMap %k %v) (: Map.TransientMap))
  ((MapCursor %k %v)    (: Map.MapCursor)))

(import/extern
  (map-empty      (: Map.MapModule.Empty       (-> (Map %k %v))))
  ;; Throws for a key that is not there. `map-try-ref` is the total one, and
  ;; `map-ref-or` the one with a default.
  (map-ref        (: Map.MapModule.Ref         (-> (Map %k %v) %k %v)))
  (map-ref-or     (: Map.MapModule.RefOr       (-> (Map %k %v) %k %v %v)))
  (map-set        (: Map.MapModule.Set         (-> (Map %k %v) %k %v (Map %k %v))))
  ;; The same, except that a key already there is an error rather than a
  ;; replacement.
  (map-add        (: Map.MapModule.Add         (-> (Map %k %v) %k %v (Map %k %v))))
  ;; Through a transient, so the trie is copied once rather than once per entry.
  (map-set-all    (: Map.MapModule.SetRange    (-> (Map %k %v) (Seq (Tuple %k %v)) (Map %k %v))))
  (map-remove     (: Map.MapModule.Remove      (-> (Map %k %v) %k (Map %k %v))))
  (map-remove-all (: Map.MapModule.RemoveRange (-> (Map %k %v) (Seq %k) (Map %k %v))))
  (map-contains?  (: Map.MapModule.ContainsKey (-> (Map %k %v) %k bool)))
  (map-length     (: Map.MapModule.Count       (-> (Map %k %v) int)))
  (map-empty?     (: Map.MapModule.IsEmpty     (-> (Map %k %v) bool)))
  (map-clear      (: Map.MapModule.Clear       (-> (Map %k %v) (Map %k %v))))
  (map-keys       (: Map.MapModule.Keys        (-> (Map %k %v) (Seq %k))))
  (map-values     (: Map.MapModule.Values      (-> (Map %k %v) (Seq %v))))
  ;; The right-hand map wins where both have a key. Cheap where the two have a
  ;; history in common: an untouched subtree is taken whole rather than walked.
  (map-merge      (: Map.MapModule.Merge       (-> (Map %k %v) (Map %k %v) (Map %k %v))))
  ;; The same, with the collisions decided by a function of the key, the value
  ;; already there and the one arriving.
  (map-merge-with (: Map.MapModule.MergeWith   (-> (-> %k %v %v %v) (Map %k %v) (Map %k %v) (Map %k %v))))

  (map-try-ref/pair (: Map.MapModule.TryGetValue (-> (Map %k %v) %k (Tuple bool %v))))

  ;; --- Walking ---
  ;;
  ;; Every callback takes the key and the value as *two* arguments, which is
  ;; what a walk of the trie has to hand over anyway.
  (map-map        (: Map.MapModule.Map       (-> (-> %k %v %w) (Map %k %v) (Map %k %w))))
  ;; The functor's map: the value moves and the key rides along.
  (map-map-values (: Map.MapModule.MapValues (-> (-> %v %w) (Map %k %v) (Map %k %w))))
  (map-filter     (: Map.MapModule.Filter    (-> (-> %k %v bool) (Map %k %v) (Map %k %v))))
  (map-fold       (: Map.MapModule.Fold      (-> (-> %s %k %v %s) %s (Map %k %v) %s)))
  ;; Walks until the predicate answers false, and reports whether it ran to the
  ;; end — the early-exit walk, and the one to reach for when the answer is
  ;; known before the entries run out.
  (map-iter       (: Map.MapModule.Iter      (-> (-> %k %v bool) (Map %k %v) bool)))
  (map-any?       (: Map.MapModule.Exists    (-> (-> %k %v bool) (Map %k %v) bool)))
  (map-try-find   (: Map.MapModule.TryFind   (-> (-> %k %v bool) (Map %k %v) (Tuple bool %k %v))))

  (seq->map (: Map.MapModule.FromEnumerable (-> (Seq (Tuple %k %v)) (Map %k %v))))
  (map->seq (: Map.MapModule.AsEnumerable   (-> (Map %k %v) (Seq (Tuple %k %v)))))

  ;; The cursor `Iterable` walks with. `done?` is what advances it, which the
  ;; protocol allows and which is what lets the walk allocate nothing per entry.
  (map-cursor         (: Map.MapModule.Cursor        (-> (Map %k %v) (MapCursor %k %v))))
  (map-cursor-done?   (: Map.MapModule.CursorDone    (-> (MapCursor %k %v) bool)))
  (map-cursor-current (: Map.MapModule.CursorCurrent (-> (MapCursor %k %v) (Tuple %k %v))))

  ;; --- Builders ---
  ;;
  ;; Appends land in a flat buffer and are scattered into the trie by hash in one
  ;; pass at the end, which beats inserting a key at a time by enough to be the
  ;; default way to build one. The mutators answer nothing: a builder is a class
  ;; that mutates in place and whose identity never changes, so handing the
  ;; reference back would buy nothing and cost a discard at every call site.
  (mapbuilder-empty    (: Map.MapBuilderModule.Empty    (-> (MapBuilder %k %v))))
  (map->mapbuilder     (: Map.MapBuilderModule.FromMap  (-> (Map %k %v) (MapBuilder %k %v))))
  (mapbuilder-add!     (: Map.MapBuilderModule.Add      (-> (MapBuilder %k %v) %k %v void)))
  (mapbuilder-add-all! (: Map.MapBuilderModule.AddRange (-> (MapBuilder %k %v) (Seq (Tuple %k %v)) void)))
  ;; Appends, not entries: a key appended twice is resolved when the map is
  ;; built, last one winning.
  (mapbuilder-length   (: Map.MapBuilderModule.Count    (-> (MapBuilder %k %v) int)))
  (mapbuilder->map     (: Map.MapBuilderModule.Build    (-> (MapBuilder %k %v) (Map %k %v))))

  ;; --- Transients ---
  (transientmap-empty       (: Map.TransientMapModule.Empty          (-> (TransientMap %k %v))))
  (map->transientmap        (: Map.TransientMapModule.FromPersistent (-> (Map %k %v) (TransientMap %k %v))))
  ;; The map as it stands. The transient stays usable and disowns what it handed
  ;; over, so a later write copies rather than corrupting the snapshot.
  (transientmap->map        (: Map.TransientMapModule.ToPersistent   (-> (TransientMap %k %v) (Map %k %v))))
  (transientmap-set!        (: Map.TransientMapModule.Set            (-> (TransientMap %k %v) %k %v void)))
  (transientmap-set-all!    (: Map.TransientMapModule.SetRange       (-> (TransientMap %k %v) (Seq (Tuple %k %v)) void)))
  (transientmap-remove!     (: Map.TransientMapModule.Remove         (-> (TransientMap %k %v) %k void)))
  (transientmap-remove-all! (: Map.TransientMapModule.RemoveRange    (-> (TransientMap %k %v) (Seq %k) void)))
  (transientmap-contains?   (: Map.TransientMapModule.ContainsKey    (-> (TransientMap %k %v) %k bool)))
  (transientmap-ref         (: Map.TransientMapModule.Ref            (-> (TransientMap %k %v) %k %v)))
  (transientmap-ref-or      (: Map.TransientMapModule.RefOr          (-> (TransientMap %k %v) %k %v %v)))
  (transientmap-length      (: Map.TransientMapModule.Count          (-> (TransientMap %k %v) int)))
  (transientmap-empty?      (: Map.TransientMapModule.IsEmpty        (-> (TransientMap %k %v) bool)))
  (transientmap-filter!     (: Map.TransientMapModule.FilterInPlace  (-> (-> %k %v bool) (TransientMap %k %v) void)))
  (transientmap-try-ref/pair (: Map.TransientMapModule.TryGetValue   (-> (TransientMap %k %v) %k (Tuple bool %v)))))

;; The value under `key`, or `None`. The `Option` is put on here because a
;; static C# method has no `Option` to hand back — the type is Bjolang's.
(: map-try-ref (-> (Map %k %v) %k (Option %v)))
(defun (map-try-ref m key)
  (def (found value) (map-try-ref/pair m key))
  (if found (Some value) None))

(: transientmap-try-ref (-> (TransientMap %k %v) %k (Option %v)))
(defun (transientmap-try-ref m key)
  (def (found value) (transientmap-try-ref/pair m key))
  (if found (Some value) None))


(: map-has-key? (-> (Map %k %v) %k bool))
(defun (map-has-key? m key) (map-contains? m key))

;; The first entry satisfying `pred`, as an `Option`. The entry is a pair here
;; because it is a *value* being handed back, not an argument list.
(: map-find (-> (-> %k %v bool) (Map %k %v) (Option (Tuple %k %v))))
(defun (map-find pred m)
  (def (found k v) (map-try-find pred m))
  (if found (Some (Tuple k v)) None))


(: map-for-each (-> (-> %k %v void) (Map %k %v) void))
(defun (map-for-each f m)
  (ignore (map-iter (fun (k v) (f k v) #t) m)))

;; to satisfy the interface, foldable on map has to take a Tuple
(def/impl (Foldable (Map %k %v))
  (type %item (Tuple %k %v))
  (defun (fold f acc col)
    (map-fold (fun (acc2 k v) (f acc2 (Tuple k v))) acc col)))

;; Two maps are equal when they hold the same entries.
;;
;; Keys are matched by *lookup*, so key equality here is the trie's, which is
;; .NET's; only the values go through `Eq %v`. That is the one place `=` is not
;; yet the single answer §0 asks for, and it closes when a type's `Equals` is
;; emitted as a call to its `Eq` implementation — after which the trie is asking
;; the same question this trait is.
(def/impl (Eq (Map %k %v))
  (where (Eq %k) (Eq %v))
  (defun (= a b)
    (and (= (map-length a) (map-length b))
         (map-iter (fun (k v)
                     (match (map-try-ref b k)
                       ((Some w) (= v w))
                       (None #f)))
                   a)))
  ;; Order-independent, because the trie's walk order is: xor commutes, so two
  ;; equal maps built by different routes still hash alike. Combination *within*
  ;; an entry does not commute, so a key and its value cannot swap places
  ;; unnoticed.
  ;;
  ;; The fold is `Map<TK, TV>`'s own, operation and seed both, so `eq-hash` and
  ;; `GetHashCode` answer the same number for one map rather than merely each
  ;; agreeing with itself.
  (defun (eq-hash m)
    (map-fold (fun (h k v) (bitwise-xor h (hash-combine (eq-hash k) (eq-hash v)))) 0 m)))

;; ---------------------------------------------------------------------------
;; Iterable
;; ---------------------------------------------------------------------------

;; First-order with two associated types, and an ordinary interface trait
;; rather than an inline-only one: it never returns a sequence at a new element
;; type, so there is no constructor variable to abstract over.
;;
;; Every method takes the sequence *and* the cursor.
;;
;; The protocol's contract:
;;   1. `done?` is called exactly once per iteration. Nothing peeks and nothing
;;      tests at both top and bottom, which is what lets `done?` be effectful.
;;   2. `current` is called only when the preceding `done?` returned false.
;;   3. The cursor is used linearly: never copied, stepped twice, or captured.
;;   4. `start` is called once per entry to the level owning the cursor.
;;   5. ->seq is just the lazy way of iterating through an iterable
(def/trait (Iterable %s)
  (type %elem)
  (type %cursor)
  (: iterable-start (-> %s %cursor))
  (: iterable-done? (-> %s %cursor bool))
  (: iterable-current (-> %s %cursor %elem))
  (: iterable-next (-> %s %cursor %cursor))
  (: ->seq (-> %s (Seq %elem)))

  (defun (->seq s)
    (seql (:for e s)
          (:yield e))))

(def/impl (Iterable (List %a))
  (type %elem %a)
  (type %cursor (List %a))
  (defun (iterable-start s) s)
  (defun (iterable-done? s c) (list-empty? c))
  (defun (iterable-current s c) (list-head c))
  (defun (iterable-next s c) (list-tail c)))

;; A Vec is a tree, so walking it by index pays O(log32 n) per element. Its
;; native enumerator descends once and then walks leaves, so the cursor is one
;; of those.
;; We re-use the cursor the c# library provides.
(def/impl (Iterable (Vec %a))
  (type %elem %a)
  (type %cursor (VecCursor %a))
  (defun (iterable-start s) (vec-cursor s))
  (defun (iterable-done? s c) (vec-cursor-done? c))
  (defun (iterable-current s c) (vec-cursor-current c))
  (defun (iterable-next s c) c))

(def/impl (Iterable (Array %a))
  (type %elem %a)
  (type %cursor int)
  (defun (iterable-start s) 0)
  (defun (iterable-done? s index) (= index (array-length s)))
  (defun (iterable-current s index) (array-ref s index))
  (defun (iterable-next s index) (+ index 1)))

;; A half-open range of ints. Its cursor is the number itself, so a loop over
;; one is `c = lo`, `c < hi`, `c += by` — a hand-written `for`.
;;
;; `by` must be positive: coping with both directions means testing the sign
;; every iteration, and counting down deserves its own sequence rather than a
;; branch in the common path.
(type (: Range (Struct (: lo int) (: hi int) (: by int))))

(: range (-> int int Range))
(defun (range lo hi)
  (Range (lo lo) (hi hi) (by 1)))

(: range-by (-> int int int Range))
(defun (range-by lo hi by)
  (Range (lo lo) (hi hi) (by by)))

(def/impl (Iterable Range)
  (type %elem int)
  (type %cursor int)
  (defun (iterable-start s) (record-ref s lo))
  (defun (iterable-done? s c) (>= c (record-ref s hi)))
  (defun (iterable-current s c) c)
  (defun (iterable-next s c) (+ c (record-ref s by))))

;; A Map's elements are its pairs, in the trie's own order.
(def/impl (Iterable (Map %k %v))
  (type %elem (Tuple %k %v))
  (type %cursor (MapCursor %k %v))
  (defun (iterable-start s) (map-cursor s))
  (defun (iterable-done? s c) (map-cursor-done? c))
  (defun (iterable-current s c) (map-cursor-current c))
  (defun (iterable-next s c) c))

;; A string's elements are its *characters*, so a walk yields one `char` per
;; codepoint and an astral character arrives whole rather than as two halves.
;; 
(def/impl (Iterable string)
  (type %elem char)
  (type %cursor StringCursor)
  (defun (iterable-start s) (string-cursor-start s))
  (defun (iterable-done? s c) (string-cursor-end? s c))
  (defun (iterable-current s c) (string-cursor-ref s c))
  (defun (iterable-next s c) (string-cursor-next s c)))



;; The Vec impl's shape, not the List impl's, and for a reason worth stating: a
;; `Seq` is an `IEnumerable`, which hands out enumerators and nothing else. It
;; has no tail. Making the cursor "the sequence minus what has been seen" meant
;; a fresh enumeration per element — quadratic, and it re-ran everything the
;; generator does on the way, so a `Seq` over a port read each line as many
;; times as it had predecessors.
;;
;; The cursor holds the enumerator instead, so a walk pulls each element once.
;; `start` makes a new one, which is what keeps a `Seq` re-enumerable: two
;; loops over the same sequence each get their own position and each run the
;; body from the beginning.
(def/impl (Iterable (Seq %a))
  (type %elem %a)
  (type %cursor (SeqCursor %a))
  (defun (iterable-start s) (seq-cursor s))
  (defun (iterable-done? s c) (seq-cursor-done? c))
  (defun (iterable-current s c) (seq-cursor-current c))
  (defun (iterable-next s c) c))

;; ---------------------------------------------------------------------------
;; Cursor
;; ---------------------------------------------------------------------------

;; A position, where `Iterable` is a walk. An `Iterable` cursor may be a live
;; enumerator, so it is used linearly; a `Cursor` is a value, and may be held,
;; compared, and stepped backwards.
(def/trait (Cursor %s)
  (type %elem)
  (type %cursor)
  (: cursor-start (-> %s %cursor))
  (: cursor-end (-> %s %cursor))
  (: cursor-end? (-> %s %cursor bool))
  (: cursor-ref (-> %s %cursor %elem))
  (: cursor-next (-> %s %cursor %cursor))
  (: cursor-prev (-> %s %cursor %cursor)))

(def/impl (Cursor string)
  (type %elem char)
  (type %cursor StringCursor)
  (defun (cursor-start s) (string-cursor-start s))
  (defun (cursor-end s) (string-cursor-end s))
  (defun (cursor-end? s c) (string-cursor-end? s c))
  (defun (cursor-ref s c) (string-cursor-ref s c))
  (defun (cursor-next s c) (string-cursor-next s c))
  (defun (cursor-prev s c) (string-cursor-prev s c)))

;; ---------------------------------------------------------------------------
;; Collector
;; ---------------------------------------------------------------------------

;; Also first-order with associated types, and it needs no bridge to a generic
;; path: `init`/`step`/`finish` pass and return values with no cursor aliasing.
(def/trait (Collector %c)
  (type %elem)
  (type %acc)
  (type %out)
  (: collector-init (-> %c %acc))
  (: collector-step (-> %c %acc %elem %acc))
  (: collector-finish (-> %c %acc %out)))

;; The stock collectors. Each one's *constructor* is the name written in an
;; `:acc` clause, which is what makes a new accumulator an ordinary impl rather
;; than a change to the compiler. The type parameter on `Listing` and
;; `Counting` is a phantom, pinning `%elem` and nothing else.

(type (: (Listing %a) (Union listing)))

;; Uses listbuilder. About 2x faster
(def/impl (Collector (Listing %a))
  (type %elem %a)
  (type %acc (ListBuilder %a))
  (type %out (List %a))
  (defun (collector-init c) (listbuilder-empty))
  (defun (collector-step c acc x) (listbuilder-add! acc x) acc)
  (defun (collector-finish c acc) (listbuilder->list acc)))

;; The same, into a Vec — what to reach for when the result is going to be
;; indexed rather than walked.
(type (: (Vecing %a) (Union vecing)))

(def/impl (Collector (Vecing %a))
  (type %elem %a)
  (type %acc (VecBuilder %a))
  (type %out (Vec %a))
  (defun (collector-init c) (vecbuilder-empty))
  (defun (collector-step c acc x) (vecbuilder-add! acc x) acc)
  (defun (collector-finish c acc) (vecbuilder->vec acc)))

;; Collects pairs into a Map. Its elements are `(Tuple key value)`, which is
;; exactly what iterating a Map yields — so
;; `(loop (:for kv m) (:acc out (mapping kv)))` copies one.
;;
;; `MapBuilder` appends into a flat buffer and sorts by hash once at the end,
;; which is a good deal faster than inserting into the trie a key at a time.
(type (: (Mapping %k %v) (Union mapping)))

(def/impl (Collector (Mapping %k %v))
  (type %elem (Tuple %k %v))
  (type %acc (MapBuilder %k %v))
  (type %out (Map %k %v))
  (defun (collector-init c) (mapbuilder-empty))
  (defun (collector-step c acc kv)
    (def (k v) kv)
    (mapbuilder-add! acc k v)
    acc)
  (defun (collector-finish c acc) (mapbuilder->map acc)))

;; Characters into a string, through one buffer. `string-append` in a loop
;; rebuilds the whole string per element and is quadratic.
(type (: Stringing (Union stringing)))

(def/impl (Collector Stringing)
  (type %elem char)
  (type %acc StringBuilder)
  (type %out string)
  (defun (collector-init c) (stringbuilder-empty))
  (defun (collector-step c acc x) (stringbuilder-add! acc x) acc)
  (defun (collector-finish c acc) (stringbuilder->string acc)))

(type (: Summing (Union summing)))

(def/impl (Collector Summing)
  (type %elem int)
  (type %acc int)
  (type %out int)
  (defun (collector-init c) 0)
  (defun (collector-step c acc x) (+ acc x))
  (defun (collector-finish c acc) acc))

(type (: (Counting %a) (Union counting)))

(def/impl (Collector (Counting %a))
  (type %elem %a)
  (type %acc int)
  (type %out int)
  (defun (collector-init c) 0)
  (defun (collector-step c acc x) (+ acc 1))
  (defun (collector-finish c acc) acc))

;; `folding` is the primitive the others could all be written in terms of: the
;; accumulator simply becomes the step expression's value. Its seed is a
;; *construction* argument, so it is written `(folding seed expr)`.
(type (: (Folding %a) (Union (folding %a))))

(def/impl (Collector (Folding %a))
  (type %elem %a)
  (type %acc %a)
  (type %out %a)
  (defun (collector-init c) (match c ((folding s) s)))
  (defun (collector-step c acc x) x)
  (defun (collector-finish c acc) acc))


(def/trait (Functor (%f %a))
  (: map (-> (-> %a %b) (%f %a)  (%f %b))))

(def/impl (Functor (List %a))
  (defun (map g xs) (list-map g xs))) 

(def/impl (Functor (Vec %a))
  (defun (map g v) (vec-map g v)))

;; `(Map %k %v)`'s abstracted argument is `%v`, so the functor moves values and
;; leaves keys alone. `map-map` will not serve: it hands over the key as well,
;; and a functor's `(-> %a %b)` has room for one element type.
(def/impl (Functor (Map %k %v))
  (defun (map g m)
    (map-map-values g m)))

(def/impl (Functor (Option %a))
  (defun (map g o)
    (match o ((Some v) (Some (g v))) (None None))))

;; `%e` is fixed by the impl, so the error rides along untouched.
(def/impl (Functor (Result %e %a))
  (defun (map g r)
    (match r ((Ok v) (Ok (g v))) ((Err e) (Err e)))))



;; ---------------------------------------------------------------------------
;; Conversions
;; ---------------------------------------------------------------------------
;; the loop form is probably the fastest way to iterate over a list
;; but this should be rewritten to use the iter versions over vec and
;; map for maximum speed

(: list->map (-> (List (Tuple %k %v)) (Map %k %v)))
(defun (list->map xs)
  (loop (:for kvp xs)
        (:acc map (mapping kvp))))

(: map->list (-> (Map %k %v) (List (Tuple %k %v))))
(defun (map->list m)
  (loop (:for kvp m)
        (:acc lst (listing kvp))))
(: vec->map (-> (Vec (Tuple %k %v)) (Map %k %v)))
(defun (vec->map v)
  (loop (:for kvp v)
        (:acc map (mapping kvp))))

(: map->vec (-> (Map %k %v) (Vec (Tuple %k %v))))
(defun (map->vec m)
  (loop (:for kvp m)
        (:acc v (vecing kvp))))





;; ---------------------------------------------------------------------------
;; Maths
;; ---------------------------------------------------------------------------

;; The rest of `System.Math` stays in `std/maths.bjo`; what is re-exported here
;; is `Num`, general enough that a program should not have to ask for it.

(import (std maths))

;; Remember: exporting one trait function exposes ALL functions.
(re-export abs sign min max clamp zero?)

;; `sqrt` is imported here rather than re-exported from `std/maths`, where the
;; rest of `System.Math` lives. It is an import alias, and `re-export` names
;; something in scope as a *binding* — an alias is not one. Exporting it from
;; the module that imports it is the same thing by a shorter route.
;;
;; `Math.Sqrt` is the one overload there is, so an integer argument widens to
;; it: `(sqrt 9)` is 3.0, the same conversion C# would perform, emitted as one.
(import/extern
  (sqrt (: System.Math.Sqrt)))

;; ---------------------------------------------------------------------------
;; Strings, conversions, files and paths
;; ---------------------------------------------------------------------------
;; The wrapper is not ceremony: an `import/extern` alias is an
;; overload set, which is not a value, so `(map int->string xs)` would not
;; compile if the name were the import. The signature also pins the overload
;; once here rather than at every call site.

;; --- Strings ---

(import/extern
  (clr-concat        (: System.String.Concat))
  (clr-parse-int     (: System.Int32.Parse))
  (clr-parse-double  (: System.Double.Parse)))

(: string-append (-> string string string))
(defun (string-append a b) (clr-concat a b))

;; Variadic concatenation, and what `#"a ${x} b"` expands to a call of.
(: str (-> #:rest string string))
(defun (str #:rest parts) (clr-concat parts))

;; `.Length` is a property, so there is no method to import — a one-line body
;; reading the member is the whole of it.
;;
;; **This counts storage units, not characters.**
(: string-length (-> string int))
(defun (string-length s) (.-Length s))

;; --- Searching and rewriting -----------------------------------------------
;;
;; Ordinal, explicitly: .NET's one-argument overloads compare by culture, which
;; makes the answer depend on the machine. Fold the case first for an
;; insensitive answer.
;;
;; None of the `char`-taking overloads is wrapped — a Bjolang `char` is a
;; codepoint and a C# `char` a UTF-16 code unit. `(char->string c)` crosses.

(import/extern
  (clr-ordinal (: System.StringComparison.Ordinal #:get)))

(: string-contains? (-> string string bool))
(defun (string-contains? s needle) (.Contains s needle clr-ordinal))

(: string-starts-with? (-> string string bool))
(defun (string-starts-with? s prefix) (.StartsWith s prefix clr-ordinal))

(: string-ends-with? (-> string string bool))
(defun (string-ends-with? s suffix) (.EndsWith s suffix clr-ordinal))

;; Every occurrence. Replacing with `""` deletes.
(: string-replace (-> string string string string))
(defun (string-replace s old new) (.Replace s old new clr-ordinal))

;; --- Case ------------------------------------------------------------------
;;
;; Invariant, for the reason `char-upcase` is, and character for character: ß
;; upcases to itself rather than to SS. For normalising before a comparison,
;; not for presenting text to a reader.
(: string-upcase (-> string string))
(defun (string-upcase s) (.ToUpperInvariant s))

(: string-downcase (-> string string))
(defun (string-downcase s) (.ToLowerInvariant s))

;; --- Trimming and padding --------------------------------------------------
;;
;; Whitespace only, by `char-whitespace?`'s definition: a "trim these
;; characters" form is `params char[]`, which is unreachable from here.
(: string-trim (-> string string))
(defun (string-trim s) (.Trim s))

(: string-trim-start (-> string string))
(defun (string-trim-start s) (.TrimStart s))

(: string-trim-end (-> string string))
(defun (string-trim-end s) (.TrimEnd s))

;; To `width` *characters* — `string-count`'s count, not `string-length`'s —
;; with `#:with`, which defaults to a space. Never truncates.
;;
;; `.PadLeft` is not what these call: it counts storage units and its pad is a
;; UTF-16 code unit, so neither an astral character in `s` nor an astral pad
;; would come out at the width that was asked for.
(: string-pad-left (-> string int (#:with char) string))
(defun (string-pad-left s width #:with #\space)
  (let ((b (stringbuilder-empty)))
    (string-pad-fill! b with (- width (string-count s)))
    (stringbuilder-add-string! b s)
    (stringbuilder->string b)))

(: string-pad-right (-> string int (#:with char) string))
(defun (string-pad-right s width #:with #\space)
  (let ((b (stringbuilder-empty)))
    (stringbuilder-add-string! b s)
    (string-pad-fill! b with (- width (string-count s)))
    (stringbuilder->string b)))

;; `n` copies of `c`, and nothing at all when `n` is not positive — which is
;; the "never truncates" half of the two above.
(: string-pad-fill! (-> StringBuilder char int void))
(defun (string-pad-fill! b c n)
  (let fill ((i 0))
    (when (< i n)
      (stringbuilder-add! b c)
      (fill (+ i 1)))))

;; --- Splitting and joining -------------------------------------------------

;; Empty fields are kept, which is what makes splitting and joining inverses.
;; Drop them with `(vec-filter #(not (string-empty? &1)) parts)`.
(import/extern
  (clr-keep-empty-fields (: System.StringSplitOptions.None #:get)))

;; A `Vec` rather than the `(Array %a)` .NET answers with: an array is
;; `Iterable` and nothing more, so it can be walked and not measured or mapped.
(: string-split (-> string string (Vec string)))
(defun (string-split s sep)
  (loop (:for field (.Split s sep clr-keep-empty-fields))
        (:acc fields (vecing field))))

(: string-join (-> (Vec string) string string))
(defun (string-join parts sep)
  (let ((b (stringbuilder-empty)))
    (loop (:with first? #t #f)
          (:for part parts)
          (:do (unless first? (stringbuilder-add-string! b sep))
               (stringbuilder-add-string! b part)))
    (stringbuilder->string b)))

;; --- Conversions ---
;;
;; `ToString` is an instance method on each of the numeric types, and interop
;; resolves it against the argument's own type, so these are four bodies rather
;; than one overload set.

(: int->string (-> int string))
(defun (int->string n) (.ToString n))

(: long->string (-> long string))
(defun (long->string n) (.ToString n))

(: double->string (-> double string))
(defun (double->string n) (.ToString n))

(: byte->string (-> byte string))
(defun (byte->string n) (.ToString n))

;; `number->string` is declared over `int`, so it is the same operation as
;; `int->string` and is kept as the name R7RS programs reach for.
(: number->string (-> int string))
(defun (number->string n) (int->string n))

(: string->int (-> string int))
(defun (string->int s) (clr-parse-int s))

(: string->double (-> string double))
(defun (string->double s) (clr-parse-double s))

;; ---------------------------------------------------------------------------
;; Characters
;; ---------------------------------------------------------------------------
;;
;; R6RS §11.11, over Unicode scalar values rather than UTF-16 code units. Every
;; predicate asks about a *codepoint*, so an astral character gets a real answer
;; instead of whatever its leading surrogate would have said — which is the bug
;; `char.IsLetter` on a C# char produces, silently, only for text outside the
;; BMP, and therefore only in production.
;;
;; The classification and case procedures are builtins: interop cannot resolve a
;; method on a `BjoChar`, which is not a type Bjolang can name. What is written
;; here is the part that needs no help — the comparisons, which are the ordinary
;; operators at `char`, and the case-insensitive family, which is a fold
;; followed by one of them.
;; 
;; R6RS's spelling of the conversions. The same operations as `char->int` and
;; `int->char`, kept under both names for the reason `number->string` is: a
;; program ported from Scheme should not have to be rewritten to compile.
(: char->integer (-> char int))
(defun (char->integer c) (char->int c))

(: integer->char (-> int char))
(defun (integer->char n) (int->char n))

;; Ordering is by codepoint, and `<` at `char` *is* the C# operator on the
;; underlying value — so these are aliases rather than implementations.
;;
;; They are binary, where R6RS's are n-ary. The chaining `(< a b c)` is done
;; by the parser
(: char=? (-> char char bool))
(defun (char=? a b) (= a b))

(: char<? (-> char char bool))
(defun (char<? a b) (< a b))

(: char>? (-> char char bool))
(defun (char>? a b) (> a b))

(: char<=? (-> char char bool))
(defun (char<=? a b) (<= a b))

(: char>=? (-> char char bool))
(defun (char>=? a b) (>= a b))

;; Case-insensitive comparison, by folding both sides first. `char-foldcase`
;; rather than `char-downcase`: folding is the operation defined for comparing,
;; and the two differ for exactly the characters that make it matter.
(: char-ci=? (-> char char bool))
(defun (char-ci=? a b) (= (char-foldcase a) (char-foldcase b)))

(: char-ci<? (-> char char bool))
(defun (char-ci<? a b) (< (char-foldcase a) (char-foldcase b)))

(: char-ci>? (-> char char bool))
(defun (char-ci>? a b) (> (char-foldcase a) (char-foldcase b)))

(: char-ci<=? (-> char char bool))
(defun (char-ci<=? a b) (<= (char-foldcase a) (char-foldcase b)))

(: char-ci>=? (-> char char bool))
(defun (char-ci>=? a b) (>= (char-foldcase a) (char-foldcase b)))

;; ---------------------------------------------------------------------------
;; String cursors
;; ---------------------------------------------------------------------------
;;
;; A cursor is a position in a string, and it is what replaces the `string-ref`
;; this language deliberately does not have. In the future we might switch to utf8
;; to gain memory efficiency and speed, but doing that automatically invalidates a
;; string-ref api.
(: string-cursor=? (-> StringCursor StringCursor bool))
(defun (string-cursor=? a b) (= a b))

(: string-cursor<? (-> StringCursor StringCursor bool))
(defun (string-cursor<? a b) (< a b))

(: string-cursor>? (-> StringCursor StringCursor bool))
(defun (string-cursor>? a b) (> a b))

(: string-cursor<=? (-> StringCursor StringCursor bool))
(defun (string-cursor<=? a b) (<= a b))

(: string-cursor>=? (-> StringCursor StringCursor bool))
(defun (string-cursor>=? a b) (>= a b))

;; --- Traversal -------------------------------------------------------------

;; Left fold: the folder takes the accumulator first, as everywhere else in this
;; library. One pass, no allocation beyond whatever the folder does itself.
(: string-fold (-> (-> %a char %a) %a string %a))
(defun (string-fold f init s)
  (let loop ((c (string-cursor-start s)) (acc init))
    (if (string-cursor-end? s c)
        acc
        (loop (string-cursor-next s c) (f acc (string-cursor-ref s c))))))

;; Right fold, with the element first — the same argument order `list-foldr`
;; takes, for the same reason.
;;
;; Walking backwards rather than recursing forwards: `string-cursor-prev`
;; decodes one character backwards in constant time, so this stays a loop and
;; costs no stack, where the natural recursive spelling would be O(n) frames
;; deep in a string of n characters.
(: string-fold-right (-> (-> char %a %a) %a string %a))
(defun (string-fold-right f init s)
  (let loop ((c (string-cursor-end s)) (acc init))
    (if (string-cursor=? c (string-cursor-start s))
        acc
        (let ((p (string-cursor-prev s c)))
          (loop p (f (string-cursor-ref s p) acc))))))

(: string-for-each (-> (-> char void) string void))
(defun (string-for-each f s)
  (let loop ((c (string-cursor-start s)))
    (unless (string-cursor-end? s c)
      (f (string-cursor-ref s c))
      (loop (string-cursor-next s c)))))

;; The first character satisfying `pred`, as a cursor — `None` if there is none.
(: string-index (-> (-> char bool) string (Option StringCursor)))
(defun (string-index pred s)
  (let loop ((c (string-cursor-start s)))
    (if (string-cursor-end? s c)
        None
        (if (pred (string-cursor-ref s c))
            (Some c)
            (loop (string-cursor-next s c))))))

;; --- Conversions -----------------------------------------------------------

(: string->list (-> string (List char)))
(defun (string->list s)
  (string-fold-right cons Nil s))

(: list->string (-> (List char) string))
(defun (list->string cs)
  (let ((b (stringbuilder-empty)))
    (list-for-each #(stringbuilder-add! b &1) cs)
    (stringbuilder->string b)))

(: string->vec (-> string (Vec char)))
(defun (string->vec s)
  (let ((b (vecbuilder-empty)))
    (string-for-each #(vecbuilder-add! b &1) s)
    (vecbuilder->vec b)))

;; Reversing by character, so a string ending in an astral character comes back
;; with that character intact rather than with its two halves swapped.
(: string-reverse (-> string string))
(defun (string-reverse s)
  (let ((b (stringbuilder-empty)))
    (let loop ((c (string-cursor-end s)))
      (unless (string-cursor=? c (string-cursor-start s))
        (let ((p (string-cursor-prev s c)))
          (stringbuilder-add! b (string-cursor-ref s p))
          (loop p))))
    (stringbuilder->string b)))

;; A string folds over its characters, so `fold` from `Foldable` and the
;; `string-fold` above are the same operation under the trait.
(def/impl (Foldable string)
  (type %item char)
  (defun (fold f acc col)
    (string-fold f acc col)))

;; --- Files ---
;;
;; Whole-file operations, for when the contents fit in memory. The ports below
;; are where to go when they do not.
;;
;; None returns a `Result`: they throw as the .NET methods do, and a caller who
;; wants a value wraps the call in `try`. The port openers take the other route
;; and return a `Result` directly.

;; The three that move contents are `#:blocking`: each waits on however much
;; text the file holds, and does it on the thread that called. That changes
;; nothing about the emitted call — it is what lets the blocking lint say which
;; bjoroutines end up holding a pool thread here.
;;
;; `Exists` and `Delete` are not marked. They ask the filesystem about a name
;; rather than waiting on contents, and marking every call that touches a disk
;; would make the lint report everything and so report nothing.
(import/extern
  (clr-read-all-text   (: System.IO.File.ReadAllText   #:blocking))
  (clr-write-all-text  (: System.IO.File.WriteAllText  #:blocking))
  (clr-append-all-text (: System.IO.File.AppendAllText #:blocking))
  (clr-file-exists     (: System.IO.File.Exists))
  (clr-file-delete     (: System.IO.File.Delete)))

(: file-read-text (-> string string))
(defun (file-read-text path) (clr-read-all-text path))

;; Truncates the file if it is already there.
(: file-write-text (-> string string void))
(defun (file-write-text path contents) (clr-write-all-text path contents))

(: file-append-text (-> string string void))
(defun (file-append-text path contents) (clr-append-all-text path contents))

(: file-exists? (-> string bool))
(defun (file-exists? path) (clr-file-exists path))

(: file-delete (-> string void))
(defun (file-delete path) (clr-file-delete path))

;; --- Paths ---
;;
;; Textual operations on path strings: none of them touches the file system.
;;
;; The three that can come up empty answer `(Option string)`. .NET reports "no
;; filename here" and "no extension" as `""`, and a root's directory as `null`,
;; and neither is a path — an empty string used as one names the working
;; directory, which is a different place from nowhere.
;;
;; `path-directory` is *not* here: it is the `null` case, and absorbing that
;; needs the boundary code in the runtime.

(import/extern
  (clr-full-path      (: System.IO.Path.GetFullPath))
  (clr-path-combine   (: System.IO.Path.Combine))
  (clr-file-name      (: System.IO.Path.GetFileName))
  (clr-file-extension (: System.IO.Path.GetExtension)))

(: path-absolute (-> string string))
(defun (path-absolute path) (clr-full-path path))

;; Variadic, and the array a `#:rest` parameter collects is handed straight to
;; `Path.Combine(params string[])` — the same call C# would make.
(: path-combine (-> #:rest string string))
(defun (path-combine #:rest parts) (clr-path-combine parts))

;; `None` for a path that ends in a separator, which names a directory.
(: path-filename (-> string (Option string)))
(defun (path-filename path)
  (let ((name (clr-file-name path)))
    (if (string-empty? name) None (Some name))))

;; The extension including its dot. A name that is nothing but a dotted suffix
;; — `.bashrc` — counts as one, as it does to .NET.
(: path-file-extension (-> string (Option string)))
(defun (path-file-extension path)
  (let ((ext (clr-file-extension path)))
    (if (string-empty? ext) None (Some ext))))

;; --- Directories ---
;;
;; They throw as the file operations above do; wrap a call in `try` for a
;; `Result`. Listing is eager and gives whole paths — `EnumerateFiles` answers
;; an `IEnumerable<string>`, which interop cannot equate with `(Seq string)`.
;; There is no pattern argument: filter the `Vec`.

(import/extern
  (clr-dir-exists  (: System.IO.Directory.Exists))
  (clr-dir-create  (: System.IO.Directory.CreateDirectory))
  (clr-dir-delete  (: System.IO.Directory.Delete))
  (clr-dir-files   (: System.IO.Directory.GetFiles))
  (clr-dir-subdirs (: System.IO.Directory.GetDirectories)))

(: directory-exists? (-> string bool))
(defun (directory-exists? path) (clr-dir-exists path))

;; Creates every missing directory along the path, and does nothing if it is
;; already there — so it needs no guard, which would be a race anyway. The
;; `DirectoryInfo` it answers is of no use here.
(: directory-create (-> string void))
(defun (directory-create path) (ignore (clr-dir-create path)))

;; An *empty* directory. Deleting a tree is spelled differently because it is
;; not a mistake anything can undo.
(: directory-delete (-> string void))
(defun (directory-delete path) (clr-dir-delete path))

(: directory-delete-tree (-> string void))
(defun (directory-delete-tree path) (clr-dir-delete path #t))

;; Directly in `path`, not in its subdirectories.
(: directory-files (-> string (Vec string)))
(defun (directory-files path)
  (loop (:for file (clr-dir-files path))
        (:acc files (vecing file))))

(: directory-subdirectories (-> string (Vec string)))
(defun (directory-subdirectories path)
  (loop (:for dir (clr-dir-subdirs path))
        (:acc dirs (vecing dir))))

;; --- The environment ---
;;
;; A variable that is not set is `None` rather than the empty string .NET's
;; `null` arrives as. It cannot tell "unset" from "set to nothing": the test
;; available here is `IsNullOrEmpty`, there being no `null` to compare against.
;;
;; The working directory is a procedure rather than a value because it is
;; process-wide mutable state.

(import/extern
  (clr-get-env      (: System.Environment.GetEnvironmentVariable))
  (clr-set-env      (: System.Environment.SetEnvironmentVariable))
  (clr-empty?       (: System.String.IsNullOrEmpty))
  (clr-cwd          (: System.Environment.CurrentDirectory #:get))
  (clr-set-cwd      (: System.Environment.CurrentDirectory #:set)))

(: get-environment-variable (-> string (Option string)))
(defun (get-environment-variable name)
  (let ((value (clr-get-env name)))
    (if (clr-empty? value)
        None
        (Some value))))

;; For this process and its children, not for the shell that started it.
;; Setting a variable to the empty string removes it.
(: set-environment-variable! (-> string string void))
(defun (set-environment-variable! name value) (clr-set-env name value))

(: current-directory (-> string))
(defun (current-directory) clr-cwd)

(: set-current-directory! (-> string void))
(defun (set-current-directory! path) (clr-set-cwd path))

;; ---------------------------------------------------------------------------
;; Ports
;; ---------------------------------------------------------------------------
;;
;; `ports-spec.md` carries the argument; these are the decisions it reached.
;;
;; - **A port is the .NET object.** `TextReader` already abstracts over file,
;;   string and console, so it is imported *as* `TextInputPort`. `with-open`
;;   then works unchanged, and `peek` needs no pushback buffer.
;; - **Concrete readers are `cast` inside `open-*`.** HM has no subtyping, so a
;;   `StreamReader` will not unify with `TextInputPort`; casting at the door is
;;   what makes a file port and a string port one type to every caller.
;; - **Input, output, text and binary are separate types.** Reading a byte from
;;   a textual port is a type error here rather than R7RS's runtime surprise,
;;   which is why `input-port?` and friends do not exist.
;; - **Opening returns `Result`; operating throws.** A missing file is expected;
;;   a device error mid-stream is not, and threading `Result` through every read
;;   would poison the API for a case nobody handles.
;; - **The base API fails, the `/opt` variants do not.** `read-line` throws at
;;   end of input, guarded by `port-eof?`; `read-line/opt` is for when the check
;;   and the read want to be one step.
;;
;; A port is as much a part of the language as `print` is, so the API a program
;; opens, reads and writes with lives here. What stayed in `std/ports` is the
;; part parameterised by a reader procedure — `port->list`, `port->vec`,
;; `port->seq` and `file->seq` — which is a library, not a vocabulary.

(import/class
  ;; The port types themselves: abstract, so no constructor.
  (TextReader (: System.IO.TextReader))
  (TextWriter (: System.IO.TextWriter))

  ;; The concrete readers and writers, upcast into the above by `open-*`.
  ;; Only the listed exceptions become values; anything else keeps unwinding,
  ;; which is the point — an exception nobody named is a bug, not a result.
  (StreamReader (: System.IO.StreamReader (-> string StreamReader)
                   #:exceptions (System.IO.FileNotFoundException
                                  System.IO.DirectoryNotFoundException
                                  System.UnauthorizedAccessException)))
  (StringReader (: System.IO.StringReader (-> string StringReader)))
  (StreamWriter (: System.IO.StreamWriter (-> string StreamWriter)
                   #:exceptions (System.IO.DirectoryNotFoundException
                                  System.UnauthorizedAccessException)))
  ;; Writes into a buffer of its own, so it takes nothing and cannot fail.
  (StringWriter (: System.IO.StringWriter (-> StringWriter)))

  ;; The buffered pair, wrapped around a file's reader and writer by `open-*`.
  ;;
  ;; A `BjoPort` owns the characters it has read, which is what lets it answer
  ;; `port-eof?` without a syscall — `Peek` is "read one and put it back", and
  ;; the read is the part that waits. Owning the buffer is also what lets the
  ;; port have suspending reads at all: `TextReader` has no async peek, and
  ;; there is no adding one from outside.
  ;;
  ;; Both are ordinary `TextReader`/`TextWriter` subclasses, so nothing in the
  ;; type surface below moves.
  (BjoPort (: Bjolang.Runtime.BjoPort (-> TextReader BjoPort)))
  (BjoWriter (: Bjolang.Runtime.BjoWriter (-> TextWriter BjoWriter)))

  (Exception (: System.Exception)))

;; The port types, under exported names: an `import/class` alias is
;; module-local, so callers could not write the type. Spelled as the .NET name
;; rather than the alias above, because an exported alias serializes to
;; whatever it points at — pointing it at a module-local alias would export a
;; name the caller cannot resolve either.
(type
  (: TextInputPort System.IO.TextReader)
  (: TextOutputPort System.IO.TextWriter))

;; --- Opening ---

;; Open a file for text input. `Err` carries the .NET exception, so an arm may
;; tell one failure from another with `(:is System.IO.FileNotFoundException e)`.
;;
;; The reader is wrapped in a `BjoPort`, which is what gives a file port a
;; buffer of its own and so an eof question that usually costs nothing.
;;
;; **The open itself still blocks.** `StreamReader.` opens synchronously and
;; .NET has no async constructor — `FileOptions.Asynchronous` affects reads, not
;; the open. So this is one call that parks wherever it is made; everything
;; done to the port afterwards need not.
(: open-input-file (-> string (Result Exception TextInputPort)))
(defun (open-input-file path)
  (match (StreamReader. path)
    ((Ok r) (Ok (cast TextInputPort (BjoPort. (cast TextInputPort r)))))
    ((Err e) (Err e))))

;; A string as an input port. Cannot fail, so no `Result` — the asymmetry with
;; `open-input-file` is the honest one.
;;
;; Deliberately *not* wrapped: the text is already in memory, so there is
;; nothing for a buffer to save and nothing for a read to wait on. A string
;; port takes the ordinary path and pays neither a copy nor an allocation for
;; a suspension that could never happen.
(: open-input-string (-> string TextInputPort))
(defun (open-input-string contents)
  (cast TextInputPort (StringReader. contents)))

;; Open a file for text output, truncating it if it exists.
(: open-output-file (-> string (Result Exception TextOutputPort)))
(defun (open-output-file path)
  (match (StreamWriter. path)
    ((Ok w) (Ok (cast TextOutputPort (BjoWriter. (cast TextOutputPort w)))))
    ((Err e) (Err e))))

;; A port that collects what is written to it, to be asked for with
;; `get-output-string`. The output counterpart of `open-input-string`, and it
;; cannot fail for the same reason: there is nothing outside the process to go
;; wrong with.
;;
;; It is a `TextOutputPort` like any other, which is the whole point — a
;; procedure that writes to a port does not learn where the text is going.
;;
;; Unwrapped, for the reason `open-input-string` is: a buffer in front of a
;; writer that is already a buffer buys nothing. It is also what
;; `get-output-string` needs — it asks the port for the text it accumulated,
;; and only a `StringWriter` has any.
(: open-output-string (-> TextOutputPort))
(defun (open-output-string)
  (cast TextOutputPort (StringWriter.)))

;; --- Closing ---

;; Rarely needed: `with-open` disposes a port however the body ends.
;;
;; Two functions rather than one `close-port`, because `.Dispose` needs a
;; concrete receiver and HM has no bound for "any port". Typing it
;; `System.IDisposable` only moves the cast to every call site.
(: close-input-port (-> TextInputPort void))
(defun (close-input-port p) (.Dispose p))

(: close-output-port (-> TextOutputPort void))
(defun (close-output-port p) (.Dispose p))

;; A leaf, and the only one on the writing side: a write goes into a buffer and
;; is a memory copy whatever colour it is made in, so the syscall — and so the
;; wait — is here.
(import/extern
  (clr-flush       (: Bjolang.Runtime.BjoWriter.FlushPort      (-> TextOutputPort void) #:blocking))
  (clr-flush-await (: Bjolang.Runtime.BjoWriter.FlushPortAsync (-> TextOutputPort void) #:async)))

(: flush-port (-> TextOutputPort void))
(defbjouble (flush-port p)
  (#:sync (clr-flush p))
  (#:bjo  (clr-flush-await p)))

;; --- Input ---

;; --- The leaves ---
;;
;; These four are the *only* procedures here written twice, and the reason is
;; specific to each: its two colours call different .NET methods, which is the
;; one thing no inference derives. `TextReader` has `Peek` and has no async
;; peek — that is not an oversight in .NET, because eof on a stream is a read —
;; so the suspending answer is a different method on a different type.
;;
;; Everything above them is an ordinary `defun`, written once. `read-line/opt`,
;; `port-fold`, `port->list` and the rest say nothing about colour and never
;; will.
;;
;; **Both bodies of each pair agree on failure.** `read-line` throws at end of
;; input in both; `port-eof?` answers `true` in both and never raises;
;; `read-all` answers `""` in both. Nothing checks that — no compiler compares
;; what two different .NET methods do when they fail — so it is a promise made
;; here and kept.
;;
;; The sync halves are `#:blocking`: each waits on the thread it is called on,
;; which is exactly true and is what lets the lint report a bjoroutine that
;; reaches one through a `defun` that has no suspending copy yet.
(import/extern
  (clr-eof        (: Bjolang.Runtime.BjoPort.PortEof            (-> TextInputPort bool)   #:blocking))
  (clr-eof-await  (: Bjolang.Runtime.BjoPort.PortEofAsync       (-> TextInputPort bool)   #:async))
  (clr-line       (: Bjolang.Runtime.BjoPort.ReadLineOrThrow    (-> TextInputPort string) #:blocking))
  (clr-line-await (: Bjolang.Runtime.BjoPort.ReadLineOrThrowAsync (-> TextInputPort string) #:async))
  (clr-char       (: Bjolang.Runtime.BjoPort.ReadCharOrThrow    (-> TextInputPort char)   #:blocking))
  (clr-char-await (: Bjolang.Runtime.BjoPort.ReadCharOrThrowAsync (-> TextInputPort char) #:async))
  (clr-rest       (: Bjolang.Runtime.BjoPort.ReadRest           (-> TextInputPort string) #:blocking))
  (clr-rest-await (: Bjolang.Runtime.BjoPort.ReadRestAsync      (-> TextInputPort string) #:async)))

;; Whether the port has no more input.
;;
;; Free whenever the port has anything buffered, which reading a line at a time
;; is all but one call in a bufferful — that is what `BjoPort` is for.
(: port-eof? (-> TextInputPort bool))
(defbjouble (port-eof? p)
  (#:sync (clr-eof p))
  (#:bjo  (clr-eof-await p)))

;; The next line, without its newline. **Throws at end of input** — guard with
;; `port-eof?`, or use `read-line/opt`. Both halves throw the same exception
;; with the same message.
(: read-line (-> TextInputPort string))
(defbjouble (read-line p)
  (#:sync (clr-line p))
  (#:bjo  (clr-line-await p)))

;; The next line, or `None` at end of input, for when the check and the read
;; want to be one step.
(: read-line/opt (-> TextInputPort (Option string)))
;; Built on the leaves above rather than on the raw builtin, which is the shape
;; the whole layering is meant to have: `read-line` and `port-eof?` are the two
;; procedures that know about colour, and everything over them is written once.
(defun (read-line/opt p)
  (if (port-eof? p)
      None
      (Some (read-line p))))

;; The next character. **Throws at end of input** — guard with `port-eof?`, or
;; use `read-char/opt`.
;;
;; A whole character, not a UTF-16 code unit: one outside the BMP is stored as
;; two units and comes back as one `char`, the same way walking a `string`
;; yields it whole. So `(port->seq read-char p)` is a `(Seq char)` that agrees
;; with `(read-all p)` walked as a string, which it could not if this handed
;; out halves.
;;
;; There is no `peek-char`. A port gives one code unit of lookahead, one unit is
;; not always a character, and a peek that could not promise the answer
;; `read-char` is about to give would be worse than none. `port-eof?` is the
;; question peeking is usually asked, and text that needs real lookahead wants
;; `read-all` and a `StringCursor`.
;; The surrogate arithmetic lives in the runtime and is shared by both halves,
;; so the two colours cannot disagree about what a character is.
(: read-char (-> TextInputPort char))
(defbjouble (read-char p)
  (#:sync (clr-char p))
  (#:bjo  (clr-char-await p)))

;; The next character, or `None` at end of input, for when the check and the
;; read want to be one step.
(: read-char/opt (-> TextInputPort (Option char)))
(defun (read-char/opt p)
  (if (port-eof? p)
      None
      (Some (read-char p))))

;; Everything remaining, as one string. Empty at end of input, which needs no
;; `Option`: there is no difference between "no more input" and "the empty
;; remainder" once the whole rest is what you asked for.
(: read-all (-> TextInputPort string))
(defbjouble (read-all p)
  (#:sync (clr-rest p))
  (#:bjo  (clr-rest-await p)))

;; The reader is `-?->`: this takes one of either colour, and both copies of
;; `port-fold` are generated from this one body. Declared rather than inferred,
;; because that is the decision — left to inference, every higher-order function
;; in the language would double for callbacks nobody will ever suspend.
;;
;; The collection functions are deliberately *not* converted, and the reason is
;; the same one. Nothing about `list-map` suggests IO, so declaring it `-?->`
;; would double its emitted size to buy a copy no program asks for. This one is
;; the port surface, where the whole question came from and where a suspending
;; reader is the ordinary case.
;;
;; The loop below has to stay tail-recursive. `LoopLowering` promotes it to a
;; `while` in the enclosing method, and in the generated copy that method is
;; `async` — which is what lets `(f port acc)` be awaited there. A loop that
;; escaped would stay a C# local function and the copy could not be built.
(: port-fold (-> (-?-> TextInputPort %a %a) %a TextInputPort %a))
(defun (port-fold f init port)
  (let loop ((acc init))
    (if (port-eof? port)
        acc
        (loop (f port acc)))))


;; --- Output ---

(: write-string (-> TextOutputPort string void))
(defun (write-string p s) (.Write p s))

;; One character. The counterpart of `read-char`, and a whole character for the
;; same reason: one outside the BMP goes out as the two units it is made of
;; rather than as a lone surrogate.
(: write-char (-> TextOutputPort char void))
(defun (write-char p c) (writer-write-char! p c))

(: writeln (-> TextOutputPort string void))
(defun (writeln p s) (.WriteLine p s))

;; Everything written to a string port so far.
;;
;; The port stays open and keeps collecting, so this is a look rather than a
;; close: asking twice with writes in between gives the second answer including
;; the first.
;;
;; **Throws for a port that is not a string port.** That case cannot be a type
;; error, because a file port and a string port are deliberately one type — so
;; it is the one port operation where the wrong argument is only found at
;; runtime. The alternative was letting .NET answer "System.IO.StreamWriter"
;; and say nothing.
(: get-output-string (-> TextOutputPort string))
(defun (get-output-string p) (writer->string p))


;; ---------------------------------------------------------------------------
;; Collection
;; ---------------------------------------------------------------------------
;;
;; What every collection can be *asked*: how many, whether any, and give me the
;; elements. `Iterable` says how to walk one and `Foldable` how to consume one;
;; this is the trait for the questions that need no walk to ask.
;;
;; I should get ->seq into the iterable trait with a simple default method there.
(def/trait (Collection %a)
  (type %content)
  (: length (-> %a int))
  (: empty? (-> %a bool)))

(def/impl (Collection (List %a))
  (type %content %a)
  (defun (length lst)
    (list-length lst))
  (defun (empty? lst)
    (list-empty? lst)))

(def/impl (Collection (Vec %a))
  (type %content %a)
  (defun (length vec)
    (vec-length vec))
  (defun (empty? vec)
    (vec-empty? vec)))

;; A map's element is its `(Tuple %k %v)` pair, so `(->seq m)` is a sequence of
;; pairs and `(length m)` counts entries, not keys and values separately.
(def/impl (Collection (Map %k %v))
  (type %content (Tuple %k %v))
  (defun (length m)
    (map-length m))
  (defun (empty? m)
    (map-empty? m)))

;; The one member that holds no elements: a `Range` computes its answers from
;; `lo`, `hi` and `by` rather than looking at anything. `by` is positive by
;; construction, so the length is the ceiling of the span divided by the step,
;; and a range whose `hi` has already been passed is empty rather than negative.
(def/impl (Collection Range)
  (type %content int)
  (defun (length r)
    (def lo (record-ref r lo))
    (def hi (record-ref r hi))
    (def by (record-ref r by))
    (if (<= hi lo)
        0
        (/ (+ (- hi lo) (- by 1)) by)))
  (defun (empty? r)
    (>= (record-ref r lo) (record-ref r hi))))

;; A string's content is its characters. `length` is `string-count` — the walk —
;; rather than `string-length`, so that it agrees with the sequence `->seq`
;; produces; `empty?` stays O(1), since a string with no storage has no
;; characters in any encoding.
(def/impl (Collection string)
  (type %content char)
  (defun (length s)
    (string-count s))
  (defun (empty? s)
    (string-empty? s)))

;; `->seq` is the identity here, which is the point: generic code written
;; against `Collection` accepts a sequence without a conversion.
;;
;; The other two are the honest ones rather than the cheap ones. `seq-length`
;; walks and `seq-empty?` forces an element, and over a source that cannot be
;; walked twice — a `port->seq` — asking either is asking for the data. That is
;; a property of the source, not of `Seq`: the same questions over a
;; `(list->seq xs)` are ordinary. Reach for `Iterable` when the walk itself is
;; what you want, and `seq->vec` when you mean to ask more than once.
(def/impl (Collection (Seq %a))
  (type %content %a)
  (defun (length s)
    (seq-length s))
  (defun (empty? s)
    (seq-empty? s)))


;; ---------------------------------------------------------------------------
;; Control
;; ---------------------------------------------------------------------------
;;
;; The macros the prelude publishes. They are here rather than in a library
;; because they are control flow: `cond` is `if` at any number of arms, and the
;; other three are what unwrapping an `Option` costs when unwrapping is the
;; whole of what is happening.
;;
;; Written with `syntax-match`, which is imported for exactly that. A macro
;; cannot be used in the module that defines it, so the pattern language has to
;; come from somewhere else — and `std/syntax-match` is below this file
;; precisely so that it can, importing nothing at all itself.
;;
;; None of them is in the `(export ...)` at the top of this file. A macro is
;; published by being one, through the assembly's `BjolangMacros`, and it is not
;; a binding anyone can call: there is nothing to export.
(import (std syntax-match))

;; `(cond (test body ...) ... (else body ...))`
;;
;; The final `else` is required rather than conventional: every arm answers a
;; value of one type, so there has to be a last answer. `when` and `unless` are
;; the one-armed forms, and neither needs one.
(def/macro (cond form inject compare)
  (syntax-match form
    ((_ clause ...) (cond-arms clause form))
    (bad (syntax-error bad "cond takes clauses: (cond (test body ...) ... (else body ...))"))))

(: cond-arms (-> (List Syntax) Syntax Syntax))
(defun (cond-arms clauses whole)
  (match clauses
    (Nil
      (syntax-error whole "cond needs a final (else ...) clause: every arm answers something, so there has to be a last answer."))
    ((Cons clause rest)
     (syntax-match clause
       ;; `'else` matches that identifier and nothing else. Note what it is not:
       ;; a check against whatever `else` happens to mean at the call site,
       ;; which is not a question that can be asked at parse time.
       (('else body ...) (one-form body clause))
       ((test body ...) #'(if ,test ,(one-form body clause) ,(cond-arms rest whole)))
       (bad (syntax-error bad "A cond clause is (test body ...), or (else body ...) for the last one."))))))

;; Several forms as one. An `if` branch is an expression, where a `defun` body
;; and a `match` arm are bodies, and `(let () ...)` is how one becomes the other.
(: one-form (-> (List Syntax) Syntax Syntax))
(defun (one-form body whole)
  (match body
    (Nil (syntax-error whole "This clause has nothing to do."))
    ((Cons only Nil) only)
    (_ #'(let () ,@body))))

;; `(if-let ((name expr)) then else)`
;;
;; `then` with `name` bound to what `expr` answered, if it answered anything,
;; and `else` if it did not. The binding is shaped like a `let`'s and there is
;; exactly one: a second would make this `and-let*`, which is a different macro
;; with a different name.
(def/macro (if-let form inject compare)
  (syntax-match form
    ((_ (name value) then else)
     #'(match ,value ((Some ,name) ,then) (None ,else)))
    (bad (syntax-error bad "if-let takes one binding, a then and an else: (if-let (name expr) then else)"))))

;; `(when-let ((name expr)) body ...)`
;;
;; The body with `name` bound, when there was something to bind.
;;
;; It expands to a `when` rather than to a `match` so that it *is* one: the form
;; answers nothing, and the body's own value is thrown away rather than having
;; to be unit. A `match` would have made the missing branch's `unit` something
;; the body had to agree with, which is not what the one-armed form means
;; anywhere else in the language.
(def/macro (when-let form inject compare)
  (syntax-match form
    ((_ (name value) first body ...)
     ;; `value` is bound before it is asked about, so it is evaluated once.
     #'(let ((found ,value))
         (when (some? found)
           (let ((,name (option-ref found)))
             ,first
             ,@body))))
    (bad (syntax-error bad "when-let takes one binding and a body: (when-let (name expr) body ...)"))))

;; `(some-> value step ...)` — `->`, stopping at the first `None`.
;;
;; Each step answers an `(Option ...)` and is handed what the step before it
;; unwrapped to, so the whole answers one and nothing after a `None` runs.
;; Threading is `->`'s own, `&` and all, because each step is passed to it
;; rather than reimplemented here.
(def/macro (some-> form inject compare)
  (syntax-match form
    ((_ value step ...) (some-steps value step))
    (bad (syntax-error bad "some-> takes a value and steps: (some-> value (f &) (g &))"))))

(: some-steps (-> Syntax (List Syntax) Syntax))
(defun (some-steps value steps)
  (match steps
    ;; Nothing could have failed, so nothing has.
    (Nil #'(Some ,value))
    ;; The last step's answer is already the answer.
    ((Cons step Nil) #'(-> ,value ,step))
    ((Cons step rest)
     ;; Every level binds `it`, and every level means its own: the step is
     ;; spliced where the nearest one is in scope. They are one name because
     ;; they are one idea, and the expander renames it apart from the call site
     ;; either way.
     #'(match (-> ,value ,step)
        (None None)
        ((Some it) ,(some-steps #'it rest))))))

;; ---------------------------------------------------------------------------
;; Cancellation scopes
;; ---------------------------------------------------------------------------

;; `(with-cancel (cancel) body ...)` — a cancellation scope that ends when the
;; scope does.
;;
;; `parameterize` restores the binding on the way out but never *fires* the
;; token. 
;;
;;     (parameterize ((current-cancel tok))
;;       (bjo (worker jobs)))        ;; promise dropped
;;     (respond 200)                 ;; scope exits, worker runs on
;;
;; So: make the token here, install it, and fire it however the body leaves.
;;
;;   * normal exit  → `Scope-Ended`
;;   * a failure    → `(Failed e)`, and the exception carries on out
;;   * either way   → the binding is restored
;;
;; **What it does not do.** Firing returns immediately, so a cooperating child
;; stops *soon*, not before the scope exits. A child midway through its cleanup
;; can still be writing to a port this scope has closed; guaranteeing otherwise
;; needs the children joined, which needs a nursery. This is the cheap half, and
;; it is the half that stops the leak.
(def/macro (with-cancel form inject compare)
  (syntax-match form
    ((_ (cancel) first body ...)
     ;; `cancel` came from the input, so hygiene leaves it alone and the body
     ;; sees it. Everything else here is the template's and is renamed apart,
     ;; which is where a hand-written desugar would have had to gensym.
     #'(let ()
         (def (,cancel scope-token) (make-cancel))
         (def saved (parameter-push! current-cancel scope-token))
         (try
             ;; Catches everything, so the token fires for every failure rather
             ;; than for a list somebody remembered to write. That costs the
             ;; caller nothing because `raise` puts the exception straight back,
             ;; with the stack trace it arrived with.
             (match (try (let () ,first ,@body) #:catch (System.Exception))
               ((Ok answer) (,cancel Scope-Ended) answer)
               ((Err failure) (,cancel (Failed failure)) (raise failure)))
           #:finally (dyn-restore! saved))))
    (bad (syntax-error bad "with-cancel names its cancel thunk and takes a body: (with-cancel (cancel) body ...)"))))

;; `(with-deadline ms body ...)` — a `with-cancel` whose token also fires on its
;; own, after `ms`, with `Deadline`.
;;
;; Costs nothing on top: the scope is the same scope, and the timer is one fiber
;; that races the scope's own token, so finishing early takes the timer away
;; again rather than leaving it parked until an instant nothing is waiting for.
;;
;; The canceller is not named because there is nobody to hand it to — a deadline
;; is the whole reason this scope is cancellable. Write `with-cancel` and start
;; your own timer if you want both.
(def/macro (with-deadline form inject compare)
  (syntax-match form
    ((_ ms first body ...)
     ;; `fire` is the template's on both sides, so it is one renamed name: the
     ;; `with-cancel` this expands into binds it, and the watcher started inside
     ;; that scope is what holds it.
     #'(with-cancel (fire)
        (deadline-watch! fire ,ms)
        ,first
        ,@body))
    (bad (syntax-error bad "with-deadline takes a millisecond limit and a body: (with-deadline 5000 body ...)"))))

;; ---------------------------------------------------------------------------
;; Container formats
;; ---------------------------------------------------------------------------

;; `'(1 2 3)`, with every element formatted by its own `->str`.
;;
;; The where clause is the whole content of the type: this formats a list of
;; anything formattable, which — since `->str` has a blanket — is every list,
;; but the *element's* implementation is what runs, chosen where the element
;; type is known. Written as a function as well as an implementation so that it
;; can be called at a known element type without going through dispatch, which
;; is what the implementation below then does.
(: list->str (-> (List %a) string) (where (->str %a)))
(defun (list->str l)
  (if (list-empty? l)
      "()"
      (let ((sb (stringbuilder-empty)))
        (stringbuilder-add-string! sb "'(")
        (stringbuilder-add-string! sb (->str (list-head l)))
        (loop (:for elem (list-tail l))
              (:do (stringbuilder-add-string! sb " ")
                   (stringbuilder-add-string! sb (->str elem))))
        (stringbuilder-add-string! sb ")")
        (stringbuilder->string sb))))

(def/impl (->str (List %a))
  (where (->str %a))
  (defun (->str l)
    (list->str l)))

(: vec->str (-> (Vec %a) string) (where (->str %a)))
(defun (vec->str v)
  (def sp (open-output-string))
  (def out #(write-string sp &1))
  (out "[")
  (when (not (empty? v))
    (out (->str (vec-ref v 0)))
    (loop (:with i 0 (+ i 1))
          (:for elem v)
          (:when (> i 0))
          (:do (out " ")
               (out (->str elem)))))
  (out "]")
  (get-output-string sp))

(def/impl (->str (Vec %a))
  (where (->str %a))
  (defun (->str v)
    (vec->str v)))


(: seq->str (-> (Seq %a) string) (where (->str %a)))
(defun (seq->str sq)
  (def sp (open-output-string))
  (def out #(write-string sp &1))
  (out "(seq")
  ;; One walk. The `empty?`-then-head-then-tail shape this replaces enumerated
  ;; the sequence three times over before the loop even started, which for a
  ;; `Seq` is three runs of whatever produces it.
  (loop (:for item sq)
        (:do (out " ")
             (out (->str item))))
  (out ")")
  (get-output-string sp))

(def/impl (->str (Seq %a))
  (where (->str %a))
  (defun (->str sq)
    (seq->str sq)))

;; One entry, as `key value`. A function of its own because a loop clause is a
;; body of expressions and a `def` is a declaration, so the pair has to come
;; apart somewhere that a binding may be introduced.
(: map-entry->str (-> (Tuple %k %v) string) (where (->str %k) (->str %v)))
(defun (map-entry->str entry)
  (def (k v) entry)
  (str (->str k) " " (->str v)))

;; `#map(key value ...)`, so the literal round-trips. The order is the trie's,
;; which is stable for a given map and worth nothing beyond that — print an
;; `(std orderedmap)` map when two equal maps have to print the same.
(: map->str (-> (Map %k %v) string) (where (->str %k) (->str %v)))
(defun (map->str m)
  (let ((sb (stringbuilder-empty)))
    (stringbuilder-add-string! sb "#map(")
    (loop (:with first? #t #f)
          (:for entry m)
          (:do (unless first? (stringbuilder-add-string! sb " "))
               (stringbuilder-add-string! sb (map-entry->str entry))))
    (stringbuilder-add-string! sb ")")
    (stringbuilder->string sb)))

(def/impl (->str (Map %k %v))
  (where (->str %k) (->str %v))
  (defun (->str m)
    (map->str m)))

;; Sequential binding
;;
;; `let` and `parameterize` bind *simultaneously*: every value expression is
;; evaluated where the form is written, and none of the new bindings is in
;; scope, or installed, for any of them. That is the R7RS reading and it is what
;; makes `(let ((a b) (b a)) ...)` a swap.
;;
;; These two are the sequential forms, for the case where a later value really
;; is meant to see an earlier binding. Both are macros rather than special
;; forms, and both are one line of work, because a *single* binding means the
;; same thing under either reading — so a sequential group is nothing but a nest
;; of singles, and there is nothing for the compiler to know about it.

;; `(let* ((a 1) (b (+ a 1))) ...)` — each binding is in scope for the next.
(def/macro (let* form compare inject)
  (syntax-match form
    ((_ () body ...)
     #'(let () ,@body))
    ((_ (bind) body ...)
     #'(let (,bind) ,@body))
    ((_ (bind binds ...) body ...)
     #'(let (,bind)
        (let* (,@binds) ,@body)))))

;; `(parameterize* ((p 1) (q (parameter-ref p))) ...)` — each parameter is
;; installed before the next value expression runs, so `q` here gets 1 rather
;; than whatever `p` was outside.
;;
;; The unwinding is the same either way: each binding still gets its own
;; `try/finally`, so an exception restores exactly the pushes that happened.
(def/macro (parameterize* form compare inject)
  (syntax-match form
    ((_ () body ...)
     #'(let () ,@body))
    ((_ (bind) body ...)
     #'(parameterize (,bind) ,@body))
    ((_ (bind binds ...) body ...)
     #'(parameterize (,bind)
        (parameterize* (,@binds) ,@body)))))

;; ---------------------------------------------------------------------------
;; type/derive
;; ---------------------------------------------------------------------------
;;
;; `(type/derive (Eq) (: Point (Record (: x int) (: y int))))` is the type
;; declaration and the implementations its shape determines.
;;
;; Syntactic, and it has to be: where a declaration is read there is no registry
;; to ask what a type's fields are, only the form that declares them. The
;; declaration is passed through untouched and the implementation is written out
;; of the same S-expression.
;;
;; The traits are a list: `(Eq)`, `(Ord)` or `(Eq Ord)`, each deriving its own
;; methods from the one declaration.

(: derive-sym (-> string Syntax))
(defun (derive-sym name) (SSym (string->symbol name)))

;; How the transformer refuses its input where a list of methods is wanted.
;; `syntax-error` never returns; the `Nil` is what makes it type.
(: derive-fail (-> Syntax string (List Syntax)))
(defun (derive-fail form message)
  (ignore (syntax-error form message))
  Nil)

;; The type variables of a declaration's head: none for `Point`, one for
;; `(Box %a)`. Each becomes a constraint, because comparing a `Box` is comparing
;; whatever it holds.
(: derive-head-vars (-> Syntax (List Syntax)))
(defun (derive-head-vars head)
  (match head
    ((SList items)
     (match items
       (Nil Nil)
       ((Cons _ vars) vars)))
    (_ Nil)))

;; The type's own name: the head itself for `Point`, its first item for
;; `(Box %a)`. Wanted only for a diagnostic — the name a type with no lawful
;; hash reports itself under — so the bare spelling is the right one.
(: derive-head-name (-> Syntax Syntax))
(defun (derive-head-name head)
  (match head
    ((SList items)
     (match items
       ((Cons name _) name)
       (Nil head)))
    (_ head)))

;; A fold of `hash-combine` over the parts of a value, in order. Combination
;; does not commute, so two fields cannot swap places unnoticed.
(: derive-hash-fold (-> (List Syntax) Syntax Syntax))
(defun (derive-hash-fold parts acc)
  (match parts
    (Nil acc)
    ((Cons p rest) (derive-hash-fold rest #'(hash-combine ,acc ,p)))))

;; --- Records and structs ---

;; A field is `(: name type)` or `(: name type #:mutable)`, so the marker is
;; matched with an ellipsis rather than by a second arm: `#:mutable` is the only
;; one the parser accepts, and it has already refused anything else by the time
;; a declaration reaches here.
(: derive-field-names (-> (List Syntax) (List Syntax)))
(defun (derive-field-names fields)
  (list-map (fun (f)
              (syntax-match f
                ((_ name _ marker ...) name)
                (bad (syntax-error bad "a record field is written (: name type), optionally followed by #:mutable."))))
            fields))

;; Whether any field carries a marker — which, `#:mutable` being the only one
;; there is, means the record has a mutable field.
(: derive-any-mutable? (-> (List Syntax) bool))
(defun (derive-any-mutable? fields)
  (match fields
    (Nil #f)
    ((Cons f rest)
     (if (syntax-match f
           ((_ _ _ marker markers ...) #t)
           (_ #f))
         #t
         (derive-any-mutable? rest)))))

;; `=` is field-wise over every field, mutable ones included: comparing a record
;; means comparing what it holds now, and that a later write can change the
;; answer is what mutation *is*.
;;
;; `eq-hash` is the other half of the trait and has no honest answer. Hashing
;; the mutable field breaks the law that a key's hash does not change; hashing
;; only the immutable ones breaks the law that equal values hash alike. So a
;; derived implementation refuses, naming the type. A hand-written one is still
;; free to hash the stable fields and mean it — this is the default, not a
;; property of the type.
(: derive-eq-record (-> Syntax (List Syntax) bool (List Syntax)))
(defun (derive-eq-record head names mutable?)
  (def equals
    #'(defun (= a b)
        (and ,@(list-map (fun (n) #'(= (record-ref a ,n) (record-ref b ,n))) names))))
  (def hashed
    (if mutable?
        #'(defun (eq-hash v) (unhashable ,(SStr (syntax->string (derive-head-name head)))))
        #'(defun (eq-hash v)
            ,(derive-hash-fold (list-map (fun (n) #'(eq-hash (record-ref v ,n))) names) #'17))))
  (Cons equals (Cons hashed Nil)))

;; --- Unions ---
;;
;; A case is `Name` or `(Name payload ...)`, and a `#:literal` marker is neither
;; a payload nor a field.

(: derive-case-name (-> Syntax Syntax))
(defun (derive-case-name c)
  (match c
    ((SList items)
     (match items
       ((Cons head _) head)
       (Nil c)))
    (_ c)))

(: derive-payload (-> Syntax (List Syntax)))
(defun (derive-payload c)
  (match c
    ((SList items)
     (match items
       ((Cons _ rest)
        (list-filter (fun (t) (match t ((SKey _) #f) (_ #t))) rest))
       (Nil Nil)))
    (_ Nil)))

;; The binders a case's payload is taken apart into. Built rather than written
;; in a template, since how many there are is only known here — which also means
;; they are not renamed. That is harmless: each is bound by the pattern it
;; appears in and read only by that arm's body.
(: derive-binders (-> string int int (List Syntax)))
(defun (derive-binders side i n)
  (if (= i n)
      Nil
      (Cons (derive-sym (string-append side (int->string i)))
            (derive-binders side (+ i 1) n))))

(: derive-eq-pairs (-> (List Syntax) (List Syntax) (List Syntax)))
(defun (derive-eq-pairs ls rs)
  (match ls
    (Nil Nil)
    ((Cons l lrest)
     (match rs
       (Nil Nil)
       ((Cons r rrest) (Cons #'(= ,l ,r) (derive-eq-pairs lrest rrest)))))))

;; Same case, compare the payloads positionally; any other case, unequal.
(: derive-eq-union-arm (-> Syntax Syntax))
(defun (derive-eq-union-arm c)
  (def name (derive-case-name c))
  (def n (list-length (derive-payload c)))
  (def ls (derive-binders "__derived-l" 0 n))
  (def rs (derive-binders "__derived-r" 0 n))
  #'((,name ,@ls)
     (match b
       ((,name ,@rs) (and ,@(derive-eq-pairs ls rs)))
       (,(derive-sym "_") #f))))

;; Seeded with the case's position, so that two cases carrying the same payload
;; hash differently.
(: derive-hash-union-arms (-> (List Syntax) int (List Syntax)))
(defun (derive-hash-union-arms cases index)
  (match cases
    (Nil Nil)
    ((Cons c rest)
     (def name (derive-case-name c))
     (def ls (derive-binders "__derived-l" 0 (list-length (derive-payload c))))
     (def tag (SInt (int->string index)))
     (Cons #'((,name ,@ls)
              ,(derive-hash-fold (list-map (fun (l) #'(eq-hash ,l)) ls) tag))
           (derive-hash-union-arms rest (+ index 1))))))

(: derive-eq-union (-> (List Syntax) (List Syntax)))
(defun (derive-eq-union cases)
  (def equals
    #'(defun (= a b) (match a ,@(list-map derive-eq-union-arm cases))))
  (def hashed
    #'(defun (eq-hash v) (match v ,@(derive-hash-union-arms cases 0))))
  (Cons equals (Cons hashed Nil)))

;; --- Ordering ---
;;
;; `compare` promises a sign rather than -1, 0 and 1, so a derived body hands
;; back whatever the part that decided the answer said, unexamined.

;; The comparisons of a value's parts, left to right, answering with the first
;; that decides. A nest of `let` is what stopping early looks like without a
;; special form for it: the tail is an arm of the `if`, so it is reached only
;; where the head compared equal. The last part needs no test — there is nothing
;; after it to prefer — so it is spliced in bare.
(: derive-ord-chain (-> (List Syntax) int Syntax))
(defun (derive-ord-chain parts i)
  (match parts
    (Nil #'0)
    ((Cons p rest)
     (def c (derive-sym (string-append "__derived-c" (int->string i))))
     (if (list-empty? rest)
         p
         #'(let ((,c ,p))
             (if (= ,c 0) ,(derive-ord-chain rest (+ i 1)) ,c))))))

;; Lexicographic in declaration order, mutable fields included, for the reason
;; `=` includes them: the order is over what the record holds now. Nothing here
;; corresponds to `eq-hash`'s refusal, because ordering has no law saying an
;; answer may not change — a sorted collection going stale under a write is the
;; write's doing rather than the comparison's.
(: derive-ord-record (-> (List Syntax) (List Syntax)))
(defun (derive-ord-record names)
  (Cons #'(defun (compare a b)
            ,(derive-ord-chain
              (list-map (fun (n) #'(compare (record-ref a ,n) (record-ref b ,n))) names)
              0))
        Nil))

;; A payload bound to nothing, for the arms that only ask which case they have.
(: derive-wildcards (-> int (List Syntax)))
(defun (derive-wildcards n)
  (if (= n 0)
      Nil
      (Cons (derive-sym "_") (derive-wildcards (- n 1)))))

;; Which case a value is, as its position in the declaration — the order the
;; hash already seeds itself with, so ordering and hashing read the union the
;; same way.
(: derive-ord-index-arms (-> (List Syntax) int (List Syntax)))
(defun (derive-ord-index-arms cases index)
  (match cases
    (Nil Nil)
    ((Cons c rest)
     (Cons #'((,(derive-case-name c) ,@(derive-wildcards (list-length (derive-payload c))))
              ,(SInt (int->string index)))
           (derive-ord-index-arms rest (+ index 1))))))

(: derive-ord-pairs (-> (List Syntax) (List Syntax) (List Syntax)))
(defun (derive-ord-pairs ls rs)
  (match ls
    (Nil Nil)
    ((Cons l lrest)
     (match rs
       (Nil Nil)
       ((Cons r rrest) (Cons #'(compare ,l ,r) (derive-ord-pairs lrest rrest)))))))

;; Same case, so the payloads decide it positionally. The inner wildcard cannot
;; run — the indices were equal before this was reached — and is there because a
;; match answers on every input.
(: derive-ord-union-arm (-> Syntax Syntax))
(defun (derive-ord-union-arm c)
  (def name (derive-case-name c))
  (def n (list-length (derive-payload c)))
  (def ls (derive-binders "__derived-l" 0 n))
  (def rs (derive-binders "__derived-r" 0 n))
  #'((,name ,@ls)
     (match b
       ((,name ,@rs) ,(derive-ord-chain (derive-ord-pairs ls rs) 0))
       (,(derive-sym "_") 0))))

;; Case first, payload second. Both indices are taken before either is used, so
;; the cross-case answer is one comparison of ints rather than an arm for every
;; pair of cases.
(: derive-ord-union (-> (List Syntax) (List Syntax)))
(defun (derive-ord-union cases)
  (def ia (derive-sym "__derived-ia"))
  (def ib (derive-sym "__derived-ib"))
  (def index-arms (derive-ord-index-arms cases 0))
  (Cons #'(defun (compare a b)
            (let ((,ia (match a ,@index-arms))
                  (,ib (match b ,@index-arms)))
              (if (= ,ia ,ib)
                  (match a ,@(list-map derive-ord-union-arm cases))
                  (compare ,ia ,ib))))
        Nil))

;; --- Putting one implementation together ---

;; What can be derived is a property of the declaration rather than of the
;; trait, so the same refusal serves both of them.
(: derive-shape-error (-> Syntax (List Syntax)))
(defun (derive-shape-error bad)
  (derive-fail bad "a type that derives has to be a Record, a Struct or a Union. An alias is a second spelling of a type rather than a type of its own — derive for the type it names."))

;; A `Struct` never reaches `derive-eq-record` with a mutable field: the parser
;; refuses the combination outright, so the flag it is handed is always false.
(: derive-eq-methods (-> Syntax Syntax (List Syntax)))
(defun (derive-eq-methods head shape)
  (syntax-match shape
    (('Record fields ...) (derive-eq-record head (derive-field-names fields) (derive-any-mutable? fields)))
    (('Struct fields ...) (derive-eq-record head (derive-field-names fields) (derive-any-mutable? fields)))
    (('Union cases ...) (derive-eq-union cases))
    (('Enum cases ...) (derive-eq-union cases))
    (('Sum cases ...) (derive-eq-union cases))
    (bad (derive-shape-error bad))))

(: derive-ord-methods (-> Syntax (List Syntax)))
(defun (derive-ord-methods shape)
  (syntax-match shape
    (('Record fields ...) (derive-ord-record (derive-field-names fields)))
    (('Struct fields ...) (derive-ord-record (derive-field-names fields)))
    (('Union cases ...) (derive-ord-union cases))
    (('Enum cases ...) (derive-ord-union cases))
    (('Sum cases ...) (derive-ord-union cases))
    (bad (derive-shape-error bad))))

(: derive-methods (-> Syntax Syntax Syntax (List Syntax)))
(defun (derive-methods trait head shape)
  (if (syntax-ident=? trait (derive-sym "Eq"))
      (derive-eq-methods head shape)
      (if (syntax-ident=? trait (derive-sym "Ord"))
          (derive-ord-methods shape)
          (derive-fail trait "the traits that can be derived are Eq and Ord."))))

;; A type with parameters derives a *conditional* implementation: every
;; parameter has to satisfy the same trait, because the fields hold values of
;; those types and comparing one is what the body does.
(: derive-impl (-> Syntax Syntax Syntax))
(defun (derive-impl trait typedef)
  (syntax-match typedef
    ((_ head shape)
     #'(def/impl (,trait ,head)
         (where ,@(list-map (fun (v) #'(,trait ,v)) (derive-head-vars head)))
         ,@(derive-methods trait head shape)))
    (bad (syntax-error bad "a type declaration is written (: Name (Record ...))."))))

(: derive-impls (-> (List Syntax) (List Syntax) (List Syntax)))
(defun (derive-impls traits typedefs)
  (match traits
    (Nil Nil)
    ((Cons t rest)
     (list-append (list-map (fun (td) (derive-impl t td)) typedefs)
                  (derive-impls rest typedefs)))))

(def/macro (type/derive form inject compare)
  (syntax-match form
    ((_ (trait ...) typedef ...)
     #'(begin
         (type ,@typedef)
         ,@(derive-impls trait typedef)))
    (bad (syntax-error bad "type/derive takes a list of traits and one or more type declarations, as in (type/derive (Eq) (: Point (Record (: x int)))).")))

