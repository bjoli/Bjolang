;; `,@` inside '(...).
;;
;; A quoted list is built element by element as it is read, so there is no
;; position for a list whose length only exists at run time. Splicing does work
;; in a `#'` template, which builds a `Syntax` value instead — the message says
;; so, because the two spellings look alike and only one of them can do it.

;; EXPECT-ERROR: Splicing with ,@ inside '(...)
;; EXPECT-ERROR: ,@ does work inside a #' template

(import (std prelude))

(defun (main args)
  (def xs (list "a" "b"))
  (println (int->string (list-length '(a ,@xs))))
  0)
