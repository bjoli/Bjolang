;; An inner level may not reuse the name of a variable bound in an enclosing
;; level: the enclosing variable is carried into the inner level by its name.

;; EXPECT-ERROR: 'x' at loop_rebind_outer.bjo:14 is already a variable of an enclosing level of this loop.

(import (std prelude))

(: f (-> (List int)))
(defun (f)
  (loop (:for x '(1 2))
        (:subloop)
        (:for y '(3 4))
        (:subloop)
        (:for x '(5 6))
        (:acc out (listing (+ x y)))))

(defun (main) (println (int->string (list-length (f)))) 0)
