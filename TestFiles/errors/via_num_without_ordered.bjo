;; Num requires Ordered, so a newtype that is a number can be compared with <,
;; and has to be given Ordered as well.

;; EXPECT-ERROR: 'via_num_without_ordered/Banana' does not satisfy 'Ordered', needed by 'Num', which requires it of every implementor. A newtype has only what is implemented for it, and this is not: write (impl (Ordered Banana) #:via int).

(import (std prelude))

(type (: Banana (Newtype int)))
(impl (Num Banana) #:via int)

(defun (main args) 0)
