;; A mismatch deep inside two types says where they part: the whole types are
;; shown beside what each is, and below them the innermost pair and the way
;; down to it.

;; EXPECT-ERROR: Type error: what 'f' returns has the wrong type.
;; EXPECT-ERROR: expected (Option (List string))
;; EXPECT-ERROR: found    (Option (List int))
;; EXPECT-ERROR: They differ inside the Option, inside the List: string against int.
;; EXPECT-ERROR: type_error_path.bjo:14

(import (std prelude))

(: f (-> int (Option (List string))))
(defun (f n)
  (Some (list n)))

(defun (main) 0)
