;; Docs for std/inbox.bjo, read through (:doc #:file "inbox.bjodoc"). The
;; texts are samizdat markup: code in prose is @code{...}.

(:doc #:module
  (summary "Thread-safe bounded queue bridging external .NET threads and Bjolang fibers with backpressure and request/reply support.")
  (see make-inbox inbox-post! inbox-recv inbox-closed inbox-call)
  (example """
    (import (std inbox))

    (: changes (Inbox string))
    (def changes (make-inbox 1000 DropOldest))

    ;; External callback executed on a .NET thread: posts and returns immediately.
    (: on-change (-> string void))
    (defun (on-change path)
      (ignore (inbox-post! changes path)))

    ;; Fiber consumes incoming items within its own execution context.
    (: watch (-bjo-> (Inbox string) int))
    (defbjo (watch ib)
      (let go ((n 0))
        (match (sync (choose (wrap (inbox-recv ib) Some)
                             (wrap (inbox-closed ib) (fun (_) None))))
          ((Some path) (log (str "changed: " path)) (go (+ n 1)))
          (None n))))
    """)
  (example """
    ;; Request/reply pattern: a .NET caller awaits a Task, handled by a fiber.
    (: requests (Inbox (Call int int)))
    (def requests (make-inbox 64 DropNewest))

    ;; On the .NET thread: (inbox-call requests 21) returns a (Task int).

    ;; On the fiber:
    (: serve (-bjo-> (Inbox (Call int int)) void))
    (defbjo (serve ib)
      (let ((c (sync (inbox-recv ib))))
        (try (ignore (call-reply! c (* 2 (call-request c))))
             ;; Ensure the caller receives a fault if an exception occurs.
             #:finally (ignore (call-fail! c (Exception. "no answer"))))
        (serve ib)))
    """)
  (reference """
    An inbox provides a thread-safe communication boundary between external
    .NET threads and Bjolang fibers. Threads outside the fiber scheduler
    (such as Kestrel workers, timer threads, or @code{FileSystemWatcher}
    callbacks) enqueue items without blocking. Receiving fibers consume
    items within their own dynamic execution environment, maintaining
    dedicated effect handlers, dynamic parameters, and cancellation scopes.

    @strong{External callbacks.} Callbacks invoked by external .NET runtimes
    should interact with Bjolang by posting to an inbox. These foreign
    callbacks execute as synchronous functions rather than fibers; they do
    not share active fiber parameters or effect handlers. Calling
    @code{(log ...)} within foreign callbacks routes directly to the default
    global logger. Post items to an inbox and perform domain processing
    within the receiving fiber.

    @strong{Bounded capacity and backpressure.} Every inbox requires an
    explicit capacity limit to prevent unbounded memory growth when
    producers outpace consumers. @code{make-inbox} requires a
    @code{WhenFull} policy governing @code{inbox-post!} and
    @code{inbox-call}. Synchronous operations like @code{inbox-send} and
    @code{inbox-send-evt} block until space is available rather than
    dropping items.

    @strong{Concurrent ML events.} @code{inbox-recv}, @code{inbox-send-evt},
    and @code{inbox-closed} are first-class CML events. If an alternative
    branch in @code{choose} synchronizes first, no items are enqueued or
    dequeued. Items preserve FIFO ordering. Senders waiting for available
    space are queued in FIFO order across both tasks and events.

    @strong{Thread hopping and fiber scheduling.} Posts from external
    threads do not immediately run receiving fibers on the caller's thread,
    preventing deadlocks when foreign threads hold external locks. Instead,
    the scheduler queues the receiver on the Bjolang fiber pool. Posts
    originating from fibers wake receivers immediately.

    @strong{Termination and lifecycle.} @code{inbox-close!} and
    @code{inbox-fail!} initiate graceful shutdown, allowing consumers to
    drain queued items. @code{inbox-abort!} immediately drains and discards
    all pending items. @code{inbox-closed} triggers once an inbox is closed
    and all remaining items have been consumed.

    @strong{Request/reply workflows.} Inboxes handling @code{Call} instances
    support structured request/reply workflows. Fibers receiving a
    @code{Call} should ensure a response is provided (typically within a
    @code{#:finally} block) via @code{call-reply!} or @code{call-fail!},
    preventing external callers from waiting indefinitely.

    See @code{BjolangRuntime/Cml/Inbox.cs} for implementation details.
    """))

;; ---------------------------------------------------------------------------
;; Making one, and the policy it needs
;; ---------------------------------------------------------------------------

(:doc WhenFull
  (summary "Overflow policy determining how a full inbox handles items submitted via inbox-post! or inbox-call.")
  (case DropNewest "Rejects the incoming item. @code{inbox-post!} returns @code{#f}, and @code{inbox-call} tasks fault.")
  (case DropOldest "Evicts the oldest queued item to accept the incoming item. The evicted item's task faults if it was a call.")
  (see make-inbox inbox-dropped-count)
  (reference """
    This policy does not apply to @code{inbox-send}, @code{inbox-send/token},
    or @code{inbox-send-evt}, which wait until space is available.

    Faulted tasks fail with @code{Bjoml.InboxFullException}. Discarded items
    increment @code{inbox-dropped-count}.
    """))

(:doc make-inbox
  (summary "Creates an empty inbox with the specified maximum capacity and overflow policy.")
  (arg capacity "Maximum number of queued items. Must be at least 1.")
  (arg policy "Overflow policy applied when the inbox is full.")
  (returns "A new, open inbox instance.")
  (raises System.ArgumentOutOfRangeException "When capacity is less than 1.")
  (see WhenFull inbox-post! inbox-recv)
  (example """
    (def events (make-inbox 1000 DropOldest))
    """)
  (reference """
    Inboxes require an explicit capacity limit to enforce backpressure and
    prevent unbounded memory growth from rapid event sources (such as file
    system notifications or high-throughput HTTP connections).
    """))

;; ---------------------------------------------------------------------------
;; Putting something in
;; ---------------------------------------------------------------------------

(:doc inbox-post!
  (summary "Enqueues an item without blocking. Safe to call from any thread.")
  (arg ib "The inbox.")
  (arg x "The item to enqueue.")
  (returns "@code{#t} if the item was enqueued or handed off to a waiting receiver; @code{#f} if closed, or full under @code{DropNewest}.")
  (see inbox-send inbox-send-evt WhenFull inbox-dropped-count)
  (reference """
    Designed for foreign threads without a fiber context. When capacity is
    reached, behavior follows the configured @code{WhenFull} policy. Under
    @code{DropOldest}, the oldest item is evicted and @code{#t} is returned.
    If an evicted item is a @code{Call}, its associated task faults with
    @code{Bjoml.InboxFullException}.
    """))

(:doc inbox-send
  (summary "Enqueues an item, returning a Task that completes when queued. Safe from any thread.")
  (arg ib "The inbox.")
  (arg x "The item to enqueue.")
  (returns "A Task that completes when the item is enqueued or delivered.")
  (see inbox-send/token inbox-send-evt inbox-post!)
  (reference """
    When the inbox is full, the task remains pending until space is freed.
    Does not drop items; ignores @code{WhenFull}. Cancels immediately if the
    inbox is closed or aborted. Fibers should prefer @code{inbox-send-evt}.
    """))

(:doc inbox-send/token
  (summary "Enqueues an item with an external CancellationToken, returning a completion task.")
  (arg ib "The inbox.")
  (arg x "The item to enqueue.")
  (arg token "Cancellation token to monitor (e.g. ASP.NET @code{RequestAborted}).")
  (returns "A Task that completes when the item is enqueued or delivered.")
  (see inbox-send inbox-call/token)
  (reference """
    If cancellation is triggered while waiting for capacity, the item is not
    enqueued and the task is cancelled.
    """))

(:doc inbox-send-evt
  (summary "Returns a CML event that enqueues an item when capacity is available.")
  (arg ib "The inbox.")
  (arg x "The item to enqueue.")
  (returns "An event that synchronizes when the item is enqueued.")
  (see inbox-send inbox-closed)
  (example """
    (sync (choose (inbox-send-evt ib job)
                  (wrap (inbox-closed ib) (fun (_) (log "inbox closed")))))
    """)
  (reference """
    The event synchronizes once space is available. If an alternative branch
    in @code{choose} synchronizes first, the item is not enqueued. Never
    synchronizes on a closed inbox.
    """))

;; ---------------------------------------------------------------------------
;; Taking it out, and the end of the stream
;; ---------------------------------------------------------------------------

(:doc inbox-recv
  (summary "Returns a CML event that dequeues and yields the oldest item in the inbox.")
  (arg ib "The inbox.")
  (returns "An event yielding the dequeued item.")
  (see inbox-closed inbox-post!)
  (reference """
    First-class CML event. If another branch in @code{choose} synchronizes
    first, no item is dequeued. Never synchronizes if the inbox is closed and
    empty; use @code{inbox-closed} to monitor shutdown.
    """))

(:doc inbox-closed
  (summary "Returns a CML event that triggers when the inbox is closed and all items have been consumed.")
  (arg ib "The inbox.")
  (returns "An event yielding @code{None} after normal closure or abort, or @code{(Some e)} after failure.")
  (see inbox-recv inbox-close! inbox-fail! inbox-abort!)
  (example """
    (defbjo (drain ib)
      (let go ()
        (match (sync (choose (wrap (inbox-recv ib) Some)
                             (wrap (inbox-closed ib) (fun (_) None))))
          ((Some x) (handle x) (go))
          (None 'done))))
    """)
  (reference """
    Triggers once the inbox is closed, all queued items have been dequeued,
    and all pending send operations have committed. Subsequent synchronizations
    complete immediately.
    """))

;; ---------------------------------------------------------------------------
;; Ending it
;; ---------------------------------------------------------------------------

(:doc inbox-close!
  (summary "Initiates graceful shutdown of the inbox, allowing remaining queued items to be consumed.")
  (arg ib "The inbox.")
  (see inbox-fail! inbox-abort! inbox-closed)
  (reference """
    Subsequent calls to @code{inbox-post!} return @code{#f}, and new send or
    call tasks are cancelled immediately. Queued items remain accessible to
    receivers. Pending send operations waiting for space are permitted to
    complete. @code{inbox-closed} triggers once all items are consumed.
    Idempotent.
    """))

(:doc inbox-fail!
  (summary "Initiates graceful shutdown with an exception, causing inbox-closed to yield (Some e).")
  (arg ib "The inbox.")
  (arg e "The exception indicating failure.")
  (see inbox-close! inbox-closed)
  (reference """
    The failure exception is stored separately from queued items so it cannot
    be dropped by overflow policies. The first failure is preserved; later
    failures are ignored.
    """))

(:doc inbox-abort!
  (summary "Abruptly closes the inbox and discards all pending items.")
  (arg ib "The inbox.")
  (see inbox-close! inbox-closed)
  (reference """
    All queued items are discarded immediately. Pending call and send tasks
    are cancelled. @code{inbox-closed} triggers with @code{None} or an
    earlier failure exception. Discarded items do not increment
    @code{inbox-dropped-count}.
    """))

;; ---------------------------------------------------------------------------
;; What was lost, and subscribing to an IObservable
;; ---------------------------------------------------------------------------

(:doc inbox-dropped-count
  (summary "Returns the total number of items discarded by the overflow policy.")
  (arg ib "The inbox.")
  (returns "Number of dropped items.")
  (see WhenFull inbox-post!)
  (reference """
    Enables monitoring of dropped message metrics. Items discarded by
    @code{inbox-abort!} are not included in this count.
    """))

(:doc inbox-observer
  (summary "Adapts the inbox into a .NET IObserver instance for IObservable subscriptions.")
  (arg ib "The inbox.")
  (returns "An IObserver forwarding OnNext to inbox-post!, OnError to inbox-fail!, and OnCompleted to inbox-close!.")
  (see make-observer inbox-post! inbox-fail! inbox-close!)
  (example """
    (.Subscribe observable (inbox-observer ib))
    """)
  (reference """
    @code{OnNext} invokes @code{inbox-post!}, adhering to the inbox's
    configured @code{WhenFull} overflow policy.
    """))

(:doc make-observer
  (summary "Constructs an IObserver from three callback delegates.")
  (arg on-next "Delegate invoked for each emitted item.")
  (arg on-error "Delegate invoked when the stream terminates with an error.")
  (arg on-completed "Delegate invoked when the stream terminates successfully.")
  (returns "An IObserver delegating to the provided callbacks.")
  (see inbox-observer)
  (reference """
    Provides an adapter for @code{IObservable.Subscribe}. The callback
    delegates execute on the thread of the observable and should adhere to
    standard foreign callback rules: post to an inbox and avoid blocking.
    """))

(:doc IObserver
  (summary "The .NET System.IObserver interface used to subscribe to IObservable event streams.")
  (tparam %a "Type of emitted elements.")
  (see make-observer inbox-observer))

;; ---------------------------------------------------------------------------
;; Request and reply
;; ---------------------------------------------------------------------------

(:doc inbox-call
  (summary "Enqueues a request as a Call and returns a task representing the eventual response. Safe from any thread.")
  (arg ib "The request/reply inbox.")
  (arg request "The request payload.")
  (returns "A Task completing when a fiber responds via @code{call-reply!} or @code{call-fail!}.")
  (see inbox-call/token inbox-try-call call-request call-reply!)
  (reference """
    Enqueues the request without blocking, adhering to @code{WhenFull}. If
    rejected or evicted, the task faults with @code{Bjoml.InboxFullException}.
    On a closed inbox, the task is cancelled immediately.
    """))

(:doc inbox-call/token
  (summary "Enqueues a request as a Call with a cancellation token, returning a response task.")
  (arg ib "The request/reply inbox.")
  (arg request "The request payload.")
  (arg token "Cancellation token to monitor (e.g. ASP.NET @code{RequestAborted}).")
  (returns "A Task completing when a fiber responds via @code{call-reply!} or @code{call-fail!}.")
  (see inbox-call call-abandoned inbox-try-call/token)
  (reference """
    Cancellation handling depends on the state of the call:
    @itemlist{
    @item{@strong{Queued:} The call is evicted from the queue and its task
    is cancelled immediately.}
    @item{@strong{Dequeued by a fiber:} The task is not cancelled
    automatically. Instead, @code{call-abandoned} triggers on the fiber,
    allowing the worker to handle abandonment safely.}
    }
    """))

(:doc inbox-try-call
  (summary "Attempts to post a request as a Call, returning None instead of faulting if full or closed.")
  (arg ib "The request/reply inbox.")
  (arg request "The request payload.")
  (returns "@code{(Some task)} if enqueued successfully; @code{None} if closed or full under @code{DropNewest}.")
  (see inbox-call inbox-try-call/token inbox-post!)
  (reference """
    Useful in HTTP middleware where returning a faulted task would trigger
    generic 500 error handlers rather than returning an explicit 503
    Service Unavailable response.
    """))

(:doc inbox-try-call/token
  (summary "Attempts to post a request as a Call with a cancellation token, returning None if rejected.")
  (arg ib "The request/reply inbox.")
  (arg request "The request payload.")
  (arg token "Cancellation token to monitor.")
  (returns "@code{(Some task)} if enqueued successfully; @code{None} if closed or full under @code{DropNewest}.")
  (see inbox-try-call inbox-call/token call-abandoned)
  (example """
    (match (inbox-try-call/token requests ctx (request-aborted ctx))
      ((Some answering) (cast Task answering))
      (None (set-status! (response-of ctx) 503) completed-task))
    """))

(:doc call-request
  (summary "Returns the request payload associated with a Call.")
  (arg c "The call instance.")
  (returns "The request value.")
  (see call-reply! call-fail!))

(:doc call-reply!
  (summary "Resolves a Call successfully with the provided response value.")
  (arg c "The call instance.")
  (arg value "The response value.")
  (returns "@code{#t} if this response resolved the call; @code{#f} if already completed or cancelled.")
  (see call-fail! call-abandoned)
  (reference """
    The first response or failure wins; subsequent resolutions are ignored.
    Callers awaiting the task resume on their original synchronization
    context or thread pool, not on the responding fiber's thread.
    """))

(:doc call-fail!
  (summary "Faults a Call with the provided exception.")
  (arg c "The call instance.")
  (arg e "The exception indicating failure.")
  (returns "@code{#t} if this failure completed the call; @code{#f} if already completed or cancelled.")
  (see call-reply!))

(:doc call-abandoned
  (summary "Returns a CML event that triggers if the caller's cancellation token cancels after dequeuing.")
  (arg c "The call instance.")
  (returns "An event enabled once cancellation is requested.")
  (see inbox-call/token inbox-try-call/token call-reply!)
  (example """
    (sync (choose (wrap (work-evt (call-request c))
                        (fun (v) (ignore (call-reply! c v))))
                  (wrap (call-abandoned c)
                        (fun (_) (ignore (call-fail! c (System.OperationCanceledException.)))))))
    """)
  (reference """
    Does not trigger for calls created without a cancellation token, nor for
    calls cancelled while still waiting in the queue.
    """))

;; ---------------------------------------------------------------------------
;; The token an inbox-call/token is given
;; ---------------------------------------------------------------------------

(:doc CancellationToken
  (summary "The .NET System.Threading.CancellationToken structure passed to inbox operations.")
  (see inbox-call/token inbox-send/token inbox-try-call/token))
