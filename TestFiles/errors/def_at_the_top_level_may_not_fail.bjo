;; A pattern at the top level has to match every value.
;;
;; What a `def` produces when its pattern does not match is the value of the
;; body it stands in, and a declaration list is not a body — so there is nowhere
;; for the `None` here to go, and no failure part to write either.

;; EXPECT-ERROR: at the top level there is nowhere else for one to go

(import (std prelude))

(: found (-> (Option int)))
(defun (found) (Some 1))

(def (Some n) (found))
