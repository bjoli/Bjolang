;; Literal elaboration against a union that came out of a compiled module.
;;
;; Selection reads the union's cases out of the registry, and an imported one is
;; rebuilt from the metadata `proclit` published. `#:literal` is part of that:
;; without it two of `Item`'s cases carry a list, and every nested literal below
;; would be ambiguous here while compiling fine where the type is declared.
(import (std prelude))
(import "inc/proclit.bjo")
(import (std simpletest))

(defun (main args)
  (expect "imported union, nested literal"
          (show-items '(a (b "c") d))
          "a (b c) d")

  ;; The unmarked case, written out. Its own payload type is pushed into the
  ;; literal the same way a function's parameter type is.
  (expect "imported union, explicit case"
          (show-items (list (Sym 'x) (Args (list "y" "z"))))
          "x args:2")
  0)
