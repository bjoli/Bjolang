;; Implementations for (List int) and (List string). An implementation is
;; chosen by the head of the type, so the second replaced the first, and a call
;; at (List int) failed with a mismatch at the call rather than at the impl.

;; EXPECT-ERROR: 'Describe' already has an implementation for (List int), at impl_same_head.bjo:12:1. An implementation is chosen by the head of the type, List, and not by its arguments

(import (std prelude))

(def/trait (Describe %a)
  (: describe (-> %a string)))

(impl (Describe (List int))
  (defun (describe xs) "ints"))

(impl (Describe (List string))
  (defun (describe xs) "strings"))

(defun (main args)
  (println (describe (list 1)))
  0)
