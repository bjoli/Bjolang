;; `,x` is reserved rather than unknown: a pattern built from a value at run
;; time is the obvious next thing to want, and the message says it is not there
;; rather than complaining about punctuation.

;; EXPECT-ERROR: cannot splice a value in
;; EXPECT-ERROR: Dynamically built patterns are not supported

(import (std prelude))
(import (std rx))

(defun (main)
  (def letters "abc")
  (println (->str (rx-match? #rx((+ ,letters)) "a")))
  0)
