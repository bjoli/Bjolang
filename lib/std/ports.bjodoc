;; Docs for std/ports.bjo, read through (:doc #:file "ports.bjodoc"). The
;; texts are samizdat markup: code in prose is @code{...}.

(:doc #:module
  (summary "Byte-level I/O operations, CML event-driven reads, streaming conversions, and port adapters.")
  (see read-some-evt read-some read-bytes peek-bytes write-bytes! shutdown! byte-pipe port->vec port->chan)
  (example """
    (import (std ports))

    ;; Read a 4-byte length header followed by the payload.
    (defbjo (read-frame in)
      (match (read-bytes in 4)
        ((Some header) (read-bytes in (frame-length header)))
        (None None)))
    """)
  (example """
    ;; Read available bytes with a 1-second timeout.
    (match (sync (choose (read-some-evt in)
                         (wrap (timeout 1000) (fun (_) (Ok None)))))
      ((Ok (Some bytes)) (use bytes))
      ((Ok None) (log "EOF or stream completed"))
      ((Err e) (raise e)))
    """)
  (example """
    ;; In-memory bidirectional pipe for unit testing without network/file I/O.
    (match (byte-pipe)
      ((Tuple in out)
       (write-string out "hello\n")
       (close-output-port out)
       (read-line in)))           ; "hello"
    """)
  (reference """
    An @code{InputPort} represents an underlying stream of binary bytes.
    Textual functions like @code{read-line} and @code{read-char} decode UTF-8
    data from the port. Binary functions like @code{read-some},
    @code{read-bytes}, and @code{peek-bytes} read raw byte sequences directly.
    Both textual and binary operations can be interleaved on the same port.

    An @code{OutputPort} supports both UTF-8 text (@code{write-string},
    @code{write-char}) and binary byte arrays (@code{write-bytes!}).

    @strong{Event-based reads in @code{choose}.} Inbound data read from the
    underlying stream is stored in the port's internal buffer. An event-based
    read consumes bytes from this buffer only when its branch wins
    synchronization in @code{choose}. If another branch synchronizes first,
    no bytes are consumed, leaving the buffered bytes available for subsequent
    read operations.

    Byte-reading operations are available as CML events:
    @code{read-some-evt}, @code{read-bytes-evt}, and @code{eof-evt}.
    Synchronous wrappers (@code{read-some}, @code{read-bytes}) synchronize
    these events directly.

    @strong{Draining and streaming.} @code{port->list}, @code{port->vec},
    and @code{port->lines} eagerly consume a port until EOF. @code{port->seq}
    and @code{file->seq} provide lazy evaluation sequences.
    @code{port->chan} offloads reads to a dedicated background fiber that sends
    items over a channel.

    @strong{Stream adapters.} Files are opened via prelude functions
    @code{open-input-file} and @code{open-output-file}. .NET @code{Stream}
    instances can be adapted using @code{stream->input-port} and
    @code{stream->output-port}. Bidirectional network streams are supported
    via @code{(std net)}.

    See @code{BjolangRuntime/BjoInputPort.cs} for input port implementation
    details.
    """))

;; ---------------------------------------------------------------------------
;; Draining
;; ---------------------------------------------------------------------------

(:doc port->list
  (summary "Consumes items from a port until EOF, returning them as a list.")
  (arg reader "Reader function or bjoroutine invoked to read each item.")
  (arg p "The input port.")
  (returns "A list of read items in order of occurrence.")
  (see port->vec port->lines port->seq port->chan)
  (example """
    (port->list read-char (open-input-string "abc"))   ; (#\\a #\\b #\\c)
    """)
  (reference """
    The reader is invoked repeatedly while @code{port-eof?} returns @code{#f}.
    The reader must consume input on each invocation to prevent an infinite
    loop.

    If @code{reader} is a bjoroutine, calls suspend cooperatively. If it is
    a standard synchronous function, calls block the active thread. The port
    is not closed automatically.
    """))

(:doc port->vec
  (summary "Consumes items from a port until EOF, returning them as a vector.")
  (arg reader "Reader function or bjoroutine invoked to read each item.")
  (arg p "The input port.")
  (returns "A vector containing all read items in order.")
  (see port->list port->lines port->chan)
  (reference """
    Equivalent to @code{port->list}, but collects items into an indexed
    vector.
    """))

(:doc port->lines
  (summary "Reads all remaining lines from a port into a list.")
  (arg port "The input port.")
  (key mode "Line delimiter mode (defaults to @code{Any}).")
  (returns "A list of strings containing remaining lines without delimiters.")
  (see port->vec read-line LineMode)
  (reference """
    Reads synchronously using @code{read-line}. To suspend cooperatively
    within a bjoroutine, use @code{port->vec} with a bjoroutine reader.
    """))

;; ---------------------------------------------------------------------------
;; Streaming
;; ---------------------------------------------------------------------------

(:doc port->seq
  (summary "Returns a lazy sequence of items read from a port.")
  (arg reader "Reader function invoked to produce each item.")
  (arg p "The input port.")
  (returns "A lazy sequence that reads from the port as elements are evaluated.")
  (see port->vec port->chan file->seq)
  (reference """
    Items are read on demand during sequence iteration, not at sequence
    creation time. The port is not closed upon completion. Reading mutates
    port state, so repeated traversals continue from where the previous
    traversal ended.

    Sequence evaluation cannot suspend cooperatively; within a bjoroutine,
    use @code{port->vec} or @code{port->chan} instead.
    """))

(:doc file->seq
  (summary "Returns a lazy sequence of items read from a file path.")
  (arg reader "Reader function invoked on the file's input port.")
  (arg path "Path to the target file.")
  (returns "@code{(Ok seq)} on success, or @code{(Err e)} if the file cannot be opened.")
  (see file-read/seq port->seq)
  (reference """
    The file is initially opened to verify accessibility and immediately
    closed. Each sequence iteration opens the file anew, reads from the
    beginning, and closes it upon reaching EOF.
    """))

;; ---------------------------------------------------------------------------
;; Streaming that suspends
;; ---------------------------------------------------------------------------

(:doc port->chan
  (summary "Spawns a fiber that reads items from a port and streams them over a channel.")
  (arg reader "Bjoroutine reader invoked to read each item.")
  (arg p "The input port.")
  (returns "A tuple containing the output channel and a completion promise holding the count of read items.")
  (raises Bjolang.Runtime.ScopeEnded "When invoked outside an ambient structured concurrency scope.")
  (see chan-next port->vec)
  (example """
    (match (port->chan read-line port)
      ((Tuple lines done)
       (let go ()
         (match (chan-next lines done)
           ((Some line) (handle line) (go))
           (None 'finished)))))
    """)
  (reference """
    The producer fiber executes within the ambient scope. The unbuffered
    channel ensures backpressure: the worker fiber reads the next item only
    after the receiver consumes the previous one. The port is not closed
    automatically.

    If the reader throws an exception, the completion promise fails and no
    further items are emitted.
    """))

(:doc chan-next
  (summary "Fetches the next item from a port->chan stream, or None at EOF.")
  (arg c "The channel returned by @code{port->chan}.")
  (arg done "The completion promise returned by @code{port->chan}.")
  (returns "@code{(Some item)} if an item is available, or @code{None} if the stream completed.")
  (see port->chan)
  (reference """
    Synchronizes on both the channel and the completion promise. To check
    for errors after @code{None} is returned, join the completion promise:
    @code{(sync (promise-join done))}.
    """))

;; ---------------------------------------------------------------------------
;; Bytes: the types
;; ---------------------------------------------------------------------------

(:doc Stream
  (summary "The .NET System.IO.Stream type wrapped by Bjolang ports.")
  (see stream->input-port stream->output-port))

;; ---------------------------------------------------------------------------
;; Reading, as events
;; ---------------------------------------------------------------------------

(:doc read-some-evt
  (summary "Returns a CML event that reads available bytes from the port buffer.")
  (arg p "The input port.")
  (returns "An event yielding @code{(Ok (Some bytes))} with at least 1 byte, @code{(Ok None)} at EOF, or @code{(Err e)} on I/O failure.")
  (see read-some read-bytes-evt eof-evt)
  (reference """
    First-class CML event. If another branch in @code{choose} synchronizes
    first, no bytes are consumed and the buffer contents remain intact.

    The event is ephemeral: each synchronization evaluates against the
    current port state, allowing repeated reads in a loop without stale
    cached results.
    """))

(:doc read-bytes-evt
  (summary "Returns a CML event that reads exactly n bytes, or remaining bytes at EOF.")
  (arg p "The input port.")
  (arg n "Target byte count. Must be at least 1.")
  (returns "An event yielding @code{(Ok (Some bytes))}, @code{(Ok None)} at EOF, or @code{(Err e)} on failure.")
  (raises System.ArgumentOutOfRangeException "When n is less than 1.")
  (see read-bytes read-some-evt)
  (reference """
    If EOF is reached before n bytes are read, any remaining bytes are
    yielded as @code{(Some bytes)}, and the subsequent read yields
    @code{None}.
    """))

(:doc eof-evt
  (summary "Returns a CML event that triggers when a port reaches EOF or encounters an error.")
  (arg p "The input port.")
  (returns "An event enabled when no further bytes can be read.")
  (see read-some-evt port-eof?)
  (reference """
    Triggers when the port buffer is exhausted and no further input can
    arrive. Useful for detecting peer disconnections in network protocols.
    """))

;; ---------------------------------------------------------------------------
;; Reading, for when there is nothing to choose between
;; ---------------------------------------------------------------------------

(:doc read-some
  (summary "Reads available bytes from the port, blocking or suspending until at least one byte arrives.")
  (arg p "The input port.")
  (returns "@code{(Some bytes)} containing at least 1 byte, or @code{None} at EOF.")
  (raises System.IO.IOException "When an underlying stream I/O failure occurs.")
  (see read-some-evt read-bytes)
  (reference """
    Synchronizes on @code{read-some-evt}. Suspends cooperatively within a
    bjoroutine; blocks the thread in standard synchronous code.
    """))

(:doc read-bytes
  (summary "Reads exactly n bytes, or remaining bytes at EOF.")
  (arg p "The input port.")
  (arg n "Number of bytes to read. Must be at least 1.")
  (returns "@code{(Some bytes)} (shorter than n only at EOF), or @code{None} if already at EOF.")
  (raises System.ArgumentOutOfRangeException "When n is less than 1.")
  (raises System.IO.IOException "When an underlying stream I/O failure occurs.")
  (see read-bytes-evt read-some peek-bytes))

;; ---------------------------------------------------------------------------
;; Looking without taking
;; ---------------------------------------------------------------------------

(:doc peek-bytes
  (summary "Inspects bytes ahead of the port cursor without consuming them.")
  (arg p "The input port.")
  (arg skip "Number of bytes to skip before peeking. Must be non-negative.")
  (arg count "Number of bytes to peek. Must be non-negative.")
  (returns "@code{(Some bytes)} (shorter than count at EOF), or @code{None} if EOF occurs before skip.")
  (raises System.ArgumentOutOfRangeException "When skip or count is negative.")
  (raises System.IO.IOException "When the stream fails and the buffer is empty.")
  (see read-bytes reencode-input-port)
  (example """
    ;; Inspect magic bytes before choosing a decompression strategy:
    (match (peek-bytes in 0 2)
      ((Some magic) (if (gzip-magic? magic) (inflate in) (plain in)))
      (None (empty)))
    """)
  (reference """
    Buffers data until the requested range is satisfied or EOF is reached.
    Bytes remain in the port buffer and can subsequently be consumed by
    @code{read-bytes} or textual readers.
    """))

;; ---------------------------------------------------------------------------
;; Writing
;; ---------------------------------------------------------------------------

(:doc write-bytes!
  (summary "Writes a byte array to an output port.")
  (arg p "The output port.")
  (arg bytes "Byte array to write.")
  (raises System.InvalidOperationException "When called after shutdown! has closed the output side.")
  (see flush-port shutdown! write-string)
  (reference """
    Output ports are buffered. Writes that fill the buffer trigger a flush to
    the underlying stream, suspending cooperatively in fibers or blocking in
    synchronous functions.
    """))

;; ---------------------------------------------------------------------------
;; The half-close
;; ---------------------------------------------------------------------------

(:doc shutdown!
  (summary "Shuts down the write half of a duplex port while keeping the read half open.")
  (arg p "The output port.")
  (see write-bytes! flush-port byte-pipe)
  (reference """
    Flushes buffered data and transmits a shutdown signal (e.g. TCP FIN or
    pipe EOF) to the peer. Subsequent write operations throw
    @code{InvalidOperationException}. The port must still be closed with
    @code{close-output-port} to release underlying system handles.
    """))

;; ---------------------------------------------------------------------------
;; Composition
;; ---------------------------------------------------------------------------

(:doc limited
  (summary "Wraps an input port to read at most n bytes before reporting EOF.")
  (arg p "The source input port.")
  (arg n "Maximum number of bytes to read. Must be non-negative.")
  (returns "A new limited input port reading through p.")
  (raises System.ArgumentOutOfRangeException "When n is negative.")
  (see byte-pipe reencode-input-port)
  (example """
    ;; Read a fixed-length HTTP body as text lines without consuming trailing data:
    (port->lines (limited conn content-length))
    """)
  (reference """
    Reads through the underlying port's buffer without skipping or
    duplicating data. Closing the limited port does not close the underlying
    source port.
    """))

(:doc byte-pipe
  (summary "Creates an in-memory duplex byte pipe.")
  (returns "A pair of (input-port, output-port).")
  (see limited shutdown! stream->input-port)
  (reference """
    An unbounded in-memory pipe suitable for testing and internal message
    buffering. Writes do not block. Closing or shutting down the output port
    signals EOF to the input port once buffered bytes are drained.
    """))

;; ---------------------------------------------------------------------------
;; Sources
;; ---------------------------------------------------------------------------

(:doc stream->input-port
  (summary "Wraps a .NET Stream in a Bjolang input port.")
  (arg s "The .NET Stream instance.")
  (returns "A new input port reading from s.")
  (raises Bjolang.Runtime.ScopeEnded "When called without an ambient structured concurrency scope.")
  (see stream->output-port)
  (reference """
    The port takes ownership of the stream. Closing the port or exiting the
    ambient concurrency scope disposes the underlying stream.
    """))

(:doc stream->output-port
  (summary "Wraps a .NET Stream in a Bjolang output port.")
  (arg s "The .NET Stream instance.")
  (returns "A new output port writing to s.")
  (raises Bjolang.Runtime.ScopeEnded "When called without an ambient structured concurrency scope.")
  (see stream->input-port)
  (reference """
    The port takes ownership of the stream. Closing the port or exiting the
    ambient concurrency scope flushes and disposes the underlying stream.
    """))

;; ---------------------------------------------------------------------------
;; Encodings
;; ---------------------------------------------------------------------------

(:doc reencode-input-port
  (summary "Wraps an input port to transcode bytes from a specified encoding into UTF-8.")
  (arg p "The source input port.")
  (arg encoding "Source text encoding from @code{(text encodings)}.")
  (returns "A new input port yielding UTF-8 bytes.")
  (see reencode-output-port peek-bytes Encoding)
  (example """
    (import (only (text encodings) windows-1252))

    (read-line (reencode-input-port in windows-1252))
    """)
  (reference """
    Transcodes input on the fly into UTF-8. Unrecognized byte sequences are
    replaced with U+FFFD. Closing the re-encoded port does not close the
    underlying source port.
    """))

(:doc reencode-output-port
  (summary "Wraps an output port to transcode outgoing UTF-8 bytes into a specified target encoding.")
  (arg p "The destination output port.")
  (arg encoding "Target text encoding from @code{(text encodings)}.")
  (returns "A new output port accepting UTF-8 bytes.")
  (see reencode-input-port Encoding)
  (reference """
    Transcodes UTF-8 input into the target encoding before writing to p.
    Characters not representable in the target encoding are replaced with
    fallback characters. Closing the wrapped port flushes remaining data to
    p while leaving p open.
    """))
