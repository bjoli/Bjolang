;; Annoteringen nålar fast `#:elem` vid `int`, och värdets egen implementation
;; av `Iterable` säger `string`. Det är ett vanligt unifieringsfel — `prune`
;; löser projektionen så snart implementortypen är känd — med en rad om vilken
;; association de två är svar på.
;;
;; EXPECT-ERROR: They are what #:elem is pinned to on either side of a (dyn Iterable ...)
;; EXPECT-ERROR: string

(import (std prelude))

(: d (dyn Iterable #:elem int #:cursor (List string)))
(def d (dyn Iterable (list "a")))

(defun (main args) 0)
