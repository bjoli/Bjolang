;; A collection compares with the key's Eq or Ord, not field by field.
;;
;; Each key type below has an Eq or Ord that is not its fields: an unordered
;; pair, and two union cases `=` equates. The collections and .NET's own
;; Equals, GetHashCode and CompareTo all give `=`'s answer. Before, the first
;; three were lookups that silently missed and the fourth threw at its second
;; element.

(import (std prelude))
(import (std hashset))
(import (std orderedmap))
(import (std orderedset))
(import (std simpletest))

;; An unordered pair.
(type (: (Pair %a) (Record (: fst %a) (: snd %a))))

(impl (Eq (Pair %a))
  (where (Eq %a))
  (defun (= x y)
    (or (and (= (.fst x) (.fst y)) (= (.snd x) (.snd y)))
        (and (= (.fst x) (.snd y)) (= (.snd x) (.fst y)))))
  (defun (eq-hash p) (bitwise-xor (eq-hash (.fst p)) (eq-hash (.snd p)))))

;; Ordered by the first component alone.
(impl (Ord (Pair %a))
  (where (Ord %a))
  (defun (compare x y) (compare (.fst x) (.fst y))))

(: (-> int int (Pair int)))
(defun (pair a b) (Pair (fst a) (snd b)))

;; Two cases `=` equates.
(type (: Money (Union (: Cents int) (: Dollars int))))

(: (-> Money int))
(defun (money->cents m)
  (match m ((Cents c) c) ((Dollars d) (* d 100))))

(impl (Eq Money)
  (defun (= x y) (= (money->cents x) (money->cents y)))
  (defun (eq-hash m) (eq-hash (money->cents m))))

;; .NET's own equality of a union is the union's, so it agrees with `=` across
;; cases: what a Dictionary through interop, or LINQ, would see. Money is a
;; struct union; Tally contains itself, so it is a class.
(type-rec (: Tally (Union (: Ones int) (: Tens int) (: Both Tally Tally))))

(: (-> Tally int))
(defun (tally-value t)
  (match t ((Ones n) n) ((Tens n) (* 10 n)) ((Both a b) (+ (tally-value a) (tally-value b)))))

(impl (Eq Tally)
  (defun (= x y) (= (tally-value x) (tally-value y)))
  (defun (eq-hash t) (eq-hash (tally-value t))))

(import/class (Obj (: System.Object)))
(import/extern
  (object-equals (: System.Object.Equals (-> Obj Obj bool)))
  (object-hash (: System.Object.GetHashCode (-> Obj int))))

;; A generic function that never mentions Eq: the constraint is inferred, and
;; the caller's evidence is what reaches the set.
(: (-> (List %a) int))
(defun (distinct-count xs) (hashset-length (list->hashset xs)))

(defun (main)
  (expect "a Map keyed on an unordered pair"
          (map-length (map-set (map-set (map-empty) (pair 1 2) "a") (pair 2 1) "b"))
          1)
  (expect-true "finds the other order"
               (some? (map-try-ref (list->map (list (Tuple (pair 1 2) "a"))) (pair 2 1))))
  (expect "an OrderedSet ordered by its Ord"
          (orderedset-length (list->orderedset (list (pair 1 2) (pair 3 1) (pair 2 2) (pair 1 5))))
          3)
  (expect "an OrderedMap likewise"
          (orderedmap-length (orderedmap-set (orderedmap-set (orderedmap-empty) (pair 1 9) "a") (pair 1 2) "b"))
          1)
  (expect "through a generic function" (distinct-count (list (Cents 100) (Dollars 1) (Cents 5))) 2)
  (expect "a list of such keys"
          (map-length (list->map (list (Tuple (list (Cents 100)) 1) (Tuple (list (Dollars 1)) 2))))
          1)
  (expect "a set mapped into a new element type asks that type"
          (hashset-length (hashset-map (fun (c) (if (= c 100) (Cents c) (Dollars 1))) (list->hashset (list 100 200))))
          1)
  (expect "a filtered set keeps its comparer"
          (hashset-length (hashset-add (hashset-filter (fun (m) #t) (list->hashset (list (Cents 100)))) (Dollars 1)))
          1)
  (expect "an emptied map keeps it"
          (map-length (map-set (map-set (map-clear (map-set (map-empty) (Cents 1) 0)) (Cents 100) 1) (Dollars 1) 2))
          1)
  (expect "a collected map asks the key's Eq"
          (map-length {mapping (Tuple m 0) (:for m (list (Cents 100) (Dollars 1)))})
          1)
  (expect "Object.Equals of two cases is the union's Eq"
          (object-equals (cast Obj (Cents 100)) (cast Obj (Dollars 1)))
          #t)
  (expect "and so is GetHashCode"
          (= (object-hash (cast Obj (Cents 100))) (object-hash (cast Obj (Dollars 1))))
          #t)
  (expect "a union that is a class: Object.Equals of two cases"
          (object-equals (cast Obj (Tens 2)) (cast Obj (Both (Ones 10) (Tens 1))))
          #t)
  (expect "and GetHashCode"
          (= (object-hash (cast Obj (Tens 2))) (object-hash (cast Obj (Both (Ones 10) (Tens 1)))))
          #t)
  (expect "Object.Equals of two unordered pairs"
          (object-equals (cast Obj (pair 1 2)) (cast Obj (pair 2 1)))
          #t)
  (expect "a case of it is still matched by position"
          (match (Both (Ones 1) (Tens 2)) ((Both (Ones a) (Tens b)) (+ a b)) (_ 0))
          3)
  0)
