;; Re-exporting a method of a trait this module declares.
;;
;; As for a type this module declares (`reexport_own_type.bjo`): `re-export`
;; passes on what this module imported, and this trait is its own. `export` is
;; the form, and publishes the trait with its methods.

;; EXPECT-ERROR: a trait this module declares

(import (std prelude))

(def/trait (Sings %a)
  (: sing (-> %a string)))

(re-export sing)

(defun (main args) 0)
