;; An `Eq` implementation for an `import/class` alias.
;;
;; The orphan rule refuses it: a .NET type is declared by no module, so only
;; the module that declares `Eq` may implement it. It would also answer `=`
;; while `Map` and `HashSet` ask the type's own `Equals`, already compiled into
;; it by .NET. The way out is a wrapper type.

;; EXPECT-ERROR: is a .NET type, so 'Eq' cannot be implemented for it
;; EXPECT-ERROR: wrapper type

(import (std prelude))

(import/class
  (Uri (: System.Uri)))

(impl (Eq Uri)
  (defun (= a b) #t)
  (defun (eq-hash a) 0))

(defun (main args) 0)
