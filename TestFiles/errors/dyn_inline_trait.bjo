;; En inline-trait skriver sin implementor applicerad, så den har inget
;; gränssnitt och ingen ordbok. Det finns alltså varken något att radera eller
;; något att dispatcha genom.
;;
;; EXPECT-ERROR: 'Monad' applies its implementor
;; EXPECT-ERROR: no interface and no dictionary

(import (std prelude))
(import (std monad))

(: run-it (-> (dyn Monad) int))
(defun (run-it d) 0)

(defun (main args) 0)
