;; A generic type constructed at a type that breaks its constraint.

;; EXPECT-ERROR: which needs T to be a value type (struct), and here T is System.Text.StringBuilder

(import (std prelude))
(import/class
  ((Nul %a) (: System.Nullable (-> %a (Nul %a))))
  (StringBuilder (: System.Text.StringBuilder (-> StringBuilder))))
(defun (main) (ignore (Nul. (StringBuilder.))))
