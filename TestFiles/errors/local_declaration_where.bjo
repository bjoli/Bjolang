;; EXPECT-ERROR: has a (where ...), and a definition in a body cannot have one

;; A local function cannot take trait dictionaries of its own.

(import (std prelude))

(: outer (-> int))
(defun (outer)
  (: helper (-> %a int) (where (Num %a)))
  (defun (helper x) 1)
  (helper 1))

(defun (main args) (println (outer)) 0)
