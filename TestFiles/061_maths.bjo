;; `std/maths.bjo` through its compiled .dll.
;;
;; The `Num` methods are overload sets that cross the boundary as a trait; the
;; rest of `System.Math` crosses as the imports themselves.
(import (std maths))
(import (std prelude))
(import (std simpletest))

;; A `Num`-constrained function defined on this side of the boundary, dispatched
;; through a dictionary built from the imported impls.
;;
;; Only trait methods are asked of `%a`: arithmetic on a constrained type
;; variable is a separate matter, since `+` is not a member of any trait and C#
;; has no operator to emit for an unconstrained generic parameter.
(: spread (-> %a %a %a) (where (Num %a)))
(defun (spread x y)
  (max (abs x) (abs y)))

(defun (main)
  ;; One name, three types, three different .NET methods.
  (expect "abs int" (abs -5) 5)
  (expect "abs long" (long->string (abs -3000000000L)) "3000000000")
  (expect "abs double" (double->string (abs -2.5)) "2.5")

  ;; The result type need not mention the implementor.
  (expect "sign negative" (sign -2.5) -1)
  (expect "sign zero" (sign 0) 0)
  (expect "sign positive" (sign 42L) 1)
  (expect "sqrt of an int" (double->string (sqrt 9)) "3")
  (expect "sqrt of a double" (double->string (sqrt 2.25)) "1.5")

  (expect "min int" (min 3 9) 3)
  (expect "max double" (double->string (max 1.5 2.5)) "2.5")
  (expect "clamp below" (clamp 1 3 9) 3)
  (expect "clamp inside" (clamp 5 3 9) 5)
  (expect "clamp above" (clamp 99 3 9) 9)

  ;; Through a dictionary rather than devirtualized.
  (expect "constrained generic, int" (spread -7 3) 7)
  (expect "constrained generic, double" (double->string (spread -1.5 2.5)) "2.5")

  ;; The double functions: one method each, imported and re-exported as such.
  (expect "floor" (double->string (floor 2.7)) "2")
  (expect "ceiling" (double->string (ceiling 2.1)) "3")
  (expect "truncate" (double->string (truncate -2.7)) "-2")
  (expect "round" (double->string (round 2.5)) "2")
  ;; 27 is not a case cube root gets exactly right — `Math.Cbrt(27.0)` is
  ;; 3.0000000000000004 — so this asks for a power of two, which it does.
  (expect "cbrt" (double->string (cbrt 8.0)) "2")
  (expect "exp of zero" (double->string (exp 0.0)) "1")
  (expect "pow" (double->string (pow 2.0 10.0)) "1024")
  (expect "log2" (double->string (log2 8.0)) "3")
  (expect "log10" (double->string (log10 1000.0)) "3")
  (expect "loge" (double->string (loge 1.0)) "0")
  ;; The other half of `System.Math.Log`, under a name of its own: one logarithm
  ;; per base, and no name whose meaning depends on its arity.
  (expect "log-base" (double->string (log-base 8.0 2.0)) "3")
  (expect "sin of zero" (double->string (sin 0.0)) "0")
  (expect "cos of zero" (double->string (cos 0.0)) "1")
  (expect "atan2" (double->string (atan2 0.0 1.0)) "0")
  (expect "sinh of zero" (double->string (sinh 0.0)) "0")
  (expect "acosh of one" (double->string (acosh 1.0)) "0")

  ;; Integer division, Racket's way. The four sign combinations are where
  ;; remainder and modulo differ.
  (expect "quotient" (quotient -7 2) -3)
  (expect "remainder" (remainder -7 2) -1)
  (expect "modulo, negative dividend" (modulo -7 2) 1)
  (expect "modulo, negative divisor" (modulo 7 -2) -1)
  (expect "modulo, both negative" (modulo -7 -2) -1)
  (expect "modulo, exact" (modulo -6 3) 0)
  (expect "modulo of a long" (long->string (modulo -7L 3L)) "2")
  (expect "modulo of a uint" (modulo 7u 3u) 1u)
  (expect "quotient/remainder" (quotient/remainder 17 -5) (Tuple -3 2))

  ;; The integer functions.
  (expect "gcd" (gcd -12 18) 6)
  (expect "gcd with zero" (gcd 0 5) 5)
  (expect "lcm" (lcm 4 -6) 12)
  (expect "lcm with zero" (lcm 0 3) 0)
  (expect "expt" (expt 2 10) 1024)
  (expect "expt to zero" (expt 7 0) 1)
  (expect "expt of a long" (long->string (expt 10L 18)) "1000000000000000000")
  (expect "a negative exponent is refused"
          (match (try (expt 2 -1) #:catch (System.ArgumentOutOfRangeException))
            ((Ok _) #f)
            ((Err _) #t))
          #t)
  (expect "integer-sqrt" (integer-sqrt 15) 3)
  (expect "integer-sqrt, exact" (integer-sqrt 16) 4)
  (expect "integer-sqrt at int-max" (integer-sqrt int-max) 46340)
  (expect "integer-sqrt of a uint, at its largest" (integer-sqrt 4294967295u) 65535u)
  (expect "sqr" (sqr -3) 9)
  (expect "zero is not positive" (positive? 0) #f)
  (expect "negative?" (negative? -0.5) #t)

  ;; Doubles.
  (expect "nan?" (nan? (/ 0.0 0.0)) #t)
  (expect "infinite?" (infinite? (/ -1.0 0.0)) #t)
  (expect "finite?" (finite? 1.0) #t)
  (expect "pi" (double->string pi) "3.141592653589793")
  (expect "exact-round, half to even" (exact-round 2.5) 2)
  (expect "exact-floor" (exact-floor -2.5) -3)
  (expect "exact-ceiling" (exact-ceiling -2.5) -2)
  (expect "exact-truncate" (exact-truncate -2.5) -2)
  (expect "NaN has no int"
          (match (try (exact-round (/ 0.0 0.0)) #:catch (System.OverflowException))
            ((Ok _) #f)
            ((Err _) #t))
          #t)
  0)
