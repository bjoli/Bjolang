;; A redirection without one of its two items.
;;
;; `(into-file string Form)` takes a file name and the one form to run. The
;; compiler reads the items where you write the literal, so it refuses a form
;; without one of them there, not `run` at start-up.

;; EXPECT-ERROR: (into-file ...): expected Form; found the end of the list

(import (std prelude))
(import (std run))

(defun (main args)
  (ignore
   (match (run/string '(into-file "out.txt"))
     ((Ok s) 0)
     ((Err e) 0)))
  0)
