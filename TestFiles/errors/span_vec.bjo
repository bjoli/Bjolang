;; A span cannot be a type argument of a generic function.
;; EXPECT-ERROR: 'vec-length' is generic, and here one of its type variables would be a (System.Span long)
(import (std prelude))
(import/extern
  (whole (: System.MemoryExtensions.AsSpan (-> (Array %a) (System.Span %a))))
  (sleep (: System.Threading.Tasks.Task.Delay (-> int void) #:async #:uncancellable)))
(: (-> (System.Span long) int))
(defun (len s) (.-Length s))

(defun (main) (def xs (vec->array [1L])) (println (vec-length [(whole xs)])) 0)
