;; `set!` writes a field step with `record-set!`, so a .NET property as the last
;; step is refused where it is written. Before the last step it is only read,
;; and that is allowed.

;; EXPECT-ERROR: .-Length is a .NET property, and set! writes the last step with record-set!

(import (std prelude))

(defun (main args)
  (def s "abc")
  (set! s .-Length 2)
  0)
