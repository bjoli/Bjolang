;; EXPECT-ERROR: (url ...): expected (port ...), (user ...), (path ...), (query ...), (fragment ...) or the end of the list; found (qeury ...)
;;
;; The grammar `url/Link` reads a URL literal where it is written. A misspelt
;; part is a compile error, not a URL with the wrong text in it.

(import (std url))

(defun (main args)
  (println (link '(url https "example.com" (qeury (q "x")))))
  0)
