;; A def whose initialiser reads the imported value of its own name. The use
;; meant the import to the checker and the module's unset field to the emitted
;; code: this printed 1, not 6.

;; EXPECT-ERROR: `k` is read by its own definition

(import (std prelude))
(import "../inc/value_k.bjo")

(: k int)
(def k (+ k 1))

(defun (main args)
  (println (->str k))
  0)
