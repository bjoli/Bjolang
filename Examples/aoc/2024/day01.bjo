;; Day 1: Historian Hysteria. Two columns of location IDs. Part 1 pairs the
;; smallest with the smallest, and so on, and sums the distances. Part 2 sums
;; each left ID times the number of times it is in the right column.
(import (std prelude))
(import (std maths))
(import (std mutable map))
(import "common.bjo")

(defun (main args)
  (def pairs {vecing (let ((cols (string-split (string-trim line) "   ")))
                        (Tuple (parse-long (vec-ref cols 0)) (parse-long (vec-ref cols 1))))
                      (:for line (input-lines args))})
  (def left (vec-sort (vec-map fst pairs)))
  (def right (vec-sort (vec-map snd pairs)))
  (println {summing (abs (- a b)) (:for a left) (:for b right)})
  (def counts (mutablemap))
  (loop (:for b right)
        (:do (mutablemap-set! counts b (+ 1L (mutablemap-ref-or counts b 0L)))))
  (println {summing (* a (mutablemap-ref-or counts a 0L)) (:for a left)})
  0)
