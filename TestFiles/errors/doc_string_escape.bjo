;; EXPECT-ERROR: this string writes \q, which source keeps as a backslash and q but a published doc cannot
;; Source keeps an escape it does not define as the two characters, and
;; bjodat refuses one, so the published docs would not read back.
(import (std prelude))

(:doc twice
  (summary "Doubles \q a number.")
  (arg n "The number.")
  (returns "Twice n."))
(: twice (-> int int))
(defun (twice n) (* 2 n))

(defun (main args) 0)
