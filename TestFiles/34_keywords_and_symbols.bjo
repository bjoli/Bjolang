;; Test for first-class Keywords and Symbols with runtime interning
(import (std prelude))

(: match-kw (-> Keyword int))
(defun (match-kw k)
  (match k
    (:apple 1)
    (:banana 2)
    (:cherry 3)
    (_ 0)))

(: match-sym (-> Symbol string))
(defun (match-sym s)
  (match s
    ('alpha "first")
    ('beta "second")
    ('gamma "third")
    (_ "unknown")))

(defun (main)
  ;; 1. Keyword reference equality and syntax equivalence (:kw vs #:kw)
  (if (eq? :foo #:foo)
      (println "keyword eq pass")
      (println "keyword eq fail"))

  (if (not (eq? :foo :bar))
      (println "keyword neq pass")
      (println "keyword neq fail"))

  ;; 2. Symbol reference equality
  (if (eq? 'test 'test)
      (println "symbol eq pass")
      (println "symbol eq fail"))

  (if (not (eq? 'alpha 'beta))
      (println "symbol neq pass")
      (println "symbol neq fail"))

  ;; 3. Conversions
  (println (keyword->string :hello))
  (println (symbol->string 'world))
  (if (eq? (string->keyword "dynamic") :dynamic)
      (println "string->keyword pass")
      (println "string->keyword fail"))
  (if (eq? (string->symbol "sym-dyn") 'sym-dyn)
      (println "string->symbol pass")
      (println "string->symbol fail"))

  ;; 4. Predicates
  (if (keyword? :foo) (println "keyword? pass") (println "keyword? fail"))
  (if (not (keyword? "foo")) (println "not keyword? pass") (println "not keyword? fail"))
  (if (symbol? 'foo) (println "symbol? pass") (println "symbol? fail"))
  (if (not (symbol? 42)) (println "not symbol? pass") (println "not symbol? fail"))

  ;; 5. Pattern matching
  (println (int->string (match-kw :apple)))
  (println (int->string (match-kw :banana)))
  (println (int->string (match-kw :cherry)))
  (println (int->string (match-kw :other)))

  (println (match-sym 'alpha))
  (println (match-sym 'beta))
  (println (match-sym 'gamma))
  (println (match-sym 'delta))

  ;; 6. ->str trait
  (println :trait-keyword)
  (println 'trait-symbol)

  ;; 7. Map usage
  (let ((m (map-set (map-set (map-empty) :first 10) :second 20)))
    (println (int->string (map-ref m :first)))
    (println (int->string (map-ref m :second))))

  0)
