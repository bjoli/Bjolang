;; A member's constraint with an associated type left unpinned.
;;
;; The clause pins every associated type of the trait it names, the way a dyn
;; type does — pinning to a fresh variable is how it says "don't care". Left
;; unpinned, the message names which one.

;; EXPECT-ERROR: the associated type #:cursor of 'Iterable' is not pinned

(import (std prelude))

(def/trait (Sink %c)
  (type %added)
  (: fill! (-> %c %s void)
     (where (Iterable %s #:elem %added))))

(defun (main) 0)
