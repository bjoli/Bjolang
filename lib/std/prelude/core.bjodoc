;; The module doc of std/prelude/core.bjo, read through (:doc #:file
;; "core.bjodoc"). The core's names are documented by area in the other
;; .bjodoc files beside it. The texts are samizdat markup: code in prose is
;; @code{...}.

(:doc #:module
  (summary "The part of the prelude that does not reach the operating system: collections, strings, characters, iteration and printing to a string.")
  (see list-map vec-map map-ref str written fold range)
  (example """
    (import (std prelude core))

    (def words (string-split "a b c" " "))
    (vec-length words)                       ; 3
    (loop (:for w words) (:acc (summing (string-length w))))   ; 3
    """)
  (reference """
    @code{(std prelude)} imports this module and re-exports all of it, so a
    program has its names without an import. Import it in place of
    @code{(std prelude)} only in a module that @code{(std prelude)} itself
    depends on.

    @strong{What is here.} Lists, vecs, maps and arrays, strings, characters
    and string cursors, the @code{Iterable}, @code{Collection} and
    @code{Collector} traits, @code{range} and the collectors,
    @code{Written} and @code{Displayed}, options and results, and the
    macros @code{if-let}, @code{when-let}, @code{some->}, @code{try->},
    @code{let*}, @code{parameterize*} and @code{type/derive}, the
    acc-clauses such as @code{oring}, the hash macros @code{#fl},
    @code{#fr}, @code{#ch}, @code{#map} and @code{#set!}, the path macros
    @code{get} and @code{set}, and the patterns @code{Has} and @code{Has*}.

    @strong{What is not.} Ports, files, directories and the process
    environment, effects, the clock and durations, cancellation scopes and
    @code{select} are in @code{(std prelude)}.
    """))
