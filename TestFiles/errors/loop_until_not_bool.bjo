;; An `:until` test has type bool, here as the first driver of the loop.

;; EXPECT-ERROR: these types do not match.
;; EXPECT-ERROR: bool
;; EXPECT-ERROR: string
;; EXPECT-ERROR: loop_until_not_bool.bjo:12

(import (std prelude))

(: f (-> int))
(defun (f)
  (loop (:until "done")
        (:acc s (summing 1))))

(defun (main) (println (int->string (f))) 0)
