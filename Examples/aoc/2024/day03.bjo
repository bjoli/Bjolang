;; Day 3: Mull It Over. Part 1 sums the products of the mul(X,Y)
;; instructions. Part 2 obeys do() and don't().
(import (std rx) "common.bjo")

(def instruction
  #rx(or (seq "mul(" (=> :x (** 1 3 :ascii-digit)) "," (=> :y (** 1 3 :ascii-digit)) ")")
         "do()"
         "don't()"))

(defun (main args)
  (def memory (string-join (input-lines args) "\n"))
  (def (all enabled)
    (loop (:for m (rx-matches instruction memory))
          (:with on? #t (case (rx-text m)
                          (("do()") #t)
                          (("don't()") #f)
                          (else on?)))
          (:when-let (Some x) (rx-group m :x))
          (:let product (* (parse-long x) (parse-long (option-ref (rx-group m :y)))))
          (:acc all (summing product))
          (:acc enabled (summing product) #:when on?)
          => (Tuple all enabled)))
  (println all)
  (println enabled)
  0)
