;; (std datetime): +date-period/opt, -date-period/opt, +duration/opt and
;; -duration/opt are None exactly where +date-period and the others raise,
;; for every type that has them, at both ends of the calendar.
(import (std prelude))
(import (std simpletest))
(import (std datetime))

(: (-> (Option %a) %a))
(defun (the o)
  (match o
    ((Some x) x)
    (None (panic! "a constant date or zone came back None"))))

(: DatePeriod)
(def a-day (date-period #:days 1))

(: Duration)
(def an-hour (duration #:hours 1))

(: (-> void))
(defun (dates)
  (def last (the (date 9999 12 31)))
  (def first (the (date 1 1 1)))
  (expect "a date plus a day" (+date-period/opt (the (date 2026 1 31)) a-day) (date 2026 2 1))
  (expect "is +date-period's"
          (+date-period/opt (the (date 2026 1 31)) (date-period #:months 1))
          (Some (+months (the (date 2026 1 31)) 1)))
  (expect-true "past 9999-12-31" (none? (+date-period/opt last a-day)))
  (expect-true "before 0001-01-01" (none? (-date-period/opt first a-day)))
  (expect "back from the last day" (-date-period/opt last a-day) (date 9999 12 30))
  (expect-true "months past the end"
               (none? (+date-period/opt (the (date 9999 12 1)) (date-period #:months 1))))
  (expect-true "a huge period" (none? (+date-period/opt first (date-period #:years 2147483647)))))

(: (-> void))
(defun (datetimes)
  (def late (the (datetime 9999 12 31 #:hours 23)))
  (expect "half an hour later"
          (+duration/opt late (duration #:minutes 30))
          (datetime 9999 12 31 #:hours 23 #:minutes 30))
  (expect-true "an hour past the end" (none? (+duration/opt late an-hour)))
  (expect-true "a day past the end" (none? (+date-period/opt late a-day)))
  (expect-true "a day before the start" (none? (-date-period/opt (the (datetime 1 1 1)) a-day)))
  (expect-true "a tick before the start"
               (none? (-duration/opt (the (datetime 1 1 1)) (duration #:nanoseconds 100)))))

(: (-> void))
(defun (instants)
  (def last (the (iso8601->instant "9999-12-31T23:59:59Z")))
  (expect "a second short of the end"
          (displayed (the (+duration/opt last (duration #:milliseconds 999))))
          "9999-12-31T23:59:59.999Z")
  (expect-true "a second past it" (none? (+duration/opt last (duration #:seconds 1))))
  (expect-true "before the start"
               (none? (-duration/opt (the (iso8601->instant "0001-01-01T00:00:00Z")) an-hour))))

(: (-> void))
(defun (durations)
  (def longest (duration #:hours 256204778))
  (expect "a duration plus a duration" (+duration/opt an-hour an-hour) (Some (duration #:hours 2)))
  (expect-true "past ±29 227 years" (none? (+duration/opt longest longest)))
  (expect-true "and below" (none? (-duration/opt (duration-negate longest) longest))))

(: (-> void))
(defun (times)
  (expect "a time wraps, so it is never None"
          (+duration/opt (the (time 23 0)) (duration #:hours 2))
          (time 1 0))
  (expect "back past midnight" (-duration/opt (the (time 1 0)) (duration #:hours 3)) (time 22 0)))

(: (-> TimeZone void))
(defun (moments z)
  (def late (the (datetime->moment/opt (the (datetime 9999 12 31 #:minutes 30)) z)))
  (expect "a moment plus an hour"
          (displayed (the (+duration/opt late an-hour)))
          "9999-12-31T01:30:00+01:00[Europe/Stockholm]")
  (expect-true "a day past the end" (none? (+date-period/opt late a-day)))
  (expect-true "24 hours past the end" (none? (+duration/opt late (duration #:hours 24))))
  (def early (the (datetime->moment/opt (the (datetime 1 1 2 #:hours 12)) z)))
  (expect-true "two days before the start" (none? (-date-period/opt early (date-period #:days 2))))
  (expect "a day before is still in it"
          (displayed (->date (the (-date-period/opt early a-day))))
          "0001-01-01"))

(defun (main)
  (dates)
  (datetimes)
  (instants)
  (durations)
  (times)
  (match (timezone "Europe/Stockholm")
    ((Some z) (moments z))
    (None (fail "the IANA time zone database was not found. Install tzdata.")))
  0)
