;; An instant has no calendar: "one day later" needs a zone to say when the day
;; ends, so `+days` on one is refused. `(+days (instant->moment i z) 1)` or
;; `(+hours i 24)` say which was meant.
;;
;; Reported once, at the call. The specialiser used to try a copy of `+days` at
;; Instant first, and warn against the library's definition that it could not.

;; EXPECT-ERROR: no implementation of trait 'DateArith' for 'datetime/Instant', needed to call '+days'
;; EXPECT-NO-ERROR: could not specialise

(import (std datetime))

(defun (main)
  (println (+days (now system-clock) 1))
  0)
