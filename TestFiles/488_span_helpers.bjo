;; The prelude's spans: (Span %a) and (RoSpan %a), made from an array with
;; #:from and #:to, and read, written, sliced and copied by name. Also: a
;; named let takes a loop variable's type from its initial value before the
;; body is checked, so a member of the variable resolves in the body.

(import (std prelude))
(import (std simpletest))

(import/extern
  (as-span (: System.MemoryExtensions.AsSpan (-> (Array %a) int int (System.Span %a))))
  ;; Not generic: ReadOnlySpan<byte> and ReadOnlySpan<char>. A span passes as
  ;; it is where an array would be made into one.
  (ascii? (: System.Text.Ascii.IsValid (-> (RoSpan byte) bool))))

(: (-> (Span long) long))
(defun (sum s)
  (let loop ((i 0) (acc 0L))
    (if (< i (span-length s))
        (loop (+ i 1) (+ acc (span-ref s i)))
        acc)))

(: (-> (RoSpan long) long))
(defun (ro-sum s)
  (let loop ((i 0) (acc 0L))
    (if (< i (ro-span-length s))
        (loop (+ i 1) (+ acc (ro-span-ref s i)))
        acc)))

;; The loop variable is the parameter: its type comes from `s`.
(: (-> (Span long) long))
(defun (sum-by-member s)
  (let loop ((i 0) (v s) (acc 0L))
    (if (< i (.-Length v))
        (loop (+ i 1) v (+ acc (.get_Item v i)))
        acc)))

(defun (main)
  (def xs (vec->array [1L 2L 3L 4L]))
  (expect "the whole array" (sum (array->span xs)) 10L)
  (expect "#:from and #:to" (sum (array->span xs #:from 1 #:to 3)) 5L)
  (expect "#:from alone" (sum (array->span xs #:from 2)) 7L)
  (expect "#:to alone, read-only" (ro-sum (array->ro-span xs #:to 2)) 3L)
  (expect "an empty span" (span-length (array->span xs #:from 4)) 0)

  (def s (array->span xs))
  (span-set! s 0 10L)
  (expect "a write reaches the array" (array->vec xs) [10L 2L 3L 4L])
  (expect "a slice, copied" (array->vec (span->array (span-slice s #:from 1 #:to 3))) [2L 3L])
  (expect "a slice from" (span-length (span-slice s #:from 3)) 1)
  (expect "a span made read-only" (ro-sum (span->ro-span s)) 19L)
  (expect "a read-only slice, copied"
          (array->vec (ro-span->array (ro-span-slice (array->ro-span xs) #:from 3)))
          [4L])
  (expect "a copy is not the array"
          (let ((copy (span->array s)))
            (array-set! copy 0 0L)
            (span-ref s 0))
          10L)

  (def text (vec->array [104uy 105uy 200uy]))
  (expect "a span to an ordinary span parameter" (ascii? (array->ro-span text #:to 2)) #t)
  (expect "and the rest" (ascii? (array->ro-span text #:from 1)) #f)

  (expect "a loop variable's member" (sum-by-member (array->span xs)) 19L)
  (expect "a loop variable from a call with keywords"
          (let loop ((v (array->span xs #:from 1)) (acc 0L))
            (if (= (.-Length v) 0)
                acc
                (loop (.Slice v 1) (+ acc (.get_Item v 0)))))
          9L)
  (expect "a loop variable from an import"
          (let walk ((r (as-span xs 0 2)) (n 0))
            (if (< n (.-Length r)) (walk r (+ n 1)) n))
          2)
  0)
