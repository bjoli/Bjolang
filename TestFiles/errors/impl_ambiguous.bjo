;; An empty list says nothing about its element type, and an implementation
;; for (List int) and one for (List string) both fit it. Either choice would be
;; a guess, and the two say different things.

;; EXPECT-ERROR: which implementation of 'Describe' 'describe' uses here is not decided. Its type is '(List ?a)', and the implementations for '(List int)' and '(List string)' both fit it

(import (std prelude))

(def/trait (Describe %a)
  (: describe (-> %a string)))

(impl (Describe (List int))
  (defun (describe xs) "ints"))

(impl (Describe (List string))
  (defun (describe xs) "strings"))

(defun (main args)
  (println (describe (list)))
  0)
