;; A union case no clause names. The counterexample is the case itself, spelled
;; as source writes it rather than as the key it is registered under.

;; EXPECT-ERROR: does not cover every value
;; EXPECT-ERROR: Blue reaches no clause

(import (std prelude))

(type (: Colour (Enum Red Green Blue)))

(: shade (-> Colour string))
(defun (shade c)
  (match c
    (Red "r")
    (Green "g")))

(defun (main args)
  (println (shade Red))
  0)
