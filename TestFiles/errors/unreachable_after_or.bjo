;; An `(or ...)` covers each of its alternatives, so a clause naming one of them
;; again is dead.

;; EXPECT-ERROR: this clause can never run

(import (std prelude))

(type (: Colour (Enum Red Green Blue)))

(: shade (-> Colour string))
(defun (shade c)
  (match c
    ((or Red Green) "warm")
    (Red "red")
    (Blue "cool")))

(defun (main args)
  (println (shade Red))
  0)
