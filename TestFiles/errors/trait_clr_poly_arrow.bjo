;; A `-?->` parameter on a trait that stands for a .NET interface.
;;
;; The twin is a second method, and every other trait has somewhere to put one:
;; a slot on the emitted interface, or a second static landing pad. A CLR
;; constraint has neither. Its methods *are* the members it names, and .NET
;; supplies those.

;; EXPECT-ERROR: stands for a .NET interface
;; EXPECT-ERROR: no second member for a -?-> to be answered by
;; EXPECT-ERROR: Declare the parameter ->

(import (std prelude))

(def/trait (Sizey %a)
  (#:clr-constraint (System.IComparable %a))
  (: measure (-> %a (-?-> %a int) int) #:clr-member CompareTo))

(defun (main args) 0)
