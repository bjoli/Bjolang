;; A :for runs out, and then the loop has no value: it needs `=>` for that
;; exit, even though it also ends by (:finish test value).

;; EXPECT-ERROR: gives the loop a value of type int, and the loop gives no value when it ends in another way.
;; EXPECT-ERROR: Write the value for that exit after =>
;; EXPECT-ERROR: loop_finish_value_can_run_out.bjo:13:9

(import (std prelude))

(: find-negative (-> (List int) int))
(defun (find-negative xs)
  (loop (:for x xs)
        (:finish (< x 0) x)))

(defun (main) 0)
