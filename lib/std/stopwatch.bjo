(import (std prelude))
(import (std syntax-match))

(import/class
  (ArgumentException (: System.ArgumentException (-> string ArgumentException))))

(import/extern (get-memory-usage (: System.GC.GetAllocatedBytesForCurrentThread)))

(:doc #:file "stopwatch.bjodoc")

(export Stopwatch stopwatch stopwatch-start! stopwatch-stop! stopwatch-ns stopwatch-us stopwatch-ms
        ns->string time-it get-memory-usage)

;; A stopwatch reads the prelude's `monotonic-ns` from `current-clock` rather
;; than holding a `System.Diagnostics.Stopwatch`, so that a test can bind a
;; clock and get an exact elapsed time instead of a real one.
;;
;; `started` is the reading in nanoseconds the watch was last started at, or -1
;; when it is not running; `elapsed` is the nanoseconds earlier runs added up
;; to. Both mutable, because a stopwatch is a thing that is started and stopped
;; rather than a value that is replaced. The other units are read from the
;; nanoseconds, so that a run under a millisecond is not lost.
(type
  (: Stopwatch (Record (: started long #:mutable)
                       (: elapsed long #:mutable))))

(: stopwatch (-> Stopwatch))
(defun (stopwatch)
  (Stopwatch (started -1L) (elapsed 0L)))

(: running? (-> Stopwatch bool))
(defun (running? sw)
  (>= (record-ref sw started) 0L))

;; Starting a running watch does nothing, as restarting a .NET one does not.
(: stopwatch-start! (-> Stopwatch void))
(defun (stopwatch-start! sw)
  (unless (running? sw)
    (record-set! sw (started (monotonic-ns)))))

(: stopwatch-stop! (-> Stopwatch void))
(defun (stopwatch-stop! sw)
  (when (running? sw)
    (record-set! sw
                 (elapsed (+ (record-ref sw elapsed) (- (monotonic-ns) (record-ref sw started))))
                 (started -1L))))

;; The reading while running includes the segment in progress, so a watch can be
;; read without stopping it.
(: stopwatch-ns (-> Stopwatch long))
(defun (stopwatch-ns sw)
  (if (running? sw)
      (+ (record-ref sw elapsed) (- (monotonic-ns) (record-ref sw started)))
      (record-ref sw elapsed)))

(: stopwatch-us (-> Stopwatch long))
(defun (stopwatch-us sw)
  (/ (stopwatch-ns sw) 1000L))

(: stopwatch-ms (-> Stopwatch long))
(defun (stopwatch-ms sw)
  (/ (stopwatch-ns sw) 1000000L))

;; `(ref sw 'ms)` — the elapsed time under the name of a unit.
(impl (Refable Stopwatch)
  (type %index Symbol)
  (type %out long)
  (defun (ref sw sym)
    (case sym
      ('ns (stopwatch-ns sw))
      ('us (stopwatch-us sw))
      ('ms (stopwatch-ms sw))
      ('s (/ (stopwatch-ns sw) 1000000000L))
      (else
        (raise
          (cast Exception
                (ArgumentException.
                  (str "A stopwatch is read with 'ns, 'us, 'ms or 's, and this was '"
                       (->str sym) "."))))))))

;; A duration in the largest unit that keeps it at 1 or more, with one decimal
;; under 100: "850 ns", "12.5 us", "3.2 ms", "1.5 s".
(: ns->string (-> long string))
(defun (ns->string ns)
  (def magnitude (abs ns))
  (cond
    ((< magnitude 1000L) (str (->str ns) " ns"))
    ((< magnitude 1000000L) (scaled ns 1000L " us"))
    ((< magnitude 1000000000L) (scaled ns 1000000L " ms"))
    (else (scaled ns 1000000000L " s"))))

;; ns in units of `unit` nanoseconds: one decimal under 100, none above.
(: scaled (-> long long string string))
(defun (scaled ns unit suffix)
  (def sign (if (< ns 0L) "-" ""))
  (def tenths (/ (* (abs ns) 10L) unit))
  (if (< tenths 1000L)
      (str sign (->str (/ tenths 10L)) "." (->str (% tenths 10L)) suffix)
      (str sign (->str (/ tenths 10L)) suffix)))


;; (time-it body ...) — prints elapsed time and allocated memory.
;; Drops body's value.
;; Runs a warmup that redirects the output to a different output port.
(def/macro (time-it form inject compare)
  (syntax-match form
    ((_ #:times n first body ...)
     #'(let ((ignored-port (open-output-string)))
         (ignore (parameterize ((current-output-port ignored-port))
                   ,first
                   ,@body
                   (get-output-string ignored-port)))
         (def sw (stopwatch))
         (def/mutable bytes-used 0L)
         (let lp ((n ,n))
           (when (> n 0)
             (def before (get-memory-usage))
             (stopwatch-start! sw)
             ,first
             ,@body
             (stopwatch-stop! sw)
             (set! bytes-used (+ bytes-used (- (get-memory-usage) before )))
             (lp (- n 1))))
         (println (str "Mean of "  (->str ,n) " runs: " (ns->string (/ (stopwatch-ns sw) ,n)) ". "
                       (->str (/ bytes-used ,n)) "B allocated per run."))))
    ((_ first body ...) #'(time-it #:times 1 ,first ,@body)) 
    (bad (syntax-error bad "time-it takes a body: (time-it expr ...)"))))
