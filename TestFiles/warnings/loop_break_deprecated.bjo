;; `:break` is the old spelling of `:finish`. It still works, and says so.

;; EXPECT-WARNING: `:break` at loop_break_deprecated.bjo:12 is deprecated, use `:finish`.

(import (std prelude))
(import (std simpletest))

(: f (-> (List int) int))
(defun (f xs)
  (loop (:for x xs)
        (:acc s (summing x))
        (:break (> x 2) -1)
        => s))

(defun (main)
  (expect "break with a value" (f '(1 2 3)) -1)
  (expect "break not reached" (f '(1 1)) 2)
  0)
