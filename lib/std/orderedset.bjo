;; std/orderedset.bjo — the sorted set.
;; Persistent B-tree of elements kept in their natural order.

(export
  ;; The types.
  OrderedSet OrderedSetBuilder TransientOrderedSet OrderedSetCursor
  OrderedSetting

  ;; Sets
  orderedset-empty orderedset-add orderedset-add-all orderedset-remove
  orderedset-remove-all orderedset-contains? orderedset-length orderedset-empty?
  orderedset-clear
  ;; Set algebra
  orderedset-union orderedset-intersection orderedset-difference
  orderedset-symmetric-difference
  ;; Order — what the tree is for
  orderedset-min orderedset-max orderedset-successor orderedset-predecessor
  orderedset-range orderedset-from orderedset-until
  ;; Walking and rebuilding
  orderedset-map orderedset-filter orderedset-fold orderedset-for-each
  orderedset-iter orderedset-any? orderedset-find
  ;; Conversions
  list->orderedset orderedset->list vec->orderedset orderedset->vec
  seq->orderedset orderedset->seq
  orderedset->str
  ;; Builders — the same shape as ListBuilder
  orderedsetbuilder-empty orderedset->orderedsetbuilder orderedsetbuilder-add!
  orderedsetbuilder-add-all! orderedsetbuilder-length orderedsetbuilder->orderedset
  ;; Transients — the set's interface, in place
  transientorderedset-empty orderedset->transientorderedset
  transientorderedset->orderedset transientorderedset-add!
  transientorderedset-add-all! transientorderedset-remove!
  transientorderedset-remove-all! transientorderedset-contains?
  transientorderedset-length transientorderedset-empty?
  transientorderedset-min transientorderedset-max
  transientorderedset-filter!)

(import (std prelude))

(import/class
  ((OrderedSet %a) (: OrderedSet.OrderedSet))
  ((OrderedSetBuilder %a) (: OrderedSet.OrderedSetBuilder))
  ((TransientOrderedSet %a) (: OrderedSet.TransientOrderedSet))
  ((OrderedSetCursor %a) (: OrderedSet.OrderedSetCursor))
  ;; What a set orders its elements by. See `ord-comparer`.
  ((Comparer %a) (: System.Collections.Generic.IComparer)))

;; ---------------------------------------------------------------------------
;; The set
;; ---------------------------------------------------------------------------

(import/extern
  (clr-orderedset-empty  (: OrderedSet.OrderedSetModule.Empty       (-> (Comparer %a) (OrderedSet %a))))
  (clr-orderedset-comparer (: OrderedSet.OrderedSetModule.Comparer  (-> (OrderedSet %a) (Comparer %a))))
  (orderedset-add        (: OrderedSet.OrderedSetModule.Add         (-> (OrderedSet %a) %a (OrderedSet %a))))
  ;; Add a run of elements.
  (orderedset-add-all    (: OrderedSet.OrderedSetModule.AddRange    (-> (OrderedSet %a) (Seq %a) (OrderedSet %a))))
  (orderedset-remove     (: OrderedSet.OrderedSetModule.Remove      (-> (OrderedSet %a) %a (OrderedSet %a))))
  (orderedset-remove-all (: OrderedSet.OrderedSetModule.RemoveRange (-> (OrderedSet %a) (Seq %a) (OrderedSet %a))))
  (orderedset-contains?  (: OrderedSet.OrderedSetModule.Contains    (-> (OrderedSet %a) %a bool)))
  (orderedset-length     (: OrderedSet.OrderedSetModule.Count       (-> (OrderedSet %a) int)))
  (orderedset-empty?     (: OrderedSet.OrderedSetModule.IsEmpty     (-> (OrderedSet %a) bool)))
  (orderedset-clear      (: OrderedSet.OrderedSetModule.Clear       (-> (OrderedSet %a) (OrderedSet %a))))

  ;; --- Set algebra ---
  (orderedset-union                (: OrderedSet.OrderedSetModule.Merge (-> (OrderedSet %a) (OrderedSet %a) (OrderedSet %a))))
  (orderedset-intersection         (: OrderedSet.OrderedSetModule.Intersect (-> (OrderedSet %a) (OrderedSet %a) (OrderedSet %a))))
  (orderedset-difference           (: OrderedSet.OrderedSetModule.Except (-> (OrderedSet %a) (OrderedSet %a) (OrderedSet %a))))
  (orderedset-symmetric-difference (: OrderedSet.OrderedSetModule.SymmetricExcept (-> (OrderedSet %a) (OrderedSet %a) (OrderedSet %a))))

  ;; --- Order ---
  ;; Partial answers as Options.
  (orderedset-min         (: OrderedSet.OrderedSetModule.TryGetMin         (-> (OrderedSet %a) (out %a) (Option %a))))
  (orderedset-max         (: OrderedSet.OrderedSetModule.TryGetMax         (-> (OrderedSet %a) (out %a) (Option %a))))
  ;; Successor.
  (orderedset-successor   (: OrderedSet.OrderedSetModule.TryGetSuccessor   (-> (OrderedSet %a) %a (out %a) (Option %a))))
  (orderedset-predecessor (: OrderedSet.OrderedSetModule.TryGetPredecessor (-> (OrderedSet %a) %a (out %a) (Option %a))))

  ;; Range walks.
  (orderedset-range (: OrderedSet.OrderedSetModule.Range (-> (OrderedSet %a) %a %a (Seq %a))))
  (orderedset-from  (: OrderedSet.OrderedSetModule.From  (-> (OrderedSet %a) %a (Seq %a))))
  (orderedset-until (: OrderedSet.OrderedSetModule.Until (-> (OrderedSet %a) %a (Seq %a))))

  ;; --- Walking ---
  (clr-orderedset-map    (: OrderedSet.OrderedSetModule.Map        (-> (-> %a %b) (OrderedSet %a) (Comparer %b) (OrderedSet %b))))
  (clr-orderedset-filter (: OrderedSet.OrderedSetModule.Filter     (-> (-> %a bool) (OrderedSet %a) (OrderedSet %a))))
  (clr-orderedset-fold   (: OrderedSet.OrderedSetModule.Fold       (-> (-> %a %s %s) %s (OrderedSet %a) %s)))
  (clr-orderedset-iter   (: OrderedSet.OrderedSetModule.Iter       (-> (-> %a bool) (OrderedSet %a) bool)))
  (orderedset-any?       (: OrderedSet.OrderedSetModule.Exists     (-> (-> %a bool) (OrderedSet %a) bool)))
  (orderedset-find       (: OrderedSet.OrderedSetModule.TryFindKey (-> (-> %a bool) (OrderedSet %a) (out %a) (Option %a))))

  (clr-seq->orderedset (: OrderedSet.OrderedSetModule.FromEnumerable (-> (Seq %a) (Comparer %a) (OrderedSet %a))))
  (orderedset->seq (: OrderedSet.OrderedSetModule.AsEnumerable   (-> (OrderedSet %a) (Seq %a))))

  (orderedset-cursor         (: OrderedSet.OrderedSetModule.Cursor        (-> (OrderedSet %a) (OrderedSetCursor %a))))
  (orderedset-cursor-done?   (: OrderedSet.OrderedSetModule.CursorDone    (-> (OrderedSetCursor %a) bool)))
  (orderedset-cursor-current (: OrderedSet.OrderedSetModule.CursorCurrent (-> (OrderedSetCursor %a) %a)))
  (orderedset-cursor-next    (: OrderedSet.OrderedSetModule.CursorNext    (-> (OrderedSetCursor %a) (OrderedSetCursor %a)))))

;; ---------------------------------------------------------------------------
;; Builders and transients
;; ---------------------------------------------------------------------------

(import/extern
  (clr-orderedsetbuilder-empty     (: OrderedSet.OrderedSetBuilderModule.Empty    (-> (Comparer %a) (OrderedSetBuilder %a))))
  (orderedset->orderedsetbuilder   (: OrderedSet.OrderedSetBuilderModule.FromSet  (-> (OrderedSet %a) (OrderedSetBuilder %a))))
  (orderedsetbuilder-add!          (: OrderedSet.OrderedSetBuilderModule.Add      (-> (OrderedSetBuilder %a) %a void)))
  (orderedsetbuilder-add-all!      (: OrderedSet.OrderedSetBuilderModule.AddRange (-> (OrderedSetBuilder %a) (Seq %a) void)))
  (orderedsetbuilder-length        (: OrderedSet.OrderedSetBuilderModule.Count    (-> (OrderedSetBuilder %a) int)))
  (orderedsetbuilder->orderedset   (: OrderedSet.OrderedSetBuilderModule.Build    (-> (OrderedSetBuilder %a) (OrderedSet %a))))

  (clr-transientorderedset-empty   (: OrderedSet.TransientOrderedSetModule.Empty          (-> (Comparer %a) (TransientOrderedSet %a))))
  (orderedset->transientorderedset (: OrderedSet.TransientOrderedSetModule.FromPersistent (-> (OrderedSet %a) (TransientOrderedSet %a))))
  (transientorderedset->orderedset (: OrderedSet.TransientOrderedSetModule.ToPersistent   (-> (TransientOrderedSet %a) (OrderedSet %a))))
  (transientorderedset-add!        (: OrderedSet.TransientOrderedSetModule.Add            (-> (TransientOrderedSet %a) %a void)))
  (transientorderedset-add-all!    (: OrderedSet.TransientOrderedSetModule.AddRange       (-> (TransientOrderedSet %a) (Seq %a) void)))
  (transientorderedset-remove!     (: OrderedSet.TransientOrderedSetModule.Remove         (-> (TransientOrderedSet %a) %a void)))
  (transientorderedset-remove-all! (: OrderedSet.TransientOrderedSetModule.RemoveRange    (-> (TransientOrderedSet %a) (Seq %a) void)))
  (transientorderedset-contains?   (: OrderedSet.TransientOrderedSetModule.Contains       (-> (TransientOrderedSet %a) %a bool)))
  (transientorderedset-length      (: OrderedSet.TransientOrderedSetModule.Count          (-> (TransientOrderedSet %a) int)))
  (transientorderedset-empty?      (: OrderedSet.TransientOrderedSetModule.IsEmpty        (-> (TransientOrderedSet %a) bool)))
  (transientorderedset-filter!     (: OrderedSet.TransientOrderedSetModule.FilterInPlace  (-> (-> %a bool) (TransientOrderedSet %a) void)))

  (transientorderedset-min         (: OrderedSet.TransientOrderedSetModule.TryGetMin      (-> (TransientOrderedSet %a) (out %a) (Option %a))))
  (transientorderedset-max         (: OrderedSet.TransientOrderedSetModule.TryGetMax      (-> (TransientOrderedSet %a) (out %a) (Option %a)))))

;; ---------------------------------------------------------------------------
;; Where a set comes from
;; ---------------------------------------------------------------------------

;; What makes a set out of nothing asks for the element's Ord, and the tree
;; orders elements by it — the order `compare` gives, also where the type has
;; no CompareTo of its own. One made from a set keeps that set's.
(: orderedset-empty (-> (OrderedSet %a)) (where (Ord %a)))
(defun (orderedset-empty) (clr-orderedset-empty (ord-comparer)))

(: seq->orderedset (-> (Seq %a) (OrderedSet %a)) (where (Ord %a)))
(defun (seq->orderedset xs) (clr-seq->orderedset xs (ord-comparer)))

(: orderedsetbuilder-empty (-> (OrderedSetBuilder %a)) (where (Ord %a)))
(defun (orderedsetbuilder-empty) (clr-orderedsetbuilder-empty (ord-comparer)))

(: transientorderedset-empty (-> (TransientOrderedSet %a)) (where (Ord %a)))
(defun (transientorderedset-empty) (clr-transientorderedset-empty (ord-comparer)))

;; ---------------------------------------------------------------------------
;; Ordered sets, where the callback may suspend
;; ---------------------------------------------------------------------------

(: orderedset-map (-> (-?-> %a %b) (OrderedSet %a) (OrderedSet %b)) (where (Ord %b)))
(defbjouble (orderedset-map f s)
  (#:sync (clr-orderedset-map f s (ord-comparer)))
  (#:bjo
    (def b (orderedsetbuilder-empty))
    (let go ((c (orderedset-cursor s)))
      (cond
        ((orderedset-cursor-done? c) (orderedsetbuilder->orderedset b))
        (else
          (orderedsetbuilder-add! b (f (orderedset-cursor-current c)))
          (go (orderedset-cursor-next c)))))))

(: orderedset-filter (-> (-?-> %a bool) (OrderedSet %a) (OrderedSet %a)))
(defbjouble (orderedset-filter keep? s)
  (#:sync (clr-orderedset-filter keep? s))
  (#:bjo
    (def b (clr-orderedsetbuilder-empty (clr-orderedset-comparer s)))
    (let go ((c (orderedset-cursor s)))
      (cond
        ((orderedset-cursor-done? c) (orderedsetbuilder->orderedset b))
        (:def x (orderedset-cursor-current c))
        (else
          (when (keep? x)
            (orderedsetbuilder-add! b x))
          (go (orderedset-cursor-next c)))))))

(: orderedset-fold (-> (-?-> %a %s %s) %s (OrderedSet %a) %s))
(defbjouble (orderedset-fold f init s)
  (#:sync (clr-orderedset-fold f init s))
  (#:bjo
    ;; `f` before the step, as in `map-fold`.
    (let go ((acc init) (c (orderedset-cursor s)))
      (if (orderedset-cursor-done? c)
          acc
          (go (f (orderedset-cursor-current c) acc) (orderedset-cursor-next c))))))

(: orderedset-iter (-> (-?-> %a bool) (OrderedSet %a) bool))
(defbjouble (orderedset-iter f s)
  (#:sync (clr-orderedset-iter f s))
  (#:bjo
    (let go ((c (orderedset-cursor s)))
      (cond ((orderedset-cursor-done? c) #t)
            ((f (orderedset-cursor-current c)) (go (orderedset-cursor-next c)))
            (else #f)))))

(: list->orderedset (-> (List %a) (OrderedSet %a)) (where (Ord %a)))
(defun (list->orderedset xs)
  (def sb (orderedsetbuilder-empty))
  (loop (:for x xs)
        (:do (orderedsetbuilder-add! sb x)))
  (orderedsetbuilder->orderedset sb))

(: orderedset->list (-> (OrderedSet %a) (List %a)))
(defun (orderedset->list s)
  (def lb (listbuilder-empty))
  (orderedset-for-each #(listbuilder-add! lb &) s)
  (listbuilder->list lb))

(: vec->orderedset (-> (Vec %a) (OrderedSet %a)) (where (Ord %a)))
(defun (vec->orderedset v)
  (def sb (orderedsetbuilder-empty))
  (vec-for-each #(orderedsetbuilder-add! sb &) v)
  (orderedsetbuilder->orderedset sb))

(: orderedset->vec (-> (OrderedSet %a) (Vec %a)))
(defun (orderedset->vec s)
  (def vb (vecbuilder-empty))
  (orderedset-for-each #(vecbuilder-add! vb &) s)
  (vecbuilder->vec vb))

;; ---------------------------------------------------------------------------
;; The traits
;; ---------------------------------------------------------------------------
(impl (Refable (OrderedSet %a))
  (type %index %a)
  (type %out bool)
  (defun (ref set key)
    (orderedset-contains? set key)))
(impl (Refable (TransientOrderedSet %a))
  (type %index %a)
  (type %out bool)
  (defun (ref set key)
    (transientorderedset-contains? set key)))

(impl (Iterable (OrderedSet %a))
  (type %elem %a)
  (type %cursor (OrderedSetCursor %a))
  (defun (iterable-start s) (orderedset-cursor s))
  (defun (iterable-done? s c) (orderedset-cursor-done? c))
  (defun (iterable-current s c) (orderedset-cursor-current c))
  (defun (iterable-next s c) (orderedset-cursor-next c)))

(: orderedset-for-each (-> (-?-> %a void) (OrderedSet %a) void))
(defun (orderedset-for-each f s)
  (let go ((c (orderedset-cursor s)))
    (cond
      ((orderedset-cursor-done? c) unit)
      (else
        (f (orderedset-cursor-current c))
        (go (orderedset-cursor-next c))))))

(impl (Collection (OrderedSet %a))
  (type %content %a)
  (defun (length s) (orderedset-length s))
  (defun (empty? s) (orderedset-empty? s)))


(type (: (OrderedSetting %a) (Union ordered-setting)))

(impl (Collector (OrderedSetting %a))
  (where (Ord %a))
  (type %elem %a)
  (type %acc (OrderedSetBuilder %a))
  (type %out (OrderedSet %a))
  (defun (collector-init c) (orderedsetbuilder-empty))
  (defun (collector-step c acc x) (orderedsetbuilder-add! acc x) acc)
  (defun (collector-finish c acc) (orderedsetbuilder->orderedset acc)))

;; The mutable sinks, one element at a time. `Addable!` is the prelude's
;; trait; this module owns the types, which is what licenses the impls.
(impl (Addable! (OrderedSetBuilder %a))
      (type %elem %a)
      (defun (add! sb elem)
        (orderedsetbuilder-add! sb elem)))

(impl (Addable! (TransientOrderedSet %a))
      (type %elem %a)
      (defun (add! ts elem)
        (transientorderedset-add! ts elem)))

;; And the persistent set itself.
(impl (Addable (OrderedSet %a))
      (type %elem %a)
      (defun (add s elem)
        (orderedset-add s elem)))

;; Equality for ordered sets.
(impl (Eq (OrderedSet %a))
  (where (Eq %a))
  (defun (= a b)
    (and (= (orderedset-length a) (orderedset-length b))
         (= (orderedset->list a) (orderedset->list b))))
  (defun (eq-hash s)
    (orderedset-fold (fun (x h) (hash-combine h (eq-hash x))) 17 s)))

(: orderedset->str (-> (OrderedSet %a) string) (where (->str %a)))
(defun (orderedset->str s)
  (def sb (stringbuilder-empty))
  (stringbuilder-add-string! sb "#{")
  (loop (:with first? #t #f)
        (:for elem s)
        (:do (unless first? (stringbuilder-add-string! sb " "))
             (stringbuilder-add-string! sb (->str elem))))
  (stringbuilder-add-string! sb "}")
  (stringbuilder->string sb))

(impl (->str (OrderedSet %a))
  (where (->str %a))
  (defun (->str s)
    (orderedset->str s)))
