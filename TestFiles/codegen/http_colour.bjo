;; `(std http client)` blocks in a `defun` and suspends in a `defbjo`. This
;; checks the emitted C# for both.
;;
;; - `fetch` is a `defbjouble`: `sync` on a fiber, `sync/blocking` on a thread.
;; - `response-text` reads through a port, so it is emitted twice like any
;;   other `defun` that reads a port.
;; - `response-port` only builds the port. The read on it suspends.
;; - Everything written on top of them, `fetch-body` below included, is
;;   emitted twice.
;;
;; No behavioural test can see this. A suspending copy that reached the
;; blocking half returns the same bytes and passes every check in
;; `604_http_client.bjo`, but it holds a pool thread for the whole request.

;; A plain `defun` over the http API is emitted twice, whether or not this file
;; has a bjoroutine that calls it.
;; EXPECT-CS: public static BjoString\.Utf8String fetchsubbody\(
;; EXPECT-CS: public static async .*fetchsubbody__bjo\(

;; The suspending copy awaits the request, the body and the read.
;; EXPECT-CS: await v1_Module\.fetch__bjo\(
;; EXPECT-CS: await .*responsesubtext__bjo\(
;; EXPECT-CS: await .*readsubline__bjo\(.*responsesubport\(

;; The blocking copy calls the blocking halves of the same names.
;; EXPECT-CS: = v1_Module\.fetch\(v1_Module\.httpsubget\(url\)\);
;; EXPECT-CS: responsesubtext\(r\)

;; Nothing waits on a task by hand. A pair collapsed to one method would.
;; EXPECT-NO-CS: \.Result
;; EXPECT-NO-CS: GetAwaiter\(\)\.GetResult\(\)

(import (std prelude))
(import (std http client))

;; Written once. No colour is named anywhere in it.
(: (-> string string))
(defun (fetch-body url)
  (match (fetch (http-get url))
    ((Ok r) (let ((text (response-text r))) (response-close r) text))
    ((Err e) "failed")))

(: (-> string string))
(defun (first-line url)
  (match (fetch (http-get url))
    ((Ok r) (let ((line (read-line (response-port r)))) (response-close r) line))
    ((Err e) "failed")))

;; The caller that forces the suspending copies into existence.
(: (-bjo-> string string))
(defbjo (from-a-fiber url)
  (str (fetch-body url) (first-line url)))
