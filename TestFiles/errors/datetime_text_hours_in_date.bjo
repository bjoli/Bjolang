;; A date has no time of day, so a date's format has no hours to ask for. The
;; grammar DatePart refuses the field where the format is written.

;; EXPECT-ERROR: DatePart: expected DateField, a string or a char; found (hours ...)

(import (std datetime))

(defun (main)
  (match (date 2026 10 25)
    ((Some d) (println (date->text d '((year 4) " " (hours 2)))))
    (None (println "none")))
  0)
