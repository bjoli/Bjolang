;; A cancellation token is *represented* by a promise. It is not one.
;;
;; `CancelToken` is a newtype, and this is what the newtype is for. Aliased to
;; `(Promise CancelReason)` instead, every promise operation would apply to a
;; token and two of them would be nonsense in the same way: `promise-join` hands
;; back a `(Result Exception CancelReason)` and invites a `match` on a failure
;; that cannot occur, since the only writer a program can reach is
;; `make-cancel`'s thunk; and `detach` arms an unhandled-exception report for a
;; promise nothing ever fails.
;;
;; Costs nothing to have. The generated C# is `Bjoml.Promise<CancelReason>`
;; either way — the distinction exists only where it does any good, which is
;; here.

;; EXPECT-ERROR: CancelToken

(import (std prelude))

(defbjo (main args)
  (def (cancel! tok) (make-cancel))
  (def joined (sync (promise-join tok)))
  0)
