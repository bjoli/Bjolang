(import (std simpletest))

(: f (-> int (#:acc int) (#:other int) int))
(defun (f n #:acc (let loop ((i 3) (a 0)) (if (= i 0) a (loop (- i 1) (+ a 1)))) #:other (+ acc 100))
  (+ (+ n acc) other))

(defun (main)
  ;; Båda förvalen räknas fram: #:acc av en namngiven let (3), och #:other av
  ;; #:acc plus 100.
  (expect "both keyword defaults" (f 1) 107)
  ;; #:other läser det #:acc som faktiskt gäller, inte förvalet.
  (expect "a default reading a supplied argument" (f 1 #:acc 5) 111)
  (expect "both supplied" (f 1 #:acc 5 #:other 2) 8)
  0)
