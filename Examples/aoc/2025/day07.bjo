;; Day 7: Laboratories. A beam falls from S; a splitter (^) starts two beams,
;; one column to each side. Part 1 counts the splitters a beam reaches, part 2
;; the timelines.
(import "common.bjo")

(defun (main args)
  (def* (rows (vec-map string->vec (input-lines args)))
        (w (length (ref rows 0))))
  ;; The number of timelines with a particle in each column.
  (def/mutable beams (make-array w))
  (loop (:for x (range 0 w))
        (:do (array-set! beams x (if (char=? (ref (ref rows 0) x) #\S) 1L 0L))))
  (def/mutable splits 0)
  (loop (:for row rows)
        (:do (def next (make-array w))
             (defun (add! x n) (array-set! next x (+ n (ref next x))))
             (loop (:for x (range 0 w))
                   (:let n (ref beams x))
                   (:when (> n 0L))
                   (:do (if (char=? (ref row x) #\^)
                            (let ()
                              (set! splits (+ splits 1))
                              (when (> x 0) (add! (- x 1) n))
                              (when (< (+ x 1) w) (add! (+ x 1) n)))
                            (add! x n))))
             (set! beams next)))
  (println splits)
  (println {summing n (:for n beams)})
  0)
