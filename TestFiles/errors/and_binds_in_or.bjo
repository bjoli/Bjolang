;; An `(and ...)` inside an `(or ...)`. Only one alternative runs, so a name
;; bound down one of them has no value on the arm — and the conjunction does not
;; hide the binder from that check.

;; EXPECT-ERROR: this alternative binds x

(import (std prelude))

(: f (-> int string))
(defun (f n)
  (match n
    ((or (and 1 x) 2) "low")
    (_ "other")))

(defun (main args)
  (println (f 1))
  0)
