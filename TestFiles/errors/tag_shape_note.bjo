;; A head that is not a tag makes the list data for the untagged list case. When
;; that fails, the head was most likely a misspelled tag, so the error says the
;; list was not read as a tagged form and which tags there are.
;; EXPECT-ERROR: note: `form` is not a tag of tag_shape_note/Clause either, so this list was read as tag_shape_note/Columns
(import (std prelude))

(type (: Col (Union (CId #:tag id) (CName #:tag name))))
(type (: Clause (Union (Columns (List Col))
                       (From Symbol #:tag from))))

(: f (-> (List Clause) int))
(defun (f c) 0)

(defun (main args)
  (f (list '(id name) '(form users))))
