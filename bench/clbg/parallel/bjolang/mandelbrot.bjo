;; mandelbrot, in parallel: the Mandelbrot set as a portable bitmap (PBM P4).
;; Argument: the width and height in pixels.
;;
;; The rows go to one fiber for each CPU through a channel, so that a fiber
;; that finishes early takes the next row. A -1 tells a fiber to stop.

(import "par.bjo")
(import (only (std ports) write-bytes!))

;; Whether the point (cr, ci) stays inside radius 2 for 50 iterations.
(: inside? (-> double double bool))
(defun (inside? cr ci)
  (let go ((i 0) (zr 0.0) (zi 0.0) (tr 0.0) (ti 0.0))
    (if (and (< i 50) (<= (+ tr ti) 4.0))
        (let* ((zi (+ (* 2.0 (* zr zi)) ci))
               (zr (+ (- tr ti) cr)))
          (go (+ i 1) zr zi (* zr zr) (* zi zi)))
        (<= (+ tr ti) 4.0))))

;; Writes row y of an n by n bitmap.
(: row! (-> (Array byte) int int void))
(defun (row! bitmap n y)
  (def row-bytes (/ (+ n 7) 8))
  (def size (cast System.Double n))
  (def ci (- (/ (* 2.0 (cast System.Double y)) size) 1.0))
  (let go ((x 0) (bits 0) (at (* y row-bytes)))
    (cond
      ((= x n)
       (when (not (= 0 (% n 8)))
         (array-set! bitmap at (cast System.Byte (shift-left bits (- 8 (% n 8)))))))
      (else
       (def cr (- (/ (* 2.0 (cast System.Double x)) size) 1.5))
       (def bits (+ (shift-left bits 1) (if (inside? cr ci) 1 0)))
       (if (= 7 (% x 8))
           (let ()
             (array-set! bitmap at (cast System.Byte bits))
             (go (+ x 1) 0 (+ at 1)))
           (go (+ x 1) bits at))))))

(: row-worker (-bjo-> (Chan int) (Array byte) int void))
(defbjo (row-worker rows bitmap n)
  (let go ()
    (def y (chan-get rows))
    (when (>= y 0)
      (row! bitmap n y)
      (go))))

(: send-all (-bjo-> (Chan int) int int void))
(defbjo (send-all ch from to)
  (let go ((i from))
    (when (< i to)
      (chan-put ch i)
      (go (+ i 1)))))

(defbjo (main args)
  (def n (string->int (vec-ref args 0)))
  (def bitmap (make-array (* (/ (+ n 7) 8) n)))
  (def rows (make-chan))
  (with-scope
    (loop (:for w (range 0 workers))
          (:do (spawn (row-worker rows bitmap n))))
    (send-all rows 0 n)
    (let stop ((w 0))
      (when (< w workers)
        (chan-put rows -1)
        (stop (+ w 1)))))
  (def out (parameter-ref current-output-port))
  (write-string out #"P4\n${n} ${n}\n")
  (write-bytes! out bitmap)
  0)
