;; A keyword-headed form is a clause that did not read, and is reported as one
;; rather than parsed as a call to a keyword.

;; EXPECT-ERROR: This is not a (do ...) form

(import (std prelude))
(import (std monad))

(: stepped (-> int (Option int)))
(defun (stepped n)
  (do (:bind x (Some n))
      (:where (> x 0))
      (:return x)))

(defun (main) 0)
