  (v256-first-true (: Bjolang.Runtime.BjoSimd.FirstTrue256 (-> (Simd256 %a) int)))
  (v256-splat (: System.Runtime.Intrinsics.Vector256.Create (-> %a (Simd256 %a))))
  (v256-zero (: Bjolang.Runtime.BjoSimd.Zero256 (-> (Simd256 %a))))
  (v256-mask-bits (: Bjolang.Runtime.BjoSimd.MaskBits256 (-> (Simd256 %a) int)))
