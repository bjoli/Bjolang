;; A match binder named like a special form, called in the clause.
;; EXPECT-ERROR: (list ...) is the special form 'list', not a call to the local 'list'

(import (std prelude))

(: f (-> (Option (-> int (List int))) (List int)))
(defun (f o)
  (match o
    ((Some list) (list 1))
    (None Nil)))

(defun (main args) 0)
