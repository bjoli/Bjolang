;; A trait's where clause is about its implementor.

;; EXPECT-ERROR: 'Greet' cannot require 'Named': a trait's where clause is about its implementor, %a, and this names %b.

(import (std prelude))

(def/trait (Named %a)
  (: name-of (-> %a string)))

(def/trait (Greet %a)
  (where (Named %b))
  (: greeting (-> %a string)))

(defun (main args) 0)
