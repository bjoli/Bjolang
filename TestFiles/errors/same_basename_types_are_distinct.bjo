;; Två moduler som heter lika deklarerar var sin `Thing`.
;;
;; Det är två typer, och att lämna den ena till en funktion som vill ha den
;; andra är ett typfel. Förr delade de nyckel — modulen hette sitt filnamn — så
;; det typcheckade, och C#-backenden avvisade programmet efteråt med en CS1503
;; som namngav genererade namn.
;;
;; Katalogtaggen i namnen är en hash av sökvägen och står inte här.

;; EXPECT-ERROR: Type error: these types do not match.
;; EXPECT-ERROR: /thing/Thing
;; EXPECT-ERROR: Both are called Thing
;; EXPECT-ERROR: each declared one

(import (std prelude))
(import "../samebase/a/thing.bjo")
(import "../samebase/b/thing.bjo")

(defun (main)
  (println (peel-a (make-b "boom")))
  0)
