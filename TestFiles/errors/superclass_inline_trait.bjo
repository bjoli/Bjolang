;; An inline-only trait has no dictionary to carry a superclass's in, so it
;; cannot require one.

;; EXPECT-ERROR: 'Mappable' cannot require 'Named': it applies its implementor, so it is inline-only, and an inline-only trait cannot require other traits.

(import (std prelude))

(def/trait (Named %a)
  (: name-of (-> %a string)))

(def/trait (Mappable (%f %a))
  (where (Named %f))
  (: remap (-> (%f %a) (-> %a %b) (%f %b))))

(defun (main args) 0)
