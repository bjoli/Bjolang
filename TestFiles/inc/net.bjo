;; A facade. It publishes two of another module's bindings under the names its
;; callers should write, and compiles to a class with neither of them in it:
;; the export metadata carries the origin, so an importer emits a reference
;; straight to `net_internals` and no forwarding method is generated here.
(import "net_internals.bjo")

(:alias http-get http-get/async+fixed-headers)
(:alias ping ping/v2)

(export http-get ping)
