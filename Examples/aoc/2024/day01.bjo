;; Day 1: Historian Hysteria. Part 1 pairs the two sorted columns and sums the
;; distances. Part 2 sums each left ID times its count in the right column.
(import (std maths) (std mutable map) "common.bjo")

(defun (main args)
  (def (left right)
    (loop (:for line (input-lines args))
          (:let cols (string-split (string-trim line) "   "))
          (:acc left (vecing (parse-long (ref cols 0))))
          (:acc right (vecing (parse-long (ref cols 1))))
          => (Tuple (vec-sort left) (vec-sort right))))
  (println {summing (abs (- a b)) (:for a left) (:for b right)})
  (def counts (mutablemap))
  (defun (count x) (mutablemap-ref-or counts x 0L))
  (vec-for-each #(mutablemap-set! counts & (+ 1L (count &))) right)
  (println {summing (* a (count a)) (:for a left)})
  0)
