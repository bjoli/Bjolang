;; A hoisted form is evaluated once, so it cannot see a local: it would keep the
;; first evaluation's value of it.
;; EXPECT-ERROR: it cannot refer to the local `n`
(import (std prelude))

(: twice (-> int int))
(defun (twice n) (please-hoist-i-promise-i-am-not-naughty (* n 2)))

(defun (main) (twice 1))
