;; Day 2: Red-Nosed Reports. A report is safe when it rises or falls by 1 to 3
;; at each step. Part 2 also counts a report that is safe with one level removed.
(import "common.bjo")

(: safe? (-> (Vec int) bool))
(defun (safe? levels)
  (def* (n (length levels))
        (sign (if (and (> n 1) (< (ref levels 0) (ref levels 1))) 1 -1)))
  (all? #(<= 1 (* sign (- (ref levels &) (ref levels (- & 1)))) 3) (range 1 n)))

(: dampened-safe? (-> (Vec int) bool))
(defun (dampened-safe? levels)
  (or (safe? levels)
      (any? #(safe? (vec-remove-at levels &)) (range 0 (length levels)))))

(defun (main args)
  (def reports {vecing (vec-map string->int (string-split line " ")) (:for line (input-lines args))})
  (println {counting r :when (safe? r) (:for r reports)})
  (println {counting r :when (dampened-safe? r) (:for r reports)})
  0)
