;; A generic function whose type parameter reaches a .NET method imported
;; #:uses-type, for errors/uses_type_across_modules.bjo and
;; 502_uses_type.bjo. An importer learns it from this module's metadata.

(import (std prelude))
(export empty-of)

(import/extern
  (array-empty (: System.Array.Empty (-> (Array %a)) #:uses-type)))

(: (-> (Array %a)))
(defun (empty-of) (array-empty))
