;; EXPECT-ERROR: Kind Error
;; EXPECT-ERROR: abstracts over the last
;;
;; A kind error naming both arities, and mentioning the newtype that a flipped
;; constructor needs.
(import (std prelude))

(def/trait (Monad (%m %a))
  (: pure (-> %a (%m %a)))
  (: bind (-> (%m %a) (-> %a (%m %b)) (%m %b))))

;; `int` takes no arguments at all, so there is nothing for the trait's
;; constructor variable to abstract over.
(def/impl (Monad int)
  (defun (pure x) x)
  (defun (bind m k) (k m)))

(defun (main) 0)
