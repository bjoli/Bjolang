;; A type written at a parameter has to agree with the declared signature.
;;
;; A top-level `defun` normally takes its parameter types from the `(: name ...)`
;; beside it, and one written at the parameter used to be a parse error. It is
;; now the same grammar the body-local form uses — where it is the *only* source
;; of the type — so it is accepted here too, and checked rather than ignored.

;; EXPECT-ERROR: Type error: these types do not match.

(import (std prelude))

(: twice (-> int int))
(defun (twice (: n string))
  (* n 2))

(defun (main)
  (println (int->string (twice 21)))
  0)
