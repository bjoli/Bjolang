;; EXPECT-ERROR: Hole at hole_type_and_fits.bjo:14:8: '_' stands for a value of type int.
;; EXPECT-ERROR: Bindings in scope that fit: n, start
;; EXPECT-ERROR: Hole at hole_type_and_fits.bjo:18:12: '_' stands for a value of type (-?-> string int).
;; EXPECT-ERROR: Bindings in scope that fit: string-count
;;
;; A hole says what the code around it wants, and which bindings would do:
;; the hole's own scope first. A local of another type is no fit.

(import (std prelude))

(: total (-> (List int) int int))
(defun (total xs start)
  (let ((n (length xs)))
    (+ _ n)))

(: lengths (-> (Vec string) (Vec int)))
(defun (lengths names)
  (vec-map _ names))

(defun (main) 0)
