;; A third `thing`, with a macro whose expansion calls a helper of this module.
;; The expansion spells the helper qualified with its module's class, which is
;; `thing_Module` here and in `../a/thing.bjo` alike.

(export doubled double-it)
(import (std prelude))
(import (std syntax-match))

(: double-it (-> int int))
(defun (double-it n) (* n 2))

(def/macro (doubled form inject compare)
  (syntax-match form
    ((_ x) #'(double-it ,x))))
