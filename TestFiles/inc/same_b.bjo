;; For the ambiguous-import tests: the names of `same_a.bjo`, as other things.

(export helper Figure area)
(import (std prelude))

(type (: Figure (Union (: Pt string))))

(: helper (-> int int))
(defun (helper n) (* n 10))

(: area (-> Figure int))
(defun (area f) (match f ((Pt s) (string-length s))))

(def/macro (twice-of form inject compare)
  (match form
    ((SList (Cons _ (Cons x Nil))) #'(* 20 ,x))
    (_ (syntax-error form "twice-of takes one argument"))))
