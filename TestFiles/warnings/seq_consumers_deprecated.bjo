;; `seq->list`, `seq->vec`, `seq->map`, `seq-length` and `seq-head` are the
;; old spellings of `->list`, `->vec`, `->map`, `count` and `first`, which take
;; any iterable. They still work, and say so. `seq->map` is a prelude function
;; deprecated with (:deprecated ...); the others are builtins.

;; EXPECT-WARNING: `seq->list` at seq_consumers_deprecated.bjo:17 is deprecated, use `->list`, which takes any iterable.
;; EXPECT-WARNING: `seq->vec` at seq_consumers_deprecated.bjo:18 is deprecated, use `->vec`, which takes any iterable.
;; EXPECT-WARNING: `seq->map` at seq_consumers_deprecated.bjo:19 is deprecated, use `->map`, which takes any iterable of pairs.
;; EXPECT-WARNING: `seq-length` at seq_consumers_deprecated.bjo:20 is deprecated, use `count`, which takes any iterable.
;; EXPECT-WARNING: `seq-head` at seq_consumers_deprecated.bjo:21 is deprecated, use `first`, which takes any iterable and answers an Option rather than failing on an empty one.

(import (std prelude))
(import (std simpletest))

(defun (main)
  (def xs (list->seq '(1 2 3)))
  (expect "seq->list" (seq->list xs) '(1 2 3))
  (expect "seq->vec" (seq->vec xs) [1 2 3])
  (expect "seq->map" (seq->map (list->seq (list (Tuple 1 "a")))) #map((1 "a")))
  (expect "seq-length" (seq-length xs) 3)
  (expect "seq-head" (seq-head xs) 1)
  0)
