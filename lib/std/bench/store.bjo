;; std/bench/store.bjo — a benchmark run kept in a file, and a run compared
;; with one.
;;
;; A saved run is bjodat, one tagged form, a case to a line:
;;
;;     (bench-run
;;       (version 1)
;;       (saved "2026-10-16T12:00:00Z")
;;       (machine "3f9c...")
;;       (header (build "Release") (dotnet ".NET 10.0.4") ...)
;;       (case (name "sort") (labels ("n" "1000")) (k 512) (once #f)
;;             (bytes 0.0) (samples [41213.0 41180.5 ...]))
;;       ...)
;;
;; The samples rather than a summary: a comparison needs the distribution.
;; It is `(std bench)` that measures and prints; this module knows only runs
;; as data, so that the two do not import each other.

(export SavedRun SavedCase Comparison Verdict CompareResult PairedCase
        saved-run->string parse-saved-run write-saved-run! read-saved-run
        case-key compare-runs compare-paired)

;; Every export is documented there; the module doc is too.
(:doc #:file "store.bjodoc")

(import (std prelude))
(import (std maths))
(import (std bench stats))
(import (text bjodat-core))

;; ---------------------------------------------------------------------------
;; Runs as data
;; ---------------------------------------------------------------------------

;; One benchmark at one combination of its parameters. `samples` are
;; nanoseconds per call, in the order they were taken; `bytes` is allocated
;; bytes per call.
(type (: SavedCase (Record (: name string)
                           (: labels (List (Tuple string string)))
                           (: k long)
                           (: once bool)
                           (: bytes double)
                           (: samples (Vec double)))))

;; A run: when, where, and what it measured. `header` holds the facts of
;; the machine and the build, by name: `build`, `dotnet`, `arch`, `cores`,
;; `gc-server`, `cpu`, `os`, `governor`.
(type (: SavedRun (Record (: saved string)
                          (: machine string)
                          (: header (List (Tuple string string)))
                          (: cases (List SavedCase)))))

(: case-name (-> SavedCase string))
(defun (case-name c) (record-ref c name))

(: case-labels (-> SavedCase (List (Tuple string string))))
(defun (case-labels c) (record-ref c labels))

(: case-samples (-> SavedCase (Vec double)))
(defun (case-samples c) (record-ref c samples))

;; What a case is known by across runs: its name and its parameters, as the
;; report shows them.
(: case-key (-> SavedCase string))
(defun (case-key c)
  (string-join (list->vec (cons (case-name c)
                                (list-map (fun (l) (match l ((Tuple p v) (str p "=" v))))
                                          (case-labels c))))
               " "))

;; ---------------------------------------------------------------------------
;; Writing
;; ---------------------------------------------------------------------------

(def file-version 1L)

(: sym (-> string Bjodat))
(defun (sym s) (BjoSym (string->symbol s)))

(: clause (-> string Bjodat Bjodat))
(defun (clause name value) (BjoList (list (sym name) value)))

(: pair->bjodat (-> (Tuple string string) Bjodat))
(defun (pair->bjodat p) (match p ((Tuple a b) (BjoList (list (BjoStr a) (BjoStr b))))))

(: case->bjodat (-> SavedCase Bjodat))
(defun (case->bjodat c)
  (BjoList (list (sym "case")
                 (clause "name" (BjoStr (case-name c)))
                 (BjoList (cons (sym "labels") (list-map pair->bjodat (case-labels c))))
                 (clause "k" (BjoInt (record-ref c k)))
                 (clause "once" (BjoBool (record-ref c once)))
                 (clause "bytes" (BjoFloat (record-ref c bytes)))
                 (clause "samples" (BjoVec (vec-map BjoFloat (case-samples c)))))))

(: header->bjodat (-> (List (Tuple string string)) Bjodat))
(defun (header->bjodat facts)
  (BjoList (cons (sym "header")
                 (list-map (fun (f) (match f ((Tuple n v) (clause n (BjoStr v))))) facts))))

;; The text of a saved run: a case to a line, so that a diff of two files
;; says which cases changed.
(: saved-run->string (-> SavedRun string))
(defun (saved-run->string r)
  (def lines
    (list-append
      (list (bjodat->string (clause "version" (BjoInt file-version)))
            (bjodat->string (clause "saved" (BjoStr (record-ref r saved))))
            (bjodat->string (clause "machine" (BjoStr (record-ref r machine))))
            (bjodat->string (header->bjodat (record-ref r header))))
      (list-map (fun (c) (bjodat->string (case->bjodat c))) (record-ref r cases))))
  (str "(bench-run\n"
       (string-join (list->vec (list-map (fun (l) (str "  " l)) lines)) "\n")
       ")\n"))

(: write-saved-run! (-> string SavedRun void))
(defun (write-saved-run! path r) (file-write-text path (saved-run->string r)))

;; ---------------------------------------------------------------------------
;; Reading
;; ---------------------------------------------------------------------------

;; The value of clause `name` among `(name value)` clauses.
(: clause-ref (-> (List Bjodat) string (Option Bjodat)))
(defun (clause-ref clauses name)
  (match clauses
    ((Cons (BjoList (Cons (BjoSym s) (Cons v Nil))) more)
     (if (= (symbol->string s) name) (Some v) (clause-ref more name)))
    ((Cons _ more) (clause-ref more name))
    (Nil None)))

;; The clauses of the form `(name ...)` among them, each without its name.
(: forms-named (-> (List Bjodat) string (List (List Bjodat))))
(defun (forms-named clauses name)
  (loop (:for c clauses)
        (:acc (listing (match c ((BjoList (Cons _ rest)) rest) (_ (list))))
              #:when (match c
                       ((BjoList (Cons (BjoSym s) _)) (= (symbol->string s) name))
                       (_ #f)))))

(: number (-> Bjodat (Option double)))
(defun (number d)
  (match d
    ((BjoFloat x) (Some x))
    ((BjoInt n) (Some (cast System.Double n)))
    (_ None)))

(: string-pair (-> Bjodat (Option (Tuple string string))))
(defun (string-pair d)
  (match d
    ((BjoList (Cons (BjoStr a) (Cons (BjoStr b) Nil))) (Some (Tuple a b)))
    (_ None)))

(: all-some (-> (List (Option %a)) (Option (List %a))))
(defun (all-some xs)
  (match xs
    (Nil (Some (list)))
    ((Cons (Some x) more) (match (all-some more) ((Some rest) (Some (cons x rest))) (None None)))
    ((Cons None _) None)))

(: bjodat->case (-> (List Bjodat) (Result string SavedCase)))
(defun (bjodat->case clauses)
  (def labels
    (match (find (fun (c) (match c ((BjoList (Cons (BjoSym s) _)) (= (symbol->string s) "labels")) (_ #f)))
                 clauses)
      ((Some (BjoList (Cons _ pairs))) (all-some (list-map string-pair pairs)))
      (_ None)))
  (match (Tuple (clause-ref clauses "name") labels (clause-ref clauses "k")
                (clause-ref clauses "once") (clause-ref clauses "bytes") (clause-ref clauses "samples"))
    ((Tuple (Some (BjoStr name)) (Some labels) (Some (BjoInt k)) (Some (BjoBool once))
            (Some bytes) (Some (BjoVec samples)))
     (match (Tuple (number bytes) (all-some (list-map number (vec->list samples))))
       ((Tuple (Some b) (Some xs))
        (Ok (SavedCase (name name) (labels labels) (k k) (once once) (bytes b) (samples (list->vec xs)))))
       (_ (Err #"the case ${name} has a sample or a size that is not a number"))))
    (_ (Err "a case lacks one of name, labels, k, once, bytes and samples, or has one of the wrong kind"))))

(: results (-> (List (Result string %a)) (Result string (List %a))))
(defun (results rs)
  (match rs
    (Nil (Ok (list)))
    ((Cons (Ok x) more) (match (results more) ((Ok rest) (Ok (cons x rest))) ((Err e) (Err e))))
    ((Cons (Err e) _) (Err e))))

(def not-a-run "it is not a saved benchmark run: that is one (bench-run ...) form")

(: parse-saved-run (-> string (Result string SavedRun)))
(defun (parse-saved-run text)
  (match (parse-bjodat text)
    ((Err e) (Err e))
    ((Ok (BjoList (Cons (BjoSym head) clauses)))
     (if (not (= (symbol->string head) "bench-run"))
         (Err not-a-run)
         (match (Tuple (clause-ref clauses "version") (clause-ref clauses "saved") (clause-ref clauses "machine"))
           ((Tuple (Some (BjoInt v)) (Some (BjoStr saved)) (Some (BjoStr machine)))
            (if (> v file-version)
                (Err #"it is version ${v} of the format, and this program reads version ${file-version}")
                (saved-run-of clauses saved machine)))
           (_ (Err "it lacks its version, the time it was saved, or its machine")))))
    (_ (Err not-a-run))))


(: saved-run-of (-> (List Bjodat) string string (Result string SavedRun)))
(defun (saved-run-of clauses saved machine)
  (def header
    (match (forms-named clauses "header")
      ((Cons facts _)
       (loop (:for f facts)
             (:acc (listing (match f
                              ((BjoList (Cons (BjoSym n) (Cons (BjoStr v) Nil))) (Tuple (symbol->string n) v))
                              (_ (Tuple "" ""))))
                   #:when (match f ((BjoList (Cons (BjoSym _) (Cons (BjoStr _) Nil))) #t) (_ #f)))))
      (Nil (list))))
  (match (results (list-map bjodat->case (forms-named clauses "case")))
    ((Ok cases) (Ok (SavedRun (saved saved) (machine machine) (header header) (cases cases))))
    ((Err e) (Err e))))

;; The run saved in `path`, or what is wrong with it.
(: read-saved-run (-> string (Result string SavedRun)))
(defun (read-saved-run path)
  (if (not (file-exists? path))
      (Err #"${path} does not exist")
      (match (try (file-read-text path) #:catch (System.Exception))
        ((Ok text)
         (match (parse-saved-run text)
           ((Ok r) (Ok r))
           ((Err e) (Err #"${path}: ${e}"))))
        (_ (Err #"${path} could not be read")))))

;; ---------------------------------------------------------------------------
;; Comparing
;; ---------------------------------------------------------------------------

;; What a comparison concludes: a change that is significant and larger
;; than the threshold, one that is significant but smaller, or none shown.
(type (: Verdict (Union Faster Slower SmallChange NoChange)))

;; One case compared. `change` is the ratio of the medians less one, `now`
;; against `was`, and `lo` and `hi` its 95% interval the same way; `p` is
;; corrected for the run's number of comparisons, `p-raw` is not.
(type (: Comparison (Record (: name string)
                            (: labels (List (Tuple string string)))
                            (: was double)
                            (: now double)
                            (: change double)
                            (: lo double)
                            (: hi double)
                            (: p-raw double)
                            (: p double)
                            (: verdict Verdict)
                            ;; With several process pairs, the standard
                            ;; deviation of their log ratios: how far apart
                            ;; processes were. -1 when it was not measured.
                            (: spread double))))

;; A run compared with a saved one. `only-now` and `only-saved` are the
;; cases one side has and the other has not, by `case-key`. `warnings` are
;; the facts of the two runs that differ; `other-machine` is set when the
;; machine keys do, and then no verdict is to be believed.
(type (: CompareResult (Record (: comparisons (List Comparison))
                               (: only-now (List string))
                               (: only-saved (List string))
                               (: warnings (List string))
                               (: other-machine bool))))

(: fact (-> (List (Tuple string string)) string string))
(defun (fact facts name)
  (match (find (fun (f) (match f ((Tuple n _) (= n name)))) facts)
    ((Some (Tuple _ v)) v)
    (None "")))

;; The facts that a machine key leaves out and that move times: said when
;; they differ.
(def watched-facts (list (Tuple "build" "the build")
                         (Tuple "dotnet" "the .NET version")
                         (Tuple "gc-server" "server GC")
                         (Tuple "governor" "the CPU frequency governor")))

(: fact-warnings (-> SavedRun SavedRun (List string)))
(defun (fact-warnings saved now)
  (loop (:for w watched-facts)
        (:let (Tuple name what) w)
        (:let a (fact (record-ref saved header) name))
        (:let b (fact (record-ref now header) name))
        (:acc (listing #"${what} differs: ${a} in the saved run, ${b} now")
              #:when (not (= a b)))))

(: verdict (-> double double double double Verdict))
(defun (verdict p change alpha threshold)
  (cond
    ((>= p alpha) NoChange)
    ((<= (abs change) threshold) SmallChange)
    ((> change 0.0) Slower)
    (else Faster)))

(: find-case (-> (List SavedCase) string (Option SavedCase)))
(defun (find-case cases key) (find (fun (c) (= (case-key c) key)) cases))

;; `now` compared with `saved`, case by case: the Mann–Whitney U test on the
;; two sets of samples, since a saved run has no pairs, and a bootstrap
;; interval of the ratio of the medians; the p-values corrected by Holm's
;; method for the number of cases compared.
(: compare-runs (-> SavedRun SavedRun double double CompareResult))
(defun (compare-runs saved now alpha threshold)
  (def saved-cases (record-ref saved cases))
  (def now-cases (record-ref now cases))
  (def pairs
    (loop (:for c now-cases)
          (:acc (listing (Tuple (match (find-case saved-cases (case-key c)) ((Some s) s) (None c)) c))
                #:when (some? (find-case saved-cases (case-key c))))))
  (def raw
    (list->vec (list-map (fun (p) (match p ((Tuple a b) (mann-whitney-p (case-samples a) (case-samples b)))))
                         pairs)))
  (def corrected (holm raw))
  (def comparisons
    (loop (:for p pairs)
          (:with i 0 (+ i 1))
          (:let (Tuple a b) p)
          (:let was (median (case-samples a)))
          (:let now-median (median (case-samples b)))
          (:let change (if (> was 0.0) (- (/ now-median was) 1.0) 0.0))
          (:let (Tuple lo hi) (bootstrap-ratio (case-samples a) (case-samples b)))
          (:acc (listing (Comparison (name (case-name b)) (labels (case-labels b))
                                     (was was) (now now-median) (change change)
                                     (lo (- lo 1.0)) (hi (- hi 1.0))
                                     (p-raw (vec-ref raw i)) (p (vec-ref corrected i))
                                     (verdict (verdict (vec-ref corrected i) change alpha threshold))
                                     (spread -1.0))))))
  (CompareResult
    (comparisons comparisons)
    (only-now (loop (:for c now-cases)
                    (:acc (listing (case-key c)) #:when (none? (find-case saved-cases (case-key c))))))
    (only-saved (loop (:for c saved-cases)
                      (:acc (listing (case-key c)) #:when (none? (find-case now-cases (case-key c))))))
    (warnings (fact-warnings saved now))
    (other-machine (not (= (record-ref saved machine) (record-ref now machine))))))

;; ---------------------------------------------------------------------------
;; Comparing in rounds: A/B
;; ---------------------------------------------------------------------------

;; One case of an A/B run: for each process pair, A's and B's per-call times,
;; a sample of each a round, in the order of the rounds.
(type (: PairedCase (Record (: name string)
                            (: labels (List (Tuple string string)))
                            (: a (Vec (Vec double)))
                            (: b (Vec (Vec double))))))

(: log-ratio (-> double double double))
(defun (log-ratio a b) (if (and (> a 0.0) (> b 0.0)) (loge (/ b a)) 0.0))

;; The comparison of one case before the correction: was, now, change, the
;; interval, the raw p, and the spread between processes.
(type (: Paired (Record (: was double) (: now double) (: change double)
                        (: lo double) (: hi double) (: p double) (: spread double))))

(: paired-one (-> PairedCase Paired))
(defun (paired-one c)
  (def pairs (vec-length (record-ref c a)))
  (if (= pairs 1)
      ;; One process a side: the rounds are the pairs. The Wilcoxon test on
      ;; each round's difference of log times, and a bootstrap that draws
      ;; whole rounds.
      (let ()
        (def a (vec-ref (record-ref c a) 0))
        (def b (vec-ref (record-ref c b) 0))
        (def n (min (vec-length a) (vec-length b)))
        (def was (median a))
        (def now (median b))
        (def (Tuple lo hi) (bootstrap-ratio/paired a b))
        (Paired (was was) (now now) (change (if (> was 0.0) (- (/ now was) 1.0) 0.0))
                (lo (- lo 1.0)) (hi (- hi 1.0))
                (p (wilcoxon-p {vecing (log-ratio (vec-ref a i) (vec-ref b i)) (:for i (range 0 n))}))
                (spread -1.0)))
      ;; Several process pairs: one ratio of medians each, and the t-test
      ;; and t-interval on their logs, which a difference between processes
      ;; is in.
      (let ()
        (def logs {vecing (log-ratio (median (vec-ref (record-ref c a) j)) (median (vec-ref (record-ref c b) j)))
                          (:for j (range 0 pairs))})
        (def m (mean logs))
        (def sd (std-dev logs))
        (def half (* (t-critical 0.05 (- pairs 1)) (/ sd (sqrt (cast System.Double pairs)))))
        (Paired (was (median (vec-map median (record-ref c a))))
                (now (median (vec-map median (record-ref c b))))
                (change (- (exp m) 1.0))
                (lo (- (exp (- m half)) 1.0)) (hi (- (exp (+ m half)) 1.0))
                (p (t-test-p logs))
                (spread sd)))))

;; An A/B run's cases compared, A as `was` and B as `now`, the p-values
;; corrected by Holm's method. `only-a` and `only-b` are the cases one side
;; has and the other has not.
(: compare-paired (-> (List PairedCase) (List string) (List string) double double CompareResult))
(defun (compare-paired cases only-a only-b alpha threshold)
  (def results (list->vec (list-map paired-one cases)))
  (def corrected (holm (vec-map (fun (r) (record-ref r p)) results)))
  (CompareResult
    (comparisons
      (loop (:for c cases)
            (:with i 0 (+ i 1))
            (:let r (vec-ref results i))
            (:acc (listing (Comparison (name (record-ref c name)) (labels (record-ref c labels))
                                       (was (record-ref r was)) (now (record-ref r now))
                                       (change (record-ref r change))
                                       (lo (record-ref r lo)) (hi (record-ref r hi))
                                       (p-raw (record-ref r p)) (p (vec-ref corrected i))
                                       (verdict (verdict (vec-ref corrected i) (record-ref r change) alpha threshold))
                                       (spread (record-ref r spread)))))))
    (only-now only-b)
    (only-saved only-a)
    (warnings (list))
    (other-machine #f)))
