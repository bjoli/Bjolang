;; For 383_class_alias_shadows_import.bjo: a record type called `Url`, which
;; an importer also names with an `import/class` alias of its own.

(export Url url-record url-text)
(import (std prelude))

(type (: Url (Record (: text string))))

(: url-record (-> string Url))
(defun (url-record s) (Url (text s)))

(: url-text (-> Url string))
(defun (url-text u) (record-ref u text))
