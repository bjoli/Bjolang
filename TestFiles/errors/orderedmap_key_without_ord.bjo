;; An ordered map compares its keys, so a type with no Ord cannot key one.
;; EXPECT-ERROR: no implementation of trait 'Ord' for 'orderedmap_key_without_ord/Pt', needed to call 'orderedmap-empty'
(import (std prelude))
(import (std orderedmap))

(type (: Pt (Record (: x int) (: y int))))

(defun (main)
  (def m (orderedmap-set (orderedmap-empty) (Pt (x 1) (y 2)) "a"))
  (println (->str (orderedmap-length m)))
  0)
