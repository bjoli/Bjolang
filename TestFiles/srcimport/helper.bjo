;; An imported source module. `(import "helper.bjo")` compiles this to
;; `helper.dll` and imports that — a module boundary is an assembly boundary,
;; so only what is exported crosses it, and every exported name needs a
;; signature.
;;
;; For splitting one module across files with no boundary at all, use
;; `(include ...)`.

(: twice (-> int int))
(defun (twice x)
  (* x 2))

;; Not exported, and so not visible to whoever imports this.
(: secret (-> int int))
(defun (secret x)
  (+ x 1000))

(export twice)
