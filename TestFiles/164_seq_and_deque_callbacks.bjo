;; The eager Seq walks, and the deque's.
;;
;; `seq-fold` and `seq-for-each` were builtins. They are prelude functions now,
;; over `seq-cursor`, which is what lets their callback suspend. `seq-map`,
;; `seq-filter` and `seq-unfold` stay builtins: they are lazy, so the callback
;; runs when the walker pulls rather than here.
;;
;; `deque-fold` and `deque-for-each` needed no body of their own — they hand
;; the callback to `list-foldl` and `list-for-each`, which picks those
;; functions' suspending copies.

(import (std prelude))
(import (std mutable deque))
(import (std simpletest))

;; The yield point: `read-line` from a bjoroutine.
(: slow-double (-bjo-> int int))
(defbjo (slow-double n)
  (ignore (read-line (open-input-string "tick\n")))
  (* n 2))

(: run-int (-> (Promise int) int))
(defun (run-int p)
  (match (sync/blocking (promise-join p)) ((Ok n) n) ((Err e) -1)))

;; ---------------------------------------------------------------------------
;; Seq
;; ---------------------------------------------------------------------------

(: seq-folded (-bjo-> int))
(defbjo (seq-folded)
  (seq-fold (bjoroutine (acc x) (+ acc (slow-double x))) 0 (seq-range 1 4)))

(def/mutable seen 0)

(: seq-each (-bjo-> int))
(defbjo (seq-each)
  (set! seen 0)
  (ignore (seq-for-each (bjoroutine (x) (set! seen (+ seen (slow-double x))))
                        (seq-range 1 4)))
  seen)

;; The lazy half still produces ordinarily while the eager half suspends.
(: over-lazy (-bjo-> int))
(defbjo (over-lazy)
  (seq-fold (bjoroutine (acc x) (+ acc (slow-double x)))
            0
            (seq-filter (fun (x) (> x 1)) (seq-map (fun (x) (+ x 1)) (seq-range 0 3)))))

;; ---------------------------------------------------------------------------
;; Deque
;; ---------------------------------------------------------------------------

(: three (-> (Deque int)))
(defun (three)
  (list->deque (list 1 2 3)))

(: deque-folded (-bjo-> int))
(defbjo (deque-folded)
  (deque-fold (bjoroutine (acc x) (+ acc (slow-double x))) 0 (three)))

(: deque-each (-bjo-> int))
(defbjo (deque-each)
  (set! seen 0)
  (deque-for-each (bjoroutine (x) (set! seen (+ seen (slow-double x)))) (three))
  seen)

;; Both halves occupied, so the walk crosses the reversed rear list.
(: split (-> (Deque int)))
(defun (split)
  (let ((d (list->deque (list 2 3))))
    (deque-push-front! d 1)
    (deque-push-back! d 4)
    d))

(: deque-split-folded (-bjo-> string))
(defbjo (deque-split-folded)
  (deque-fold (bjoroutine (acc x) (str acc (int->string (slow-double x)))) "" (split)))

(: run-str (-> (Promise string) string))
(defun (run-str p)
  (match (sync/blocking (promise-join p)) ((Ok s) s) ((Err e) "raised")))

(defun (main)
  (expect "seq-fold suspending" (run-int (bjo (seq-folded))) 12)
  (expect "seq-for-each suspending" (run-int (bjo (seq-each))) 12)
  (expect "a suspending fold over a lazy seq" (run-int (bjo (over-lazy))) 10)

  (expect "deque-fold suspending" (run-int (bjo (deque-folded))) 12)
  (expect "deque-for-each suspending" (run-int (bjo (deque-each))) 12)
  (expect "deque-fold keeps front to back" (run-str (bjo (deque-split-folded))) "2468")

  (expect "seq-fold, ordinarily" (seq-fold (fun (a x) (+ a x)) 0 (seq-range 1 4)) 6)
  (expect "deque-fold, ordinarily" (deque-fold (fun (a x) (+ a x)) 0 (three)) 6)
  0)
