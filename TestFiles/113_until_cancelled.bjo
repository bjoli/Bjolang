;; `until-cancelled`: watching a token that is not the ambient one.
;;
;; The ambient token is `sync`'s business — a `sync` under a cancelled scope
;; raises `Cancelled`, and nothing has to be written for that to happen. This
;; combinator is for every *other* token: a per-request deadline, a sub-scope's,
;; one received from somewhere else. Those are ordinary events, and this is how
;; one is raced against real work.
;;
;; It answers `None` rather than raising, and the reason is the trap that would
;; otherwise be there. A fired token is *persistent* — that is the design, since
;; cancellation is a fact every listener has to see — and persistence is also
;; the trap. A loop that races `(cancelled tok)` in a `choose` and then goes
;; round again finds the token branch available immediately, wins on it, goes
;; round again, and spins a core at 100%. `None` makes leaving the natural
;; spelling, because not recursing is what you write anyway.
;;
;; The loop clause `(:until-cancelled)` is the other half, and it is for a
;; different loop: the compute loop that has no sync point to hang an event on
;; at all. It is a poll, so it can read the ambient token without disagreeing
;; with `sync` about anything.

(import (std prelude))
(import (std simpletest))

;; ---------------------------------------------------------------------------
;; The combinator
;; ---------------------------------------------------------------------------
;;
;; The token is a parameter. It used to be read out of the dynamic environment,
;; and that job moved to `sync`: two mechanisms watching one token — one
;; raising, one answering `None` — would be two answers to the same question.

(: worker (-> CancelToken (Chan int) (Chan string) void))
(defbjo (worker tok jobs results)
  (let go ((total 0) (taken 0))
    (match (sync (until-cancelled tok (chan-recv jobs)))
      ((Some j) (go (+ total j) (+ taken 1)))
      (None (sync (chan-send results
                             (string-append (int->string taken)
                                            (string-append "/" (int->string total)))))))))

;; Handed a token nobody holds the other half of, `until-cancelled` is `Some`
;; for as long as there is anything to take, and the loop leaves on its own
;; terms instead.
(: bounded (-> CancelToken (Chan int) int int))
(defbjo (bounded tok jobs n)
  (let go ((i 0) (total 0))
    (if (= i n)
        total
        (match (sync (until-cancelled tok (chan-recv jobs)))
          ((Some j) (go (+ i 1) (+ total j)))
          (None total)))))

(: feed (-> (Chan int) int void))
(defbjo (feed jobs n)
  (loop (:for i (range 0 n))
        (:do (sync (chan-send jobs i)))))

;; ---------------------------------------------------------------------------
;; The loop clause
;; ---------------------------------------------------------------------------
;;
;; No sync point anywhere in here, so there is no event to race — which is the
;; whole reason the clause exists alongside the combinator. The test is once per
;; iteration, and the ambient read is hoisted to loop entry, so the body pays a
;; predicate rather than a dynamic-environment lookup.
;;
;; Written *before* the accumulator on purpose: clause order decides where in an
;; iteration the exit happens, so the iteration that sees the token contributes
;; nothing.
(: count-ambient (-> int int))
(defun (count-ambient limit)
  (loop (:for i (range 0 limit))
        (:until-cancelled)
        (:acc n (counting i))
        => n))

;; The explicit form does no lookup at all, and is the only way to watch a token
;; that is not the ambient one.
(: count-explicit (-> CancelToken int int))
(defun (count-explicit tok limit)
  (loop (:for i (range 0 limit))
        (:until-cancelled tok)
        (:acc n (counting i))
        => n))

;; The exit is where it is written, not at the top: this one accumulates first,
;; so the iteration that notices the cancellation has already counted.
(: count-after (-> CancelToken int int))
(defun (count-after tok limit)
  (loop (:for i (range 0 limit))
        (:acc n (counting i))
        (:until-cancelled tok)
        => n))

(defbjo (main args)
  ;; ---- The combinator, uncancelled -----------------------------------------
  (def (never-fires! idle) (make-cancel))
  (def jobs (make-chan))
  (spawn (feed jobs 4))
  (expect "an uncancelled until-cancelled is just the event"
          (bounded idle jobs 4) 6)

  ;; ---- The combinator, cancelled while parked ------------------------------
  ;;
  ;; Each send is a rendezvous, so by the time the second returns the worker has
  ;; taken both and is parked in the sync with nothing to receive. The
  ;; cancellation is what wakes it, and `None` is what it wakes to.
  (def (stop! tok) (make-cancel))
  (def jobs2 (make-chan))
  (def results (make-chan))
  (def w (bjo (worker tok jobs2 results)))
  (def s1 (sync (chan-send jobs2 20)))
  (def s2 (sync (chan-send jobs2 22)))
  (def stopped (stop! (Requested "the test")))
  (expect "a parked until-cancelled wakes on the token it was handed"
          (sync (chan-recv results)) "2/42")

  ;; And the fiber came home rather than spinning: a `None` that is not
  ;; recursed on is a loop that has left.
  (expect "and the worker finished"
          (match (sync (promise-join w)) ((Ok u) "done") ((Err e) "failed"))
          "done")

  ;; ---- The loop clause -----------------------------------------------------
  (expect "an uncancelled ambient clause runs to the limit"
          (count-ambient 100) 100)

  (def (stop-scope! scope) (make-cancel))
  (def sc (stop-scope! Deadline))
  (expect "a cancelled ambient clause stops at once"
          (parameterize ((current-cancel scope)) (count-ambient 100)) 0)

  ;; The read is hoisted to loop *entry*, and entry is inside the
  ;; `parameterize` here — which is exactly why it is loop entry and not
  ;; function entry. Read at function entry this would see the root token and
  ;; count to 100.
  (def (stop-later! later) (make-cancel))
  (expect "an ambient clause under an unfired token runs to the limit"
          (parameterize ((current-cancel later)) (count-ambient 100)) 100)

  ;; ---- The explicit form ---------------------------------------------------
  (def (never! quiet) (make-cancel))
  (expect "an explicit clause on an unfired token runs to the limit"
          (count-explicit quiet 100) 100)

  (def (now! fired) (make-cancel))
  (def n (now! (Requested "the test")))
  (expect "an explicit clause on a fired token stops at once"
          (count-explicit fired 100) 0)

  ;; Clause order is the author's, and it is observable: with the exit written
  ;; after the accumulator, the iteration that sees the token has already
  ;; counted.
  (expect "and the exit happens where it was written"
          (count-after fired 100) 1)

  (println "113 ok")
  0)
