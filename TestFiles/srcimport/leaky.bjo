;; A module whose exported signature names a type it does not export.
;;
;; Built on demand by `errors/type_not_exported.bjo`, which is the only thing
;; that imports it — it lives here rather than in `inc/` because the fixture
;; builder compiles everything in that directory and this is meant not to
;; compile.
(export make-crate)

(type (: Crate (Union (MkCrate int))))

(: make-crate (-> int Crate))
(defun (make-crate n) (MkCrate n))
