;; Functions with number types that have units, for 509_unit_types.bjo.
(import (std prelude))

(export same sec pick ratio)

(def/dimension length #:base m)
(def/dimension time #:base s)

(: same (-> (double m) (double m)))
(defun (same x) x)

(: sec (-> (double s) (double s)))
(defun (sec x) x)

(: pick (-> (double %u) (double %u) (double %u)))
(defun (pick a b) a)

(: ratio (-> (double m/s) (double m/s)))
(defun (ratio v) v)
