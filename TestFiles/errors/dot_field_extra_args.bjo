;; `(.field r args...)` does not call a function stored in the field. Only
;; `((.field r) args...)` does.

;; EXPECT-ERROR: '.run' reads a field, so it takes exactly one argument
;; EXPECT-ERROR: write ((.run target) args...)

(import (std prelude))

(type (: Job (Record (: run (-> int int)))))

(defun (main args)
  (def j (Job (run (fun (n) (+ n 1)))))
  (println (int->string (.run j 41)))
  0)
