;; A trait method has no parameter names, so its doc gives them, one for each.

;; EXPECT-ERROR: names 1 argument with (arg ...), and combine takes 2 arguments

(import (std prelude))

(def/trait (Combines %c)
  (: combine (-> %c %c %c)))

(:doc combine (summary "Combines.") (arg a "One.") (returns "Both."))

(defun (main args) 0)
