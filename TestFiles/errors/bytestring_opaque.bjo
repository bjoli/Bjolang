;; A ByteString is opaque: code outside (std prelude bytestring) cannot build one, so
;; it cannot hold an array that something else writes to.
;;
;; EXPECT-ERROR: cannot be constructed here

(import (std prelude))

(defun (main)
  (def a (string->bytes "abc"))
  (println (bytestring-length (ByteString (bytes a) (start 0) (end 3)))))
