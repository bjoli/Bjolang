;; std/orderedmap.bjo — the sorted map.
;; Persistent B-tree keyed in the keys' natural order. Lookups are O(log n).

(export
  ;; The types.
  OrderedMap OrderedMapBuilder TransientOrderedMap OrderedMapCursor
  OrderedMapping

  ;; Maps
  orderedmap-empty orderedmap-ref orderedmap-ref-or orderedmap-try-ref
  orderedmap-set orderedmap-set-all orderedmap-remove orderedmap-remove-all
  orderedmap-contains? orderedmap-has-key? orderedmap-length orderedmap-empty?
  orderedmap-clear orderedmap-keys orderedmap-values
  orderedmap-merge orderedmap-merge-with
  ;; Order — what the tree is for
  orderedmap-min orderedmap-max orderedmap-successor orderedmap-predecessor
  orderedmap-range orderedmap-from orderedmap-until
  ;; Walking and rebuilding
  orderedmap-map orderedmap-map-values orderedmap-filter orderedmap-fold
  orderedmap-for-each orderedmap-iter orderedmap-any? orderedmap-find
  ;; Conversions
  list->orderedmap orderedmap->list vec->orderedmap orderedmap->vec
  seq->orderedmap orderedmap->seq map->orderedmap orderedmap->map
  orderedmap->str
  ;; Builders — the same shape as ListBuilder
  orderedmapbuilder-empty orderedmap->orderedmapbuilder orderedmapbuilder-add!
  orderedmapbuilder-add-all! orderedmapbuilder-length
  orderedmapbuilder->orderedmap
  ;; Transients — the map's interface, in place
  transientorderedmap-empty orderedmap->transientorderedmap
  transientorderedmap->orderedmap transientorderedmap-set!
  transientorderedmap-set-all! transientorderedmap-remove!
  transientorderedmap-remove-all! transientorderedmap-contains?
  transientorderedmap-ref transientorderedmap-ref-or transientorderedmap-try-ref
  transientorderedmap-length transientorderedmap-empty?
  transientorderedmap-filter!)

(import (std prelude))

(import/class
  ((OrderedMap %k %v) (: OrderedMap.OrderedMap))
  ((OrderedMapBuilder %k %v) (: OrderedMap.OrderedMapBuilder))
  ((TransientOrderedMap %k %v) (: OrderedMap.TransientOrderedMap))
  ((OrderedMapCursor %k %v) (: OrderedMap.OrderedMapCursor))
  ;; What a map orders its keys by. See `ord-comparer`.
  ((Comparer %a) (: System.Collections.Generic.IComparer)))

;; ---------------------------------------------------------------------------
;; The map
;; ---------------------------------------------------------------------------

(import/extern
  (clr-orderedmap-empty  (: OrderedMap.OrderedMapModule.Empty       (-> (Comparer %k) (OrderedMap %k %v))))
  (clr-orderedmap-comparer (: OrderedMap.OrderedMapModule.Comparer  (-> (OrderedMap %k %v) (Comparer %k))))
  ;; Lookups.
  (orderedmap-ref        (: OrderedMap.OrderedMapModule.Ref         (-> (OrderedMap %k %v) %k %v)))
  (orderedmap-ref-or     (: OrderedMap.OrderedMapModule.RefOr       (-> (OrderedMap %k %v) %k %v %v)))
  (orderedmap-set        (: OrderedMap.OrderedMapModule.Set         (-> (OrderedMap %k %v) %k %v (OrderedMap %k %v))))
  ;; Bulk set.
  (orderedmap-set-all    (: OrderedMap.OrderedMapModule.SetRange    (-> (OrderedMap %k %v) (Seq (Tuple %k %v)) (OrderedMap %k %v))))
  (orderedmap-remove     (: OrderedMap.OrderedMapModule.Remove      (-> (OrderedMap %k %v) %k (OrderedMap %k %v))))
  (orderedmap-remove-all (: OrderedMap.OrderedMapModule.RemoveRange (-> (OrderedMap %k %v) (Seq %k) (OrderedMap %k %v))))
  (orderedmap-contains?  (: OrderedMap.OrderedMapModule.ContainsKey (-> (OrderedMap %k %v) %k bool)))
  (orderedmap-length     (: OrderedMap.OrderedMapModule.Count       (-> (OrderedMap %k %v) int)))
  (orderedmap-empty?     (: OrderedMap.OrderedMapModule.IsEmpty     (-> (OrderedMap %k %v) bool)))
  (orderedmap-clear      (: OrderedMap.OrderedMapModule.Clear       (-> (OrderedMap %k %v) (OrderedMap %k %v))))
  (orderedmap-keys       (: OrderedMap.OrderedMapModule.Keys        (-> (OrderedMap %k %v) (Seq %k))))
  (orderedmap-values     (: OrderedMap.OrderedMapModule.Values      (-> (OrderedMap %k %v) (Seq %v))))
  ;; Merging.
  (orderedmap-merge      (: OrderedMap.OrderedMapModule.Merge       (-> (OrderedMap %k %v) (OrderedMap %k %v) (OrderedMap %k %v))))
  (orderedmap-merge-with (: OrderedMap.OrderedMapModule.MergeWith   (-> (-> %k %v %v %v) (OrderedMap %k %v) (OrderedMap %k %v) (OrderedMap %k %v))))

  ;; Try ref, answering Option.
  (orderedmap-try-ref (: OrderedMap.OrderedMapModule.TryGetValue (-> (OrderedMap %k %v) %k (out %v) (Option %v))))

  ;; --- Order ---
  ;; Min entry as Option.
  (orderedmap-min         (: OrderedMap.OrderedMapModule.TryGetMin         (-> (OrderedMap %k %v) (out %k) (out %v) (Option (Tuple %k %v)))))
  (orderedmap-max         (: OrderedMap.OrderedMapModule.TryGetMax         (-> (OrderedMap %k %v) (out %k) (out %v) (Option (Tuple %k %v)))))
  ;; Successor entry.
  (orderedmap-successor   (: OrderedMap.OrderedMapModule.TryGetSuccessor   (-> (OrderedMap %k %v) %k (out %k) (out %v) (Option (Tuple %k %v)))))
  (orderedmap-predecessor (: OrderedMap.OrderedMapModule.TryGetPredecessor (-> (OrderedMap %k %v) %k (out %k) (out %v) (Option (Tuple %k %v)))))

  ;; Range walks.
  (orderedmap-range (: OrderedMap.OrderedMapModule.Range (-> (OrderedMap %k %v) %k %k (Seq (Tuple %k %v)))))
  (orderedmap-from  (: OrderedMap.OrderedMapModule.From  (-> (OrderedMap %k %v) %k (Seq (Tuple %k %v)))))
  (orderedmap-until (: OrderedMap.OrderedMapModule.Until (-> (OrderedMap %k %v) %k (Seq (Tuple %k %v)))))

  ;; --- Walking ---
  ;;
  (clr-orderedmap-map        (: OrderedMap.OrderedMapModule.Map       (-> (-> %k %v %w) (OrderedMap %k %v) (OrderedMap %k %w))))
  ;; Map values.
  (clr-orderedmap-map-values (: OrderedMap.OrderedMapModule.MapValues (-> (-> %v %w) (OrderedMap %k %v) (OrderedMap %k %w))))
  (clr-orderedmap-filter     (: OrderedMap.OrderedMapModule.Filter    (-> (-> %k %v bool) (OrderedMap %k %v) (OrderedMap %k %v))))
  (clr-orderedmap-fold       (: OrderedMap.OrderedMapModule.Fold      (-> (-> %k %v %s %s) %s (OrderedMap %k %v) %s)))
  (clr-orderedmap-iter       (: OrderedMap.OrderedMapModule.Iter      (-> (-> %k %v bool) (OrderedMap %k %v) bool)))
  (orderedmap-any?       (: OrderedMap.OrderedMapModule.Exists    (-> (-> %k %v bool) (OrderedMap %k %v) bool)))
  ;; Find entry satisfying pred.
  (orderedmap-find       (: OrderedMap.OrderedMapModule.TryFind   (-> (-> %k %v bool) (OrderedMap %k %v) (out %k) (out %v) (Option (Tuple %k %v)))))

  (clr-seq->orderedmap (: OrderedMap.OrderedMapModule.FromEnumerable (-> (Seq (Tuple %k %v)) (Comparer %k) (OrderedMap %k %v))))
  (orderedmap->seq (: OrderedMap.OrderedMapModule.AsEnumerable   (-> (OrderedMap %k %v) (Seq (Tuple %k %v)))))

  (orderedmap-cursor         (: OrderedMap.OrderedMapModule.Cursor        (-> (OrderedMap %k %v) (OrderedMapCursor %k %v))))
  (orderedmap-cursor-done?   (: OrderedMap.OrderedMapModule.CursorDone    (-> (OrderedMapCursor %k %v) bool)))
  (orderedmap-cursor-current (: OrderedMap.OrderedMapModule.CursorCurrent (-> (OrderedMapCursor %k %v) (Tuple %k %v)))))

;; Alias for contains?.
(: orderedmap-has-key? (-> (OrderedMap %k %v) %k bool))
(defun (orderedmap-has-key? m key) (orderedmap-contains? m key))

;; `(om-has key p)` matches a map that has `key`, with `p` matching its value:
;;
;;     (match config
;;       ((om-has "port" (:view ->str p)) p)
;;       (_ "8080"))
;;
;; A pattern macro over `orderedmap-try-ref`, which is an exported binding of
;; this module — a template resolves a name to the module it was written in, so
;; the call site needs no name for it.
;;
;; The lookup runs once per clause that tries it, as every view does. Three
;; clauses reading three keys are three lookups; that is the price of writing
;; the test in the pattern rather than before the `match`.
(def/pattern (om-has form inject compare)
  (match form
    ((SList (Cons _ (Cons key (Cons p Nil))))
     #'(:view (orderedmap-try-ref & ,key) (Some ,p)))
    (_ (syntax-error form "(om-has key p) matches a map that has key, p matching the value."))))

;; ---------------------------------------------------------------------------
;; Builders and transients
;; ---------------------------------------------------------------------------

(import/extern
  (clr-orderedmapbuilder-empty   (: OrderedMap.OrderedMapBuilderModule.Empty    (-> (Comparer %k) (OrderedMapBuilder %k %v))))
  (orderedmap->orderedmapbuilder (: OrderedMap.OrderedMapBuilderModule.FromMap  (-> (OrderedMap %k %v) (OrderedMapBuilder %k %v))))
  (orderedmapbuilder-add!        (: OrderedMap.OrderedMapBuilderModule.Add      (-> (OrderedMapBuilder %k %v) %k %v void)))
  (orderedmapbuilder-add-all!    (: OrderedMap.OrderedMapBuilderModule.AddRange (-> (OrderedMapBuilder %k %v) (Seq (Tuple %k %v)) void)))
  ;; Length in builder.
  (orderedmapbuilder-length      (: OrderedMap.OrderedMapBuilderModule.Count    (-> (OrderedMapBuilder %k %v) int)))
  (orderedmapbuilder->orderedmap (: OrderedMap.OrderedMapBuilderModule.Build    (-> (OrderedMapBuilder %k %v) (OrderedMap %k %v))))

  (clr-transientorderedmap-empty   (: OrderedMap.TransientOrderedMapModule.Empty          (-> (Comparer %k) (TransientOrderedMap %k %v))))
  (orderedmap->transientorderedmap (: OrderedMap.TransientOrderedMapModule.FromPersistent (-> (OrderedMap %k %v) (TransientOrderedMap %k %v))))
  (transientorderedmap->orderedmap (: OrderedMap.TransientOrderedMapModule.ToPersistent   (-> (TransientOrderedMap %k %v) (OrderedMap %k %v))))
  (transientorderedmap-set!        (: OrderedMap.TransientOrderedMapModule.Set            (-> (TransientOrderedMap %k %v) %k %v void)))
  (transientorderedmap-set-all!    (: OrderedMap.TransientOrderedMapModule.SetRange       (-> (TransientOrderedMap %k %v) (Seq (Tuple %k %v)) void)))
  (transientorderedmap-remove!     (: OrderedMap.TransientOrderedMapModule.Remove         (-> (TransientOrderedMap %k %v) %k void)))
  (transientorderedmap-remove-all! (: OrderedMap.TransientOrderedMapModule.RemoveRange    (-> (TransientOrderedMap %k %v) (Seq %k) void)))
  (transientorderedmap-contains?   (: OrderedMap.TransientOrderedMapModule.ContainsKey    (-> (TransientOrderedMap %k %v) %k bool)))
  (transientorderedmap-ref         (: OrderedMap.TransientOrderedMapModule.Ref            (-> (TransientOrderedMap %k %v) %k %v)))
  (transientorderedmap-ref-or      (: OrderedMap.TransientOrderedMapModule.RefOr          (-> (TransientOrderedMap %k %v) %k %v %v)))
  (transientorderedmap-length      (: OrderedMap.TransientOrderedMapModule.Count          (-> (TransientOrderedMap %k %v) int)))
  (transientorderedmap-empty?      (: OrderedMap.TransientOrderedMapModule.IsEmpty        (-> (TransientOrderedMap %k %v) bool)))
  (transientorderedmap-filter!     (: OrderedMap.TransientOrderedMapModule.FilterInPlace  (-> (-> %k %v bool) (TransientOrderedMap %k %v) void)))
  (transientorderedmap-try-ref     (: OrderedMap.TransientOrderedMapModule.TryGetValue    (-> (TransientOrderedMap %k %v) %k (out %v) (Option %v)))))

;; ---------------------------------------------------------------------------
;; Where a map comes from
;; ---------------------------------------------------------------------------

;; What makes a map out of nothing asks for the key's Ord, and the tree orders
;; keys by it — the order `compare` gives, also where the type has no CompareTo
;; of its own. One made from a map keeps that map's.
(: orderedmap-empty (-> (OrderedMap %k %v)) (where (Ord %k)))
(defun (orderedmap-empty) (clr-orderedmap-empty (ord-comparer)))

(: seq->orderedmap (-> (Seq (Tuple %k %v)) (OrderedMap %k %v)) (where (Ord %k)))
(defun (seq->orderedmap xs) (clr-seq->orderedmap xs (ord-comparer)))

(: orderedmapbuilder-empty (-> (OrderedMapBuilder %k %v)) (where (Ord %k)))
(defun (orderedmapbuilder-empty) (clr-orderedmapbuilder-empty (ord-comparer)))

(: transientorderedmap-empty (-> (TransientOrderedMap %k %v)) (where (Ord %k)))
(defun (transientorderedmap-empty) (clr-transientorderedmap-empty (ord-comparer)))

;; ---------------------------------------------------------------------------
;; Ordered maps, where the callback may suspend
;; ---------------------------------------------------------------------------

(: orderedmap-map (-> (-?-> %k %v %w) (OrderedMap %k %v) (OrderedMap %k %w)))
(defbjouble (orderedmap-map f m)
  (#:sync (clr-orderedmap-map f m))
  (#:bjo
    (def b (clr-orderedmapbuilder-empty (clr-orderedmap-comparer m)))
    (def c (orderedmap-cursor m))
    (let go ()
      (cond
        ((orderedmap-cursor-done? c) (orderedmapbuilder->orderedmap b))
        (else
          (def (k v) (orderedmap-cursor-current c))
          (orderedmapbuilder-add! b k (f k v))
          (go))))))

(: orderedmap-map-values (-> (-?-> %v %w) (OrderedMap %k %v) (OrderedMap %k %w)))
(defbjouble (orderedmap-map-values f m)
  (#:sync (clr-orderedmap-map-values f m))
  (#:bjo
    (def b (clr-orderedmapbuilder-empty (clr-orderedmap-comparer m)))
    (def c (orderedmap-cursor m))
    (let go ()
      (cond
        ((orderedmap-cursor-done? c) (orderedmapbuilder->orderedmap b))
        (else
          (def (k v) (orderedmap-cursor-current c))
          (orderedmapbuilder-add! b k (f v))
          (go))))))

(: orderedmap-filter (-> (-?-> %k %v bool) (OrderedMap %k %v) (OrderedMap %k %v)))
(defbjouble (orderedmap-filter keep? m)
  (#:sync (clr-orderedmap-filter keep? m))
  (#:bjo
    (def b (clr-orderedmapbuilder-empty (clr-orderedmap-comparer m)))
    (def c (orderedmap-cursor m))
    (let go ()
      (cond
        ((orderedmap-cursor-done? c) (orderedmapbuilder->orderedmap b))
        (else
          (def (k v) (orderedmap-cursor-current c))
          (when (keep? k v)
            (orderedmapbuilder-add! b k v))
          (go))))))

(: orderedmap-fold (-> (-?-> %k %v %s %s) %s (OrderedMap %k %v) %s))
(defbjouble (orderedmap-fold f init m)
  (#:sync (clr-orderedmap-fold f init m))
  (#:bjo
    (def c (orderedmap-cursor m))
    (let go ((acc init))
      (cond
        ((orderedmap-cursor-done? c) acc)
        (else
          (def (k v) (orderedmap-cursor-current c))
          (go (f k v acc)))))))

(: orderedmap-iter (-> (-?-> %k %v bool) (OrderedMap %k %v) bool))
(defbjouble (orderedmap-iter f m)
  (#:sync (clr-orderedmap-iter f m))
  (#:bjo
    (def c (orderedmap-cursor m))
    (let go ()
      (cond
        ((orderedmap-cursor-done? c) #t)
        (:def (k v) (orderedmap-cursor-current c))
        ((f k v) (go))
        (else #f)))))

;; ---------------------------------------------------------------------------
;; Conversions
;; ---------------------------------------------------------------------------
;; TODO: currently orderedmap-for-each goes through the enumerator,
;;       when internal iteration would be a lot faster. 
(: list->orderedmap (-> (List (Tuple %k %v)) (OrderedMap %k %v)) (where (Ord %k)))
(defun (list->orderedmap xs)
  (def om (orderedmapbuilder-empty))
  (loop (:for (k . v) xs)
        (:do (orderedmapbuilder-add! om k v)))
  (orderedmapbuilder->orderedmap om))

(: orderedmap->list (-> (OrderedMap %k %v) (List (Tuple %k %v))))
(defun (orderedmap->list m)
  (def lb (listbuilder-empty))
  (orderedmap-for-each #(listbuilder-add! lb (&1 . &2)) m)
  (listbuilder->list lb))

(: vec->orderedmap (-> (Vec (Tuple %k %v)) (OrderedMap %k %v)) (where (Ord %k)))
(defun (vec->orderedmap v)
  (def om (orderedmapbuilder-empty))
  (vec-for-each #(let (((k . v) &))
                   (orderedmapbuilder-add! om k v)) v)
  (orderedmapbuilder->orderedmap om))

(: orderedmap->vec (-> (OrderedMap %k %v) (Vec (Tuple %k %v))))
(defun (orderedmap->vec m)
  (def vb (vecbuilder-empty))
  (orderedmap-for-each #(vecbuilder-add! vb (&1 . &2)) m)
  (vecbuilder->vec vb))

;; Hashed map conversions.
(: map->orderedmap (-> (Map %k %v) (OrderedMap %k %v)) (where (Ord %k)))
(defun (map->orderedmap m)
  (def om (orderedmapbuilder-empty))
  (map-for-each #(orderedmapbuilder-add! om &1 &2) m)
  (orderedmapbuilder->orderedmap om))

(: orderedmap->map (-> (OrderedMap %k %v) (Map %k %v)))
(defun (orderedmap->map m)
  (def mb (mapbuilder-empty))
  (orderedmap-for-each #(mapbuilder-add! mb &1 &2) m)
  (mapbuilder->map mb))

;; ---------------------------------------------------------------------------
;; The traits
;; ---------------------------------------------------------------------------
(impl (Refable (OrderedMap %k %v))
  (type %index %k)
  (type %out %v)
  (defun (ref orderedmap key)
    (orderedmap-ref orderedmap key))
  (defun (try-ref orderedmap key)
    (orderedmap-try-ref orderedmap key)))

(impl (Settable (OrderedMap %k %v))
  (type %index %k)
  (type %in %v)
  (defun (ref-set orderedmap key v)
    (orderedmap-set orderedmap key v)))

(impl (Refable (TransientOrderedMap %k %v))
  (type %index %k)
  (type %out %v)
  (defun (ref orderedmap key)
    (transientorderedmap-ref orderedmap key))
  (defun (try-ref orderedmap key)
    (transientorderedmap-try-ref orderedmap key)))


(impl (Iterable (OrderedMap %k %v))
  (type %elem (Tuple %k %v))
  (type %cursor (OrderedMapCursor %k %v))
  (defun (iterable-start m) (orderedmap-cursor m))
  (defun (iterable-done? m c) (orderedmap-cursor-done? c))
  (defun (iterable-current m c) (orderedmap-cursor-current c))
  (defun (iterable-next m c) c))

(: orderedmap-for-each (-> (-?-> %k %v void) (OrderedMap %k %v) void))
(defun (orderedmap-for-each f m)
  (loop (:for (k . v) m)
        (:do (f k v))))

(impl (Collection (OrderedMap %k %v))
  (type %content (Tuple %k %v))
  (defun (length m) (orderedmap-length m))
  (defun (empty? m) (orderedmap-empty? m)))


(type (: (OrderedMapping %k %v) (Union ordered-mapping)))

(impl (Collector (OrderedMapping %k %v))
  (where (Ord %k))
  (type %elem (Tuple %k %v))
  (type %acc (OrderedMapBuilder %k %v))
  (type %out (OrderedMap %k %v))
  (defun (collector-init c) (orderedmapbuilder-empty))
  (defun (collector-step c acc kv)
    (def (k v) kv)
    (orderedmapbuilder-add! acc k v)
    acc)
  (defun (collector-finish c acc) (orderedmapbuilder->orderedmap acc)))

;; The mutable sinks, one entry at a time. `Addable!` is the prelude's trait;
;; this module owns the types, which is what licenses the impls.
(impl (Addable! (OrderedMapBuilder %k %v))
  (type %elem (%k . %v))
  (defun (add! mb tup)
    (def (k v) tup)
    (orderedmapbuilder-add! mb k v)))

(impl (Addable! (TransientOrderedMap %k %v))
  (type %elem (%k . %v))
  (defun (add! tm tup)
    (def (k v) tup)
    (transientorderedmap-set! tm k v)))

;; And the persistent map itself. Set semantics on a duplicate key, as the
;; prelude's `(Addable (Map %k %v))` explains.
(impl (Addable (OrderedMap %k %v))
  (type %elem (%k . %v))
  (defun (add m tup)
    (def (k v) tup)
    (orderedmap-set m k v)))

;; Equality for ordered maps.
(impl (Eq (OrderedMap %k %v))
  (where (Eq %k) (Eq %v))
  (defun (= a b)
    (and (= (orderedmap-length a) (orderedmap-length b))
         (= (orderedmap->list a) (orderedmap->list b))))
  (defun (eq-hash m)
    (orderedmap-fold
     (fun (k v h) (hash-combine h (hash-combine (eq-hash k) (eq-hash v))))
     17
     m)))

(: entry->str (-> (Tuple %k %v) string) (where (->str %k) (->str %v)))
(defun (entry->str entry)
  (def (k v) entry)
  (str (->str k) " " (->str v)))

(: orderedmap->str (-> (OrderedMap %k %v) string) (where (->str %k) (->str %v)))
(defun (orderedmap->str m)
  (def sb (stringbuilder-empty))
  (stringbuilder-add-string! sb "#map(")
  (loop (:with first? #t #f)
        (:for entry m)
        (:do (unless first? (stringbuilder-add-string! sb " "))
             (stringbuilder-add-string! sb (entry->str entry))))
  (stringbuilder-add-string! sb ")")
  (stringbuilder->string sb))

(impl (->str (OrderedMap %k %v))
  (where (->str %k) (->str %v))
  (defun (->str m)
    (orderedmap->str m)))
