;; `#:async` on an accessor.
;;
;; The three concurrency keywords describe how a *call* is made: what is awaited,
;; and what the ambient cancellation token is threaded into. Reading a property
;; is neither — there is no overload set to select a token-taking member of, and
;; nothing to await.
;;
;; Worth refusing rather than ignoring. A clause that reads as async and is not
;; is a call site that reads as a yield point and is not, which is precisely the
;; confusion §7.2 exists to remove.

;; EXPECT-ERROR: reading or writing a property is not a call

(import (std prelude))

(import/extern
  (sb-length (: System.Text.StringBuilder.Length #:get #:async)))

(defun (main args) 0)
