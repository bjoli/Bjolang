;; With `=> (name expr)`, only `name` is bound after the form. The form's
;; accumulators are not.

;; EXPECT-ERROR: Unbound variable: s

(import (std prelude))

(: f (-> (List (List int)) (List int)))
(defun (f rows)
  (loop (:for row rows)
        (:subloop (:for y row)
                  (:acc s (summing y))
                  => (doubled (* 2 s)))
        (:acc out (listing (+ doubled s)))))

(defun (main) (println (int->string (list-length (f '((1)))))) 0)
