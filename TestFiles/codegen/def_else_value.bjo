;; A `def/else` in the return position: no slot, no meeting point.
;;
;; Each `EXPECT-CS` is an extended regex matched against a single line of the
;; generated C# — and against the *whole file*, which is why the case that
;; wants a slot lives next door in `def_else_slot.bjo` rather than here: the
;; `EXPECT-NO-CS` lines below are the point of this file, and one function
;; needing a slot would defeat them.
;;
;; The sequel and the else body are the form's two arms, so both are generated
;; into the same target. Here that target is the method's `return`: each arm
;; ends in a `return` of its own, nothing falls out of the bottom, and so
;; neither the `goto` over the else body nor the label after it is emitted.
;;
;; A `def/else*` still emits its else body **once**, with every failing clause
;; jumping to it: `triple` below has three `goto __else` and one `"missing"`.

(import (std prelude))

;; EXPECT-CS: \} else goto __else__[0-9]+;
;; EXPECT-CS: return "none";
;; EXPECT-NO-CS: goto __else_done__[0-9]+;
;; EXPECT-NO-CS: __else_done__[0-9]+: ;
;; EXPECT-NO-CS: = default!;
(: classify (-> (Option int) string))
(defun (classify o)
  (def/else ((Some n) o)
    "none")
  (str "got " (int->string n)))

;; EXPECT-CS: return "missing";
(: triple (-> (Option int) (Option int) (Option int) string))
(defun (triple a b c)
  (def/else* (((Some x) a)
              ((Some y) b)
              ((Some z) c))
    "missing")
  (int->string (+ x (+ y z))))

(defun (main)
  (println (classify (Some 1)))
  (println (classify None))
  (println (triple (Some 1) (Some 2) (Some 3)))
  (println (triple (Some 1) None (Some 3)))
  0)
