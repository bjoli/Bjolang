;; A `(:def ...)` clause with nothing to bind.
;;
;; The clause binds a pattern to a value, so a clause with only a name in it
;; has no value to give it. Refused where it is written rather than read as a
;; test called `:def`, which is what the general clause below it would make of
;; it.
;;
;; EXPECT-ERROR: (:def ...) binds

(import (std prelude))

(: broken (-> int int))
(defun (broken n)
  (cond
    ((> n 0) 1)
    (:def x)
    (else x)))

(defun (main) (println (int->string (broken 0))) 0)
