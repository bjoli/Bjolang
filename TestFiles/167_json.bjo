;; Reading JSON off a port.
;;
;; The reader never holds the document: it looks at one character at a time
;; with `peek-char` and takes it with `read-char`. Every refusal names the line
;; and column of the character it refused, which is the whole reason the reader
;; counts them; a column is a character, wherever in Unicode it is.

(import (std prelude))
(import (std ports))
(import (text json))
(import (std simpletest))

;; A summary to assert on, since the module reads and does not write.
(: (-> Json string))
(defun (shape j)
  (match j
    (JsonNull "null")
    ((JsonBool b) (if b "true" "false"))
    ((JsonInt n) (str "i" (long->string n)))
    ((JsonFloat d) (str "f" (double->string d)))
    ((JsonStr s) (str "\"" s "\""))
    ((JsonArr v) (str "[" (string-join (iarray->vec (iarray-map shape v)) ",") "]"))
    ((JsonObj m) (str "{" (string-join (entries m) ",") "}"))
    ;; In their own order.
    ((JsonFields fs)
     (str "{" (string-join (vec-map (fun (p) (str "\"" (fst p) "\":" (shape (snd p)))) (iarray->vec fs)) ",") "}"))))

;; Sorted, so the assertion does not depend on a hash order.
(: (-> (Map string Json) (Vec string)))
(defun (entries m)
  (let ((pairs (loop (:for (Tuple k v) m)
                     (:acc out (listing (str "\"" k "\":" (shape v)))))))
    (loop (:for e (list-sort pairs)) (:acc v (vecing e)))))

(: (-> string string))
(defun (ok text)
  (match (parse-json text) ((Ok j) (shape j)) ((Err e) (str "REFUSED " e))))

;; `s` written `n` times.
(: (-> string int string))
(defun (repeated s n)
  (def sb (stringbuilder-empty))
  (loop (:for _ (range 0 n)) (:do (stringbuilder-add-string! sb s)))
  (stringbuilder->string sb))

;; The bytes of `s`, and then `tail`.
(: (-> string (Array byte) (Array byte)))
(defun (bytes-then s tail)
  (def head (string->bytes s))
  (def all (array-resize head (+ (array-length head) (array-length tail))))
  (loop (:for i (range 0 (array-length tail)))
        (:do (array-set! all (+ (array-length head) i) (array-ref tail i))))
  all)

(: (-> string string))
(defun (bad text)
  (match (parse-json text) ((Ok j) (str "ACCEPTED " (shape j))) ((Err e) e)))

(: (-> string bool))
(defun (accepted? text)
  (match (parse-json text) ((Ok _) #t) ((Err _) #f)))

;; Bytes no string can hold, read off a port.
(: (-> (Array byte) string))
(defun (bytes-json bytes)
  (match (byte-pipe)
    ((Tuple in out)
     (write-bytes! out bytes)
     (close-output-port out)
     (match (read-json in) ((Ok j) (shape j)) ((Err e) e)))))

;; The reader's first read from a port asks for this many bytes, and it gets
;; them all before it parses any (`read-first` in json.bjo). A document is
;; cut by the end of a read only there.
(: int)
(def first-read 16384)

;; How many newlines go before `first`, so that the first read ends where
;; `first` does.
(: (-> (Array byte) int))
(defun (pad-for first) (- first-read (array-length first)))

;; A document that arrives in two reads, cut between `first` and `second`.
;; Newlines before it make `first` end at the end of the first read; they move
;; the line of what follows and not its column. `second` is written after the
;; reader has started.
(: (-> (Array byte) (Array byte) string))
(defun (split-bytes first second)
  (match (byte-pipe)
    ((Tuple in out)
     (write-bytes! out (make-array (pad-for first) #:fill (cast byte 10)))
     (write-bytes! out first)
     (flush-port out)
     (def reading (bjo (read-in-a-fiber in)))
     (write-bytes! out second)
     (close-output-port out)
     (run-str reading))))

(: (-> string string string))
(defun (split-json first second)
  (split-bytes (string->bytes first) (string->bytes second)))

;; The line `n` of `first` is after the newlines `split-json` puts before it.
(: (-> string int string))
(defun (cut-line first n)
  (int->string (+ n (pad-for (string->bytes first)))))

(: string)
(def emoji (list->string (list (integer->char 128512))))

;; Deeper than anyone types.
(: (-> int string))
(defun (nest n)
  (let ((sb (stringbuilder-empty)))
    (loop (:for i (range 0 n)) (:do (stringbuilder-add! sb #\[)))
    (loop (:for i (range 0 n)) (:do (stringbuilder-add! sb #\])))
    (stringbuilder->string sb)))

(: (-> int string))
(defun (nest-objects n)
  (let ((sb (stringbuilder-empty)))
    (loop (:for i (range 0 n)) (:do (stringbuilder-add-string! sb "{\"a\":")))
    (stringbuilder-add-string! sb "1")
    (loop (:for i (range 0 n)) (:do (stringbuilder-add! sb #\})))
    (stringbuilder->string sb)))

;; Nothing here says a colour, and the reader is the same source either way.
(: (-bjo-> InputPort string))
(defbjo (read-in-a-fiber p)
  (match (read-json p) ((Ok j) (shape j)) ((Err e) e)))

(: (-> (Promise string) string))
(defun (run-str p)
  (match (sync/blocking (promise-join p)) ((Ok s) s) ((Err e) "raised")))

(defun (main)
  ;; --- Values --------------------------------------------------------------
  (expect "null" (ok "null") "null")
  (expect "true" (ok "true") "true")
  (expect "false" (ok "false") "false")
  (expect "zero" (ok "0") "i0")
  (expect "an integer" (ok "42") "i42")
  (expect "a negative integer" (ok "-42") "i-42")
  (expect "the widest long" (ok "9223372036854775807") "i9223372036854775807")
  (expect "a fraction" (ok "1.5") "f1.5")
  (expect "an exponent" (ok "1e3") "f1000")
  (expect "a signed exponent" (ok "-2.5E-2") "f-0.025")
  ;; A long is as wide as an integer goes; past it the value is still a number.
  (expect "wider than a long" (ok "99999999999999999999") "f1E+20")
  (expect "the narrowest long" (ok "-9223372036854775808") "i-9223372036854775808")
  (expect "one past the widest long" (ok "9223372036854775808") "f9.223372036854776E+18")
  (expect "eighteen digits" (ok "999999999999999999") "i999999999999999999")
  (expect "nineteen digits" (ok "1000000000000000000") "i1000000000000000000")
  (expect "minus zero" (ok "-0") "i0")
  (expect "a zero with a fraction" (ok "0.25") "f0.25")
  (expect "an exponent with a plus" (ok "2e+2") "f200")
  (expect "numbers in an array" (ok "[1,-2.5,3e1]") "[i1,f-2.5,f30]")

  ;; --- Strings -------------------------------------------------------------
  (expect "a string" (ok "\"hi\"") "\"hi\"")
  (expect "an empty string" (ok "\"\"") "\"\"")
  (expect "an escaped quote" (ok "\"a\\\"b\"") "\"a\"b\"")
  (expect "an escaped solidus" (ok "\"a\\/b\"") "\"a/b\"")
  (expect "a tab escape" (ok "\"a\\tb\"") "\"a\tb\"")
  (expect "a \\u escape" (ok "\"\\u0041\"") "\"A\"")
  ;; A char is a Unicode scalar, so the pair is one of them rather than two.
  (expect "a surrogate pair is one character" (ok "\"\\uD83D\\uDE00\"") (str "\"" emoji "\""))
  (expect "an astral character read raw" (ok (str "\"" emoji "\"")) (str "\"" emoji "\""))
  ;; The reader's own end-of-port marker is #\nul, and this is not it.
  (expect "an escaped nul is not the end of the port"
          (ok "\"a\\u0000b\"")
          (str "\"a" (list->string (list (integer->char 0))) "b\""))

  ;; --- Arrays and objects --------------------------------------------------
  (expect "an empty array" (ok "[]") "[]")
  (expect "an array" (ok "[1, 2, 3]") "[i1,i2,i3]")
  (expect "a ragged array" (ok "[1, \"a\", null, true]") "[i1,\"a\",null,true]")
  (expect "an empty object" (ok "{}") "{}")
  (expect "an object" (ok "{\"a\": 1, \"b\": [2]}") "{\"a\":i1,\"b\":[i2]}")
  (expect "a repeated key keeps the second" (ok "{\"a\": 1, \"a\": 2}") "{\"a\":i2}")
  (expect "whitespace everywhere" (ok "  {\n \"a\" :\t[ 1 ,2 ]\n}  ") "{\"a\":[i1,i2]}")
  (expect "a byte-order mark is skipped"
          (ok (str (list->string (list (integer->char 65279))) "\"x\""))
          "\"x\"")

  ;; --- Refusals name the position ------------------------------------------
  (expect "a bare word" (bad "nope")
          "line 1, column 2: 'null' is spelled out to here, and then there is 'o'")
  (expect "a trailing comma" (bad "[1,]") "line 1, column 4: ']' does not begin a value")
  (expect "a missing colon" (bad "{\"a\" 1}")
          "line 1, column 6: an object wants ':' after a key, and this is '1'")
  (expect "an unquoted key" (bad "{a: 1}")
          "line 1, column 2: an object's key has to be a string, and this is 'a'")
  (expect "a leading zero" (bad "01") "line 1, column 2: a number may not have a leading zero")
  (expect "a lone decimal point" (bad "1.")
          "line 1, column 3: a number needs a digit after its decimal point, and this is the document ended")
  (expect "a lone minus" (bad "[-]")
          "line 1, column 3: a number needs a digit here, and this is ']'")
  (expect "a decimal point and no digit" (bad "[1.x]")
          "line 1, column 4: a number needs a digit after its decimal point, and this is 'x'")
  (expect "an exponent and no digit" (bad "[1e+]")
          "line 1, column 5: a number needs a digit after its exponent, and this is ']'")
  (expect "a leading zero in an array" (bad "[0, 012]")
          "line 1, column 6: a number may not have a leading zero")
  (expect "a number after a newline" (bad "[1,\n -]")
          "line 2, column 3: a number needs a digit here, and this is ']'")
  (expect "an unterminated string" (bad "\"abc")
          "line 1, column 5: the document ended inside a string")
  (expect "a raw newline in a string" (bad "\"a\nb\"")
          "line 1, column 3: a control character in a string has to be written as an escape")
  (expect "trailing content" (bad "1 2")
          "line 1, column 3: the value ended here, and then there is '2'")
  (expect "an empty document" (bad "")
          "line 1, column 1: the document ended where a value was expected")
  (expect "a lone high surrogate" (bad "\"\\uD83D\"")
          "line 1, column 8: a high surrogate has to be followed by \\u and its low surrogate")
  (expect "a bad escape" (bad "\"\\q\"") "line 1, column 3: \\q is not an escape")
  (expect "a character outside the BMP is one column"
          (bad (str "[\"" emoji "\" x]"))
          "line 1, column 6: an array wants ',' or ']' here, and this is 'x'")
  (expect "and is quoted whole when refused"
          (bad (str "[" emoji "]"))
          (str "line 1, column 2: '" emoji "' does not begin a value"))

  ;; A document is UTF-8 (RFC 8259, section 8.1), and bytes that are not are
  ;; refused where they are.
  (expect "a byte that is not UTF-8 in a string"
          (bytes-json #[34 97 255 98 34])
          "line 1, column 3: a string has to be UTF-8, and this byte is not")
  (expect "an overlong form"
          (bytes-json #[34 192 128 34])
          "line 1, column 2: a string has to be UTF-8, and this byte is not")
  (expect "an encoded surrogate"
          (bytes-json #[34 237 160 128 34])
          "line 1, column 2: a string has to be UTF-8, and this byte is not")
  (expect "a character cut off by the end"
          (bytes-json #[34 226 130])
          "line 1, column 2: a string has to be UTF-8, and this byte is not")
  (expect "outside a string"
          (bytes-json #[91 255 93])
          "line 1, column 2: a byte that is not UTF-8 does not begin a value")
  (expect "every length of character, after one another"
          (bytes-json #[34 97 195 165 226 130 172 240 159 152 128 34])
          (str "\"aå€" emoji "\""))

  ;; A character whose bytes arrive in two reads is one character.
  (expect "a character split between two reads"
          (split-bytes #[34 195] #[169 34])
          "\"é\"")

  ;; A number whose digits arrive in two reads is one number.
  (expect "a number split between two reads"
          (split-json "[12" "34.5e1, 6]")
          "[f12345,i6]")
  (expect "a number split after its minus"
          (split-json "-" "7")
          "i-7")
  (expect "a number split after its exponent"
          (split-json "[1e" "2]")
          "[f100]")
  (expect "a refusal split between two reads"
          (split-json "[1." "x]")
          (str "line " (cut-line "[1." 1) ", column 4: a number needs a digit after its decimal point, and this is 'x'"))

  ;; A string is read in runs off the chunk, and white space is skipped a chunk
  ;; at a time. A run, a character, an escape and white space can each be cut
  ;; by the end of a read.
  (expect "a string cut between two reads"
          (split-json "[\"abc" "def\"]")
          "[\"abcdef\"]")
  (expect "a character of several bytes cut inside a run"
          (split-bytes #[91 34 97 226 130] #[172 98 34 93])
          "[\"a€b\"]")
  (expect "an escape cut between its backslash and its letter"
          (split-json "[\"a\\" "nb\"]")
          "[\"a\nb\"]")
  (expect "white space cut between two reads, and the line and column after it"
          (split-json "[1,  \n  " "  @]")
          (str "line " (cut-line "[1,  \n  " 2) ", column 5: '@' does not begin a value"))
  ;; A run is scanned 32 bytes at a time, and the bytes after the last whole
  ;; block one at a time. These strings are long enough to have whole
  ;; blocks, and put what stops the run in every lane.
  (expect "a string of every length up to three blocks, with an escape after it"
          (loop (:for n (range 0 100))
                (:let text (repeated "a" n))
                (:when (not (= (ok (str "\"" text "\\n\""))
                              (str "\"" text "\n\""))))
                (:acc bad (listing n))
                => bad)
          '())
  (expect "a quote in every lane of the second block"
          (loop (:for n (range 32 64))
                (:let text (repeated "b" n))
                (:when (not (= (ok (str "[\"" text "\",1]")) (str "[\"" text "\",i1]"))))
                (:acc bad (listing n))
                => bad)
          '())
  (expect "the column after a long run of letters of several bytes"
          (bad (str "[\"" (repeated "blåbär" 10) "\", @]"))
          "line 1, column 66: '@' does not begin a value")
  (expect "a byte that is not UTF-8 deep in a long run, at its column"
          (bytes-json (bytes-then (str "\"" (repeated "å" 40)) #[255 34]))
          "line 1, column 42: a string has to be UTF-8, and this byte is not")
  (expect "a control character deep in a long run, at its column"
          (bytes-json (bytes-then (str "\"" (repeated "x" 45)) #[9 34]))
          "line 1, column 47: a control character in a string has to be written as an escape")
  (expect "a long run of letters of several bytes, kept"
          (ok (str "\"" (repeated "€ö😀" 20) "\""))
          (str "\"" (repeated "€ö😀" 20) "\""))
  ;; White space is skipped 32 bytes at a time, and the line and column
  ;; counted from its newlines. An error after it says where it ended.
  (expect "the column after every length of spaces up to three blocks"
          (loop (:for n (range 0 100))
                (:when (not (= (bad (str "[1," (repeated " " n) "@]"))
                               (str "line 1, column " (int->string (+ 4 n)) ": '@' does not begin a value"))))
                (:acc wrong (listing n))
                => wrong)
          '())
  (expect "the line and column after newlines and an indent, in every lane"
          (loop (:for k '(1 2 31 32 33 64))
                (:subloop)
                (:for m (range 0 70))
                (:when (not (= (bad (str "[1," (repeated "\n" k) (repeated " " m) "@]"))
                               (str "line " (int->string (+ 1 k)) ", column " (int->string (+ 1 m))
                                    ": '@' does not begin a value"))))
                (:acc wrong (listing (Tuple k m)))
                => wrong)
          '())
  (expect "tabs and returns are white space, and a return is not a newline"
          (bad (str "[1," (repeated " \t\r" 20) "\n" (repeated "\t" 40) "@]"))
          "line 2, column 41: '@' does not begin a value")
  (expect "a value after long white space"
          (ok (str "[" (repeated "\n    " 20) "1," (repeated " " 50) "2" (repeated "\n" 40) "]"))
          "[i1,i2]")
  (expect "a column after a run with letters of several bytes in it"
          (bad "[\"blåbär\", @]")
          "line 1, column 12: '@' does not begin a value")
  (expect "a byte that is not UTF-8 after a run, at its column"
          (bytes-json #[34 97 98 99 255 34])
          "line 1, column 5: a string has to be UTF-8, and this byte is not")
  ;; Keys are kept and handed out again. Two that share a slot, `xaa` and `xcc`
  ;; by `key-slot`, are told apart.
  (expect "keys repeated, and keys that share a slot"
          (ok "[{\"xaa\":1,\"xcc\":2},{\"xcc\":3,\"xaa\":4},{\"xaa\":5}]")
          "[{\"xaa\":i1,\"xcc\":i2},{\"xaa\":i4,\"xcc\":i3},{\"xaa\":i5}]")
  (expect "a key with an escape in it, twice"
          (ok "[{\"a\\\"b\":1},{\"a\\\"b\":2}]")
          "[{\"a\"b\":i1},{\"a\"b\":i2}]")
  (expect "an empty key" (ok "{\"\":1}") "{\"\":i1}")

  ;; The row is the point of all this.
  (expect "the third line" (bad "[\n  1,\n  @\n]")
          "line 3, column 3: '@' does not begin a value")
  (expect "the fourth line" (bad "{\n\"a\": 1,\n\"b\": 2\n@")
          "line 4, column 1: an object wants ',' or '}' here, and this is '@'")

  ;; --- Depth ---------------------------------------------------------------
  (expect "as deep as it goes" (accepted? (nest json-max-depth)) #t)
  (expect "one array deeper" (bad (nest (+ json-max-depth 1)))
          "line 1, column 1001: this array nests deeper than 1000, which is as far as reading goes")
  (expect "one object deeper" (bad (nest-objects (+ json-max-depth 1)))
          "line 1, column 5001: this object nests deeper than 1000, which is as far as reading goes")

  ;; --- Off a file, and off a fiber -----------------------------------------
  (let ((path (path-combine (current-directory) "167-scratch.json")))
    (file-write-text path "{\n  \"a\": [1, 2],\n  \"b\": \"x\"\n}\n")
    (match (open-input-file path)
      ((Err e) (expect "the scratch file opens" "no" "yes"))
      ((Ok p)
       (expect "read off a file port"
               (match (read-json p) ((Ok j) (shape j)) ((Err e) e))
               "{\"a\":[i1,i2],\"b\":\"x\"}")
       (close-input-port p)))
    (file-delete path))

  (expect "read inside a bjoroutine"
          (run-str (bjo (read-in-a-fiber (open-input-string "[1, 2, 3]"))))
          "[i1,i2,i3]")
  0)
