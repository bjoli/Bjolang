;; En trait som står för ett .NET-gränssnitt har ingenting att lådlägga: det
;; gränssnittet *är* den raderade typen, och `cast` är vägen dit.
;;
;; EXPECT-ERROR: 'Num' stands for the .NET interface 'System.Numerics.INumber'
;; EXPECT-ERROR: Write (cast System.Numerics.INumber x)

(import (std prelude))
(import (std maths))

(: add-them (-> (dyn Num) int))
(defun (add-them d) 0)

(defun (main args) 0)
