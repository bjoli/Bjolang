;; std/ports.bjo — draining and streaming a textual port.

(export
  ;; Draining
  port->list port->vec port->lines
  ;; Streaming
  port->seq file->seq 
  port->chan chan-next)

(import (std prelude))

;; Exception import.
(import/class
  (Exception (: System.Exception)))

;; ---------------------------------------------------------------------------
;; Draining
;; ---------------------------------------------------------------------------
;;
;; Drains items.


;; Drains a port.
(: port->list (-> (-?-> TextInputPort %a) TextInputPort (List %a)))
(defun (port->list reader p)
  (loop (:with i 1 1)
        (:break (port-eof? p))
        (:acc lst (listing (reader p)))))



(: port->vec (-> (-?-> TextInputPort %a) TextInputPort (Vec %a)))
(defun (port->vec reader p)
  (loop (:with i 1 1)
        (:break (port-eof? p))
        (:acc vec (vecing (reader p)))))

(: port->lines (-> TextInputPort (Vec string)))
(defun (port->lines port)
  (port->vec read-line port))

;; ---------------------------------------------------------------------------
;; Streaming
;; ---------------------------------------------------------------------------

;; Streams items from port as a Seq.
(: port->seq (-> (-> TextInputPort %a) TextInputPort (Seq %a)))
(defun (port->seq reader p)
  (seql (:with i 0 0)
        (:break (port-eof? p))
        (:yield (reader p))))

;; ---------------------------------------------------------------------------
;; Streaming that suspends
;; ---------------------------------------------------------------------------
;;
;; Streaming that suspends.
;; Returns a channel and end-of-stream promise.

;; Reads port on a fiber into a channel.
(: port->chan (-> (-bjo-> TextInputPort %a) TextInputPort (Tuple (Chan %a) (Promise int))))
(defun (port->chan reader p)
  (let ((c (make-chan)))
    (Tuple c (bjo (port-fill c reader p)))))

;; Reader loop run on fiber.
(: port-fill (-bjo-> (Chan %a) (-bjo-> TextInputPort %a) TextInputPort int))
(defbjo (port-fill c reader p)
  (let go ((n 0))
    (if (port-eof? p)
        n
        (let ()
          ;; Send item.
          (ignore (sync (chan-send c (reader p))))
          (go (+ n 1))))))

;; Gets next item or None.
(: chan-next (-bjo-> (Chan %a) (Promise int) (Option %a)))
(defbjo (chan-next c done)
  (sync (choose (wrap (chan-recv c) (fun (x) (Some x)))
                (wrap (promise-join done) (fun (r) None)))))

;; Streams file contents as Seq.
(: file->seq (-> (-> TextInputPort %a) string (Result Exception (Seq %a))))
(defun (file->seq reader path)
  (match (open-input-file path)
    ((Ok probe)
     (let ()
         ;; First we just check if the file exists
        (close-input-port probe)
        (Ok (file-read/seq reader path))))
    ((Err e) (Err e))))
