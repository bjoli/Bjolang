;; The width of one code point, by a binary search of `width-ranges`.
(: (-> int int))
(defun (code-point-width cp)
  (if (and (>= cp 32) (< cp 127))
      1
      (searched-width cp)))

(: (-> int int))
(defun (searched-width cp)
  (let lp ((lo 0) (hi (- (/ (array-length width-ranges) 3) 1)))
    (if (> lo hi)
        1
        (let ()
          (def mid (/ (+ lo hi) 2))
          (cond
            ((< cp (ref width-ranges (* 3 mid))) (lp lo (- mid 1)))
            ((> cp (ref width-ranges (+ (* 3 mid) 1))) (lp (+ mid 1) hi))
            (else (ref width-ranges (+ (* 3 mid) 2))))))))

;; The cursor after the escape sequence that starts at `c`, an ESC: a CSI
;; ends at a character from @ to ~, an OSC at BEL or at ESC and a backslash,
;; and any other is ESC and one character.
(: (-> string StringCursor StringCursor))
(defun (after-escape s c)
  (def next (string-cursor-next s c))
  (defun (char-at k) (if (string-cursor-end? s k) 0 (char->integer (string-cursor-ref s k))))
  (cond
    ((string-cursor-end? s next) next)
    ((= (char-at next) 91)
     (let lp ((k (string-cursor-next s next)))
       (cond
         ((string-cursor-end? s k) k)
         ((and (>= (char-at k) 64) (<= (char-at k) 126)) (string-cursor-next s k))
         (else (lp (string-cursor-next s k))))))
    ((= (char-at next) 93)
     (let lp ((k (string-cursor-next s next)))
       (cond
         ((string-cursor-end? s k) k)
         ((= (char-at k) 7) (string-cursor-next s k))
         ((and (= (char-at k) 27)
               (let ((k2 (string-cursor-next s k)))
                 (and (not (string-cursor-end? s k2)) (= (char-at k2) 92))))
          (string-cursor-next s (string-cursor-next s k)))
         (else (lp (string-cursor-next s k))))))
    (else (string-cursor-next s next))))

;; How many columns `s` takes in a terminal.
(: (-> string int))
(defun (terminal-width s)
  (let lp ((c (string-cursor-start s)) (total 0) (last 0) (joined? #f) (open-flag? #f))
    (if (string-cursor-end? s c)
        total
        (let ()
          (def cp (char->integer (string-cursor-ref s c)))
          (def next (string-cursor-next s c))
          (cond
            ((= cp 27) (lp (after-escape s c) total last joined? open-flag?))
            ((= cp 8205) (lp next total last #t #f))
            ((= cp 65039)
             (if (= last 1) (lp next (+ total 1) 2 #f #f) (lp next total last #f #f)))
            (joined? (lp next total last #f #f))
            ((and (>= cp 127462) (<= cp 127487))
             (if open-flag? (lp next total last #f #f) (lp next (+ total 2) 2 #f #t)))
            (else
             (def w (code-point-width cp))
             (lp next (+ total w) (if (> w 0) w last) #f #f)))))))

;; ===========================================================================
;; A table as a literal
;; ===========================================================================
;;
;; `(show-table '(table (style rounded) header (column "Item") ... (rows ,rows)))`.
;; The grammar checks the literal where it is written; `table-block` lays out
;; the value with `tabular/rows`.

(def/grammar Table
  (Table (table (: options TableOptions) (: columns TableColumn ...+) (: rows (rows TableRow ...))))
  (TableOptions (:each (: style    (:? (style TableStyle)))
                       (: header   (:? 'header))
                       (: rules    (:? (rules TableRules)))
                       (: width    (:? (width int)))
                       (: overflow (:? (overflow Overflow)))))
  (TableColumn (column (: title string) (: options ColumnOptions)))
  (ColumnOptions (:each (: align (:? (align Align)))
                        (: width (:? (width ColumnWidth)))
                        (: kind  (:? ColumnKind))))
  (ColumnKind (:or (: KindNumber (number NumberFormat))
                   (: KindBytes 'bytes)
                   (: KindPercent (percent (:? (precision int))))
                   (: KindBar (bar BarFormat))))
  (NumberFormat (:each (: precision (:? (precision int)))
                       (: comma     (:? (comma int)))
                       (: signed    (:? 'signed))))
  (BarFormat (:each (: limit (:? (max double)))
                    (: size  (:? (width int)))))
  (TableRow (:or (: RowOf (row TableCell ...))
                 (: RowSpliced ,(Vec TableCell))
                 (: RowsSpliced ,(Vec (Vec TableCell)))))
  (TableCell (:or (: CellText string) (: CellInt int) (: CellNum double) (: CellBlocks ,(Vec Block)))))

;; A cell shown as it is.
(: (-> TableCell Block))
(defun (plain-cell c)
  (match c
    ((CellText s) (BStr s))
    ((CellInt n) (BInt n))
    ((CellNum x) (numeric x))
    ((CellBlocks bs) (each bs))))

(: (-> TableCell (Option double)))
(defun (cell-number c)
  (match c
    ((CellInt n) (Some (cast double n)))
    ((CellNum x) (Some x))
    (_ None)))

;; A cell shown as its column's kind says. A cell that is not a number is
;; shown as it is in any column.
(: (-> (Option ColumnKind) TableCell Block))
(defun (kind-cell kind c)
  (match (Tuple kind (cell-number c))
    ((Tuple (Some (KindNumber f)) (Some x))
     (numeric x #:precision (option-ref-or (record-ref f precision) -1)
                #:comma (option-ref-or (record-ref f comma) -1)
                #:signed (record-ref f signed)))
    ((Tuple (Some KindBytes) (Some x)) (bytes (cast long x)))
    ((Tuple (Some (KindPercent p)) (Some x)) (percent x #:precision (option-ref-or p 1)))
    ((Tuple (Some (KindBar b)) (Some x))
     (bar (/ x (option-ref-or (record-ref b limit) 1.0)) #:width (option-ref-or (record-ref b size) 10)))
    (_ (plain-cell c))))

;; A column's alignment: the one it says, or to the right for a column of
;; numbers, sizes or shares, and to the left for anything else.
(: (-> TableColumn Align))
(defun (column-align col)
  (def o (record-ref col options))
  (match (record-ref o align)
    ((Some a) a)
    (None (match (record-ref o kind)
            ((Some (KindBar _)) AlignLeft)
            ((Some _) AlignRight)
            (None AlignLeft)))))

;; The table's rows, a block a cell, each shown as its column's kind says.
(: (-> (Vec TableColumn) (Vec (Vec TableCell)) (Vec (Vec Block))))
(defun (table-cells cols rows)
  (vec-map (fun (row)
             {vecing (kind-cell (if (< i (vec-length cols))
                                    (record-ref (record-ref (vec-ref cols i) options) kind)
                                    None)
                                (vec-ref row i))
                     (:for i (range 0 (vec-length row)))})
           rows))

;; A table literal as a block, laid out as `tabular/rows` lays out a table.
(: (-> Table Block))
(defun (table-block t)
  (def* (o (record-ref t options))
        (cols (list->vec (record-ref t columns)))
        (rows (list-foldl (fun (r acc)
                            (match r
                              ((RowOf cells) (vec-add acc (list->vec cells)))
                              ((RowSpliced cells) (vec-add acc cells))
                              ((RowsSpliced more) (vec-merge acc more))))
                          []
                          (record-ref t rows)))
        (laid (tabular/rows (table-cells cols rows)
                            #:titles (if (record-ref o header)
                                         (vec-map (fun (c) (BStr (record-ref c title))) cols)
                                         [])
                            #:style (option-ref-or (record-ref o style) StyleNone)
                            #:rules (option-ref-or (record-ref o rules) RulesHeader)
                            #:align (vec-map column-align cols)
                            #:widths (vec-map (fun (c) (option-ref-or (record-ref (record-ref c options) width)
                                                                      WidthAuto))
                                              cols)
                            #:overflow (option-ref-or (record-ref o overflow) OverflowPush))))
  (match (record-ref o width)
    ((Some w) (with-fmt current-width w [laid]))
    (None laid)))

;; Shows a table literal on the current output port. `#:sync` for `show`'s
;; reason.
(: show-table #:sync (-> Table void))
(defun (show-table t) (show [(table-block t)]))
