;; ACK -- One of the Kernighan and Van Wyk benchmarks.
;; Arguments: count m n expected

(import "common.bjo")

(: ack (-> int int int))
(defun (ack m n)
  (cond ((= m 0) (+ n 1))
        ((= n 0) (ack (- m 1) 1))
        (else (ack (- m 1) (ack m (- n 1))))))

(defun (main args)
  (def m (arg-int args 1))
  (def n (arg-int args 2))
  (def expected (arg-int args 3))
  (run-benchmark "ack" (arg-int args 0) (fun () (ack m n)) #(= & expected)))
