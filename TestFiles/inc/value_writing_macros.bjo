;; Macros whose templates use functions as values, for
;; `483_template_values_resolved.bjo`.

(import (std prelude))
(import (std syntax-match))

(export lengths-of joined-by-commas)

(def/macro (lengths-of form inject compare)
  (syntax-match form
    ((_ xs) #'(vec-map string-length ,xs))))

(def/macro (joined-by-commas form inject compare)
  (syntax-match form
    ((_ xs) #'(string-join (vec-map ->str ,xs) ","))))
