;; A failure part starts with a keyword. A bare value reads as a default and
;; means leaving the body, so the error asks which of the two was meant.

;; EXPECT-ERROR: a def's failure part starts with a keyword
;; EXPECT-ERROR: :default value      binds port to value and carries on

(import (std prelude))

(: f (-> (Option int) int))
(defun (f o)
  (def (Some port) o 8080)
  (+ port 1))
