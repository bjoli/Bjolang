;; EXPECT-ERROR: no implementation of trait 'Ord'
;; EXPECT-ERROR: no head constructor
;;
;; `Ord` is an ordinary trait, so sorting needs a dictionary, and a dictionary
;; is chosen by the element type's head constructor. `(list-empty)` never says
;; what it holds, so there is no head to choose by and nothing to pass.
;;
;; Annotating fixes it — `(def (: xs (List string)) (list-empty))` — which is
;; what `139_ord.bjo` does.
(import (std prelude))

(defun (main)
  (displayln (int->string (list-length (list-sort (list-empty)))))
  0)
