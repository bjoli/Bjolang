;; The tasks of this repository: `bjo task` lists them.
;;
;; - Each task needs a built compiler and standard library. The scripts that
;;   make those, and the test runners, stay as scripts: build_compiler.sh,
;;   build_std.sh, run_tests.py and run_bjo_tests.py. They must work when
;;   the tree does not build.

(export unicode-tables bench Suite clean)

(import (std prelude))
(import (std argparse))
(import (std os))
(import (std run))
(import (std glob))
(import (bjo task))

;; ---------------------------------------------------------------------------
;; unicode-tables
;; ---------------------------------------------------------------------------

;; The UCD files that the four generators in lib/std/unicode read, relative
;; to the `ucd` directory of a Unicode version.
(: (Vec string))
(def ucd-files
  ["UnicodeData.txt" "DerivedCoreProperties.txt" "PropList.txt" "CaseFolding.txt"
   "CompositionExclusions.txt" "DerivedNormalizationProps.txt" "NormalizationTest.txt"
   "auxiliary/GraphemeBreakProperty.txt" "auxiliary/GraphemeBreakTest.txt"
   "emoji/emoji-data.txt"])

(: (Vec string))
(def generators ["gen_casefold.py" "gen_chars.py" "gen_grapheme.py" "gen_normalize.py"])

;; The URL of the `ucd` directory of `version`: "latest", or a number such
;; as "17.0.0".
(: (-> string string))
(defun (ucd-url version)
  (if (= version "latest")
      "https://www.unicode.org/Public/UCD/latest/ucd/"
      #"https://www.unicode.org/Public/${version}/ucd/"))

;; Downloads `ucd-files` into `dir`, with one curl for each file. Ends the
;; task when a download fails.
(: (-> string string void))
(defun (download-ucd version dir)
  (def base (ucd-url version))
  (println #"Downloading the UCD from ${base}")
  (loop (:for f ucd-files)
        (:do (task-run! ["curl" "--fail" "--silent" "--show-error" "--location" "--create-dirs"
                         "-o" (path->string/lossy (path-join dir f)) (str base f)]))))

(:doc unicode-tables
  (summary "Generates the Unicode tables of (std unicode) from the UCD, and builds the library.")
  (key #:version "The Unicode version to download: latest, or a number such as 17.0.0.")
  (key #:ucd "A directory that has the UCD files already. Nothing is downloaded.")
  (key #:build "Run build_std.sh after the tables are written."))
(: (-> (#:version string) (#:ucd (Option string)) (#:build bool) void))
(defun (unicode-tables #:version "latest" #:ucd None #:build #t)
  ;; A download goes into a temporary directory. It is deleted when the
  ;; generators have run; a step that fails ends the task and leaves it.
  (def dir (match ucd
             ((Some d) d)
             (None (let ((d (make-temp-directory #:prefix "bjolang-ucd-")))
                     (download-ucd version d)
                     d))))
  (loop (:for g generators)
        (:do (println #"Running ${g}")
             (task-run! ["python3" (str "lib/std/unicode/" g) dir])))
  (when (none? ucd) (directory-delete-tree dir))
  (when build (task-run! ["./build_std.sh"]))
  (println "The tables are written. Run ./run_tests.py, then look at git diff."))

;; ---------------------------------------------------------------------------
;; bench
;; ---------------------------------------------------------------------------

(:doc Suite (summary "A benchmark suite under bench/."))
(def/cmdline-choices (: Suite (Union Cml Collections Clbg Scheme)))

(: (-> Suite (Vec string)))
(defun (suite-command suite)
  (match suite
    (Cml ["bench/run.sh"])
    (Collections ["bench/collections/run.sh"])
    (Clbg ["python3" "bench/clbg/run.py"])
    (Scheme ["python3" "bench/scheme/run.py"])))

(:doc bench
  (summary "Runs a benchmark suite under bench/.")
  (arg suite "The suite: cml (bench/run.sh), collections, clbg or scheme.")
  (arg args "Passed on to the suite's runner. Put -- before them: bjo task bench clbg -- --reps 5.")
  (returns "The runner's exit code."))
(: (-> Suite (List string) int))
(defun (bench suite args)
  (match (task-run (vec-append (suite-command suite) (list->vec args)))
    ((Ok code) code)
    ((Err e) (raise e))))

;; ---------------------------------------------------------------------------
;; clean
;; ---------------------------------------------------------------------------

;; Ignored paths that clean never deletes: what builds and runs the compiler
;; and bjo, and the tasks that are running.
(: (Vec string))
(def kept-prefixes ["bin/" "obj/" "BjolangRuntime/bin/" "BjolangRuntime/obj/" "bjo/" ".bjo/" "tasks."
                    ".test-lock"])

;; Ignored directories that clean deletes whole.
(: (Vec string))
(def deleted-directories ["TestFiles/.test-logs/" "TestFiles/.bjo-tests/"])

;; The build output of the compiler, of the test runner and of dotnet.
(: Glob)
(def output-files
  (glob-pattern "**/*.{exe,dll,pdb,bjobuild,deps.json,runtimeconfig.json}" #:dot? #t))

;; What clean deletes for the ignored file `p`, a path relative to the
;; repository root with / between names:
;; - None, when it is kept, or is not build output;
;; - a directory that holds it, ending in /, when the whole directory goes:
;;   one of `deleted-directories`, a `bin` or `obj` of dotnet, or a
;;   `__pycache__`;
;; - else `p`, when it is an output file, or the stamp of the test fixtures.
(: (-> bool string (Option string)))
(defun (target-of lib? p)
  (def parts (string-split p "/"))
  (def whole
    {finding (str (string-join (vec-take parts (+ i 1)) "/") "/")
             :when (let ((name (vec-ref parts i)))
                     (or (= name "bin") (= name "obj") (= name "__pycache__")))
             (:for i (range 0 (- (vec-length parts) 1)))})
  (def deleted {finding d :when (string-starts-with? p d) (:for d deleted-directories)})
  (cond
    ((any? (fun (k) (string-starts-with? p k)) kept-prefixes) None)
    ((and (not lib?) (string-starts-with? p "lib/")) None)
    ((some? deleted) deleted)
    ((some? whole) whole)
    ((= p "TestFiles/inc/.built-from") (Some p))
    ((glob-match? output-files p) (Some p))
    (else None)))

;; The targets of `paths`, each once. `paths` is in git's order, so the
;; files of one directory are next to each other, and so are their targets.
(: (-> bool (Vec string) (List string)))
(defun (targets-of lib? paths)
  (def found {listing t (:for p paths) (:when-let (Some t) (target-of lib? p))})
  (let go ((ts found) (last "") (acc Nil))
    (match ts
      (Nil (list-reverse acc))
      ((Cons t rest) (if (= t last) (go rest last acc) (go rest t (Cons t acc)))))))

;; The size of the file `p` in bytes, or 0 when it is gone.
(: (-> Path long))
(defun (file-size p) (option-ref-or (option-map (fun (i) (record-ref i size)) (fs-info p)) 0L))

;; The size of what `target` names, in bytes: a file, or a directory with
;; everything below it.
(: (-> string long))
(defun (size-of target)
  (if (string-ends-with? target "/")
      {summing (file-size p) (:for p (directory-walk target))}
      (file-size (path target))))

;; The first name of `target`.
(: (-> string string))
(defun (top-of target)
  (match (string-split-once target "/")
    ((Some (Tuple top _)) top)
    (None target)))

(: long)
(def kilobyte 1024L)

(: long)
(def megabyte (* 1024L 1024L))

;; `n` bytes as KB below a megabyte, else as MB, rounded.
(: (-> long string))
(defun (size-text n)
  (if (< n megabyte)
      #"${(/ (+ n (/ kilobyte 2L)) kilobyte)} KB"
      #"${(/ (+ n (/ megabyte 2L)) megabyte)} MB"))

;; `size-text`, padded on the left to a column of 7 characters.
(: (-> long string))
(defun (size-column n) (string-pad-left (size-text n) 7))

;; Prints one line for each top directory of `targets`: how many targets
;; are under it, and their size. `targets` is sorted, so each top directory
;; is one run.
(: (-> (List (Tuple string long)) void))
(defun (print-summary sized)
  (let go ((rest sized) (top "") (count 0) (bytes 0L))
    (match rest
      (Nil (print-group top count bytes))
      ((Cons (Tuple t n) more)
       (if (= (top-of t) top)
           (go more top (+ count 1) (+ bytes n))
           (let ()
             (print-group top count bytes)
             (go more (top-of t) 1 n)))))))

(: (-> string int long void))
(defun (print-group top count bytes)
  (when (> count 0)
    (println #"${(size-column bytes)}  ${count} under ${top}")))

(:doc clean
  (summary "Lists, or deletes, the build output that git ignores.")
  (key #:delete "Delete what is listed. Without it, nothing is deleted.")
  (key #:lib "Also the build output under lib/. Run build_std.sh afterwards.")
  (key #:verbose "List each file and directory, not only a line for each top directory.")
  (returns "0, or 1 when git cannot list the ignored files."))
(: (-> (#:delete bool) (#:lib bool) (#:verbose bool) int))
(defun (clean #:delete #f #:lib #f #:verbose #f)
  (def err (parameter-ref current-error-port))
  (match (run/output '(git ls-files -z --others --ignored --exclude-standard))
    ((Err e) (writeln err #"clean: could not run git: ${(written e)}") 1)
    ((Ok (Tuple code listed))
     (if (not (= code 0))
         (let () (writeln err "clean: git ls-files failed") 1)
         (let ()
           (def paths (vec-filter (fun (p) (not (= p ""))) (string-split listed "\u{0}")))
           (def sized (list-map (fun (t) (Tuple t (size-of t))) (targets-of lib paths)))
           (if verbose
               (loop (:for (Tuple t n) sized) (:do (println #"${(size-column n)}  ${t}")))
               (print-summary sized))
           (def total {summing n (:for (Tuple _ n) sized)})
           (cond
             ((list-empty? sized) (println "Nothing to clean."))
             (delete
              (loop (:for (Tuple t _) sized)
                    (:do (if (string-ends-with? t "/") (directory-delete-tree t) (file-delete t))))
              (println #"Deleted ${(list-length sized)}, ${(size-text total)}."))
             (else
              (println #"${(list-length sized)} to delete, ${(size-text total)}. Run with --delete to delete them.")))
           0)))))
