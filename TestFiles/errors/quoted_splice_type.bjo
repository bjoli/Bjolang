;; What `,@` may be handed.
;;
;; A splice contributes a whole collection where its siblings contribute one
;; element each, so it has to be given the enclosing literal's own type — not
;; one element of it, and not a collection of something else.
;;
;; The position is the `,@`, not the literal. The literal is fine: it says what
;; it holds, and the splice is what disagrees.

;; EXPECT-ERROR: ,@ puts the elements of a collection into the list literal around it
;; EXPECT-ERROR: expected (List int)
;; EXPECT-ERROR: got      (List string)

(import (std prelude))

(defun (main args)
  (def (: words (List string)) (list "a" "b"))
  (def (: numbers (List int)) '(1 ,@words 2))
  (println (int->string (list-length numbers)))
  0)
