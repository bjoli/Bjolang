;; Annoteringen nålar fast `#:item` vid `int`, och värdets egen implementation
;; av `Foldable` säger `string`. Det är ett vanligt unifieringsfel — `prune`
;; löser projektionen så snart implementortypen är känd — med en rad om vilken
;; association de två är svar på.
;;
;; EXPECT-ERROR: They are what #:item is pinned to on either side of a (dyn Foldable ...)
;; EXPECT-ERROR: string

(import (std prelude))

(: d (dyn Foldable #:item int))
(def d (dyn Foldable (list "a")))

(defun (main args) 0)
