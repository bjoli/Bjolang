;; Deriving something that has no derivation.
;;
;; The trait list is a list so that `Ord` can join it without the form changing
;; shape; until it does, naming anything else is a mistake the macro can catch
;; while it is still looking at syntax.

;; EXPECT-ERROR: the only trait that can be derived is Eq

(import (std prelude))

(type/derive (Show)
  (: Point (Record (: x int) (: y int))))

(defun (main args) 0)
