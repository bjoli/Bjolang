;; Vec functions whose callback may suspend, without giving up the tree.
;;
;; The list functions in `161_list_callbacks.bjo` moved into the prelude whole,
;; because a cons list has no algorithm worth keeping. A `(Vec %a)` is an RRB
;; tree: mapping one copies the spine and shares every subtree it can, and
;; rewriting that in Bjolang would make every ordinary call pay for a colour it
;; never uses.
;;
;; So these are `defbjouble`s — two bodies, one signature. The ordinary half is
;; still the C# call it always was; the suspending half is an indexed walk
;; written by hand. It is the first use of `defbjouble` that is not a leaf: the
;; second body exists because the first cannot be awaited, rather than because
;; the two colours call different .NET methods.
;;
;; `vec-any?`, `vec-find` and the rest are deliberately not converted. Their
;; callbacks ask a question rather than do work, and a suspending one of those
;; is a `vec-fold` away — so a second body would buy something already
;; expressible. `vec-filter` is here because it is the one predicate that is
;; not: filtering with a fold needs an intermediate structure.

(import (std prelude))
(import (std simpletest))

(: ports (-> (Vec TextInputPort)))
(defun (ports)
  (vec-add (vec-add (vec-empty) (open-input-string "one\n"))
           (open-input-string "three\n")))

(: run-int (-> (Promise int) int))
(defun (run-int p)
  (match (sync/blocking (promise-join p)) ((Ok n) n) ((Err e) -1)))

(: run-str (-> (Promise string) string))
(defun (run-str p)
  (match (sync/blocking (promise-join p)) ((Ok s) s) ((Err e) "raised")))

;; --- suspending callbacks -----------------------------------------------------

(: first-lines (-bjo-> (Vec TextInputPort) string))
(defbjo (first-lines ps)
  (->str (vec-map (bjoroutine (p) (read-line p)) ps)))

(: loud-count (-bjo-> (Vec TextInputPort) int))
(defbjo (loud-count ps)
  (vec-length (vec-filter (bjoroutine (p) (not (string-empty? (read-line p)))) ps)))

(: total-length (-bjo-> (Vec TextInputPort) int))
(defbjo (total-length ps)
  (vec-fold (bjoroutine (acc p) (+ acc (string-length (read-line p)))) 0 ps))

;; `iter` stops early, so the second port is never read — which is the whole
;; point of it, and the one place a suspending walk can be *observed* to stop
;; rather than merely produce the right answer. "one" is three characters, so
;; the predicate is false at the first element and the walk ends there.
(def/mutable reads 0)

(: read-until-short (-bjo-> (Vec TextInputPort) int))
(defbjo (read-until-short ps)
  (set! reads 0)
  (ignore (vec-iter (bjoroutine (p)
                      (let ((l (read-line p)))
                        (set! reads (+ reads 1))
                        (> (string-length l) 4)))
                    ps))
  reads)

;; --- and the ordinary colour is untouched -------------------------------------
;;
;; These reach the C# bodies, which is what the arrangement is for.

(: doubled (-> (Vec int) (Vec int)))
(defun (doubled v) (vec-map (fun (x) (* x 2)) v))

(: evens (-> (Vec int) (Vec int)))
(defun (evens v) (vec-filter (fun (x) (> x 1)) v))

(: summed (-> (Vec int) int))
(defun (summed v) (vec-fold (fun (a x) (+ a x)) 0 v))

(: nums (-> (Vec int)))
(defun (nums)
  (vec-add (vec-add (vec-add (vec-empty) 1) 2) 3))

(defun (main)
  (expect "map with a suspending callback"
          (run-str (bjo (first-lines (ports)))) "[one three]")
  (expect "filter with a suspending predicate"
          (run-int (bjo (loud-count (ports)))) 2)
  (expect "fold with a suspending step"
          (run-int (bjo (total-length (ports)))) 8)
  (expect "iter stops early, suspending"
          (run-int (bjo (read-until-short (ports)))) 1)

  (expect "map, ordinarily" (->str (doubled (nums))) "[2 4 6]")
  (expect "filter, ordinarily" (->str (evens (nums))) "[2 3]")
  (expect "fold, ordinarily" (summed (nums)) 6)
  0)
