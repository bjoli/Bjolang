(import (std prelude))
(import (std simpletest))
(import "006_lib.bjo")
(defun (main args)
  ;; `poop-on-you` frågar på current-output-port och läser svaret från
  ;; current-input-port. Utskriften fångas på en strängport så att både
  ;; frågan och det inlästa namnet går att jämföra.
  (def out (open-output-string))
  (parameterize ((current-output-port out))
    (poop-on-you))
  (expect "the prompt, then the name read from stdin"
          (get-output-string out)
          "What is your name? \nPoop on you, Linus\n")
  0)
