;; A newtype is not the type it wraps where .NET is called: C# would choose an
;; overload by the wrapped type, and the checker by the newtype.

;; EXPECT-ERROR: no overload of 'System.Text.StringBuilder.Append' accepts (newtype_to_dotnet/Banana)
;; EXPECT-ERROR: A newtype is not the type it wraps here: take the value out of it with a pattern first.

(import (std prelude))
(import/class (StringBuilder (: System.Text.StringBuilder (-> StringBuilder))))

(type (: Banana (Newtype int)))

(defun (main args)
  (ignore (.Append (StringBuilder.) (Banana 3)))
  0)
