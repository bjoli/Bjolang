;; (:prologue ...) binds what a clause macro's drivers start from, and only a
;; clause macro answers one. In a loop it is refused, with what to write.
;;
;; EXPECT-ERROR: (:prologue ...) at
;; EXPECT-ERROR: is for a clause macro to answer

(defun (main args)
  (println (int->string {summing x (:prologue n 3) (:for x (range 0 n))}))
  0)
