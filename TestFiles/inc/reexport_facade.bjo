;; The facade. One import for its callers, and three types that are not its.
;;
;; `(re-export ...)` takes a type as readily as a binding, and publishes a
;; *spelling*: no declaration of this module's is made, and the one that
;; travels goes under the key `reexport_origin` gave it. That is what makes a
;; value built here and one built there the same type rather than two.
;;
;; A union comes whole. `Dot`, `Line` and `Blob` are not named below and arrive
;; anyway, because a union that arrived without its cases would be a type
;; nothing could take apart.
(export crate-of)

(import (std prelude))
(import "reexport_origin.bjo")

(: crate-of (-> string Crate))
(defun (crate-of s) (Crate (label s) (weight 1)))

(re-export Shape Crate Sealed seal sealed-tag shape-size)
