;; A trait has no key, so pretty_b's Pretty takes the place of pretty_a's.
;; The prefix A/ promises a name of its own for pretty_a's trait, and can not
;; keep that promise, so the program is refused.
;; EXPECT-ERROR: two different traits are named Pretty, one from pretty_a and one from pretty_b
;; EXPECT-ERROR: can not keep them apart
(import (std prelude))
(import (prefix-types "../inc/pretty_a.bjo" "A/") (prefix-defs "../inc/pretty_a.bjo" "A/"))
(import (prefix-types "../inc/pretty_b.bjo" "B/") (prefix-defs "../inc/pretty_b.bjo" "B/"))
(defun (main args)
  (println (A/pretty 5))
  (println (B/pretty "hello"))
  0)
