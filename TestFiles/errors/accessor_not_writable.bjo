;; `#:set` on a property that has no setter.
;;
;; Refused at the import rather than at the first write, for the reason every
;; other fact about a clause is: the claim that this member can be written was
;; made here, and it is wrong whether or not anybody got around to writing it.
;;
;; `String.Length` is the clearest case — a string is immutable, so there is no
;; setter to find and no way to add one.

;; EXPECT-ERROR: System.String.Length
;; EXPECT-ERROR: has no setter
;; EXPECT-ERROR: #:get

(import (std prelude))

(import/extern
  (set-length! (: System.String.Length #:set)))

(defun (main args) 0)
