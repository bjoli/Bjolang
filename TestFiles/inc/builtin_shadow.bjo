;; En modul med en privat bindning som heter som en builtin.
;;
;; Skuggan exporteras inte. Den gäller den här filen och ingen annan, och den
;; svarar tvärtemot builtinen så att fel svar syns som fel värde.

(export shadowed-answer)
(import (std prelude))

(: list-empty? (-> (List %a) bool))
(defun (list-empty? xs) #f)

(: shadowed-answer (-> (List string) bool))
(defun (shadowed-answer xs) (list-empty? xs))
