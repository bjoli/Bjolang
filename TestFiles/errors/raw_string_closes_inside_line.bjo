;; The closing quotes of a raw string over several lines are on a line of their
;; own, so the margin is what is before them. Three quotes inside a line are
;; neither a close nor text.

;; EXPECT-ERROR: It closes only on a line of its own

(import (std prelude))

(defun (main args)
  (println """
    a """ b
    """)
  0)
