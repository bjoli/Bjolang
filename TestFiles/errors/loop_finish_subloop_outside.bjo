;; `:finish-subloop` belongs inside a `:subloop` form.

;; EXPECT-ERROR: (:finish-subloop ...) at loop_finish_subloop_outside.bjo:10 is only allowed inside a (:subloop ...) form.

(import (std prelude))

(: f (-> (List int) int))
(defun (f xs)
  (loop (:for x xs)
        (:finish-subloop (> x 2))
        (:acc s (summing x))))

(defun (main) (println (int->string (f '(1 2 3)))) 0)
