;; `#:elsewhere` names a positional parameter of the function.

;; EXPECT-ERROR: #:elsewhere names 'job', and 'run' has the positional parameters 'n', 'work'.
;; EXPECT-ERROR: elsewhere_unknown_parameter.bjo:8:26

(import (std prelude))

(: (-> int (-> int) int) #:elsewhere job)
(defun (run n work) (+ n (work)))

(defun (main)
  (println (int->string (run 1 (fun () 2))))
  0)
