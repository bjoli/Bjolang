;; std/maths.bjo — Math functions.

;; Import Eq trait for `=`.
(import (std eq))

(export
  ;; Num
  abs sign min max clamp zero?
  ;; Exponential and logarithmic
  cbrt exp pow log log2 log10
  ;; Rounding
  floor ceiling truncate round
  ;; Trigonometric
  sin cos tan asin acos atan atan2
  ;; Hyperbolic
  sinh cosh tanh asinh acosh atanh)

;; ---------------------------------------------------------------------------
;; Num
;; ---------------------------------------------------------------------------

;; `Num` interface.
(def/trait (Num %a)
  (#:clr-constraint (System.Numerics.INumber %a))
  (: abs   (-> %a %a)        #:clr-member Abs)
  (: sign  (-> %a int)       #:clr-member Sign)
  (: min   (-> %a %a %a)     #:clr-member Min)
  (: max   (-> %a %a %a)     #:clr-member Max)
  (: clamp (-> %a %a %a %a)  #:clr-member Clamp)
  ;; Parity tests.
  (: zero? (-> %a bool)      #:clr-member IsZero)
  (: even? (-> %a bool)      #:clr-member IsEvenInteger)
  (: odd?  (-> %a bool)      #:clr-member IsOddInteger))


;; Todo: `min`/`max` over a sequence.

;; ---------------------------------------------------------------------------
;; The double functions
;; ---------------------------------------------------------------------------

;; Double functions.

;; Exponential and logarithmic.
(import/extern
  (cbrt  (: System.Math.Cbrt))
  (exp   (: System.Math.Exp))
  (pow   (: System.Math.Pow))
  (log   (: System.Math.Log))
  (log2  (: System.Math.Log2))
  (log10 (: System.Math.Log10)))

;; Rounding.
(import/extern
  (floor    (: System.Math.Floor))
  (ceiling  (: System.Math.Ceiling))
  (truncate (: System.Math.Truncate))
  (round    (: System.Math.Round)))

;; Trigonometric.
(import/extern
  (sin   (: System.Math.Sin))
  (cos   (: System.Math.Cos))
  (tan   (: System.Math.Tan))
  (asin  (: System.Math.Asin))
  (acos  (: System.Math.Acos))
  (atan  (: System.Math.Atan))
  (atan2 (: System.Math.Atan2)))

;; Hyperbolic.
(import/extern
  (sinh  (: System.Math.Sinh))
  (cosh  (: System.Math.Cosh))
  (tanh  (: System.Math.Tanh))
  (asinh (: System.Math.Asinh))
  (acosh (: System.Math.Acosh))
  (atanh (: System.Math.Atanh)))
