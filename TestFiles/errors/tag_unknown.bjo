;; A head symbol that names no tag, at a union with no untagged case for a
;; list. The whole point of a tag is that the declaration says which names
;; exist, so the report has to be the list of them.
;; EXPECT-ERROR: `pippe` is not a tag of the union tag_unknown/Q
;; EXPECT-ERROR: Its tags are from or where
(import (std prelude))

(type-rec
  (: Item (Union (ISym Symbol)))
  (: Q (Union (CFrom Symbol #:tag from)
              (CWhere Item #:tag where))))

(: render (-> Q string))
(defun (render q) "r")

(defun (main args)
  (println (render '(pippe x)))
  0)
