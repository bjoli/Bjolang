;; `(Pair %a %a)` is an implementation for pairs of one type only.
;; EXPECT-ERROR: Pair %a %a)' only

(import (std prelude))

(type (: (Pair %a %b) (Struct (: l %a) (: r %b))))

(def/trait (Describe %a)
  (: describe (-> %a string)))

(impl (Describe (Pair %a %a))
  (defun (describe x) "same"))

(: (-> %a string) (where (Describe %a)))
(defun (via x) (describe x))

(defun (main args)
  (println (via (Pair (l 1) (r "x"))))
  0)
