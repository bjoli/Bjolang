  (v256-array-lanes (: Bjolang.Runtime.BjoSimd.ArrayLanes256 (-> (Array %a) int)))
  (v256-list-lanes (: Bjolang.Runtime.BjoSimd.ListLanes256 (-> (MutableVec %a) int)))
  (simd256-accelerated? (: System.Runtime.Intrinsics.Vector256.IsHardwareAccelerated #:get)))

(: (-> %a (Simd256 %a)) (where (Lane %a)))
(defun (simd256-splat x) (v256-splat x))

(: (-> (Simd256 %a)) (where (Lane %a)))
(defun (simd256-zero) (v256-zero))

;; The vector a mask holds, and the mask of a vector of a comparison's lanes.
(: (-> (Simd256 %a) (Mask256 %a)))
(defun (m256 v) (Mask256 (lanes v)))

(: (-> (Mask256 %a) (Simd256 %a)))
(defun (lanes256 m) (record-ref m lanes))

(impl (Simd (Simd256 %a)) (where (Lane %a))
  (type %elem %a)
  (type %mask (Mask256 %a))
  (defun (simd-add a b) (v256-add a b))
  (defun (simd-sub a b) (v256-sub a b))
  (defun (simd-mul a b) (v256-mul a b))
  (defun (simd-scale a b) (v256-scale a b))
  (defun (simd-neg a) (v256-neg a))
  (defun (simd-abs a) (v256-abs a))
  (defun (simd-min a b) (v256-min a b))
  (defun (simd-max a b) (v256-max a b))
  (defun (simd-eq a b) (m256 (v256-eq a b)))
  (defun (simd-ne a b) (m256 (v256-not (v256-eq a b))))
  (defun (simd-lt a b) (m256 (v256-lt a b)))
  (defun (simd-le a b) (m256 (v256-le a b)))
  (defun (simd-gt a b) (m256 (v256-gt a b)))
  (defun (simd-ge a b) (m256 (v256-ge a b)))
  (defun (simd-select m a b) (v256-select (lanes256 m) a b))
  (defun (simd-sum a) (v256-sum a))
  (defun (simd-dot a b) (v256-dot a b))
  (defun (simd-ref a i) (v256-ref a i))
  (defun (simd-with a i x) (v256-with a i x))
  (defun (simd-store! a b c) (v256-store! a b c))
  (defun (simd-lanes a) (v256-lanes a)))

(impl (SimdBitwise (Simd256 %a)) (where (Lane %a))
  (defun (simd-and a b) (v256-and a b))
  (defun (simd-or a b) (v256-or a b))
  (defun (simd-xor a b) (v256-xor a b))
  (defun (simd-not a) (v256-not a))
  (defun (simd-and-not a b) (v256-and-not a b)))

(impl (SimdBitwise (Mask256 %a)) (where (Lane %a))
  (defun (simd-and a b) (m256 (v256-and (lanes256 a) (lanes256 b))))
  (defun (simd-or a b) (m256 (v256-or (lanes256 a) (lanes256 b))))
  (defun (simd-xor a b) (m256 (v256-xor (lanes256 a) (lanes256 b))))
  (defun (simd-not a) (m256 (v256-not (lanes256 a))))
  (defun (simd-and-not a b) (m256 (v256-and-not (lanes256 a) (lanes256 b)))))

(impl (SimdMask (Mask256 %a)) (where (Lane %a))
  (type %vec (Simd256 %a))
  (defun (simd-any? m) (v256-any? (lanes256 m)))
  (defun (simd-all? m) (v256-all? (lanes256 m)))
  (defun (simd-count-true m) (v256-count-true (lanes256 m)))
  (defun (simd-first-true m) (v256-first-true (lanes256 m)))
  (defun (simd-mask-bits m) (v256-mask-bits (lanes256 m)))
  (defun (simd-mask->lanes m) (lanes256 m)))

(impl (SimdFloat (Simd256 %a)) (where (FloatLane %a))
  (type %mask (Mask256 %a))
  (defun (simd-div a b) (v256-div a b))
  (defun (simd-sqrt a) (v256-sqrt a))
  (defun (simd-floor a) (v256-floor a))
  (defun (simd-ceiling a) (v256-ceiling a))
  (defun (simd-round a) (v256-round a))
  (defun (simd-truncate a) (v256-truncate a))
  (defun (simd-nan? a) (m256 (v256-nan? a)))
  (defun (simd-mul-add a b c) (v256-mul-add a b c)))

(impl (SimdInt (Simd256 %a)) (where (IntLane %a))
  (defun (simd-shift-left a n) (v256-shift-left a n))
  (defun (simd-shift-right a n) (v256-shift-right a n))
  (defun (simd-shift-right-logical a n) (v256-shift-right-logical a n))
  (defun (simd-add-saturating a b) (v256-add-saturating a b))
  (defun (simd-sub-saturating a b) (v256-sub-saturating a b))
  (defun (simd-shuffle v idx) (v256-shuffle v idx)))

(impl (SimdLookup (Simd256 %a)) (where (ByteLane %a))
  (defun (simd-lookup table idx) (v256-lookup table idx)))

(impl (SimdBits (Simd256 %a)) (where (Lane %a))
  (type %int8 (Simd256 System.SByte))
  (type %uint8 (Simd256 byte))
  (type %int16 (Simd256 short))
  (type %uint16 (Simd256 ushort))
  (type %int32 (Simd256 int))
  (type %uint32 (Simd256 uint))
  (type %int64 (Simd256 long))
  (type %uint64 (Simd256 ulong))
  (type %float32 (Simd256 System.Single))
  (type %float64 (Simd256 double))
  (defun (simd-bits->int8 v) (v256-as v))
  (defun (simd-bits->uint8 v) (v256-as v))
  (defun (simd-bits->int16 v) (v256-as v))
  (defun (simd-bits->uint16 v) (v256-as v))
  (defun (simd-bits->int32 v) (v256-as v))
  (defun (simd-bits->uint32 v) (v256-as v))
  (defun (simd-bits->int64 v) (v256-as v))
  (defun (simd-bits->uint64 v) (v256-as v))
  (defun (simd-bits->float32 v) (v256-as v))
  (defun (simd-bits->float64 v) (v256-as v)))

;; ---------------------------------------------------------------------------
;; Conversions
;; ---------------------------------------------------------------------------
;;
;; A conversion gives a vector of another element type, which depends on the
;; one it is given. So these traits are over the element type, with an impl
;; for each, and a method for each width: the name says the width, as the
;; name of what makes a vector does.
;;
;; Each name says what happens to a value that does not fit. Widening keeps
;; every value: a signed lane is sign-extended and an unsigned one is
;; zero-extended, by its type. Narrowing takes two vectors, the lower half
;; first, and either wraps, keeping the low bits, or saturates, giving the
;; nearest value that fits.

;; The lower or the upper half of the lanes, each widened to twice the bits.
(def/trait (SimdWiden %a)
  (type %wide)
  (: simd128-widen-lower (-> (Simd128 %a) (Simd128 %wide)))
  (: simd128-widen-upper (-> (Simd128 %a) (Simd128 %wide)))
  (: simd256-widen-lower (-> (Simd256 %a) (Simd256 %wide)))
  (: simd256-widen-upper (-> (Simd256 %a) (Simd256 %wide))))

;; Two vectors into one of half the bits a lane.
(def/trait (SimdNarrow %a)
  (type %narrow)
  (: simd128-narrow-wrapping (-> (Simd128 %a) (Simd128 %a) (Simd128 %narrow)))
  (: simd128-narrow-saturating (-> (Simd128 %a) (Simd128 %a) (Simd128 %narrow)))
  (: simd256-narrow-wrapping (-> (Simd256 %a) (Simd256 %a) (Simd256 %narrow)))
  (: simd256-narrow-saturating (-> (Simd256 %a) (Simd256 %a) (Simd256 %narrow))))

;; Integer lanes to float lanes of the same bits, rounded to the nearest float
;; where the integer has more digits than the float holds.
(def/trait (SimdIntToFloat %a)
  (type %float)
  (: simd128-int->float (-> (Simd128 %a) (Simd128 %float)))
  (: simd256-int->float (-> (Simd256 %a) (Simd256 %float))))

;; Float lanes to integer lanes of the same bits, toward zero. A value past the
;; integer type's range gives its least or greatest value, and NaN gives 0.
(def/trait (SimdFloatToInt %a)
  (type %int)
  (type %uint)
  (: simd128-float->int-truncating (-> (Simd128 %a) (Simd128 %int)))
  (: simd256-float->int-truncating (-> (Simd256 %a) (Simd256 %int)))
  (: simd128-float->uint-truncating (-> (Simd128 %a) (Simd128 %uint)))
  (: simd256-float->uint-truncating (-> (Simd256 %a) (Simd256 %uint))))

(import/extern
  (widen128-lower-sb (: System.Runtime.Intrinsics.Vector128.WidenLower (-> (Simd128 System.SByte) (Simd128 short))))
  (widen128-upper-sb (: System.Runtime.Intrinsics.Vector128.WidenUpper (-> (Simd128 System.SByte) (Simd128 short))))
  (widen256-lower-sb (: System.Runtime.Intrinsics.Vector256.WidenLower (-> (Simd256 System.SByte) (Simd256 short))))
  (widen256-upper-sb (: System.Runtime.Intrinsics.Vector256.WidenUpper (-> (Simd256 System.SByte) (Simd256 short)))))
