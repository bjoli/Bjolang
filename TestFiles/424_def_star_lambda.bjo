;; A function bound by `def*` in a body: the binding is declared with its
;; delegate type, since C# infers none for a lambda in a `var`.
(import (std prelude))
(import (std simpletest))

(: (-> (Vec int) int))
(defun (count-big xs)
  (def* (n 2)
        (big? (fun (ws i) (> (vec-ref ws i) n)))
        (twice (fun (g) (fun (x) (g (g x)))))
        (add1 #(+ & 1)))
  (+ (loop (:for i (range 0 (vec-length xs))) (:when (big? xs i)) (:acc (summing 1)))
     ((twice add1) 10)))

(: (-> %a %a))
(defun (kept x)
  (def* (keep (fun (y) y)))
  (keep x))

(defun (main)
  (expect "lambdas, one of them returning another" (count-big [1 3 5]) 14)
  (expect "a lambda at the function's own type variable" (kept "generic") "generic")
  (expect "and at another instantiation" (kept 7) 7)
  0)
