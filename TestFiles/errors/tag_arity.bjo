;; A tag's arguments are read positionally against what the case declares, so
;; the count is a thing the declaration decides and the form can get wrong.
;; EXPECT-ERROR: takes 1 argument, and this form has 2 arguments
(import (std prelude))

(type (: Q (Union (CFrom Symbol #:tag from) (CPlain (List Symbol)))))

(: render (-> Q string))
(defun (render q) "r")

(defun (main args)
  (println (render '(from a b)))
  0)
