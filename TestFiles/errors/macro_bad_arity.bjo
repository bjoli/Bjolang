;; A transformer takes exactly three parameters: the form, inject and compare.
;; The signature is fixed because the expander invokes it by reflection, so a
;; different shape is a syntax error rather than a mismatch discovered inside
;; the compiler.
;;
;; EXPECT-ERROR: a transformer takes exactly three parameters
;; EXPECT-ERROR: and this one takes 1

(def/macro (broken form)
  #'(+ 1 2))

(defun (main args) 0)
