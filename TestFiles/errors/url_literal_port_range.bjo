;; EXPECT-ERROR: a port is from 0 to 65535, and this is 99999
;;
;; The compiler runs the check `url/port` on a literal port. A port out of
;; range is a compile error at the literal, not an exception at run time.

(import (std url))

(defun (main args)
  (println (link '(url https "example.com" (port 99999))))
  0)
