;; def/dimension, def/unit and def/prefix, over units of this module and of
;; an imported one.
(import (std prelude))
(import (std simpletest))
(import "inc/unit_table.bjo")

(def/dimension mass #:base kg)
(def/unit g "1|1000 kg")
(def/unit ft "3048|10000 m")
(def/unit mi "5280 ft")
(def/unit kmh "1 km/h")
(def/unit N "1 kg m/s^2")
(def/unit J "1 N*m")
(def/unit W "1 J/s")
(def/unit deg "1|180 pi")
(def/unit % "1|100")
(def/unit Hz "1/s")
(def/unit noise "1 m^(1/2)/Hz^-1|2")
(def/unit yd "3 ft")
(def/unit acre "4840 yd2")

(defun (main)
  (expect-true "the imported module is there" (= (seconds-per-hour) 3600))
  0)
