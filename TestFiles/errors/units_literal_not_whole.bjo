;; A literal whose value in the base is not whole, at a whole-number carrier.

;; EXPECT-ERROR: <0.001 EUR> is 1/10 cent, and a long holds whole numbers only

(import (std prelude))

(def/dimension money #:base cent #:carrier long)
(def/unit EUR <100 cent>)

(def tiny <0.001 EUR>)

(defun (main) 0)
