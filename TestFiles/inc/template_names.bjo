;; Macros whose templates call functions this module imports and does not
;; export, for `341_template_names_resolved.bjo`.

(import (std prelude))
(import (std syntax-match))

(export joined shouted)

(def/macro (joined form inject compare)
  (syntax-match form
    ((_ a b) #'(string-append ,a ,b))))

(def/macro (shouted form inject compare)
  (syntax-match form
    ((_ s) #'(string-upcase ,s))))
