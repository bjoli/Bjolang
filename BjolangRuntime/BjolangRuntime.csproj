<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <NuGetAudit>false</NuGetAudit>
  </PropertyGroup>
  <ItemGroup>
    <!-- The CML layer is compiled straight in: `Cml\*.cs` is swept up by this
         project's own glob and wants no removal. Only the projects beside it do
         — a test runner, a stress harness and a sample, each with a `Main`. -->
    <Compile Remove="Cml\Tests\**" />
    <Compile Remove="Cml\StressTest\**" />
    <Compile Remove="Cml\Example\**" />
    <None Remove="Cml\Tests\**" />
    <None Remove="Cml\StressTest\**" />
    <None Remove="Cml\Example\**" />
  </ItemGroup>
  <ItemGroup>
    <!-- The regression tests need to observe parked operations to get a reliable
         "this fiber has suspended" signal. -->
    <InternalsVisibleTo Include="Tests" />
    <!-- The diagnostic harness benchmarks the direct TimeoutEvent against the
         retained combinator specification (Cml.TimeoutViaCombinators). -->
    <InternalsVisibleTo Include="Diag" />
  </ItemGroup>
  <ItemGroup>
    <!-- Every one of these is a submodule with a project of its own. Without
         the removals their sources are swept up by this project's own glob and
         compiled a second time. -->
    <Compile Remove="RrbList\**" />
    <Compile Remove="Map\**" />
    <Compile Remove="SchemeList\**" />
    <Compile Remove="Set\**" />
    <Compile Remove="OrderedSet\**" />
    <Compile Remove="OrderedMap\**" />
    <Compile Remove="BjoString\**" />
    <EmbeddedResource Remove="BjoString\**" />
    <None Remove="BjoString\**" />
    <Compile Remove="BjoRx\**" />
    <EmbeddedResource Remove="BjoRx\**" />
    <None Remove="BjoRx\**" />
    <EmbeddedResource Remove="RrbList\**" />
    <EmbeddedResource Remove="Map\**" />
    <EmbeddedResource Remove="SchemeList\**" />
    <EmbeddedResource Remove="Set\**" />
    <EmbeddedResource Remove="OrderedSet\**" />
    <EmbeddedResource Remove="OrderedMap\**" />
    <None Remove="RrbList\**" />
    <None Remove="Map\**" />
    <None Remove="SchemeList\**" />
    <None Remove="Set\**" />
    <None Remove="OrderedSet\**" />
    <None Remove="OrderedMap\**" />
    <ProjectReference Include="RrbList/src/Collections/Collections.csproj" />
    <ProjectReference Include="SchemeList/src/SchemeList/SchemeList.csproj" />
    <ProjectReference Include="Map/Map/Map.csproj" />
    <ProjectReference Include="Set/Set/Set.csproj" />
    <ProjectReference Include="OrderedSet/OrderedSet/OrderedSet.csproj" />
    <ProjectReference Include="OrderedMap/OrderedMap/OrderedMap.csproj" />
    <ProjectReference Include="BjoString/src/BjoString/BjoString.csproj" />
    <ProjectReference Include="BjoRx/src/BjoRx/BjoRx.csproj" />
  </ItemGroup>
</Project>
