  (summary "4 lanes of @code{double}: @code{(Simd256 double)}."))

(:doc Float32x8
  (summary "8 lanes of @code{System.Single}: @code{(Simd256 System.Single)}."))

(:doc Int64x4
  (summary "4 lanes of @code{long}: @code{(Simd256 long)}."))

(:doc Int32x8
  (summary "8 lanes of @code{int}: @code{(Simd256 int)}."))

(:doc Int16x16
  (summary "16 lanes of @code{short}: @code{(Simd256 short)}."))

(:doc Int8x32
  (summary "32 lanes of @code{System.SByte}: @code{(Simd256 System.SByte)}."))

