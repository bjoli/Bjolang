;; Keyword lists of a grammar: the head symbol of a quoted literal selects
;; the constructor.
;;
;; `(kw item ...)` is an alternative that starts with the keyword `kw`. The
;; literal does not keep the keyword. The other values of the list are the
;; payload of the case, in order, and `item ...` is a List. `'kw` alone is a
;; case without a payload. A keyword has priority over a list without a
;; keyword and over a symbol, so the cases without keywords stay reachable
;; for other heads.

(import (std prelude))
(import (std simpletest))
(import "inc/tagged.bjo")

(def/grammar Q
  (Q (:or (: CSym symbol)                 ;; a bare symbol
          (: CStr string)                 ;; a string
          (: CPlain (Item ...))           ;; a list without a keyword
          (: CSelect (select Item ...))   ;; a keyword, then a repeat
          (: CFrom (from symbol))         ;; one argument
          (: CInto (into string Q))       ;; two, one of them the grammar
          (: CAsc 'asc)                   ;; nothing at all
          (: CParam (param Prm))))        ;; an argument selected by type
  (Item (:or (: ISym symbol) (: IStr string) (: ISub (Item ...))))
  ;; `,x` has no shape of its own, so its type selects the case.
  (Prm (:or (: PrInt int) (: PrStr string))))

(: (-> Prm string))
(defun (render-prm p)
  (match p
    ((PrInt n) (string-append "int " (int->string n)))
    ((PrStr s) (string-append "str " s))))

(: (-> Item string))
(defun (render-item i)
  (match i
    ((ISym s) (symbol->string s))
    ((IStr s) (string-append "\"" (string-append s "\"")))
    ((ISub xs) (string-append "(" (string-append (render-items xs) ")")))))

(: (-> (List Item) string))
(defun (render-items xs)
  (match xs
    (Nil "")
    ((Cons x Nil) (render-item x))
    ((Cons x rest) (string-append (render-item x) (string-append " " (render-items rest))))))

(: (-> Q string))
(defun (render q)
  (match q
    ((CSym s) (string-append "sym:" (symbol->string s)))
    ((CStr s) (string-append "str:" s))
    ((CPlain xs) (string-append "plain(" (string-append (render-items xs) ")")))
    ((CSelect xs) (string-append "select(" (string-append (render-items xs) ")")))
    ((CFrom t) (string-append "from " (symbol->string t)))
    ((CInto p inner) (string-append "into " (string-append p (string-append " " (render inner)))))
    ((CAsc) "asc")
    ((CParam p) (string-append "param:" (render-prm p)))))

;; A return type is an expected type. Thus the grammar reads a literal at
;; the end of a body. This is also true through an `if`, a `let` and a
;; `match`.
(: (-> Q))
(defun (from-t) '(from t))

(: (-> bool Q))
(defun (pick b) (if b '(from a) 'asc))

(: (-> Q))
(defun (via-let)
  (let ((name "out"))
    '(into ,name (from t))))

(: (-> (Option Symbol) Q))
(defun (via-match o)
  (match o
    ((Some s) '(from ,s))
    (None '(select))))

(defun (main args)
  ;; --- The arities of a keyword list --------------------------------------
  ;;
  ;; `Item ...`: any number of arguments, also none.
  (expect "repeat, several arguments" (render '(select a "b" (c d))) "select(a \"b\" (c d))")
  (expect "repeat, none" (render '(select)) "select()")

  ;; One argument, and two arguments. The second argument of `into` is the
  ;; grammar itself.
  (expect "one argument" (render '(from users)) "from users")
  (expect "two arguments, one the grammar" (render '(into "out.txt" (from t))) "into out.txt from t")

  ;; The symbol alone selects a case without a payload.
  (expect "no payload" (render 'asc) "asc")

  ;; --- What a keyword does not take ---------------------------------------
  ;;
  ;; A head that is not a keyword is not an error, because the grammar has a
  ;; list without a keyword. `'(plain a "b")` is that case, and its head is
  ;; one more element of the list.
  (expect "a head that is not a keyword" (render '(plain a "b")) "plain(plain a \"b\")")
  (expect "a string case" (render "hello") "str:hello")
  (expect "a symbol case" (render 'x) "sym:x")

  ;; --- The same, from a compiled module -----------------------------------
  ;;
  ;; The metadata carries the grammar. Thus an importing module reads a
  ;; keyword list as the declaring module does.
  (expect "imported keyword, repeat" (render-q '(select a (b c))) "select(a (b c))")
  (expect "imported keyword, one argument" (render-q '(from users)) "from users")
  (expect "imported keyword, nothing" (render-q 'esc) "esc")
  (expect "imported list without a keyword" (render-q '(plain a)) "plain(plain a)")

  ;; --- Splices ------------------------------------------------------------
  ;;
  ;; `,@` puts its elements where the grammar repeats an item.
  (def (: parts (List Item)) (list (ISym 'a) (ISym 'b)))
  (expect "a splice among the arguments" (render '(select ,@parts "z")) "select(a b \"z\")")
  (expect "a splice alone" (render '(select ,@parts)) "select(a b)")

  ;; --- An argument selected by type ---------------------------------------
  ;;
  ;; `,x` has no shape, so its type selects the case of Prm. The annotation
  ;; gives the type.
  (def (: amount int) 7)
  (def label "ada")
  (expect "an argument by type, int" (render '(param ,amount)) "param:int 7")
  (expect "an argument by type, string" (render '(param ,label)) "param:str ada")

  ;; --- Where the expected type comes from ---------------------------------
  ;;
  ;; An annotation, and the parameter of a function. The same literal is a Q
  ;; in both places.
  (def (: annotated Q) '(from t))
  (expect "an annotated binding" (render annotated) "from t")
  (expect "through a call" (render '(from t)) "from t")

  ;; A tail position passes the expected type on: a return type, the
  ;; branches of an `if`, a `let` body, a `match` arm, and the value of a
  ;; `def/mutable`.
  (expect "a return value" (render (from-t)) "from t")
  (expect "an if, then" (render (pick #t)) "from a")
  (expect "an if, else" (render (pick #f)) "asc")
  (expect "a let body" (render (via-let)) "into out from t")
  (expect "a match arm" (render (via-match (Some 'u))) "from u")
  (expect "another match arm" (render (via-match None)) "select()")
  (expect "an if in argument position" (render (if (vec-empty? args) '(from x) '(from y))) "from x")

  (defun (local) : Q '(from l))
  (expect "a local function's body" (render (local)) "from l")

  (def/mutable (: cell Q) '(from m))
  (expect "an annotated def/mutable" (render cell) "from m")
  0)
