;; `=` on two functions.
;;
;; The blanket implementation means a type with none of its own still has an
;; equality, so this is one of the few things `=` cannot do. A function type's
;; only implementations are those written for `Procedure`, which no blanket
;; reaches, and `Eq` has none for it.
;;
;; There is no negative-implementation mechanism, so there is no way to say
;; "this type has no meaningful equality" about a type that *does* have a head:
;; `(= p q)` on two ports compiles and means reference identity.

;; EXPECT-ERROR: no implementation of trait 'Eq'
;; EXPECT-ERROR: (-> int int)
;; EXPECT-ERROR: a blanket implementation does not reach it

(import (std prelude))

(: (-> int int))
(defun (twice x) (* 2 x))

(defun (main args)
  (if (= twice twice) 1 0))
