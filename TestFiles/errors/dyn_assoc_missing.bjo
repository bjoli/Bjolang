;; En dyn-typ nålar fast varenda associerad typ traiten deklarerar. Lådan döljer
;; typen som annars skulle svara på dem, så en som inte är fastnålad har inget
;; svar alls.
;;
;; EXPECT-ERROR: the associated type #:item of 'Foldable' is not pinned
;; EXPECT-ERROR: it has #:item

(import (std prelude))

(: total (-> (dyn Foldable) int))
(defun (total d) 0)

(defun (main args) 0)
