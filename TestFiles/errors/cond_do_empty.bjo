;; A `(:do)` clause with nothing in it.
;;
;; It would expand to nothing at all, which is a clause written by mistake
;; rather than a clause that does nothing on purpose.
;;
;; EXPECT-ERROR: (:do ...) needs something to run

(import (std prelude))

(: broken (-> int int))
(defun (broken n)
  (cond
    ((> n 0) 1)
    (:do)
    (else 0)))

(defun (main) (println (int->string (broken 0))) 0)
