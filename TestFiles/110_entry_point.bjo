;; The entry point's one shape: `(-> (List string) int)`.
;;
;; `main` is called by generated code, so its type is the runtime's to say. A
;; `main` written without a signature is given that one — which is what makes
;; `args` a list of strings here rather than whatever this body happens to
;; constrain — and a `main` written without a parameter is given one anyway.
;;
;; The runner passes no arguments, so what is asserted is the shape: a real
;; empty list, and elements a string function will take.
(import (std prelude))
(import (std simpletest))

;; Takes exactly what `main` is given, so calling it below is the assertion:
;; nothing in `main`'s body has to pin the element type down.
(: join (-> (List string) string))
(defun (join xs)
  (fold (fun (acc s) (string-append acc s)) "" xs))

(defun (main args)
  (expect "main is handed the arguments as a list" (list-length args) 0)
  (expect "whose elements are strings" (join args) "")
  (println "110 ok")
  0)
