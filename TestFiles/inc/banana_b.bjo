;; The other half of the clash: a second `Banana`, with a case and a payload
;; of its own, so that confusing the two is visible rather than merely wrong.

(export Banana peel-b make-b)

(type (: Banana (Union (MkBananaB string))))

(: make-b (-> string Banana))
(defun (make-b s)
  (MkBananaB s))

(: peel-b (-> Banana string))
(defun (peel-b b)
  (match b
    ((MkBananaB s) s)))
