;; A body an `#:opaque` type's module published is checked where it lands, as
;; that module's code, and so needs no fallback.
;;
;; `coin-weight`'s body is `origin_marks`'s, except for the `Coin` a
;; `sealed_box` macro built inside it. That part keeps `sealed_box`'s access
;; across the publication, or the copy made here could not construct it.

;; EXPECT-NO-WARNING: could not specialise
;; EXPECT-NO-WARNING: could not inline

(import (std prelude))
(import "../inc/sealed_box.bjo")
(import "../inc/origin_marks.bjo")

(defun (main)
  (println (double-coin 5))
  (println (sealed-tag 7))
  (println (coin-value (coin-weight "four")))
  (println (span-ticks 42L))
  0)
