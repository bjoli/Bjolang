(import (std prelude))
(import (std orderedmap))
(import (std orderedset))
(import (std simpletest))

;; `orderedmap-merge`, `orderedmap-merge-with`, `orderedset-union`,
;; `-intersection` and `-difference` take two or more. Each result is checked
;; against the same inputs taken two at a time, for few inputs and for more
;; than the 32 the k-way walk takes, with one big input and without.

;; A map of `n` keys from `lo` on, by `step`, each worth `tag` more than its key.
(: (-> int int int int (OrderedMap int int)))
(defun (keys-map lo n step tag)
  (list->orderedmap {listing (Tuple k (+ k tag)) (:for i (range 0 n)) (:let k (+ lo (* i step)))}))

(: (-> int int int (OrderedSet int)))
(defun (keys-set lo n step)
  (list->orderedset {listing (+ lo (* i step)) (:for i (range 0 n))}))

;; A resolver whose result depends on the order of its arguments.
(: (-> int int int int))
(defun (combine k a b) (+ (* a 31) b k))

(: (-> (List (OrderedMap int int)) void))
(defun (check-maps maps)
  (match maps
    ((Cons a (Cons b rest))
     (def what #"${(list-length maps)} maps")
     (expect #"merge of ${what}"
             (orderedmap->list (apply orderedmap-merge a b rest))
             (orderedmap->list (list-foldl (fun (m acc) (orderedmap-merge acc m)) a (Cons b rest))))
     (expect #"merge-with of ${what}"
             (orderedmap->list (apply orderedmap-merge-with combine a b rest))
             (orderedmap->list (list-foldl (fun (m acc) (orderedmap-merge-with combine acc m)) a (Cons b rest)))))
    (_ (expect "two maps at least" #f #t))))

(: (-> (List (OrderedSet int)) void))
(defun (check-sets sets)
  (match sets
    ((Cons a (Cons b rest))
     (def what #"${(list-length sets)} sets")
     (expect #"union of ${what}"
             (orderedset->list (apply orderedset-union a b rest))
             (orderedset->list (list-foldl (fun (s acc) (orderedset-union acc s)) a (Cons b rest))))
     (expect #"intersection of ${what}"
             (orderedset->list (apply orderedset-intersection a b rest))
             (orderedset->list (list-foldl (fun (s acc) (orderedset-intersection acc s)) a (Cons b rest))))
     (expect #"difference of ${what}"
             (orderedset->list (apply orderedset-difference a b rest))
             (orderedset->list (list-foldl (fun (s acc) (orderedset-difference acc s)) a (Cons b rest)))))
    (_ (expect "two sets at least" #f #t))))

(defun (main)
  (def a (list->orderedmap (list (Tuple "x" 1) (Tuple "y" 2))))
  (def b (list->orderedmap (list (Tuple "y" 10) (Tuple "z" 3))))
  (def c (list->orderedmap (list (Tuple "z" 30))))
  (expect "the last value wins"
          (orderedmap->list (orderedmap-merge a b c))
          (list (Tuple "x" 1) (Tuple "y" 10) (Tuple "z" 30)))
  (expect "values combined left to right"
          (orderedmap->list (orderedmap-merge-with (fun (k l r) (- l r)) a b c))
          (list (Tuple "x" 1) (Tuple "y" -8) (Tuple "z" -27)))

  ;; Overlapping keys spread over a few maps, which the k-way walk takes; 40
  ;; small maps, too many for it; and one big map in the middle, which a
  ;; transient takes.
  (check-maps {listing (keys-map i 2000 (+ 2 i) i) (:for i (range 0 5))})
  (check-maps {listing (keys-map (* i 7) 50 3 i) (:for i (range 0 40))})
  (check-maps (list (keys-map 0 30 5 1) (keys-map 3 40 2 2) (keys-map 0 20000 1 3)
                    (keys-map 1 30 9 4) (keys-map 5 10 1 5)))

  (check-sets {listing (keys-set i 2000 (+ 2 i)) (:for i (range 0 5))})
  (check-sets {listing (keys-set (* i 7) 300 3) (:for i (range 0 40))})
  (check-sets (list (keys-set 0 20000 1) (keys-set 3 40 2) (keys-set 0 30 5)
                    (keys-set 1 30 9) (keys-set 5 10 1)))
  (check-sets (list (keys-set 0 30 5) (keys-set 3 40 2) (keys-set 0 20000 1)))
  0)
