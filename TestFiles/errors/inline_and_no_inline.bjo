;; `#:inline` and `#:no-inline` on one definition.
;;
;; The two markers say opposite things, and neither wins by being written
;; first, so the signature is rejected rather than read one way.

(import (std prelude))

;; EXPECT-ERROR: has #:inline and #:no-inline. A function is one or the other.
(: (-> int int) #:inline #:no-inline)
(defun (f x) (+ x 1))

(defun (main args) (f 1))
