;; Defines `twice`, which 548_macro_reexport reaches only through the modules
;; that export it again. Its template names `dbl`, a binding of this module.

(import (std syntax-match))

(export dbl)

(: (-> int int))
(defun (dbl x) (* 2 x))

(def/macro (twice form inject compare)
  (syntax-match form
    ((_ e) #'(dbl ,e))
    (bad (syntax-error bad "twice takes one form"))))
