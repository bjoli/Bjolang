;; std/simd.bjo — vectors of numbers, a fixed number of lanes wide.
;;
;; A lane type is a .NET `Vector128<T>` or `Vector256<T>`: 128 or 256 bits of
;; numbers of one type. `Float64x4` is four doubles and `Int8x32` is 32 signed
;; bytes. An operation on one is one CPU instruction where the CPU has it.
;;
;; The operations are the methods of a few traits, which both widths
;; implement: `Simd` for what every element type has, `SimdFloat` and
;; `SimdInt` for what only floats or only integers have, `SimdBitwise` for
;; vectors and masks alike, and `SimdMask` for masks. So `simd-add` adds two
;; `Float64x2`s or two `Int32x8`s. What makes a vector — `simd256-load`,
;; `simd128-splat` — says its width, as there is no argument to take it from,
;; and so does a conversion, whose result is a vector of another type.
;;
;; A comparison gives a mask, `(Mask128 %a)` or `(Mask256 %a)`, which is a
;; type of its own: it can be combined, counted and selected with, but not
;; added up as numbers.
;;
;; The design follows OxCaml's SIMD library where that fits a language with
;; traits and unsigned types: typed masks, operations only where they mean
;; something, and conversions named for what they do with what does not fit.
;;
;; A 128-bit vector is fast on every x86-64 and ARM64 CPU. A 256-bit one needs
;; AVX2: elsewhere .NET emulates it, which is much slower than scalar code.
;; `simd256-accelerated?` says which. A Native AOT build has AVX2 only with
;; `(aot-cpu ...)`.
(import (std prelude)
        (std syntax-match)
        (std mutable vec))

(:doc #:file "simd.bjodoc")

(export
  Simd128 Simd256 Mask128 Mask256
  Float64x2 Float32x4 Int64x2 Int32x4 Int16x8 Int8x16
  UInt64x2 UInt32x4 UInt16x8 UInt8x16
  Float64x4 Float32x8 Int64x4 Int32x8 Int16x16 Int8x32
  UInt64x4 UInt32x8 UInt16x16 UInt8x32
  ;; The element types
  Lane IntLane FloatLane
  ;; What every vector has
  Simd
  simd-add simd-sub simd-mul simd-scale simd-neg simd-abs simd-min simd-max
  simd-eq simd-ne simd-lt simd-le simd-gt simd-ge simd-select
  simd-sum simd-dot simd-ref simd-with simd-store! simd-lanes
  ;; Bits, of vectors and masks
  SimdBitwise
  simd-and simd-or simd-xor simd-not simd-and-not
  ;; Masks
  SimdMask
  simd-any? simd-all? simd-count-true simd-first-true simd-mask-bits simd-mask->lanes
  ;; Floats only
  SimdFloat
  simd-div simd-sqrt simd-floor simd-ceiling simd-round simd-truncate simd-nan? simd-mul-add
  ;; Integers only
  SimdInt
  simd-shift-left simd-shift-right simd-shift-right-logical
  simd-add-saturating simd-sub-saturating simd-shuffle
  ;; Byte tables
  ByteLane SimdLookup simd-lookup
  ;; The same bits as another element type
  SimdBits
  simd-bits->int8 simd-bits->uint8 simd-bits->int16 simd-bits->uint16
  simd-bits->int32 simd-bits->uint32 simd-bits->int64 simd-bits->uint64
  simd-bits->float32 simd-bits->float64
  ;; Conversions
  SimdWiden SimdNarrow SimdIntToFloat SimdFloatToInt
  simd128-widen-lower simd128-widen-upper simd256-widen-lower simd256-widen-upper
  simd128-narrow-wrapping simd128-narrow-saturating
  simd256-narrow-wrapping simd256-narrow-saturating
  simd128-int->float simd256-int->float
  simd128-float->int-truncating simd256-float->int-truncating
  simd128-float->uint-truncating simd256-float->uint-truncating
  ;; Where vectors are loaded from
  SimdSource simd-source-length
  ;; Making one
  simd128-splat simd128-zero simd128-of simd128-load simd128-lanes simd128-whole
  simd256-splat simd256-zero simd256-of simd256-load simd256-lanes simd256-whole
  simd128-accelerated? simd256-accelerated?)

(import/class
  ((Simd128 %a) (: System.Runtime.Intrinsics.Vector128))
  ((Simd256 %a) (: System.Runtime.Intrinsics.Vector256)))

;; A comparison's answer: a vector of the same type, with every bit of a lane
;; set where the comparison holds and none where it does not, kept apart from
;; the vectors so that it is not mistaken for numbers. Only this module makes
;; one. The JIT keeps it in a register as it keeps the vector.
(type (: (Mask128 %a) #:opaque (Struct (: lanes (Simd128 %a)))))
(type (: (Mask256 %a) #:opaque (Struct (: lanes (Simd256 %a)))))

;; ---------------------------------------------------------------------------
;; The lane types
;; ---------------------------------------------------------------------------
;;
;; Named as OxCaml names them: the element's type and bits, and the lanes.

(type (: Float64x2 (Simd128 double)))
(type (: Float32x4 (Simd128 System.Single)))
(type (: Int64x2   (Simd128 long)))
(type (: Int32x4   (Simd128 int)))
(type (: Int16x8   (Simd128 short)))
(type (: Int8x16   (Simd128 System.SByte)))
(type (: UInt64x2  (Simd128 ulong)))
(type (: UInt32x4  (Simd128 uint)))
(type (: UInt16x8  (Simd128 ushort)))
(type (: UInt8x16  (Simd128 byte)))

(type (: Float64x4 (Simd256 double)))
(type (: Float32x8 (Simd256 System.Single)))
(type (: Int64x4   (Simd256 long)))
(type (: Int32x8   (Simd256 int)))
(type (: Int16x16  (Simd256 short)))
(type (: Int8x32   (Simd256 System.SByte)))
(type (: UInt64x4  (Simd256 ulong)))
(type (: UInt32x8  (Simd256 uint)))
(type (: UInt16x16 (Simd256 ushort)))
(type (: UInt8x32  (Simd256 byte)))

;; ---------------------------------------------------------------------------
;; The element types
;; ---------------------------------------------------------------------------
;;
;; .NET's vectors hold the primitive numbers below and nothing else: a vector
;; of another type is refused when it is made, at run time. `Lane` says which
;; types they are, so a vector of a char or a string is refused when it is
;; compiled. `IntLane` and `FloatLane` divide them, for the operations that
;; mean something for one kind only. None has methods, and nothing outside
;; this module implements them.

(def/trait (Lane %a))
(impl (Lane double))
(impl (Lane System.Single))
(impl (Lane long))
(impl (Lane int))
(impl (Lane short))
(impl (Lane System.SByte))
(impl (Lane ulong))
(impl (Lane uint))
(impl (Lane ushort))
(impl (Lane byte))

(def/trait (IntLane %a))
(impl (IntLane long))
(impl (IntLane int))
(impl (IntLane short))
(impl (IntLane System.SByte))
(impl (IntLane ulong))
(impl (IntLane uint))
(impl (IntLane ushort))
(impl (IntLane byte))

(def/trait (FloatLane %a))
(impl (FloatLane double))
(impl (FloatLane System.Single))

;; The element type `simd-lookup` takes its indices in.
(def/trait (ByteLane %a))
(impl (ByteLane byte))

;; ---------------------------------------------------------------------------
;; The traits
;; ---------------------------------------------------------------------------

;; What every vector has. A comparison gives a `%mask`, which `simd-select`
;; takes: a lane from its second argument where the mask is set, and from its
;; third where it is not.
(def/trait (Simd %v)
  (type %elem)
  (type %mask)
  (: simd-add   (-> %v %v %v))
  (: simd-sub   (-> %v %v %v))
  (: simd-mul   (-> %v %v %v))
  (: simd-scale (-> %v %elem %v))
  (: simd-neg   (-> %v %v))
  (: simd-abs   (-> %v %v))
  (: simd-min   (-> %v %v %v))
  (: simd-max   (-> %v %v %v))
  (: simd-eq    (-> %v %v %mask))
  (: simd-ne    (-> %v %v %mask))
  (: simd-lt    (-> %v %v %mask))
  (: simd-le    (-> %v %v %mask))
  (: simd-gt    (-> %v %v %mask))
  (: simd-ge    (-> %v %v %mask))
  (: simd-select (-> %mask %v %v %v))
  (: simd-sum   (-> %v %elem))
  (: simd-dot   (-> %v %v %elem))
  (: simd-ref   (-> %v int %elem))
  (: simd-with  (-> %v int %elem %v))
  (: simd-store! (-> %v (Array %elem) int void))
  (: simd-lanes (-> %v int)))

;; The bitwise operations, which vectors and masks both have. Two masks
;; combine into a mask.
(def/trait (SimdBitwise %v)
  (: simd-and (-> %v %v %v))
  (: simd-or  (-> %v %v %v))
  (: simd-xor (-> %v %v %v))
  (: simd-not (-> %v %v))
  (: simd-and-not (-> %v %v %v)))

;; Reading a mask. A lane is set when every bit of it is, and the top bit says
;; it, so each reader is one move-mask instruction and an integer operation.
(def/trait (SimdMask %m)
  (type %vec)
  (: simd-any? (-> %m bool))
  (: simd-all? (-> %m bool))
  (: simd-count-true (-> %m int))
  (: simd-first-true (-> %m int))
  (: simd-mask-bits (-> %m int))
  (: simd-mask->lanes (-> %m %vec)))

;; What only float lanes have. Integer lanes divide one lane at a time, with
;; no instruction for it, and raise on a zero; that is not offered as a
;; vector operation.
(def/trait (SimdFloat %v)
  (type %mask)
  (: simd-div (-> %v %v %v))
  (: simd-sqrt (-> %v %v))
  (: simd-floor (-> %v %v))
  (: simd-ceiling (-> %v %v))
  (: simd-round (-> %v %v))
  (: simd-truncate (-> %v %v))
  (: simd-nan? (-> %v %mask))
  (: simd-mul-add (-> %v %v %v %v)))

;; What only integer lanes have. A shift of a float lane would shift the bits
;; of its encoding. A shuffle's indices are of the vector's own type, which
;; for a float vector would be another type; a float vector is shuffled as
;; the same bits read as integers, with `simd-bits->int64` and back.
(def/trait (SimdInt %v)
  (: simd-shift-left (-> %v int %v))
  (: simd-shift-right (-> %v int %v))
  (: simd-shift-right-logical (-> %v int %v))
  (: simd-add-saturating (-> %v %v %v))
  (: simd-sub-saturating (-> %v %v %v))
  (: simd-shuffle (-> %v %v %v)))

;; A lookup in a table of 16 bytes, one for each byte of the indices.
(def/trait (SimdLookup %v)
  (: simd-lookup (-> (Simd128 byte) %v %v)))

;; The same bits, read as lanes of another type. The lanes are as many as the
;; bits allow: an `Int64x2` is a `UInt8x16`.
(def/trait (SimdBits %v)
  (type %int8) (type %uint8) (type %int16) (type %uint16) (type %int32)
  (type %uint32) (type %int64) (type %uint64) (type %float32) (type %float64)
  (: simd-bits->int8 (-> %v %int8))
  (: simd-bits->uint8 (-> %v %uint8))
  (: simd-bits->int16 (-> %v %int16))
  (: simd-bits->uint16 (-> %v %uint16))
  (: simd-bits->int32 (-> %v %int32))
  (: simd-bits->uint32 (-> %v %uint32))
  (: simd-bits->int64 (-> %v %int64))
  (: simd-bits->uint64 (-> %v %uint64))
  (: simd-bits->float32 (-> %v %float32))
  (: simd-bits->float64 (-> %v %float64)))

;; ---------------------------------------------------------------------------
;; 128 bits
;; ---------------------------------------------------------------------------

(import/extern
  (v128-add (: System.Runtime.Intrinsics.Vector128.Add (-> (Simd128 %a) (Simd128 %a) (Simd128 %a))))
  (v128-sub (: System.Runtime.Intrinsics.Vector128.Subtract (-> (Simd128 %a) (Simd128 %a) (Simd128 %a))))
  (v128-mul (: System.Runtime.Intrinsics.Vector128.Multiply (-> (Simd128 %a) (Simd128 %a) (Simd128 %a))))
  (v128-div (: System.Runtime.Intrinsics.Vector128.Divide (-> (Simd128 %a) (Simd128 %a) (Simd128 %a))))
  (v128-scale (: System.Runtime.Intrinsics.Vector128.Multiply (-> (Simd128 %a) %a (Simd128 %a))))
  (v128-neg (: System.Runtime.Intrinsics.Vector128.Negate (-> (Simd128 %a) (Simd128 %a))))
  (v128-abs (: System.Runtime.Intrinsics.Vector128.Abs (-> (Simd128 %a) (Simd128 %a))))
  (v128-min (: System.Runtime.Intrinsics.Vector128.Min (-> (Simd128 %a) (Simd128 %a) (Simd128 %a))))
  (v128-max (: System.Runtime.Intrinsics.Vector128.Max (-> (Simd128 %a) (Simd128 %a) (Simd128 %a))))
  (v128-sqrt (: System.Runtime.Intrinsics.Vector128.Sqrt (-> (Simd128 %a) (Simd128 %a))))
  (v128-and (: System.Runtime.Intrinsics.Vector128.BitwiseAnd (-> (Simd128 %a) (Simd128 %a) (Simd128 %a))))
  (v128-or (: System.Runtime.Intrinsics.Vector128.BitwiseOr (-> (Simd128 %a) (Simd128 %a) (Simd128 %a))))
  (v128-xor (: System.Runtime.Intrinsics.Vector128.Xor (-> (Simd128 %a) (Simd128 %a) (Simd128 %a))))
  (v128-not (: System.Runtime.Intrinsics.Vector128.OnesComplement (-> (Simd128 %a) (Simd128 %a))))
  (v128-and-not (: System.Runtime.Intrinsics.Vector128.AndNot (-> (Simd128 %a) (Simd128 %a) (Simd128 %a))))
  (v128-eq (: System.Runtime.Intrinsics.Vector128.Equals (-> (Simd128 %a) (Simd128 %a) (Simd128 %a))))
  (v128-lt (: System.Runtime.Intrinsics.Vector128.LessThan (-> (Simd128 %a) (Simd128 %a) (Simd128 %a))))
  (v128-le (: System.Runtime.Intrinsics.Vector128.LessThanOrEqual (-> (Simd128 %a) (Simd128 %a) (Simd128 %a))))
  (v128-gt (: System.Runtime.Intrinsics.Vector128.GreaterThan (-> (Simd128 %a) (Simd128 %a) (Simd128 %a))))
  (v128-ge (: System.Runtime.Intrinsics.Vector128.GreaterThanOrEqual (-> (Simd128 %a) (Simd128 %a) (Simd128 %a))))
  (v128-nan? (: System.Runtime.Intrinsics.Vector128.IsNaN (-> (Simd128 %a) (Simd128 %a))))
  (v128-select (: System.Runtime.Intrinsics.Vector128.ConditionalSelect (-> (Simd128 %a) (Simd128 %a) (Simd128 %a) (Simd128 %a))))
  (v128-sum (: System.Runtime.Intrinsics.Vector128.Sum (-> (Simd128 %a) %a)))
  (v128-dot (: System.Runtime.Intrinsics.Vector128.Dot (-> (Simd128 %a) (Simd128 %a) %a)))
  (v128-ref (: System.Runtime.Intrinsics.Vector128.GetElement (-> (Simd128 %a) int %a)))
  (v128-with (: System.Runtime.Intrinsics.Vector128.WithElement (-> (Simd128 %a) int %a (Simd128 %a))))
  (v128-store! (: System.Runtime.Intrinsics.Vector128.CopyTo (-> (Simd128 %a) (Array %a) int void)))
  (v128-add-saturating (: System.Runtime.Intrinsics.Vector128.AddSaturate (-> (Simd128 %a) (Simd128 %a) (Simd128 %a))))
  (v128-sub-saturating (: System.Runtime.Intrinsics.Vector128.SubtractSaturate (-> (Simd128 %a) (Simd128 %a) (Simd128 %a))))
  (v128-shuffle (: Bjolang.Runtime.BjoSimd.Shuffle128 (-> (Simd128 %a) (Simd128 %a) (Simd128 %a))))
  (v128-lookup (: Bjolang.Runtime.BjoSimd.Lookup128 (-> (Simd128 byte) (Simd128 %a) (Simd128 %a))))
  (v128-as (: System.Runtime.Intrinsics.Vector128.As (-> (Simd128 %a) (Simd128 %b))))
  (v128-floor (: Bjolang.Runtime.BjoSimd.Floor128 (-> (Simd128 %a) (Simd128 %a))))
  (v128-ceiling (: Bjolang.Runtime.BjoSimd.Ceiling128 (-> (Simd128 %a) (Simd128 %a))))
  (v128-round (: Bjolang.Runtime.BjoSimd.Round128 (-> (Simd128 %a) (Simd128 %a))))
  (v128-truncate (: Bjolang.Runtime.BjoSimd.Truncate128 (-> (Simd128 %a) (Simd128 %a))))
  (v128-mul-add (: Bjolang.Runtime.BjoSimd.MulAdd128 (-> (Simd128 %a) (Simd128 %a) (Simd128 %a) (Simd128 %a))))
  (v128-lanes (: Bjolang.Runtime.BjoSimd.Lanes128 (-> (Simd128 %a) int)))
  (v128-any? (: Bjolang.Runtime.BjoSimd.Any128 (-> (Simd128 %a) bool)))
  (v128-all? (: Bjolang.Runtime.BjoSimd.All128 (-> (Simd128 %a) bool)))
  (v128-count-true (: Bjolang.Runtime.BjoSimd.CountTrue128 (-> (Simd128 %a) int)))
  (v128-first-true (: Bjolang.Runtime.BjoSimd.FirstTrue128 (-> (Simd128 %a) int)))
  (v128-splat (: System.Runtime.Intrinsics.Vector128.Create (-> %a (Simd128 %a))))
  (v128-zero (: Bjolang.Runtime.BjoSimd.Zero128 (-> (Simd128 %a))))
  (v128-mask-bits (: Bjolang.Runtime.BjoSimd.MaskBits128 (-> (Simd128 %a) int)))
  (v128-shift-left (: Bjolang.Runtime.BjoSimd.ShiftLeft128 (-> (Simd128 %a) int (Simd128 %a))))
  (v128-shift-right (: Bjolang.Runtime.BjoSimd.ShiftRight128 (-> (Simd128 %a) int (Simd128 %a))))
  (v128-shift-right-logical (: Bjolang.Runtime.BjoSimd.ShiftRightLogical128 (-> (Simd128 %a) int (Simd128 %a))))
  (v128-load-array (: System.Runtime.Intrinsics.Vector128.Create (-> (Array %a) int (Simd128 %a))))
  (v128-load-list (: Bjolang.Runtime.BjoSimd.LoadList128 (-> (MutableVec %a) int (Simd128 %a))))
  (v128-array-lanes (: Bjolang.Runtime.BjoSimd.ArrayLanes128 (-> (Array %a) int)))
  (v128-list-lanes (: Bjolang.Runtime.BjoSimd.ListLanes128 (-> (MutableVec %a) int)))
  (simd128-accelerated? (: System.Runtime.Intrinsics.Vector128.IsHardwareAccelerated #:get)))

(: (-> %a (Simd128 %a)) (where (Lane %a)))
(defun (simd128-splat x) (v128-splat x))

(: (-> (Simd128 %a)) (where (Lane %a)))
(defun (simd128-zero) (v128-zero))

;; The vector a mask holds, and the mask of a vector of a comparison's lanes.
(: (-> (Simd128 %a) (Mask128 %a)))
(defun (m128 v) (Mask128 (lanes v)))

(: (-> (Mask128 %a) (Simd128 %a)))
(defun (lanes128 m) (record-ref m lanes))

(impl (Simd (Simd128 %a)) (where (Lane %a))
  (type %elem %a)
  (type %mask (Mask128 %a))
  (defun (simd-add a b) (v128-add a b))
  (defun (simd-sub a b) (v128-sub a b))
  (defun (simd-mul a b) (v128-mul a b))
  (defun (simd-scale a b) (v128-scale a b))
  (defun (simd-neg a) (v128-neg a))
  (defun (simd-abs a) (v128-abs a))
  (defun (simd-min a b) (v128-min a b))
  (defun (simd-max a b) (v128-max a b))
  (defun (simd-eq a b) (m128 (v128-eq a b)))
  (defun (simd-ne a b) (m128 (v128-not (v128-eq a b))))
  (defun (simd-lt a b) (m128 (v128-lt a b)))
  (defun (simd-le a b) (m128 (v128-le a b)))
  (defun (simd-gt a b) (m128 (v128-gt a b)))
  (defun (simd-ge a b) (m128 (v128-ge a b)))
  (defun (simd-select m a b) (v128-select (lanes128 m) a b))
  (defun (simd-sum a) (v128-sum a))
  (defun (simd-dot a b) (v128-dot a b))
  (defun (simd-ref a i) (v128-ref a i))
  (defun (simd-with a i x) (v128-with a i x))
  (defun (simd-store! a b c) (v128-store! a b c))
  (defun (simd-lanes a) (v128-lanes a)))

(impl (SimdBitwise (Simd128 %a)) (where (Lane %a))
  (defun (simd-and a b) (v128-and a b))
  (defun (simd-or a b) (v128-or a b))
  (defun (simd-xor a b) (v128-xor a b))
  (defun (simd-not a) (v128-not a))
  (defun (simd-and-not a b) (v128-and-not a b)))

(impl (SimdBitwise (Mask128 %a)) (where (Lane %a))
  (defun (simd-and a b) (m128 (v128-and (lanes128 a) (lanes128 b))))
  (defun (simd-or a b) (m128 (v128-or (lanes128 a) (lanes128 b))))
  (defun (simd-xor a b) (m128 (v128-xor (lanes128 a) (lanes128 b))))
  (defun (simd-not a) (m128 (v128-not (lanes128 a))))
  (defun (simd-and-not a b) (m128 (v128-and-not (lanes128 a) (lanes128 b)))))

(impl (SimdMask (Mask128 %a)) (where (Lane %a))
  (type %vec (Simd128 %a))
  (defun (simd-any? m) (v128-any? (lanes128 m)))
  (defun (simd-all? m) (v128-all? (lanes128 m)))
  (defun (simd-count-true m) (v128-count-true (lanes128 m)))
  (defun (simd-first-true m) (v128-first-true (lanes128 m)))
  (defun (simd-mask-bits m) (v128-mask-bits (lanes128 m)))
  (defun (simd-mask->lanes m) (lanes128 m)))

(impl (SimdFloat (Simd128 %a)) (where (FloatLane %a))
  (type %mask (Mask128 %a))
  (defun (simd-div a b) (v128-div a b))
  (defun (simd-sqrt a) (v128-sqrt a))
  (defun (simd-floor a) (v128-floor a))
  (defun (simd-ceiling a) (v128-ceiling a))
  (defun (simd-round a) (v128-round a))
  (defun (simd-truncate a) (v128-truncate a))
  (defun (simd-nan? a) (m128 (v128-nan? a)))
  (defun (simd-mul-add a b c) (v128-mul-add a b c)))

(impl (SimdInt (Simd128 %a)) (where (IntLane %a))
  (defun (simd-shift-left a n) (v128-shift-left a n))
  (defun (simd-shift-right a n) (v128-shift-right a n))
  (defun (simd-shift-right-logical a n) (v128-shift-right-logical a n))
  (defun (simd-add-saturating a b) (v128-add-saturating a b))
  (defun (simd-sub-saturating a b) (v128-sub-saturating a b))
  (defun (simd-shuffle v idx) (v128-shuffle v idx)))

(impl (SimdLookup (Simd128 %a)) (where (ByteLane %a))
  (defun (simd-lookup table idx) (v128-lookup table idx)))

(impl (SimdBits (Simd128 %a)) (where (Lane %a))
  (type %int8 (Simd128 System.SByte))
  (type %uint8 (Simd128 byte))
  (type %int16 (Simd128 short))
  (type %uint16 (Simd128 ushort))
  (type %int32 (Simd128 int))
  (type %uint32 (Simd128 uint))
  (type %int64 (Simd128 long))
  (type %uint64 (Simd128 ulong))
  (type %float32 (Simd128 System.Single))
  (type %float64 (Simd128 double))
  (defun (simd-bits->int8 v) (v128-as v))
  (defun (simd-bits->uint8 v) (v128-as v))
  (defun (simd-bits->int16 v) (v128-as v))
