;; A keyword selects one alternative. Two alternatives with the same keyword
;; can not be told apart, so the compiler refuses the grammar.
;; EXPECT-ERROR: can both start with (from ...)
(import (std prelude))

(def/grammar Q
  (:or (: CFrom (from symbol))
       (: CInto (from string))
       (: CPlain (symbol ...))))

(defun (main args) 0)
