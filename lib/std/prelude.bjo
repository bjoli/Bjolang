;; std/prelude.bjo, the module (std prelude): what every program gets without
;; an import.
;; - All of (std prelude core), (std prelude bytestring), (std prelude path),
;;   (std eq), (std unicode chars) and (std core-macros), re-exported.
;; - Ports, files, paths, directories and the process environment.
;; - The Diagnostics and getenv effects, the clock and durations.
;; - Cancellation scopes, the dynamic environment and select.
;; Macros defined here cannot be used in this file. Those of
;; (std prelude core) and (std core-macros), such as cond, can.
(export
  FsError fs-error-of fs-error-path fs-error-exception fs-error-message
  file-read-text file-write-text file-append-text file-exists?
  file-delete file-move file-info file-copy file-read-bytes file-write-bytes
  file-append-bytes file-read-lines file-write-lines file-read/seq
  file-read-lines/seq path-absolute path-combine path-filename
  path-file-extension directory-exists? directory-create directory-delete
  directory-delete-tree directory-files directory-subdirectories
  directory-walk get-environment-variable set-environment-variable!
  current-directory set-current-directory! open-input-file open-input-string
  open-output-file open-output-string close-input-port close-output-port
  flush-port open-input-file/raw open-output-file/raw WriteMode
  call-with-input-file call-with-output-file FsKind FsInfo FsEntry MoveMode
  open-read-stream op/open-read-stream open-read-stream/raw open-write-stream
  op/open-write-stream open-write-stream/raw fs-info op/fs-info fs-info/raw
  fs-list op/fs-list fs-list/raw fs-create-directory op/fs-create-directory
  fs-create-directory/raw fs-delete-file op/fs-delete-file fs-delete-file/raw
  fs-delete-directory op/fs-delete-directory fs-delete-directory/raw fs-move
  op/fs-move fs-move/raw port-eof? read-line read-line/opt LineMode read-char
  read-char/opt peek-char peek-char/opt read-all port-fold write-string
  write-char writeln get-output-string get-output-bytes Duration
  ticks->duration duration-ticks milliseconds seconds minutes hours timeout
  duration->timer-ms warn op/warn log op/log getenv op/getenv Clock make-clock
  system-clock current-clock monotonic-ms monotonic-ns DynamicEnvironment
  current-dynamic-environment call-with-dynamic-environment promise-join/sync)

(import (std prelude core))
(import (std unicode chars))
(import (std eq))
(import (std core-macros))
(import (std syntax-match))
(import (std prelude bytestring))
(import (std prelude path))

(re-export
  (everything-from (std prelude core))
  (everything-from (std prelude bytestring))
  (everything-from (std prelude path))
  (everything-from (std eq))
  (everything-from (std unicode chars))
  (everything-from (std core-macros)))

;; The docs: the definitions of this file and the builtins, by area. The
;; builtins are documented here because every program gets them with the
;; prelude, and their docs are published in its assembly. The docs of the
;; core's definitions are in lib/std/prelude.
(:doc #:file "prelude.bjodoc")
(:doc #:file "prelude-core.bjodoc")
(:doc #:file "prelude-seqs.bjodoc")
(:doc #:file "prelude-lists.bjodoc")
(:doc #:file "prelude-vecs.bjodoc")
(:doc #:file "prelude-strings.bjodoc")
(:doc #:file "prelude-chars.bjodoc")
(:doc #:file "prelude-files.bjodoc")
(:doc #:file "prelude-ports.bjodoc")
(:doc #:file "prelude-concurrency.bjodoc")
(:doc #:file "prelude-syntax.bjodoc")

;; --- File operations.
;;
;; Everything in this section and the directory one below reaches the disk
;; through the operations of the `FS` effect, declared with the ports further
;; down, so a fake filesystem answers for all of it.

;; How an output file is opened.
;;
;; - `Truncate`: create the file, or empty it if it exists.
;; - `Append`: create the file, or write after what it holds.
;; - `CreateNew`: create the file, and fail if it exists. The check and the
;;   create are one system call, so two writers cannot both succeed.
(type (: WriteMode (Union Truncate Append CreateNew)))

;; What a path names, when it names anything.
;;
;; - `FsFile`, `FsDirectory`: a file, a directory.
;; - `FsLink`: a symbolic link, not followed. Only a listing reports one:
;;   `fs-info` follows the link, and says `link?`.
;; - `FsOther`: a FIFO, a socket or a device. Only a listing reports one:
;;   `fs-info` reports it as `FsFile`, as .NET does.
(type (: FsKind (Union FsFile FsDirectory FsLink FsOther)))

;; One entry of a directory, as `fs-list` returns it.
;;
;; - `entry-path`: the directory joined with `entry-name`.
;; - `entry-name`: the bytes the OS gave.
;; - `entry-kind`: the entry's own kind, as the listing reported it. A symbolic
;;   link is `FsLink`, so a caller that follows links asks `fs-info`.
(type (: FsEntry (Record (: entry-path Path)
                         (: entry-name ByteString)
                         (: entry-kind FsKind))))

;; What a move does when something is already at the target.
;;
;; - `MoveNew`: fails, and changes nothing.
;; - `MoveReplace`: a file at the target is replaced, in the one rename that
;;   moves the new one there, so nothing ever sees the target missing. A
;;   directory is never replaced, whichever of the two it is.
(type (: MoveMode (Union MoveNew MoveReplace)))

;; What `(fs-info path)` answers about a path that names something. One answer
;; to one question, so that a handler cannot say a path is a file and then
;; forget to say how big it is.
;;
;; - `size`: in bytes. 0 for a directory.
;; - `modified-ms`: the last write, in Unix milliseconds, UTC. Milliseconds
;;   because `(std datetime)`'s `unix-milliseconds->instant` takes them, and
;;   the prelude cannot name an `Instant` itself.
;; - `link?`: the path itself is a symbolic link. The other fields are what
;;   .NET reports for it; `directory-walk` does not enter one, so a link back up
;;   the tree cannot loop it.
(type (: FsInfo (Record (: kind FsKind)
                        (: size long)
                        (: modified-ms long)
                        (: link? bool))))

;; Why a file system operation failed. Each case holds the path it is about
;; and the exception it was made from, which `raise-err` raises and which has
;; the OS's own message.
;;
;; - `NotFound`: no such file or directory.
;; - `AlreadyExists`: `CreateNew`, `MoveNew` or a copy found something there.
;; - `PermissionDenied`: the OS refused access.
;; - `NotEmpty`: `directory-delete` of a directory that holds something.
;; - `IsDirectory`: a directory where a file was wanted.
;; - `NotDirectory`: a file where a directory was wanted, the path to it
;;   included.
;; - `InvalidPath`: a path .NET cannot take: empty, not UTF-8 or too long.
;; - `Io`: any other failure.
;;
;; `fs-error-of` makes one from an exception. A handler of the `FS` effect
;; can use it, or make a case itself.
(type (: FsError (Union (: NotFound Path Exception)
                        (: AlreadyExists Path Exception)
                        (: PermissionDenied Path Exception)
                        (: NotEmpty Path Exception)
                        (: IsDirectory Path Exception)
                        (: NotDirectory Path Exception)
                        (: InvalidPath Path Exception)
                        (: Io Path Exception))))

;; The functions in the file and directory sections return the `Result` of the
;; `FS` operations, with an `FsError`. An `IOException` or an
;; `UnauthorizedAccessException` that the I/O raises after the file is open is
;; an `Err` too. A cancellation is raised as usual.
;;
;; `raise-err` is for a caller that wants the exception instead.

;; The `Err` of `r`, an exception, as the `FsError` for `path`.
(: (-> Path (Result Exception %a) (Result FsError %a)))
(defun (fs-result path r)
  (match r
    ((Ok v) (Ok v))
    ((Err e) (Err (fs-error-of path e)))))

;; Read all text.
(: (-> %p (Result FsError string)) (where (AsPath %p)))
(defun (file-read-text path)
  (match (open-input-file path)
    ((Ok opened)
     (fs-result (as-path path) (try (with-open ((p opened))
            (read-all p))
       #:catch (System.IO.IOException System.UnauthorizedAccessException))))
    ((Err e) (Err e))))

;; The flush is explicit so that the suspending copy awaits it. Closing would
;; flush too, but synchronously, on whatever thread runs the close.
(: (-> Path string WriteMode (Result FsError Unit)))
(defun (write-whole-file path contents mode)
  (match (open-output-file path #:mode mode)
    ((Ok opened)
     (fs-result (as-path path) (try (with-open ((p opened))
            (write-string p contents)
            (flush-port p)
            unit)
       #:catch (System.IO.IOException System.UnauthorizedAccessException))))
    ((Err e) (Err e))))

;; Write text.
(: (-> %p string (Result FsError Unit)) (where (AsPath %p)))
(defun (file-write-text path contents)
  (write-whole-file (as-path path) contents Truncate))

(: (-> %p string (Result FsError Unit)) (where (AsPath %p)))
(defun (file-append-text path contents)
  (write-whole-file (as-path path) contents Append))

(: (-> %p (Option FsInfo)) (where (AsPath %p)))
(defun (file-info path)
  (fs-info (as-path path)))

;; What a path names, for the functions below that only ask that.
(: (-> Path (Option FsKind)))
(defun (kind-of path)
  (option-map (fun (info) (record-ref info kind)) (fs-info path)))

(: (-> %p bool) (where (AsPath %p)))
(defun (file-exists? path)
  (match (kind-of (as-path path))
    ((Some FsFile) #t)
    (_ #f)))

;; A missing file is not an error, as with `File.Delete`.
(: (-> %p (Result FsError Unit)) (where (AsPath %p)))
(defun (file-delete path)
  (fs-delete-file (as-path path)))

;; Moves or renames a file or a directory. Fails if `to` exists, unless
;; `#:mode MoveReplace` says to replace a file there.
(: (-> %p %q (#:mode MoveMode) (Result FsError Unit)) (where (AsPath %p) (AsPath %q)))
(defun (file-move from to #:mode MoveNew)
  (fs-move (as-path from) (as-path to) mode))

;; --- Paths ---
;; Path strings.

(import/extern
  (clr-full-path      (: System.IO.Path.GetFullPath))
  (clr-path-combine   (: System.IO.Path.Combine))
  (clr-file-name      (: System.IO.Path.GetFileName))
  (clr-file-extension (: System.IO.Path.GetExtension)))

(: (-> %p string) (where (AsPath %p)))
(defun (path-absolute path)
  (clr-full-path (raise-err (os-path (as-path path)))))

;; Path combine.
(: (-> #:rest string string))
(defun (path-combine #:rest parts)
  (clr-path-combine parts))

;; Path filename.
(: (-> string (Option string)))
(defun (path-filename path)
  (def name (clr-file-name path))
  (if (string-empty? name)
      None
      (Some name)))

;; File extension.
(: (-> string (Option string)))
(defun (path-file-extension path)
  (def ext (clr-file-extension path))
  (if (string-empty? ext)
      None
      (Some ext)))

;; --- Directories ---

(: (-> %p bool) (where (AsPath %p)))
(defun (directory-exists? path)
  (match (kind-of (as-path path))
    ((Some FsDirectory) #t)
    (_ #f)))

;; Create directory.
(: (-> %p (Result FsError Unit)) (where (AsPath %p)))
(defun (directory-create path)
  (fs-create-directory (as-path path)))

;; Delete directory.
(: (-> %p (Result FsError Unit)) (where (AsPath %p)))
(defun (directory-delete path)
  (fs-delete-directory (as-path path)))

;; Built from the operations rather than handed to `Directory.Delete` with its
;; recursive flag, so that a handler sees every deletion.
;;
;; A symbolic link to a directory is removed as a link and never entered, and
;; that includes `path` itself. Entering one would delete what it points at: a
;; link to the home directory inside a build directory would empty the home
;; directory, and a link back up the tree would never end.
(: (-> %p (Result FsError Unit)) (where (AsPath %p)))
(defun (directory-delete-tree path)
  (delete-tree (as-path path)))

;; Stops at the first error. What was deleted before it stays deleted.
(: (-> Path (Result FsError Unit)))
(defun (delete-tree path)
  (if (directory-link? path)
      (fs-delete-directory path)
      (match (fs-list path)
        ((Ok entries)
         (match (delete-entries entries 0)
           ((Ok _) (fs-delete-directory path))
           (failed failed)))
        ((Err e) (Err e)))))

(: (-> (Vec FsEntry) int (Result FsError Unit)))
(defun (delete-entries entries i)
  (if (= i (vec-length entries))
      (Ok unit)
      (let ((entry (vec-ref entries i)))
        (match (match (record-ref entry entry-kind)
                 (FsDirectory (delete-tree (record-ref entry entry-path)))
                 ;; A link is removed, and what it leads to is kept.
                 (_ (fs-delete-file (record-ref entry entry-path))))
          ((Ok _) (delete-entries entries (+ i 1)))
          (failed failed)))))

(: (-> Path bool))
(defun (directory-link? path)
  (match (fs-info path)
    ((Some info) (and (record-ref info link?) (= (record-ref info kind) FsDirectory)))
    (None #f)))

;; The kind of an entry, with a symbolic link followed: `fs-info` is asked
;; for a link only. A link to nothing is a file, as `fs-info` says. An entry
;; gone since the listing is `None`.
(: (-> FsEntry (Option FsKind)))
(defun (followed-kind entry)
  (match (record-ref entry entry-kind)
    (FsLink (kind-of (record-ref entry entry-path)))
    (FsOther (Some FsFile))
    (k (Some k))))

;; The entries of `path` that are files, or directories, with links
;; followed.
(: (-> Path FsKind (Result FsError (Vec Path))))
(defun (entries-of-kind path kind)
  (match (fs-list path)
    ((Ok entries)
     (Ok (loop (:for entry entries)
               (:when (= (followed-kind entry) (Some kind)))
               (:acc found (vecing (record-ref entry entry-path))))))
    ((Err e) (Err e))))

(: (-> %p (Result FsError (Vec Path))) (where (AsPath %p)))
(defun (directory-files path)
  (entries-of-kind (as-path path) FsFile))

(: (-> %p (Result FsError (Vec Path))) (where (AsPath %p)))
(defun (directory-subdirectories path)
  (entries-of-kind (as-path path) FsDirectory))

;; --- The environment ---

(import/extern
  (clr-get-env      (: System.Environment.GetEnvironmentVariable))
  (clr-set-env      (: System.Environment.SetEnvironmentVariable))
  (clr-empty?       (: System.String.IsNullOrEmpty))
  (clr-cwd          (: System.Environment.CurrentDirectory #:get))
  (clr-set-cwd      (: System.Environment.CurrentDirectory #:set)))

(: (-> string (Option string)))
(defun (get-environment-variable name)
  (def value (clr-get-env name))
  (if (clr-empty? value)
      None
      (Some value)))

;; Set environment variable.
(: (-> string string void))
(defun (set-environment-variable! name value)
  (clr-set-env name value))

(: (-> string))
(defun (current-directory)
  clr-cwd)

(: (-> %p void) (where (AsPath %p)))
(defun (set-current-directory! path)
  (clr-set-cwd (raise-err (os-path (as-path path)))))

;; ---------------------------------------------------------------------------
;; Ports
;; ---------------------------------------------------------------------------

(import/class
  ;; What the `FS` effect's openers answer, and what a file port is over.
  (ClrStream (: System.IO.Stream))
  ;; `IOException` covers `CreateNew` finding the file already there, as well
  ;; as the not-found exceptions below it. `ArgumentException` is the empty
  ;; path.
  (FileStream (: System.IO.FileStream (-> string FileMode FileAccess FileShare FileStream)
                 #:exceptions (System.IO.IOException
                               System.UnauthorizedAccessException
                               System.ArgumentException)))
  (FileMode (: System.IO.FileMode))
  (FileAccess (: System.IO.FileAccess))
  (FileShare (: System.IO.FileShare)))

;; Port types.
;;
;; What ends a line: Racket's `read-line` modes. `Any` is the default
;; everywhere a line is read.
(type (: LineMode (Union Any AnyOne Linefeed Return ReturnLinefeed)))

;; --- Opening ---
;;
;; A file port is owned by the ambient scope: when the scope returns, the file
;; is closed, whether the program said so or not. A string port is not - it is
;; memory, and the GC prices memory.
;;
;; The scope is read before the file is opened, so a program with no scope to
;; put the port in fails without having opened anything.

(import/extern
  ;; A port over a stream, registered on the ambient scope.
  (owned-port-over (: Bjolang.Runtime.BytePorts.FromStream (-> ClrStream InputPort)))
  (string-port  (: Bjolang.Runtime.InputPorts.FromString (-> string InputPort)))
  (owned-port-out (: Bjolang.Runtime.OutputPorts.FromStream (-> ClrStream OutputPort)))
  (string-port-out (: Bjolang.Runtime.OutputPorts.OpenString (-> OutputPort)))
  (output-bytes (: Bjolang.Runtime.OutputPorts.GetBytes (-> OutputPort (Array byte))))
  (close-in     (: BjolangRuntime.CloseInput  (-> InputPort void)))
  (close-out    (: BjolangRuntime.CloseOutput (-> OutputPort void)))
  (close-out-await (: BjolangRuntime.CloseOutputAsync (-> OutputPort void) #:async)))

;; An input port over a stream an opener answered, registered on the ambient
;; scope. Whatever the stream is - a file, or a `MemoryStream` a fake
;; filesystem made - the port is owned the same way.
(: (-> (Result FsError ClrStream) (Result FsError InputPort)))
(defun (stream->input-port opened)
  (match opened
    ((Ok s) (Ok (owned-port-over s)))
    ((Err e) (Err e))))

;; The same for an output port: a file port is buffered a block at a time, and
;; closing it, or its scope ending, writes what is left.
(: (-> (Result FsError ClrStream) (Result FsError OutputPort)))
(defun (stream->output-port opened)
  (match opened
    ((Ok s) (Ok (owned-port-out s)))
    ((Err e) (Err e))))

;; Open input string: a port over the string's own UTF-8 bytes, shared rather
;; than copied. Memory only, so nothing registers it.
(: (-> string InputPort))
(defun (open-input-string contents)
  (string-port contents))

;; Open output string: a port that keeps what is written to it, read back with
;; `get-output-string` or `get-output-bytes`. Memory only, so nothing
;; registers it.
(: (-> OutputPort))
(defun (open-output-string)
  (string-port-out))

;; --- Closing ---
;;
;; Closing goes through the owner handle rather than calling `.Dispose`. A
;; direct dispose would close the stream and leave the registration on the
;; scope's list, so a long-lived scope would collect one spent entry per file it
;; had already finished with.
;;
;; On a port nothing owns this disposes, which is what a string port wants. On
;; one of the standard ports it flushes and stops: nothing in the language
;; should be able to take stdout away from the rest of the program.
(: (-> InputPort void))
(defun (close-input-port p)
  (close-in p))

;; What is still buffered goes out first. On a fiber that write suspends, so the
;; close works over a stream that refuses blocking I/O, as Kestrel's do; the
;; port is closed even when the write fails, and the failure raised after.
;; `with-open` and a scope ending close with a blocking write, which after a
;; `flush-port` has nothing left to do.
(: (-> OutputPort void))
(defbjouble (close-output-port p)
  (#:sync (close-out p))
  (#:bjo (close-out-await p)))

;; --- The filesystem is an effect ---
;;
;; All filesystem operations route through the `FS` algebraic effect, allowing
;; callers to intercept disk operations (e.g., in-memory mocks for tests, sandbox
;; write restrictions, or build dependency tracking). When unhandled, operations
;; fall back to their `/raw` defaults using standard .NET calls.
;;
;; Design:
;; - Openers return raw `ClrStream`s rather than ports. Higher-level functions
;;   (like `open-input-file` or `(std ports)` byte openers) construct ports and
;;   register them in the ambient scope, allowing mock handlers to work uniformly
;;   across text and byte I/O.
;; - Effect operations are synchronous; coroutine suspension occurs only when reading
;;   or writing through the underlying streams/ports.
;; - Effect operations return `(Result FsError %a)` values, and so do the
;;   prelude's file and directory functions over them.

(type (: FsListed Bjolang.Runtime.FsListed))

(import/class
  (DirectoryInfo (: System.IO.DirectoryInfo (-> string DirectoryInfo)))
  (FileInfo (: System.IO.FileInfo (-> string FileInfo))))

(import/extern
  (clr-dir-exists  (: System.IO.Directory.Exists (-> string bool)))
  (clr-file-exists (: System.IO.File.Exists (-> string bool)))
  (clr-list        (: Bjolang.Runtime.FsListing.List (-> (Array byte) (Array FsListed))
                      #:exceptions (System.IO.IOException System.UnauthorizedAccessException
                                   System.ArgumentException)))
  (clr-listed-name (: Bjolang.Runtime.FsListed.Name (-> FsListed (Array byte)) #:get))
  (clr-listed-kind (: Bjolang.Runtime.FsListed.Kind (-> FsListed int) #:get))
  (clr-classify    (: Bjolang.Runtime.FsListing.Classify (-> FileInfo int)))
  (clr-dir-create  (: System.IO.Directory.CreateDirectory (-> string DirectoryInfo)
                      #:exceptions (System.IO.IOException System.UnauthorizedAccessException
                                   System.ArgumentException)))
  (clr-file-delete (: System.IO.File.Delete (-> string void)
                      #:exceptions (System.IO.IOException System.UnauthorizedAccessException
                                   System.ArgumentException)))
  (clr-dir-delete  (: System.IO.Directory.Delete (-> string void)
                      #:exceptions (System.IO.IOException System.UnauthorizedAccessException
                                   System.ArgumentException)))
  (clr-file-move   (: System.IO.File.Move (-> string string bool void)
                      #:exceptions (System.IO.IOException System.UnauthorizedAccessException
                                   System.ArgumentException)))
  (clr-dir-move    (: System.IO.Directory.Move (-> string string void)
                      #:exceptions (System.IO.IOException System.UnauthorizedAccessException
                                   System.ArgumentException))))

(import/class
  (ArgumentException (: System.ArgumentException (-> string ArgumentException))))

;; The `FsError` for exception `e` of an operation on `path`.
;;
;; - The type of `e` decides first: `FileNotFoundException`,
;;   `DirectoryNotFoundException`, `PathTooLongException`,
;;   `UnauthorizedAccessException`, `ArgumentException`.
;; - A `DirectoryNotFoundException` is `NotDirectory` when `path`, or the
;;   nearest ancestor of `path` that exists, is a file.
;; - An `UnauthorizedAccessException` is `IsDirectory` when `path` is a
;;   directory. .NET raises it to open or delete a directory as a file.
;; - For another `IOException`, the `HResult` decides. On Windows it is
;;   `0x8007xxxx` with a Win32 error code. On Unix it is the `errno`; the codes
;;   of both Linux and macOS are accepted.
;; - Any other exception is `Io`.
(: (-> Path Exception FsError))
(defun (fs-error-of path e)
  (match e
    ((:is System.IO.FileNotFoundException) (NotFound path e))
    ((:is System.IO.DirectoryNotFoundException)
     (if (ancestor-is-file? path) (NotDirectory path e) (NotFound path e)))
    ((:is System.IO.PathTooLongException) (InvalidPath path e))
    ((:is System.UnauthorizedAccessException)
     (if (is-os-directory? path) (IsDirectory path e) (PermissionDenied path e)))
    ((:is System.ArgumentException) (InvalidPath path e))
    ((:is System.IO.IOException) (fs-error-of-code path e (.-HResult e)))
    (_ (Io path e))))

;; Win32 codes in the low 16 bits of `0x8007xxxx`, else `errno` values.
(: (-> Path Exception int FsError))
(defun (fs-error-of-code path e code)
  (cond
    ((= (bitwise-and code -65536) -2147024896)
     (match (bitwise-and code 0xFFFF)
       (2 (NotFound path e))
       (3 (NotFound path e))
       (5 (PermissionDenied path e))
       (80 (AlreadyExists path e))
       (183 (AlreadyExists path e))
       (145 (NotEmpty path e))
       (267 (NotDirectory path e))
       (123 (InvalidPath path e))
       (206 (InvalidPath path e))
       (_ (Io path e))))
    (else
     (match code
       (1 (PermissionDenied path e))
       (2 (NotFound path e))
       (13 (PermissionDenied path e))
       (17 (AlreadyExists path e))
       (20 (NotDirectory path e))
       (21 (IsDirectory path e))
       ;; ENAMETOOLONG: 36 on Linux, 63 on macOS and BSD.
       (36 (InvalidPath path e))
       (63 (InvalidPath path e))
       ;; ENOTEMPTY: 39 on Linux, 66 on macOS and BSD.
       (39 (NotEmpty path e))
       (66 (NotEmpty path e))
       (_ (Io path e))))))

(: (-> Path bool))
(defun (is-os-directory? p)
  (match (path->string p)
    ((Ok name) (clr-dir-exists name))
    ((Err _) #f)))

;; Whether `p`, or else the nearest ancestor of `p` that exists, is a file.
(: (-> Path bool))
(defun (ancestor-is-file? p)
  (match (path->string p)
    ((Err _) #f)
    ((Ok name)
     (cond
       ((clr-file-exists name) #t)
       ((clr-dir-exists name) #f)
       ((= name "") #f)
       (else (match (path-parent p)
               (None #f)
               ((Some parent) (ancestor-is-file? parent))))))))

(: (-> FsError Path))
(defun (fs-error-path e)
  (match e
    ((NotFound p _) p)
    ((AlreadyExists p _) p)
    ((PermissionDenied p _) p)
    ((NotEmpty p _) p)
    ((IsDirectory p _) p)
    ((NotDirectory p _) p)
    ((InvalidPath p _) p)
    ((Io p _) p)))

(: (-> FsError Exception))
(defun (fs-error-exception e)
  (match e
    ((NotFound _ x) x)
    ((AlreadyExists _ x) x)
    ((PermissionDenied _ x) x)
    ((NotEmpty _ x) x)
    ((IsDirectory _ x) x)
    ((NotDirectory _ x) x)
    ((InvalidPath _ x) x)
    ((Io _ x) x)))

;; The kind of error, the path and the exception's message.
(: (-> FsError string))
(defun (fs-error-message e)
  (def kind (match e
              ((NotFound _ _) "not found")
              ((AlreadyExists _ _) "already exists")
              ((PermissionDenied _ _) "permission denied")
              ((NotEmpty _ _) "directory not empty")
              ((IsDirectory _ _) "is a directory")
              ((NotDirectory _ _) "not a directory")
              ((InvalidPath _ _) "invalid path")
              ((Io _ _) "I/O error")))
  #"${kind}: ${(path->string/lossy (fs-error-path e))}: ${(.-Message (fs-error-exception e))}")

(impl (AsException FsError)
  (defun (as-exception e) (fs-error-exception e)))

;; The name of a path as the .NET file functions take it.
;;
;; - .NET file names are UTF-16 strings. On Unix, .NET encodes them as UTF-8.
;; - A path that is not UTF-8 has no such string, so the result is an
;;   `ArgumentException`. The name is not changed to a different one.
(: (-> Path (Result FsError string)))
(defun (os-path p)
  (match (path->string p)
    ((Ok s) (Ok s))
    ((Err e)
     (Err
      (InvalidPath
       p
       (cast
        Exception
        (ArgumentException.
         #"the path ${(path->string/lossy p)} cannot be given to .NET: ${(decode-error-message e)}")))))))

;; `(f name)` with the .NET name of `p`, or the error of `os-path`. An
;; exception in the `Err` of `f` is made an `FsError` for `p`.
(: (-> Path (-> string (Result Exception %a)) (Result FsError %a)))
(defun (with-os-path p f)
  (match (os-path p)
    ((Ok name) (fs-result p (f name)))
    ((Err e) (Err e))))

;; Read-only, and other readers allowed alongside, as `StreamReader`'s own
;; path constructor opens.
(: (-> Path (Result FsError ClrStream)))
(defun (open-read-stream/raw path)
  (with-os-path path (fun (name)
                       (match (FileStream. name FileMode.Open FileAccess.Read FileShare.Read)
                         ((Ok s) (Ok (cast ClrStream s)))
                         ((Err e) (Err e))))))

(: (-> WriteMode FileMode))
(defun (write-mode->file-mode mode)
  (match mode
    (Truncate FileMode.Create)
    (Append FileMode.Append)
    (CreateNew FileMode.CreateNew)))

;; Write-only, readers allowed alongside, as `StreamWriter`'s path constructor
;; opens.
(: (-> Path WriteMode (Result FsError ClrStream)))
(defun (open-write-stream/raw path mode)
  (with-os-path path
    (fun (name)
      (match (FileStream. name (write-mode->file-mode mode) FileAccess.Write FileShare.Read)
        ((Ok s) (Ok (cast ClrStream s)))
        ((Err e) (Err e))))))

;; .NET ticks at 1970-01-01T00:00Z, and per millisecond.
(: long)
(def unix-epoch-ticks 621355968000000000L)

;; Rounds toward the past, so a write just before 1970 is -1 and not 0.
(: (-> long long))
(defun (ticks->unix-ms ticks)
  (def d (- ticks unix-epoch-ticks))
  (def q (/ d 10000L))
  (if (< (% d 10000L) 0L)
      (- q 1L)
      q))

;; Where a chain of symbolic links ends: `path` itself when it is no link. A
;; link's target is relative to the directory the link is in. At most 40
;; steps, as Linux allows, so that a loop of links ends. Read step by step
;; because `ResolveLinkTarget` answers null for a link to nothing, and there is
;; no null to test here.
(: (-> string string))
(defun (link-end path)
  (let loop ((p path)
             (steps 0))
    (def target (.-LinkTarget (FileInfo. p)))
    (if (or (clr-empty? target) (= steps 40))
        p
        (loop (match (path-directory p)
                ((Some dir) (path-combine dir target))
                (None target))
              (+ steps 1)))))

;; What `path` names, following symbolic links.
;;
;; - One `FileInfo` reads the path once, on its first property: an `lstat`,
;;   and a `stat` more for a link. Size and time come from the same read,
;;   so they agree with each other.
;; - A link's size and time are those of the end of its chain of links,
;;   which is what reading it reads. `link?` says that it is one. A link to
;;   nothing is a file, and keeps its own size and time.
;; - The empty path is `None`: the `FileInfo` constructor raises for it.
(: (-> string (Option FsInfo)))
(defun (os-info path)
  (if (string-empty? path)
      None
      (let ((own (FileInfo. path)))
        (def class (clr-classify own))
        (cond
          ((< class 0) None)
          ((>= class 4)
           (def end (FileInfo. (link-end path)))
           (def end-class (clr-classify end))
           (if (or (< end-class 0) (>= end-class 4))
               (info-of own 0 #t)
               (info-of end end-class #t)))
          (else (info-of own class #f))))))

;; The info of `f`, whose kind `clr-classify` gave as `class`, 0 or 1.
(: (-> FileInfo int bool (Option FsInfo)))
(defun (info-of f class link)
  (def directory (= class 1))
  (Some (FsInfo (kind (if directory FsDirectory FsFile))
                (size (if directory
                          0L
                          (.-Length f)))
                (modified-ms (ticks->unix-ms (.-Ticks (.-LastWriteTimeUtc f))))
                (link? link))))

;; Raises the `ArgumentException` of `os-path` for a path that is not UTF-8,
;; because `None` would say that nothing is there.
(: (-> Path (Option FsInfo)))
(defun (fs-info/raw path)
  (os-info (raise-err (os-path path))))

;; The entries of a directory, in the order the OS gives them, with the
;; kinds the listing reports. On Linux, the path and the names are bytes,
;; so a name that is not UTF-8 is listed as it is, and no entry is asked
;; about. See `Bjolang.Runtime.FsListing`.
(: (-> Path (Result FsError (Vec FsEntry))))
(defun (fs-list/raw path)
  (match (fs-result path (clr-list (bytestring->bytes (path->bytestring path))))
    ((Ok listed)
     (Ok (loop (:for l listed)
               (:let name (bytes->bytestring (clr-listed-name l)))
               (:acc found (vecing (FsEntry (entry-path (path-join path name))
                                            (entry-name name)
                                            (entry-kind (listed-kind (clr-listed-kind l)))))))))
    ((Err e) (Err e))))

(: (-> int FsKind))
(defun (listed-kind k)
  (cond
    ((= k 0) FsFile)
    ((= k 1) FsDirectory)
    ((= k 2) FsLink)
    (else FsOther)))

;; Creates every missing directory along the path. One that is already there is
;; not an error.
(: (-> Path (Result FsError Unit)))
(defun (fs-create-directory/raw path)
  (with-os-path path (fun (name)
                       (match (clr-dir-create name)
                         ((Ok _) (Ok unit))
                         ((Err e) (Err e))))))

;; What a guarded `void` call answers, as the `Unit` an operation declares.
(: (-> (Result Exception %a) (Result Exception Unit)))
(defun (unit-result r)
  (match r
    ((Ok _) (Ok unit))
    ((Err e) (Err e))))

;; A missing file is not an error.
(: (-> Path (Result FsError Unit)))
(defun (fs-delete-file/raw path)
  (with-os-path path (fun (name) (unit-result (clr-file-delete name)))))

;; An empty directory. A missing or non-empty one is an `IOException`.
(: (-> Path (Result FsError Unit)))
(defun (fs-delete-directory/raw path)
  (with-os-path path (fun (name) (unit-result (clr-dir-delete name)))))

;; A file or a directory. Fails if `to` exists, unless `MoveReplace` asks to
;; replace a file there. `Directory.Move` never replaces, which is the rule.
;;
;; The error is about `from` when `from` is missing, and about `to` otherwise.
;; `Directory.Move` onto a path that exists raises a plain `IOException`, so
;; that is `AlreadyExists` when something is at `to`.
(: (-> Path Path MoveMode (Result FsError Unit)))
(defun (fs-move/raw from to mode)
  (match (os-path from)
    ((Err e) (Err e))
    ((Ok from-name)
     (match (os-path to)
       ((Err e) (Err e))
       ((Ok to-name)
        (match (unit-result (if (clr-dir-exists from-name)
                                (clr-dir-move from-name to-name)
                                (clr-file-move from-name
                                               to-name
                                               (match mode
                                                 (MoveNew #f)
                                                 (MoveReplace #t)))))
          ((Ok _) (Ok unit))
          ((Err e)
           (Err (cond
                  ((not (or (clr-file-exists from-name) (clr-dir-exists from-name)))
                   (fs-error-of from e))
                  ((or (clr-file-exists to-name) (clr-dir-exists to-name))
                   (match (fs-error-of to e)
                     ((Io p x) (AlreadyExists p x))
                     (other other)))
                  (else (fs-error-of to e)))))))))))

(defeffect FS
  (open-read-stream    (-> Path (Result FsError ClrStream)))
  (open-write-stream   (-> Path WriteMode (Result FsError ClrStream)))
  (fs-info             (-> Path (Option FsInfo)))
  (fs-list             (-> Path (Result FsError (Vec FsEntry))))
  (fs-create-directory (-> Path (Result FsError Unit)))
  (fs-delete-file      (-> Path (Result FsError Unit)))
  (fs-delete-directory (-> Path (Result FsError Unit)))
  (fs-move             (-> Path Path MoveMode (Result FsError Unit)))
  #:default ((open-read-stream open-read-stream/raw)
             (open-write-stream open-write-stream/raw)
             (fs-info fs-info/raw)
             (fs-list fs-list/raw)
             (fs-create-directory fs-create-directory/raw)
             (fs-delete-file fs-delete-file/raw)
             (fs-delete-directory fs-delete-directory/raw)
             (fs-move fs-move/raw))
  #:cold (open-read-stream open-write-stream fs-info fs-list
          fs-create-directory fs-delete-file fs-delete-directory fs-move))

;; --- Opening a file port ---
;;
;; The scope is read before the perform, so a program with nowhere to put the
;; port fails without having opened anything.

(: (-> %p (Result FsError InputPort)) (where (AsPath %p)))
(defun (open-input-file path)
  (ignore (current-scope))
  (stream->input-port (open-read-stream (as-path path))))

;; `(open-output-file path)` truncates; `#:mode Append` or `#:mode CreateNew`
;; says otherwise.
(: (-> %p (#:mode WriteMode) (Result FsError OutputPort)) (where (AsPath %p)))
(defun (open-output-file path #:mode Truncate)
  (ignore (current-scope))
  (stream->output-port (open-write-stream (as-path path) mode)))

;; The same, past whatever handler is installed. The `/raw` says so.
(: (-> %p (Result FsError InputPort)) (where (AsPath %p)))
(defun (open-input-file/raw path)
  (ignore (current-scope))
  (stream->input-port (open-read-stream/raw (as-path path))))

(: (-> %p WriteMode (Result FsError OutputPort)) (where (AsPath %p)))
(defun (open-output-file/raw path mode)
  (ignore (current-scope))
  (stream->output-port (open-write-stream/raw (as-path path) mode)))

;; Opens a file, passes the open port to `proc`, and guarantees port closure
;; on normal return or exception via `with-open`.
;;
;; Unlike `with-scope`, `with-open` avoids allocating a new fiber scope, allowing
;; synchronous functions to call it without requiring a coroutine context.
;;
;; `proc` is suspension-polymorphic (`-?->`): both synchronous and async/suspending
;; variants are compiled, ensuring suspending bodies receive identical cleanup.
(: (-> %p (-?-> InputPort %a) (Result FsError %a)) (where (AsPath %p)))
(defun (call-with-input-file path proc)
  (match (open-input-file path)
    ((Ok p)
     (with-open ((it p))
       (Ok (proc it))))
    ((Err e) (Err e))))

(: (-> %p (-?-> OutputPort %a) (#:mode WriteMode) (Result FsError %a)) (where (AsPath %p)))
(defun (call-with-output-file path proc #:mode Truncate)
  (match (open-output-file path #:mode mode)
    ((Ok p)
     (with-open ((it p))
       (Ok (proc it))))
    ((Err e) (Err e))))

;; --- Bytes, copies and lines ---
;;
;; Because the prelude has no byte port type, byte I/O and file copying operate
;; directly on `ClrStream`s returned by the `FS` effect openers (`open-read-stream`
;; and `open-write-stream`).
;;
;; Like the text port functions, these helpers provide both sync and suspending
;; (async) variants backed by the streams' async methods. When used in `with-open`,
;; a stream is explicitly flushed before exiting so pending writes are awaited
;; asynchronously rather than blocking during synchronous disposal.

(import/class
  (MemoryStream (: System.IO.MemoryStream (-> MemoryStream)))
  (IOException (: System.IO.IOException (-> string IOException))))

(import/extern
  (clr-copy-to            (: System.IO.Stream.CopyTo      (-> ClrStream ClrStream void) #:blocking))
  (clr-copy-to-await      (: System.IO.Stream.CopyToAsync (-> ClrStream ClrStream void) #:async))
  (clr-stream-write       (: System.IO.Stream.Write       (-> ClrStream (Array byte) int int void) #:blocking))
  (clr-stream-write-await (: System.IO.Stream.WriteAsync  (-> ClrStream (Array byte) int int void) #:async))
  (clr-stream-flush       (: System.IO.Stream.Flush       (-> ClrStream void) #:blocking))
  (clr-stream-flush-await (: System.IO.Stream.FlushAsync  (-> ClrStream void) #:async)))

(: (-> ClrStream ClrStream void))
(defbjouble (stream-copy! from to)
  (#:sync (clr-copy-to from to))
  (#:bjo (clr-copy-to-await from to)))

(: (-> ClrStream (Array byte) void))
(defbjouble (stream-write! s bytes)
  (#:sync (clr-stream-write s bytes 0 (array-length bytes)))
  (#:bjo (clr-stream-write-await s bytes 0 (array-length bytes))))

(: (-> ClrStream void))
(defbjouble (stream-flush! s)
  (#:sync (clr-stream-flush s))
  (#:bjo (clr-stream-flush-await s)))

(import/extern
  (clr-stream-read       (: System.IO.Stream.Read      (-> ClrStream (Array byte) int int int) #:blocking))
  (clr-stream-read-await (: System.IO.Stream.ReadAsync (-> ClrStream (Array byte) int int int) #:async))
  (clr-stream-length     (: System.IO.Stream.Length (-> ClrStream long) #:get))
  (clr-new-guid          (: System.Guid.NewGuid (-> System.Guid)))
  (clr-guid-text         (: System.Guid.ToString (-> System.Guid string string))))

;; Up to `n` bytes into the start of `buffer`; the number read, 0 at the end.
(: (-> ClrStream (Array byte) int int))
(defbjouble (stream-read-some! s buffer n)
  (#:sync (clr-stream-read s buffer 0 n))
  (#:bjo (clr-stream-read-await s buffer 0 n)))

;; The first `n` bytes of `buffer`.
(: (-> ClrStream (Array byte) int void))
(defbjouble (stream-write-some! s buffer n)
  (#:sync (clr-stream-write s buffer 0 n))
  (#:bjo (clr-stream-write-await s buffer 0 n)))

;; At most `count` bytes: what the source held when it was opened.
;;
;; - `Stream.CopyTo` copies to the end of the source. When the target is the
;;   source under another name, opened to append, the end moves away as fast
;;   as the copy writes, and the file grows until the disk is full. Copying
;;   the length that the source had when it was opened ends.
;; - Stops early when the source ends before `count` bytes.
(: (-> ClrStream ClrStream long void))
(defun (stream-copy-count! from to count)
  (def buffer (make-array (cast int (min 81920L (max count 1L)))))
  (let go ((left count))
    (when (> left 0L)
      (def n (stream-read-some! from buffer (cast int (min (cast long (array-length buffer)) left))))
      (when (> n 0)
        (stream-write-some! to buffer n)
        (go (- left (cast long n)))))))

;; Copies a file from `from` to `to`.
;;
;; `#:mode` controls destination behavior:
;; - `CreateNew` (default): Fails if `to` exists, preventing accidental overwrite.
;; - `Truncate`: Overwrites `to` via an atomic replace.
;; - `Append`: Appends to `to`.
;;
;; Safety & Aliasing:
;; - Direct self-copies are rejected.
;; - The source is opened first; a missing source leaves `to` untouched.
;; - If `to` is an alias or symlink to `from`, in-place truncation could empty
;;   the source before copying. To prevent this:
;;   * `Truncate` copies to a temporary sibling file and moves it over `to`
;;     (replacing any symlink rather than writing through it).
;;   * `Append` copies only the source's initial byte length, preventing an
;;     infinite loop when appending a file to itself.
(: (-> %p %q (#:mode WriteMode) (Result FsError Unit)) (where (AsPath %p) (AsPath %q)))
(defun (file-copy from to #:mode CreateNew)
  (copy-file (as-path from) (as-path to) mode))

;; `p` from the root, without `.` and `..`, as `Path.GetFullPath` gives it.
(: (-> Path Path))
(defun (full-path p)
  (path-normalize (path-join (current-directory) p)))

;; `(Err e)` for an exception that I/O raises, and `e` raised again for any
;; other, such as a cancellation.
(: (-> Path Exception (Result FsError %a)))
(defun (io-failure path e)
  (match e
    ((:is System.IO.IOException) (Err (fs-error-of path e)))
    ((:is System.UnauthorizedAccessException) (Err (fs-error-of path e)))
    (_ (raise e))))

(: (-> Path Path WriteMode (Result FsError Unit)))
(defun (copy-file from to mode)
  (if (= (full-path from) (full-path to))
      (Err (Io from
               (cast Exception
                     (IOException. (string-append "cannot copy a file onto itself: "
                                                  (path->string/lossy from))))))
      (match (open-read-stream from)
        ((Err e) (Err e))
        ((Ok opened)
         (with-open ((in opened))
           (def count (clr-stream-length in))
           (match mode
             (Truncate
              (def fresh
                (as-path (bytestring-append (path->bytestring to)
                                            (string->bytestring (str ".copy-"
                                                                     (clr-guid-text (clr-new-guid) "N"))))))
              ;; Any exception deletes `fresh`, a cancellation too.
              (def outcome
                (try
                  (match (open-write-stream fresh CreateNew)
                    ((Ok s)
                     (with-open ((out s))
                       (stream-copy-count! in out count)
                       (stream-flush! out))
                     (fs-move fresh to MoveReplace))
                    ((Err e) (Err e)))
                  #:catch (System.Exception)))
              (match outcome
                ((Ok (Ok _)) (Ok unit))
                ((Ok failed)
                 (ignore (fs-delete-file fresh))
                 failed)
                ((Err e)
                 (ignore (fs-delete-file fresh))
                 (io-failure to e))))
             (_
              (match (open-write-stream to mode)
                ((Ok s)
                 (fs-result to (try (with-open ((out s))
                        (stream-copy-count! in out count)
                        (stream-flush! out)
                        unit)
                   #:catch (System.IO.IOException System.UnauthorizedAccessException))))
                ((Err e) (Err e))))))))))

(: (-> %p (Result FsError (Array byte))) (where (AsPath %p)))
(defun (file-read-bytes path)
  (match (open-read-stream (as-path path))
    ((Ok opened)
     (fs-result (as-path path) (try (with-open ((in opened))
            (def buffer (MemoryStream.))
            (stream-copy! in (cast ClrStream buffer))
            (.ToArray buffer))
       #:catch (System.IO.IOException System.UnauthorizedAccessException))))
    ((Err e) (Err e))))

(: (-> Path (Array byte) WriteMode (Result FsError Unit)))
(defun (write-whole-bytes path bytes mode)
  (match (open-write-stream path mode)
    ((Ok opened)
     (fs-result (as-path path) (try (with-open ((out opened))
            (stream-write! out bytes)
            (stream-flush! out)
            unit)
       #:catch (System.IO.IOException System.UnauthorizedAccessException))))
    ((Err e) (Err e))))

(: (-> %p (Array byte) (Result FsError Unit)) (where (AsPath %p)))
(defun (file-write-bytes path bytes)
  (write-whole-bytes (as-path path) bytes Truncate))

(: (-> %p (Array byte) (Result FsError Unit)) (where (AsPath %p)))
(defun (file-append-bytes path bytes)
  (write-whole-bytes (as-path path) bytes Append))

;; The lines, without their line ends. What ends a line is `#:mode`'s to say;
;; by default "\n", "\r" and "\r\n" all do. A last line needs no end, and a
;; final line end makes no empty line after it.
(: (-> %p (#:mode LineMode) (Result FsError (Vec string))) (where (AsPath %p)))
(defun (file-read-lines path #:mode Any)
  (match (open-input-file path)
    ((Ok opened)
     (fs-result (as-path path) (try (with-open ((p opened))
            (def lines (vecbuilder-empty))
            (let next ()
              (unless (port-eof? p)
                (vecbuilder-add! lines (read-line p #:mode mode))
                (next)))
            (vecbuilder->vec lines))
       #:catch (System.IO.IOException System.UnauthorizedAccessException))))
    ((Err e) (Err e))))

;; Each line followed by "\n", the last one too, on every OS: the same lines
;; make the same bytes wherever they are written, and `file-read-lines` gives
;; them back as long as none holds a line end of its own.
(: (-> %p (Vec string) (Result FsError Unit)) (where (AsPath %p)))
(defun (file-write-lines path lines)
  (match (open-output-file path)
    ((Ok opened)
     (fs-result (as-path path) (try (with-open ((p opened))
            (loop (:for line lines)
                  (:do (write-string p line)
                       (write-string p "\n")))
            (flush-port p)
            unit)
       #:catch (System.IO.IOException System.UnauthorizedAccessException))))
    ((Err e) (Err e))))

;; Returns a lazy `Seq` of items produced by repeatedly calling `(reader port)`.
;;
;; The file is opened inside the `seq`, meaning each iteration re-opens the file
;; from the start. The file is closed when iteration reaches EOF, stops early,
;; or encounters an exception. If an iterator is abandoned without cleanup, the
;; port remains open until the ambient scope ends.
;;
;; Because opening happens inside the sequence, open errors (such as a missing
;; file) raise on the first pull rather than when `file-read/seq` is called.
(: file-read/seq (-> (-> InputPort %a) %p (Seq %a)) (where (AsPath %p)) #:sync)
(defun (file-read/seq reader path)
  (seq
    (def file (raise-err (open-input-file path)))
    (with-open ((p file))
      (let loop ()
        (unless (port-eof? p)
          (yield (reader p))
          (loop))))))

(: file-read-lines/seq (-> %p (#:mode LineMode) (Seq string)) (where (AsPath %p)) #:sync)
(defun (file-read-lines/seq path #:mode Any)
  (file-read/seq (fun (p) (read-line p #:mode mode)) path))

(: (-> Path (List FsEntry)))
(defun (sorted-entries dir)
  (vec->list (vec-sort-by (fun (a b) (compare (record-ref a entry-name) (record-ref b entry-name)))
                          (raise-err (fs-list dir)))))

;; Lazily yields all files under `dir` in depth-first order.
;;
;; Behavior & Guarantees:
;; - Deterministic: Directory entries are sorted by name, byte by byte, guaranteeing identical
;;   traversal order across all operating systems and virtual filesystems.
;; - Filtering (`#:into?`): Called on each directory before entering; return `#f`
;;   to skip a subtree (e.g. `.git`).
;; - Cycle Prevention: Directory symlinks are never followed.
;; - Lazy Traversal: Subdirectories are listed on demand using the ambient `FS`
;;   handler, so stopping iteration early avoids unneeded filesystem I/O.
(: directory-walk (-> %p (#:into? (-> Path bool)) (Seq Path)) (where (AsPath %p)) #:sync)
(defun (directory-walk dir #:into? (fun (d) #t))
  (seq
    (let loop ((todo (sorted-entries (as-path dir))))
      (unless (list-empty? todo)
        (def entry (list-head todo))
        (def p (record-ref entry entry-path))
        (def rest (list-tail todo))
        (match (record-ref entry entry-kind)
          (FsDirectory
           (if (into? p)
               (loop (list-append (sorted-entries p) rest))
               (loop rest)))
          ;; A link is followed to a file, and never into a directory.
          (FsLink
           (match (kind-of p)
             ((Some FsFile)
              (yield p)
              (loop rest))
             (_ (loop rest))))
          (_
           (yield p)
           (loop rest)))))))

;; Flush.
(import/extern
  (clr-flush       (: Bjolang.Runtime.BjoOutputPort.Flush           (-> OutputPort void) #:blocking))
  (clr-flush-await (: Bjolang.Runtime.BjoOutputPort.FlushValueAsync (-> OutputPort void) #:async)))

(: (-> OutputPort void))
(defbjouble (flush-port p)
  (#:sync (clr-flush p))
  (#:bjo (clr-flush-await p)))

;; --- Input ---
;; These are the leaves of our IO. The bottom calls, so to say.
(import/extern
  (clr-eof        (: Bjolang.Runtime.BjoInputPort.Eof                 (-> InputPort bool)   #:blocking))
  (clr-eof-await  (: Bjolang.Runtime.BjoInputPort.EofAsync            (-> InputPort bool)   #:async))
  (clr-line       (: Bjolang.Runtime.InputPorts.ReadLineOrThrow    (-> InputPort int string) #:blocking))
  (clr-line-await (: Bjolang.Runtime.InputPorts.ReadLineOrThrowAsync (-> InputPort int string) #:async))
  (clr-char       (: Bjolang.Runtime.InputPorts.ReadCharOrThrow    (-> InputPort char)   #:blocking))
  (clr-char-await (: Bjolang.Runtime.InputPorts.ReadCharOrThrowAsync (-> InputPort char) #:async))
  (clr-rest       (: Bjolang.Runtime.BjoInputPort.ReadToEndUtf8       (-> InputPort string) #:blocking))
  (clr-rest-await (: Bjolang.Runtime.BjoInputPort.ReadToEndUtf8Async  (-> InputPort string) #:async))
  (clr-line-opt       (: Bjolang.Runtime.InputPorts.ReadLineOpt      (-> InputPort int (Option string)) #:blocking))
  (clr-line-opt-await (: Bjolang.Runtime.InputPorts.ReadLineOptAsync (-> InputPort int (Option string)) #:async))
  (clr-char-opt       (: Bjolang.Runtime.InputPorts.ReadCharOpt      (-> InputPort (Option char)) #:blocking))
  (clr-char-opt-await (: Bjolang.Runtime.InputPorts.ReadCharOptAsync (-> InputPort (Option char)) #:async))
  (clr-peek-char       (: Bjolang.Runtime.InputPorts.PeekCharOrThrow      (-> InputPort char) #:blocking))
  (clr-peek-char-await (: Bjolang.Runtime.InputPorts.PeekCharOrThrowAsync (-> InputPort char) #:async))
  (clr-peek-char-opt       (: Bjolang.Runtime.InputPorts.PeekCharOpt      (-> InputPort (Option char)) #:blocking))
  (clr-peek-char-opt-await (: Bjolang.Runtime.InputPorts.PeekCharOptAsync (-> InputPort (Option char)) #:async)))

;; Port eof.
(: (-> InputPort bool))
(defbjouble (port-eof? p)
  (#:sync (clr-eof p))
  (#:bjo (clr-eof-await p)))

;; `LineMode` as `Bjolang.Runtime.LineMode` numbers it.
(: (-> LineMode int))
(defun (line-mode-code mode)
  (match mode
    (Any 0)
    (AnyOne 1)
    (Linefeed 2)
    (Return 3)
    (ReturnLinefeed 4)))

;; Where a reader of one argument is expected, `read-line` is the function
;; that calls it with the port, and the mode is `Any`: `(port->list read-line
;; p)`. For another mode, hand it over as `(fun (p) (read-line p #:mode m))`.
(: (-> InputPort (#:mode LineMode) string))
(defbjouble (read-line p #:mode Any)
  (#:sync (clr-line p (line-mode-code mode)))
  (#:bjo (clr-line-await p (line-mode-code mode))))

;; One read, not `port-eof?` and then `read-line`: between those two another
;; fiber reading the same port can take the last line.
(: (-> InputPort (#:mode LineMode) (Option string)))
(defbjouble (read-line/opt p #:mode Any)
  (#:sync (clr-line-opt p (line-mode-code mode)))
  (#:bjo (clr-line-opt-await p (line-mode-code mode))))

(: (-> InputPort char))
(defbjouble (read-char p)
  (#:sync (clr-char p))
  (#:bjo (clr-char-await p)))

;; One read, for the reason `read-line/opt` is.
(: (-> InputPort (Option char)))
(defbjouble (read-char/opt p)
  (#:sync (clr-char-opt p))
  (#:bjo (clr-char-opt-await p)))

;; The character `read-char` would answer, left in the port, as Racket's
;; `peek-char`. Decoded from the port's buffer: it waits for the bytes a
;; character needs and takes none of them.
(: (-> InputPort char))
(defbjouble (peek-char p)
  (#:sync (clr-peek-char p))
  (#:bjo (clr-peek-char-await p)))

(: (-> InputPort (Option char)))
(defbjouble (peek-char/opt p)
  (#:sync (clr-peek-char-opt p))
  (#:bjo (clr-peek-char-opt-await p)))

;; Drains a port
(: (-> InputPort string))
(defbjouble (read-all p)
  (#:sync (clr-rest p))
  (#:bjo (clr-rest-await p)))

;; Port fold.
(: (-> (-?-> InputPort %a %a) %a InputPort %a))
(defun (port-fold f init port)
  (let loop ((acc init))
    (if (port-eof? port)
        acc
        (loop (f port acc)))))

;; --- Output ---

;; Port write operations provide both synchronous (`#:sync`) and suspending (`#:async`)
;; implementations via `defbjouble`.
;;
;; Writes are buffered in memory and non-blocking until the buffer fills. When a buffer
;; drains (triggering a syscall), the async variant suspends the coroutine rather than
;; blocking the host thread.
;;
;; In contrast, pure string formatters (`written` and `displayed`) output to a
;; thread-local `StringBuilder`, remaining strictly synchronous and side-effect free.
(import/extern
  (clr-write         (: Bjolang.Runtime.BjoOutputPort.WriteText          (-> OutputPort string void) #:blocking))
  (clr-write-await   (: Bjolang.Runtime.BjoOutputPort.WriteTextAsync     (-> OutputPort string void) #:async))
  (clr-writec        (: Bjolang.Runtime.BjoOutputPort.WriteScalar        (-> OutputPort char void)   #:blocking))
  (clr-writec-await  (: Bjolang.Runtime.BjoOutputPort.WriteScalarAsync   (-> OutputPort char void)   #:async))
  (clr-writeln       (: Bjolang.Runtime.BjoOutputPort.WriteTextLine      (-> OutputPort string void) #:blocking))
  (clr-writeln-await (: Bjolang.Runtime.BjoOutputPort.WriteTextLineAsync (-> OutputPort string void) #:async)))

(: (-> OutputPort string void))
(defbjouble (write-string p s)
  (#:sync (clr-write p s))
  (#:bjo (clr-write-await p s)))

;; Write char.
(: (-> OutputPort char void))
(defbjouble (write-char p c)
  (#:sync (clr-writec p c))
  (#:bjo (clr-writec-await p c)))

(: (-> OutputPort string void))
(defbjouble (writeln p s)
  (#:sync (clr-writeln p s))
  (#:bjo (clr-writeln-await p s)))

;; What a string port has been given, as text. Bytes written to it with
;; `write-bytes!` that are not UTF-8 read as U+FFFD, as Racket's do.
(: (-> OutputPort string))
(defun (get-output-string p)
  (writer->string p))

;; What a string port has been given, as bytes.
(: (-> OutputPort (Array byte)))
(defun (get-output-bytes p)
  (output-bytes p))

;; ---------------------------------------------------------------------------
;; Effects
;; ---------------------------------------------------------------------------
;;
;; An operation is a parameter holding a function, and performing an effect
;; calls that function on the performer's own stack.
;; (std effect) has the whole of the mechanism; what is here is the handful
;; of operations the standard library performs itself.
;;
;; What is an effect and what is a parameter?
;; If the thing is a value the caller reads, it is a parameter. If it is a
;; behaviour the caller decides - with a default worth naming, a possible
;; abort, and a signature worth checking - it is an effect. So errors stay
;; try/raise, state stays parameterize and def/mutable, the three
;; standard ports stay parameters, and random stays the parameter
;; (std random) already has: it is swappable, it has no abort case, and an
;; effect would put a wrapper function over a read that is already one.
;; The clock is a parameter for the same reason.
;;
;; Installing a handler needs (import (std effect)) for with-handler. A
;; macro is not a binding, so it cannot be re-exported from here.

(import (std effect))

;; `(warn "...")` - something is wrong, and carrying on is the default.
;;
;; Warn continues by default, but this is overridable.
;;
;; (log "...") - a line of diagnostics, and nobody's decision.
;;
;; Both are synchronous. A diagnostic that suspends is a promise answered here,
;; and acted on wherever it is awaited.
(defeffect Diagnostics
  (warn (-> string void))
  (log (-> string void))
  #:default ((warn (fun (s) (writeln (parameter-ref current-error-port) s)))
             (log (fun (s) (writeln (parameter-ref current-error-port) s)))))

;; (getenv "HOME") - the process environment, as an effect so that a test can
;; answer for it without writing to the real one.
;;
;; Cold: read at startup, not in a loop.
(defeffect Env
  (getenv (-> string (Option string)))
  #:default ((getenv get-environment-variable))
  #:cold (getenv))

;; ---------------------------------------------------------------------------
;; The clock
;; ---------------------------------------------------------------------------
;;
;; A `Clock` is a record of functions, so a program can make its own.
;; `monotonic-ms` and `monotonic-ns` read it here, and (std datetime)'s `now`
;; and `today` read the same one, so binding `current-clock` moves both.
;;
;; - `read-monotonic-ms`: milliseconds from an unspecified start. Never
;;   decreases; only differences mean anything.
;; - `read-monotonic-ns`: the same clock in nanoseconds, at the resolution
;;   the clock has. A clock made with only `#:monotonic-ms` reads it as its
;;   milliseconds times a million, so a fake clock gives the same exact
;;   elapsed time in both units.
;; - `read-utc-ticks`: the wall clock, in .NET ticks since 0001-01-01 UTC. May
;;   step back.
;; - `read-zone`: the zone (std datetime)'s `today` is in.
;; - `advance-ticks`: what (std datetime)'s `clock-advance!` calls, with a
;;   number of ticks. `None` for a clock that cannot be moved.
(type (: Clock (Record (: read-monotonic-ms (-> long))
                       (: read-monotonic-ns (-> long))
                       (: read-utc-ticks (-> long))
                       (: read-zone (-> System.TimeZoneInfo))
                       (: advance-ticks (Option (-> long void))))))

(import/extern
  (clock-ms (: BjolangRuntime.ClockMs (-> long)))
  (clock-ns (: BjolangRuntime.ClockNs (-> long)))
  (clr-utc-now (: System.DateTime.UtcNow #:get))
  (clr-local-zone (: System.TimeZoneInfo.Local #:get)))

(: (-> long))
(defun (system-utc-ticks)
  (.-Ticks clr-utc-now))

(: (-> System.TimeZoneInfo))
(defun (system-zone)
  clr-local-zone)

;; Each part not given is the system clock's, but for the nanoseconds: when
;; `#:monotonic-ns` is not given, they are read from the milliseconds, so that
;; a clock given only `#:monotonic-ms` agrees with itself.
(: (-> (#:monotonic-ms (-> long)) (#:monotonic-ns (Option (-> long))) (#:utc-ticks (-> long))
       (#:zone (-> System.TimeZoneInfo)) (#:advance (Option (-> long void))) Clock))
(defun (make-clock #:monotonic-ms clock-ms #:monotonic-ns None #:utc-ticks system-utc-ticks
                   #:zone system-zone #:advance None)
  (Clock (read-monotonic-ms monotonic-ms)
         (read-monotonic-ns (match monotonic-ns
                              ((Some ns) ns)
                              (None (fun () (* (monotonic-ms) 1000000L)))))
         (read-utc-ticks utc-ticks)
         (read-zone zone)
         (advance-ticks advance)))

;; The machine's clock, in the machine's zone.
(: Clock)
(def system-clock (make-clock #:monotonic-ns (Some clock-ns)))

;; Cold: nothing reads the time in a loop.
(: (Param Clock))
(def current-clock (make-cold-parameter system-clock))

;; Not called `now`: that is (std datetime)'s wall-clock `Instant`.
(: (-> (#:clock Clock) long))
(defun (monotonic-ms #:clock (parameter-ref current-clock))
  ((record-ref clock read-monotonic-ms)))

;; Nanoseconds on the same clock: for timing what takes less than a
;; millisecond.
(: (-> (#:clock Clock) long))
(defun (monotonic-ns #:clock (parameter-ref current-clock))
  ((record-ref clock read-monotonic-ns)))

;; ---------------------------------------------------------------------------
;; Cancellation scopes
;; ---------------------------------------------------------------------------
;;
;; A scope owns the fibers started inside it. `(spawn ...)` and `(bjo ...)` put
;; a fiber into the current scope, and the scope does not return until every one
;; of those fibers has finished. So this
;;
;;     (with-cancel (cancel)
;;       (spawn (process a))
;;       (spawn (process b)))
;;
;; waits for both, and the work is over when the form returns.
;;
;; Stopping early is what the cancel thunk is for:
;;
;;     (with-cancel (cancel)
;;       (spawn (worker jobs answers))
;;       (def answer (sync (chan-recv answers)))
;;       (cancel (Requested "got it"))
;;       answer)
;;
;; The cost of waiting first rather than cancelling first: a scope whose children
;; never end, and which never calls `cancel`, hangs here. That is the intended
;; trade. A hang says where it is; a scope that returned while its children ran
;; on says nothing at all.
;;
;; Waiting is the whole of what the four forms do. In a bjoroutine the wait
;; suspends; in ordinary code it parks the thread, as the end of a `defun`
;; `main` does. `scope-form` writes both, with `by-colour`.

;; The shared expansion of `with-cancel`, `with-deadline` and `with-shield`.
;;
;; `opener` is the call that makes the scope, and it is the only difference
;; between the three: a linked scope, a linked scope with a timer, or an
;; unlinked one. Everything after that — install, run, close, restore — is the
;; same, which is the point of writing it once.
;;
;; The two nested `try`s are one mechanism each. The inner one turns a failure in
;; the body into a value, so that the close can be told about it and can cancel
;; the other children before waiting for them. The outer one restores the
;; dynamic binding however the form is left; a fired token left installed would
;; make every later scope look cancelled.
;;
;; `(raise failure)` puts the body's exception back with the stack it arrived
;; with. It is not reached when the close raised first, which is what happens
;; when children failed too — the close reports them together.
(def/macro (scope-form form inject compare)
  (syntax-match form
    ((_ opener (cancel) first body ...)
     #'(let ()
         (def scope ,opener)
         (def saved (scope-push! scope))
         (def ,cancel (scope-canceller scope))
         (try
           (match (try
                    (let ()
                      ,first
                      ,@body)
                    #:catch (System.Exception))
             ((Ok answer)
              (by-colour (#:sync (scope-close!/blocking scope None))
                         (#:bjo (scope-close! scope None)))
              answer)
             ((Err failure)
              (by-colour (#:sync (scope-close!/blocking scope (Some failure)))
                         (#:bjo (scope-close! scope (Some failure))))
              (raise failure)))
           #:finally (dyn-restore! saved))))
    (bad
     (syntax-error
      bad
      "scope-form takes an opener, a cancel thunk name and a body. It is what with-scope, with-cancel, with-deadline and with-shield expand to; write one of those."))))

;; `(with-scope body ...)` - a scope with no cancel thunk.
;;
;; The plain form, and the one to put around resources. Everything the other
;; three do about fibers it does too: it waits for what was spawned in it, and
;; it releases what was owned in it, newest first.
;;
;; The cancel thunk is bound to a name the template made up, so nothing in the
;; body can reach it. A scope that wants to stop early says so with
;; `with-cancel`; a scope that only wants ownership says so with this.
(def/macro (with-scope form inject compare)
  (syntax-match form
    ((_ first body ...) #'(scope-form (scope-open! 0) (no-cancel) ,first ,@body))
    (bad
     (syntax-error
      bad
      "with-scope takes a body: (with-scope body ...). For a cancel thunk write with-cancel."))))

;; `(with-cancel (cancel) body ...)` — a scope that owns what it starts.
(def/macro (with-cancel form
             inject
             compare)
  (syntax-match form
    ((_ (cancel) first body ...) #'(scope-form (scope-open! 0) (,cancel) ,first ,@body))
    (bad
     (syntax-error
      bad
      "with-cancel names its cancel thunk and takes a body: (with-cancel (cancel) body ...)"))))

;; `(with-deadline duration body ...)` — the same scope, whose token also fires
;; on its own once `duration` has passed, with `Deadline`.
;;
;; The timer belongs to the scope rather than to a fiber racing it. A watcher
;; fiber cannot work here: the scope waits for its children before it fires its
;; token, and the watcher would be waiting for that token — so each would be
;; waiting for the other.
(def/macro (with-deadline form
             inject
             compare)
  (syntax-match form
    ((_ ms first body ...)
     #'(scope-form (deadline-open! (duration->timer-ms ,ms)) (fire) ,first ,@body))
    (bad
     (syntax-error
      bad
      "with-deadline takes a Duration and a body: (with-deadline (seconds 5) body ...)"))))

;; ---------------------------------------------------------------------------
;; The dynamic environment, for another thread
;; ---------------------------------------------------------------------------

;; Opaque: taken by `current-dynamic-environment`, used by
;; `call-with-dynamic-environment`, and nothing else.
(import/class
  (DynamicEnvironment (: Bjolang.Runtime.DynamicEnvironment)))

(import/extern
  (current-dynamic-environment (: Bjolang.Runtime.DynamicEnvironments.Current (-> DynamicEnvironment)))
  (call-with-dynamic-environment (: Bjolang.Runtime.DynamicEnvironments.Call (-> DynamicEnvironment (-> %a) %a))))

;; `(with-shield body ...)` and `(with-shield #:within ms body ...)` — a scope
;; whose token is *not* linked to its parent's.
;;
;; This is how cleanup runs after a cancellation. Every `sync` consults the
;; ambient token, so once a scope has been cancelled every `sync` in it raises —
;; including the ones in the code that is trying to tidy up. Inside a shield the
;; ambient token is a fresh one that has not fired, so a `sync` works again:
;;
;;     (with-shield #:within (seconds 5)
;;       (spawn (flush-buffer a))
;;       (spawn (flush-buffer b)))
;;
;; It is the same object as any other scope with one flag different, and that is
;; deliberate: `(current-cancel)` inside a shield also reads as "not cancelled",
;; so a hand-written `until-cancelled` agrees with what `sync` is doing rather
;; than contradicting it.
;;
;; The deadline is not optional and defaults to thirty seconds. A shield with no
;; deadline is unreachable from outside by construction, which would make the
;; program impossible to kill.
;;
;; A shield is a scope, so it waits for its own children like any other.
(def/macro (with-shield
             form
             inject
             compare)
  (syntax-match form
    ((_ #:within ms first body ...)
     #'(scope-form (shield-open! (duration->timer-ms ,ms)) (fire) ,first ,@body))
    ((_ first body ...)
     #'(with-shield
         #:within (seconds 30)
         ,first
         ,@body))
    (bad
     (syntax-error
      bad
      "with-shield takes a body and an optional deadline: (with-shield #:within (seconds 5) body ...)"))))

;; ---------------------------------------------------------------------------
;; Scope Resource Management
;; ---------------------------------------------------------------------------
;;
;; Scopes manage unmanaged resources (OS handles, file descriptors, network connections)
;; whose lifetimes must be strictly bound rather than left to garbage collection.
;;
;; Cleanup Lifecycle:
;; - Registered cleanup thunks run when the scope exits, after all spawned fibers
;;   have completed.
;; - Cleanup runs in LIFO order (newest first), ensuring wrappers (e.g., buffered ports)
;;   close before their underlying resources (e.g., streams).
;; - Cleanup thunks are synchronous and non-suspending. If a cleanup callback throws,
;;   the exception is recorded and remaining cleanup thunks continue to run.
;;
;; Scope Boundaries & Fibers:
;; - Fibers do NOT introduce their own scopes. A resource opened inside `(spawn ...)`
;;   or `(bjo ...)` belongs to the ambient enclosing scope and outlives the spawned fiber.
;; - For workloads that create many short-lived resources within a long-lived operation,
;;   use nested child scopes (`(with-scope ...)`) per work unit to reclaim resources promptly.
;; - A closing scope refuses new fibers (`spawn`), and a closed scope refuses new resource
;;   registrations (`own!`).

;; `(in-scope s body ...)` - run the body with `s` as the ambient scope.
;;
;; The way to own something in a scope other than the innermost one, and the
;; way back in from a .NET callback, which runs on a foreign thread with no
;; ambient scope at all:
;;
;;     (def home (current-scope))
;;     (on-event (fun (e) (in-scope home (handle e))))
;;
;; This installs a scope; it does not open or close one. Whoever opened `s` is
;; still the one that waits for it.
;;
;; A form and not a keyword argument on `spawn` and `own!`: Bjolang has no
;; rest-keywords, so a `#:scope` could not be forwarded through a wrapper, and
;; the two would drift apart.
(def/macro (in-scope form inject compare)
  (syntax-match form
    ((_ scope first body ...)
     #'(let ()
         (def saved (scope-push! ,scope))
         (try
           (let ()
             ,first
             ,@body)
           #:finally (dyn-restore! saved))))
    (bad (syntax-error bad "in-scope takes a scope and a body: (in-scope s body ...)"))))

;; `(own-disposable x)` - register `.Dispose` on the ambient scope, and hand
;; `x` straight back.
;;
;; A form rather than a function so that `.Dispose` is resolved at the call
;; site, the way `with-open` resolves it. A function would need the whole
;; `System.IDisposable` constraint apparatus to say the same thing.
;;
;; `with-open` is the other spelling: that one for a resource whose lifetime is
;; one block, this one for a resource whose lifetime is the scope's.
(def/macro (own-disposable form inject compare)
  (syntax-match form
    ((_ x)
     ;; `unit` after the call, not the call itself: `.Dispose` is a void .NET
     ;; method, so it has no value for the thunk to return.
     #'(let ((it ,x))
         (ignore (own! (fun ()
                         (.Dispose it)
                         unit)))
         it))
    (bad
     (syntax-error bad
                   "own-disposable takes one expression: (own-disposable (StreamReader. path))"))))

;; ---------------------------------------------------------------------------
;; Durations
;; ---------------------------------------------------------------------------
;;
;; A length of time, which is what every timer takes. A number of milliseconds
;; is a number whose unit is in no type: `5000` is easy to misread, and a count
;; that overflows becomes a different deadline without a word. A Duration has
;; its unit, and making one past its range raises.
;;
;; In .NET ticks of 100 ns, within ±long-max ticks, about ±29 227 years. Leaving
;; out long's minimum gives every duration a negation, so each one prints and
;; reads back. (std datetime) adds the arithmetic, the calendar and the text.

(import/class
  (DurationSpan (: System.TimeSpan (-> long DurationSpan)))
  (DurationOverflow (: System.OverflowException (-> string DurationOverflow))))

(import/extern
  (clr-duration-span-ticks (: System.TimeSpan.Ticks (-> DurationSpan long) #:get)))

(type (: Duration #:opaque (Struct (: v DurationSpan))))

(: (-> %a))
(defun (duration-overflow)
  (raise (cast Exception
               (DurationOverflow.
                "a duration is outside ±29 227 years (±9 223 372 036 854 775 807 ticks)"))))

;; The duration of `t` ticks. Raises at long's minimum, the one tick count
;; with no negation.
(: (-> long Duration))
(defun (ticks->duration t)
  (when (= t -9223372036854775808L)
    (duration-overflow))
  (Duration (v (DurationSpan. t))))

(: (-> Duration long))
(defun (duration-ticks d)
  (clr-duration-span-ticks (struct-ref d v)))

;; n units of `unit` ticks, or a raise past the range of a Duration.
(: (-> long long Duration))
(defun (units->duration n unit)
  (def limit (/ 9223372036854775807L unit))
  (when (or (> n limit) (< n (- limit)))
    (duration-overflow))
  (Duration (v (DurationSpan. (* n unit)))))

(: (-> long Duration))
(defun (milliseconds n)
  (units->duration n 10000L))

(: (-> long Duration))
(defun (seconds n)
  (units->duration n 10000000L))

(: (-> long Duration))
(defun (minutes n)
  (units->duration n 600000000L))

(: (-> long Duration))
(defun (hours n)
  (units->duration n 36000000000L))

(impl (Ord Duration)
  (defun (compare a b)
    (compare (duration-ticks a) (duration-ticks b))))

;; ISO 8601: PT26H30M, PT0.5S, with one leading sign: -PT1H30M.
(impl (Written Duration)
  (defun (written d)
    (duration->iso (duration-ticks d)))
  (defun (write-into d b)
    (stringbuilder-add-string! b (written d))))

(: (-> long string))
(defun (duration->iso t)
  (if (= t 0L)
      "PT0S"
      (let ()
        (def a
          (if (< t 0L)
              (- t)
              t))
        (def h (/ a 36000000000L))
        (def m (% (/ a 600000000L) 60L))
        (def s (% (/ a 10000000L) 60L))
        (def f (% a 10000000L))
        (string-append (if (< t 0L)
                           "-PT"
                           "PT")
                       (string-append (if (= h 0L)
                                          ""
                                          #"${h}H")
                                      (string-append (if (= m 0L)
                                                         ""
                                                         #"${m}M")
                                                     (if (and (= s 0L) (= f 0L))
                                                         ""
                                                         #"${s}${(tick-fraction f)}S")))))))

;; ".5" for half a second: up to seven digits, without trailing zeros, and
;; nothing for a whole second.
(: (-> long string))
(defun (tick-fraction f)
  (if (= f 0L)
      ""
      (let trim ((f f)
                 (width 7))
        (if (= (% f 10L) 0L)
            (trim (/ f 10L) (- width 1))
            (let pad ((digits (displayed f)))
              (if (< (string-length digits) width)
                  (pad (string-append "0" digits))
                  (string-append "." digits)))))))

;; Milliseconds for a timer, which counts them in a long. A part of a
;; millisecond counts as a whole one, so that a positive duration does not
;; become zero, which a timer takes as a time already passed.
(: (-> Duration long))
(defun (duration->timer-ms d)
  (def t (duration-ticks d))
  (if (<= t 0L)
      0L
      (+ (/ (- t 1L) 10000L) 1L)))

(import/extern
  (clr-timeout-ms (: BjolangRuntime.timeout (-> long (Event Unit)))))

;; An event that is ready `d` after each sync of it. Zero or less is ready at
;; once.
(: (-> Duration (Event Unit)))
(defun (timeout d)
  (clr-timeout-ms (duration->timer-ms d)))

;; ---------------------------------------------------------------------------
;; Select
;; ---------------------------------------------------------------------------

;; Several forms as one.
(: (-> (List Syntax) Syntax Syntax))
(defun (one-form body whole)
  (match body
    (Nil (syntax-error whole "This clause has nothing to do."))
    ((Cons only Nil) only)
    (_
     #'(let ()
         ,@body))))

;; `(select branch ...)` - sync on the events of the branches, then run the
;; body of the branch whose event committed.
;;
;; - Branches:
;;   - `(event pattern body ...)`: `event` is any `(Event %a)`. When it
;;     commits, its value is matched against `pattern` and `body` runs.
;;   - `(#:timeout duration body ...)`: a branch on `(timeout duration)`.
;;   - `(#:else body ...)`: runs when no other branch can commit at once. The
;;     sync does not wait. It must be the last branch.
;; - Types: each event has its own value type. The bodies have one type, which
;;   is the type of the form.
;; - Order: the events are offered in the order written. When several can
;;   commit at once, the first one wins, as with `choose`.
;; - Bodies run after the sync, in the code that the form is in. In a
;;   bjoroutine a body can suspend. A branch that loses runs no body, and a
;;   `with-nack` in its event fires.
;; - Colour: in a bjoroutine the form suspends, as `sync`. In a `defun` it
;;   parks the thread, as `sync/blocking`.
;; - Errors: a pattern that can fail to match makes the form a non-exhaustive
;;   `match`, which is a compile error.
;;
;; Expansion: `wrap` tags each value with nested `Ok` and `Err`, one `choose`
;; takes the tagged events, and a `match` on the tag runs the body. The
;; compiler emits a `choose` of two to four `wrap`s at a `sync` as one
;; `Cml.WrapChooseOnce` event, so a warm sync of up to four branches
;; allocates nothing.
(def/macro (select form inject compare)
  (syntax-match form
    ((_)
     (syntax-error
      form
      "select takes branches: (select (event pattern body ...) ... (#:timeout duration body ...) (#:else body ...))"))
    ((_ (#:else body ...))
     (syntax-error
      form
      "select needs a branch with an event, not only (#:else ...). Without one, write the body."))
    ((_ branch ...) (select-form (select-arms branch)))
    (bad
     (syntax-error
      bad
      "select takes branches: (select (event pattern body ...) ... (#:timeout duration body ...) (#:else body ...))"))))

;; One branch of a `select`: its event, its pattern and its body as one form.
(type (: SelectArm (Union (: Arm Syntax Syntax Syntax))))

;; The branches of a `select`, in the order written.
(: (-> (List Syntax) (List SelectArm)))
(defun (select-arms branches)
  (match branches
    (Nil Nil)
    ((Cons branch rest)
     (syntax-match branch
       ((#:else body ...)
        (match rest
          (Nil (list (Arm #'(always unit) (SSym (string->symbol "_")) (one-form body branch))))
          ((Cons after _)
           (list
            (select-arm-error
             after
             "(#:else ...) must be the last branch of a select: it runs only when no branch above it can commit at once.")))))
       ((#:timeout duration body ...)
        (Cons (Arm #'(timeout ,duration) (SSym (string->symbol "_")) (one-form body branch))
              (select-arms rest)))
       ((#:timeout)
        (list (select-arm-error branch "(#:timeout ...) is (#:timeout duration body ...).")))
       ((event pattern body ...)
        (match event
          ((SKey _)
           (list (select-arm-error event
                                   "A select branch starts with an event, #:timeout or #:else.")))
          (_ (Cons (Arm event pattern (one-form body branch)) (select-arms rest)))))
       (bad
        (list
         (select-arm-error
          bad
          "A select branch is (event pattern body ...), (#:timeout duration body ...) or (#:else body ...).")))))))

;; Raises the syntax error. Typed as an arm, for the lists above.
(: (-> Syntax string SelectArm))
(defun (select-arm-error at message)
  (def stx (syntax-error at message))
  (Arm stx stx stx))

;; The `match` on the sync of all the arms.
(: (-> (List SelectArm) Syntax))
(defun (select-form arms)
  (def last (- (list-length arms) 1))
  (def event
    (match arms
      ((Cons (Arm only _ _) Nil) only)
      (_ #'(choose ,@(select-wraps arms 0 last)))))
  #'(match (by-colour (#:sync (sync/blocking ,event)) (#:bjo (sync ,event)))
      ,@(select-clauses
         arms
         0
         last)))

;; Each arm's event, with its value tagged by `select-tag`.
(: (-> (List SelectArm) int int (List Syntax)))
(defun (select-wraps arms i last)
  (match arms
    (Nil Nil)
    ((Cons (Arm event _ _) rest)
     (Cons #'(wrap ,event (fun (v) ,(select-tag i last #'v))) (select-wraps rest (+ i 1) last)))))

;; Each arm's `match` clause: the arm's tag, and a `match` of the value on the
;; arm's pattern. The inner `match` is what a pattern that can fail is
;; reported on, so the message names the event's values, not the tags.
(: (-> (List SelectArm) int int (List Syntax)))
(defun (select-clauses arms i last)
  (match arms
    (Nil Nil)
    ((Cons (Arm _ pattern body) rest)
     (Cons #'(,(select-tag i last #'v) (match v
                                         (,pattern ,body)))
           (select-clauses rest (+ i 1) last)))))

;; The tag of arm `i` of `last + 1` arms around `x`, as an expression or a
;; pattern. Arm 0 is `(Ok x)`, arm 1 is `(Err (Ok x))`, and the last arm is
;; `x` inside `last` `Err`s. One arm has no tag.
(: (-> int int Syntax Syntax))
(defun (select-tag i last x)
  (cond
    ((= last 0) x)
    ((= i 0) #'(Ok ,x))
    (else #'(Err ,(select-tag (- i 1) (- last 1) x)))))

;; -------------------------------------------------------------
;; Extra thingies for cml
;;

(: (-> (Promise %a) %a))
(defun (promise-join/sync p)
  (match (sync/blocking (promise-join p))
    ((Err e) (raise e))
    ((Ok v) v)))
