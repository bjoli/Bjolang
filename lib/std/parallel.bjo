;; Work on the parts of a collection at the same time.
;;
;; A `Chunkable` collection splits into parts that together hold each element
;; once, in the collection's order when it has one. `in-parallel` runs a
;; function on each part on threads made for work that uses a core, and
;; returns the results in the order of the parts. The caller joins them: `(vec-fold + 0 ...)`, a
;; concatenation, a merge.
;;
;; The functions over a whole collection join the parts for the caller:
;;
;; - `par-map` and `par-filter` return a collection of the type they are
;;   given. Each type has its own way to join its parts.
;; - `par-collect` puts the elements into a collector, one accumulator for
;;   each part. A `MergingCollector` merges the accumulators in the order of
;;   the parts.
;; - `par-for-each` runs a function on each element.
;;
;; An array splits into views, not copies. A part of an array gives a span of
;; its own elements, so the parts of one array can be written in place at the
;; same time. A span cannot go to another thread, so each part makes its own.
;; A vector, a map or a set splits into collections of its own type, which
;; share its nodes.

(import (std prelude))
(import (std hashset))
(import (std orderedmap))
(import (std orderedset))
(import (std atomic))
(import (std inbox))

(:doc #:file "parallel.bjodoc")

(import/extern
  (processor-count (: System.Environment.ProcessorCount #:get))
  (parse-int (: System.Int32.TryParse (-> string (out int) (Option int))))
  (make-jobs-inbox (: Bjoml.InboxModule.MakeNewestFirst (-> int bool (Inbox %a))))
  (spin-before-parking (: BjolangRuntime.SpinBeforeParking (-> int void)))
  (clr-vec-split-at (: Collections.RrbFun.SplitAt (-> (Vec %a) (Array int) (Array (Vec %a)))))
  (clr-map-split (: Map.MapModule.Split (-> (Map %k %v) int (Array (Map %k %v)))))
  (clr-hashset-split (: Set.SetModule.Split (-> (HashSet %a) int (Array (HashSet %a)))))
  (clr-orderedmap-split (: OrderedMap.OrderedMapModule.Split (-> (OrderedMap %k %v) int (Array (OrderedMap %k %v)))))
  (clr-orderedset-split (: OrderedSet.OrderedSetModule.Split (-> (OrderedSet %a) int (Array (OrderedSet %a)))))
  (iarray-adopt (: Bjolang.Runtime.IArrayModule.Adopt (-> (Array %a) (IArray %a))))
  (clr-orderedmap-concat (: OrderedMap.OrderedMapModule.Concat (-> (Array (OrderedMap %k %v)) (OrderedMap %k %v))))
  (clr-orderedset-concat (: OrderedSet.OrderedSetModule.Concat (-> (Array (OrderedSet %a)) (OrderedSet %a)))))

(import/class
  ;; The accumulator of `arraying`, which the prelude does not export.
  ((ArrayBuilder %a) (: Bjolang.Runtime.ArrayBuilder)))

(import/extern
  (arraybuilder-empty (: Bjolang.Runtime.ArrayBuilderModule.Empty (-> (ArrayBuilder %a))))
  (arraybuilder-add   (: Bjolang.Runtime.ArrayBuilderModule.Add   (-> (ArrayBuilder %a) %a (ArrayBuilder %a))))
  (arraybuilder-count (: Bjolang.Runtime.ArrayBuilderModule.Count (-> (ArrayBuilder %a) int)))
  (arraybuilder-grow  (: Bjolang.Runtime.ArrayBuilderModule.Grow  (-> (ArrayBuilder %a) int (ArrayBuilder %a))))
  (arraybuilder-span  (: Bjolang.Runtime.ArrayBuilderModule.Span  (-> (ArrayBuilder %a) int int (Span %a)))))

(export Chunkable chunk-size chunks
        in-parallel computing-each compute-thread-count
        ArrayPart part-array part-lo part-hi part-length part->span part->ro-span
        IArrayPart iarray-part-lo iarray-part-hi iarray-part-length
        MergingCollector collector-merge par-collect par-for-each
        ParallelMap par-map ParallelFilter par-filter)

;; ---------------------------------------------------------------------------
;; The trait
;; ---------------------------------------------------------------------------

;; A collection that splits into parts.
;;
;; - `chunk-size`: the number of elements, or a good estimate.
;; - `chunks c k`: about k parts, in the collection's order when it has one,
;;   that hold each element once. Fewer when there are fewer elements than k,
;;   and at least one, which may be empty.
(def/trait (Chunkable %c)
  (type %chunk)
  (: chunk-size (-> %c int))
  (: chunks (-> %c int (Vec %chunk))))

;; The number of parts to make of n elements when k are asked for: at least
;; one, and no more than there are elements.
(: (-> int int int))
(defun (part-count n k)
  (max 1 (min k n)))

;; Where part i of k starts, as an offset into n elements. Parts differ in size
;; by one at most. In a long, because i times n can pass `int-max`.
(: (-> int int int int))
(defun (part-start n k i)
  (cast int (/ (* (cast long n) (cast long i)) (cast long k))))

;; ---------------------------------------------------------------------------
;; The compute threads
;; ---------------------------------------------------------------------------

;; Threads for work that uses a core, made at the first call and kept.
;;
;; - Each is a `spawn/thread` that takes jobs from `jobs` for ever. A
;;   detached fiber syncs its event, as `spawn/thread` starts its thread when
;;   synced. The fiber is suspended for ever, and holds nothing.
;; - They are not the threads of the run queues, so a job holds no pump, and
;;   fibers go on running while the jobs compute.
;; - `jobs` is an inbox, which several threads can wait on, and which a post
;;   does not wait for. It wakes the thread that waited last, which is the
;;   one most likely to be spinning still, as a thread spins a little before
;;   it parks: then a post makes no system call to wake it.
;; - A thread that has no job spins for 50 us before it parks. A call that
;;   comes within that time finds it awake: it starts at once, and the post
;;   makes no system call. Measured on 24 empty parts after 10 us of other
;;   work: 14 to 6 us for each call. The cost is a core for 50 us after the
;;   last job of each thread.
;; - A job is a closure over the dynamic environment of the code that made
;;   it, and runs in that environment.
;; - A job posted to a full inbox is dropped. That is safe because a call
;;   always has a thread that takes its parts: in ordinary code the calling
;;   thread, and in a bjoroutine the first runner, which waits for room
;;   when the inbox is full.

;; How many compute threads there are: BJOLANG_COMPUTE_THREADS, or one for
;; each logical core. Read once, when the module is loaded.
(def thread-count
  (match (get-environment-variable "BJOLANG_COMPUTE_THREADS")
    ((Some s) (match (parse-int s)
                ((Some n) (if (> n 0) n processor-count))
                (None processor-count)))
    (None processor-count)))

(: (-> int))
(defun (compute-thread-count) thread-count)

(def jobs (: (make-jobs-inbox 4096 #f) (Inbox (-> Unit))))
(def started (make-atomic 0))

;; A compute thread: runs jobs for ever. A job raises nothing: the parts it
;; runs keep their exceptions.
(def spin-us 50)

(: (-> Unit))
(defun (compute-loop)
  (spin-before-parking spin-us)
  (let go ()
    ((sync/blocking (inbox-recv jobs)))
    (go)))

(: (-bjo-> void))
(defbjo (keep-compute-thread)
  (ignore (sync (spawn/thread compute-loop))))

(: (-> void))
(defun (start-compute-threads!)
  (when (= (atomic-compare-and-swap! started 0 1) 0)
    (loop (:for _ (range 0 thread-count))
          (:do (spawn/detached (keep-compute-thread))))))

;; ---------------------------------------------------------------------------
;; Running the parts
;; ---------------------------------------------------------------------------

;; Runs `(work k)` for each k from 0 to n - 1 on the compute threads, and
;; returns the values in the order of k.
;;
;; - A runner is a job that takes parts by number until none is left. The
;;   caller posts runners one after the other while a part is left that no
;;   runner has taken, up to one for each compute thread, or for each part
;;   when there are fewer. A post that wakes a thread that sleeps is a system
;;   call of some microseconds, and the thread starts some microseconds
;;   later: so when the parts are small, the first runners take them all and
;;   the caller stops posting. A runner that a thread takes after the parts
;;   are all taken ends at once.
;; - In a bjoroutine the fiber is suspended until the parts have run, and
;;   holds nothing.
;; - In ordinary code the thread posts one runner fewer, then takes the parts
;;   that are left itself, and then waits only for the parts that other
;;   threads have taken. So a part can call `computing-each` itself: a call
;;   does not wait for runners that no thread is free to take, and there is
;;   no deadlock when calls nest.
;; - A part runs in the dynamic environment of the call.
;; - When a part raises, the parts not started do not run, and the exception
;;   is raised here when the parts that started have ended. A part that runs
;;   cannot be stopped. In a bjoroutine, the parts not started when the scope
;;   is cancelled do not run, and `Cancelled` is raised.
(: computing-each (-> int (-> int %a) (Vec %a)))
(defun (computing-each n work)
  (if (<= n 0)
      []
      (let ()
        (start-compute-threads!)
        (def results (make-array n))
        (def next (make-atomic -1))
        (def ended (make-atomic 0))
        (def failed (make-atomic 0))
        (def failure (: (make-array 1) (Array Exception)))
        (def skipped (make-atomic 0))
        (def done (: (make-inbox 1 DropNewest) (Inbox Unit)))
        (def token (parameter-ref current-cancel))
        (def env (current-dynamic-environment))
        ;; Takes parts until none is left.
        (def run-parts
          (fun ()
            (let go ()
              (def k (atomic-increment! next))
              (when (< k n)
                (cond
                  ((not (= (atomic-ref failed) 0)) unit)
                  ((cancelled? token) (ignore (atomic-increment! skipped)))
                  (else (match (try (array-set! results k (work k)) #:catch (System.Exception))
                          ((Ok _) unit)
                          ((Err e) (when (= (atomic-compare-and-swap! failed 0 1) 0)
                                     (array-set! failure 0 e))))))
                (when (= (atomic-increment! ended) n)
                  (ignore (inbox-post! done unit)))
                (go)))
            unit))
        (def runner (fun () (call-with-dynamic-environment env run-parts)))
        ;; At most one runner for each part and one for each compute thread,
        ;; and in ordinary code one less, as the calling thread takes parts
        ;; too.
        (def runners (by-colour (#:sync (min (- n 1) thread-count))
                                (#:bjo (min n thread-count))))
        (def posted (make-atomic 0))
        ;; Posts runners while a part is left that no runner has taken.
        (def post-runners
          (fun ()
            (let go ()
              (when (and (< (+ (atomic-ref next) 1) n)
                         (<= (atomic-increment! posted) runners))
                (ignore (inbox-post! jobs runner))
                (go)))))
        (by-colour
          (#:sync (begin
                    (post-runners)
                    (run-parts)
                    (sync/blocking (inbox-recv done))))
          (#:bjo (begin
                   (ignore (atomic-increment! posted))
                   (unless (inbox-post! jobs runner)
                     (sync (inbox-send-evt jobs runner)))
                   (post-runners)
                   (sync (inbox-recv done))
                   (when (> (atomic-ref skipped) 0) (sync (: (never) (Event Unit)))))))
        (when (= (atomic-ref failed) 1) (raise (array-ref failure 0)))
        (array->vec results))))

;; Runs `f` on each part of `c` on the compute threads, and returns the
;; results in the order of the parts. For work that uses a core: see
;; `computing-each`, which runs the parts.
;;
;; `#:parts` is how many parts to ask for: four for each compute thread
;; unless given. The collection may make fewer.
(: in-parallel (-> %c (-> %p %r) (#:parts int) (Vec %r)) (where (Chunkable %c #:chunk %p)))
(defun (in-parallel c f #:parts (* 4 thread-count))
  (def ps (chunks c parts))
  (computing-each (vec-length ps) (fun (i) (f (vec-ref ps i)))))

;; ---------------------------------------------------------------------------
;; Ranges and vectors
;; ---------------------------------------------------------------------------

(impl (Chunkable Range)
  (type %chunk Range)
  (defun (chunk-size r) (max 0 (- (record-ref r hi) (record-ref r lo))))
  (defun (chunks r k)
    (def lo (record-ref r lo))
    (def n (max 0 (- (record-ref r hi) lo)))
    (def m (part-count n k))
    (loop (:for i (range 0 m))
          (:acc parts (vecing (range (+ lo (part-start n m i))
                                     (+ lo (part-start n m (+ i 1)))))))))

;; A part of a vector is a slice of it, which shares its nodes.
(impl (Chunkable (Vec %a))
  (type %chunk (Vec %a))
  (defun (chunk-size v) (vec-length v))
  (defun (chunks v k)
    (def n (vec-length v))
    (def m (part-count n k))
    (loop (:for i (range 0 m))
          (:acc parts (vecing (vec-slice v
                                         (part-start n m i)
                                         (- (part-start n m (+ i 1)) (part-start n m i))))))))

;; ---------------------------------------------------------------------------
;; Arrays: parts are views
;; ---------------------------------------------------------------------------

;; The elements of `array` from `lo` up to `hi`. A view: it holds the array,
;; not a copy of the elements.
(type (: (ArrayPart %a) (Struct (: array (Array %a)) (: lo int) (: hi int))))

(: (-> (ArrayPart %a) (Array %a)))
(defun (part-array p) (record-ref p array))

;; The index in the array of the part's first element.
(: (-> (ArrayPart %a) int))
(defun (part-lo p) (record-ref p lo))

;; The index in the array after the part's last element.
(: (-> (ArrayPart %a) int))
(defun (part-hi p) (record-ref p hi))

(: (-> (ArrayPart %a) int))
(defun (part-length p) (- (record-ref p hi) (record-ref p lo)))

;; A span of the part's elements, which writes into the array. Index 0 is the
;; part's first element. Made where it is used: a span cannot go to another
;; thread or into a closure.
(: (-> (ArrayPart %a) (Span %a)))
(defun (part->span p)
  (array->span (record-ref p array) #:from (record-ref p lo) #:to (record-ref p hi)))

(: (-> (ArrayPart %a) (RoSpan %a)))
(defun (part->ro-span p)
  (array->ro-span (record-ref p array) #:from (record-ref p lo) #:to (record-ref p hi)))

;; The part's elements, in order. The cursor is the index into the array.
(impl (Iterable (ArrayPart %a))
  (type %elem %a)
  (type %cursor int)
  (defun (iterable-start p) (record-ref p lo))
  (defun (iterable-done? p index) (>= index (record-ref p hi)))
  (defun (iterable-current p index) (array-ref (record-ref p array) index))
  (defun (iterable-next p index) (+ index 1))
  (defun (count p) (- (record-ref p hi) (record-ref p lo))))

(impl (Chunkable (Array %a))
  (type %chunk (ArrayPart %a))
  (defun (chunk-size a) (array-length a))
  (defun (chunks a k)
    (def n (array-length a))
    (def m (part-count n k))
    (loop (:for i (range 0 m))
          (:acc parts (vecing (ArrayPart (array a)
                                         (lo (part-start n m i))
                                         (hi (part-start n m (+ i 1)))))))))

;; ---------------------------------------------------------------------------
;; Immutable arrays: parts are views too
;; ---------------------------------------------------------------------------

(type (: (IArrayPart %a) (Struct (: iarray (IArray %a)) (: lo int) (: hi int))))

(: (-> (IArrayPart %a) int))
(defun (iarray-part-lo p) (record-ref p lo))

(: (-> (IArrayPart %a) int))
(defun (iarray-part-hi p) (record-ref p hi))

(: (-> (IArrayPart %a) int))
(defun (iarray-part-length p) (- (record-ref p hi) (record-ref p lo)))

(impl (Iterable (IArrayPart %a))
  (type %elem %a)
  (type %cursor int)
  (defun (iterable-start p) (record-ref p lo))
  (defun (iterable-done? p index) (>= index (record-ref p hi)))
  (defun (iterable-current p index) (iarray-ref (record-ref p iarray) index))
  (defun (iterable-next p index) (+ index 1))
  (defun (count p) (- (record-ref p hi) (record-ref p lo))))

(impl (Chunkable (IArray %a))
  (type %chunk (IArrayPart %a))
  (defun (chunk-size a) (iarray-length a))
  (defun (chunks a k)
    (def n (iarray-length a))
    (def m (part-count n k))
    (loop (:for i (range 0 m))
          (:acc parts (vecing (IArrayPart (iarray a)
                                          (lo (part-start n m i))
                                          (hi (part-start n m (+ i 1)))))))))

;; ---------------------------------------------------------------------------
;; Maps and sets: parts are maps and sets
;; ---------------------------------------------------------------------------

;; The split is in the runtime. It cuts along the tree's own nodes, so the
;; parts share them, and their sizes are close but not equal. A tree too small
;; to cut, one leaf, is one part.

;; The parts of a hash map or a hash set are in no order that means
;; anything, as the map's own order does not.
(impl (Chunkable (Map %k %v))
  (type %chunk (Map %k %v))
  (defun (chunk-size m) (map-length m))
  (defun (chunks m k) (array->vec (clr-map-split m k))))

(impl (Chunkable (HashSet %a))
  (type %chunk (HashSet %a))
  (defun (chunk-size s) (hashset-length s))
  (defun (chunks s k) (array->vec (clr-hashset-split s k))))

;; The parts of an ordered map or set are in key order: every key of a part
;; is less than every key of the next.
(impl (Chunkable (OrderedMap %k %v))
  (type %chunk (OrderedMap %k %v))
  (defun (chunk-size m) (orderedmap-length m))
  (defun (chunks m k) (array->vec (clr-orderedmap-split m k))))

(impl (Chunkable (OrderedSet %a))
  (type %chunk (OrderedSet %a))
  (defun (chunk-size s) (orderedset-length s))
  (defun (chunks s k) (array->vec (clr-orderedset-split s k))))

;; ---------------------------------------------------------------------------
;; Collectors that merge
;; ---------------------------------------------------------------------------

;; A `Collector` whose accumulators of two runs merge into one.
;;
;; - `collector-merge c a b`: the accumulator of the elements of `a`'s run
;;   followed by those of `b`'s run, as if one run took them all in that
;;   order. It may change and return `a` or `b`, which are not used again.
;; - `%acc` is the collector's own `%acc`.
;;
;; A collector that starts from a value, such as `(vecing x #:into v)` or
;; `folding`, does not merge: each run would start from the value again.
(def/trait (MergingCollector %c)
  (type %acc)
  (: collector-merge (-> %c %acc %acc %acc)))

(impl (MergingCollector (Listing %a))
  (type %acc (ListBuilder %a))
  (defun (collector-merge c a b)
    (listbuilder-add-range! a (list->seq (listbuilder->list b)))
    a))

;; Each run's list is its elements last first, so the merge is `b`'s list
;; and then `a`'s.
(impl (MergingCollector (ListingReverse %a))
  (type %acc (List %a))
  (defun (collector-merge c a b) (list-append b a)))

(impl (MergingCollector (Vecing %a))
  (type %acc (VecBuilder %a))
  (defun (collector-merge c a b)
    (vec->vecbuilder (vec-merge (vecbuilder->vec a) (vecbuilder->vec b)))))

(impl (MergingCollector (VecingSmall %a))
  (type %acc (VecBuilder %a))
  (defun (collector-merge c a b)
    (vec->vecbuilder (vec-merge (vecbuilder->vec a) (vecbuilder->vec b)))))

(impl (MergingCollector (Arraying %a))
  (type %acc (ArrayBuilder %a))
  (defun (collector-merge c a b) (arraybuilder-append a b)))

;; `a` with the elements of `b` added at its end.
(: (-> (ArrayBuilder %a) (ArrayBuilder %a) (ArrayBuilder %a)))
(defun (arraybuilder-append a b)
  (def start (arraybuilder-count a))
  (def n (arraybuilder-count b))
  (def grown (arraybuilder-grow a n))
  (def to (arraybuilder-span grown start n))
  (def from (arraybuilder-span b 0 n))
  (loop (:for i (range 0 n))
        (:do (span-set! to i (span-ref from i))))
  grown)

;; Where both runs have a key, `b`'s value is kept, as a later step of one
;; run keeps it.
(impl (MergingCollector (Mapping %k %v))
  (type %acc (MapBuilder %k %v))
  (defun (collector-merge c a b)
    (map->mapbuilder (map-merge (mapbuilder->map a) (mapbuilder->map b)))))

(impl (MergingCollector (HashSetting %a))
  (type %acc (HashSetBuilder %a))
  (defun (collector-merge c a b)
    (hashset->hashsetbuilder (hashset-union (hashsetbuilder->hashset a) (hashsetbuilder->hashset b)))))

;; `b`'s entries are added to `a`'s builder, which sorts them when it builds
;; unless they come after `a`'s: so the parts of an ordered map cost no sort.
(impl (MergingCollector (OrderedMapping %k %v))
  (type %acc (OrderedMapBuilder %k %v))
  (defun (collector-merge c a b)
    (orderedmapbuilder-add-all! a (orderedmap->seq (orderedmapbuilder->orderedmap b)))
    a))

(impl (MergingCollector (OrderedSetting %a))
  (type %acc (OrderedSetBuilder %a))
  (defun (collector-merge c a b)
    (orderedsetbuilder-add-all! a (orderedset->seq (orderedsetbuilder->orderedset b)))
    a))

(impl (MergingCollector Stringing)
  (type %acc StringBuilder)
  (defun (collector-merge c a b)
    (stringbuilder-add-string! a (stringbuilder->string b))
    a))

(impl (MergingCollector (Summing %a))
  (where (Num %a))
  (type %acc %a)
  (defun (collector-merge c a b) (+ a b)))

(impl (MergingCollector (Counting %a %n))
  (where (Num %n))
  (type %acc %n)
  (defun (collector-merge c a b) (+ a b)))

;; ---------------------------------------------------------------------------
;; Over the elements of a whole collection
;; ---------------------------------------------------------------------------

;; The functions that run on each part are top-level functions, not lambdas
;; in the callers: a lambda's parameter of the part's type does not get the
;; part's element type from the caller's `where` (Todo.org).

;; The accumulator of `col` over the elements of one part, each through `f`.
(: collect-part (-> %k (-> %e %x) %p %acc)
   (where (Iterable %p #:elem %e)
          (Collector %k #:elem %x #:acc %acc)))
(defun (collect-part col f part)
  (let go ((acc (collector-init col)) (cur (iterable-start part)))
    (if (iterable-done? part cur)
        acc
        (go (collector-step col acc (f (iterable-current part cur)))
            (iterable-next part cur)))))

;; Puts `(f x)` for each element x of `c` into the collector `col`, and
;; returns what the collector makes of them.
;;
;; - Each part has an accumulator of its own, on a compute thread. Then the
;;   accumulators are merged on the calling thread, in the order of the
;;   parts, and the collector finishes the result.
;; - `f` runs on the compute threads, at the same time for different parts.
;; - A part runs as `in-parallel` runs it: also for exceptions and the
;;   dynamic environment.
(: par-collect (-> %k (-> %e %x) %c %out)
   (where (Chunkable %c #:chunk %p)
          (Iterable %p #:elem %e)
          (Collector %k #:elem %x #:acc %acc #:out %out)
          (MergingCollector %k #:acc %acc)))
(defun (par-collect col f c)
  (def accs (in-parallel c (fun (part) (collect-part col f part))))
  (collector-finish col (joined accs (fun (a b) (collector-merge col a b)))))

(: each-of-part (-> (-> %e void) %p Unit) (where (Iterable %p #:elem %e)))
(defun (each-of-part f part)
  (let go ((cur (iterable-start part)))
    (if (iterable-done? part cur)
        unit
        (begin
          (f (iterable-current part cur))
          (go (iterable-next part cur))))))

;; Runs `f` on each element of `c`, on the compute threads. The elements of
;; a part are taken in order, and the parts at the same time.
(: par-for-each (-> (-> %e void) %c void)
   (where (Chunkable %c #:chunk %p)
          (Iterable %p #:elem %e)))
(defun (par-for-each f c)
  (ignore (in-parallel c (fun (part) (each-of-part f part)))))

;; The parts joined from the first to the last: `(join (join p0 p1) p2)`.
;; There is at least one part.
(: (-> (Vec %a) (-> %a %a %a) %a))
(defun (joined parts join)
  (loop (:for i (range 1 (vec-length parts)))
        (:acc out (folding (vec-ref parts 0) (join out (vec-ref parts i))))))

;; ---------------------------------------------------------------------------
;; A collection of the type given
;; ---------------------------------------------------------------------------

;; A collection whose elements a function can change on the compute threads.
;;
;; - `par-map f c`: a collection of the same type, with `(f x)` in place of
;;   each element x, in the same order. `f` runs on the compute threads.
;; - Of a map, the values are the elements: the keys stay as they are.
;; - A set is not a `ParallelMap`, as a set of the values of `f` needs their
;;   `Eq` or `Ord`. Use `par-collect` with `hash-setting` or
;;   `ordered-setting`.
(def/trait (ParallelMap (%c %a))
  (: par-map (-> (-> %a %b) (%c %a) (%c %b))))

;; A collection whose elements a test can select on the compute threads.
;;
;; - `par-filter keep? c`: a collection of the same type, with the elements
;;   for which `(keep? x)` is true, in the same order. `keep?` runs on the
;;   compute threads.
;; - Of a map, `keep?` is given the value. To test the key too, use
;;   `in-parallel` with `map-filter`, and `map-merge` the parts.
(def/trait (ParallelFilter (%c %a))
  (: par-filter (-> (-> %a bool) (%c %a) (%c %a))))

;; --- Vectors: the parts are joined by concatenation, which shares their
;; nodes.

(impl (ParallelMap (Vec %a))
  (defun (par-map f v)
    (joined (in-parallel v (fun (p) (vec-map f p))) (fun (a b) (vec-merge a b)))))

(impl (ParallelFilter (Vec %a))
  (defun (par-filter keep? v)
    (joined (in-parallel v (fun (p) (vec-filter keep? p))) (fun (a b) (vec-merge a b)))))

;; --- Arrays: `par-map` makes the result first, and each part writes its
;; own range of it. `par-filter` collects each part's elements, and then
;; copies them into an array of their number.

;; Writes `(f x)` into `out` for each element x of part `p` of `a`, at the
;; same index.
(: (-> (-> %a %b) (ArrayPart %a) (Array %b) Unit))
(defun (map-part-into f p out)
  (def a (record-ref p array))
  (loop (:for i (range (record-ref p lo) (record-ref p hi)))
        (:do (array-set! out i (f (array-ref a i)))))
  unit)

(: (-> (-> %a %b) (IArrayPart %a) (Array %b) Unit))
(defun (map-iarray-part-into f p out)
  (def a (record-ref p iarray))
  (loop (:for i (range (record-ref p lo) (record-ref p hi)))
        (:do (array-set! out i (f (iarray-ref a i)))))
  unit)

;; The elements of the builders, one builder after the other, in an array of
;; their number.
(: (-> (Vec (ArrayBuilder %a)) (Array %a)))
(defun (builders->array parts)
  (def out (make-array (loop (:for b parts) (:acc n (summing (arraybuilder-count b))))))
  (loop (:for b parts)
        (:with at 0 (+ at (arraybuilder-count b)))
        (:do (let ((from (arraybuilder-span b 0 (arraybuilder-count b))))
               (loop (:for i (range 0 (span-length from)))
                     (:do (array-set! out (+ at i) (span-ref from i)))))))
  out)

(: (-> (-> %a bool) (ArrayPart %a) (ArrayBuilder %a)))
(defun (filter-part keep? p)
  (loop (:for x p)
        (:when (keep? x))
        (:acc kept (folding (arraybuilder-empty) (arraybuilder-add kept x)))))

(: (-> (-> %a bool) (IArrayPart %a) (ArrayBuilder %a)))
(defun (filter-iarray-part keep? p)
  (loop (:for x p)
        (:when (keep? x))
        (:acc kept (folding (arraybuilder-empty) (arraybuilder-add kept x)))))

(impl (ParallelMap (Array %a))
  (defun (par-map f a)
    (def out (make-array (array-length a)))
    (ignore (in-parallel a (fun (p) (map-part-into f p out))))
    out))

(impl (ParallelFilter (Array %a))
  (defun (par-filter keep? a)
    (builders->array (in-parallel a (fun (p) (filter-part keep? p))))))

;; The array that the parts write is not seen by any other code, so it
;; becomes the immutable array with no copy.
(impl (ParallelMap (IArray %a))
  (defun (par-map f a)
    (def out (make-array (iarray-length a)))
    (ignore (in-parallel a (fun (p) (map-iarray-part-into f p out))))
    (iarray-adopt out)))

(impl (ParallelFilter (IArray %a))
  (defun (par-filter keep? a)
    (iarray-adopt (builders->array (in-parallel a (fun (p) (filter-iarray-part keep? p)))))))

;; --- Hash maps and sets: the parts have no key in common, so a merge
;; shares their nodes.

(impl (ParallelMap (Map %k %a))
  (defun (par-map f m)
    (joined (in-parallel m (fun (p) (map-map-values f p))) (fun (a b) (map-merge a b)))))

(impl (ParallelFilter (Map %k %a))
  (defun (par-filter keep? m)
    (joined (in-parallel m (fun (p) (map-filter (fun (k v) (keep? v)) p)))
            (fun (a b) (map-merge a b)))))

(impl (ParallelFilter (HashSet %a))
  (defun (par-filter keep? s)
    (joined (in-parallel s (fun (p) (hashset-filter keep? p))) (fun (a b) (hashset-union a b)))))

;; --- Ordered maps and sets: the parts are in key order, so the runtime
;; joins them by their leaves, under new internal nodes. No entry is
;; compared or copied.

(impl (ParallelMap (OrderedMap %k %a))
  (defun (par-map f m)
    (clr-orderedmap-concat (vec->array (in-parallel m (fun (p) (orderedmap-map-values f p)))))))

(impl (ParallelFilter (OrderedMap %k %a))
  (defun (par-filter keep? m)
    (clr-orderedmap-concat (vec->array (in-parallel m (fun (p) (orderedmap-filter (fun (k v) (keep? v)) p)))))))

(impl (ParallelFilter (OrderedSet %a))
  (defun (par-filter keep? s)
    (clr-orderedset-concat (vec->array (in-parallel s (fun (p) (orderedset-filter keep? p)))))))
