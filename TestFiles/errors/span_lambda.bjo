;; A (fun ...) cannot take a span: it is a delegate.
;; EXPECT-ERROR: this (fun ...) takes or answers a (System.Span long)
;; EXPECT-ERROR: local (defun ...)
(import (std prelude))
(import/extern
  (whole (: System.MemoryExtensions.AsSpan (-> (Array %a) (System.Span %a))))
  (sleep (: System.Threading.Tasks.Task.Delay (-> int void) #:async #:uncancellable)))
(: (-> (System.Span long) int))
(defun (len s) (.-Length s))

(defun (main) (def xs (vec->array [1L])) (def f (fun (s) (len s))) (println (f (whole xs))) 0)
