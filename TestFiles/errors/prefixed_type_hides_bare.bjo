;; EXPECT-ERROR: there is no type named 'Crate'. It is imported as 'T/Crate'
;;
;; `prefix-types` gives the imported types a name of their own, and that name
;; replaces the bare one, as `prefix` replaces a def's. The refusal says what
;; the type is called here.

(import (std prelude))
(import (prefix-types "../inc/kitchen.bjo" "T/"))

(: (-> (Crate int) int))
(defun (f c) 1)

(defun (main) 0)
