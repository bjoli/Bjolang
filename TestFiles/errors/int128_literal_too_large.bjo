;; A literal at int128 is checked against its range, as at the eight.

;; EXPECT-ERROR: '170141183460469231731687303715884105728' does not fit in a 'int128'

(import (std prelude))

(: too-large (-> int128))
(defun (too-large) 170141183460469231731687303715884105728)

(defun (main args) (println (too-large)) 0)
