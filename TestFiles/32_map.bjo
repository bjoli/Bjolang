(import (std prelude))

(defun (main)
  ;; 1. Basic map operations
  (def m (map-empty))
  (println (if (map-empty? m) "empty: yes" "empty: no"))
  (println (map-length m))

  (def m1 (map-set m "a" 10))
  (def m2 (map-set (map-set m "a" 10) "b" 20))
  (println (if (map-empty? m1) "m1 empty: yes" "m1 empty: no"))
  (println (map-length m1))
  (println (map-length m2))
  (println (map-ref m2 "a"))
  (println (map-get m2 "b"))
  (println (map-get-or m2 "c" 999))
  (println (if (map-contains? m2 "a") "has a: yes" "has a: no"))
  (println (if (map-has-key? m2 "z") "has z: yes" "has z: no"))

  (def m3 (map-remove m2 "a"))
  (println (map-length m3))
  (println (if (map-contains? m3 "a") "has a: yes" "has a: no"))

  ;; 2. Merge and higher order functions
  (def ma (map-set (map-set (map-empty) "x" 1) "y" 2))
  (def mb (map-set (map-set (map-empty) "y" 20) "z" 30))
  (def merged (map-merge ma mb))
  (println (map-length merged))
  (println (map-ref merged "y"))
  (println (map-ref merged "z"))

  ;; Every Map callback takes the pair as one argument. The resolver of a
  ;; merge sees the key and the two values that collided under it, so its
  ;; argument is a triple.
  (def merged-with (map-merge-with (fun (kvv)
                                     (def (_ v1 v2) kvv)
                                     (+ v1 v2))
                                   ma mb))
  (println (map-ref merged-with "y"))

  (def doubled (map-map (fun (kv)
                          (def (_ . v) kv)
                          (* v 2))
                        ma))
  (println (map-ref doubled "x"))
  (println (map-ref doubled "y"))

  ;; The pair reaches a callback the same way anywhere else does, so it
  ;; destructures in the parameter list too.
  (def filtered (map-filter (fun (kv)
                              (def (_ . v) kv)
                              (> v 1))
                            ma))
  (println (map-length filtered))
  (println (map-ref filtered "y"))

  ;; Keys only move through map-map-values' sibling: the value mapper leaves
  ;; them alone and changes the value type.
  (def shown (map-map-values int->string ma))
  (println (map-ref shown "x"))

  (def direct (map-fold (fun (acc kv)
                          (def (_ . v) kv)
                          (+ acc v))
                        0 ma))
  (println direct)

  ;; The same fold reached through the Foldable trait, which is what the pair
  ;; shape is for: `%item` is one thing, so the folder takes one argument.
  (def sum (fold (fun (acc kv)
                   (def (_ . v) kv)
                   (+ acc v))
              0 ma))
  (println sum)

  ;; 3. Conversions
  (def l (Cons (Tuple "k1" 100) (Cons (Tuple "k2" 200) Nil)))
  (def mfromlist (list->map l))
  (println (map-length mfromlist))
  (println (map-ref mfromlist "k1"))
  (println (map-ref mfromlist "k2"))

  (def l2 (map->list mfromlist))
  (println (list-length l2))

  (println "Map tests passed!")
  0)
