;; The failure part of a top-level `def`, which has nothing to be the value of.
;;
;; The same refusal covers a `def*` clause, which is read as the `def` it would
;; have been.

;; EXPECT-ERROR: the top level is not a body

(import (std prelude))

(: found (-> (Option int)))
(defun (found) (Some 1))

(def (Some n) (found) 0)
