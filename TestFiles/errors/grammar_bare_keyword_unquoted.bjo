;; A bare keyword of a grammar is written as a quoted symbol. Outside a quote,
;; a symbol is a name. Thus the compiler reports a name without a binding, and
;; the grammar has no part in the message.
;; EXPECT-ERROR: Unbound variable: asc
(import (std prelude))

(def/grammar Q
  (:or (: CAsc 'asc)
       (: CPlain (symbol ...))))

(: render (-> Q string))
(defun (render q) "r")

(defun (main args)
  ;; The correct spelling is `'asc`. Here `asc` is a name without a binding.
  (println (render asc))
  0)
