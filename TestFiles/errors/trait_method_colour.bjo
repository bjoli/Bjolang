;; An implementation whose definer disagrees with the trait's arrow.
;;
;; An impl method writes no signature of its own — it inherits the trait's — so
;; this is the only place the two can meet, and it has to be checked rather than
;; unified: `recolour` repaints an inherited signature's outermost arrow with the
;; definer's colour before anything is unified, so a disagreement left to the
;; unifier is erased instead of reported.
;;
;; The colour is uniform across implementations, and the message says why. A
;; call dispatched through a dictionary decides whether to await before it knows
;; which implementation answered, so the claim belongs to the trait and every
;; impl keeps it.

;; EXPECT-ERROR: trait 'Fetcher' declares 'fetch' with -bjo->
;; EXPECT-ERROR: every implementation of it has to be able to suspend
;; EXPECT-ERROR: Define this one with defbjo

(import (std prelude))

(def/trait (Fetcher %a)
  (: fetch (-bjo-> %a string)))

(def/impl (Fetcher int)
  (defun (fetch x) "ordinary, and the trait said otherwise"))

(defun (main args) 0)
