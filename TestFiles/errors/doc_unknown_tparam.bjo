;; A type parameter the definition does not have.

;; EXPECT-ERROR: documents the type parameter %b, and Box has no %b. Its type parameters are %a

(import (std prelude))

(:doc Box (summary "A box.") (tparam %b "Nothing.") (field content "What is in it."))
(type (: (Box %a) (Record (: content %a))))

(defun (main args) 0)
