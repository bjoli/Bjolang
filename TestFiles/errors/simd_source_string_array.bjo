;; An array is a source of vectors only when its elements are a `Lane` type.

;; EXPECT-ERROR: no implementation of trait 'Lane' for 'string', needed by the implementation of 'SimdSource'

(import (std prelude))
(import (std simd))

(defun (main)
  (def a (make-array 8 #:fill "x"))
  (println (simd-lanes (simd256-load a 0)))
  0)
