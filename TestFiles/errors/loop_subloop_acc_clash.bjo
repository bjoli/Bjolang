;; A `:subloop` form's accumulator may not take the name of one of the loop's.

;; EXPECT-ERROR: 'total' at loop_subloop_acc_clash.bjo:10 is already an accumulator of this loop.

(import (std prelude))

(: f (-> (List (List int)) int))
(defun (f rows)
  (loop (:for row rows)
        (:subloop (:for y row)
                  (:acc total (summing y)))
        (:acc total (summing 1))
        => total))

(defun (main) (println (int->string (f '((1))))) 0)
