;; An escape is not a value. There is no type it could be given that would let
;; it be passed anywhere, so mentioning it without applying it is refused where
;; it stands rather than failing later as a type nobody wrote.

;; EXPECT-ERROR: is an escape, not a value

(import (std prelude))

(: f (-> (List int) (List int)))
(defun (f xs)
  (with-return ret
    (list-map ret xs)))
