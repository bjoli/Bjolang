;; A function whose where clause pins an associated type takes a dictionary
;; whose type argument is the pinned type, and has no type parameter for the
;; associated type. A variable that only a pin names is a type parameter.
(import (std prelude))

(export to-map count-with-cursor)

;; EXPECT-CS: tosubmap<T_s, T_k, T_v, T_s_cursor>\(Eq<T_k> \w+, Iterable<T_s, ValueTuple<T_k, T_v>, T_s_cursor> \w+, T_s s\)
;; EXPECT-NO-CS: T_s_elem
(: to-map (-> %s (Map %k %v)) (where (Eq %k) (Iterable %s #:elem (Tuple %k %v))))
(defun (to-map s) #:no-inline
  (loop (:for e s)
        (:acc m (mapping e))))

;; EXPECT-CS: countsubwithsubcursor<T_s, T_e, T_c>\(Iterable<T_s, T_e, T_c> \w+, T_s s\)
(: count-with-cursor (-> %s int) (where (Iterable %s #:elem %e #:cursor %c)))
(defun (count-with-cursor s) #:no-inline
  (let go ((c (iterable-start s)) (n 0))
    (if (iterable-done? s c)
        n
        (go (iterable-next s c) (+ n 1)))))
