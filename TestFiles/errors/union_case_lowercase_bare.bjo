;; A pattern reads a bare name that does not begin with a capital as a binder,
;; so a lowercase case written bare bound and matched every value. Written as a
;; list it is the constructor, and the error says so.
;; EXPECT-ERROR: blob is a case of Shape, but a bare name that does not begin with a capital is a variable
(type (: Shape (Union blob (: dot int) Big)))

(: show (-> Shape string))
(defun (show s) (match s (blob "a") ((dot _) "b") (Big "c")))

(defun (main args) 0)
