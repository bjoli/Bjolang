;; A facade in front of `inc/trait_reexport_origin.bjo`, passing on its type and
;; one method of its trait.
;;
;; `weigh` is a method of a keyed trait, so it is no binding here: it is bound
;; under its key, and `weigh` is a spelling of that. Re-exporting it publishes
;; the whole trait, `def/trait` and implementations, under the origin's key.
(export make-banana)

(import (std prelude))
(import "trait_reexport_origin.bjo")

(: make-banana (-> int Banana))
(defun (make-banana g) (Banana (grams g)))

(re-export Banana weigh)
