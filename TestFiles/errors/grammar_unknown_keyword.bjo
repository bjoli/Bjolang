;; A head symbol that is no keyword, where the grammar has no list without a
;; keyword. The grammar gives the keywords, so the message tells them.
;; EXPECT-ERROR: expected (from ...) or (where ...); found (pippe ...)
(import (std prelude))

(def/grammar Q
  (Q (:or (: CFrom (from symbol))
          (: CWhere (where Item))))
  (Item (:or (: ISym symbol))))

(: (-> Q string))
(defun (render q) "r")

(defun (main args)
  (println (render '(pippe x)))
  0)
