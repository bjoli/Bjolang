;; A conjunction covers the intersection of its conjuncts, which the
;; exhaustiveness check has no head constructor for. One conjunct that can fail
;; is the whole of what the conjunction matches; two is something it will not
;; guess at, so the clause covers nothing.

;; EXPECT-ERROR: does not cover every value
;; EXPECT-ERROR: _ reaches no clause

(import (std prelude))

(: f (-> int int))
(defun (f n)
  (match n
    ((and (:view even? #t) (:view (< 4 &) #t)) 1)))

(defun (main args)
  (println (int->string (f 6)))
  0)
