;; Passes on lengths from unit_types.bjo, whose units it declares nothing of,
;; for 511_unit_relay.bjo.
(import (std prelude))
(import "unit_types.bjo")

(export relay a-length)

(: relay (-> (double m) (double m)))
(defun (relay x) (same x))

(: a-length (-> (double m)))
(defun (a-length) (cast (double m) 2.5))
