;; A quoted literal read by a grammar from a compiled module.
;;
;; The compiler reads the grammar of `Item` from the metadata that
;; inc/proclit.bjo publishes. Two cases of `Item` carry a list. The grammar
;; says that only a written list is a `Sub`, so the nested literals below
;; are read here as in the declaring module.
(import (std prelude))
(import "inc/proclit.bjo")
(import (std simpletest))

(defun (main args)
  (expect "imported grammar, nested literal"
          (show-items '(a (b "c") d))
          "a (b c) d")

  ;; The splice-only case, written out. Its payload type is the expected
  ;; type of the literal inside it, as for a function's parameter.
  (expect "imported grammar, explicit case"
          (show-items (list (Sym 'x) (Args (list "y" "z"))))
          "x args:2")
  0)
