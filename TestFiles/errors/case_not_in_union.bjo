;; EXPECT-ERROR: Red is used here as a case_not_in_union/Shade, which has no case Red. It is a case of case_not_in_union/Light and case_not_in_union/Suit.
;;
;; The type decides which union, and that union has no case of the name.

(import (std prelude))

(type (: Light (Union Red Amber Green)))
(type (: Suit (Union Red Black)))
(type (: Shade (Union Dark Pale)))

(: s Shade)
(def s Red)

(defun (main) 0)
