;; `only-pair` takes two arguments and writes no clause for anything else.
;;
;; `syntax-match` adds that clause: a form no clause matched is a macro handed
;; something it does not accept, and the arm it adds says so against the form
;; itself. Writing one by hand — as the other macros in `inc/sm_macros.bjo` do —
;; only buys a message that can name the macro.
;;
;; EXPECT-ERROR: The macro 'only-pair' failed
;; EXPECT-ERROR: No clause of this syntax-match matched.
;; EXPECT-ERROR: (only-pair 1 2 3)

(import "../inc/sm_macros.bjo")

(defun (main args)
  (println (int->string (only-pair 1 2 3)))
  0)
