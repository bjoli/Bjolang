;; PARAFFINS -- Compute how many paraffins exist with N carbon atoms.
;; Arguments: count n expected
;;
;; A radical is `(H)` or `#(C r r r)` in the original, and a paraffin is
;; `#(BCP r r)` or `#(CCP r r r r)`. Here they are two unions. A partition is
;; a vector of ints in both.

(import "common.bjo")

(type-rec
  (: Radical (Union H (: C Radical Radical Radical))))

(type
  (: Paraffin (Union (: BCP Radical Radical)
                     (: CCP Radical Radical Radical Radical))))

(: three-partitions (-> int (List (Array int))))
(defun (three-partitions m)
  (let loop1 ((lst Nil) (nc1 (/ m 3)))
    (if (< nc1 0)
        lst
        (let loop2 ((lst lst) (nc2 (/ (- m nc1) 2)))
          (if (< nc2 nc1)
              (loop1 lst (- nc1 1))
              (loop2 (Cons #[nc1 nc2 (- m (+ nc1 nc2))] lst)
                     (- nc2 1)))))))

(: four-partitions (-> int (List (Array int))))
(defun (four-partitions m)
  (let loop1 ((lst Nil) (nc1 (/ m 4)))
    (if (< nc1 0)
        lst
        (let loop2 ((lst lst) (nc2 (/ (- m nc1) 3)))
          (if (< nc2 nc1)
              (loop1 lst (- nc1 1))
              (let ((start (max nc2 (- (/ (+ m 1) 2) (+ nc1 nc2)))))
                (let loop3 ((lst lst) (nc3 (/ (- m (+ nc1 nc2)) 2)))
                  (if (< nc3 start)
                      (loop2 lst (- nc2 1))
                      (loop3 (Cons #[nc1 nc2 nc3 (- m (+ nc1 (+ nc2 nc3)))] lst)
                             (- nc3 1))))))))))

(: gen (-> int (Tuple (List Paraffin) (List Paraffin))))
(defun (gen n)
  (def n/2 (/ n 2))
  (def radicals (make-array (+ n/2 1)))
  (def h-list (list H))
  (let fill ((i 0))
    (when (<= i n/2)
      (array-set! radicals i h-list)
      (fill (+ i 1))))

  (defun (rads-of-size (: n int)) : (List Radical)
    (defun (loop1 (: ps (List (Array int))) (: lst (List Radical))) : (List Radical)
      (if (list-empty? ps)
          lst
          (let* ((p (list-head ps))
                 (nc1 (array-ref p 0))
                 (nc2 (array-ref p 1))
                 (nc3 (array-ref p 2)))
            (defun (loop2 (: rads1 (List Radical)) (: lst (List Radical))) : (List Radical)
              (if (list-empty? rads1)
                  lst
                  (let ()
                    (defun (loop3 (: rads2 (List Radical)) (: lst (List Radical))) : (List Radical)
                      (if (list-empty? rads2)
                          lst
                          (let ()
                            (defun (loop4 (: rads3 (List Radical)) (: lst (List Radical))) : (List Radical)
                              (if (list-empty? rads3)
                                  lst
                                  (Cons (C (list-head rads1) (list-head rads2) (list-head rads3))
                                        (loop4 (list-tail rads3) lst))))
                            (loop4 (if (= nc2 nc3) rads2 (array-ref radicals nc3))
                                   (loop3 (list-tail rads2) lst)))))
                    (loop3 (if (= nc1 nc2) rads1 (array-ref radicals nc2))
                           (loop2 (list-tail rads1) lst)))))
            (loop2 (array-ref radicals nc1)
                   (loop1 (list-tail ps) lst)))))
    (loop1 (three-partitions (- n 1)) Nil))

  (defun (bcp-generator (: j int)) : (List Paraffin)
    (if (odd? j)
        Nil
        (let ()
          (defun (loop1 (: rads1 (List Radical)) (: lst (List Paraffin))) : (List Paraffin)
            (if (list-empty? rads1)
                lst
                (let ()
                  (defun (loop2 (: rads2 (List Radical)) (: lst (List Paraffin))) : (List Paraffin)
                    (if (list-empty? rads2)
                        lst
                        (Cons (BCP (list-head rads1) (list-head rads2))
                              (loop2 (list-tail rads2) lst))))
                  (loop2 rads1 (loop1 (list-tail rads1) lst)))))
          (loop1 (array-ref radicals (/ j 2)) Nil))))

  (defun (ccp-generator (: j int)) : (List Paraffin)
    (defun (loop1 (: ps (List (Array int))) (: lst (List Paraffin))) : (List Paraffin)
      (if (list-empty? ps)
          lst
          (let* ((p (list-head ps))
                 (nc1 (array-ref p 0))
                 (nc2 (array-ref p 1))
                 (nc3 (array-ref p 2))
                 (nc4 (array-ref p 3)))
            (defun (loop2 (: rads1 (List Radical)) (: lst (List Paraffin))) : (List Paraffin)
              (if (list-empty? rads1)
                  lst
                  (let ()
                    (defun (loop3 (: rads2 (List Radical)) (: lst (List Paraffin))) : (List Paraffin)
                      (if (list-empty? rads2)
                          lst
                          (let ()
                            (defun (loop4 (: rads3 (List Radical)) (: lst (List Paraffin))) : (List Paraffin)
                              (if (list-empty? rads3)
                                  lst
                                  (let ()
                                    (defun (loop5 (: rads4 (List Radical)) (: lst (List Paraffin))) : (List Paraffin)
                                      (if (list-empty? rads4)
                                          lst
                                          (Cons (CCP (list-head rads1) (list-head rads2)
                                                     (list-head rads3) (list-head rads4))
                                                (loop5 (list-tail rads4) lst))))
                                    (loop5 (if (= nc3 nc4) rads3 (array-ref radicals nc4))
                                           (loop4 (list-tail rads3) lst)))))
                            (loop4 (if (= nc2 nc3) rads2 (array-ref radicals nc3))
                                   (loop3 (list-tail rads2) lst)))))
                    (loop3 (if (= nc1 nc2) rads1 (array-ref radicals nc2))
                           (loop2 (list-tail rads1) lst)))))
            (loop2 (array-ref radicals nc1)
                   (loop1 (list-tail ps) lst)))))
    (loop1 (four-partitions (- j 1)) Nil))

  (let loop ((i 1))
    (if (> i n/2)
        (Tuple (bcp-generator n) (ccp-generator n))
        (let ()
          (array-set! radicals i (rads-of-size i))
          (loop (+ i 1))))))

(: nb (-> int int))
(defun (nb n)
  (match (gen n)
    ((Tuple bcps ccps) (+ (list-length bcps) (list-length ccps)))))

(defun (main args)
  (def n (arg-int args 1))
  (def expected (arg-int args 2))
  (run-benchmark "paraffins" (arg-int args 0) (fun () (nb n)) #(= & expected)))
