  (summary "32 lanes of @code{byte}: @code{(Simd256 byte)}."))

(:doc SimdSource
  (summary "What vectors are loaded from: elements of one type, one after the other in memory.")
  (tparam %s "The source: @code{(Array %a)} or @code{(MutableVec %a)}.")
  (see simd128-load simd256-load simd256-whole simd-source-length)
  (reference """
    A string is not a source. Its positions are cursors, and a lane of its
    bytes would be a byte index. For a byte search, @code{string->bytes}
    gives an array.
    """))

(:doc simd-source-length
  (summary "How many elements a source has: the length of the array or the @code{MutableVec}.")
  (arg s "The source.")
  (returns "The number of elements."))

(:doc simd-mask-bits
  (summary "A mask as an int: bit i is set where lane i of the mask is.")
  (arg mask "The mask.")
  (returns "The bits. A 32-lane mask with its last lane set is a negative int.")
  (see simd-first-true simd-count-true)
  (example """
    (import (std maths))

    ;; The index of every comma in the 32 bytes of the array a from i.
    (defun (commas a i)
      (def bits (simd-mask-bits (simd-eq (simd256-load a i) (simd256-splat 44uy))))
      (loop (:with b bits (bitwise-and b (- b 1)))
            (:while (not (= b 0)))
            (:acc out (listing (+ i (trailing-zeros b))))
            => out))
    """)
  (reference """
    The CPU's move-mask instruction: one instruction for a whole vector.
    Each lane gives its top bit, which is every bit of a mask's lane.
    """))

(:doc simd-shift-left
  (summary "Shifts every lane left by the same number of bits.")
  (arg v "The vector, of integer lanes.")
  (arg n "The number of bits.")
  (returns "The shifted lanes. Bits shifted out are lost, and zeros come in.")
  (reference """
    The count is taken modulo the lane's width in bits, as the scalar
    shifts take it: shifting an @code{Int32x4} by 33 shifts it by 1.
    """)
  (see simd-shift-right simd-shift-right-logical))

(:doc simd-shift-right
  (summary "Shifts every lane right: arithmetic for signed lanes, logical for unsigned ones.")
  (arg v "The vector, of integer lanes.")
  (arg n "The number of bits.")
  (returns "The shifted lanes. A signed lane keeps its sign, as @code{shift-right} does.")
  (see simd-shift-right-logical simd-shift-left))

(:doc simd-shift-right-logical
  (summary "Shifts every lane right, with zeros coming in, for any integer lane type.")
  (arg v "The vector, of integer lanes.")
  (arg n "The number of bits.")
  (returns "The shifted lanes.")
  (see simd-shift-right simd-shift-left))

(:doc simd-add
  (summary "Adds the lanes of two vectors.")
  (arg a "The first vector.")
  (arg b "The second vector.")
  (returns "The lane-wise sums."))

(:doc simd-sub
  (summary "Subtracts the lanes of @code{b} from the lanes of @code{a}.")
  (arg a "The vector to subtract from.")
  (arg b "The vector to subtract.")
  (returns "The lane-wise differences."))

(:doc simd-mul
  (summary "Multiplies the lanes of two vectors.")
  (arg a "The first vector.")
  (arg b "The second vector.")
  (returns "The lane-wise products."))

(:doc simd-div
  (summary "Divides the float lanes of @code{a} by those of @code{b}. A lane divided by 0 is an infinity, or NaN for 0 by 0.")
  (arg a "The dividends.")
  (arg b "The divisors.")
  (returns "The lane-wise quotients."))

(:doc simd-scale
  (summary "Multiplies every lane by one number.")
  (arg v "The vector.")
  (arg k "The factor.")
  (returns "Each lane times @code{k}."))

(:doc simd-neg
  (summary "Negates every lane.")
  (arg v "The vector.")
  (returns "The negated lanes."))

(:doc simd-abs
  (summary "The absolute value of every lane.")
  (arg v "The vector.")
  (returns "The absolute values."))

(:doc simd-min
  (summary "The lesser of each pair of lanes.")
  (arg a "The first vector.")
  (arg b "The second vector.")
  (returns "The lane-wise minimums."))

(:doc simd-max
  (summary "The greater of each pair of lanes.")
  (arg a "The first vector.")
  (arg b "The second vector.")
  (returns "The lane-wise maximums."))

(:doc simd-sqrt
  (summary "The square root of every float lane. A negative lane gives NaN.")
  (arg v "The vector.")
  (returns "The square roots."))

(:doc simd-floor
  (summary "Every float lane rounded down, toward negative infinity.")
  (arg v "The vector.")
  (returns "The rounded lanes, still floats."))

(:doc simd-ceiling
  (summary "Every float lane rounded up, toward positive infinity.")
  (arg v "The vector.")
  (returns "The rounded lanes, still floats."))

(:doc simd-round
  (summary "Every float lane rounded to the nearest integer, and from halfway to the even one.")
  (arg v "The vector.")
  (returns "The rounded lanes, still floats: 0.5 and 1.5 give 0 and 2.")
  (see simd128-float->int-truncating))

(:doc simd-truncate
  (summary "Every float lane rounded toward zero.")
  (arg v "The vector.")
  (returns "The rounded lanes, still floats."))

(:doc simd-nan?
  (summary "A mask of the float lanes that are NaN.")
  (arg v "The vector.")
  (returns "A mask."))

(:doc simd-mul-add
  (summary "@code{a * b + c} in every float lane, rounded once.")
  (arg a "The first factors.")
  (arg b "The second factors.")
  (arg c "What is added to the products.")
  (returns "The lanes of @code{a * b + c}.")
  (reference """
    One fused instruction where the CPU has one (FMA3 on x86-64, every
    ARM64). Rounded once, so it can differ in the last bit from
    @code{(simd-add (simd-mul a b) c)}, which rounds twice.
    """))

(:doc simd-shuffle
  (summary "The lanes of @code{v}, in the order @code{idx} says: lane i of the result is lane @code{(simd-ref idx i)} of @code{v}.")
  (arg v "The vector, of integer lanes.")
  (arg idx "The lane to take for each lane, of the same type. An index past the last lane gives 0.")
  (returns "The rearranged lanes.")
  (see simd-lookup simd-bits->int64)
  (example """
    (simd-shuffle (simd128-of 10 20 30 40) (simd128-of 3 2 1 0))   ; 40 30 20 10
    (simd-shuffle v (simd128-of 0 0 0 0))                          ; lane 0 in every lane

    ;; Float lanes, through their bits.
    (simd-bits->float64 (simd-shuffle (simd-bits->int64 xs) (simd128-of 1L 0L)))
    """)
  (reference """
    One instruction where the indices are known and the CPU has it: SSSE3
    or AVX2 on x86-64, @code{tbl} on ARM64. Indices that are not constant
    cost a little more. At 256 bits, AVX2 moves bytes and shorts only within
    each half of 16 bytes, so a shuffle that takes a lane from the other
    half is a few instructions.
    """))

(:doc simd-lookup
  (summary "Each byte of @code{idx} looked up in a table of 16 bytes. An index of 16 or more gives 0.")
  (arg table "The table: a @code{UInt8x16}, entry i at lane i.")
  (arg idx "The indices, a @code{UInt8x16} or @code{UInt8x32}.")
  (returns "The entries, a vector of the type of @code{idx}.")
  (see simd-shuffle simd-shift-right-logical)
  (example """
    ;; Which bytes are ASCII digits, by their two halves. A byte's high
    ;; half picks a set of low halves from one table, its low half a bit
    ;; from the other: bit 0 is "a digit's low half", and only high half 3
    ;; allows it.
    (def low-table  (simd128-of 1uy 1uy 1uy 1uy 1uy 1uy 1uy 1uy 1uy 1uy))   ; 0-9
    (def high-table (simd128-of 0uy 0uy 0uy 1uy))                         ; 0x30-0x3F
    (: digits (-> UInt8x32 (Mask256 byte)))
    (defun (digits bytes)
      (def lo (simd-lookup low-table (simd-and bytes (simd256-splat 15uy))))
      (def hi (simd-lookup high-table (simd-shift-right bytes 4)))
      (simd-ne (simd-and lo hi) (simd256-zero)))
    """)
  (reference """
    The instruction is @code{pshufb} on x86-64 and @code{tbl} on ARM64:
    16 lookups for a @code{UInt8x16} and 32 for a @code{UInt8x32}, in one
    instruction. A @code{UInt8x32} looks up its two halves in the same
    table. With a table for each half of a byte, as in the example, a
    vector of bytes is classified into up to eight sets at once: digits,
    spaces, the characters a JSON or CSV parser stops at. With a table of
    characters, it converts: @code{"0123456789abcdef"} gives hex digits.
    """))

(:doc simd-add-saturating
  (summary "Adds the integer lanes, and gives the type's greatest or least value where the sum does not fit.")
  (arg a "The first vector.")
  (arg b "The second vector.")
  (returns "The lane-wise sums, saturated: 250uy plus 10uy is 255uy."))

(:doc simd-sub-saturating
  (summary "Subtracts the integer lanes, and gives the type's greatest or least value where the difference does not fit.")
  (arg a "The vector to subtract from.")
  (arg b "The vector to subtract.")
  (returns "The lane-wise differences, saturated: 5uy minus 10uy is 0uy."))

(:doc simd-and-not
  (summary "The bits of @code{a} that are not set in @code{b}. Of two masks, the lanes set in the first only.")
  (arg a "The first vector or mask.")
  (arg b "The second, whose bits are taken away.")
  (returns "The bits of @code{a} and not @code{b}."))

(:doc simd-and
  (summary "The bitwise and of two vectors. Combines two masks into the lanes set in both.")
  (arg a "The first vector.")
  (arg b "The second vector.")
  (returns "The bitwise and."))

(:doc simd-or
  (summary "The bitwise or of two vectors. Combines two masks into the lanes set in either.")
  (arg a "The first vector.")
  (arg b "The second vector.")
  (returns "The bitwise or."))

(:doc simd-xor
  (summary "The bitwise exclusive or of two vectors.")
  (arg a "The first vector.")
  (arg b "The second vector.")
  (returns "The bitwise exclusive or."))

(:doc simd-not
  (summary "Inverts every bit. Turns a mask into the lanes it does not set.")
  (arg v "The vector.")
  (returns "The inverted bits."))

(:doc simd-eq
  (summary "A mask of the lanes where @code{a} equals @code{b}. NaN equals nothing.")
  (arg a "The first vector.")
  (arg b "The second vector.")
  (returns "A mask."))

(:doc simd-ne
  (summary "A mask of the lanes where @code{a} does not equal @code{b}. NaN differs from everything.")
  (arg a "The first vector.")
  (arg b "The second vector.")
  (returns "A mask.")
  (example """
    (simd-ne v (simd256-zero))   ; the lanes that are not 0: a mask from -1/0 lanes kept in memory
    """))

(:doc simd-lt
  (summary "A mask of the lanes where @code{a} is less than @code{b}.")
  (arg a "The first vector.")
  (arg b "The second vector.")
  (returns "A mask."))

(:doc simd-le
  (summary "A mask of the lanes where @code{a} is less than or equal to @code{b}.")
  (arg a "The first vector.")
  (arg b "The second vector.")
  (returns "A mask."))

(:doc simd-gt
  (summary "A mask of the lanes where @code{a} is greater than @code{b}.")
  (arg a "The first vector.")
  (arg b "The second vector.")
  (returns "A mask."))

(:doc simd-ge
  (summary "A mask of the lanes where @code{a} is greater than or equal to @code{b}.")
  (arg a "The first vector.")
  (arg b "The second vector.")
  (returns "A mask."))

(:doc simd-select
  (summary "Each lane from @code{a} where @code{mask} is set, and from @code{b} where it is not. The mask is a comparison's of vectors of the same type.")
  (arg mask "Which lanes to take from @code{a}.")
  (arg a "The lanes where the mask is set.")
  (arg b "The lanes where the mask is not set.")
  (returns "The selected lanes."))

(:doc simd-any?
  (summary "Whether any lane of a mask is set.")
  (arg mask "The mask.")
  (returns "#t when at least one lane is set."))

(:doc simd-all?
  (summary "Whether every lane of a mask is set.")
  (arg mask "The mask.")
  (returns "#t when every lane is set."))

(:doc simd-count-true
  (summary "How many lanes of a mask are set.")
  (arg mask "The mask.")
  (returns "The number of lanes that are set."))

(:doc simd-first-true
  (summary "The index of the first lane of a mask that is set, or -1.")
  (arg mask "The mask.")
  (returns "The lowest index of a set lane, or -1."))

(:doc simd-sum
  (summary "The sum of the lanes.")
  (arg v "The vector.")
  (returns "The sum."))

(:doc simd-dot
  (summary "The sum of the products of the lanes.")
  (arg a "The first vector.")
  (arg b "The second vector.")
  (returns "The dot product."))

(:doc simd-ref
  (summary "The lane at an index. Raises @code{ArgumentOutOfRangeException} outside the lanes.")
  (arg v "The vector.")
  (arg i "The lane, from 0.")
  (returns "The number in the lane."))

(:doc simd-with
  (summary "The vector with one lane replaced. Raises @code{ArgumentOutOfRangeException} outside the lanes.")
  (arg v "The vector.")
  (arg i "The lane, from 0.")
  (arg x "The new number.")
  (returns "A vector of the same lanes but the one at @code{i}.")
  (see simd128-of simd-ref))

(:doc simd-mask->lanes
  (summary "The vector a mask holds: every bit of a lane set where the mask is, and none where it is not.")
  (arg mask "The mask.")
  (returns "For integer lanes, -1 where set and 0 where not. For float lanes, the same bits, which are NaN.")
  (example """
    ;; Matches counted lane by lane: subtracting -1 adds one.
    (simd-sub counts (simd-mask->lanes (simd-eq bytes needle)))
    """))

(:doc simd-bits->int8
  (summary "The same bits, as lanes of @code{System.SByte}.")
  (arg v "The vector.")
  (returns "An @code{Int8x16} or @code{Int8x32}."))

(:doc simd-bits->uint8
  (summary "The same bits, as lanes of @code{byte}.")
  (arg v "The vector.")
  (returns "A @code{UInt8x16} or @code{UInt8x32}."))

(:doc simd-bits->int16
  (summary "The same bits, as lanes of @code{short}.")
  (arg v "The vector.")
  (returns "An @code{Int16x8} or @code{Int16x16}."))

(:doc simd-bits->uint16
  (summary "The same bits, as lanes of @code{ushort}.")
  (arg v "The vector.")
  (returns "A @code{UInt16x8} or @code{UInt16x16}."))

(:doc simd-bits->int32
  (summary "The same bits, as lanes of @code{int}.")
  (arg v "The vector.")
  (returns "An @code{Int32x4} or @code{Int32x8}."))

(:doc simd-bits->uint32
  (summary "The same bits, as lanes of @code{uint}.")
  (arg v "The vector.")
  (returns "A @code{UInt32x4} or @code{UInt32x8}."))

(:doc simd-bits->int64
  (summary "The same bits, as lanes of @code{long}.")
  (arg v "The vector.")
  (returns "An @code{Int64x2} or @code{Int64x4}.")
  (example """
    (simd-bits->int64 (simd-mask->lanes (simd-lt xs ys)))   ; -1 and 0, from doubles
    """))

(:doc simd-bits->uint64
  (summary "The same bits, as lanes of @code{ulong}.")
  (arg v "The vector.")
  (returns "A @code{UInt64x2} or @code{UInt64x4}."))

(:doc simd-bits->float32
  (summary "The same bits, as lanes of @code{System.Single}.")
  (arg v "The vector.")
  (returns "A @code{Float32x4} or @code{Float32x8}."))

(:doc simd-bits->float64
  (summary "The same bits, as lanes of @code{double}.")
  (arg v "The vector.")
  (returns "A @code{Float64x2} or @code{Float64x4}."))

(:doc simd128-widen-lower
  (summary "The lower half of the lanes, each widened to twice the bits.")
  (arg v "The vector.")
  (returns "A vector of the wider type: @code{UInt8x16} gives @code{UInt16x8}.")
  (see simd128-widen-upper SimdWiden))

(:doc simd128-widen-upper
  (summary "The upper half of the lanes, each widened to twice the bits.")
  (arg v "The vector.")
  (returns "A vector of the wider type.")
  (see simd128-widen-lower SimdWiden))

(:doc simd256-widen-lower
  (summary "The lower half of the lanes, each widened to twice the bits.")
  (arg v "The vector.")
  (returns "A vector of the wider type: @code{UInt8x32} gives @code{UInt16x16}.")
  (see simd256-widen-upper SimdWiden))

(:doc simd256-widen-upper
  (summary "The upper half of the lanes, each widened to twice the bits.")
  (arg v "The vector.")
  (returns "A vector of the wider type.")
  (see simd256-widen-lower SimdWiden))

(:doc simd128-narrow-wrapping
  (summary "Two vectors into one of half the bits a lane, keeping the low bits of each.")
  (arg lower "The vector whose lanes become the lower half.")
  (arg upper "The vector whose lanes become the upper half.")
  (returns "The narrowed lanes: an @code{int} 300 becomes the @code{short} 300, and 70000 becomes 4464.")
  (see simd128-narrow-saturating SimdNarrow))

(:doc simd128-narrow-saturating
  (summary "Two vectors into one of half the bits a lane, giving the nearest value that fits.")
  (arg lower "The vector whose lanes become the lower half.")
  (arg upper "The vector whose lanes become the upper half.")
  (returns "The narrowed lanes: an @code{int} 70000 becomes the @code{short} 32767.")
  (see simd128-narrow-wrapping SimdNarrow))

(:doc simd256-narrow-wrapping
  (summary "Two vectors into one of half the bits a lane, keeping the low bits of each.")
  (arg lower "The vector whose lanes become the lower half.")
  (arg upper "The vector whose lanes become the upper half.")
  (returns "The narrowed lanes.")
  (see simd256-narrow-saturating SimdNarrow))

(:doc simd256-narrow-saturating
  (summary "Two vectors into one of half the bits a lane, giving the nearest value that fits.")
  (arg lower "The vector whose lanes become the lower half.")
  (arg upper "The vector whose lanes become the upper half.")
  (returns "The narrowed lanes.")
  (see simd256-narrow-wrapping SimdNarrow))

(:doc simd128-int->float
  (summary "Integer lanes as float lanes of the same bits: @code{int} to @code{System.Single}, @code{long} to @code{double}.")
  (arg v "The vector.")
  (returns "The floats, each the nearest to its integer.")
  (see simd128-float->int-truncating SimdIntToFloat))

(:doc simd256-int->float
  (summary "Integer lanes as float lanes of the same bits.")
  (arg v "The vector.")
  (returns "The floats, each the nearest to its integer.")
  (see simd256-float->int-truncating SimdIntToFloat))

(:doc simd128-float->int-truncating
  (summary "Float lanes as signed integer lanes of the same bits, rounded toward zero.")
  (arg v "The vector.")
  (returns "The integers. Past the range, the type's least or greatest value; NaN gives 0.")
  (see simd-round simd128-float->uint-truncating SimdFloatToInt)
  (example """
    (simd128-float->int-truncating (simd-round v))   ; to the nearest, then exact
    """))

(:doc simd256-float->int-truncating
  (summary "Float lanes as signed integer lanes of the same bits, rounded toward zero.")
  (arg v "The vector.")
  (returns "The integers. Past the range, the type's least or greatest value; NaN gives 0.")
  (see simd256-float->uint-truncating SimdFloatToInt))

(:doc simd128-float->uint-truncating
  (summary "Float lanes as unsigned integer lanes of the same bits, rounded toward zero.")
  (arg v "The vector.")
  (returns "The integers. A negative lane gives 0, past the range the greatest value, and NaN 0.")
  (see simd128-float->int-truncating SimdFloatToInt))

(:doc simd256-float->uint-truncating
  (summary "Float lanes as unsigned integer lanes of the same bits, rounded toward zero.")
  (arg v "The vector.")
  (returns "The integers. A negative lane gives 0, past the range the greatest value, and NaN 0.")
  (see simd256-float->int-truncating SimdFloatToInt))

(:doc simd-store!
  (summary "Writes the lanes into an array, from an index. Raises when they do not fit.")
  (arg v "The vector.")
  (arg a "The array to write.")
  (arg i "The index of the first lane in the array."))

(:doc simd-lanes
  (summary "How many lanes the vector has.")
  (arg v "The vector. Only its type is read.")
  (returns "The number of lanes."))

(:doc simd128-splat
  (summary "A 128-bit vector with the number in every lane.")
  (arg x "The number.")
  (returns "The vector."))

(:doc simd128-zero
  (summary "A 128-bit vector of zeros. Its element type comes from where it is used.")
  (returns "The vector."))

(:doc simd128-of
  (summary "A 128-bit vector of the given lanes, from lane 0.")
  (form (simd128-of x more ...))
  (arg x "Lane 0.")
  (rest more "The lanes after it.")
  (see simd-with simd128-splat)
  (example """
    (simd128-of 1 2 3 4)          ; an Int32x4
    (simd128-of 1.5 2.5)          ; a Float64x2
    """)
  (reference """
    Each value is written into a vector of zeros with @code{simd-with}, so a
    lane not given is 0, and a value past the last lane raises
    @code{ArgumentOutOfRangeException}. The element type is the values'.
    """))

(:doc simd128-load
  (summary "The 128-bit vector of the elements of a source from an index.")
  (arg s "The array or @code{MutableVec}.")
  (arg i "The index of the first lane.")
  (returns "The vector.")
  (reference """
    Raises @code{ArgumentOutOfRangeException} when fewer than a vector's
    lanes of elements are left from @code{i}.
    """))

(:doc simd128-lanes
  (summary "How many elements of the source one 128-bit vector holds.")
  (arg s "The source. Only its type is read.")
  (returns "The number of lanes."))

(:doc simd128-whole
  (summary "The length of the source, rounded down to whole 128-bit vectors.")
  (arg s "The array or @code{MutableVec}.")
  (returns "The index of the first element after the last whole vector."))

(:doc simd128-accelerated?
  (summary "Whether the CPU runs 128-bit vector operations as instructions, not emulated."))

(:doc simd256-splat
  (summary "A 256-bit vector with the number in every lane.")
  (arg x "The number.")
  (returns "The vector."))

(:doc simd256-zero
  (summary "A 256-bit vector of zeros. Its element type comes from where it is used.")
  (returns "The vector."))

(:doc simd256-of
  (summary "A 256-bit vector of the given lanes, from lane 0.")
  (form (simd256-of x more ...))
  (arg x "Lane 0.")
  (rest more "The lanes after it.")
  (see simd-with simd256-splat)
  (example """
    (simd256-of 1.0 2.0 3.0 4.0)  ; a Float64x4
    """)
  (reference """
    Each value is written into a vector of zeros with @code{simd-with}, so a
    lane not given is 0, and a value past the last lane raises
    @code{ArgumentOutOfRangeException}. The element type is the values'.
    """))

(:doc simd256-load
  (summary "The 256-bit vector of the elements of a source from an index.")
  (arg s "The array or @code{MutableVec}.")
  (arg i "The index of the first lane.")
  (returns "The vector.")
  (reference """
    Raises @code{ArgumentOutOfRangeException} when fewer than a vector's
    lanes of elements are left from @code{i}.
    """))

(:doc simd256-lanes
  (summary "How many elements of the source one 256-bit vector holds.")
  (arg s "The source. Only its type is read.")
  (returns "The number of lanes."))

(:doc simd256-whole
  (summary "The length of the source, rounded down to whole 256-bit vectors.")
  (arg s "The array or @code{MutableVec}.")
  (returns "The index of the first element after the last whole vector."))

(:doc simd256-accelerated?
  (summary "Whether the CPU runs 256-bit vector operations as instructions, not emulated."))
