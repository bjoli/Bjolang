(import (std prelude))
(import (std simpletest))
(import (std text))

;; A text of `n` numbered lines, a few characters of them not ASCII.
(: (-> int string))
(defun (lines-of n)
  (def b (stringbuilder-empty))
  (loop (:for i (range 0 n)) (:do (stringbuilder-add-string! b #"line ${i}: blåbär €\n")))
  (stringbuilder->string b))

(: (-> (-> void) string))
(defun (outcome f)
  (def inner (fun () (match (try (f) #:catch (System.ArgumentOutOfRangeException)) ((Ok _) "done") ((Err _) "out of range"))))
  (match (try (inner) #:catch (System.ArgumentException)) ((Ok s) s) ((Err _) "mid-character")))

(: (-> int string string))
(defun (repeated n s)
  (def b (stringbuilder-empty))
  (loop (:for _ (range 0 n)) (:do (stringbuilder-add-string! b s)))
  (stringbuilder->string b))

(defun (main)
  ;; The module's example.
  (def r (string->text "hello world\nsecond line"))
  (def c5 (text-cursor-forward r (text-cursor-start r) 5))
  (def r2 (text-insert r c5 ","))
  (expect "insert" (text->string r2) "hello, world\nsecond line")
  (def d5 (text-cursor-forward r2 (text-cursor-start r2) 5))
  (expect "delete" (text->string (text-delete r2 d5 (text-cursor-next r2 d5))) "hello world\nsecond line")
  (expect "a line" (text->string (text-line r2 1)) "second line")
  (def w (option-ref (text-search r2 "world")))
  (expect "a search" (text->string (text-substring r2 w (text-cursor-end r2))) "world\nsecond line")
  (expect "its line" (text-cursor-line r2 w) 0)
  (expect "the old text is unchanged" (text->string r) "hello world\nsecond line")

  ;; A text of many chunks.
  (def text (lines-of 2000))
  (def big (string->text text))
  (expect "a tree" (> (text-height big) 0) #t)
  (expect "sound" (text-check big) None)
  (expect "bytes" (text-length big) (string-length text))
  (expect "characters" (text-count big) (string-count text))
  (expect "lines" (text-line-count big) 2001)
  (expect "line 1234" (text->string (text-line big 1234)) "line 1234: blåbär €")
  (def l1234 (text-cursor-at-line big 1234))
  (expect "the line of its start" (text-cursor-line big l1234) 1234)
  (def (Tuple a b) (text-split-at big (text-cursor-at-line big 1500)))
  (expect "split and append" (= (text-append a b) big) #t)
  (expect "equal texts hash alike" (= (eq-hash (text-append a b)) (eq-hash big)) #t)
  (expect "a substring"
          (text->string (text-substring big (text-cursor-at-line big 5) (text-cursor-at-line big 10)))
          (string-join (vec-map (fun (i) #"line ${i}: blåbär €\n") [5 6 7 8 9]) ""))
  (expect "a match across chunks" (text-search big "line 1999: ") (Some (text-cursor-at-line big 1999)))
  (expect "character n, found by the counts"
          (text-cursor-ref big (text-cursor-forward big (text-cursor-start big) (string-count (string-take text 30001))))
          (string-cursor-ref text (string-cursor-forward text (string-cursor-start text) (string-count (string-take text 30001)))))

  ;; Typing into a transient, at character indices, with a text taken halfway.
  (def t (text->transienttext big))
  (def at (string-count (substring text (string-cursor-start text)
                                   (option-ref (string-search text "line 1000:")))))
  (loop (:for i (range 0 500)) (:do (transienttext-insert! t (+ at i) "x")))
  (def mid (transienttext->text t))
  (loop (:for _ (range 0 200)) (:do (transienttext-delete! t (+ at 299) (+ at 300))))
  (transienttext-insert! t at "€")
  (def done (transienttext->text t))
  (expect "the transient's length" (transienttext-length t) (+ (string-length text) 303))
  (expect "the transient's count" (transienttext-count t) (+ (string-count text) 301))
  (def m0 (text-cursor-forward mid (text-cursor-start mid) at))
  (expect "the text taken halfway" (text->string (text-substring mid m0 (text-cursor-forward mid m0 500))) (repeated 500 "x"))
  (expect "is sound" (text-check mid) None)
  (expect "the text at the end" (text->string (text-line done 1000)) #"€${(repeated 300 "x")}line 1000: blåbär €")
  (expect "is sound too" (text-check done) None)
  (expect "the first text is unchanged" (text->string big) text)

  ;; Cursors.
  (def tr (string->text "one two\nthree"))
  (def c (option-ref (text-search tr "two")))
  (expect "its character" (text-cursor-ref tr c) #\t)
  (expect "four on" (text-cursor-line tr (text-cursor-forward tr c 4)) 1)
  (expect "a loop from it" (loop (:for ch c) (:acc (stringing ch))) "two\nthree")
  (expect "a loop back from it" (loop (:for ch (text-backward tr c)) (:acc (stringing ch))) " eno")
  (expect "the column" (text-cursor-column tr (text-cursor-forward tr c 6)) 2)
  (expect "a line down, same column"
          (text-cursor-at-line tr 1 #:column (text-cursor-column tr c)) (text-cursor-forward tr (text-cursor-start tr) 12))
  (expect "the end of its line" (text-cursor-line-end tr c) (text-cursor-forward tr c 3))
  (expect "back to a space" (text-cursor-find-backward char-whitespace? tr c) (Some (text-cursor-back tr c 1)))
  (expect "between two cursors" (text->string (text-substring tr c (text-cursor-line-end tr c))) "two")
  (def bc (text-cursor-at-line big 1500))
  (expect "a search back across chunks" (text-cursor-search-backward big bc "line 1234: ") (Some l1234))
  (expect "steps across chunks" (text-cursor-back big (text-cursor-forward big bc 5000) 5000) bc)
  (expect "cursors compare" (text-cursor<? (text-cursor-start big) bc) #t)
  (expect "the index of a cursor" (text-cursor-index big (text-cursor-forward big bc 5000)) (+ (text-cursor-index big bc) 5000))
  (expect "an index carried across an edit"
          (let ((i (text-cursor-index tr c)) (tr2 (text-insert tr (text-cursor-start tr) "é ")))
            (text-cursor-ref tr2 (text-cursor-forward tr2 (text-cursor-start tr2) (+ i 2))))
          #\t)

  ;; Collecting.
  (def words (list "one" " " "two" " " "three"))
  (expect "texting" (text->string (loop (:for w words) (:acc (texting w)))) "one two three")
  (expect "texting into a text" (text->string (loop (:for w words) (:acc (texting w #:into (string->text "> "))))) "> one two three")
  (expect "texting many lines" (loop (:for i (range 0 2000)) (:acc (texting #"line ${i}: blåbär €\n"))) big)
  (expect "add" (text->string (add (string->text "ab") "cd")) "abcd")
  (def tb (textbuilder-empty))
  (add-all! tb words)
  (expect "add-all! to a builder" (text->string (textbuilder->text tb)) "one two three")
  (expect "texting characters" (text->string (loop (:for ch (string->text "abc")) (:acc (texting (char-upcase ch))))) "ABC")

  ;; As a string has them.
  (def s (string->text "  one, two, three  "))
  (expect "take characters" (text->string (text-take (string->text "blåbär") 3)) "blå")
  (expect "drop characters" (text->string (text-drop (string->text "blåbär") 3)) "bär")
  (expect "replace" (text->string (text-replace s "," ";")) "  one; two; three  ")
  (expect "split" (vec-map text->string (text-split (text-trim s) ", ")) ["one" "two" "three"])
  (expect "join" (text->string (text-join (text-split (text-trim s) ", ") "+")) "one+two+three")
  (expect "trim" (text->string (text-trim s)) "one, two, three")
  (expect "pad" (text->string (text-pad-left (string->text "7") 3 #:with #\0)) "007")
  (expect "reverse" (text->string (text-reverse (string->text "blåbär"))) "räbålb")
  (expect "a search" (text-search s "two") (Some (text-cursor-forward s (text-cursor-start s) 7)))
  (expect "a replace across chunks" (text-replace big "blåbär" "x") (string->text (string-replace text "blåbär" "x")))
  (expect "ref by a cursor" (ref s (text-cursor-forward s (text-cursor-start s) 2)) #\o)
  (expect "a fold" (text-fold (fun (ch n) (if (char=? ch #\,) (+ n 1) n)) 0 s) 2)
  (expect "a list" (text->list (string->text "aé")) (list #\a #\é))

  ;; Errors.
  (def bs (text-cursor-start big))
  (expect "a cursor moved past the end" (outcome (fun () (ignore (text-cursor-forward big bs (+ (text-count big) 1))))) "out of range")
  (expect "a range that ends before it starts" (outcome (fun () (ignore (text-substring big bc bs)))) "out of range")
  (expect "a transient index outside" (outcome (fun () (transienttext-insert! t (+ (transienttext-count t) 1) "x"))) "out of range")
  (expect "the transient is unchanged" (transienttext->text t) done)
  0)
