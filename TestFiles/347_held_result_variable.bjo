(import (std prelude))
(import (std simpletest))

;; A local function whose type variable appears only in its result is
;; monomorphic in it, and a sibling that uses it shares that one type.
;; See errors/held_result_variable_shared.bjo for two types.

(defun (main args)
  (defun (mk) Nil)
  (defun (g x) (cons x (mk)))
  (expect "one use" (list-length (g 1)) 1)
  (expect "another use at the same type" (list-length (g 2)) 1)
  0)
