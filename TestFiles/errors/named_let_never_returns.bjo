;; EXPECT-ERROR: the loop 'more' at
;; A named let whose every branch calls it again never returns, so nothing
;; gives its result a type. The trait `length` needs is reported as that,
;; at the loop.

(import (std prelude))

(defun (main args)
  (def xs
    (let more ((i 0))
      (if (> i 3) (more 0) (more (+ i 1)))))
  (println (displayed (length xs)))
  0)
