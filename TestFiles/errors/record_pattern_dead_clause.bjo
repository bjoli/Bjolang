;; A record pattern whose fields all match anything covers the whole type.

;; EXPECT-ERROR: this clause can never run

(import (std prelude))

(type (: Car (Record (: brand string) (: year int))))

(: f (-> Car string))
(defun (f c)
  (match c
    ((Car (brand b)) b)
    (_ "")))

(defun (main args)
  (println (f (Car (brand "a") (year 1))))
  0)
