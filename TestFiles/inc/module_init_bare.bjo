;; A module-level value whose initialiser starts a fiber with no scope of
;; its own, for 501_module_init_scope.bjo. Its use raises, and .NET then
;; refuses each use of this module, so it has a module of its own.

(import (std prelude))
(export started-bare)

(: (Promise Unit))
(def started-bare (bjo (sync (timeout (milliseconds 50)))))
