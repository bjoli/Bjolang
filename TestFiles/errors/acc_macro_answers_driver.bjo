;; A collector macro's clauses go where the (:acc ...) was, which is in no
;; driver group, so a driver among them is refused, naming the macro.
;;
;; EXPECT-ERROR: The collector macro 'summing-pairs'
;; EXPECT-ERROR: returns a driver, a (:subloop) or a (:prologue ...)

(import "../inc/acc_macros.bjo")

(defun (main args)
  (println (int->string {summing-pairs x (:for x [1 2])}))
  0)
