;; Foreign .NET interop: classes, constructors, instance methods and properties.
;;
;; `import/class` registers the alias both as a type — so a signature may say
;; `StreamWriter` — and as a constructor, written `StreamWriter.` in the Lisp
;; tradition. Instance members are reached with `(.Method target args...)` and
;; `(.-Property target)`.
(import (std prelude))
(import (std simpletest))

(import/class
  (StreamWriter (: System.IO.StreamWriter (-> string StreamWriter)))
  (StringBuilder (: System.Text.StringBuilder (-> StringBuilder))))

(import/extern
  (read-all-text (: System.IO.File.ReadAllText (-> string string)))
  (file-delete! (: System.IO.File.Delete (-> string void))))

;; The alias is a type, so it may be written in an ordinary signature.
(: write-greeting (-> StreamWriter void))
(defun (write-greeting w)
  (.Write w "Bjolang interop")
  (.Flush w))

;; Two spellings of one type, met above the definitions that carry them.
;;
;; `fill-builder` names the alias, `builder-text` names the .NET class it stands
;; for, and `describe-builder` compiles only if those are the same type *here* —
;; which is above both.
;;
;; Signatures are resolved in one pass before any declaration is checked, and
;; that pass folded in `type` declarations but not `import/class` — so the alias
;; was read as a type constructor of its own name. Each definition was then
;; checked further down against its annotation resolved again in place, where
;; the import had landed, so every definition agreed with itself and disagreed
;; with whatever was written above it. That is why this needs a forward
;; reference to show at all, and why it showed as a type refusing to unify with
;; the same type spelled the other way.
(: describe-builder (-> string string))
(defun (describe-builder s)
  (builder-text (fill-builder s)))

(: fill-builder (-> string StringBuilder))
(defun (fill-builder s)
  (let ((sb (StringBuilder.)))
    (ignore (.Append sb s))
    sb))

(: builder-text (-> System.Text.StringBuilder string))
(defun (builder-text b) (.ToString b))

(defun (main)
  (def path "51_dotnet_class_io.tmp")

  (def w (StreamWriter. path))
  (write-greeting w)
  (.Dispose w)

  (expect "round trip through StreamWriter" (read-all-text path) "Bjolang interop")
  (file-delete! path)

  ;; A constructor taking no arguments, then a chain of instance calls. Every
  ;; one of these is a distinct overload chosen from its argument's type.
  (def sb (StringBuilder.))
  ;; `Append` returns the builder so that calls can be chained; nothing here
  ;; wants the chain, and §8.2 says a dropped value has to say so.
  (ignore (.Append sb "a"))
  (ignore (.Append sb "b"))
  (ignore (.Append sb "c"))
  (expect "StringBuilder" (.ToString sb) "abc")

  ;; The alias read from a signature above the definition that declares it.
  (expect "a forward reference through an imported class" (describe-builder "xyz") "xyz")

  ;; A property read, and a method on the result of another method.
  (expect "property read" (.-Length sb) 3)
  (expect "instance method on a string" (.Substring "abcdef" 2 3) "cde")

  0)
