;; A module whose declarations come from a macro.
;;
;; `def/macro-maker` splices a `def/macro` in beside a function, and a macro is
;; published by the module it is *written* in — which is this one, however it
;; got here. `122_splice.bjo` imports this and calls `answer`, which exists
;; nowhere in this file's source text.
(import "splicemacros.bjo")

(export made-helper)

(def/macro-maker answer made-helper)
