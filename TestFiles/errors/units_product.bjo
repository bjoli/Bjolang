;; A product of lengths is an area.

;; EXPECT-ERROR: expected (double m)
;; EXPECT-ERROR: found    (double m^2)
;; EXPECT-ERROR: Their units differ: m and m^2.

(import (std prelude))

(def/dimension length #:base m)

(: area (-> (double m) (double m) (double m)))
(defun (area w l) (* w l))

(defun (main) 0)
