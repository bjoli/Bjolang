;; The body is checked against the pin: an element pinned to int is not a
;; string.

;; EXPECT-ERROR: string

(import (std prelude))

(: lengths (-> %s int) (where (Iterable %s #:elem int)))
(defun (lengths s)
  (loop (:for x s)
        (:acc n (summing (string-length x)))))

(defun (main args) 0)
