;; Docs for std/mutable/vec.bjo, read through (:doc #:file "vec.bjodoc"). The
;; texts are samizdat markup: code in prose is @code{...}.

(:doc #:module
  (summary "In-place growable array backed directly by .NET List<T>.")
  (see MutableVec mutablevec mutablevec-add! mutablevec-ref mutablevec-pop!)
  (example """
    (import (std mutable vec))

    (def v (mutablevec))
    (mutablevec-add! v 3)
    (mutablevec-add! v 1)
    (mutablevec-add! v 2)
    (mutablevec-sort! v)
    (mutablevec-ref v 0)       ; 1
    (mutablevec-set! v 0 10)
    (mutablevec-pop! v)        ; (Some 3)
    (mutablevec->list v)       ; (10 2)
    """)
  (reference """
    @code{(MutableVec a)} directly aliases .NET @code{List<T>}. It provides a
    contiguous backing array that doubles its capacity when full. Index lookups,
    updates, and appending at the end run in O(1) amortized time. Inserting or
    removing elements at arbitrary indices takes O(n) time. Foreign interop via
    @code{import/extern} taking @code{List<T>} accepts @code{MutableVec} directly.

    @strong{Mutability.} Operations such as @code{mutablevec-add!} mutate the
    vector in place and return unit. All references to the vector observe the
    changes immediately. In contrast, @code{Vec} is an immutable, persistent
    collection.

    @strong{Comparison to builders.} Unlike @code{VecBuilder} and
    @code{ListBuilder} (which only support appending and produce immutable
    collections upon completion), @code{MutableVec} allows arbitrary indexed
    writes, in-place sorting, and removals.

    @strong{Indexing.} Indices are 0-based. Out-of-bounds access with
    @code{mutablevec-ref}, @code{mutablevec-set!}, @code{mutablevec-insert!}, or
    @code{mutablevec-remove-at!} raises @code{System.ArgumentOutOfRangeException}.
    Use @code{mutablevec-try-ref} to return @code{Option} safely.
    @code{mutablevec-pop!} returns @code{None} on an empty vector without
    raising.

    @strong{Equality and hashing.} Value searches (@code{mutablevec-contains?},
    @code{mutablevec-index-of}, @code{mutablevec-remove!}) use .NET's default
    equality comparer (@code{EqualityComparer<T>.Default}), which resolves to
    Bjolang's @code{Eq} for Bjolang types. Two vectors are @code{=} if they
    contain equal elements in the same order. Because vectors are mutable,
    @code{eq-hash} raises an exception to prevent mutable vectors from being used
    as hash map keys.

    @strong{Iteration.} Iterating via @code{Iterable} (e.g. @code{for-each} or
    @code{(:for x v)}) checks the count dynamically. Modifying the vector during
    iteration via @code{mutablevec->seq} raises
    @code{System.InvalidOperationException}.

    @strong{Thread safety.} Vectors are not thread-safe. Concurrent reads are
    safe if no writes occur, but concurrent mutations require external
    synchronization.

    @strong{Traits.} Implements @code{Refable} with an integer index,
    @code{Iterable}, @code{Collection}, @code{Addable!}, @code{Eq},
    @code{Written} and @code{Displayed}.
    """))

;; ---------------------------------------------------------------------------
;; The vector
;; ---------------------------------------------------------------------------

(:doc MutableVec
  (summary "In-place growable array of %a (aliases .NET List<T>).")
  (tparam %a "The element type.")
  (see mutablevec vec->mutablevec Vec))

(:doc mutablevec
  (summary "Creates an empty mutable vector.")
  (returns "A new empty vector.")
  (see mutablevec-with-capacity list->mutablevec))

(:doc mutablevec-with-capacity
  (summary "Creates an empty mutable vector with preallocated capacity.")
  (arg capacity "Initial capacity before reallocation is required. Must be >= 0.")
  (returns "A new empty vector.")
  (raises System.ArgumentOutOfRangeException "When capacity is negative.")
  (see mutablevec)
  (reference """
    Use this when the expected element count is known in advance to avoid
    repeated array reallocations.
    """))

(:doc mutablevec-length
  (summary "Returns the number of elements in a vector.")
  (arg v "The vector.")
  (returns "The element count.")
  (see mutablevec-empty?))

(:doc mutablevec-empty?
  (summary "Tests if a vector contains no elements.")
  (arg v "The vector.")
  (returns "#t if the vector is empty, otherwise #f.")
  (see mutablevec-length))

(:doc mutablevec-ref
  (summary "Returns the element at the specified index.")
  (arg v "The vector.")
  (arg i "Zero-based index. Must be less than length.")
  (returns "The element at index i.")
  (raises System.ArgumentOutOfRangeException "When i is negative or >= length.")
  (see mutablevec-try-ref mutablevec-set! ref))

(:doc mutablevec-try-ref
  (summary "Returns the element at an index, or None if the index is out of bounds.")
  (arg v "The vector.")
  (arg i "Zero-based index.")
  (returns "(Some x) if index i is valid, otherwise None.")
  (see mutablevec-ref try-ref))

(:doc mutablevec-set!
  (summary "Replaces the element at the specified index.")
  (arg v "The vector to modify.")
  (arg i "Zero-based index. Must be less than length.")
  (arg x "The new element value.")
  (raises System.ArgumentOutOfRangeException "When i is negative or >= length.")
  (see mutablevec-ref mutablevec-insert!)
  (reference """
    Does not expand the vector's length. Use @code{mutablevec-add!} or
    @code{mutablevec-insert!} to add elements.
    """))

(:doc mutablevec-add!
  (summary "Appends an element to the end of a vector.")
  (arg v "The vector to modify.")
  (arg x "The element to append.")
  (see mutablevec-add-all! mutablevec-insert! mutablevec-pop!)
  (reference """
    O(1) amortized. When full, the underlying array doubles in capacity.
    """))

(:doc mutablevec-add-all!
  (summary "Appends all elements from a sequence to the end of a vector.")
  (arg v "The vector to modify.")
  (arg xs "The elements to append.")
  (see mutablevec-add!))

(:doc mutablevec-insert!
  (summary "Inserts an element at the specified index, shifting subsequent elements.")
  (arg v "The vector to modify.")
  (arg i "Zero-based index, from 0 to length inclusive. Inserting at length appends.")
  (arg x "The element to insert.")
  (raises System.ArgumentOutOfRangeException "When i is negative or greater than length.")
  (see mutablevec-add! mutablevec-remove-at!)
  (reference """
    Runs in O(n) time proportional to the number of elements shifted after index i.
    """))

(:doc mutablevec-remove-at!
  (summary "Removes the element at the specified index, shifting subsequent elements.")
  (arg v "The vector to modify.")
  (arg i "Zero-based index. Must be less than length.")
  (raises System.ArgumentOutOfRangeException "When i is negative or >= length.")
  (see mutablevec-insert! mutablevec-remove! mutablevec-pop!)
  (reference """
    Runs in O(n) time proportional to the number of elements shifted after index i.
    """))

(:doc mutablevec-remove!
  (summary "Removes the first occurrence of an element matching a value.")
  (arg v "The vector to modify.")
  (arg x "The value to find and remove.")
  (returns "#t if an element was found and removed, otherwise #f.")
  (see mutablevec-remove-at! mutablevec-remove-where! mutablevec-index-of))

(:doc mutablevec-remove-where!
  (summary "Removes all elements satisfying a predicate.")
  (arg v "The vector to modify.")
  (arg pred "Predicate function returning #t to remove an element.")
  (returns "The number of elements removed.")
  (see mutablevec-remove!)
  (example """
    (mutablevec-remove-where! v (fun (x) (< x 0)))   ; remove negative numbers
    """)
  (reference """
    Executes in a single pass over the vector, maintaining the relative order
    of remaining elements.
    """))

(:doc mutablevec-pop!
  (summary "Removes and returns the last element of a vector, or None if empty.")
  (arg v "The vector to modify.")
  (returns "(Some x) containing the last element, or None if the vector was empty.")
  (see mutablevec-add!)
  (example """
    ;; Use the vector as a stack.
    (let loop ()
      (match (mutablevec-pop! stack)
        (None unit)
        ((Some x) (visit x) (loop))))
    """))

(:doc mutablevec-clear!
  (summary "Removes all elements from a vector.")
  (arg v "The vector to clear.")
  (reference """
    Retains allocated buffer capacity so subsequent appends do not require
    immediate reallocation.
    """))

(:doc mutablevec-contains?
  (summary "Tests if a vector contains an element matching a value.")
  (arg v "The vector to search.")
  (arg x "The value to locate.")
  (returns "#t if a matching element is found, otherwise #f.")
  (see mutablevec-index-of)
  (reference """
    Runs in O(n) time, scanning forward until the first match.
    """))

(:doc mutablevec-index-of
  (summary "Returns the 0-based index of the first occurrence of a value, or -1.")
  (arg v "The vector to search.")
  (arg x "The value to locate.")
  (returns "The zero-based index of the first match, or -1 if not found.")
  (see mutablevec-contains? mutablevec-remove-at!)
  (reference """
    Returns -1 rather than Option to avoid heap allocation.
    """))

(:doc mutablevec-reverse!
  (summary "Reverses the order of elements in place.")
  (arg v "The vector to reverse."))

(:doc mutablevec-sort!
  (summary "Sorts a vector in place in ascending order using Ord. Stable.")
  (arg xs "The vector to sort.")
  (see mutablevec-sort-by! compare)
  (reference """
    Performs a stable sort: equal elements maintain their relative positions.
    """))

(:doc mutablevec-sort-by!
  (summary "Sorts a vector in place using a custom comparison function. Stable.")
  (arg v "The vector to sort.")
  (arg cmp "Comparison function returning negative if a < b, 0 if equal, and positive if a > b.")
  (see mutablevec-sort!)
  (example """
    (mutablevec-sort-by! v (fun (a b) (compare b a)))   ; sort descending
    """)
  (reference """
    Performs a stable sort preserving the order of equal elements. Uses
    insertion sort on 16-element runs combined with merge passes and a temporary
    buffer.
    """))

(:doc mutablevec-copy
  (summary "Creates a shallow copy of a vector.")
  (arg v "The vector to copy.")
  (returns "A new vector with identical elements. Does not clone elements.")
  (see mutablevec->vec))

;; ---------------------------------------------------------------------------
;; Conversions
;; ---------------------------------------------------------------------------

(:doc list->mutablevec
  (summary "Constructs a new vector containing the elements of a list in order.")
  (arg xs "The source list.")
  (returns "A new mutable vector.")
  (see mutablevec->list))

(:doc mutablevec->list
  (summary "Converts a vector's elements into a list in order.")
  (arg xs "The source vector.")
  (returns "A new list.")
  (see list->mutablevec))

(:doc vec->mutablevec
  (summary "Constructs a new mutable vector from a persistent Vec.")
  (arg v "The source persistent vec.")
  (returns "A new mutable vector.")
  (see mutablevec->vec))

(:doc mutablevec->vec
  (summary "Converts a mutable vector into an immutable persistent Vec.")
  (arg xs "The source vector.")
  (returns "A new persistent Vec. Subsequent modifications to xs do not affect it.")
  (see vec->mutablevec))

(:doc seq->mutablevec
  (summary "Constructs a new vector from a sequence in order.")
  (arg xs "The source sequence.")
  (returns "A new mutable vector.")
  (see mutablevec->seq))

(:doc mutablevec->seq
  (summary "Views a vector as a sequence without copying.")
  (arg v "The source vector.")
  (returns "The vector itself viewed as a Seq.")
  (see seq->mutablevec mutablevec->list)
  (reference """
    Wraps the live vector directly. Modifying the vector while iterating
    over this sequence causes iteration to raise
    @code{System.InvalidOperationException}. To snapshot elements beforehand,
    use @code{mutablevec->list} or @code{mutablevec->vec}.
    """))

(:doc mutablevec->array
  (summary "Copies the elements of a vector into a new .NET array.")
  (arg v "The source vector.")
  (returns "A newly allocated .NET array.")
  (see mutablevec->vec))

;; ---------------------------------------------------------------------------
;; Printing
;; ---------------------------------------------------------------------------

(:doc mutablevec->str
  (summary "Deprecated: use @code{displayed}. Formats a vector as text in the form #mvec(a b c).")
  (arg xs "The vector to format.")
  (returns "String representation formatted using displayed for each element.")
  (example """
    (displayed (list->mutablevec (list 1 2 3)))   ; "#mvec(1 2 3)"
    """)
  (reference """
    The same text as @code{displayed} gives for a mutable vector.
    Provided for human-readable display; no reader macro parses this representation.
    """))
