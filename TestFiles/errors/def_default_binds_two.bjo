;; `:default` gives one name a value; which value goes to which of several
;; names is not something it answers.

;; EXPECT-ERROR: `:default` gives the pattern's one name a value, and this pattern binds 2

(import (std prelude))

(: f (-> (List int) int))
(defun (f xs)
  (def (Cons first rest) xs :default 0)
  first)
