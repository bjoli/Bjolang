;; std/fmt.bjo — formatting. Layer 1: Interpolation. Layer 2: Layout.
(import (std prelude))
(import (std syntax-match))
(export
  ;; Exported types.
  Disp Sink Block Align TableLayout TableStyle TableRules BorderChars ColumnWidth Overflow

  ;; Layer 1 — interpolation
  println*
  ;; Running blocks
  render show render->string run-block run-blocks
  ;; Settings
  with-fmt with-fmt* with-pad
  current-pad current-width current-ellipsis current-string-width
  current-precision current-comma current-comma-sep current-decimal-sep
  current-signed terminal-width
  ;; The block algebra
  nothing each captured width-of
  ;; Vertical and horizontal space
  nl fl space-to tab-to
  ;; Fitting to a width
  padded/left padded/right padded/both
  trimmed/left trimmed/right trimmed/both
  fitted/left fitted/right fitted/both
  ;; Sequences
  joined joined/prefix joined/suffix joined/last
  ;; Numbers
  numeric numeric/comma bytes percent bar sparkline
  ;; Paragraphs and tables
  wrapped justified columnar tabular tabular/rows
  table-layout table-widths table-row table-top table-rule table-bottom
  ;; A table as a literal
  Table TableCell table-block show-table)

;; Every export is documented there; the module doc is too.
(:doc #:file "fmt.bjodoc")


;; ===========================================================================
;; Layer 1 — interpolation
;; ===========================================================================
;;
;; What an interpolation literal can hold: one atom of each of these types.
(def/grammar Disp
  (:or (: DStr string) (: DInt int) (: DDouble double) (: DChar char) (: DBool bool)))

(: (-> Disp string))
(defun (disp->string d)
  (match d
    ((DStr s) s)
    ((DInt n) (int->string n))
    ((DDouble x) (double->string x))
    ((DChar c) (char->string c))
    ((DBool b) (if b "#t" "#f"))))

;; Formats to string.
(: (-> (Vec Disp) string))
(defun (str* ds)
  (let ((b (stringbuilder-empty)))
    (ignore
     (fold (fun (d acc) (stringbuilder-add-string! acc (disp->string d)) acc)
           b
           ds))
    (stringbuilder->string b)))

(: (-> (Vec Disp) void))
(defun (println* ds) (displayln (str* ds)))


;; ===========================================================================
;; Layer 2 — layout
;; ===========================================================================

;; Output sink.
(type (: Sink (-> string void)))

;; Layout blocks. A vec of blocks is a block: its blocks in order. BRun runs
;; combinators.
(def/grammar Block
  (:or (: BStr string) (: BInt int) (: BChar char) (: BMany (Vec Block))
       (: BRun ,(-> Sink int int))))

;; Computes column position.
(: (-> int string int))
(defun (column-after col s)
  (string-fold (fun (ch c) (if (char=? ch #\newline) 0 (+ c 1))) col s))

(: (-> Sink int Block int))
(defun (run-block out col b)
  (match b
    ((BStr s) (let () (out s) (column-after col s)))
    ((BInt n) (run-block out col (BStr (int->string n))))
    ((BChar c) (run-block out col (BStr (char->string c))))
    ((BMany bs) (run-blocks out col bs))
    ((BRun f) (f out col))))

(: (-> Sink int (Vec Block) int))
(defun (run-blocks out col bs)
  (fold (fun (b c) (run-block out c b)) col bs))

;; `#:sync`, and it cannot be otherwise: the sink is stored in a `Block`'s
;; `BRun` case, and a stored function's colour is its type — so no `-?->` can
;; go there and no suspending copy of this could ever await. Rendering from a
;; fiber is `render->string` plus a write you make yourself.
(: render #:sync (-> OutputPort Block void))
(defun (render port b)
  (ignore (run-block #(write-string port &1) 0 b)))

(: (-> Block string))
(defun (render->string b)
  (let ((sb (stringbuilder-empty)))
    (ignore (run-block #(stringbuilder-add-string! sb &1) 0 b))
    (stringbuilder->string sb)))

;; Renders to current output port. `#:sync` for `render`'s reason, and stated
;; here too rather than left to follow from it: this is the exported one, and
;; what it promises a caller should be readable at it.
;; 
(: show #:sync (-> Block void))
(defun (show b) (render (parameter-ref current-output-port) b))


;; --- Settings --------------------------------------------------------------
(: (-> (Param %a) %a Block Block))
(defun (with-fmt p v b)
  (BRun (fun (out col)
          (parameterize ((p v))
            (run-block out col b)))))

;; What padding is made of.
(: (Param char))
(def current-pad (make-parameter #\space))

(: (-> char Block Block))
(defun (with-pad c b) (with-fmt current-pad c b))

;; `(with-fmt* ((current-width 30) (current-pad #\.)) block ...)`: with-fmt
;; for each setting, the first outermost, around the blocks in order.
(def/macro (with-fmt* form inject compare)
  (syntax-match form
    ((_ () body ...)
     #'[,@body])
    ((_ ((p v) more ...) body ...)
     #'(with-fmt ,p ,v (with-fmt* (,@more) ,@body)))
    (bad (syntax-error bad "with-fmt* takes settings and blocks: (with-fmt* ((current-width 30)) block ...)"))))

;; The right margin: what `wrapped`, `justified` and `columnar` fill up to.
(: (Param int))
(def current-width (make-parameter 78))

;; Put in place of whatever a `trimmed` cut off. Empty means cut silently.
(: (Param string))
(def current-ellipsis (make-cold-parameter ""))

;; Calculates string width in columns.
(: (Param (-> string int)))
(def current-string-width (make-cold-parameter #(string-count &1)))

;; --- Number settings -------------------------------------------------------

;; Digits after the decimal separator. Negative means as many as the number
;; needs, which is what `double->string` would have given.
(: (Param int))
(def current-precision (make-cold-parameter -1))

;; Digits per group in the integer part. Zero means no grouping.
(: (Param int))
(def current-comma (make-cold-parameter 0))

(: (Param char))
(def current-comma-sep (make-cold-parameter #\,))

(: (Param char))
(def current-decimal-sep (make-cold-parameter #\.))

;; A leading `+` on a number that has no sign of its own.
(: (Param bool))
(def current-signed (make-cold-parameter #f))


;; --- Measuring -------------------------------------------------------------

;; Returns width of string.
(: (-> string int))
(defun (width-of s)
  (let ((measure (parameter-ref current-string-width)))
    (measure s)))

;; Generates padding of specified width.
(: (-> int string))
(defun (padding w)
  (def* (c (parameter-ref current-pad))
        (cw (width-of (char->string c)))
        (b (stringbuilder-empty)))
  (when (> cw 0)
    (let loop ((room w))
      (when (>= room cw)
        (stringbuilder-add! b c)
        (loop (- room cw)))))
  (stringbuilder->string b))

;; Gets prefix/suffix fitting w columns.
(: (-> string int string))
(defun (prefix-of-width s w)
  (let loop ((c (string-cursor-start s)) (room w))
    (if (string-cursor-end? s c)
        s
        (let ((cw (width-of (char->string (string-cursor-ref s c)))))
          (if (<= cw room)
              (loop (string-cursor-next s c) (- room cw))
              (substring s (string-cursor-start s) c))))))

(: (-> string int string))
(defun (suffix-of-width s w)
  (let loop ((c (string-cursor-end s)) (room w))
    (cond
      ((string-cursor=? c (string-cursor-start s))
       s)
      (:def p (string-cursor-prev s c))
      (:def cw (width-of (char->string (string-cursor-ref s p))))
      ((<= cw room) (loop p (- room cw)))
      (else (substring s c (string-cursor-end s))))))
    ;; (if (string-cursor=? c (string-cursor-start s))
    ;;     s
    ;;     (let* ((p (string-cursor-prev s c))
    ;;            (cw (width-of (char->string (string-cursor-ref s p)))))
    ;;           (if (<= cw room)
    ;;               (loop p (- room cw))
    ;;               (substring s c (string-cursor-end s)))))))

(: (-> int string string))
(defun (pad/left w s) (string-append (padding (- w (width-of s))) s))

(: (-> int string string))
(defun (pad/right w s) (string-append s (padding (- w (width-of s)))))

;; Centred, with the odd column on the right — SRFI 166's rule.
(: (-> int string string))
(defun (pad/both w s)
  (let* ((missing (- w (width-of s)))
         (left (/ missing 2)))
    (string-append (padding left) (string-append s (padding (- missing left))))))

;; Trims string to w columns.
(: (-> int string string))
(defun (trim/left w s)
  (if (<= (width-of s) w)
      s
      (let ((e (prefix-of-width (parameter-ref current-ellipsis) w)))
        (string-append e (suffix-of-width s (- w (width-of e)))))))

(: (-> int string string))
(defun (trim/right w s)
  (if (<= (width-of s) w)
      s
      (let ((e (prefix-of-width (parameter-ref current-ellipsis) w)))
        (string-append (prefix-of-width s (- w (width-of e))) e))))

;; The middle survives, and both ends say so.
(: (-> int string string))
(defun (trim/both w s)
  (if (<= (width-of s) w)
      s
      (let* ((e (prefix-of-width (parameter-ref current-ellipsis) (/ w 2)))
             (room (- w (* 2 (width-of e))))
             (dropped (- (width-of s) (max room 0)))
             (kept (suffix-of-width s (- (width-of s) (/ dropped 2)))))
        (string-append e (string-append (prefix-of-width kept (max room 0)) e)))))


;; --- The block algebra -----------------------------------------------------

;; Nothing, written. What a conditional arm answers when it has nothing to say.
(: Block)
(def nothing (BRun (fun (out col) col)))

;; Blocks in order, as one. What a vec of blocks is anyway; the name is for
;; where a function is wanted, as in (vec-map each rows).
(: (-> (Vec Block) Block))
(defun (each bs) (BMany bs))

;; Renders the content and applies f.
(: (-> (-> string Block) Block Block))
(defun (captured f b)
  (BRun (fun (out col) (run-block out col (f (render->string b))))))


;; --- Vertical and horizontal space -----------------------------------------

(: Block)
(def nl (BStr "\n"))

;; Outputs newline if not at start of line.
(: Block)
(def fl
  (BRun (fun (out col)
          (if (= col 0) col (run-block out col nl)))))

;; Pads to specified column.
(: (-> int Block))
(defun (space-to goal)
  (BRun (fun (out col)
          (if (>= col goal)
              col
              (run-block out col (BStr (padding (- goal col))))))))

;; Moves to next tab stop.
(: (-> (#:width int) Block))
(defun (tab-to #:width 8)
  (BRun (fun (out col)
          (run-block out col (BStr (padding (- (* width (+ 1 (/ col width)))
                                               col)))))))


;; --- Fitting to a width ----------------------------------------------------

(: (-> int Block Block))
(defun (padded/left w b) (captured (fun (s) (BStr (pad/left w s))) b))

(: (-> int Block Block))
(defun (padded/right w b) (captured (fun (s) (BStr (pad/right w s))) b))

(: (-> int Block Block))
(defun (padded/both w b) (captured (fun (s) (BStr (pad/both w s))) b))

(: (-> int Block Block))
(defun (trimmed/left w b) (captured (fun (s) (BStr (trim/left w s))) b))

(: (-> int Block Block))
(defun (trimmed/right w b) (captured (fun (s) (BStr (trim/right w s))) b))

(: (-> int Block Block))
(defun (trimmed/both w b) (captured (fun (s) (BStr (trim/both w s))) b))

(: (-> int Block Block))
(defun (fitted/left w b)
  (captured (fun (s) (BStr (pad/left w (trim/left w s)))) b))

(: (-> int Block Block))
(defun (fitted/right w b)
  (captured (fun (s) (BStr (pad/right w (trim/right w s)))) b))

(: (-> int Block Block))
(defun (fitted/both w b)
  (captured (fun (s) (BStr (pad/both w (trim/both w s)))) b))


;; --- Sequences -------------------------------------------------------------

;; Every element, with `sep` between them.
(: (-> (-> %a Block) (List %a) Block Block))
(defun (joined f xs sep) (joined/last f f xs sep))

;; `sep` before each element, including the first.
(: (-> (-> %a Block) (List %a) Block Block))
(defun (joined/prefix f xs sep)
  (BRun (fun (out col)
          (list-foldl (fun (x c) (run-block out (run-block out c sep) (f x)))
                      col
                      xs))))

;; Appends separator after elements.
(: (-> (-> %a Block) (List %a) Block Block))
(defun (joined/suffix f xs sep)
  (BRun (fun (out col)
          (list-foldl (fun (x c) (run-block out (run-block out c (f x)) sep))
                      col
                      xs))))

;; Joins elements with custom last element formatter.
(: (-> (-> %a Block) (-> %a Block) (List %a) Block Block))
(defun (joined/last f last-f xs sep)
  (BRun (fun (out col)
          (let loop ((ys xs) (c col) (first? #t))
            (match ys
              (Nil c)
              ((Cons x Nil)
               (run-block out (if first? c (run-block out c sep)) (last-f x)))
              ((Cons x rest)
               (loop rest
                     (run-block out (if first? c (run-block out c sep)) (f x))
                     #f)))))))


;; --- Numbers ---------------------------------------------------------------
(import/extern
  (clr-invariant (: System.Globalization.CultureInfo.InvariantCulture #:get)))

;; `n` digits at a time from the right, `sep` between the groups.
(: (-> string int char string))
(defun (grouped digits n sep)
  (if (<= n 0)
      digits
      (let ((b (stringbuilder-empty)))
        ;; Backwards, because the groups are counted from the right; the string
        ;; comes out reversed and is turned around once at the end.
        (let loop ((c (string-cursor-end digits)) (i 0))
          (unless (string-cursor=? c (string-cursor-start digits))
            (let ((p (string-cursor-prev digits c)))
              (when (and (> i 0) (= 0 (% i n)))
                (stringbuilder-add! b sep))
              (stringbuilder-add! b (string-cursor-ref digits p))
              (loop p (+ i 1)))))
        (string-reverse (stringbuilder->string b)))))

;; Formats number blocks.
;;
;; It is `double` rather than anything wider: an `int` crosses with
;; `(cast double n)`, and a number being formatted is on its way to a string.
(: (-> double (#:precision int) (#:comma int) (#:comma-sep char)
       (#:decimal-sep char) (#:signed bool) Block))
(defun (numeric x #:precision -1 #:comma -1 #:comma-sep #\nul
                #:decimal-sep #\nul #:signed #f)
  (BRun (fun (out col)
          (run-block
           out
           col
           (BStr (formatted x
                            (if (< precision 0) (parameter-ref current-precision) precision)
                            (if (< comma 0) (parameter-ref current-comma) comma)
                            (if (char=? comma-sep #\nul)
                                (parameter-ref current-comma-sep)
                                comma-sep)
                            (if (char=? decimal-sep #\nul)
                                (parameter-ref current-decimal-sep)
                                decimal-sep)
                            (or signed (parameter-ref current-signed))))))))

(: (-> double int int char char bool string))
(defun (formatted x precision comma comma-sep decimal-sep signed)
  (let* ((raw (if (< precision 0)
                  (.ToString x clr-invariant)
                  (.ToString x (string-append "F" (int->string precision)) clr-invariant)))
         (negative? (string-starts-with? raw "-"))
         (body (if negative? (string-drop-first raw) raw))
         (parts (split-at-point body))
         (whole (first-of parts))
         (fraction (second-of parts)))
    (string-append
     (if negative? "-" (if signed "+" ""))
     (string-append
      (grouped whole comma comma-sep)
      (if (string-empty? fraction)
          ""
          (string-append (char->string decimal-sep) fraction))))))

;; The common case, and the reason `comma` is spelled that way: thousands.
(: (-> double Block))
(defun (numeric/comma x) (numeric x #:comma 3))

;; The invariant culture's decimal point is `.`, so this is a split on one
;; character and not a search for whatever the machine calls a separator.
(: (-> string (Tuple string string)))
(defun (split-at-point s)
  (match (string-index (fun (c) (char=? c #\.)) s)
    ((Some c) (Tuple (substring s (string-cursor-start s) c)
                     (substring s (string-cursor-next s c) (string-cursor-end s))))
    (None (Tuple s ""))))

(: (-> (Tuple string string) string))
(defun (first-of t) (let (((a _) t)) a))

(: (-> (Tuple string string) string))
(defun (second-of t) (let (((_ b) t)) b))

(: (-> string string))
(defun (string-drop-first s)
  (if (string-empty? s)
      s
      (substring s
                 (string-cursor-next s (string-cursor-start s))
                 (string-cursor-end s))))


;; --- Sizes, shares, bars ----------------------------------------------------

;; A number of bytes in the largest unit it is at least one of: `512 B`,
;; `1.2 KiB`, `3.4 GiB`. With `#:si`, the units are powers of 1000: `1.2 kB`.
(: (-> long (#:si bool) (#:precision int) Block))
(defun (bytes n #:si #f #:precision 1)
  (BRun (fun (out col)
          (def step (if si 1000.0 1024.0))
          (def units (if si ["B" "kB" "MB" "GB" "TB" "PB" "EB"] ["B" "KiB" "MiB" "GiB" "TiB" "PiB" "EiB"]))
          (def negative? (< n 0L))
          (def size (cast double (if negative? (- 0L n) n)))
          (def text
            (let lp ((x size) (u 0))
              (cond
                ((= u 0) (if (< x step) (str (long->string (cast long x)) " B") (lp (/ x step) 1)))
                ((and (>= x step) (< u (- (vec-length units) 1))) (lp (/ x step) (+ u 1)))
                (else (str (formatted x (max precision 0) 0 #\, (parameter-ref current-decimal-sep) #f)
                           " " (vec-ref units u))))))
          (run-block out col (BStr (if negative? (str "-" text) text))))))

;; A share, written as a percentage: 0.125 is `12.5%`.
(: (-> double (#:precision int) Block))
(defun (percent x #:precision 1)
  (BRun (fun (out col)
          (run-block out col
                     (BStr (str (formatted (* x 100.0) (max precision 0) 0 #\,
                                           (parameter-ref current-decimal-sep) #f)
                                "%"))))))

;; The eighths of a block, from one eighth to seven.
(def eighths ["▏" "▎" "▍" "▌" "▋" "▊" "▉"])

;; A bar `width` columns wide, filled to `fraction` of it to an eighth of a
;; column, and `empty` in the rest. A fraction outside 0 to 1 is the nearest
;; end.
(: (-> double (#:width int) (#:empty string) Block))
(defun (bar fraction #:width 10 #:empty " ")
  (BRun (fun (out col)
          (def* (f (max (min fraction 1.0) 0.0))
                (total (cast int (+ (* f (cast double (* width 8))) 0.5)))
                (full (/ total 8))
                (part (% total 8))
                (b (stringbuilder-empty)))
          (loop (:for _ (range 0 full)) (:do (stringbuilder-add-string! b "█")))
          (when (> part 0) (stringbuilder-add-string! b (vec-ref eighths (- part 1))))
          (def used (+ full (if (> part 0) 1 0)))
          (loop (:for _ (range 0 (- width used))) (:do (stringbuilder-add-string! b empty)))
          (run-block out col (BStr (stringbuilder->string b))))))

(def levels ["▁" "▂" "▃" "▄" "▅" "▆" "▇" "█"])

;; The values as a line of bars of eight heights, the smallest the lowest and
;; the largest the highest. Values that are all the same are all in the
;; middle.
(: (-> (Vec double) Block))
(defun (sparkline xs)
  (BRun (fun (out col)
          (def* (first (if (> (vec-length xs) 0) (vec-ref xs 0) 0.0))
                (lo (vec-fold min first xs))
                (hi (vec-fold max first xs))
                (b (stringbuilder-empty)))
          (loop (:for x xs)
                (:do (stringbuilder-add-string!
                      b
                      (if (<= hi lo)
                          (vec-ref levels 3)
                          (vec-ref levels (min 7 (cast int (* 8.0 (/ (- x lo) (- hi lo))))))))))
          (run-block out col (BStr (stringbuilder->string b))))))


;; --- Paragraphs ------------------------------------------------------------

;; The runs of non-whitespace in `s`, in order.
(: (-> string (Vec string)))
(defun (words-of s)
  (def out (vecbuilder-empty))
  (let lp ((c (string-cursor-start s)) (start (string-cursor-start s)) (in? #f))
    (if (string-cursor-end? s c)
        ;; todo: add a (cond ...) here
        (when in? (vecbuilder-add! out (substring s start c)))
        (if (char-whitespace? (string-cursor-ref s c))
            (let ()
              (when in? (vecbuilder-add! out (substring s start c)))
              (lp (string-cursor-next s c) (string-cursor-next s c) #f))
            (lp (string-cursor-next s c) (if in? start c) #t))))
  (vecbuilder->vec out))

;; Packs words into lines.
(: (-> (Vec string) int int (List (List string))))
(defun (packed ws first width)
  (let lp ((i 0) (line Nil) (used 0) (budget first) (lines Nil))
    (if (>= i (vec-length ws))
        (list-reverse (if (list-empty? line) lines (Cons (list-reverse line) lines)))
        (let* ((w (vec-ref ws i))
               (needed (if (= used 0) (width-of w) (+ used 1 (width-of w)))))
          (if (or (= used 0) (<= needed budget))
              (lp (+ i 1) (Cons w line) needed budget lines)
              (lp i Nil 0 width (Cons (list-reverse line) lines)))))))

;; The words with a single pad character between them.
(: (-> (List string) string))
(defun (spaced ws)
  (def b (stringbuilder-empty))
  (def gap (padding 1))
  (loop (:with first? #t #f)
        (:for w ws)
        (:do
         (unless first? (stringbuilder-add-string! b gap))
         (stringbuilder-add-string! b w)))
  (stringbuilder->string b))

;; Stretches spaced words to budget.
(: (-> (List string) int string))
(defun (stretched ws budget)
  (let ((gaps (- (list-length ws) 1)))
    (if (<= gaps 0)
        (spaced ws)
        (let* ((text (list-foldl (fun (w acc) (+ acc (width-of w))) 0 ws))
               (room (max (- budget text) gaps))
               (base (/ room gaps))
               (extra (% room gaps))
               (b (stringbuilder-empty)))
              ;; TODO: rewrite as a {folding ...}
              (ignore (list-foldl (fun (w i)
                                    (when (> i 0)
                                      (stringbuilder-add-string!
                                       b
                                       (padding (+ base (if (<= i extra) 1 0)))))
                                    (stringbuilder-add-string! b w)
                                    (+ i 1))
                                  0
                                  ws))
              (stringbuilder->string b)))))

(: (-> (Vec string) bool Block))
(defun (wrap ws justify?)
  (BRun (fun (out col)
          (let* ((width (parameter-ref current-width))
                 (lines (packed ws (- width col) width)))
                (let loop ((ls lines) (c col) (first? #t))
                  (match ls
                    (Nil c)
                    ((Cons line rest)
                     ;; Todo: rewrite using (def ...)
                     (let* ((c1 (if first? c (run-block out c nl)))
                            (budget (if first? (- width col) width))
                            (text (if (and justify? (not (list-empty? rest)))
                                      (stretched line budget)
                                      (spaced line))))
                       (loop rest (run-block out c1 (BStr text)) #f)))))))))

;; Filled to the right margin, ragged on the right.
(: (-> Block Block))
(defun (wrapped b) (captured (fun (s) (wrap (words-of s) #f)) b))

;; Filled to the right margin and flush against both, the last line excepted.
(: (-> Block Block))
(defun (justified b) (captured (fun (s) (wrap (words-of s) #t)) b))


;; --- Tables ----------------------------------------------------------------
;;
;; They differ only in where the widths come from: `columnar` divides
;; `current-width` evenly and cuts whatever does not fit, `tabular` gives each
;; column the width its own content asks for and cuts nothing.

;; The lines of `s`, without the empty one a trailing newline leaves behind.
(: (-> string (Vec string)))
(defun (lines-of s)
  (def* (parts (string-split s "\n"))
        (n (vec-length parts)))
  (if (and (> n 1) (string-empty? (vec-ref parts (- n 1))))
      (vec-slice parts 0 (- n 1))
      parts))

;; Where a cell sits in its column. `(on #\.)` puts a character of every cell
;; in one column, as the decimal point is in a column of numbers.
(def/grammar Align
  (:or (: AlignLeft 'left) (: AlignRight 'right) (: AlignCentre 'centre) (: AlignOn (on char))))

;; The alignment of column `i`: left unless said otherwise.
(: (-> (Vec Align) int Align))
(defun (align-at aligns i)
  (if (< i (vec-length aligns)) (vec-ref aligns i) AlignLeft))

;; A cell fitted to its column. A cut keeps the end an alignment leans on,
;; as `fitted/left` and the rest do. The last column is not padded on the
;; right: there is nothing after it to line up.
(: (-> Align int bool bool string string))
(defun (fit-cell a w cut? last? text)
  (def s (if cut?
             (match a
               (AlignLeft (trim/right w text))
               (AlignRight (trim/left w text))
               (AlignCentre (trim/both w text))
               ((AlignOn _) (trim/left w text)))
             text))
  (match a
    (AlignLeft (if last? s (pad/right w s)))
    (AlignRight (pad/left w s))
    (AlignCentre (if last?
                     (string-append (padding (/ (- w (width-of s)) 2)) s)
                     (pad/both w s)))
    ;; Without the widths on either side of the character, which these
    ;; tables do not measure, the cell is aligned to the right.
    ((AlignOn _) (pad/left w s))))

(: (-> (Vec (Vec string)) (Vec int) (Vec Align) string bool Block))
(defun (laid-out cells widths aligns sep cut?)
  (BRun (fun (out col)
          (def rows (vec-fold (fun (ls acc) (max acc (vec-length ls))) 0 cells))
          (let lp ((r 0) (c (run-block out col fl)))
            (if (>= r rows)
                c
                (lp (+ r 1)
                    (run-block out
                               (run-block out c (BStr (row-of cells widths aligns sep cut? r)))
                               nl)))))))

;; Line `r` of a row. Empty cells at the end of it are left out, separators
;; and all, so that no line ends in blanks.
(: (-> (Vec (Vec string)) (Vec int) (Vec Align) string bool int string))
(defun (row-of cells widths aligns sep cut? r)
  (def* (b (stringbuilder-empty))
        (texts (vec-map (fun (ls) (if (< r (vec-length ls)) (vec-ref ls r) "")) cells))
        (n (let lp ((n (vec-length texts)))
             (if (and (> n 0) (string-empty? (vec-ref texts (- n 1)))) (lp (- n 1)) n))))
  (let lp ((i 0))
    (when (< i n)
      (when (> i 0) (stringbuilder-add-string! b sep))
      (stringbuilder-add-string!
       b
       (fit-cell (align-at aligns i) (vec-ref widths i) cut? (= i (- n 1)) (vec-ref texts i)))
      (lp (+ i 1))))
  (stringbuilder->string b))

;; Each cell's lines.
(: (-> (Vec (Vec Block)) (Vec (Vec string))))
(defun (rendered-cells cells)
  (vec-map (fun (c) (lines-of (render->string c))) cells))

;; The lines of a row's cells, a block each.
(: (-> (Vec Block) (Vec (Vec string))))
(defun (rendered-row row)
  (vec-map (fun (c) (lines-of (render->string [c]))) row))

(: (-> (Vec string) int))
(defun (widest ls) (vec-fold (fun (l acc) (max acc (width-of l))) 0 ls))

;; Renders columns.
(: (-> (Vec (Vec Block)) (#:sep string) (#:align (Vec Align)) Block))
(defun (columnar cols #:sep " " #:align [])
  (BRun (fun (out col)
          (let* ((cells (rendered-cells cols))
                 (n (vec-length cells))
                 (room (- (parameter-ref current-width)
                          (* (width-of sep) (max (- n 1) 0))))
                 (each-width (if (> n 0) (max (/ room n) 0) 0)))
            (run-block out
                       col
                       (laid-out cells (vec-map (fun (ls) each-width) cells) align sep #t))))))

;; --- Borders -----------------------------------------------------------------
;;
;; A bordered table is lines of three kinds: the cells of a row, a horizontal
;; line made of a fill repeated to each column's width, and the edges and
;; joins around both. `BorderChars` is every piece of them, so a style is a
;; value and a custom one is written as one.

(type (: BorderChars (Record (: top-left string) (: top string) (: top-join string) (: top-right string)
                             (: left string) (: column string) (: right string)
                             (: rule-left string) (: rule string) (: rule-join string) (: rule-right string)
                             (: bottom-left string) (: bottom string) (: bottom-join string)
                             (: bottom-right string)
                             (: marks bool))))

(def/grammar TableStyle
  (:or (: StyleNone 'none) (: StyleSimple 'simple) (: StyleAscii 'ascii) (: StyleLight 'light)
       (: StyleHeavy 'heavy) (: StyleDouble 'double) (: StyleRounded 'rounded)
       (: StyleMarkdown 'markdown) (: StyleCustom ,BorderChars)))

;; Which horizontal rules a table has inside it: under the header, between
;; every two rows, or none.
(def/grammar TableRules
  (:or (: RulesHeader 'header) (: RulesEvery 'every) (: RulesNone 'none)))

;; How wide a column is: as its content asks, a number of columns, at least
;; or at most a number, or a share of what the other columns leave of
;; `current-width`.
(def/grammar ColumnWidth
  (:or (: WidthAuto 'auto) (: WidthFixed int) (: WidthAtLeast (at-least int))
       (: WidthAtMost (at-most int)) (: WidthShare (share int))))

;; What a cell wider than its column does: pushes the rest of its row out,
;; is cut, or is wrapped onto more lines. A table that cuts or wraps is made
;; to fit `current-width`.
(def/grammar Overflow
  (:or (: OverflowPush 'push) (: OverflowCut 'cut) (: OverflowWrap 'wrap)))

;; `n` spaces, whatever the pad character is: a border's spacing is part of
;; the border.
(: (-> int string))
(defun (spaces n)
  (def b (stringbuilder-empty))
  (loop (:for _ (range 0 n)) (:do (stringbuilder-add! b #\space)))
  (stringbuilder->string b))

;; A box drawn with the line `h`, the line `v`, and the nine places they meet,
;; as on a keypad: the top row, the middle row and the bottom row, each left,
;; middle and right. A cell has a space on each side of it.
(: (-> string string string string string string string string string string string BorderChars))
(defun (box-chars h v tl tj tr ml mj mr bl bj br)
  (BorderChars (top-left (str tl h)) (top h) (top-join (str h tj h)) (top-right (str h tr))
               (left (str v " ")) (column (str " " v " ")) (right (str " " v))
               (rule-left (str ml h)) (rule h) (rule-join (str h mj h)) (rule-right (str h mr))
               (bottom-left (str bl h)) (bottom h) (bottom-join (str h bj h)) (bottom-right (str h br))
               (marks #f)))

;; No edges: `sep` between the columns, and a rule of `fill` under the header
;; when `fill` is not empty.
(: (-> string string BorderChars))
(defun (open-chars sep fill)
  (BorderChars (top-left "") (top "") (top-join "") (top-right "")
               (left "") (column sep) (right "")
               (rule-left "") (rule fill) (rule-join (spaces (width-of sep))) (rule-right "")
               (bottom-left "") (bottom "") (bottom-join "") (bottom-right "")
               (marks #f)))

;; The pieces a style is drawn with. `sep` is what `StyleNone` puts between
;; the columns.
(: (-> TableStyle string BorderChars))
(defun (border-chars style sep)
  (match style
    (StyleNone (open-chars sep ""))
    (StyleSimple (open-chars "  " "─"))
    (StyleAscii (box-chars "-" "|" "+" "+" "+" "+" "+" "+" "+" "+" "+"))
    (StyleLight (box-chars "─" "│" "┌" "┬" "┐" "├" "┼" "┤" "└" "┴" "┘"))
    (StyleHeavy (box-chars "━" "┃" "┏" "┳" "┓" "┣" "╋" "┫" "┗" "┻" "┛"))
    (StyleDouble (box-chars "═" "║" "╔" "╦" "╗" "╠" "╬" "╣" "╚" "╩" "╝"))
    (StyleRounded (box-chars "─" "│" "╭" "┬" "╮" "├" "┼" "┤" "╰" "┴" "╯"))
    (StyleMarkdown
     (BorderChars (top-left "") (top "") (top-join "") (top-right "")
                  (left "| ") (column " | ") (right " |")
                  (rule-left "| ") (rule "-") (rule-join " | ") (rule-right " |")
                  (bottom-left "") (bottom "") (bottom-join "") (bottom-right "")
                  (marks #t)))
    ((StyleCustom chars) chars)))

;; Whether a table is laid out as the tables without borders always were:
;; no borders, no header, no column aligned on a character, which only the
;; bordered layout measures, and no width rules or overflow.
(: (-> TableStyle (Vec Block) (Vec Align) (Vec ColumnWidth) Overflow bool))
(defun (plain-table? style titles aligns widths overflow)
  (and (match style (StyleNone #t) (_ #f))
       (= (vec-length titles) 0)
       (not (any? (fun (a) (match a ((AlignOn _) #t) (_ #f))) aligns))
       (= (vec-length widths) 0)
       (match overflow (OverflowPush #t) (_ #f))))

;; A column's width, and for one aligned on a character, the widest part of a
;; line before the character and the widest from it on.
(type (: ColumnFit (Record (: width int) (: before int) (: after int))))

;; A line cut where `c` first is: the part before it, and the rest from it
;; on. A line without one is all before.
(: (-> char string (Tuple string string)))
(defun (split-on c s)
  (match (string-index (fun (x) (char=? x c)) s)
    ((Some at) (Tuple (substring s (string-cursor-start s) at) (substring s at (string-cursor-end s))))
    (None (Tuple s ""))))

(: (-> (Vec (Vec string)) int (Vec string)))
(defun (cell-at cells i)
  (if (< i (vec-length cells)) (vec-ref cells i) []))

;; Every line of column `i`, in all the rows.
(: (-> (Vec (Vec (Vec string))) int (Vec string)))
(defun (column-lines rows i)
  (def b (vecbuilder-empty))
  (loop (:for row rows)
        (:do (loop (:for l (cell-at row i)) (:do (vecbuilder-add! b l)))))
  (vecbuilder->vec b))

(: (-> Align (Vec string) (Vec string) bool ColumnFit))
(defun (column-fit a title lines marks)
  (def* (parts (match a
                 ((AlignOn c)
                  (vec-fold (fun (l acc)
                              (def (Tuple b af) (split-on c l))
                              (Tuple (max (fst acc) (width-of b)) (max (snd acc) (width-of af))))
                            (Tuple 0 0) lines))
                 (_ (Tuple 0 0))))
        (content (match a
                   ((AlignOn _) (+ (fst parts) (snd parts)))
                   (_ (widest lines)))))
  (ColumnFit (width (max content (max (widest title) (if marks 3 0))))
             (before (fst parts))
             (after (snd parts))))

(: (-> (Vec Align) (Vec (Vec string)) (Vec (Vec (Vec string))) bool (Vec ColumnFit)))
(defun (column-fits aligns titles rows marks)
  (def n (vec-fold (fun (r acc) (max acc (vec-length r))) (vec-length titles) rows))
  {vecing (column-fit (align-at aligns i) (cell-at titles i) (column-lines rows i) marks)
          (:for i (range 0 n))})

;; A title is aligned as its column is, and one over a column aligned on a
;; character to the right, where the numbers under it end.
(: (-> Align Align))
(defun (title-align a)
  (match a
    ((AlignOn _) AlignRight)
    (_ a)))

;; One line of a cell, as wide as its column. `open-end?` is a last cell with
;; nothing after it, which is not padded on the right.
(: (-> Align ColumnFit bool string string))
(defun (fit-line a fit open-end? text)
  (def w (record-ref fit width))
  (match a
    ((AlignOn c)
     (def* (parts (split-on c text))
           (before (fst parts))
           (span (+ (record-ref fit before) (record-ref fit after)))
           (core (str (padding (- (record-ref fit before) (width-of before))) before (snd parts))))
     (str (padding (- w span)) (if open-end? core (pad/right span core))))
    (_ (fit-cell a w #f open-end? text))))

;; One line of a row: the edges, the separators and each cell's line `k`.
;; Without edges, empty cells at the end are left out and the last one is not
;; padded, as in a table without borders.
(: (-> BorderChars (Vec Align) (Vec ColumnFit) (Vec string) string))
(defun (row-line chars aligns fits texts)
  (def* (open? (and (string-empty? (record-ref chars left)) (string-empty? (record-ref chars right))))
        (n (if open?
               (let lp ((n (vec-length texts)))
                 (if (and (> n 0) (string-empty? (vec-ref texts (- n 1)))) (lp (- n 1)) n))
               (vec-length fits)))
        (b (stringbuilder-empty)))
  (stringbuilder-add-string! b (record-ref chars left))
  (loop (:for i (range 0 n))
        (:do (when (> i 0) (stringbuilder-add-string! b (record-ref chars column)))
             (stringbuilder-add-string!
              b
              (fit-line (align-at aligns i) (vec-ref fits i) (and open? (= i (- n 1)))
                        (if (< i (vec-length texts)) (vec-ref texts i) "")))))
  (stringbuilder-add-string! b (record-ref chars right))
  (stringbuilder->string b))

;; The lines of a row, as many as its tallest cell has.
(: (-> BorderChars (Vec Align) (Vec ColumnFit) (Vec (Vec string)) (Vec string)))
(defun (row-lines chars aligns fits cells)
  (def height (vec-fold (fun (c acc) (max acc (vec-length c))) 1 cells))
  {vecing (row-line chars aligns fits
                    (vec-map (fun (c) (if (< k (vec-length c)) (vec-ref c k) "")) cells))
          (:for k (range 0 height))})

;; `fill` repeated to `w` columns.
(: (-> string int string))
(defun (repeated fill w)
  (def* (fw (width-of fill))
        (b (stringbuilder-empty)))
  (when (> fw 0)
    (loop (:for _ (range 0 (/ w fw))) (:do (stringbuilder-add-string! b fill))))
  (stringbuilder->string b))

;; A column's part of the rule under a Markdown header, which says how the
;; column is aligned.
(: (-> Align int string))
(defun (marked a w)
  (match a
    (AlignLeft (str ":" (repeated "-" (- w 1))))
    (AlignCentre (str ":" (repeated "-" (- w 2)) ":"))
    (_ (str (repeated "-" (- w 1)) ":"))))

;; A horizontal line: `fill` across each column, `join` where the columns
;; meet, and the two ends.
(: (-> string string string string bool (Vec Align) (Vec ColumnFit) string))
(defun (hline lft fill join rgt marks aligns fits)
  (def b (stringbuilder-empty))
  (stringbuilder-add-string! b lft)
  (loop (:for i (range 0 (vec-length fits)))
        (:do (when (> i 0) (stringbuilder-add-string! b join))
             (def w (record-ref (vec-ref fits i) width))
             (stringbuilder-add-string! b (if marks (marked (align-at aligns i) w) (repeated fill w)))))
  (stringbuilder-add-string! b rgt)
  (stringbuilder->string b))

(: (-> BorderChars (Vec Align) (Vec ColumnFit) string))
(defun (top-line chars aligns fits)
  (hline (record-ref chars top-left) (record-ref chars top) (record-ref chars top-join)
         (record-ref chars top-right) #f aligns fits))

(: (-> BorderChars bool (Vec Align) (Vec ColumnFit) string))
(defun (rule-line chars marks aligns fits)
  (hline (record-ref chars rule-left) (record-ref chars rule) (record-ref chars rule-join)
         (record-ref chars rule-right) marks aligns fits))

(: (-> BorderChars (Vec Align) (Vec ColumnFit) string))
(defun (bottom-line chars aligns fits)
  (hline (record-ref chars bottom-left) (record-ref chars bottom) (record-ref chars bottom-join)
         (record-ref chars bottom-right) #f aligns fits))

;; The lines, each ended by a newline, starting on a fresh line.
(: (-> (Vec string) Block))
(defun (lines-block lines)
  (BRun (fun (out col)
          (vec-fold (fun (l c) (run-block out (run-block out c (BStr l)) nl)) (run-block out col fl) lines))))

;; --- Column widths and overflow ----------------------------------------------

(: (-> (Vec ColumnWidth) int ColumnWidth))
(defun (width-rule-at rules i)
  (if (< i (vec-length rules)) (vec-ref rules i) WidthAuto))

(: (-> ColumnWidth bool))
(defun (shared? rule)
  (match rule ((WidthShare _) #t) (_ #f)))

;; The narrowest a column may be made to fit the table into its width.
(: (-> ColumnWidth int))
(defun (narrowest rule)
  (match rule
    ((WidthFixed n) (max n 1))
    ((WidthAtLeast n) (max n 1))
    (_ 1)))

;; The width of each column: its content's, `natural`, as its rule says, with
;; the shares dividing what the others leave of `room`. When `fit?`, the
;; widest column that may shrink loses a column until the table fits `room`.
(: (-> (Vec int) (Vec ColumnWidth) int bool (Vec int)))
(defun (settled-widths natural rules room fit?)
  (def* (n (vec-length natural))
        (base {vecing (match (width-rule-at rules i)
                        ((WidthFixed k) (max k 1))
                        ((WidthAtLeast k) (max (vec-ref natural i) k))
                        ((WidthAtMost k) (max (min (vec-ref natural i) k) 1))
                        ((WidthShare _) 0)
                        (WidthAuto (vec-ref natural i)))
                      (:for i (range 0 n))})
        (shares (loop (:for i (range 0 n))
                      (:acc (summing (match (width-rule-at rules i) ((WidthShare s) (max s 1)) (_ 0)))))))
  (defun (shrinkable? ws i)
    (and (not (shared? (width-rule-at rules i)))
         (match (width-rule-at rules i) ((WidthFixed _) #f) (_ #t))
         (> (vec-ref ws i) (narrowest (width-rule-at rules i)))))
  (def* (fitted (if (not fit?)
                    base
                    (let lp ((ws base))
                      (def used (vec-fold + 0 ws))
                      (def wanted (+ used (if (> shares 0) n 0)))
                      (def widest-i
                        (loop (:for i (range 0 n))
                              (:when (shrinkable? ws i))
                              (:acc best (folding -1 (if (or (< best 0) (> (vec-ref ws i) (vec-ref ws best))) i best)))))
                      (if (or (<= wanted room) (< widest-i 0))
                          ws
                          (lp (vec-set ws widest-i (- (vec-ref ws widest-i) 1))))))))
  (if (= shares 0)
      fitted
      (let ()
        (def left (max (- room (vec-fold + 0 fitted)) 0))
        {vecing (match (width-rule-at rules i)
                  ((WidthShare s) (max (/ (* left (max s 1)) shares) 1))
                  (_ (vec-ref fitted i)))
                (:for i (range 0 n))})))

;; `word` in pieces no wider than `w`. A character wider than `w` is a piece
;; of its own.
(: (-> int string (List string)))
(defun (chopped w word)
  (let lp ((c (string-cursor-start word)) (start (string-cursor-start word)) (used 0) (acc Nil))
    (cond
      ((string-cursor-end? word c)
       (list-reverse (if (string-cursor=? start c) acc (Cons (substring word start c) acc))))
      (:def cw (width-of (char->string (string-cursor-ref word c))))
      ((and (> used 0) (> (+ used cw) w)) (lp c c 0 (Cons (substring word start c) acc)))
      (else (lp (string-cursor-next word c) start (+ used cw) acc)))))

;; A line broken at its spaces into lines no wider than `w`.
(: (-> int string (Vec string)))
(defun (wrapped-line w line)
  (if (<= (width-of line) w)
      [line]
      (let ()
        (def pieces (vecbuilder-empty))
        (loop (:for word (words-of line))
              (:do (loop (:for p (chopped w word)) (:do (vecbuilder-add! pieces p)))))
        (list->vec (list-map spaced (packed (vecbuilder->vec pieces) w w))))))

;; A cell's lines made to fit a column of `w`, as `overflow` says.
(: (-> Overflow Align int (Vec string) (Vec string)))
(defun (overflowed overflow a w lines)
  (match (Tuple overflow a)
    ((Tuple _ (AlignOn _)) lines)
    ((Tuple OverflowPush _) lines)
    ((Tuple OverflowCut AlignLeft) (vec-map (fun (l) (trim/right w l)) lines))
    ((Tuple OverflowCut AlignCentre) (vec-map (fun (l) (trim/both w l)) lines))
    ((Tuple OverflowCut _) (vec-map (fun (l) (trim/left w l)) lines))
    ((Tuple OverflowWrap _)
     (vec-fold (fun (l acc) (vec-merge acc (wrapped-line w l))) [] lines))))

;; A row's cells made to fit their columns.
(: (-> Overflow (Vec Align) (Vec int) (Vec (Vec string)) (Vec (Vec string))))
(defun (overflowed-row overflow aligns widths cells)
  {vecing (overflowed overflow (align-at aligns i)
                      (if (< i (vec-length widths)) (vec-ref widths i) 1)
                      (vec-ref cells i))
          (:for i (range 0 (vec-length cells)))})

;; How many columns the edges and separators of a row of `n` cells take.
(: (-> BorderChars int int))
(defun (border-width chars n)
  (+ (width-of (record-ref chars left))
     (+ (width-of (record-ref chars right))
        (* (max (- n 1) 0) (width-of (record-ref chars column))))))

;; A table with borders, its cells rendered already: a header of `titles`
;; when there are any, and `rows`. A horizontal line is drawn where its fill
;; is not empty. The columns are as wide as `widths` says, and a cell wider
;; than its column does what `overflow` says.
(: (-> BorderChars (Vec Align) (Vec (Vec string)) (Vec (Vec (Vec string))) TableRules
       (Vec ColumnWidth) Overflow Block))
(defun (bordered chars aligns titles rows rules widths overflow)
  (def* (marks (record-ref chars marks))
        (natural (column-fits aligns titles rows marks))
        (fit? (match overflow (OverflowPush #f) (_ #t)))
        (settled (vec-map (fun (w) (if marks (max w 3) w))
                          (settled-widths (vec-map (fun (f) (record-ref f width)) natural) widths
                                          (- (parameter-ref current-width)
                                             (border-width chars (vec-length natural)))
                                          fit?)))
        (fits {vecing (ColumnFit (width (vec-ref settled i))
                                 (before (record-ref (vec-ref natural i) before))
                                 (after (record-ref (vec-ref natural i) after)))
                      (:for i (range 0 (vec-length natural)))})
        (title-aligns {vecing (title-align (align-at aligns i)) (:for i (range 0 (vec-length fits)))})
        (titles (overflowed-row overflow title-aligns settled titles))
        (rows (vec-map (fun (row) (overflowed-row overflow aligns settled row)) rows))
        (ruled? (not (string-empty? (record-ref chars rule))))
        (under-header? (match rules (RulesNone #f) (_ #t)))
        (between-rows? (match rules (RulesEvery #t) (_ #f)))
        (lines (vecbuilder-empty)))
  (defun (add-all ls) (loop (:for l ls) (:do (vecbuilder-add! lines l))))
  (unless (string-empty? (record-ref chars top))
    (vecbuilder-add! lines (top-line chars aligns fits)))
  (when (> (vec-length titles) 0)
    (add-all (row-lines chars title-aligns fits titles))
    (when (and ruled? under-header?)
      (vecbuilder-add! lines (rule-line chars marks aligns fits))))
  (loop (:for (Tuple r row) (enumerate rows))
        (:do (when (and (> r 0) ruled? (not marks) between-rows?)
               (vecbuilder-add! lines (rule-line chars #f aligns fits)))
             (add-all (row-lines chars aligns fits row))))
  (unless (string-empty? (record-ref chars bottom))
    (vecbuilder-add! lines (bottom-line chars aligns fits)))
  (lines-block (vecbuilder->vec lines)))

;; Columns of lines as rows of one-line cells: the `r`th line of each column
;; is row `r`.
(: (-> (Vec (Vec string)) (Vec (Vec (Vec string)))))
(defun (columns->rows cols)
  (def height (vec-fold (fun (c acc) (max acc (vec-length c))) 0 cols))
  {vecing (vec-map (fun (c) (if (< r (vec-length c)) [(vec-ref c r)] [])) cols)
          (:for r (range 0 height))})

(: (-> (Vec (Vec Block)) (#:sep string) (#:align (Vec Align)) (#:style TableStyle)
       (#:titles (Vec Block)) (#:rules TableRules) (#:widths (Vec ColumnWidth)) (#:overflow Overflow)
       Block))
(defun (tabular cols #:sep " " #:align [] #:style StyleNone #:titles [] #:rules RulesHeader
                #:widths [] #:overflow OverflowPush)
  (BRun (fun (out col)
          (def cells (rendered-cells cols))
          (if (plain-table? style titles align widths overflow)
              (run-block out col (laid-out cells (vec-map widest cells) align sep #f))
              (run-block out col (bordered (border-chars style sep) align (rendered-row titles)
                                           (columns->rows cells) rules widths overflow))))))

;; --- Tables a row at a time --------------------------------------------------
;;
;; A table whose rows are known one by one: the widths are settled first,
;; and each row is then laid out on its own, so it can be written the moment
;; it is known.

(type (: TableLayout (Record (: widths (Vec int))
                             (: aligns (Vec Align))
                             (: sep string)
                             (: style TableStyle))))

(: (-> (Vec int) (#:sep string) (#:align (Vec Align)) (#:style TableStyle) TableLayout))
(defun (table-layout widths #:sep " " #:align [] #:style StyleNone)
  (TableLayout (widths widths) (aligns align) (sep sep) (style style)))

;; A layout's columns as fits. The widths on either side of a character are
;; not known a row at a time, so a column aligned on one is aligned right.
(: (-> TableLayout (Vec Align)))
(defun (layout-aligns layout)
  (def aligns (record-ref layout aligns))
  {vecing (title-align (align-at aligns i)) (:for i (range 0 (vec-length (record-ref layout widths))))})

(: (-> TableLayout (Vec ColumnFit)))
(defun (layout-fits layout)
  (vec-map (fun (w) (ColumnFit (width w) (before 0) (after 0))) (record-ref layout widths)))

(: (-> TableLayout BorderChars))
(defun (layout-chars layout)
  (border-chars (record-ref layout style) (record-ref layout sep)))

;; The line above a table laid out a row at a time, or nothing for a style
;; without one.
(: (-> TableLayout Block))
(defun (table-top layout)
  (def chars (layout-chars layout))
  (if (string-empty? (record-ref chars top))
      nothing
      (lines-block [(top-line chars (layout-aligns layout) (layout-fits layout))])))

;; A rule across the table: under a header row, or between two rows.
(: (-> TableLayout Block))
(defun (table-rule layout)
  (def chars (layout-chars layout))
  (if (string-empty? (record-ref chars rule))
      nothing
      (lines-block [(rule-line chars (record-ref chars marks) (layout-aligns layout) (layout-fits layout))])))

;; The line under a table laid out a row at a time.
(: (-> TableLayout Block))
(defun (table-bottom layout)
  (def chars (layout-chars layout))
  (if (string-empty? (record-ref chars bottom))
      nothing
      (lines-block [(bottom-line chars (layout-aligns layout) (layout-fits layout))])))

;; The width each column of these rows asks for: its widest line.
(: (-> (Vec (Vec Block)) (Vec int)))
(defun (table-widths rows)
  (vec-fold (fun (row acc)
              (def ws (vec-map widest (rendered-row row)))
              (def n (max (vec-length acc) (vec-length ws)))
              {vecing (max (if (< i (vec-length acc)) (vec-ref acc i) 0)
                           (if (< i (vec-length ws)) (vec-ref ws i) 0))
                      (:for i (range 0 n))})
            [] rows))

;; One row, laid out to `layout`. A cell wider than its column is not cut:
;; it pushes the rest of its row out. Cells past the layout's columns get
;; no width and are left as they are.
;;
;; With a style that has borders, a row is drawn between them, every cell
;; padded to its column, and a cell past the layout's columns is left out.
(: (-> TableLayout (Vec Block) Block))
(defun (table-row layout row)
  (BRun (fun (out col)
          (def cells (rendered-row row))
          (if (plain-table? (record-ref layout style) [] [] [] OverflowPush)
              (let ()
                (def ws (record-ref layout widths))
                (def widths {vecing (if (< i (vec-length ws)) (vec-ref ws i) 0)
                                    (:for i (range 0 (vec-length cells)))})
                (run-block out col (laid-out cells widths (record-ref layout aligns) (record-ref layout sep) #f)))
              (run-block out col (lines-block (row-lines (layout-chars layout) (layout-aligns layout)
                                                         (layout-fits layout) cells)))))))

;; `tabular`, given rows rather than columns.
(: (-> (Vec (Vec Block)) (#:sep string) (#:align (Vec Align)) (#:style TableStyle)
       (#:titles (Vec Block)) (#:rules TableRules) (#:widths (Vec ColumnWidth)) (#:overflow Overflow)
       Block))
(defun (tabular/rows rows #:sep " " #:align [] #:style StyleNone #:titles [] #:rules RulesHeader
                     #:widths [] #:overflow OverflowPush)
  ;; Measured when it runs, where the settings it is run under are bound.
  (BRun (fun (out col)
          (if (plain-table? style titles align widths overflow)
              (let ()
                (def layout (table-layout (table-widths rows) #:sep sep #:align align))
                (run-blocks out col (vec-map (fun (row) (table-row layout row)) rows)))
              (run-block out col (bordered (border-chars style sep) align (rendered-row titles)
                                           (vec-map rendered-row rows) rules widths overflow))))))

;; --- Width in a terminal ---------------------------------------------------
;;
;; The code points whose width in a terminal is not one column, as triples of
;; the first, the last and the width: 0 for combining marks, format and
;; control characters and the skin tone modifiers, which join what is before
;; them, and 2 for East Asian Wide and Fullwidth characters and the regional
;; indicators. Generated from Python's `unicodedata` (Unicode 16.0) and checked
;; in, as `(std rx)` checks in its tables.
