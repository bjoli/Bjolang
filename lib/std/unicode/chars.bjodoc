;; Docs for std/unicode/chars.bjo, read through (:doc #:file "chars.bjodoc").
;; The texts are samizdat markup: code in prose is @code{...}.

(:doc #:module
  (summary "The Unicode properties and case mappings of a character, R6RS section 11.11.")
  (see char-alphabetic? char-upcase char-foldcase char-general-category chars-unicode-version)
  (example """
    (char-alphabetic? #\ä)            ; #t
    (char-upcase #\ä)                 ; #\Ä
    (char-ci=? #\ſ #\S)               ; #t: the long s folds to s
    (char-general-category #\€)       ; 'Sc
    (digit-value #\٣)                 ; (Some 3)
    """)
  (reference """
    @code{(std prelude)} re-exports this module, so a program has its names
    without an import.

    @strong{Tables.} The properties are from the Unicode Character
    Database, generated by @code{tools/unicode/chars.bjo}. They do not use
    .NET or ICU, so every platform gives the same answers, and they are of the same
    Unicode version as @code{(std unicode normalize)}, @code{casefold} and
    @code{grapheme}. The version is @code{chars-unicode-version}.

    @strong{One character to one character.} The case mappings here are
    the simple ones of @code{UnicodeData.txt} and @code{CaseFolding.txt}. A
    mapping that gives more than one character is not one of them: @code{ß}
    upcases to itself, not to @code{SS}. To fold whole strings, use
    @code{string-foldcase} of @code{(std unicode casefold)}.

    @strong{Culture.} No function depends on a culture. @code{I} downcases
    to @code{i} in Turkish text too.

    @strong{Cost.} Every function is two reads into the tables and one into
    the kind of the character, about a nanosecond. The tables are compiled
    into the assembly with @code{include-bytes}, so the first call in a
    process only loads the module, about 0.4 ms.
    """))

(:doc chars-unicode-version
  (summary "The version of the Unicode Character Database the tables are from.")
  (see char-general-category))

;; ---------------------------------------------------------------------------
;; Case
;; ---------------------------------------------------------------------------

(:doc char-upcase
  (summary "The uppercase form of a character.")
  (arg c "The character.")
  (returns "Its simple uppercase mapping, or c itself when it has none.")
  (see char-downcase char-titlecase char-upper-case?)
  (example """
    (char-upcase #\a)    ; #\A
    (char-upcase #\ǆ)    ; #\Ǆ
    (char-upcase #\ß)    ; #\ß
    """)
  (reference """
    The Simple_Uppercase_Mapping of @code{UnicodeData.txt}. A mapping to more
    than one character is not a simple mapping, so @code{ß} maps to itself.
    """))

(:doc char-downcase
  (summary "The lowercase form of a character.")
  (arg c "The character.")
  (returns "Its simple lowercase mapping, or c itself when it has none.")
  (see char-upcase char-foldcase char-lower-case?)
  (reference """
    The Simple_Lowercase_Mapping of @code{UnicodeData.txt}. To compare
    without case, use @code{char-foldcase}: the fold also maps @code{ς} and
    @code{ſ}, which are lowercase already.
    """))

(:doc char-titlecase
  (summary "The titlecase form of a character.")
  (arg c "The character.")
  (returns "Its simple titlecase mapping, or c itself when it has none.")
  (see char-upcase char-title-case?)
  (example """
    (char-titlecase #\ǆ)    ; #\ǅ
    (char-titlecase #\a)    ; #\A
    """)
  (reference """
    The Simple_Titlecase_Mapping of @code{UnicodeData.txt}, which is the
    uppercase mapping for every character but the few with a titlecase form
    of their own, such as the Latin digraphs: @code{ǆ} and @code{Ǆ} both
    map to @code{ǅ}.
    """))

(:doc char-foldcase
  (summary "A character with its case folded, for comparing without case.")
  (arg c "The character.")
  (returns "Its simple case fold, or c itself when it has none.")
  (see char-ci=? char-downcase)
  (example """
    (char-foldcase #\A)    ; #\a
    (char-foldcase #\ς)    ; #\σ
    (char-foldcase #\ſ)    ; #\s
    (char-foldcase #\ß)    ; #\ß
    """)
  (reference """
    The simple case folding of @code{CaseFolding.txt}: the mappings of
    status C and S, as R6RS specifies. Most characters fold to their
    lowercase form. @code{ς}, @code{ſ} and the micro sign fold to
    @code{σ}, @code{s} and @code{μ}, so the three Greek sigmas compare
    equal without case. @code{ß} folds to itself: its full fold, @code{ss},
    is two characters, and is @code{string-foldcase}'s.

    Every @code{char-ci} comparison folds both sides with it.
    """))

;; ---------------------------------------------------------------------------
;; Classification
;; ---------------------------------------------------------------------------

(:doc char-alphabetic?
  (summary "Whether a character is alphabetic.")
  (arg c "The character.")
  (returns "#t when c has the Unicode property Alphabetic.")
  (see char-numeric? char-general-category)
  (example """
    (char-alphabetic? #\a)          ; #t
    (char-alphabetic? #\Ⅷ)          ; #t: a letter number
    (char-alphabetic? #\1)          ; #f
    """)
  (reference """
    Alphabetic is the letters, Lu, Ll, Lt, Lm and Lo, and also the letter
    numbers (Nl), such as the Roman numerals, and the marks and other
    characters that are Other_Alphabetic, such as the vowel signs of many
    scripts.
    """))

(:doc char-numeric?
  (summary "Whether a character is a number of any kind.")
  (arg c "The character.")
  (returns "#t when c is in category Nd, Nl or No.")
  (see digit-value char-alphabetic?)
  (reference """
    Wider than decimal digits: @code{½} and @code{Ⅶ} are numeric.
    @code{digit-value} returns a value only for decimal digits.
    """))

(:doc char-whitespace?
  (summary "Whether a character is white space.")
  (arg c "The character.")
  (returns "#t when c has the Unicode property White_Space.")
  (see char-general-category)
  (reference """
    The separators (Zs, Zl and Zp), and tab, line feed, vertical tab, form
    feed, carriage return and U+0085 NEXT LINE.
    """))

(:doc char-upper-case?
  (summary "Whether a character is uppercase.")
  (arg c "The character.")
  (returns "#t when c has the Unicode property Uppercase.")
  (see char-lower-case? char-title-case? char-upcase)
  (reference """
    Uppercase is category Lu and the characters that are Other_Uppercase,
    such as the circled letters @code{Ⓐ} to @code{Ⓩ}. A titlecase letter
    such as @code{ǅ} is neither uppercase nor lowercase.
    """))

(:doc char-lower-case?
  (summary "Whether a character is lowercase.")
  (arg c "The character.")
  (returns "#t when c has the Unicode property Lowercase.")
  (see char-upper-case? char-downcase)
  (reference """
    Lowercase is category Ll and the characters that are Other_Lowercase,
    such as @code{ª}, @code{º} and the modifier letters @code{ʰ} and
    @code{ˢ}.
    """))

(:doc char-title-case?
  (summary "Whether a character is a titlecase letter.")
  (arg c "The character.")
  (returns "#t when c is in category Lt, such as ǅ.")
  (see char-titlecase char-upper-case?))

(:doc digit-value
  (summary "The value of a decimal digit.")
  (arg c "The character.")
  (returns "(Some n), n from 0 to 9, when c is a decimal digit (category Nd); None otherwise.")
  (see char-numeric?)
  (example """
    (digit-value #\7)    ; (Some 7)
    (digit-value #\٣)    ; (Some 3), ARABIC-INDIC DIGIT THREE
    (digit-value #\½)    ; None
    """)
  (reference """
    Narrower than @code{char-numeric?}: @code{½} is numeric and has no
    digit value. Any decimal digit counts, not only 0 to 9 of ASCII.
    """))

(:doc char-general-category
  (summary "The Unicode general category of a character.")
  (arg c "The character.")
  (returns "The two-letter category as a symbol: 'Lu, 'Ll, 'Nd, 'Zs and the rest.")
  (see char-alphabetic? char-numeric? char-whitespace?)
  (example """
    (char-general-category #\a)        ; 'Ll
    (char-general-category #\space)    ; 'Zs
    """)
  (reference """
    One of the thirty categories R6RS names: Lu Ll Lt Lm Lo, Mn Mc Me,
    Nd Nl No, Pc Pd Ps Pe Pi Pf Po, Sm Sc Sk So, Zs Zl Zp, Cc Cf Cs Co
    and Cn. An unassigned code point returns @code{'Cn}. A symbol, so it
    is compared with @code{=} or @code{eq?} at the cost of a reference
    comparison.
    """))

;; ---------------------------------------------------------------------------
;; Comparison without case
;; ---------------------------------------------------------------------------

(:doc char-ci=?
  (summary "Whether two characters are the same, ignoring case.")
  (arg a "The first character.")
  (arg b "The second.")
  (returns "#t when a and b are the same after char-foldcase.")
  (see char=? char-foldcase)
  (example """
    (char-ci=? #\a #\A)    ; #t
    (char-ci=? #\ς #\Σ)    ; #t
    """)
  (reference """
    Both sides go through @code{char-foldcase} and are then compared by
    code point, as every @code{char-ci} comparison does. Binary, where
    R6RS's is n-ary.
    """))

(:doc char-ci<?
  (summary "Whether one character comes before another, ignoring case.")
  (arg a "The first character.")
  (arg b "The second.")
  (returns "#t when a's folded code point is less than b's.")
  (see char<? char-foldcase))

(:doc char-ci>?
  (summary "Whether one character comes after another, ignoring case.")
  (arg a "The first character.")
  (arg b "The second.")
  (returns "#t when a's folded code point is greater than b's.")
  (see char>? char-foldcase))

(:doc char-ci<=?
  (summary "Whether one character comes before another or is the same, ignoring case.")
  (arg a "The first character.")
  (arg b "The second.")
  (returns "#t when a's folded code point is not greater than b's.")
  (see char<=? char-foldcase))

(:doc char-ci>=?
  (summary "Whether one character comes after another or is the same, ignoring case.")
  (arg a "The first character.")
  (arg b "The second.")
  (returns "#t when a's folded code point is not less than b's.")
  (see char>=? char-foldcase))
