;; A body that names a type its module does not export is not published, so an
;; importer does not try to splice it and warn that it could not.
;; EXPECT-NO-WARNING: could not inline

(import (std prelude))
(import "../inc/withheld_body.bjo")

(defun (main args)
  (def answer (lazily (fun () 42)))
  (+ (answer) (answer) -84))
