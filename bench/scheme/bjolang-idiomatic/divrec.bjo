;; DIVREC, idiomatic: every other element of a vec, by a comprehension that
;; walks the vec and keeps the elements at even positions.
;; Arguments: count n expected-length

(import "../bjolang/common.bjo")

(: div2 (-> (Vec int) (Vec int)))
(defun (div2 v)
  {vecing x :when (even? i) (:for x (in-vec v)) (:for i (up-from 0))})

(defun (main args)
  (def v {vecing 0 (:for i (range 0 (arg-int args 1)))})
  (def expected (arg-int args 2))
  (run-benchmark "divrec" (arg-int args 0) (fun () (div2 v)) #(= (vec-length &) expected)))
