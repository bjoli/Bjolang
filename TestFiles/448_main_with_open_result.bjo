;; A main whose result no expression fixes is generic in it: here it returns
;; an empty list, and one that ends in panic! is generic the same way. The
;; entry point calls it all the same, and the run exits with 0.
(import (std prelude))
(import (std simpletest))

(defun (main)
  (expect "a main may return a value of an open type" (+ 1 1) 2)
  (list))
