;; A shuffle's indices are of the vector's own type, so a float vector has
;; none: `simd-shuffle` is a `SimdInt` method, and a float vector is shuffled
;; through its bits.

;; EXPECT-ERROR: no implementation of trait 'IntLane' for 'double', needed by the implementation of 'SimdInt'

(import (std prelude))
(import (std simd))

(defun (main)
  (def v (simd128-of 1.0 2.0))
  (println (simd-ref (simd-shuffle v v) 0))
  0)
