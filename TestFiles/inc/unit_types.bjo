;; Functions with number types that have units, written in the metadata form
;; (units carrier atom^exp ...), for 509_unit_types.bjo.
(import (std prelude))

(export same sec pick ratio)

(: same (-> (units double m^1) (units double m^1)))
(defun (same x) x)

(: sec (-> (units double s^1) (units double s^1)))
(defun (sec x) x)

(: pick (-> (units double %u^1) (units double %u^1) (units double %u^1)))
(defun (pick a b) a)

(: ratio (-> (units double m^1 s^-1) (units double m^1 s^-1)))
(defun (ratio v) v)
