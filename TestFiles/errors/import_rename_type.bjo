;; Rule 4: `rename` applies to defs and macros. Renaming a type one at a time
;; is what `prefix-types` does systematically, and what a local `type` alias
;; does for a single one.
;;
;; EXPECT-ERROR: Invalid (rename ...)
;; EXPECT-ERROR: 'Crate' is a type
;; EXPECT-ERROR: (prefix-types ...)

(import (rename "../inc/kitchen.bjo" (Crate Box)))

(defun (main)
  0)
