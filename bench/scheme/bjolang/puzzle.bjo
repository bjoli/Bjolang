;; PUZZLE -- Forest Baskett's Puzzle benchmark, from Gabriel.
;; Arguments: count size expected
;;
;; The original leaves `trial` early through `call/cc`. That continuation is
;; only ever an escape, so here the loop returns instead.

(import "common.bjo")

(def size 511)
(def classmax 3)
(def typemax 12)
(def d 8)

(: iii int)
(def/mutable iii 0)
(: kount int)
(def/mutable kount 0)

(: piececount (Array int))
(def piececount (make-array (+ classmax 1)))
(: class (Array int))
(def class (make-array (+ typemax 1)))
(: piecemax (Array int))
(def piecemax (make-array (+ typemax 1)))
(: puzzle (Array bool))
(def puzzle (make-array (+ size 1)))
(: p (Array (Array bool)))
(def p (make-array (+ typemax 1)))

(: fit (-> int int bool))
(defun (fit i j)
  (def end (array-ref piecemax i))
  (let loop ((k 0))
    (cond ((> k end) #t)
          ((and (array-ref (array-ref p i) k)
                (array-ref puzzle (+ j k)))
           #f)
          (else (loop (+ k 1))))))

(: place (-> int int int))
(defun (place i j)
  (def end (array-ref piecemax i))
  (let loop ((k 0))
    (when (<= k end)
      (when (array-ref (array-ref p i) k)
        (array-set! puzzle (+ j k) #t))
      (loop (+ k 1))))
  (array-set! piececount
              (array-ref class i)
              (- (array-ref piececount (array-ref class i)) 1))
  (let loop ((k j))
    (cond ((> k size) 0)
          ((not (array-ref puzzle k)) k)
          (else (loop (+ k 1))))))

(: puzzle-remove (-> int int void))
(defun (puzzle-remove i j)
  (def end (array-ref piecemax i))
  (let loop ((k 0))
    (when (<= k end)
      (when (array-ref (array-ref p i) k)
        (array-set! puzzle (+ j k) #f))
      (loop (+ k 1))))
  (array-set! piececount
              (array-ref class i)
              (+ (array-ref piececount (array-ref class i)) 1)))

(: trial (-> int bool))
(defun (trial j)
  (let loop ((i 0))
    (cond ((> i typemax)
           (set! kount (+ kount 1))
           #f)
          ((and (not (= 0 (array-ref piececount (array-ref class i))))
                (fit i j))
           (let ((k (place i j)))
             (if (or (trial k) (= k 0))
                 (let ()
                   (set! kount (+ kount 1))
                   #t)
                 (let ()
                   (puzzle-remove i j)
                   (loop (+ i 1))))))
          (else (loop (+ i 1))))))

(: define-piece (-> int int int int void))
(defun (define-piece iclass ii jj kk)
  (def/mutable index 0)
  (let loop-i ((i 0))
    (when (<= i ii)
      (let loop-j ((j 0))
        (when (<= j jj)
          (let loop-k ((k 0))
            (when (<= k kk)
              (set! index (+ i (* d (+ j (* d k)))))
              (array-set! (array-ref p iii) index #t)
              (loop-k (+ k 1))))
          (loop-j (+ j 1))))
      (loop-i (+ i 1))))
  (array-set! class iii iclass)
  (array-set! piecemax iii index)
  (unless (= iii typemax)
    (set! iii (+ iii 1))))

(: start (-> int int))
(defun (start size)
  (set! kount 0)
  (let loop ((m 0))
    (when (<= m size)
      (array-set! puzzle m #t)
      (loop (+ m 1))))
  (let loop-i ((i 1))
    (when (<= i 5)
      (let loop-j ((j 1))
        (when (<= j 5)
          (let loop-k ((k 1))
            (when (<= k 5)
              (array-set! puzzle (+ i (* d (+ j (* d k)))) #f)
              (loop-k (+ k 1))))
          (loop-j (+ j 1))))
      (loop-i (+ i 1))))
  (let loop-i ((i 0))
    (when (<= i typemax)
      (let loop-m ((m 0))
        (when (<= m size)
          (array-set! (array-ref p i) m #f)
          (loop-m (+ m 1))))
      (loop-i (+ i 1))))
  (set! iii 0)
  (define-piece 0 3 1 0)
  (define-piece 0 1 0 3)
  (define-piece 0 0 3 1)
  (define-piece 0 1 3 0)
  (define-piece 0 3 0 1)
  (define-piece 0 0 1 3)

  (define-piece 1 2 0 0)
  (define-piece 1 0 2 0)
  (define-piece 1 0 0 2)

  (define-piece 2 1 1 0)
  (define-piece 2 1 0 1)
  (define-piece 2 0 1 1)

  (define-piece 3 1 1 1)

  (array-set! piececount 0 13)
  (array-set! piececount 1 3)
  (array-set! piececount 2 1)
  (array-set! piececount 3 1)
  (def m (+ (* d (+ d 1)) 1))
  (def n (if (fit 0 m) (place 0 m) (let () (println "Error.") 0)))
  (if (trial n) kount -1))

(defun (main args)
  (let loop ((i 0))
    (when (<= i typemax)
      (array-set! p i (make-array (+ size 1)))
      (loop (+ i 1))))
  (def input (arg-int args 1))
  (def expected (arg-int args 2))
  (run-benchmark "puzzle" (arg-int args 0) (fun () (start input)) #(= & expected)))
