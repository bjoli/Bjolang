;; The declared signature is matched against the method's own shape, and the
;; match is what solves its type arguments — so a signature that disagrees is an
;; error at the clause rather than a surprise at the first call site.
;;
;; Here the element types disagree: `Append` is
;; `(IEnumerable<T>, T) -> IEnumerable<T>`, and no instantiation of it takes a
;; `%b` with an `(Items %a)`.
;; EXPECT-ERROR: does not match 'System.Linq.Enumerable.Append'
;; EXPECT-ERROR: a type variable of the signature stands for one of the method's
(import (std prelude))

(import/class
  ((Items %a) (: System.Collections.Generic.IEnumerable)))

(import/extern
  (append (: System.Linq.Enumerable.Append (-> (Items %a) %b (Items %a)))))

(defun (main args) 0)
