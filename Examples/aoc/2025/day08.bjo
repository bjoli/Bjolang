;; Day 8: Playground. Connect junction boxes, closest pairs first. Part 1: after
;; K pairs (10 for the example, 1000 for a real input), the product of the three
;; largest circuits. Part 2: the product of the X coordinates of the last pair
;; that makes one circuit.
(import (std prelude))
(import (std eq))
(import (std mutable vec))
(import "common.bjo")

(defun (main args)
  (def boxes {vecing (vec-map parse-long (string-split l ",")) (:for l (input-lines args))})
  (def n (length boxes))
  (def k (if (< n 100) 10 1000))
  (defun (dist2 a b) {summing (* d d) (:for c (range 0 3)) (:let d (- (ref a c) (ref b c)))})
  ;; Each pair as distance, i, j packed in one long: 10 bits per index.
  (def pairs (mutablevec))
  (loop (:for i (range 0 n))
        (:subloop)
        (:for j (range (+ i 1) n))
        (:do (mutablevec-add! pairs (bitwise-ior (shift-left (dist2 (ref boxes i) (ref boxes j)) 20)
                                                 (cast System.Int64 (+ (* i 1024) j))))))
  (mutablevec-sort! pairs)
  (defun (ends p)
    (def key (mutablevec-ref pairs p))
    (Tuple (cast System.Int32 (bitwise-and (shift-right key 10) 1023L))
           (cast System.Int32 (bitwise-and key 1023L))))
  ;; Union-find over box indices.
  (def parent (make-array n))
  (def size (make-array n #:fill 1))
  (loop (:for i (range 0 n)) (:do (array-set! parent i i)))
  (defun (root i)
    (def p (ref parent i))
    (if (= p i)
        i
        (let ((r (root p))) (array-set! parent i r) r)))
  ;; Joins the pair at index p and answers whether that merged two circuits.
  (defun (join! p)
    (def (Tuple i j) (ends p))
    (def a (root i))
    (def b (root j))
    (and (not (= a b))
         (let ()
           (array-set! parent a b)
           (array-set! size b (+ (ref size a) (ref size b)))
           #t)))
  (loop (:for p (range 0 k)) (:do (ignore (join! p))))
  (def sizes (vec-sort-by #(compare &2 &1) {vecing (ref size i) (:for i (range 0 n)) (:when (= (root i) i))}))
  (println (* (ref sizes 0) (* (ref sizes 1) (ref sizes 2))))
  ;; Part 2 goes on from where part 1 stopped, and counts circuits down to one.
  (def last
    (let go ((p k) (left (length sizes)))
      (cond ((not (join! p)) (go (+ p 1) left))
            ((= left 2) p)
            (else (go (+ p 1) (- left 1))))))
  (def (Tuple i j) (ends last))
  (println (* (ref (ref boxes i) 0) (ref (ref boxes j) 0)))
  0)
