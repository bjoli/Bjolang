;; Every out parameter is declared, in the position C# has it.
;; Deconstruct is `void Deconstruct(out TKey key, out TValue value)`.
;; EXPECT-ERROR: Every out parameter must be declared
;; EXPECT-ERROR: void KeyValuePair<TKey, TValue>.Deconstruct(out TKey key, out TValue value)
(import (std prelude))

(import/class
  ((KeyValuePair %k %v) (: System.Collections.Generic.KeyValuePair)))

(import/extern
  (kv-parts (: System.Collections.Generic.KeyValuePair.Deconstruct
               (-> (KeyValuePair %k %v) %k (out %v) (Tuple %k %v)))))

(defun (main args) 0)
