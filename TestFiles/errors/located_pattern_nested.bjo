;; A mismatch inside a pattern is reported at the innermost part.

;; EXPECT-ERROR: these types do not match.
;; EXPECT-ERROR: located_pattern_nested.bjo:11:15

(import (std prelude))

(: (-> (Tuple int string) int))
(defun (f p)
  (match p
    ((Tuple a 2) a)
    ((Tuple a b) a)))

(defun (main) (println (f (Tuple 1 "a"))) 0)
