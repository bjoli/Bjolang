;; Tagged records whose ->bjodat bodies call (text bjodat) by qualified
;; names, for warnings/qualified_published_bodies.bjo.
(import (std prelude))
(import (text bjodat))

(export Spot Place spot-text)

(def/bjodat-type
  (: Spot (Record #:tag spot (: name string))))

(def/bjodat-type
  (: Place (Record #:tag place
                   (: city string)
                   (: zip (Option string) #:optional))))

(: (-> Spot string))
(defun (spot-text s) (bjodat->string (->bjodat s)))
