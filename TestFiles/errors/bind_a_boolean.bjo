;; A boolean is a literal, so there is no name to bind.
;;
;; This was accepted. `#t` lexed as the symbol `#t`, and a binder position takes
;; a symbol — so the binding was made, and nothing could ever refer to it, since
;; a use of `#t` is the literal. A token of its own is what rules it out: the
;; binder shapes match a symbol and a boolean is not one.

;; EXPECT-ERROR: it is a boolean literal, not a name

(import (std prelude))

(defun (main args)
  (let ((#t 1))
    (println (int->string #t)))
  0)
