;; A def of the module the form is in may not have its value yet when the form
;; first runs.
;; EXPECT-ERROR: it cannot read `table`, a def of this module
(import (std prelude))

(def table [1 2 3])

(: size (-> int))
(defun (size) (please-hoist-i-promise-i-am-not-naughty (vec-length table)))

(defun (main) (size))
