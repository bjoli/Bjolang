;; A blanket implementation of a trait that abstracts over a *constructor*.
;;
;; `Monadish` abstracts the last argument of its implementor, so an impl names
;; `(F %a)` — a constructor applied. A blanket names a bare type variable, and
;; there is nothing to apply it to: `(%f %a)` is a type variable applied to
;; arguments, which `HMType` has no case for and deliberately never will, since
;; giving the unifier one makes it higher-order.
;;
;; Two levels of specificity is a statement about *heads*. A trait with no head
;; to speak of has nothing for it to say.

;; EXPECT-ERROR: cannot have a blanket implementation

(def/trait (Monadish (%f %a))
  (: wrap (-> %a (%f %a))))

(def/impl (Monadish %a)
  (defun (wrap x) x))

(defun (main args) 0)
