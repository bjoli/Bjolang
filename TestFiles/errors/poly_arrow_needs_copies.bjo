;; The suspending instantiation of an `-?->`, before there is anything to
;; instantiate it with.
;;
;; `-?->` declares that a parameter may be given a function of either colour,
;; and the two colours are two *emitted bodies*: C# generics are not
;; effect-polymorphic, so `Func<A,B>` and `Func<A,Fiber<B>>` are unrelated types
;; and one method cannot serve both. Making the second copy is what
;; monomorphisation does, and it is not built yet.
;;
;; So the declaration is accepted, checked and published — a module compiled now
;; will not need rewriting later — and it is the *use* at the suspending colour
;; that is refused. Refused rather than allowed: what it would otherwise emit is
;; one ordinary body whose C# hands a `Func<int, Fiber<int>>` to a parameter
;; typed `Func<int, int>`, which is a Roslyn error in a file nobody wrote, about
;; a type the language does not have.

;; EXPECT-ERROR: copies are not generated yet

(import (std prelude))

(: apply-twice (-> (-?-> int int) int int))
(defun (apply-twice f x) (f (f x)))

(: worker (-bjo-> int int))
(defbjo (worker n)
  (apply-twice (bjoroutine (x) (+ x 1)) n))

(defun (main args) 0)
