;; An implementation of an imported trait for function types.
;;
;; A function type is declared by no module, so only the trait's module may
;; implement the trait for `Procedure`, as the prelude does for `Written`.

;; EXPECT-ERROR: Orphan Rule Violation
;; EXPECT-ERROR: a function type is declared by no module, so 'Eq' cannot be implemented for it here

(import (std prelude))

(impl (Eq Procedure)
  (defun (= a b) #t)
  (defun (eq-hash a) 0))

(defun (main args) 0)
