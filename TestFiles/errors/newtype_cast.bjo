;; A newtype is made by its constructor and taken apart by a pattern, and a
;; cast would be a way past both, and past #:opaque.

;; EXPECT-ERROR: a cast cannot make or take apart the newtype newtype_cast/Banana. Write (Banana x) to make one

(import (std prelude))

(type (: Banana (Newtype int)))

(defun (main args)
  (println (displayed (cast Banana 3)))
  0)
