;; The four rows the merge is measured against, written in Bjolang.
;;
;; Twin of bench/Cml/Program.cs. Same counts, same topology, same work per unit,
;; so the gap between the two tables is what the language costs on top of the
;; runtime.
;;
;; The second ring row has no C# twin: a scope is a Bjolang construct, and the
;; row exists to price a *nested* one. Its 1000 spawns are inside the timed
;; region because they have to be inside the scope; against 1,000,000 messages
;; that is under 0.2%.
;;
;; Both ring rows run under a live cancellation token: `RunMainFiber` opens a
;; scope around `main`, and `bjo` and `spawn` hand the environment to their
;; children, so every `sync` anywhere in this file races a token. What the
;; second row adds is the nested scope itself — children owned and waited for
;; by it, a token linked to the outer one, and the close at the end.
;;
;; What still differs from the C# twin, after the shapes were matched:
;;
;; - The token. No row here can be run without one, because `main` is a scope;
;;   the C# rows race nothing. That difference is the point of the comparison
;;   rather than a flaw in it.
;; - The spawn-burst completion signal is a nested scope, where the C# twin
;;   counts down to a `ManualResetEventSlim`. A scope waits for its children by
;;   construction, so there is no Bjolang spelling of the latch that is not
;;   also a scope.
;; - Every `sync` here goes through the language's `sync`, which builds an
;;   event value; the C# twin awaits `ch.Send(v)` / `ch.Receive()` directly and
;;   so has no event object on the send side.

(import (std prelude))
(import (std stopwatch))

;; Per-thread allocation is useless here — the work is spread over the pool — so
;; the process-wide counter is used instead. `GC.Collect` is overloaded on
;; arity, and an extern is resolved by the signature written here, so `(-> void)`
;; picks the no-argument one; `CollectionCount` takes the generation.
(import/extern
  (total-allocated (: System.GC.GetTotalAllocatedBytes (-> bool long)))
  (gc-collect (: System.GC.Collect (-> void)))
  (gc-wait-finalizers (: System.GC.WaitForPendingFinalizers (-> void)))
  (gc-count (: System.GC.CollectionCount (-> int int)))
  (framework (: System.Runtime.InteropServices.RuntimeInformation.FrameworkDescription #:get))
  (processor-count (: System.Environment.ProcessorCount #:get))
  (server-gc? (: System.Runtime.GCSettings.IsServerGC #:get)))

(def reps 5)

;; A settled heap before the mark, as in the C# twin's `Measured`, so that a row
;; reports what it allocated rather than what the row before it left behind.
;; Without it the gen-0 collection the previous row earned lands inside this
;; one's timed region, which on this suite doubled the median of the
;; skewed-choose row.
(: settle (-> void))
(defun (settle)
  (gc-collect)
  (gc-wait-finalizers)
  (gc-collect))

;; One rep: elapsed milliseconds, bytes allocated, gen-0 collections.
(: rep-ns (-> (Tuple long long int) long long))
(defun (rep-ns r ops)
  (match r ((Tuple ms bytes gc) (/ (* ms 1000000L) ops))))

(: rep-bytes (-> (Tuple long long int) long long))
(defun (rep-bytes r ops)
  (match r ((Tuple ms bytes gc) (/ bytes ops))))

(: rep-gc (-> (Tuple long long int) int))
(defun (rep-gc r)
  (match r ((Tuple ms bytes gc) gc)))

;; The third of five, i.e. the median, of an already sorted list.
(: middle (-> (List %a) %a))
(defun (middle xs)
  (list-head (list-tail (list-tail xs))))

;; The minimum, with the median beside it, in the C# twin's layout.
;;
;; The minimum is the column phases are compared on — the skewed-choose row is
;; bimodal on a multi-CCD part — and the median is printed so that a row whose
;; two modes have moved apart is still visible. Allocation is deterministic and
;; every rep agrees.
(: report (-> string int (List (Tuple long long int)) void))
(defun (report name n results)
  (def ops (cast System.Int64 n))
  (def nss (list-sort (list-map (fun (r) (rep-ns r ops)) results)))
  (def bs (list-sort (list-map (fun (r) (rep-bytes r ops)) results)))
  (def gcs (list-sort (list-map rep-gc results)))
  (println (str (string-pad-right name 22)
                (string-pad-left (->str (list-head nss)) 10)
                (string-pad-left (->str (list-head bs)) 10)
                "   (median " (->str (middle nss))
                ", gc0 " (->str (middle gcs)) "/rep)")))

;; ---------------------------------------------------------------------------
;; 1. Ring — 1000 nodes, 1000 trips, a million parked rendezvous.
;; ---------------------------------------------------------------------------

(: ring-node (-bjo-> (Chan int) (Chan int) bool int void))
(defbjo (ring-node in out is-last trips)
  (let go ()
    (def msg (sync (chan-recv in)))
    (if (= msg -1)
        (if is-last unit (sync (chan-send out -1)))
        (let ((m (if is-last (+ msg 1) msg)))
          (if (and is-last (>= m trips))
              (let () (sync (chan-send out -1)) (go))
              (let () (sync (chan-send out m)) (go)))))))

;; The kick-off message, sent from a fiber of its own as in the C# twin, so that
;; the timed region starts with a spawn rather than with a send on the fiber
;; that is about to wait for everybody.
(: send-one (-bjo-> (Chan int) int void))
(defbjo (send-one ch v)
  (sync (chan-send ch v)))

;; Spawned with `bjo` and joined by hand, so the nodes start outside the timed
;; region exactly as they do in the C# twin. The main scope's token is still
;; ambient, so every `sync` here races it; this row is the C# twin plus that.
(: ring-joined (-bjo-> int int (Tuple long long int)))
(defbjo (ring-joined workers trips)
  (def channels (loop (:for i (range 0 workers))
                      (:acc v (vecing (make-chan)))))
  (def handles (loop (:for i (range 0 workers))
                     (:acc v (vecing (bjo (ring-node (vec-ref channels i)
                                                     (vec-ref channels (% (+ i 1) workers))
                                                     (= i (- workers 1))
                                                     trips))))))
  (settle)
  (def gc0 (gc-count 0))
  (def before (total-allocated #t))
  (def sw (stopwatch))
  (stopwatch-start! sw)
  (ignore (sync (promise-join (bjo (send-one (vec-ref channels 0) 0)))))
  (loop (:for i (range 0 workers))
        (:do (ignore (sync (promise-join (vec-ref handles i))))))
  (stopwatch-stop! sw)
  (Tuple (stopwatch-ms sw) (- (total-allocated #t) before) (- (gc-count 0) gc0)))

;; The same ring under a nested `with-cancel`, which is the only difference
;; between this row and the one above: the nodes are `spawn`ed rather than
;; `bjo`ed, the nested scope owns them and waits for them instead of a join per
;; handle, and its token is linked to the outer one. Both rows race a live
;; token, so what the pair prices is the nested scope's bookkeeping.
(: ring-nested-scope (-bjo-> int int (Tuple long long int)))
(defbjo (ring-nested-scope workers trips)
  (def channels (loop (:for i (range 0 workers))
                      (:acc v (vecing (make-chan)))))
  (settle)
  (def gc0 (gc-count 0))
  (def before (total-allocated #t))
  (def sw (stopwatch))
  (stopwatch-start! sw)
  (with-cancel (cancel)
    (loop (:for i (range 0 workers))
          (:do (spawn (ring-node (vec-ref channels i)
                                 (vec-ref channels (% (+ i 1) workers))
                                 (= i (- workers 1))
                                 trips))))
    (spawn (send-one (vec-ref channels 0) 0)))
  (stopwatch-stop! sw)
  (Tuple (stopwatch-ms sw) (- (total-allocated #t) before) (- (gc-count 0) gc0)))

;; ---------------------------------------------------------------------------
;; 2. Spawn burst — a million fibers that do nothing.
;;
;; The scope is the completion signal, which is what the C# twin's countdown
;; latch is. The scope's per-child bookkeeping is on this row.
;; ---------------------------------------------------------------------------

(: nothing (-bjo-> void))
(defbjo (nothing) unit)

(: spawn-burst (-bjo-> int (Tuple long long int)))
(defbjo (spawn-burst n)
  (settle)
  (def gc0 (gc-count 0))
  (def before (total-allocated #t))
  (def sw (stopwatch))
  (stopwatch-start! sw)
  (with-cancel (cancel)
    (loop (:for i (range 0 n))
          (:do (spawn (nothing)))))
  (stopwatch-stop! sw)
  (Tuple (stopwatch-ms sw) (- (total-allocated #t) before) (- (gc-count 0) gc0)))

;; ---------------------------------------------------------------------------
;; 3. Skewed choose — 8 branches, only the first ever fires.
;;
;; The other 7 accumulate dead takers that only the amortised sweep reclaims.
;; ---------------------------------------------------------------------------

(: skewed-sender (-bjo-> (Chan int) int void))
(defbjo (skewed-sender ch rounds)
  (loop (:for i (range 0 rounds))
        (:do (sync (chan-send ch i)))))

(: skewed-receiver (-bjo-> (Vec (Chan int)) int void))
(defbjo (skewed-receiver chs rounds)
  ;; Built once and synced a million times, as in the C# twin.
  (def ev (choose (chan-recv (vec-ref chs 0))
                  (chan-recv (vec-ref chs 1))
                  (chan-recv (vec-ref chs 2))
                  (chan-recv (vec-ref chs 3))
                  (chan-recv (vec-ref chs 4))
                  (chan-recv (vec-ref chs 5))
                  (chan-recv (vec-ref chs 6))
                  (chan-recv (vec-ref chs 7))))
  (loop (:for i (range 0 rounds))
        (:do (ignore (sync ev)))))

(: skewed-choose (-bjo-> int (Tuple long long int)))
(defbjo (skewed-choose rounds)
  (def chs (loop (:for i (range 0 8))
                 (:acc v (vecing (make-chan)))))
  (def sender (bjo (skewed-sender (vec-ref chs 0) rounds)))
  (settle)
  (def gc0 (gc-count 0))
  (def before (total-allocated #t))
  (def sw (stopwatch))
  (stopwatch-start! sw)
  ;; Spawned and joined rather than run here, as in the C# twin: on the main
  ;; fiber the receiver would be the one fiber in the row whose resume does not
  ;; go through the scheduler the same way.
  (ignore (sync (promise-join (bjo (skewed-receiver chs rounds)))))
  (ignore (sync (promise-join sender)))
  (stopwatch-stop! sw)
  (Tuple (stopwatch-ms sw) (- (total-allocated #t) before) (- (gc-count 0) gc0)))

;; ---------------------------------------------------------------------------

(defbjo (main args)
  (println (str framework
                ", ProcessorCount=" (->str processor-count)
                ", ServerGC=" (->str server-gc?)))
  (println "")
  (println (str (string-pad-right "benchmark" 22)
                (string-pad-left "ns/op" 10)
                (string-pad-left "B/op" 10)
                "   (min of " (->str reps) ")"))

  ;; Warm up every path the suite uses, so the first measured rep is not the one
  ;; paying for tier-0 code. A row hands its numbers back rather than printing
  ;; them, so a warmup rep is discarded by ignoring the result.
  (ignore (ring-joined 100 100))
  (ignore (ring-nested-scope 100 100))
  (ignore (spawn-burst 50000))
  (ignore (skewed-choose 50000))

  (report "Ring" 1000000
          (loop (:for r (range 0 reps)) (:acc l (listing (ring-joined 1000 1000)))))
  (report "Ring (nested scope)" 1000000
          (loop (:for r (range 0 reps)) (:acc l (listing (ring-nested-scope 1000 1000)))))
  (report "Spawn burst" 1000000
          (loop (:for r (range 0 reps)) (:acc l (listing (spawn-burst 1000000)))))
  (report "Skewed choose(8)" 1000000
          (loop (:for r (range 0 reps)) (:acc l (listing (skewed-choose 1000000)))))
  0)
