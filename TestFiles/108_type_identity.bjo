;; Two libraries, each declaring a `Banana`.
;;
;; A type's identity is the module that declared it plus its name, so these are
;; two types and both are usable in one program. What they are *called* is a
;; separate question. Both are imported plainly, so the bare `Banana` could be
;; either, and a use of it is refused as ambiguous
;; (errors/ambiguous_import_type.bjo). `prefix-types` gives each a spelling of
;; its own, and that is what this file writes. A prefix alone would replace the
;; bare names (384_prefix_replaces_bare.bjo); the plain imports keep them, so
;; that the constructors with names of their own are still bare.
(import (std simpletest))

(import "inc/banana_a.bjo"
        (prefix-types "inc/banana_a.bjo" "A/")
        (prefix-types "inc/banana_b.bjo" "B/")
        "inc/banana_b.bjo"
        (std prelude))

;; Both constructors arrive under their own names: a constructor follows its
;; type, and the two types are different ones.
(: (-> int int))
(defun (from-a n)
  (peel-a (MkBananaA n)))

(: (-> string string))
(defun (from-b s)
  (peel-b (MkBananaB s)))

;; Each `Banana` by its own spelling.
(: (-> B/Banana string))
(defun (shout b)
  (string-append (peel-b b) "!"))

(: (-> A/Banana int))
(defun (twice b)
  (+ (peel-a b) (peel-a b)))

;; A prefixed spelling of each, in a signature, in a constructor and in a
;; pattern. `A/Banana` and `B/Banana` are two types, not two names for one.
(: (-> A/Banana B/Banana))
(defun (relabel b)
  (match b
    ((A/MkBananaA n) (B/MkBananaB (int->string n)))))

(defun (main)
  (expect "a's constructor and a's peeler" (from-a 3) 3)
  (expect "b's constructor and b's peeler" (from-b "yes") "yes")
  (expect "b's under its prefix" (shout (make-b "ripe")) "ripe!")
  (expect "and a's under its own" (twice (make-a 4)) 8)
  (expect "one type in, the other out" (peel-b (relabel (A/MkBananaA 7))) "7")
  (println "108 ok")
  0)
