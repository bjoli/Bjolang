;; Rule 5: a spelling a modifier invents may not be one another import already
;; produces. Two renames landing on the same name is the smallest case of it.
;;
;; EXPECT-ERROR: Import collision
;; EXPECT-ERROR: 'open-it' would name

(import (rename "../inc/kitchen.bjo" (unwrap open-it) (crate-label open-it)))

(defun (main)
  0)
