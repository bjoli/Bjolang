;; Import modifiers on hash macros.
;;
;; `prefix` and `postfix` reach a hash macro as they reach everything: `#twice`
;; imported under `"s/"` is `#s/twice`. `only`, `except` and `rename` are
;; about the defs and do not see it, so an `(only ...)` that keeps one function
;; still brings every hash macro along.
(import (std simpletest))
(import (prefix "inc/hashmacros.bjo" "s/")
        (only "inc/hashmacros.bjo" tag)
        (std prelude))

(defun (main)
  (expect "prefixed" #s/twice(4) 8)
  (expect "prefixed, bracketed" #s/pairs[1 2] (list (Tuple 1 2)))
  (expect "only keeps the def" (tag "x") "tag:x")
  (expect "and leaves the hash macro alone" #twice(5) 10)
  0)
